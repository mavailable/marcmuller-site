---
import VilleTemplate from '@components/VilleTemplate.astro';

const title = "Agence web à Nancy et en Meurthe-et-Moselle | Marc M";
const description = "Agence web à Nancy (Meurthe-et-Moselle) : sites sur mesure, rapides et bien référencés pour les indépendants et TPE du Grand Est. Réponse sous 48h.";

const ville = "Nancy";
const heroEyebrow = "Agence web · Nancy · Meurthe-et-Moselle · Grand Est";
const intro = "Vous avez un commerce, un artisanat ou un service à Nancy et vous cherchez un site web qui vous ramène des clients ? Je suis Marc, agence web solo installée à Montigny-lès-Metz, à 45 minutes de Nancy. Je crée des sites sur mesure pour les indépendants et TPE de Meurthe-et-Moselle et du Grand Est. Ultra-rapides, bien référencés sur Google comme sur ChatGPT.";

const sections = [
  {
    title: "La transformation numérique à Nancy : c'est maintenant",
    content: "Nancy est une belle ville avec une forte culture entrepreneuriale. Université, PME, artisanats. Mais beaucoup manquent d'une présence web efficace.\n\nRéalité :\n- 60% des clients commencent leur recherche sur Google\n- Ils jugent un commerce en 3 secondes sur son site\n- S'il est lent ou moche, ils vont chez le concurrent\n\nÀ Nancy, je vois des bons sites (minorité) et énormément de sites « juste suffisants ».\n\nUn site vraiment bon change la donne. Vous captez des clients avant même qu'ils vous découvrent offline."
  },
  {
    title: "Ma méthode pour les entrepreneurs nancéiens",
    content: "Je travaille avec vous, pas sur vous.\n\nÉtape 1 : Appel 30 min\nOn discute de votre métier, vos objectifs, votre budget. Je vous dis ce qui coûte quoi.\n\nÉtape 2 : Vous me donnez les infos\nPhotos, textes, infos de contact. Si vous ne les avez pas, je vous aide à les trouver.\n\nÉtape 3 : Je crée votre site\nCustom, rapide, beau. Pas de template. Pas de WordPress. Juste du bon travail.\n\nÉtape 4 : C'est en ligne\nVotre site est en production. Vous recevez vos premiers appels en quelques semaines.\n\nÉtape 5 : Je reste dispo\nMaintenance 3 mois incluse. Après, vous gérez seuls ou on continue ensemble."
  },
  {
    title: "Ce que je fais pour les pros de Nancy",
    content: "**Un artisan du bâtiment**\nSituation typique : pas de site, juste une fiche Google et le bouche-à-oreille. Je crée un site avec galerie de chantiers, devis en ligne, avis clients. En quelques semaines, les premiers devis arrivent via Google.\n\n**Un commerce de centre-ville**\nSituation typique : une page Facebook ou Instagram, mais rien sur Google. Je crée un site vitrine avec horaires, produits, localisation. Les clients qui cherchent sur Google vous trouvent enfin.\n\n**Un praticien bien-être ou santé**\nSituation typique : uniquement Doctolib ou le bouche-à-oreille. Je crée un site sobre avec approche, tarifs, prise de RDV. Les patients vous trouvent par leur recherche, pas seulement par la plateforme."
  }
];

const faq = [
  {
    question: "Vous êtes vraiment disponible pour un projet à Nancy ou c'est un site générique pour toutes les villes ?",
    answer: "C'est vraiment pour Nancy. J'ai un historique ici, j'y travaille régulièrement, je connais la région. Première consultation gratuite, on verra si c'est un bon fit."
  },
  {
    question: "Combien de sites avez-vous créés en Lorraine ?",
    answer: "Plusieurs clients en Lorraine et Grand Est. Tous les sites sont visibles sur ma page réalisations. Je travaille depuis Metz, à 45 minutes de Nancy."
  },
  {
    question: "Est-ce que votre site m'aide à battre les chaînes nationales (si applicable à mon domaine) ?",
    answer: "Directement ? Non, une chaîne nationale va toujours avoir plus de budget marketing.\n\nIndirectement ? Oui. Un client cherche « salon coiffure Nancy » (local) pas « chaîne coiffure France ». Vous allez dominer votre catégorie localement si votre site est meilleur.\n\nEt un site vraiment bien fait crée de la confiance — les gens achètent local s'ils voient un vrai perso derrière."
  },
  {
    question: "Quel est votre tarif pour une maintenance long-terme ?",
    answer: "3 mois inclus après livraison (je fais les petits changements gratuits). Après : un suivi mensuel si vous voulez que je gère, ou vous faites vous-mêmes (simple avec l'interface d'édition).\n\nOu on renegotie selon le scope, c'est flexible."
  }
];

const pricingExpress = {
  title: "Site Vitrine",
  price: "On en parle",
  features: [
    "✓ Design sur mesure, pas un template",
    "✓ Référencé Google & IA",
    "✓ Formulaire, WhatsApp, appel",
    "✓ Lighthouse 100/100",
    "✓ Livré en 7 jours"
  ]
};

const pricingCustom = {
  title: "Projet Sur Mesure",
  price: "Sur devis",
  features: [
    "✓ Multi-pages, blog, CMS",
    "✓ Fonctionnalités métier",
    "✓ Stratégie SEO avancée",
    "✓ Optimisé IA (ChatGPT, Claude)",
    "✓ Devis gratuit sous 48h"
  ]
};

const geo = {
  lat: 48.6921,
  lon: 6.1844
};

const proof = {
  eyebrow: "Preuve régionale · Lorraine",
  client: "JD Zoothérapie, cliente en Lorraine",
  summary: "Zoothérapeute en Moselle, à moins d'une heure de Nancy. Son ancien Google Sites ne convertissait pas malgré du trafic. Deux semaines pour un vrai site pro : aujourd'hui il est en première page de Google, position moyenne 4,6, et ramène 118 clics par trimestre.",
  stats: [
    { value: "118", label: "Clics Google / trimestre" },
    { value: "4,6", label: "Position moyenne (page 1)" },
    { value: "100", label: "Score de vitesse" },
  ],
  link: {
    href: "/journal/refonte-jd-zootherapeute/",
    label: "Lire l'étude de cas",
  },
};

const areaServed = ["Nancy", "Lorraine", "Meurthe-et-Moselle", "Toul", "Lunéville"];

const ctaTitle = "Transformez votre présence en ligne à Nancy";
const ctaText = "Écrivez-moi. Appel gratuit sans engagement. On discute de votre projet, je vous dis ce que ça coûte, et on voit si c'est un bon fit.";
const ctaButton = "Créer mon site Nancy";
---

<VilleTemplate
  title={title}
  description={description}
  ville={ville}
  intro={intro}
  heroEyebrow={heroEyebrow}
  sections={sections}
  faq={faq}
  proof={proof}
  pricingExpress={pricingExpress}
  pricingCustom={pricingCustom}
  geo={geo}
  areaServed={areaServed}
  ctaTitle={ctaTitle}
  ctaText={ctaText}
  ctaButton={ctaButton}
  frPath="/creation-site-web-nancy"
  enPath="/en/web-design-nancy"
/>
