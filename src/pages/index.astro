---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { getProjectsForCarousel, getClientProjects, getSampleProjects } from '../data/projects';

const totalProjects = getClientProjects().length + getSampleProjects().length;

// Projets pour le hero
const heroProjects = getProjectsForCarousel('homepage').map(p => ({
  img: p.screenshot,
  name: p.title,
  sub: p.sector,
  id: p.id,
  url: p.url,
}));

const faqItems = [
  {
    question: "Concrètement, tu m'aides à trouver des clients comment ?",
    answer: "On regarde d'abord qui sont tes clients, où ils sont, et quoi leur dire. Ensuite on met en place les bons leviers : un site qui te ramène des clients, tes réseaux, de la prospection pour aller les chercher, et de quoi relancer ceux qui hésitent. Je fais avec toi, pas à ta place, et on regarde chaque semaine ce qui marche."
  },
  {
    question: "C'est quoi l'accompagnement, exactement ?",
    answer: "On bosse ensemble dans la durée. Je fais avec toi, chaque semaine, en actions concrètes. Pas de réunions pour rien, pas de PowerPoint. Comme un associé qui met les mains dedans, sans prendre tes parts. Pas de tarif tout fait : ça dépend de ce dont tu as besoin. On en parle 15 min, je te dis par quoi commencer."
  },
  {
    question: "Tu es plutôt un coach ou un dev ?",
    answer: "Les deux, et surtout un entrepreneur. J'ai monté 8 à 10 boîtes et accompagné une vingtaine d'indépendants. La plupart des coachs parlent sans faire, et les devs codent sans avoir entrepris. Moi je construis et je fais tourner les outils moi-même. C'est rare, et c'est exactement ce qui te manque."
  },
  {
    question: "Et si je veux juste un site ?",
    answer: "Possible aussi. Le site, c'est une des briques. Il est pensé pour te ramener des clients, livré rapidement, et il t'appartient : zéro abonnement, zéro lock-in. Pour le reste, on cadre ton besoin en 15 min, sans engagement."
  },
  {
    question: "Je gère tout moi-même après ?",
    answer: "Oui, c'est le but. Tout est éditable par toi dans ton admin : tes textes, tes photos, tes horaires. C'est aussi facile que poster sur Facebook, sans toucher au code. L'objectif, c'est que tu continues seul."
  },
  {
    question: "Je ne sais pas quoi écrire, c'est un problème ?",
    answer: "Pas du tout. Tu me parles de ton métier 15 minutes, je m'occupe du reste : accroches, descriptions, page à propos. Tu valides, c'est tout."
  },
  {
    question: "C'est pour qui exactement ?",
    answer: "Pour l'indépendant qui vit de son métier mais galère à avoir des clients, et qui n'a personne d'entrepreneur autour de lui à qui demander. Artisans, coachs, thérapeutes, photographes, consultants, professions libérales, freelances. Que tu veuilles te lancer ou développer une activité qui tourne déjà."
  },
  {
    question: "J'ai déjà Instagram (ou Doctolib, ou Pages Jaunes)… pourquoi aller plus loin ?",
    answer: "Les plateformes te rendent visible sur leur audience, mais un site te rend visible partout : Google, ChatGPT, Perplexity, Claude. Sans site, les moteurs et les IA ne te citent pas. Et un site t'appartient, pas d'algorithme qui décide si tes clients te voient. Ça ne remplace pas tes réseaux, ça les complète. Mais surtout : être visible, c'est un début, encore faut-il aller chercher les clients, et c'est là que je t'aide."
  },
  {
    question: "Tu travailles uniquement dans le Grand Est ?",
    answer: "Je suis basé à Metz mais j'accompagne des indépendants partout en France et à l'international. Tout se fait à distance : téléphone, visio, écrit, WhatsApp. Si tu es près de Metz, Strasbourg ou Nancy, on peut aussi se voir."
  },
  {
    question: "Tu reprends un site WordPress, Wix ou Squarespace existant ?",
    answer: "Oui, c'est fréquent. Je reprends ton contenu (textes, photos), ton nom de domaine, et je redirige l'ancien site vers le nouveau pour préserver ton référencement Google. Tu repars avec un site plus rapide, plus sûr, sans abonnement ni plugin à mettre à jour."
  },
  {
    question: "Pas à l'aise avec la technique ?",
    answer: "Aucun souci. Tu me donnes 15 minutes par téléphone, visio ou WhatsApp, je fais tout le reste. Rien à installer, rien à configurer. Et ce que je te livre, tu peux le gérer seul ensuite."
  }
];
---

<BaseLayout
  title="Le bras droit des indépendants qui veulent plus de clients | Marc M"
  description="Tu n'as pas besoin d'un site, tu as besoin de clients. Je t'aide à en trouver pour de vrai, comme un associé qui met les mains dedans : le site, la prospection, et les outils qui te font gagner du temps."
  lang="fr"
  frPath="/"
  enPath="/en/"
  preloadImages={[
    // Desktop uniquement : le showcase est immédiatement visible.
    // Mobile : aucun preload image — l'élément LCP est le H1 (texte), et
    // précharger la 1re carte du carrousel (sous la ligne de flottaison)
    // volait de la bande passante 4G à la fonte Satoshi dont dépend le
    // repaint final du H1 → LCP repoussé. La fonte gagne désormais la course.
    { href: heroProjects[1]?.img, media: '(min-width: 768px)' },
  ]}
>
  <SchemaOrg type="person" />
  <SchemaOrg type="localBusiness" />
  <SchemaOrg type="faqPage" data={faqItems} />
  <!-- HERO -->
  <section class="relative w-full overflow-hidden bg-[#0D0D0D]">
    <!-- Blobs -->
    <div class="absolute top-[15%] left-[10%] w-[600px] h-[600px] rounded-full bg-[var(--color-accent)] blur-[180px] hero-blob" style="--blob-delay: 0s; --blob-opacity: 0.07;"></div>
    <div class="absolute bottom-[5%] right-[5%] w-[500px] h-[500px] rounded-full bg-[#4F46E5] blur-[160px] hero-blob" style="--blob-delay: 0.15s; --blob-opacity: 0.04;"></div>

    <!-- Noise -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

    <div class="relative mx-auto max-w-6xl px-6 pt-16 pb-10 md:pt-14 md:pb-12 lg:pt-16 lg:pb-12 w-full">

      <!-- ── Text — centered ── -->
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-[2.5rem] md:text-[3.5rem] lg:text-[4rem] font-bold leading-[1.06] tracking-[-0.035em] text-white hero-reveal">
          Tu n'as pas besoin d'un site.<br>
          <span class="hero-accent-text">Tu as besoin de clients.</span>
        </h1>

        <p class="mt-4 md:mt-5 text-[15px] md:text-lg text-neutral-400 leading-relaxed max-w-md mx-auto hero-fade" style="--hero-delay: 0.35s;">
          J'aide les indépendants à en trouver, pour de vrai. Un site qui te ramène des clients, de quoi aller les chercher et savoir quoi leur dire, et les outils qui te font gagner du temps : <span class="text-white font-medium">tes rendez-vous, tes devis, tes factures, tes relances.</span>
        </p>
        <p class="mt-3 text-sm text-neutral-500 hero-fade" style="--hero-delay: 0.4s;">100% à distance · Clients partout en France</p>

        <div class="mt-5 md:mt-7 flex flex-col sm:flex-row items-center justify-center gap-3 md:gap-4">
          <a href="https://cal.com/marc-muller/15min" target="_blank" rel="noopener noreferrer" class="hero-cta group inline-flex items-center justify-center rounded-xl bg-accent px-6 py-3.5 md:px-8 md:py-4 text-[15px] md:text-base font-semibold text-white transition-all duration-300 hover:-translate-y-0.5" data-umami-event="cal-cta-home" data-umami-event-position="hero">
            On en parle ? 15 min, sans engagement
            <svg class="ml-2 h-4 w-4 md:h-5 md:w-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
          <a href="/offre" class="hero-fade inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/[0.03] px-6 py-3.5 md:px-8 md:py-4 text-[15px] md:text-base font-semibold text-white/80 transition-all duration-300 hover:bg-white/[0.07] hover:text-white" style="--hero-delay: 0.5s;" data-umami-event="hero-cta-click">
            Voir l'offre
          </a>
        </div>
        <p class="mt-4 hero-fade text-sm text-neutral-500" style="--hero-delay: 0.6s;">
          Pas encore prêt ? <a href="/audit-gratuit" class="text-neutral-400 underline underline-offset-2 hover:text-white transition-colors" data-umami-event="hero-audit-gratuit-click">Obtenez un audit gratuit de votre visibilité →</a>
        </p>
      </div>

      <!-- ── Showcase — Desktop: 3D coverflow · Mobile: scroll ── -->
      <div class="mt-8 md:mt-6">

        <!-- Desktop coverflow -->
        <div class="hidden md:block hero-showcase" style="perspective: 1400px;">
          <div class="relative mx-auto flex items-end justify-center" style="height: 420px; max-width: 1050px;">
            {heroProjects.slice(0, 3).map((p, i) => (
              <a
                href={`/realisations#${p.id}`}
                class={`hero-card group/card absolute overflow-hidden rounded-2xl border border-white/[0.08] shadow-2xl shadow-black/50 transition-all duration-500 hover:shadow-black/70 ${i === 1 ? 'hero-card-center z-20' : i === 0 ? 'hero-card-left z-10' : 'hero-card-right z-10'}`}
                style={`--card-delay: ${i === 1 ? '0.5' : i === 0 ? '0.65' : '0.8'}s;`}
                data-umami-event="hero-project-click"
                data-umami-event-project={p.id}
              >
                <div class="relative overflow-hidden">
                  <img
                    src={p.img}
                    alt={p.name}
                    width={i === 1 ? 520 : 400}
                    height={i === 1 ? 290 : 230}
                    class={`w-full object-cover object-top transition-transform duration-700 group-hover/card:scale-[1.03] ${i === 1 ? 'h-[290px]' : 'h-[230px]'}`}
                    style={`width: ${i === 1 ? '520px' : '400px'};`}
                    loading="eager"
                    fetchpriority={i === 1 ? 'high' : 'auto'}
                    decoding="async"
                  />
                  <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);"></div>
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300 group-hover/card:opacity-100" style="background: rgba(0,0,0,0.3);">
                    <span class="rounded-full bg-white/15 px-5 py-2 text-sm font-medium text-white backdrop-blur-sm border border-white/20">
                      Voir le site →
                    </span>
                  </div>
                  <div class="absolute inset-x-0 bottom-0 px-4 pb-3">
                    <p class="text-sm font-semibold text-white truncate">{p.name}</p>
                    <p class="text-xs text-white/50 truncate">{p.sub}</p>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Mobile carousel — tap to pause + CTA overlay -->
        <div class="md:hidden min-w-0" id="mobile-carousel">
          <div class="relative overflow-hidden rounded-2xl">
            <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-6 z-10" style="background: linear-gradient(to right, #0D0D0D, transparent);"></div>
            <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-6 z-10" style="background: linear-gradient(to left, #0D0D0D, transparent);"></div>
            <div class="mobile-track flex gap-3" id="mobile-track" style="width: max-content;">
              {[...heroProjects, ...heroProjects].map((p, i) => (
                <div
                  class="carousel-item shrink-0 w-[260px] overflow-hidden rounded-xl border border-white/[0.08] shadow-xl shadow-black/40 transition-all duration-300 cursor-pointer relative"
                  data-url={`/realisations#${p.id}`}
                  data-name={p.name}
                >
                  <div class="relative overflow-hidden">
                    <img src={p.img} alt={p.name} width="260" height="146" class="h-[146px] w-full object-cover object-top transition-transform duration-300" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" />
                    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 55%);"></div>
                    <div class="absolute inset-x-0 bottom-0 px-3 pb-2.5">
                      <p class="text-sm font-semibold text-white truncate">{p.name}</p>
                      <p class="text-[11px] text-white/50 truncate">{p.sub}</p>
                    </div>
                    <!-- CTA overlay — shown when paused on this card -->
                    <div class="carousel-overlay absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200 pointer-events-none" style="background: rgba(0,0,0,0.45); backdrop-filter: blur(2px);">
                      <a class="pointer-events-auto rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-[#0D0D0D] shadow-lg transition-transform hover:scale-105">
                        Voir le site →
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <!-- Resume button — shown when paused -->
          <button id="carousel-resume" class="mt-3 mx-auto hidden items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-xs text-white/60 transition-all active:scale-95" type="button">
            <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.841A1.5 1.5 0 004 4.11v11.78a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/></svg>
            Reprendre le défilement
          </button>
        </div>
      </div>

      <!-- Subtle link -->
      <div class="mt-8 md:mt-10 text-center hero-fade" style="--hero-delay: 1s;">
        <a href="/realisations" class="inline-flex items-center gap-2 text-sm text-neutral-500 transition-colors hover:text-white/70">
          {totalProjects} projets réalisés — voir les réalisations
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </section>


  <!-- PROBLÈME — 2 colonnes : accroche + pain points -->
  <section class="w-full bg-[var(--color-bg-alt)] px-6 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-12 md:grid-cols-[1fr_1.2fr] md:gap-16 items-start">

        <!-- Colonne gauche — accroche sticky -->
        <div class="md:sticky md:top-28">
          <p class="text-[var(--color-accent-text)] font-semibold text-sm tracking-wide uppercase mb-4">Le vrai problème</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text)] leading-tight">
            Ton métier, tu le maîtrises. <span class="text-[var(--color-accent-text)]">Trouver des clients, c'est autre chose.</span>
          </h2>
          <p class="mt-3 text-[var(--color-text-muted)] text-lg leading-relaxed">
            Tu sais faire ton boulot. Personne ne t'a appris à aller chercher des clients. Et autour de toi, pas un seul entrepreneur à qui demander.
          </p>
          <div class="mt-8 hidden md:block">
            <p class="text-[var(--color-text-muted)]">
              Et si tu avais quelqu'un qui l'a déjà fait, <span class="font-semibold text-[var(--color-text)]">à côté de toi, chaque semaine</span> ?
            </p>
            <a href="#methode" class="mt-3 inline-flex items-center gap-2 text-[var(--color-accent-text)] font-semibold text-sm hover:underline transition-colors">
              Voir comment je bosse
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
            </a>
          </div>
        </div>

        <!-- Colonne droite — pain points -->
        <div class="space-y-4">
          <div class="group rounded-2xl border-l-4 border-l-red-400 bg-white px-6 py-5 shadow-sm transition-all duration-300 hover:shadow-md">
            <h3 class="text-[17px] font-bold text-[var(--color-text)] group-hover:text-red-500 transition-colors">
              Tu attends que ça vienne
            </h3>
            <p class="mt-1.5 text-[var(--color-text-muted)] leading-relaxed text-[15px]">
              Le bouche-à-oreille tourne au ralenti. <span class="font-medium text-[var(--color-text)]">Tu n'as pas de plan pour aller chercher des clients toi-même.</span>
            </p>
          </div>

          <div class="group rounded-2xl border-l-4 border-l-amber-400 bg-white px-6 py-5 shadow-sm transition-all duration-300 hover:shadow-md">
            <h3 class="text-[17px] font-bold text-[var(--color-text)] group-hover:text-amber-600 transition-colors">
              Tu es seul à décider
            </h3>
            <p class="mt-1.5 text-[var(--color-text-muted)] leading-relaxed text-[15px]">
              Tes conseils, tu les prends auprès de gens qui n'ont jamais lancé de boîte. <span class="font-medium text-[var(--color-text)]">Du coup tu hésites, tu repousses, tu n'oses pas.</span>
            </p>
          </div>

          <div class="group rounded-2xl border-l-4 border-l-[var(--color-accent)] bg-white px-6 py-5 shadow-sm transition-all duration-300 hover:shadow-md">
            <h3 class="text-[17px] font-bold text-[var(--color-text)] group-hover:text-[var(--color-accent-text)] transition-colors">
              Tu perds des heures sur l'administratif
            </h3>
            <p class="mt-1.5 text-[var(--color-text-muted)] leading-relaxed text-[15px]">
              Devis, factures, relances, rendez-vous. <span class="font-medium text-[var(--color-text)]">Du temps qui part dans le vide au lieu d'aller chercher du chiffre.</span>
            </p>
          </div>
        </div>

      </div>

      <!-- CTA mobile (visible uniquement en mobile) -->
      <div class="mt-10 text-center md:hidden">
        <p class="text-[var(--color-text-muted)]">
          Et si tu avais quelqu'un qui l'a déjà fait, <span class="font-semibold text-[var(--color-text)]">à côté de toi, chaque semaine</span> ?
        </p>
        <a href="#methode" class="mt-3 inline-flex items-center gap-2 text-[var(--color-accent-text)] font-semibold text-sm hover:underline transition-colors">
          Voir comment je bosse
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- PREUVE SOCIALE -->
  <section class="w-full bg-white px-6 py-24 md:px-8 md:py-32">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center text-3xl md:text-4xl font-bold text-[var(--color-text)] mb-4">Je l'ai déjà fait</h2><p class="text-center text-[var(--color-text-muted)] mb-16 text-lg max-w-2xl mx-auto">Je ne suis pas un coach qui parle. J'ai monté des boîtes, et je construis moi-même les outils que je te livre.</p>
      <div class="grid gap-12 md:grid-cols-3">
        <div class="text-center">
          <div class="mb-3 text-6xl font-bold text-[var(--color-accent-text)]">8<span class="text-3xl">-10</span></div>
          <p class="text-[var(--color-text-muted)]">Boîtes que j'ai montées, dans 4 secteurs</p>
        </div>
        <div class="text-center">
          <div class="mb-3 text-6xl font-bold text-[var(--color-accent-text)]">~20</div>
          <p class="text-[var(--color-text-muted)]">Entrepreneurs que j'ai accompagnés</p>
        </div>
        <div class="text-center">
          <div class="mb-3 text-6xl font-bold text-[var(--color-accent-text)]"><span class="count-up" data-target={totalProjects}>{totalProjects}</span><span class="text-3xl">+</span></div>
          <p class="text-[var(--color-text-muted)]">Sites livrés et en production</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AVIS CLIENTS — dynamique depuis projects.ts -->
  <section class="w-full bg-[var(--color-bg-alt)] px-6 py-24 md:px-8 md:py-32">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12 text-center">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-[var(--color-accent-text)]">Avis Google</p>
        <h2 class="text-3xl font-bold text-[var(--color-text)] md:text-4xl">Ils me font confiance</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {getProjectsForCarousel('homepage').filter(p => p.review).map((p) => (
          <a href={`/realisations#${p.id}`} class="rounded-2xl border border-[var(--color-border)] bg-white p-7 shadow-sm flex flex-col transition-all hover:shadow-md hover:-translate-y-0.5 group">
            <div class="mb-4 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-accent)] text-sm font-bold text-white">{p.review!.author[0]}</div>
                <div>
                  <p class="font-semibold text-[var(--color-text)]">{p.review!.author}</p>
                  <p class="text-xs text-[var(--color-text-muted)]">{p.review!.role} · Mars 2026</p>
                </div>
              </div>
              <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
            </div>
            <div class="mb-3 flex gap-0.5">
