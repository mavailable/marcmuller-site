<style>
  /* ── Blobs ── */
  .hero-blob {
    scale: 0;
    animation: blobIn 1.4s cubic-bezier(0.16, 1, 0.3, 1) var(--blob-delay, 0s) forwards;
  }
  @keyframes blobIn {
    0% { scale: 0; opacity: 0; }
    100% { scale: 1; opacity: var(--blob-opacity, 0.06); }
  }

  /* ── H1 reveal — clip mask from bottom ──
     L'élément LCP ne doit JAMAIS démarrer caché (clip-path: inset(100%) ou opacity:0)
     sinon le LCP ne se déclenche qu'à la fin de l'animation (pénalité mobile ~+1,5s).
     On gate donc l'effet derrière une classe ajoutée par JS APRÈS le 1er paint :
     sans JS (ou avant le rAF), le H1 est peint immédiatement et plein écran. */
  .hero-reveal { clip-path: none; }
  .hero-anim .hero-reveal {
    clip-path: inset(100% 0 0 0);
    animation: clipReveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
  }
  @keyframes clipReveal {
    0% { clip-path: inset(100% 0 0 0); }
    100% { clip-path: inset(0 0 0 0); }
  }

  /* Respect des préférences de mouvement réduit pour tout le hero */
  @media (prefers-reduced-motion: reduce) {
    .hero-anim .hero-reveal,
    .hero-fade,
    .hero-cta,
    .hero-showcase,
    .hero-card,
    .hero-blob,
    .mobile-track { animation: none !important; opacity: 1 !important; clip-path: none !important; transform: none !important; }
  }

  /* ── Accent text ── */
  .hero-accent-text {
    background: linear-gradient(135deg, #E86C47 0%, #FF8A65 50%, #E86C47 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 5s ease-in-out 2s infinite;
  }
  @keyframes shimmer {
    0%, 100% { background-position: 0% center; }
    50% { background-position: 200% center; }
  }

  /* ── Generic fade ── */
  .hero-fade {
    opacity: 0;
    transform: translateY(16px);
    animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) var(--hero-delay, 0.4s) forwards;
  }
  @keyframes fadeUp {
    to { opacity: 1; transform: none; }
  }

  /* ── CTA — entrance + glow pulse ── */
  .hero-cta {
    opacity: 0;
    transform: translateY(16px);
    animation:
      fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards,
      ctaGlow 0.8s ease-in-out 1.3s both;
    box-shadow: 0 4px 24px rgba(232, 108, 71, 0.2);
  }
  .hero-cta:hover {
    box-shadow: 0 8px 32px rgba(232, 108, 71, 0.35);
  }
  @keyframes ctaGlow {
    0%, 100% { box-shadow: 0 4px 24px rgba(232, 108, 71, 0.2); }
    50% { box-shadow: 0 4px 48px rgba(232, 108, 71, 0.45), 0 0 80px rgba(232, 108, 71, 0.12); }
  }

  /* ── Desktop showcase — 3D coverflow ── */
  .hero-showcase {
    opacity: 0;
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
  }

  .hero-card {
    opacity: 0;
    animation: cardIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) var(--card-delay, 0.6s) forwards;
    will-change: transform;
  }
  .hero-card:hover {
    z-index: 30 !important;
  }

  /* Center card — front, largest */
  .hero-card-center {
    transform: translateZ(0) scale(1);
  }
  @keyframes cardIn {
    0% { opacity: 0; transform: translateY(60px) scale(0.9); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Left card */
  .hero-card-left {
    left: 0;
    bottom: 10px;
    transform: translateX(0) rotateY(4deg) scale(0.92);
  }
  .hero-card-left.hero-card { /* specificity override for final state */
    animation-name: cardInLeft;
  }
  @keyframes cardInLeft {
    0% { opacity: 0; transform: translateX(-40px) translateY(50px) rotateY(8deg) scale(0.85); }
    100% { opacity: 1; transform: translateX(0) rotateY(4deg) scale(0.92); }
  }

  /* Right card */
  .hero-card-right {
    right: 0;
    bottom: 10px;
    transform: translateX(0) rotateY(-4deg) scale(0.92);
  }
  .hero-card-right.hero-card {
    animation-name: cardInRight;
  }
  @keyframes cardInRight {
    0% { opacity: 0; transform: translateX(40px) translateY(50px) rotateY(-8deg) scale(0.85); }
    100% { opacity: 1; transform: translateX(0) rotateY(-4deg) scale(0.92); }
  }

  /* Center card position */
  .hero-card-center {
    left: 50%;
    bottom: 0;
    margin-left: -260px; /* half of 520px width */
  }

  /* Hover lift */
  .hero-card:hover {
    transform: translateY(-8px) scale(1) rotateY(0deg) !important;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Subtle float — desktop only */
  @media (min-width: 768px) {
    .hero-card-center { animation: cardIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) var(--card-delay) forwards, floatCenter 6s ease-in-out 1.6s infinite; }
    .hero-card-left   { animation: cardInLeft 0.8s cubic-bezier(0.16, 1, 0.3, 1) var(--card-delay) forwards, floatSide 7s ease-in-out 1.8s infinite; }
    .hero-card-right  { animation: cardInRight 0.8s cubic-bezier(0.16, 1, 0.3, 1) var(--card-delay) forwards, floatSide 7s ease-in-out 2s infinite; }

    @keyframes floatCenter {
      0%, 100% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-8px) scale(1); }
    }
    @keyframes floatSide {
      0%, 100% { transform: translateY(0) rotateY(var(--ry, 4deg)) scale(0.92); }
      50% { transform: translateY(-6px) rotateY(var(--ry, 4deg)) scale(0.92); }
    }
    .hero-card-left { --ry: 4deg; }
    .hero-card-right { --ry: -4deg; }
  }

  /* ── Mobile carousel ── */
  .mobile-track {
    will-change: transform;
  }
  .carousel-item.active {
    border-color: rgba(232, 108, 71, 0.4);
    box-shadow: 0 0 30px rgba(232, 108, 71, 0.15), 0 8px 30px rgba(0,0,0,0.5);
    transform: scale(1.03);
  }
  .carousel-item.active img {
    transform: scale(1.04);
  }
  .carousel-item.active .carousel-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Utilities ── */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fadeIn {
    animation: fadeIn 0.6s ease-out forwards;
    opacity: 0;
  }
</style>

<script>
  // ── Active l'animation de révélation du H1 APRÈS le 1er paint ──
  // Le H1 (élément LCP) est peint visible immédiatement (clip-path: none).
  // On ajoute .hero-anim au double rAF suivant : le LCP s'est déjà déclenché
  // sur le texte peint, et l'effet clip joue ensuite sans pénaliser la mesure.
  const heroSection = document.querySelector('.hero-reveal')?.closest('section');
  if (heroSection && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    requestAnimationFrame(() => requestAnimationFrame(() => heroSection.classList.add('hero-anim')));
  }

  // Intersection Observer pour les animations au scroll
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  // Animation des chiffres
  document.querySelectorAll('.count-up').forEach((element) => {
    const targetText = element.getAttribute('data-target');
    const target = parseInt(targetText);

    const originalObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !element.classList.contains('counted')) {
          element.classList.add('counted');
          element.textContent = '0';
          animateCount(element, target, 1500);
          originalObserver.unobserve(element);
        }
      });
    }, observerOptions);

    originalObserver.observe(element);
  });

  function animateCount(element: HTMLElement, target: number, duration: number) {
    const startTime = Date.now();
    const startValue = 0;

    const animate = () => {
      const now = Date.now();
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);

      const current = Math.floor(startValue + (target - startValue) * progress);
      element.textContent = current.toString();

      if (progress < 1) {
        requestAnimationFrame(animate);
      } else {
        element.textContent = target.toString();
      }
    };

    animate();
  }

  // FAQ accordion tracking
  document.querySelectorAll('details').forEach((el) => {
    el.addEventListener('toggle', () => {
      if (el.open) {
        const question = el.querySelector('summary')?.textContent?.trim() || '';
        if (typeof umami !== 'undefined') {
          umami.track('faq-open', { question: question.slice(0, 80) });
        }
      }
    });
  });

  // ── Mobile carousel: JS-driven scroll + tap to pause ──
  // Le carrousel est mobile-only (parent `md:hidden`). Sur desktop la boucle
  // rAF + la lecture de scrollWidth (reflow) tournaient quand même et créaient
  // une longue tâche JS → TBT desktop. On gate donc TOUTE l'init derrière un
  // check viewport mobile : sur desktop, rien ne s'exécute.
  const isMobileViewport = window.matchMedia('(max-width: 767px)').matches;
  const track = isMobileViewport ? (document.getElementById('mobile-track') as HTMLElement | null) : null;
  const resumeBtn = document.getElementById('carousel-resume');
  const items = isMobileViewport ? document.querySelectorAll<HTMLElement>('.carousel-item') : ([] as unknown as NodeListOf<HTMLElement>);

  if (track) {
    let offset = 0;
    let paused = false;
    let dragging = false;
    let dragStartX = 0;
    let dragOriginX = 0;
    let activeCard: HTMLElement | null = null;
    let inView = true;
    let halfWidth = 0;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const speed = 0.7;

    function wrap() {
      if (offset > 0) offset -= halfWidth;
      if (Math.abs(offset) >= halfWidth) offset += halfWidth;
    }

    function tick() {
      if (!paused && !dragging && inView && halfWidth > 0) {
        offset -= speed;
        wrap();
      }
      track!.style.transform = `translateX(${offset}px)`;
      requestAnimationFrame(tick);
    }

    // Démarre la boucle d'animation seulement quand le thread principal est libre
    // (réduit la contention CPU pendant le chargement → TBT mobile à 0).
    // Le scrollWidth (reflow synchrone) est lu DANS l'idle callback, pas au
    // parse du script, pour ne pas bloquer le chargement initial.
    // Désactivée si l'utilisateur préfère un mouvement réduit.
    if (!reduceMotion) {
      const startLoop = () => {
        halfWidth = track!.scrollWidth / 2; // reflow différé hors du chemin critique
        requestAnimationFrame(tick);
      };
      'requestIdleCallback' in window
        ? (window as any).requestIdleCallback(startLoop, { timeout: 2000 })
        : setTimeout(startLoop, 800);

      // Met la boucle en pause quand le carrousel sort de l'écran (économie CPU)
      const carouselEl = document.getElementById('mobile-carousel');
      if (carouselEl && 'IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          inView = entries[0]?.isIntersecting ?? true;
        }, { threshold: 0 }).observe(carouselEl);
      }
    }

    // ── Touch / drag to scroll ──
    track.addEventListener('touchstart', (e) => {
      dragging = true;
      dragStartX = e.touches[0].clientX;
      dragOriginX = dragStartX;
    }, { passive: true });

    track.addEventListener('touchmove', (e) => {
      if (!dragging) return;
      const dx = e.touches[0].clientX - dragStartX;
      offset += dx;
      wrap();
      dragStartX = e.touches[0].clientX;
    }, { passive: true });

    track.addEventListener('touchend', () => {
      dragging = false;
    });

    // ── Tap to pause / show CTA ──
    function pauseOn(card: HTMLElement) {
      if (activeCard) activeCard.classList.remove('active');
      paused = true;
      card.classList.add('active');
      activeCard = card;
      const link = card.querySelector('.carousel-overlay a');
      if (link) link.setAttribute('href', card.dataset.url || '/realisations');
      resumeBtn?.classList.remove('hidden');
      resumeBtn?.classList.add('flex');
    }

    function resume() {
      if (activeCard) activeCard.classList.remove('active');
      activeCard = null;
      paused = false;
      resumeBtn?.classList.add('hidden');
      resumeBtn?.classList.remove('flex');
    }

    items.forEach(card => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.carousel-overlay a')) return;
        // Ignore if user swiped more than 10px (not a tap)
        if (Math.abs(dragStartX - dragOriginX) > 10) return;
        if (card.classList.contains('active')) {
          resume();
        } else {
          pauseOn(card);
        }
      });
    });

    resumeBtn?.addEventListener('click', resume);
  }
</script>
