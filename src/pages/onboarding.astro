---
import BaseLayout from '../layouts/BaseLayout.astro';
import OnboardingForm from '../components/onboarding/OnboardingForm';
---

<BaseLayout
  title="Démarrer votre projet web — Marc M"
  description="Remplissez vos informations projet en 5 étapes. Sauvegarde automatique, reprise possible à tout moment."
  noindex={true}
>
  <section class="bg-secondary-100 py-14 md:py-20">
    <div class="max-w-2xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-primary-950 mb-4">Démarrons votre projet</h1>
      <p class="text-primary-700 leading-relaxed">
        5 étapes, une dizaine de minutes. Vos réponses sont sauvegardées au fur et à mesure :
        vous pouvez fermer cette page et reprendre plus tard sur le même appareil.
        Je lis tout personnellement et je reviens vers vous sous 48h.
      </p>
    </div>
  </section>

  <section class="py-10 md:py-14 bg-white">
    <div class="px-4">
      <OnboardingForm client:load />
    </div>
  </section>
</BaseLayout>
