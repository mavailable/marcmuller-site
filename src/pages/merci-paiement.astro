---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';

const checkIcon = `<svg class="w-10 h-10" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>`;
---

<BaseLayout
  title="Paiement confirmé — Écho | Marc M"
  description="Votre paiement Écho a été reçu. Votre rapport est en cours de génération."
  noindex={true}
  lang="fr"
  frPath="/merci-paiement"
>
  <section class="w-full bg-white px-6 py-24 md:px-8 md:py-32">
    <div class="mx-auto max-w-3xl text-center">

      <div class="flex justify-center mb-8">
        <div class="text-[var(--color-accent-text)]" set:html={checkIcon} />
      </div>

      <h1 class="mb-4 text-4xl font-bold leading-tight text-[var(--color-text)] md:text-5xl">
        Paiement confirmé !
      </h1>

      <p class="mb-10 text-lg text-[var(--color-text-muted)] md:text-xl leading-relaxed">
        Votre rapport Écho est en cours de génération.<br/>
        Vous le recevrez par email <strong>sous 48h</strong>.
      </p>

      <div class="bg-[var(--color-bg-alt)] rounded-2xl p-8 mb-12 border border-[var(--color-border)] text-left space-y-4">
        <h2 class="text-lg font-bold text-[var(--color-text)]">Ce qui se passe maintenant</h2>
        <div class="flex items-start gap-3">
          <span class="text-emerald-500 mt-0.5 shrink-0">✓</span>
          <p class="text-sm text-[var(--color-text-muted)]">Votre facture a été envoyée à votre adresse email.</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-[var(--color-accent-text)] mt-0.5 shrink-0">→</span>
          <p class="text-sm text-[var(--color-text-muted)]">Je génère les personas adaptés à votre secteur et zone géographique.</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-[var(--color-accent-text)] mt-0.5 shrink-0">→</span>
          <p class="text-sm text-[var(--color-text-muted)]">Chaque visiteur simulé parcourt votre site avec son profil, son appareil et son canal d'arrivée.</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-[var(--color-accent-text)] mt-0.5 shrink-0">→</span>
          <p class="text-sm text-[var(--color-text-muted)]">Vous recevez le lien vers votre rapport interactif privé sous 48h.</p>
        </div>
      </div>

      <div class="bg-[var(--color-bg)] rounded-xl p-6 mb-12">
        <p class="text-sm text-[var(--color-text-muted)] mb-4">
          Une question ? Contactez-moi directement :
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
          <a
            href={`https://wa.me/${business.whatsapp}?text=${encodeURIComponent("Bonjour Marc, je viens de commander un rapport Écho.")}`}
            target="_blank" rel="noopener noreferrer"
            data-umami-event="merci-paiement-whatsapp"
            class="inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold text-white transition-all hover:shadow-md"
            style="background:#25D366;"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <a href="mailto:marc@muller.im" data-umami-event="merci-paiement-email" class="text-sm font-medium text-[var(--color-accent-text)] hover:underline">
            marc@muller.im
          </a>
        </div>
      </div>

      <a
        href="/"
        data-umami-event="merci-paiement-retour-accueil"
        class="inline-flex items-center justify-center gap-2 font-medium transition-all duration-300 rounded-lg bg-[var(--color-accent)] text-white shadow-md hover:bg-[var(--color-accent-hover)] hover:shadow-lg hover:scale-105 px-8 py-3 text-base"
      >
        Retour à l'accueil
      </a>
    </div>
  </section>
  <script>
    if (typeof (window as any).umami !== 'undefined') {
      (window as any).umami.track('echo-paiement-confirme');
    } else {
      window.addEventListener('load', () => {
        if (typeof (window as any).umami !== 'undefined') {
          (window as any).umami.track('echo-paiement-confirme');
        }
      });
    }
  </script>
</BaseLayout>
