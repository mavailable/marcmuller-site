---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { business } from '../data/business';

const vm = business.visiteMystere;

const faqItems = [
  {
    question: 'Ce sont de vrais clients ?',
    answer: 'Non — ce sont des profils IA construits pour être réalistes. Chaque persona a un âge, un métier, un appareil (mobile/desktop), un canal d\'arrivée (Google, Instagram, bouche-à-oreille...) et un budget. Ils parcourent votre site exactement comme le ferait un vrai prospect et réagissent à ce qu\'ils voient — ou ne voient pas.',
  },
  {
    question: 'Combien de temps pour recevoir le rapport ?',
    answer: 'Sous 48 heures. Je lance l\'analyse, les prospects IA visitent votre site, et vous recevez le rapport par email avec un lien vers votre page de résultats.',
  },
  {
    question: 'C\'est différent d\'un audit SEO classique ?',
    answer: 'Complètement. Un audit SEO vous dit "votre LCP est de 3.8 secondes". La Visite Mystère vous dit "Karim, peintre de 52 ans, a quitté votre site parce qu\'il a attendu 4 secondes devant un écran blanc et qu\'il n\'a pas trouvé d\'exemple de chantier peinture dans vos réalisations." C\'est la différence entre un tableau de chiffres et une histoire humaine.',
  },
  {
    question: 'Et si je veux corriger les problèmes identifiés ?',
    answer: 'Je peux m\'en occuper. Je crée aussi des sites professionnels à partir de 490€. Chaque rapport inclut un lien pour commander directement — mais zéro obligation. Le rapport vous appartient, vous pouvez le transmettre à n\'importe quel prestataire.',
  },
  {
    question: 'Mon site est tout neuf, ça sert quand même ?',
    answer: 'Surtout ! Mieux vaut identifier les frictions maintenant, quand elles sont faciles à corriger, plutôt que perdre des clients pendant des mois sans comprendre pourquoi.',
  },
  {
    question: 'Mes données sont confidentielles ?',
    answer: 'Oui. Votre rapport est privé (non indexé par Google) et accessible uniquement via le lien que je vous envoie. Je ne publie jamais de rapport sans autorisation.',
  },
];
---

<BaseLayout
  title="Visite Mystère — 20 prospects IA testent votre site | Marc M"
  description="Des prospects IA réalistes visitent votre site web et vous disent pourquoi ils n'appellent pas. Rapport détaillé en 48h. Gratuit pour 5 visiteurs."
  lang="fr"
  frPath="/visite-mystere"
>
  <SchemaOrg type="localBusiness" />

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-20 md:px-8 md:py-32 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>
    <div class="absolute bottom-0 right-0 w-72 h-72 rounded-full opacity-5 blur-3xl" style="background: #818CF8;"></div>

    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]/40">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--color-accent)] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--color-accent)]"></span>
        </span>
        <span class="text-sm font-semibold text-white/90">Nouveau — Résultats en 48h</span>
      </div>

      <h1 class="mb-6 text-4xl font-bold leading-tight text-white md:text-5xl lg:text-6xl">
        20 prospects visitent votre site.<br/>
        <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">Aucun ne vous appelle.</span>
      </h1>

      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl mb-10">
        Découvrez pourquoi. Des IA simulent des clients réalistes qui parcourent votre site et vous disent exactement ce qui les empêche de vous contacter.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#formulaire" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[var(--color-accent)] text-white font-semibold rounded-xl hover:opacity-90 transition-opacity text-lg">
          Tester mon site gratuitement
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <a href="/audit/marcm/" class="inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-white/20 text-white font-semibold rounded-xl hover:border-white/40 transition-colors text-lg">
          Voir un exemple de rapport
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ LE CONSTAT ═══════════════════ -->
  <section class="w-full px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-3xl font-bold text-neutral-900 mb-4 md:text-4xl text-center">
        Votre site a un problème.<br/>Vous ne le voyez pas.
      </h2>
      <p class="text-neutral-500 text-center max-w-2xl mx-auto mb-12">
        Vous pensez que votre site "fait le job". Mais sans retour de vos visiteurs, vous ne savez pas combien de prospects repartent sans vous contacter — ni pourquoi.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl border border-neutral-200 p-8 text-center shadow-sm">
          <div class="text-4xl font-bold text-[var(--color-accent)] mb-2">73%</div>
          <p class="text-sm text-neutral-600">des artisans perdent des clients à cause de leur site — sans le savoir</p>
        </div>
        <div class="bg-white rounded-2xl border border-neutral-200 p-8 text-center shadow-sm">
          <div class="text-4xl font-bold text-[var(--color-accent)] mb-2">4 sur 10</div>
          <p class="text-sm text-neutral-600">visiteurs quittent un site en moins de 5 secondes s'il est lent ou confus</p>
        </div>
        <div class="bg-white rounded-2xl border border-neutral-200 p-8 text-center shadow-sm">
          <div class="text-4xl font-bold text-[var(--color-accent)] mb-2">0</div>
          <p class="text-sm text-neutral-600">feedback — vos visiteurs ne vous diront jamais pourquoi ils sont partis</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ COMMENT ÇA MARCHE ═══════════════════ -->
  <section class="w-full bg-neutral-50 border-y border-neutral-200 px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-3xl font-bold text-neutral-900 mb-12 md:text-4xl text-center">
        Comment ça marche
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Étape 1 -->
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-[var(--color-accent)]/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-3.07a4.5 4.5 0 00-6.364-6.364L4.5 6.207a4.5 4.5 0 006.364 6.364"/>
            </svg>
          </div>
          <div class="text-sm font-bold text-[var(--color-accent)] uppercase tracking-wide mb-2">Étape 1</div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Vous nous donnez votre URL</h3>
          <p class="text-sm text-neutral-500">Votre site web, c'est tout ce dont on a besoin. Aucun accès technique requis.</p>
        </div>

        <!-- Étape 2 -->
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-[var(--color-accent)]/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>
            </svg>
          </div>
          <div class="text-sm font-bold text-[var(--color-accent)] uppercase tracking-wide mb-2">Étape 2</div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">20 prospects IA visitent votre site</h3>
          <p class="text-sm text-neutral-500">Des profils réalistes : le plombier sur Google Maps, la coiffeuse sur Instagram, le syndic qui compare 3 devis. Chacun avec un appareil, un canal et un budget différent.</p>
        </div>

        <!-- Étape 3 -->
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-[var(--color-accent)]/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15a2.25 2.25 0 012.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z"/>
            </svg>
          </div>
          <div class="text-sm font-bold text-[var(--color-accent)] uppercase tracking-wide mb-2">Étape 3</div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Vous recevez leur verdict</h3>
          <p class="text-sm text-neutral-500">Qui vous a contacté, qui a hésité, qui est reparti — et surtout pourquoi. Avec des recommandations concrètes pour convertir plus.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ EXEMPLE DE RAPPORT ═══════════════════ -->
  <section class="w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-3xl font-bold text-white mb-4 md:text-4xl text-center">
        Voici ce que vous recevez
      </h2>
      <p class="text-neutral-400 text-center max-w-2xl mx-auto mb-12">
        Un rapport visuel interactif avec le feedback détaillé de chaque visiteur simulé.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
        <!-- Card: KPI -->
        <div class="bg-white/5 backdrop-blur rounded-2xl border border-white/10 p-6">
          <div class="text-sm font-bold text-[var(--color-accent)] uppercase tracking-wide mb-4">Tableau de bord</div>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-white/5 rounded-xl p-4 text-center">
              <div class="text-2xl font-bold text-emerald-400">50%</div>
              <div class="text-xs text-neutral-400 mt-1">Taux de conversion</div>
            </div>
            <div class="bg-white/5 rounded-xl p-4 text-center">
              <div class="text-2xl font-bold text-white">6.7</div>
              <div class="text-xs text-neutral-400 mt-1">Expérience / 10</div>
            </div>
            <div class="bg-white/5 rounded-xl p-4 text-center">
              <div class="text-2xl font-bold text-white">6.1</div>
              <div class="text-xs text-neutral-400 mt-1">Confiance / 10</div>
            </div>
            <div class="bg-white/5 rounded-xl p-4 text-center">
              <div class="text-2xl font-bold text-white">7.1</div>
              <div class="text-xs text-neutral-400 mt-1">Clarté / 10</div>
            </div>
          </div>
        </div>

        <!-- Card: Persona preview -->
        <div class="bg-white/5 backdrop-blur rounded-2xl border border-white/10 p-6">
          <div class="text-sm font-bold text-[var(--color-accent)] uppercase tracking-wide mb-4">Exemple de visiteur</div>
          <div class="flex items-start gap-3 mb-4">
            <span class="text-2xl">🔧</span>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-semibold text-white">Stéphane, 47 ans</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/30">Hésite</span>
              </div>
              <div class="text-xs text-neutral-400">Plombier, Woippy — Google Search / Mobile</div>
            </div>
          </div>
          <p class="text-sm text-neutral-300 italic mb-3">"Son concurrent vient de lancer un site moderne, il perd des appels depuis 6 mois"</p>
          <div class="space-y-2 text-xs">
            <div class="flex gap-2"><span class="text-emerald-400 shrink-0">+</span><span class="text-neutral-300">Prix affiché clairement, pas de devis à demander</span></div>
            <div class="flex gap-2"><span class="text-red-400 shrink-0">-</span><span class="text-neutral-300">Pas d'exemple artisan BTP en homepage</span></div>
            <div class="flex gap-2"><span class="text-red-400 shrink-0">-</span><span class="text-neutral-300">Site met 4.5 secondes à s'afficher sur mobile</span></div>
          </div>
        </div>
      </div>

      <!-- Features list -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
        <div class="text-center">
          <div class="text-2xl font-bold text-white">20</div>
          <div class="text-xs text-neutral-400">visiteurs simulés</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-white">6</div>
          <div class="text-xs text-neutral-400">canaux d'arrivée</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-white">4</div>
          <div class="text-xs text-neutral-400">scores techniques</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-white">Top 5</div>
          <div class="text-xs text-neutral-400">recommandations</div>
        </div>
      </div>

      <div class="text-center">
        <a href="/audit/marcm/" class="inline-flex items-center gap-2 text-[var(--color-accent)] hover:text-white transition-colors font-medium">
          Voir un rapport complet (120 visiteurs)
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PRICING ═══════════════════ -->
  <section class="w-full px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-3xl font-bold text-neutral-900 mb-4 md:text-4xl text-center">
        Choisissez votre formule
      </h2>
      <p class="text-neutral-500 text-center max-w-xl mx-auto mb-12">
        Les deux incluent : résultats en 48h et rapport confidentiel.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        <!-- Gratuit -->
        <div class="bg-white rounded-2xl border border-neutral-200 p-8 shadow-sm">
          <div class="text-sm font-bold text-neutral-400 uppercase tracking-wide mb-4">Découverte</div>
          <div class="flex items-baseline gap-1 mb-2">
            <span class="text-4xl font-bold text-neutral-900">Gratuit</span>
          </div>
          <p class="text-sm text-neutral-500 mb-6">Pour voir ce que vos visiteurs pensent vraiment.</p>

          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-2 text-sm text-neutral-700">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              5 visiteurs simulés
            </li>
            <li class="flex items-start gap-2 text-sm text-neutral-700">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Résumé : qui convertit, qui part
            </li>
            <li class="flex items-start gap-2 text-sm text-neutral-700">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              1 recommandation prioritaire
            </li>
            <li class="flex items-start gap-2 text-sm text-neutral-700">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Résultats par email sous 48h
            </li>
          </ul>

          <a href="#formulaire" class="block w-full text-center px-6 py-3 border-2 border-neutral-300 text-neutral-700 font-semibold rounded-xl hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-all">
            Tester gratuitement
          </a>
        </div>

        <!-- Complet -->
        <div class="bg-white rounded-2xl border-2 border-[var(--color-accent)] p-8 shadow-lg relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 bg-[var(--color-accent)] text-white text-xs font-bold rounded-full uppercase tracking-wide">
            Complet
          </div>
          <div class="text-sm font-bold text-[var(--color-accent)] uppercase tracking-wide mb-4">Rapport complet</div>
          <div class="flex items-baseline gap-1 mb-2">
            <span class="text-4xl font-bold text-neutral-900">90€</span>
            <span class="text-sm text-neutral-400">HT</span>
          </div>
          <p class="text-sm text-neutral-500 mb-6">Le diagnostic complet de votre site web.</p>

          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-2 text-sm text-neutral-700">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <strong>20 visiteurs simulés</strong> avec feedback détaillé
            </li>
            <li class="flex items-start gap-2 text-sm text-neutral-700">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Rapport interactif (personas cliquables)
            </li>
            <li class="flex items-start gap-2 text-sm text-neutral-700">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Audit technique (vitesse, sécurité, SEO, Schema.org)
            </li>
            <li class="flex items-start gap-2 text-sm text-neutral-700">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Recommandations priorisées par impact
            </li>
            <li class="flex items-start gap-2 text-sm text-neutral-700">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Page dédiée privée sur marcm.fr
            </li>
            <li class="flex items-start gap-2 text-sm text-neutral-700">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Conversion par canal (Google, Maps, IA, réseaux)
            </li>
          </ul>

          <a href="#formulaire" class="block w-full text-center px-6 py-3 bg-[var(--color-accent)] text-white font-semibold rounded-xl hover:opacity-90 transition-opacity">
            Commander — 90€ HT
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ SOCIAL PROOF ═══════════════════ -->
  <section class="w-full bg-neutral-50 border-y border-neutral-200 px-6 py-12 md:px-8">
    <div class="mx-auto max-w-5xl">
      <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-16 text-center">
        <div>
          <div class="text-3xl font-bold text-neutral-900">{vm.rapportsGeneres}+</div>
          <div class="text-sm text-neutral-500">rapports déjà générés</div>
        </div>
        <div class="hidden md:block w-px h-10 bg-neutral-300"></div>
        <div>
          <div class="text-3xl font-bold text-neutral-900">520+</div>
          <div class="text-sm text-neutral-500">visiteurs simulés au total</div>
        </div>
        <div class="hidden md:block w-px h-10 bg-neutral-300"></div>
        <div>
          <div class="text-3xl font-bold text-neutral-900">48h</div>
          <div class="text-sm text-neutral-500">délai de livraison</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ FAQ ═══════════════════ -->
  <section class="w-full px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold text-neutral-900 mb-10 md:text-4xl text-center">
        Questions fréquentes
      </h2>

      <div class="space-y-4">
        {faqItems.map((item, i) => (
          <details class="group bg-white rounded-xl border border-neutral-200 shadow-sm overflow-hidden" open={i === 0}>
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50 transition-colors">
              <span class="font-semibold text-neutral-900">{item.question}</span>
              <svg class="w-5 h-5 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-neutral-600 leading-relaxed">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ FORMULAIRE ═══════════════════ -->
  <section id="formulaire" class="w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="relative mx-auto max-w-xl z-10">
      <h2 class="text-3xl font-bold text-white mb-4 md:text-4xl text-center">
        Testez votre site gratuitement
      </h2>
      <p class="text-neutral-400 text-center mb-10">
        5 prospects IA visitent votre site et vous disent ce qu'ils en pensent. Résultats sous 48h.
      </p>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="space-y-5"
      >
        <input type="hidden" name="access_key" value="dccda1f5-4e63-4b9f-9c66-f5ce76f0dfdd" />
        <input type="text" name="botcheck" style="display: none;" />
        <input type="hidden" name="redirect" value="https://marcm.fr/merci" />
        <input type="hidden" name="subject" value="Visite Mystere — Nouvelle demande gratuite" />
        <input type="hidden" name="from_name" value="Visite Mystère — marcm.fr" />

        <!-- URL du site -->
        <div>
          <label for="vm-url" class="block text-sm font-medium text-neutral-300 mb-1.5">URL de votre site *</label>
          <input
            type="url"
            id="vm-url"
            name="url_site"
            placeholder="https://www.votre-site.fr"
            required
            class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder:text-neutral-500 focus:outline-none focus:border-[var(--color-accent)] focus:ring-1 focus:ring-[var(--color-accent)] transition-colors"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="vm-email" class="block text-sm font-medium text-neutral-300 mb-1.5">Votre email *</label>
          <input
            type="email"
            id="vm-email"
            name="email"
            placeholder="vous@exemple.fr"
            required
            class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder:text-neutral-500 focus:outline-none focus:border-[var(--color-accent)] focus:ring-1 focus:ring-[var(--color-accent)] transition-colors"
          />
        </div>

        <!-- Prénom -->
        <div>
          <label for="vm-prenom" class="block text-sm font-medium text-neutral-300 mb-1.5">Votre prénom</label>
          <input
            type="text"
            id="vm-prenom"
            name="prenom"
            placeholder="Marc"
            class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder:text-neutral-500 focus:outline-none focus:border-[var(--color-accent)] focus:ring-1 focus:ring-[var(--color-accent)] transition-colors"
          />
        </div>

        <!-- Activité -->
        <div>
          <label for="vm-activite" class="block text-sm font-medium text-neutral-300 mb-1.5">Votre activité</label>
          <select
            id="vm-activite"
            name="activite"
            class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white focus:outline-none focus:border-[var(--color-accent)] focus:ring-1 focus:ring-[var(--color-accent)] transition-colors"
          >
            <option value="" class="bg-neutral-800">-- Sélectionner --</option>
            <option value="Artisan" class="bg-neutral-800">Artisan</option>
            <option value="Commerce" class="bg-neutral-800">Commerce</option>
            <option value="Therapeute" class="bg-neutral-800">Thérapeute / Bien-être</option>
            <option value="Restaurant" class="bg-neutral-800">Restaurant / Food</option>
            <option value="Freelance" class="bg-neutral-800">Freelance / Consultant</option>
            <option value="Association" class="bg-neutral-800">Association</option>
            <option value="Autre" class="bg-neutral-800">Autre</option>
          </select>
        </div>

        <!-- Formule souhaitée -->
        <div>
          <label class="block text-sm font-medium text-neutral-300 mb-3">Formule souhaitée</label>
          <div class="grid grid-cols-2 gap-3">
            <label class="relative flex items-center justify-center gap-2 px-4 py-3 bg-white/10 border-2 border-white/20 rounded-xl cursor-pointer hover:border-[var(--color-accent)]/50 transition-colors has-[:checked]:border-[var(--color-accent)] has-[:checked]:bg-[var(--color-accent)]/10">
              <input type="radio" name="formule" value="Gratuit (5 visiteurs)" checked class="sr-only" />
              <span class="text-sm font-medium text-white">Gratuit</span>
              <span class="text-xs text-neutral-400">5 visiteurs</span>
            </label>
            <label class="relative flex items-center justify-center gap-2 px-4 py-3 bg-white/10 border-2 border-white/20 rounded-xl cursor-pointer hover:border-[var(--color-accent)]/50 transition-colors has-[:checked]:border-[var(--color-accent)] has-[:checked]:bg-[var(--color-accent)]/10">
              <input type="radio" name="formule" value="Complet (20 visiteurs) — 90€ HT" class="sr-only" />
              <span class="text-sm font-medium text-white">Complet</span>
              <span class="text-xs text-neutral-400">90€ HT</span>
            </label>
          </div>
        </div>

        <!-- RGPD -->
        <div class="flex items-start gap-3">
          <input type="checkbox" id="vm-rgpd" name="rgpd" required class="mt-1 rounded border-white/20 bg-white/10 text-[var(--color-accent)] focus:ring-[var(--color-accent)]" />
          <label for="vm-rgpd" class="text-xs text-neutral-400">
            J'accepte que mes données soient utilisées pour générer mon rapport. <a href="/politique-confidentialite" class="underline hover:text-white">Politique de confidentialité</a>
          </label>
        </div>

        <button
          type="submit"
          class="w-full px-8 py-4 bg-[var(--color-accent)] text-white font-semibold rounded-xl hover:opacity-90 transition-opacity text-lg"
        >
          Lancer ma Visite Mystère
        </button>

        <p class="text-center text-xs text-neutral-500">
          Gratuit, sans engagement. Rapport confidentiel sous 48h.
        </p>
      </form>
    </div>
  </section>

  <!-- ═══════════════════ CTA UPSELL ═══════════════════ -->
  <section class="w-full px-6 py-16 md:px-8 text-center">
    <div class="mx-auto max-w-2xl">
      <h2 class="text-2xl font-bold text-neutral-900 mb-3">
        Envie d'aller plus loin ?
      </h2>
      <p class="text-neutral-600 mb-8">
        Je crée aussi des sites qui convertissent — design sur mesure, visible sur Google et les IA, livré en 7 jours. À partir de 490€.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/commander" class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--color-accent)] text-white font-semibold rounded-xl hover:opacity-90 transition-opacity">
          Commander un site — 490€
        </a>
        <a href="/offre" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-neutral-300 text-neutral-700 font-semibold rounded-xl hover:border-neutral-400 transition-colors">
          Voir l'offre complète
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
