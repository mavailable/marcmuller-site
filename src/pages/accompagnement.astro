---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { getProjectsForCarousel } from '../data/projects';

const checkIcon = `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>`;
const crossIcon = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>`;

// Preuve : 2 avis clients réels, distincts des 3 études de cas ci-dessous
const reviews = getProjectsForCarousel('homepage')
  .filter((p) => p.review && !['DMulti Services', 'JD Zoothérapie'].includes(p.review.role))
  .slice(0, 2);

// 3 études de cas du journal (résultats réels, sources Google Search Console)
const caseStudies = [
  {
    href: '/journal/refonte-jd-zootherapeute/',
    client: 'JD Zoothérapie',
    lieu: 'Moselle',
    metric: '118 clics Google',
    detail: 'en un trimestre après la refonte, premier contact entrant reçu à J+5.',
  },
  {
    href: '/journal/site-web-securite-alarme-metz-etude-de-cas/',
    client: 'MM Sécurité',
    lieu: 'Metz',
    metric: '29 clics sur un seul article',
    detail: 'un blog SEO qui ramène à lui seul l\'essentiel du trafic Google du site.',
  },
  {
    href: '/journal/site-web-menuisier-vic-en-bigorre-etude-de-cas/',
    client: 'DMulti Services',
    lieu: 'Hautes-Pyrénées',
    metric: 'Page 1 sur Google',
    detail: 'position moyenne 4,6 sur sa requête métier, 90 jours après la mise en ligne.',
  },
];

const faqItems = [
  {
    question: 'Il y a un engagement de durée ?',
    answer: "Non. On avance mois par mois. Si tu veux arrêter, tu me préviens et c'est réglé, sans préavis à rallonge ni pénalité. L'idée, c'est que tu restes parce que ça t'apporte des clients, pas parce qu'un contrat te retient.",
  },
  {
    question: "C'est quoi le rythme, concrètement ?",
    answer: "Un point par semaine, 30 à 45 minutes en visio ou au téléphone. Entre deux points, j'avance sur ce qu'on a décidé : je construis, je rédige, je lance. Tu ne restes jamais 15 jours sans voir quelque chose bouger.",
  },
  {
    question: "Qu'est-ce qui est inclus ?",
    answer: "On prend les leviers dont tu as vraiment besoin : un site qui te ramène des clients, tes réseaux, de la prospection, un mini-CRM pour suivre tes prospects, tes devis et factures, tes relances. Pas de catalogue figé. On ajuste chaque mois selon ce qui te ramène des clients.",
  },
  {
    question: "Et le tarif ?",
    answer: "Pas de tarif tout fait : ça dépend de ce dont tu as besoin et du rythme qu'on cale. On en parle 15 minutes, je te dis par quoi commencer, et tu vois si ça matche. C'est sans engagement.",
  },
];
---

<BaseLayout
  title="L'accompagnement : ton bras droit, chaque semaine | Marc M"
  description="Le cœur de mon offre : on bosse ensemble chaque semaine, je mets les mains dedans comme un associé. Voici à quoi ressemble un mois avec moi, pour qui c'est, et la preuve en résultats."
  lang="fr"
  frPath="/accompagnement"
>
  <SchemaOrg type="localBusiness" />
  <SchemaOrg type="faqPage" data={faqItems} />

  <!-- HERO -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-16 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>

    <div class="mx-auto max-w-4xl text-center relative z-10">
      <div class="mb-6 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]">
        <span class="w-2 h-2 rounded-full" style="background-color: #E86C47;"></span>
        <span class="text-sm font-semibold text-white">Le cœur de mon offre</span>
      </div>

      <h1 class="mb-6 text-4xl font-bold leading-tight text-white md:text-5xl">
        Ton bras droit, chaque semaine.<br class="hidden md:block" />
        <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">Pas un consultant de plus.</span>
      </h1>
      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl mx-auto leading-relaxed">
        On bosse ensemble dans la durée. Je mets les mains dedans avec toi pour te ramener des clients, comme un associé, sans prendre tes parts.
      </p>

      <div class="mt-8 flex justify-center">
        <a
          href="https://cal.com/marc-muller/15min"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-2 rounded-xl px-8 py-4 text-base font-semibold text-white transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5"
          style="background: linear-gradient(135deg, #E86C47, #D4572F); box-shadow: 0 4px 20px rgba(232, 108, 71, 0.35);"
          data-umami-event="cal-cta-accompagnement"
          data-umami-event-position="hero"
        >
          On en parle ? 15 min, sans engagement
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <p class="mt-5 text-sm text-neutral-500">
        Tu veux d'abord voir comment je bosse ?
        <a href="/methode/" class="text-neutral-300 underline underline-offset-2 hover:text-white transition-colors" data-umami-event="accompagnement-methode-link">La méthode, en détail →</a>
      </p>
    </div>
  </section>

  <!-- LE PRINCIPE (éditorial, citationnable) -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-2xl">
      <p class="text-xl md:text-2xl leading-relaxed text-[var(--color-text)] font-medium mb-8">
        L'accompagnement, c'est le cœur de ce que je fais. On travaille ensemble dans la durée, chaque semaine, et j'avance avec toi pour te ramener des clients.
      </p>
      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-6">
        Le site, la prospection, les réseaux, le mini-CRM, tes devis et tes factures : on active ce dont tu as besoin, dans l'ordre qui compte. Pas tout en même temps. On prend le bon levier au bon moment, celui qui te ramène des clients le plus vite.
      </p>
      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)]">
        La différence avec un consultant classique : lui te fait un rapport, te facture et te laisse appliquer seul. Moi je fais avec toi. Je construis le site, je lance la prospection, on relance tes prospects ensemble. Tu n'es pas seul devant une liste de choses à faire qui n'avance jamais.
      </p>
    </div>
  </section>

  <!-- UN MOIS AVEC MOI -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-20 border-y" style="border-color: var(--color-border);">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent-text)] mb-3" style="letter-spacing: 0.2em;">Concrètement</p>
      <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)] mb-3">À quoi ressemble un mois avec moi</h2>
      <p class="text-[var(--color-text-muted)] mb-10 max-w-xl">Un point par semaine, et j'avance entre les points. Voici un mois type, sans version polie pour brochure. Ton mois à toi dépend de ce dont tu as besoin.</p>

      <div class="space-y-0">
        {[
          { num: '1', title: 'On met en route', detail: "On met en ligne la page qui te manquait et on lance ta première action pour aller chercher des clients. Dès la première semaine, quelque chose bouge." },
          { num: '2', title: 'On outille ta prospection', detail: "On écrit ensemble les messages que tu envoies à tes prospects, et on branche ton mini-CRM pour les suivre sans en oublier un seul." },
          { num: '3', title: 'On travaille ta visibilité', detail: "On publie un contenu qui te positionne sur Google et les IA, et on relance les prospects qui n'ont pas encore répondu." },
          { num: '4', title: 'On regarde les chiffres', detail: "Ce qui est rentré, ce qui a marché, ce qu'on lâche. On garde ce qui fonctionne et on cale le mois suivant." },
        ].map((e, i, arr) => (
          <div class="flex gap-5 md:gap-6 pb-8 relative">
            {i < arr.length - 1 && (
              <div class="absolute left-5 top-12 bottom-0 w-px bg-neutral-200"></div>
            )}
            <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center font-bold text-white text-sm z-10" style="background-color: #E86C47;">
              {e.num}
            </div>
            <div class="pt-1.5">
              <div class="flex items-center gap-3 mb-1.5">
                <h3 class="font-bold text-[var(--color-text)]">{e.title}</h3>
                <span class="text-xs text-neutral-400 bg-neutral-100 px-2 py-0.5 rounded-full">Semaine {e.num}</span>
              </div>
              <p class="text-[var(--color-text-muted)] text-sm leading-relaxed">{e.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CE QUE JE FAIS / CE QUE JE NE FAIS PAS -->
  <section class="w-full px-6 py-16 md:px-8 md:py-20" style="background: #FAFAFA;">
    <div class="mx-auto max-w-4xl">
      <div class="grid gap-8 md:grid-cols-2">
        <!-- Je fais -->
        <div class="rounded-2xl bg-white border border-[var(--color-border)] p-7 md:p-8">
          <h3 class="text-lg font-bold text-[var(--color-text)] mb-5">Ce que je fais</h3>
          <ul class="space-y-4">
            {[
              'Je mets les mains dans le cambouis avec toi : je construis, je rédige, je lance.',
              'Je te dis quoi faire, et je le fais avec toi. Pas juste un conseil que tu appliques seul.',
              'Je te livre des outils que tu gardes : ton site, ton CRM, tes modèles, tout est à toi.',
              'Je regarde tes vrais chiffres chaque mois, et on ajuste ce qui ne marche pas.',
            ].map((item) => (
              <li class="flex items-start gap-3">
                <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
                <span class="text-sm text-[var(--color-text)]">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Je ne fais pas -->
        <div class="rounded-2xl bg-white border border-[var(--color-border)] p-7 md:p-8">
          <h3 class="text-lg font-bold text-[var(--color-text)] mb-5">Ce que je ne fais pas</h3>
          <ul class="space-y-4">
            {[
              'Pas de PowerPoint, pas de rapport que tu ranges dans un tiroir.',
              "Pas de grand plan à 12 mois qui prend la poussière. On avance par actions concrètes.",
              'Pas de jargon, pas de théorie lue dans un livre. Je te parle d\'expérience.',
              'Je ne prends pas tes parts, et je ne te rends pas dépendant de moi.',
            ].map((item) => (
              <li class="flex items-start gap-3">
                <span class="text-neutral-400 flex-shrink-0 w-5 h-5 mt-0.5" set:html={crossIcon} />
                <span class="text-sm text-[var(--color-text-muted)]">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- POUR QUI / PAS POUR QUI -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-20">
    <div class="mx-auto max-w-4xl">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)]">C'est fait pour toi ?</h2>
        <p class="mt-3 text-[var(--color-text-muted)] max-w-2xl mx-auto">Autant être clair tout de suite. L'accompagnement, ça marche dans un cas et pas dans l'autre.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- Pour toi si -->
        <div class="rounded-2xl border-2 p-7 md:p-8" style="border-color: rgba(232, 108, 71, 0.4); background: rgba(232, 108, 71, 0.04);">
          <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-accent-text)] mb-5" style="letter-spacing: 0.12em;">Pour toi si</p>
          <ul class="space-y-4">
            {[
              'Tu vis de ton métier mais tu galères à avoir des clients réguliers.',
              "Tu n'as personne d'entrepreneur autour de toi à qui demander conseil.",
              'Tu veux avancer pour de vrai, pas juste réfléchir encore six mois.',
              'Tu es prêt à mettre un peu de toi chaque semaine : on fait ensemble, pas à ta place.',
            ].map((item) => (
              <li class="flex items-start gap-3">
                <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
                <span class="text-sm text-[var(--color-text)]">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Pas pour toi si -->
        <div class="rounded-2xl border border-[var(--color-border)] bg-white p-7 md:p-8">
          <p class="text-sm font-bold uppercase tracking-wider text-neutral-500 mb-5" style="letter-spacing: 0.12em;">Pas pour toi si</p>
          <ul class="space-y-4">
            {[
              "Tu cherches à tout déléguer sans jamais t'impliquer.",
              'Tu veux juste une prestation ponctuelle et cadrée : dans ce cas, prends une brique.',
              'Tu attends des résultats magiques du jour au lendemain, sans rien changer à ta façon de faire.',
            ].map((item) => (
              <li class="flex items-start gap-3">
                <span class="text-neutral-400 flex-shrink-0 w-5 h-5 mt-0.5" set:html={crossIcon} />
                <span class="text-sm text-[var(--color-text-muted)]">{item}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-[var(--color-text-muted)]">
            Tu veux juste une pièce ?
            <a href="/offre/#briques" class="text-[var(--color-accent-text)] hover:underline font-medium" data-umami-event="accompagnement-briques-link">Vois les briques à la carte →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- LA PREUVE -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="text-center mb-12">
        <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent-text)] mb-3" style="letter-spacing: 0.2em;">La preuve</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)]">Des résultats concrets, mesurés</h2>
        <p class="mt-3 text-[var(--color-text-muted)] max-w-2xl mx-auto">Je ne suis pas un coach qui parle. Voici des indépendants que j'ai aidés à devenir visibles, avec des chiffres vérifiables (source Google Search Console).</p>
      </div>

      <!-- Études de cas -->
      <div class="grid gap-5 md:grid-cols-3 mb-12">
        {caseStudies.map((c) => (
          <a
            href={c.href}
            class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-6 flex flex-col transition-all hover:shadow-md hover:-translate-y-0.5"
            data-umami-event="accompagnement-case-study"
            data-umami-event-client={c.client}
          >
            <div class="text-2xl font-extrabold mb-2" style="color: #E86C47;">{c.metric}</div>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed flex-grow">{c.detail}</p>
            <div class="mt-4 pt-4 border-t border-[var(--color-border)]">
              <p class="text-sm font-semibold text-[var(--color-text)]">{c.client}</p>
              <p class="text-xs text-[var(--color-text-muted)]">{c.lieu}</p>
            </div>
            <span class="mt-3 text-xs font-medium text-[var(--color-accent-text)] opacity-0 group-hover:opacity-100 transition-opacity">Lire l'étude de cas →</span>
          </a>
        ))}
      </div>

      <!-- Avis clients -->
      <div class="grid gap-6 md:grid-cols-2">
        {reviews.map((p) => (
          <div class="rounded-2xl border border-[var(--color-border)] bg-white p-7 shadow-sm flex flex-col">
            <div class="mb-4 flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-accent)] text-sm font-bold text-white">{p.review!.author[0]}</div>
              <div>
                <p class="font-semibold text-[var(--color-text)]">{p.review!.author}</p>
                <p class="text-xs text-[var(--color-text-muted)]">{p.review!.role}</p>
              </div>
              <svg class="h-5 w-5 shrink-0 ml-auto" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
            </div>
            <div class="mb-3 flex gap-0.5">
              {[...Array(5)].map(() => <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>)}
            </div>
            <p class="text-[var(--color-text-muted)] leading-relaxed flex-1 text-[15px]">"{p.review!.text}"</p>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="/realisations/" class="inline-flex items-center gap-2 text-sm font-medium text-[var(--color-accent-text)] hover:underline" data-umami-event="accompagnement-realisations-link">
          Voir toutes les réalisations
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl">
      <SectionTitle title="Les questions qu'on me pose" align="center" />

      <div class="mt-12 space-y-3">
        {faqItems.map((item, i) => (
          <details class="group rounded-xl bg-white p-6 border border-[var(--color-border)] hover:shadow-sm transition-all" open={i === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-3 font-bold text-[var(--color-text)]">
              <span>{item.question}</span>
              <svg class="h-5 w-5 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24" style="background: linear-gradient(135deg, #1A1A1A 0%, #111111 100%);">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="mx-auto max-w-3xl text-center relative z-10">
      <h2 class="mb-4 text-3xl font-bold text-white">On regarde ta situation ensemble ?</h2>
      <p class="mb-8 text-lg text-neutral-300">
        15 minutes, tu me dis où tu en es, je te dis par quoi commencer. Sans engagement, et sans jargon.
      </p>
      <div class="flex justify-center">
        <a
          href="https://cal.com/marc-muller/15min"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-accent)] px-8 py-4 text-base font-semibold text-white transition-all duration-300 hover:bg-[var(--color-accent-hover)] hover:shadow-lg hover:-translate-y-0.5"
          style="box-shadow: 0 0 40px rgba(232, 108, 71, 0.3);"
          data-umami-event="cal-cta-accompagnement"
          data-umami-event-position="final"
        >
          On en parle, 15 min
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  details[open] summary svg {
    transform: rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll('details').forEach((el) => {
    el.addEventListener('toggle', () => {
      if (el.open) {
        const question = el.querySelector('summary span')?.textContent?.trim() || '';
        if (typeof (window as any).umami !== 'undefined') {
          (window as any).umami.track('accompagnement-faq-open', { question: question.slice(0, 80) });
        }
      }
    });
  });
</script>
