---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { business } from '../../data/business';

const title = 'Acheter votre nom de domaine chez OVH et le brancher · Marc M';
const description = 'Guide complet pour réserver votre nom de domaine .fr ou .com chez OVH, puis le brancher sur votre site en changeant deux serveurs DNS. 10 minutes.';

const breadcrumbs = [
  { name: 'Accueil', url: `${business.url}/` },
  { name: 'Aide', url: `${business.url}/aide/` },
  { name: 'Nom de domaine OVH', url: `${business.url}/aide/domaine-ovh/` },
];

const steps = [
  {
    name: 'Allez sur la page Noms de domaine d\'OVH',
    text: 'Cliquez sur le lien ci-dessous pour accéder directement à la page de recherche de noms de domaine.',
    link: { href: 'https://www.ovhcloud.com/fr/domains/', label: 'Ouvrir OVH — Noms de domaine' },
    image: '/images/aide/ovh-recherche-domaine.webp',
    imageAlt: 'Page de recherche de noms de domaine sur OVH — barre de recherche et extensions disponibles',
  },
  {
    name: 'Cherchez votre domaine',
    text: 'Tapez le nom souhaité (ex. mon-entreprise.fr) dans la barre de recherche en haut de page. OVH vous indique immédiatement s\'il est disponible et propose des alternatives.',
  },
  {
    name: 'Choisissez l\'extension',
    text: 'Privilégiez le .fr si votre clientèle est en France. Le .com est un bon complément. Comptez environ 7 €/an pour un .fr.',
  },
  {
    name: 'Créez votre compte OVH',
    text: 'Si c\'est votre première commande, cliquez sur "Créer un compte" sur la page de connexion. Utilisez votre email professionnel et notez bien vos identifiants.',
    link: { href: 'https://www.ovh.com/auth/?onsuccess=https%3A%2F%2Fwww.ovh.com%2Fmanager&ovhSubsidiary=FR', label: 'Ouvrir la page de connexion OVH' },
    image: '/images/aide/ovh-connexion.webp',
    imageAlt: 'Page de connexion OVH — formulaire pour se connecter ou créer un compte',
  },
  {
    name: 'Passez commande',
    text: 'Ajoutez le domaine au panier. Décochez les options inutiles (hébergement, email OVH — on n\'en a pas besoin). Validez et payez.',
    tip: 'Seul le nom de domaine est nécessaire. Votre site sera hébergé ailleurs — c\'est inclus dans ma prestation.',
  },
  {
    name: 'Prévenez-moi que le domaine est acheté',
    text: 'Envoyez-moi le nom exact du domaine par email ou WhatsApp. Précisez surtout si une adresse email professionnelle tourne déjà sur ce nom de domaine (Google Workspace, OVH, autre) : c\'est le seul point à ne pas casser.',
    detail: 'De mon côté, je prépare la configuration de votre domaine chez Cloudflare, là où votre site est hébergé, en recopiant à l\'identique ce qui existe déjà : email, vérifications Google, ancien site. Tant que vous ne changez rien, rien ne bouge pour vos visiteurs.',
  },
  {
    name: 'Je vous envoie 2 adresses de serveurs DNS',
    text: 'Sous 24 heures, vous recevez deux lignes de cette forme, générées spécialement pour votre domaine :',
    sample: ['xxxxx.ns.cloudflare.com', 'yyyyy.ns.cloudflare.com'],
    sampleNote: 'Exemple de format uniquement. Les deux vraies adresses sont dans mon message, ne recopiez pas celles-ci.',
    detail: 'Ce sont ces serveurs qui indiquent à internet où trouver votre site et votre email. C\'est la seule chose que vous aurez à coller.',
  },
  {
    name: 'Changez vos 2 serveurs DNS chez OVH',
    text: 'Dans votre espace client OVH, ouvrez votre domaine puis l\'onglet « Serveurs DNS ». Cliquez sur « Modifier les serveurs DNS », choisissez l\'option serveurs DNS externes (parfois affichée « configuration personnalisée »), remplacez les deux lignes existantes par celles que je vous ai envoyées, et validez.',
    detail: 'Comptez 2 minutes. Le changement se propage en moins d\'une heure en général, 24 heures au maximum. Vous ne touchez à aucun autre réglage.',
    link: { href: 'https://manager.eu.ovhcloud.com/#/web-domains/domain', label: 'Ouvrir mes domaines dans l\'espace client OVH' },
    path: 'Espace client > Noms de domaine > votre-domaine.fr > Serveurs DNS > Modifier les serveurs DNS',
    tip: 'Si vous avez activé l\'option DNSSEC sur votre domaine, dites-le moi avant de valider : il faut la désactiver quelques heures plus tôt, sinon le domaine devient injoignable.',
  },
  {
    name: 'Confirmez-moi que c\'est fait',
    text: 'Un simple message suffit. Je vérifie la propagation, je teste que votre email fonctionne toujours, puis je branche le site sur votre domaine.',
  },
];

const howToSteps = steps.map(s => ({ name: s.name, text: s.text }));

const faq = [
  {
    question: 'Pourquoi OVH et pas un autre registrar ?',
    answer: 'OVH est le premier registrar français (bureau d\'enregistrement de noms de domaine). Le support est en français, les prix sont parmi les plus bas du marché, et la gestion est simple. C\'est ce que je recommande à tous mes clients.',
  },
  {
    question: 'Faut-il aussi prendre l\'hébergement chez OVH ?',
    answer: 'Non. Votre site sera hébergé sur Cloudflare Pages, c\'est inclus dans ma prestation. Chez OVH, vous n\'avez besoin que du nom de domaine.',
  },
  {
    question: 'Comment choisir un bon nom de domaine ?',
    answer: 'Choisissez un nom court, facile à épeler au téléphone, sans tirets si possible. L\'idéal : le nom de votre entreprise suivi de .fr.',
  },
  {
    question: 'Est-ce que je reste propriétaire de mon domaine ?',
    answer: 'Oui. Changer les serveurs DNS ne transfère rien et ne me donne aucun accès à votre compte OVH. Le domaine reste à votre nom, payé par vous, et vous êtes le seul à pouvoir le renouveler, le vendre, ou remettre les anciens réglages. Je n\'ai jamais votre mot de passe.',
  },
  {
    question: 'Mon adresse email professionnelle va-t-elle continuer à fonctionner ?',
    answer: 'Oui. Avant tout changement, je recopie vos réglages email à l\'identique dans la nouvelle configuration, et je teste l\'envoi et la réception juste après la bascule. Dites-moi simplement quelles adresses tournent sur le domaine, c\'est le point que je vérifie en premier.',
  },
  {
    question: 'Combien de temps ça prend, et mon site peut-il tomber ?',
    answer: 'Deux minutes de votre côté. La propagation prend moins d\'une heure en général, 24 heures au maximum, et votre site actuel continue de répondre pendant ce temps : vos visiteurs ne voient rien.',
  },
  {
    question: 'Et si quelque chose se passe mal ?',
    answer: 'On remet vos deux anciens serveurs DNS au même endroit et tout revient comme avant en moins d\'une heure. Je les note avant de commencer, et je vous conseille de les noter aussi. Tant que votre ancien site tourne, le retour arrière est immédiat.',
  },
  {
    question: 'Pourquoi ne pas me demander de vous désigner comme contact technique ?',
    answer: 'Parce que chez OVH ça ne sert à rien : le contact technique ne donne pas accès à l\'écran des serveurs DNS. Le changement que vous faites vous-même en 2 minutes est plus simple, plus rapide, et vous garde la main sur votre domaine.',
  },
];
---

<BaseLayout title={title} description={description} lang="fr" frPath="/aide/domaine-ovh" enPath="/en/help/ovh-domain" noindex>

  <SchemaOrg type="breadcrumb" data={breadcrumbs} />
  <SchemaOrg type="howTo" data={{
    name: 'Acheter un nom de domaine chez OVH et le brancher sur votre site',
    description: 'Guide pour réserver votre nom de domaine .fr ou .com sur OVH, puis le brancher sur votre site en changeant ses deux serveurs DNS.',
    totalTime: 'PT10M',
    steps: howToSteps,
  }} />
  <SchemaOrg type="faqPage" data={faq} />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative mx-auto max-w-3xl z-10">
      <a href="/aide" class="inline-flex items-center gap-2 text-sm text-neutral-300 hover:text-white transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
        Retour aux guides
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-block rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-xs font-semibold text-sky-300">
          Domaine
        </span>
        <span class="text-sm text-neutral-400">~10 minutes</span>
        <span class="text-sm text-neutral-400">•</span>
        <span class="text-sm text-neutral-400">Domaine ~7 €/an</span>
      </div>

      <h1 class="mb-6 text-3xl font-bold leading-tight text-white md:text-5xl">
        Acheter votre nom de domaine chez OVH
      </h1>
      <p class="text-lg text-neutral-300 md:text-xl leading-relaxed">
        Votre nom de domaine, c'est l'adresse de votre site sur internet. Voici comment le réserver en quelques minutes, puis le brancher sur votre site en changeant deux lignes chez OVH.
      </p>
    </div>
  </section>

  <!-- GUIDE BODY -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl">
      <article class="rounded-xl bg-white border border-[var(--color-border)] p-8 md:p-12 shadow-sm">

        <!-- Déjà propriétaire -->
        <div class="mb-10 rounded-lg bg-sky-50 border border-sky-200 p-5">
          <p class="text-sm font-semibold text-sky-800 mb-1">Vous avez déjà votre domaine chez OVH ?</p>
          <p class="text-sm text-sky-700 leading-relaxed">
            Inutile d'en racheter un ou de le transférer. Sautez directement à l'étape 6 : vous me prévenez, je prépare la configuration de votre côté, et vous changez deux lignes chez OVH. Votre site actuel et votre email continuent de tourner pendant toute la préparation.
          </p>
        </div>

        <!-- Steps -->
        <div class="space-y-10">
          {steps.map((step, i) => (
            <div class="flex gap-5">
              <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent)] text-white font-bold text-sm shadow-md">
                {i + 1}
              </div>
              <div class="flex-1 pt-1.5">
                <h2 class="text-lg font-bold text-[var(--color-text)] mb-2">{step.name}</h2>
                <p class="text-[var(--color-text-muted)] leading-relaxed">{step.text}</p>

                {/* Exemple de serveurs DNS (format, non copiable volontairement) */}
                {step.sample && (
                  <div class="mt-3">
                    <div class="rounded-lg bg-[#0D0D0D] px-5 py-3 space-y-1 max-w-fit">
                      {step.sample.map((line) => (
                        <code class="block text-base font-mono font-bold text-white tracking-wide">{line}</code>
                      ))}
                    </div>
                    {step.sampleNote && (
                      <p class="mt-2 text-xs text-[var(--color-text-muted)]">{step.sampleNote}</p>
                    )}
                  </div>
                )}

                {/* Additional detail */}
                {step.detail && (
                  <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{step.detail}</p>
                )}

                {/* Navigation path */}
                {step.path && (
                  <div class="mt-3 rounded-lg bg-neutral-50 border border-neutral-200 px-4 py-2.5">
                    <p class="text-xs font-semibold text-neutral-500 mb-1">Chemin dans l'espace client</p>
                    <p class="text-sm font-mono text-neutral-700">{step.path}</p>
                  </div>
                )}

                {/* Tip */}
                {step.tip && (
                  <div class="mt-3 rounded-lg bg-amber-50 border border-amber-200 px-4 py-2.5">
                    <p class="text-sm text-amber-700">{step.tip}</p>
                  </div>
                )}

                {/* External link */}
                {step.link && (
                  <a href={step.link.href} target="_blank" rel="noopener noreferrer"
                    class="mt-3 inline-flex items-center gap-2 rounded-lg border border-[var(--color-accent)]/20 bg-[var(--color-accent)]/5 px-4 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] hover:bg-[var(--color-accent)]/10 transition-colors"
                    data-umami-event="aide-domaine-lien-externe" data-umami-event-url={step.link.href}>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    {step.link.label}
                  </a>
                )}

                {/* Screenshot */}
                {step.image && (
                  <div class="mt-4 rounded-lg border border-[var(--color-border)] overflow-hidden shadow-sm">
                    <img src={step.image} alt={step.imageAlt} width="1280" height="900" loading="lazy" decoding="async" class="w-full h-auto" />
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Tips -->
        <div class="mt-10 rounded-lg bg-amber-50 border border-amber-200 p-5">
          <p class="text-sm font-semibold text-amber-800 mb-2">Conseils</p>
          <ul class="list-disc pl-4 text-sm text-amber-700 leading-relaxed space-y-1.5">
            <li>Les serveurs DNS sont le seul réglage à toucher. Le reste de la zone DNS, je m'en charge.</li>
            <li>Notez vos deux anciens serveurs DNS avant de les remplacer : c'est votre retour arrière en cas de doute.</li>
            <li>Pensez à activer le renouvellement automatique du domaine (OVH envoie aussi un rappel par email).</li>
            <li>Si le .fr est pris, essayez le .com ou une variante avec votre ville.</li>
          </ul>
        </div>

        <!-- FAQ -->
        <div class="mt-10 space-y-4">
          <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-text-muted)]">Questions fréquentes</p>
          {faq.map((item) => (
            <details class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-4 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-text)] transition-colors [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-4 pb-4">
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{item.answer}</p>
              </div>
            </details>
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-10 rounded-xl bg-[#0D0D0D] p-6 text-center">
          <p class="text-white font-semibold mb-2">Une fois le domaine acheté</p>
          <p class="text-neutral-300 text-sm mb-5">Envoyez-moi son nom exact par email ou WhatsApp. Je prépare la configuration et je vous renvoie les 2 serveurs DNS à coller.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href={`mailto:${business.email}?subject=Domaine OVH acheté&body=Bonjour Marc,%0A%0AJ'ai acheté mon domaine chez OVH.%0A%0AMon domaine : %0AUne adresse email professionnelle tourne dessus : oui / non%0ASi oui, laquelle (Google Workspace, OVH, autre) : %0A%0AMerci !`}
              class="inline-block px-6 py-2.5 bg-[var(--color-accent)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--color-accent-hover)] transition-all"
              data-umami-event="aide-domaine-email">
              Envoyer par email
            </a>
            <a href={`https://wa.me/${business.whatsapp}?text=Bonjour Marc, j'ai acheté mon domaine chez OVH. Mon domaine : . Une adresse email pro tourne dessus : oui/non`}
              target="_blank" rel="noopener noreferrer"
              class="inline-block px-6 py-2.5 bg-white/10 text-white text-sm font-semibold rounded-lg border border-white/20 hover:bg-white/20 transition-all"
              data-umami-event="aide-domaine-whatsapp">
              Envoyer par WhatsApp
            </a>
          </div>
        </div>

        <!-- Next guide -->
        <div class="mt-8 flex items-center justify-between rounded-lg border border-[var(--color-border)] p-4">
          <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-muted)]">Guide suivant</span>
          <a href="/aide/web3forms" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-text)] hover:gap-3 transition-all">
            Créer votre compte Web3Forms
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </article>
    </div>
  </section>

</BaseLayout>
