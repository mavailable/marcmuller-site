---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { business } from '../../data/business';

const title = 'Créer votre compte Resend et m\'envoyer la clé : guide pas-à-pas · Marc M';
const description = 'Créez un compte Resend gratuit en quelques minutes, générez une clé d\'envoi et transmettez-la moi pour activer les emails automatiques de votre site.';

// Clé Web3Forms (identique au formulaire de contact marcm.fr)
const WEB3FORMS_KEY = 'dccda1f5-4e63-4b9f-9c66-f5ce76f0dfdd';

const breadcrumbs = [
  { name: 'Accueil', url: `${business.url}/` },
  { name: 'Aide', url: `${business.url}/aide/` },
  { name: 'Resend', url: `${business.url}/aide/resend/` },
];

const howToSteps = [
  { name: 'Créez votre compte sur Resend', text: 'Rendez-vous sur resend.com et cliquez sur « Sign Up » (ou « Get Started »). Créez votre compte avec votre email et un mot de passe, ou directement via Google ou GitHub. C\'est gratuit et sans carte bancaire.' },
  { name: 'Confirmez votre email', text: 'Resend vous envoie un email de confirmation. Ouvrez-le et cliquez sur le lien pour valider votre compte. Pensez à vérifier vos spams si vous ne le voyez pas.' },
  { name: 'Ouvrez « API Keys »', text: 'Une fois connecté, dans le menu de gauche du tableau de bord, cliquez sur « API Keys », puis sur le bouton « Create API Key » en haut à droite.' },
  { name: 'Réglez la clé', text: 'Donnez un nom à la clé (par exemple « Mon site »). Pour la permission, choisissez « Sending access » (envoi seul). Laissez le domaine sur « All domains ». Validez (bouton « Add » ou « Create »).' },
  { name: 'Copiez la clé', text: 'Resend affiche votre clé, elle commence par « re_ ». Important : elle n\'est visible qu\'une seule fois. Copiez-la tout de suite avec le bouton prévu à côté.' },
  { name: 'Collez la clé dans le formulaire ci-dessous', text: 'Revenez sur cette page, collez la clé dans le formulaire juste en dessous, indiquez votre nom, puis cliquez sur Envoyer. Je m\'occupe du reste.' },
];

const faq = [
  {
    question: 'Resend est-il vraiment gratuit ?',
    answer: 'Oui. Le plan gratuit permet d\'envoyer 3 000 emails par mois (jusqu\'à 100 par jour), ce qui est largement suffisant pour un site vitrine ou une petite boutique. Aucune carte bancaire n\'est demandée à l\'inscription.',
  },
  {
    question: 'La clé n\'est visible qu\'une fois, et je l\'ai perdue. Que faire ?',
    answer: 'Pas de souci. Retournez dans « API Keys », supprimez l\'ancienne clé, puis créez-en une nouvelle en suivant les mêmes étapes. Transmettez-moi la nouvelle clé, c\'est celle-là que j\'utiliserai.',
  },
  {
    question: 'Est-ce que vous avez accès à mon compte Resend ?',
    answer: 'Non. Vous me transmettez uniquement une clé d\'envoi (« Sending access »), qui sert seulement à envoyer des emails depuis votre site. Je n\'ai aucun accès à votre compte, à vos identifiants ou à vos autres réglages. Et vous pouvez supprimer cette clé quand vous voulez.',
  },
  {
    question: 'À quoi servent ces emails exactement ?',
    answer: 'Cela dépend de votre site : confirmer une commande ou une réservation à votre client, lui envoyer sa facture, ou vous prévenir d\'une nouvelle demande. Ce sont des emails déclenchés automatiquement, sans action de votre part.',
  },
];
---

<BaseLayout title={title} description={description} lang="fr" frPath="/aide/resend" enPath="/en/help/resend" noindex>

  <SchemaOrg type="breadcrumb" data={breadcrumbs} />
  <SchemaOrg type="howTo" data={{
    name: 'Créer un compte Resend et transmettre la clé d\'envoi',
    description: 'Guide pour créer un compte Resend gratuit, générer une clé d\'envoi et la transmettre pour activer les emails automatiques du site.',
    totalTime: 'PT5M',
    steps: howToSteps,
  }} />
  <SchemaOrg type="faqPage" data={faq} />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative mx-auto max-w-3xl z-10">
      <a href="/aide" class="inline-flex items-center gap-2 text-sm text-neutral-300 hover:text-white transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
        Retour aux guides
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-block rounded-full border border-teal-400/30 bg-teal-400/10 px-3 py-1 text-xs font-semibold text-teal-300">
          Emails
        </span>
        <span class="text-sm text-neutral-400">~5 minutes</span>
        <span class="text-sm text-neutral-400">•</span>
        <span class="text-sm text-neutral-400">100% gratuit</span>
      </div>

      <h1 class="mb-6 text-3xl font-bold leading-tight text-white md:text-5xl">
        Créer votre compte Resend
      </h1>
      <p class="text-lg text-neutral-300 md:text-xl leading-relaxed">
        Quelques minutes pour activer les emails automatiques de votre site.
      </p>
    </div>
  </section>

  <!-- GUIDE BODY -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl">
      <article class="rounded-xl bg-white border border-[var(--color-border)] p-8 md:p-12 shadow-sm">

        <!-- Intro -->
        <p class="text-[var(--color-text-muted)] leading-relaxed mb-6">
          Votre site envoie des emails automatiques à vos clients : confirmations de commande ou de réservation, factures, notifications. Pour que ces emails partent de façon fiable, votre site s'appuie sur un service spécialisé, Resend. Vous créez votre propre compte Resend (gratuit), vous générez une petite clé, et vous me la transmettez via le formulaire en bas de page. Je la branche dans votre site, et c'est terminé.
        </p>

        <!-- Pourquoi c'est sans risque -->
        <div class="mb-6 rounded-lg bg-teal-50 border border-teal-200 p-5">
          <p class="text-sm font-semibold text-teal-800 mb-1">Pourquoi c'est sans risque</p>
          <p class="text-sm text-teal-700 leading-relaxed">
            La clé que vous me transmettez a la permission « envoi seul » (Sending access) : elle ne sert qu'à envoyer des emails, elle ne donne aucun accès à votre compte. Vous pouvez la supprimer à tout moment depuis votre tableau de bord Resend, d'un seul clic. Vous restez seul propriétaire de votre compte.
          </p>
        </div>

        <!-- Ce qu'il vous faut -->
        <div class="mb-10 rounded-lg bg-sky-50 border border-sky-200 p-5">
          <p class="text-sm font-semibold text-sky-800 mb-1">Ce qu'il vous faut</p>
          <p class="text-sm text-sky-700 leading-relaxed">
            Une adresse email et environ 5 minutes. Aucune carte bancaire n'est demandée : le plan gratuit de Resend couvre 3 000 emails par mois, largement suffisant.
          </p>
        </div>

        <!-- Steps -->
        <div class="space-y-8">
          {howToSteps.map((step, i) => (
            <div class="flex gap-5">
              <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent)] text-white font-bold text-sm shadow-md">
                {i + 1}
              </div>
              <div class="flex-1 pt-1.5">
                <h2 class="text-lg font-bold text-[var(--color-text)] mb-2">{step.name}</h2>
                {i === 0 ? (
                  <p class="text-[var(--color-text-muted)] leading-relaxed">
                    Rendez-vous sur <a href="https://resend.com/" target="_blank" rel="noopener noreferrer" class="font-semibold text-[var(--color-accent-text)] underline hover:text-[var(--color-accent)] transition-colors">resend.com</a> et cliquez sur « Sign Up » (ou « Get Started »). Créez votre compte avec votre email et un mot de passe, ou directement via Google ou GitHub. C'est gratuit et sans carte bancaire.
                  </p>
                ) : (
                  <p class="text-[var(--color-text-muted)] leading-relaxed">{step.text}</p>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- À quoi ressemble la clé -->
        <div class="mt-10 rounded-lg bg-neutral-50 border border-neutral-200 p-5">
          <p class="text-sm font-semibold text-neutral-700 mb-2">À quoi ressemble la clé ?</p>
          <code class="block bg-neutral-100 rounded-lg px-4 py-3 text-sm font-mono text-neutral-600 break-all">
            re_a1b2c3d4_E5f6G7h8I9j0K1l2M3n4O5p6
          </code>
        </div>

        <!-- FORMULAIRE -->
        <div class="mt-12 pt-10 border-t border-[var(--color-border)]">
          <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">Transmettez-moi votre clé</h2>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6">
            Collez la clé qui commence par « re_ » et indiquez votre nom pour que je sache à qui elle appartient. Le formulaire me l'envoie directement par email, rien n'est stocké sur cette page.
          </p>

          <div aria-live="polite" aria-atomic="true" class="sr-only" id="form-status"></div>

          <!-- Message de succès (caché par défaut, affiché après envoi via JS) -->
          <div id="form-success" class="hidden rounded-xl bg-emerald-50 border border-emerald-200 p-6">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 shrink-0 text-emerald-600 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <div>
                <p class="text-base font-bold text-emerald-800 mb-1">Clé bien reçue</p>
                <p class="text-sm text-emerald-700 leading-relaxed">
                  Merci ! Votre clé est envoyée. Je la branche dans votre site et je vous confirme dès que c'est actif. Vous n'avez plus rien à faire.
                </p>
              </div>
            </div>
          </div>

          <form
            id="resend-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-5"
          >
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="subject" value="Clé API Resend (nouveau client)" />
            <input type="hidden" name="from_name" value="Formulaire Resend marcm.fr" />
            <!-- Repli sans JavaScript : redirection vers la page de remerciement -->
            <input type="hidden" name="redirect" value="https://marcm.fr/merci" />
            <!-- Honeypot anti-spam -->
            <input type="text" name="botcheck" tabindex="-1" autocomplete="off" style="display: none;" />

            <div>
              <label for="client" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                Votre nom ou le nom de votre site *
              </label>
              <input
                type="text"
                id="client"
                name="client"
                required
                class="w-full rounded-lg bg-white px-4 py-3 text-[var(--color-text)] placeholder-[var(--color-text-muted)] border border-[var(--color-border)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent transition-all"
                placeholder="Ex : Boulangerie Martin"
              />
            </div>

            <div>
              <label for="cle_api" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                Votre clé API Resend *
              </label>
              <input
                type="text"
                id="cle_api"
                name="cle_api"
                required
                autocomplete="off"
                spellcheck="false"
                class="w-full rounded-lg bg-white px-4 py-3 font-mono text-sm text-[var(--color-text)] placeholder-[var(--color-text-muted)] border border-[var(--color-border)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent transition-all"
                placeholder="re_..."
              />
              <p class="mt-1 text-xs text-[var(--color-text-muted)]">La clé commence par « re_ ».</p>
            </div>

            <button
              type="submit"
              id="resend-submit"
              class="w-full rounded-xl bg-[var(--color-accent)] px-6 py-3 text-base font-medium text-white transition-all hover:bg-[var(--color-accent-hover)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
              data-umami-event="aide-resend-submit"
            >
              Envoyer la clé
            </button>

            <!-- Message d'erreur (caché par défaut) -->
            <div id="form-error" class="hidden rounded-lg bg-red-50 border border-red-200 p-4" role="alert">
              <p class="text-sm text-red-700 leading-relaxed">
                L'envoi n'a pas fonctionné. Réessayez, ou envoyez-moi la clé par email à <a href={`mailto:${business.email}?subject=Cl%C3%A9%20API%20Resend`} class="font-semibold underline hover:text-red-800">{business.email}</a>.
              </p>
            </div>

            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed pt-1">
              En envoyant ce formulaire, votre clé m'est transmise par email via Web3Forms.
              <a href="/politique-confidentialite" target="_blank" rel="noopener" class="text-[var(--color-accent-text)] underline hover:text-[var(--color-accent)] transition-colors">Politique de confidentialité</a>.
            </p>
          </form>
        </div>

        <!-- FAQ -->
        <div class="mt-12 space-y-4">
          <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-text-muted)]">Questions fréquentes</p>
          {faq.map((item) => (
            <details class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-4 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-text)] transition-colors [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-4 pb-4">
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{item.answer}</p>
              </div>
            </details>
          ))}
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed pt-2">
            Une question ? Écrivez-moi à <a href={`mailto:${business.email}`} class="font-semibold text-[var(--color-accent-text)] underline hover:text-[var(--color-accent)] transition-colors">{business.email}</a>.
          </p>
        </div>

        <!-- Réassurance -->
        <div class="mt-10 rounded-xl bg-neutral-50 border border-neutral-200 p-5">
          <p class="text-sm text-neutral-600 leading-relaxed">
            Vous restez seul propriétaire de votre compte Resend. La clé d'envoi ne donne accès ni à votre compte, ni à vos identifiants, ni à vos autres réglages, et vous pouvez la supprimer quand vous voulez depuis votre tableau de bord.
          </p>
        </div>

        <!-- Nav between guides -->
        <div class="mt-8 flex items-center justify-between rounded-lg border border-[var(--color-border)] p-4">
          <a href="/aide/web3forms" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-accent-text)] transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
            </svg>
            Formulaire Web3Forms
          </a>
          <a href="/aide" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-text)] hover:gap-3 transition-all">
            Tous les guides
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </article>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.getElementById('resend-form');
      if (!form) return;
      var statusEl = document.getElementById('form-status');
      var successBox = document.getElementById('form-success');
      var errorBox = document.getElementById('form-error');
      var submitBtn = document.getElementById('resend-submit');

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (errorBox) errorBox.classList.add('hidden');

        var data = Object.fromEntries(new FormData(form).entries());
        delete data.redirect;
        var clientName = (data.client || '').toString().trim();
        data.subject = clientName ? ('Clé API Resend : ' + clientName) : 'Clé API Resend (nouveau client)';

        var originalLabel = submitBtn ? submitBtn.textContent : '';
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Envoi...'; }
        if (statusEl) statusEl.textContent = 'Envoi en cours';

        fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data)
        })
          .then(function (r) { return r.json(); })
          .then(function (res) {
            if (res && res.success) {
              form.classList.add('hidden');
              if (successBox) {
                successBox.classList.remove('hidden');
                if (successBox.scrollIntoView) successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }
              if (statusEl) statusEl.textContent = 'Clé envoyée';
              if (window.umami && window.umami.track) window.umami.track('aide-resend-key-sent');
            } else {
              throw new Error('error');
            }
          })
          .catch(function () {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalLabel; }
            if (errorBox) errorBox.classList.remove('hidden');
            if (statusEl) statusEl.textContent = 'Une erreur est survenue';
          });
      });
    })();
  </script>
</BaseLayout>
