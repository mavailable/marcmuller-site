---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { business } from '../../data/business';

const title = 'Donner accès à votre domaine GoDaddy : guide pas-à-pas · Marc M';
const description = 'Guide pour me donner accès à votre nom de domaine GoDaddy via la délégation d\'accès, sans partager vos identifiants. Sécurisé, limité au domaine, révocable à tout moment.';

const breadcrumbs = [
  { name: 'Accueil', url: `${business.url}/` },
  { name: 'Aide', url: `${business.url}/aide/` },
  { name: 'Accès domaine GoDaddy', url: `${business.url}/aide/domaine-godaddy/` },
];

const steps = [
  {
    name: 'Connectez-vous à votre compte GoDaddy',
    text: 'Ouvrez le lien ci-dessous et connectez-vous avec vos identifiants GoDaddy habituels.',
    link: { href: 'https://account.godaddy.com', label: 'Ouvrir GoDaddy (Mon compte)' },
  },
  {
    name: 'Ouvrez la page « Accès délégué »',
    text: 'Cliquez sur votre nom (en haut à droite), puis « Paramètres du compte » et « Accès délégué ». Plus rapide : tapez directement l\'adresse ci-dessous dans la barre du navigateur.',
    link: { href: 'https://account.godaddy.com/access', label: 'Ouvrir la page Accès délégué' },
    path: 'Votre nom > Paramètres du compte > Accès délégué',
  },
  {
    name: 'Lancez une invitation d\'accès',
    text: 'Dans la section « Personnes pouvant accéder à mon compte », cliquez sur le bouton « Invitation d\'accès ».',
    image: '/images/aide/godaddy-acces-delegue.webp',
    imageAlt: 'Section « Personnes pouvant accéder à mon compte » sur GoDaddy avec le bouton « Invitation d\'accès »',
    imageW: 550,
    imageH: 544,
  },
  {
    name: 'Remplissez le formulaire',
    text: 'Renseignez mon nom et mon email, puis choisissez le niveau d\'accès le plus restreint. Voici les valeurs exactes à saisir :',
    fields: [
      { label: 'Nom', value: 'Marc Muller (marcm.fr)' },
      { label: 'Email', value: 'marc@muller.im' },
    ],
    detail: 'Pour le niveau d\'accès, cochez « Domaines uniquement ». C\'est le niveau le plus restreint : je peux gérer uniquement le domaine, sans aucun accès à vos moyens de paiement, votre facturation ou vos autres produits.',
    image: '/images/aide/godaddy-invitation.webp',
    imageAlt: 'Formulaire d\'invitation GoDaddy rempli avec l\'option « Domaines uniquement » cochée et le bouton « Inviter » actif',
    imageW: 1280,
    imageH: 812,
  },
  {
    name: 'Cliquez sur « Inviter »',
    text: 'GoDaddy m\'envoie alors une invitation par email. Je l\'accepte de mon côté et je peux configurer la connexion du domaine à votre site.',
    detail: 'Si GoDaddy vous demande de choisir un domaine précis, sélectionnez celui de votre site.',
  },
  {
    name: 'Confirmez-moi que c\'est fait',
    text: 'Envoyez-moi un message par email ou WhatsApp avec le nom de domaine concerné. Je reçois l\'invitation de mon côté et je lance la configuration.',
  },
];

const howToSteps = steps.map(s => ({ name: s.name, text: s.text }));

const faq = [
  {
    question: 'Pourquoi la délégation d\'accès plutôt que mes identifiants ?',
    answer: 'Avec la délégation d\'accès, vous gardez vos identifiants pour vous. Vous m\'invitez comme délégué sur votre domaine uniquement. C\'est plus sûr pour vous, et vous pouvez retirer cet accès quand vous voulez.',
  },
  {
    question: 'Le niveau « Domaines uniquement » me protège vraiment ?',
    answer: 'Oui. Ce niveau me donne accès à la gestion du domaine et rien d\'autre. Pas d\'accès à vos moyens de paiement, votre facturation, ni vos autres produits GoDaddy. C\'est le niveau le plus restreint proposé par GoDaddy.',
  },
  {
    question: 'Est-ce que je reste propriétaire de mon domaine ?',
    answer: 'Toujours. La délégation ne transfère rien : vous restez seul propriétaire du domaine et de votre compte. Je suis juste autorisé à configurer la connexion technique vers votre site.',
  },
  {
    question: 'Comment retirer l\'accès plus tard ?',
    answer: 'Retournez sur la même page « Accès délégué » dans les paramètres de votre compte GoDaddy. Vous y voyez la liste des personnes autorisées et vous pouvez révoquer un accès en un clic, à tout moment.',
  },
];
---

<BaseLayout title={title} description={description} lang="fr" frPath="/aide/domaine-godaddy" enPath="/en/help/godaddy-domain" noindex>

  <SchemaOrg type="breadcrumb" data={breadcrumbs} />
  <SchemaOrg type="howTo" data={{
    name: 'Donner accès à votre domaine GoDaddy',
    description: 'Guide pour inviter Marc Muller comme délégué sur votre domaine GoDaddy, sans partager vos identifiants.',
    totalTime: 'PT5M',
    steps: howToSteps,
  }} />
  <SchemaOrg type="faqPage" data={faq} />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative mx-auto max-w-3xl z-10">
      <a href="/aide/" class="inline-flex items-center gap-2 text-sm text-neutral-300 hover:text-white transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
        Retour aux guides
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-block rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-xs font-semibold text-sky-300">
          Domaine
        </span>
        <span class="text-sm text-neutral-400">~5 minutes</span>
        <span class="text-sm text-neutral-400">•</span>
        <span class="text-sm text-neutral-400">Sans partager vos identifiants</span>
      </div>

      <h1 class="mb-6 text-3xl font-bold leading-tight text-white md:text-5xl">
        Donner accès à votre domaine GoDaddy
      </h1>
      <p class="text-lg text-neutral-300 md:text-xl leading-relaxed">
        Plutôt que de me transmettre vos identifiants GoDaddy, vous m'invitez comme « délégué » sur votre domaine. C'est sécurisé, limité au domaine, révocable à tout moment, et vous gardez la pleine propriété.
      </p>
    </div>
  </section>

  <!-- GUIDE BODY -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl">
      <article class="rounded-xl bg-white border border-[var(--color-border)] p-8 md:p-12 shadow-sm">

        <!-- Steps -->
        <div class="space-y-10">
          {steps.map((step, i) => (
            <div class="flex gap-5">
              <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent)] text-white font-bold text-sm shadow-md">
                {i + 1}
              </div>
              <div class="flex-1 pt-1.5">
                <h2 class="text-lg font-bold text-[var(--color-text)] mb-2">{step.name}</h2>
                <p class="text-[var(--color-text-muted)] leading-relaxed">{step.text}</p>

                {/* Form fields to enter (name + email) with copy buttons */}
                {step.fields && (
                  <div class="mt-3 space-y-2">
                    {step.fields.map((field) => (
                      <div class="rounded-lg bg-[#0D0D0D] px-5 py-3 flex items-center justify-between gap-3 flex-wrap">
                        <div class="flex items-baseline gap-3">
                          <span class="text-xs font-semibold uppercase tracking-wide text-neutral-400">{field.label}</span>
                          <code class="text-base font-mono font-bold text-white tracking-wide">{field.value}</code>
                        </div>
                        <button
                          type="button"
                          class="copy-btn flex items-center gap-1.5 rounded-md bg-white/10 px-3 py-1.5 text-xs font-semibold text-white hover:bg-white/20 transition-colors"
                          data-copy={field.value}
                          data-umami-event="aide-domaine-godaddy-copier"
                          aria-label={`Copier ${field.label}`}
                        >
                          <svg class="w-3.5 h-3.5 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                          </svg>
                          <svg class="w-3.5 h-3.5 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                          <span class="copy-label">Copier</span>
                        </button>
                      </div>
                    ))}
                  </div>
                )}

                {/* Additional detail */}
                {step.detail && (
                  <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{step.detail}</p>
                )}

                {/* Navigation path */}
                {step.path && (
                  <div class="mt-3 rounded-lg bg-neutral-50 border border-neutral-200 px-4 py-2.5">
                    <p class="text-xs font-semibold text-neutral-500 mb-1">Chemin dans votre compte</p>
                    <p class="text-sm font-mono text-neutral-700">{step.path}</p>
                  </div>
                )}

                {/* External link */}
                {step.link && (
                  <a href={step.link.href} target="_blank" rel="noopener noreferrer"
                    class="mt-3 inline-flex items-center gap-2 rounded-lg border border-[var(--color-accent)]/20 bg-[var(--color-accent)]/5 px-4 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] hover:bg-[var(--color-accent)]/10 transition-colors"
                    data-umami-event="aide-domaine-godaddy-lien-externe" data-umami-event-url={step.link.href}>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    {step.link.label}
                  </a>
                )}

                {/* Screenshot */}
                {step.image && (
                  <div class="mt-4 rounded-lg border border-[var(--color-border)] overflow-hidden shadow-sm">
                    <img src={step.image} alt={step.imageAlt} width={step.imageW} height={step.imageH} loading="lazy" decoding="async" class="w-full h-auto" />
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Reassurance callout -->
        <div class="mt-10 rounded-lg bg-emerald-50 border border-emerald-200 p-5">
          <p class="text-sm font-semibold text-emerald-800 mb-2">Vous gardez le contrôle</p>
          <p class="text-sm text-emerald-700 leading-relaxed">
            Vous restez seul propriétaire de votre domaine. Le niveau « Domaines uniquement » ne me donne aucun accès à vos informations bancaires ni à vos achats. Vous pouvez révoquer cet accès à tout moment depuis la même page « Accès délégué ».
          </p>
        </div>

        <!-- FAQ -->
        <div class="mt-10 space-y-4">
          <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-text-muted)]">Questions fréquentes</p>
          {faq.map((item) => (
            <details class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-4 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-text)] transition-colors [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-4 pb-4">
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{item.answer}</p>
              </div>
            </details>
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-10 rounded-xl bg-[#0D0D0D] p-6 text-center">
          <p class="text-white font-semibold mb-2">Une fois l'invitation envoyée</p>
          <p class="text-neutral-300 text-sm mb-5">Envoyez-moi le nom de votre domaine par email ou WhatsApp.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href={`mailto:${business.email}?subject=Accès domaine GoDaddy&body=Bonjour Marc,%0A%0AJe vous ai invité comme délégué sur mon domaine GoDaddy.%0A%0AMon domaine : %0A%0AMerci !`}
              class="inline-block px-6 py-2.5 bg-[var(--color-accent)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--color-accent-hover)] transition-all"
              data-umami-event="aide-domaine-godaddy-email">
              Envoyer par email
            </a>
            <a href={`https://wa.me/${business.whatsapp}?text=Bonjour Marc, je vous ai invité comme délégué sur mon domaine GoDaddy. Mon domaine : `}
              target="_blank" rel="noopener noreferrer"
              class="inline-block px-6 py-2.5 bg-white/10 text-white text-sm font-semibold rounded-lg border border-white/20 hover:bg-white/20 transition-all"
              data-umami-event="aide-domaine-godaddy-whatsapp">
              Envoyer par WhatsApp
            </a>
          </div>
        </div>

        <!-- Next guide -->
        <div class="mt-8 flex items-center justify-between rounded-lg border border-[var(--color-border)] p-4">
          <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-muted)]">Guide suivant</span>
          <a href="/aide/web3forms/" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-text)] hover:gap-3 transition-all">
            Créer votre compte Web3Forms
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </article>
    </div>
  </section>

  <script>
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (!text) return;
        await navigator.clipboard.writeText(text);
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const label = btn.querySelector('.copy-label');
        if (copyIcon) copyIcon.classList.add('hidden');
        if (checkIcon) checkIcon.classList.remove('hidden');
        if (label) label.textContent = 'Copié !';
        setTimeout(() => {
          if (copyIcon) copyIcon.classList.remove('hidden');
          if (checkIcon) checkIcon.classList.add('hidden');
          if (label) label.textContent = 'Copier';
        }, 2000);
      });
    });
  </script>
</BaseLayout>
