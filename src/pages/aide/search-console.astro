---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { business } from '../../data/business';

const title = 'Donner accès à votre Google Search Console : guide pas-à-pas · Marc M';
const description = 'Ajoutez-moi à votre Google Search Console en quelques minutes pour que je suive le référencement de votre site. Vous restez seul propriétaire.';

// Accès personnel (web) : éditable ici en cas de changement
const ACCES_PERSO = business.email; // marc@muller.im
// Compte de service (API) : couvre Search Console API + Indexing API
const ACCES_OUTIL = 'indexing-api@central-pod-492109-f5.iam.gserviceaccount.com';

const breadcrumbs = [
  { name: 'Accueil', url: `${business.url}/` },
  { name: 'Aide', url: `${business.url}/aide/` },
  { name: 'Google Search Console', url: `${business.url}/aide/search-console/` },
];

const howToSteps = [
  { name: 'Ouvrez Google Search Console', text: 'Rendez-vous sur search.google.com/search-console et connectez-vous avec le compte Google qui a servi à créer votre Search Console.' },
  { name: 'Sélectionnez votre site', text: 'En haut à gauche, choisissez votre site (votre « propriété »). Si vous avez une propriété « Domaine », choisissez-la en priorité.' },
  { name: 'Ouvrez les Paramètres', text: 'En bas à gauche, cliquez sur l\'icône engrenage « Paramètres ».' },
  { name: 'Allez dans Utilisateurs et autorisations', text: 'Cliquez sur « Utilisateurs et autorisations ».' },
  { name: 'Cliquez sur Ajouter un utilisateur', text: 'En haut à droite, cliquez sur « Ajouter un utilisateur ». Vous allez le faire deux fois, une fois par accès ci-dessous.' },
];

const faq = [
  {
    question: 'La liste ne propose que « Complet » et « Restreint », pas « Propriétaire ». Que faire ?',
    answer: 'Ajoutez quand même le 2e accès en « Complet » et prévenez-moi. Je vous indique la marche à suivre, c\'est très simple de mon côté.',
  },
  {
    question: 'Comment être sûr de ne pas me tromper dans la 2e adresse ?',
    answer: 'Utilisez le bouton « Copier » à côté de l\'adresse. C\'est une adresse technique, longue, et la moindre faute de frappe empêche l\'accès de fonctionner. En la copiant-collant, vous évitez toute erreur.',
  },
  {
    question: 'Est-ce que je perds le contrôle de ma Search Console ?',
    answer: 'Non. Vous restez propriétaire de votre Search Console. Ces accès ne donnent aucun droit sur votre nom de domaine, votre hébergement ou vos e-mails. Vous pouvez les retirer quand vous voulez depuis la même page « Utilisateurs et autorisations ».',
  },
];
---

<BaseLayout title={title} description={description} lang="fr" frPath="/aide/search-console" enPath="/en/help/search-console" noindex>

  <SchemaOrg type="breadcrumb" data={breadcrumbs} />
  <SchemaOrg type="howTo" data={{
    name: 'Donner accès à votre Google Search Console',
    description: 'Guide pour ajouter un accès personnel et un compte de service à votre propriété Google Search Console.',
    totalTime: 'PT5M',
    steps: howToSteps,
  }} />
  <SchemaOrg type="faqPage" data={faq} />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative mx-auto max-w-3xl z-10">
      <a href="/aide" class="inline-flex items-center gap-2 text-sm text-neutral-300 hover:text-white transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
        Retour aux guides
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-block rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-xs font-semibold text-sky-300">
          Référencement
        </span>
        <span class="text-sm text-neutral-400">~5 minutes</span>
        <span class="text-sm text-neutral-400">•</span>
        <span class="text-sm text-neutral-400">2 accès à ajouter</span>
      </div>

      <h1 class="mb-6 text-3xl font-bold leading-tight text-white md:text-5xl">
        Donner accès à votre Google Search Console
      </h1>
      <p class="text-lg text-neutral-300 md:text-xl leading-relaxed">
        Quelques minutes pour me permettre de suivre le référencement de votre site.
      </p>
    </div>
  </section>

  <!-- GUIDE BODY -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl">
      <article class="rounded-xl bg-white border border-[var(--color-border)] p-8 md:p-12 shadow-sm">

        <!-- Intro -->
        <p class="text-[var(--color-text-muted)] leading-relaxed mb-6">
          Vous avez déjà un compte Google Search Console pour votre site. Pour que je puisse suivre vos performances et automatiser le suivi des statistiques, il suffit de m'ajouter à votre propriété. Vous restez seul propriétaire et vous pouvez retirer cet accès à tout moment.
        </p>

        <!-- Ce qu'il vous faut -->
        <div class="mb-10 rounded-lg bg-sky-50 border border-sky-200 p-5">
          <p class="text-sm font-semibold text-sky-800 mb-1">Ce qu'il vous faut</p>
          <p class="text-sm text-sky-700 leading-relaxed">
            Être connecté au compte Google avec lequel votre Search Console a été créée.
          </p>
        </div>

        <!-- Steps -->
        <div class="space-y-8">
          {howToSteps.map((step, i) => (
            <div class="flex gap-5">
              <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent)] text-white font-bold text-sm shadow-md">
                {i + 1}
              </div>
              <div class="flex-1 pt-1.5">
                <h2 class="text-lg font-bold text-[var(--color-text)] mb-2">{step.name}</h2>
                {i === 0 ? (
                  <p class="text-[var(--color-text-muted)] leading-relaxed">
                    Rendez-vous sur <a href="https://search.google.com/search-console" target="_blank" rel="noopener noreferrer" class="font-semibold text-[var(--color-accent-text)] underline hover:text-[var(--color-accent)] transition-colors">Google Search Console</a> et connectez-vous avec le compte Google qui a servi à créer votre Search Console.
                  </p>
                ) : (
                  <p class="text-[var(--color-text-muted)] leading-relaxed">{step.text}</p>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Les deux accès -->
        <div class="mt-12 mb-6">
          <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">Les deux accès à ajouter</h2>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Pour chaque accès : collez l'adresse, choisissez l'autorisation indiquée, puis cliquez sur « Ajouter ».
          </p>
        </div>

        <!-- Accès 1 -->
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden mb-5">
          <div class="border-b border-[var(--color-border)] bg-white px-5 py-3">
            <div class="flex items-center gap-3">
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-sky-100 text-sky-700 text-sm font-bold shrink-0">1</span>
              <p class="font-bold text-[var(--color-text)]">Mon accès</p>
            </div>
          </div>
          <div class="p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] mb-2">Adresse e-mail</p>
            <div class="flex flex-col sm:flex-row gap-2">
              <code id="copy-perso-value" class="flex-1 min-w-0 bg-white border border-[var(--color-border)] rounded-lg px-4 py-3 text-sm font-mono text-[var(--color-text)] break-all select-all">{ACCES_PERSO}</code>
              <button
                type="button"
                data-copy-btn
                data-copy-target="copy-perso-value"
                class="copy-btn shrink-0 inline-flex items-center justify-center gap-2 px-4 py-3 bg-[var(--color-accent)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--color-accent-hover)] transition-all min-h-[44px]"
                aria-label="Copier l'adresse e-mail de mon accès"
                data-umami-event="aide-gsc-copy-perso"
              >
                <svg class="copy-icon w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2m-6 12h8a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-8a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2Z" /></svg>
                <span class="copy-label">Copier</span>
              </button>
            </div>
            <div class="mt-4 flex items-center gap-2">
              <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">Autorisation à choisir</span>
              <span class="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-sm font-bold text-emerald-700">Complet</span>
            </div>
          </div>
        </div>

        <!-- Accès 2 -->
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden">
          <div class="border-b border-[var(--color-border)] bg-white px-5 py-3">
            <div class="flex items-center gap-3">
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-violet-100 text-violet-700 text-sm font-bold shrink-0">2</span>
              <p class="font-bold text-[var(--color-text)]">L'outil de suivi automatique</p>
            </div>
          </div>
          <div class="p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] mb-2">Adresse e-mail</p>
            <div class="flex flex-col sm:flex-row gap-2">
              <code id="copy-outil-value" class="flex-1 min-w-0 bg-white border border-[var(--color-border)] rounded-lg px-4 py-3 text-sm font-mono text-[var(--color-text)] break-all select-all">{ACCES_OUTIL}</code>
              <button
                type="button"
                data-copy-btn
                data-copy-target="copy-outil-value"
                class="copy-btn shrink-0 inline-flex items-center justify-center gap-2 px-4 py-3 bg-[var(--color-accent)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--color-accent-hover)] transition-all min-h-[44px]"
                aria-label="Copier l'adresse e-mail de l'outil de suivi"
                data-umami-event="aide-gsc-copy-outil"
              >
                <svg class="copy-icon w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2m-6 12h8a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-8a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2Z" /></svg>
                <span class="copy-label">Copier</span>
              </button>
            </div>
            <div class="mt-4 flex items-center gap-2">
              <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">Autorisation à choisir</span>
              <span class="inline-flex items-center rounded-full bg-violet-100 px-3 py-1 text-sm font-bold text-violet-700">Propriétaire</span>
            </div>
            <p class="mt-4 text-sm text-[var(--color-text-muted)] leading-relaxed">
              Choisissez bien « Propriétaire » pour ce 2e accès : c'est ce qui active l'automatisation.
            </p>
          </div>
        </div>

        <!-- C'est terminé -->
        <div class="mt-10 rounded-lg bg-emerald-50 border border-emerald-200 p-5">
          <p class="text-sm font-semibold text-emerald-800 mb-1">C'est terminé</p>
          <p class="text-sm text-emerald-700 leading-relaxed">
            Une fois les deux accès ajoutés, vous n'avez plus rien à faire. L'accès est actif immédiatement.
          </p>
        </div>

        <!-- Un souci ? -->
        <div class="mt-10 space-y-4">
          <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-text-muted)]">Un souci ?</p>
          {faq.map((item) => (
            <details class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-4 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-text)] transition-colors [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-4 pb-4">
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{item.answer}</p>
              </div>
            </details>
          ))}
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed pt-2">
            Une question ? Écrivez-moi à <a href={`mailto:${business.email}`} class="font-semibold text-[var(--color-accent-text)] underline hover:text-[var(--color-accent)] transition-colors">{business.email}</a>.
          </p>
        </div>

        <!-- Réassurance -->
        <div class="mt-10 rounded-xl bg-neutral-50 border border-neutral-200 p-5">
          <p class="text-sm text-neutral-600 leading-relaxed">
            Vous restez propriétaire de votre Search Console. Ces accès ne donnent aucun droit sur votre nom de domaine, votre hébergement ou vos e-mails, et vous pouvez les retirer quand vous voulez depuis la même page.
          </p>
        </div>

        <!-- Nav between guides -->
        <div class="mt-8 flex items-center justify-between rounded-lg border border-[var(--color-border)] p-4">
          <a href="/aide/acces-techniques" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-accent-text)] transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
            </svg>
            Accès techniques
          </a>
          <a href="/aide" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-text)] hover:gap-3 transition-all">
            Tous les guides
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </article>
    </div>
  </section>

  <script is:inline>
    (function () {
      function bind(btn) {
        btn.addEventListener('click', function () {
          var targetId = btn.getAttribute('data-copy-target');
          var el = document.getElementById(targetId);
          if (!el) return;
          var text = el.textContent.trim();
          var label = btn.querySelector('.copy-label');
          var original = label ? label.textContent : '';

          function done() {
            if (label) label.textContent = 'Copié !';
            btn.classList.add('copied');
            setTimeout(function () {
              if (label) label.textContent = original;
              btn.classList.remove('copied');
            }, 2000);
          }
          function fallback() {
            var range = document.createRange();
            range.selectNodeContents(el);
            var sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
            try { document.execCommand('copy'); done(); } catch (e) {}
            sel.removeAllRanges();
          }

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done, fallback);
          } else {
            fallback();
          }
        });
      }
      var btns = document.querySelectorAll('[data-copy-btn]');
      for (var i = 0; i < btns.length; i++) bind(btns[i]);
    })();
  </script>
</BaseLayout>
