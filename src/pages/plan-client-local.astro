<style>
  /* Hero gradient title */
  .hero-accent {
    background: linear-gradient(135deg, #E86C47 0%, #FF8A65 50%, #E86C47 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 4s ease-in-out infinite;
  }
  @keyframes shimmer {
    0%, 100% { background-position: 0% center; }
    50% { background-position: 200% center; }
  }

  /* Hero entrance */
  .hero-fade {
    opacity: 0;
    transform: translateY(16px);
    animation: heroIn 0.7s ease-out forwards;
  }
  .hero-fade-1 { animation-delay: 0.1s; }
  .hero-fade-2 { animation-delay: 0.22s; }
  .hero-fade-3 { animation-delay: 0.36s; }
  .hero-fade-4 { animation-delay: 0.5s; }
  .hero-fade-5 { animation-delay: 0.65s; }
  @keyframes heroIn {
    to { opacity: 1; transform: translateY(0); }
  }

  /* FAQ details summary hide default marker */
  details > summary { list-style: none; }
  details > summary::-webkit-details-marker { display: none; }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-accent { animation: none; }
    .hero-fade { animation: none; opacity: 1; transform: none; }
  }
</style>

<script>
  // Sticky CTA mobile : apparait apres avoir scrolle 1 viewport
  const stickyCta = document.getElementById('pcl-sticky-cta');
  if (stickyCta) {
    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const threshold = window.innerHeight * 0.9;
          if (window.scrollY > threshold) {
            stickyCta.classList.remove('translate-y-full');
          } else {
            stickyCta.classList.add('translate-y-full');
          }
          ticking = false;
        });
        ticking = true;
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // FAQ tracking Umami
  document.querySelectorAll('details.faq-item').forEach((el) => {
    el.addEventListener('toggle', () => {
      // Cast needed for HTMLDetailsElement
      const details = el as HTMLDetailsElement;
      if (details.open) {
        const question = details.querySelector('summary span')?.textContent?.trim() || '';
        if (typeof (window as any).umami !== 'undefined') {
          (window as any).umami.track('pcl-faq-open', { question: question.slice(0, 80) });
        }
      }
    });
  });
</script>
