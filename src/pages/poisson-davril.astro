---
import '../styles/global.css';
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Comment j'ai fait 50 000€/mois en 30 jours grâce au Vibe Coding — Marc M</title>
  <meta name="description" content="J'ai lancé mon agence web en 1 mois. Je fais 50k/mois avec Claude Code. Je te vends une formation." />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Open Graph -->
  <meta property="og:title" content="Comment j'ai fait 50 000€/mois en 30 jours grâce au Vibe Coding" />
  <meta property="og:description" content="Claude Code. Quelques prompts. Une connexion Wi-Fi. Je t'explique tout dans ma formation exclusive à 997€." />
  <meta property="og:image" content="https://marcm.fr/og-poisson-davril.svg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content="https://marcm.fr/poisson-davril" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Comment j'ai fait 50 000€/mois en 30 jours grâce au Vibe Coding" />
  <meta name="twitter:description" content="Claude Code. Quelques prompts. Une connexion Wi-Fi. Je t'explique tout dans ma formation exclusive à 997€." />
  <meta name="twitter:image" content="https://marcm.fr/og-poisson-davril.svg" />

  <style>
    /* ========================================
       GURU PAGE STYLES
       ======================================== */

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Satoshi', system-ui, sans-serif;
      background: #FAFAF8;
      overflow-x: hidden;
    }

    /* --- Scroll animations --- */
    .reveal {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* --- Hero --- */
    .hero {
      background: #1A1A1A;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 4rem 1.5rem;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(232,108,71,0.25) 0%, transparent 70%);
      pointer-events: none;
    }

    .badge {
      display: inline-block;
      background: #E86C47;
      color: white;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 0.4rem 1rem;
      border-radius: 100px;
      margin-bottom: 1.5rem;
    }

    .hero h1 {
      font-size: clamp(2rem, 6vw, 4.5rem);
      font-weight: 900;
      color: #FAFAF8;
      line-height: 1.1;
      max-width: 900px;
      margin-bottom: 1.5rem;
    }

    .hero h1 em {
      font-style: normal;
      color: #E86C47;
    }

    .hero-sub {
      font-size: 1.2rem;
      color: #B0B0B0;
      max-width: 560px;
      margin-bottom: 2.5rem;
      line-height: 1.6;
    }

    .btn-guru {
      display: inline-block;
      background: #E86C47;
      color: white;
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 1.1rem 2.5rem;
      border-radius: 8px;
      text-decoration: none;
      box-shadow: 0 8px 40px rgba(232,108,71,0.4);
      transition: transform 0.2s, box-shadow 0.2s;
      cursor: pointer;
      border: none;
    }
    .btn-guru:hover {
      transform: translateY(-2px) scale(1.03);
      box-shadow: 0 12px 50px rgba(232,108,71,0.55);
    }

    .hero-proof {
      margin-top: 2.5rem;
      display: flex;
      gap: 2rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .hero-proof span {
      color: #6B6B6B;
      font-size: 0.85rem;
    }
    .hero-proof span strong {
      color: #FAFAF8;
    }

    /* --- Stats --- */
    .stats {
      background: #F0EEEB;
      padding: 5rem 1.5rem;
      text-align: center;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem;
      max-width: 900px;
      margin: 3rem auto 0;
    }
    .stat-card {
      background: white;
      border-radius: 16px;
      padding: 2rem 1.5rem;
      box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    }
    .stat-number {
      font-size: 2.8rem;
      font-weight: 900;
      color: #E86C47;
      line-height: 1;
      margin-bottom: 0.5rem;
    }
    .stat-label {
      font-size: 0.9rem;
      color: #6B6B6B;
      line-height: 1.4;
    }

    /* --- Section générique --- */
    .section {
      padding: 5rem 1.5rem;
      max-width: 800px;
      margin: 0 auto;
    }
    .section-dark {
      background: #1A1A1A;
      max-width: 100%;
      padding: 5rem 1.5rem;
    }
    .section-dark .inner {
      max-width: 800px;
      margin: 0 auto;
    }

    .overline {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #E86C47;
      margin-bottom: 0.75rem;
    }

    h2.heading {
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      font-weight: 900;
      color: #1A1A1A;
      line-height: 1.15;
      margin-bottom: 1.5rem;
    }
    .section-dark h2.heading { color: #FAFAF8; }

    p.body-text {
      font-size: 1.05rem;
      color: #525252;
      line-height: 1.75;
      margin-bottom: 1rem;
    }
    .section-dark p.body-text { color: #B0B0B0; }

    /* --- Modules liste --- */
    .modules-list {
      list-style: none;
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .modules-list li {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }
    .module-num {
      background: #E86C47;
      color: white;
      font-size: 0.75rem;
      font-weight: 800;
      min-width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .module-title {
      font-weight: 700;
      color: #FAFAF8;
      margin-bottom: 0.2rem;
    }
    .module-desc {
      font-size: 0.875rem;
      color: #6B6B6B;
    }

    /* --- Témoignages --- */
    .testimonials {
      background: #F0EEEB;
      padding: 5rem 1.5rem;
    }
    .testimonials-inner {
      max-width: 800px;
      margin: 0 auto;
    }
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
      margin-top: 2.5rem;
    }
    .testi-card {
      background: white;
      border-radius: 16px;
      padding: 1.75rem;
      box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    }
    .testi-stars {
      color: #E86C47;
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
    }
    .testi-text {
      font-size: 0.95rem;
      color: #3D3D3D;
      line-height: 1.6;
      margin-bottom: 1rem;
      font-style: italic;
    }
    .testi-author {
      font-size: 0.8rem;
      font-weight: 700;
      color: #6B6B6B;
    }

    /* --- Pricing / CTA --- */
    .pricing {
      background: #1A1A1A;
      padding: 5rem 1.5rem;
      text-align: center;
    }
    .pricing-box {
      background: white;
      max-width: 520px;
      margin: 2.5rem auto 0;
      border-radius: 24px;
      padding: 3rem 2rem;
      position: relative;
    }
    .pricing-badge {
      position: absolute;
      top: -14px;
      left: 50%;
      transform: translateX(-50%);
      background: #E86C47;
      color: white;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 0.35rem 1.2rem;
      border-radius: 100px;
      white-space: nowrap;
    }
    .old-prices {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 0.5rem;
    }
    .old-price {
      font-size: 1rem;
      color: #B0B0B0;
      text-decoration: line-through;
    }
    .current-price {
      font-size: 4rem;
      font-weight: 900;
      color: #E86C47;
      line-height: 1;
      margin-bottom: 0.25rem;
    }
    .price-sub {
      font-size: 0.85rem;
      color: #6B6B6B;
      margin-bottom: 2rem;
    }
    .scarcity {
      background: #FEF3EF;
      border: 1px solid #FACBB8;
      border-radius: 8px;
      padding: 0.6rem 1rem;
      font-size: 0.85rem;
      color: #933A25;
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    /* Timer */
    .timer {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }
    .timer-block {
      background: #1A1A1A;
      color: white;
      border-radius: 8px;
      padding: 0.5rem 0.75rem;
      min-width: 52px;
      text-align: center;
    }
    .timer-num {
      font-size: 1.5rem;
      font-weight: 900;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .timer-label {
      font-size: 0.6rem;
      color: #6B6B6B;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    /* --- Reveal overlay --- */
    #reveal-overlay {
      position: fixed;
      inset: 0;
      background: #1A1A1A;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.6s ease;
    }
    #reveal-overlay.active {
      opacity: 1;
      pointer-events: all;
    }

    .fish-container {
      font-size: 6rem;
      margin-bottom: 1.5rem;
      animation: fishSwim 3s ease-in-out infinite;
    }

    @keyframes fishSwim {
      0%, 100% { transform: translateX(-12px) rotate(-3deg); }
      50% { transform: translateX(12px) rotate(3deg); }
    }

    .reveal-title {
      font-size: clamp(2rem, 6vw, 3.5rem);
      font-weight: 900;
      color: #E86C47;
      margin-bottom: 1rem;
      line-height: 1.1;
    }

    .reveal-sub {
      font-size: 1.15rem;
      color: #B0B0B0;
      max-width: 540px;
      line-height: 1.7;
      margin-bottom: 2.5rem;
    }
    .reveal-sub strong {
      color: #FAFAF8;
    }

    .btn-real {
      display: inline-block;
      background: #E86C47;
      color: white;
      font-size: 1rem;
      font-weight: 700;
      padding: 0.9rem 2rem;
      border-radius: 8px;
      text-decoration: none;
      transition: transform 0.2s;
    }
    .btn-real:hover { transform: translateY(-2px); }

    .reveal-fine {
      margin-top: 1.5rem;
      font-size: 0.8rem;
      color: #3D3D3D;
    }

    /* Confetti burst */
    .confetti-wrap {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 9998;
      overflow: hidden;
    }
    .confetti-piece {
      position: absolute;
      top: -20px;
      width: 10px;
      height: 10px;
      border-radius: 2px;
      animation: confettiFall linear forwards;
      opacity: 0;
    }

    @keyframes confettiFall {
      0%   { opacity: 1; transform: translateY(0) rotate(0deg); }
      100% { opacity: 0; transform: translateY(110vh) rotate(720deg); }
    }

    /* Responsive */
    @media (max-width: 640px) {
      .old-prices { flex-direction: column; align-items: center; gap: 0.25rem; }
    }
  </style>
</head>

<body>

  <!-- ============================
       HERO
       ============================ -->
  <section class="hero">
    <div class="badge">🔥 Offre exclusive — 1 avril 2026</div>
    <h1>
      Comment j'ai lancé mon agence web<br />
      <em>en 30 jours</em> et atteint<br />
      <em>50 000€/mois</em><br />
      grâce au Vibe Coding
    </h1>
    <p class="hero-sub">
      Claude Code. Quelques prompts. Une connexion Wi-Fi. C'était aussi simple que ça.<br />
      Maintenant je t'explique tout dans ma formation exclusive.
    </p>
    <button class="btn-guru" id="cta-hero">
      REJOINS LA FORMATION →
    </button>
    <div class="hero-proof">
      <span>✅ <strong>2 347</strong> élèves</span>
      <span>⭐ <strong>4.97/5</strong> sur 1 800 avis</span>
      <span>🏆 <strong>#1</strong> formation vibe coding France</span>
    </div>
  </section>

  <!-- ============================
       STATS
       ============================ -->
  <section class="stats">
    <div class="overline reveal">Les chiffres qui font rêver</div>
    <h2 class="heading reveal" style="color:#1A1A1A; font-size:clamp(1.75rem,4vw,2.75rem); font-weight:900; line-height:1.15; margin-bottom:1.5rem; max-width:600px; margin-left:auto; margin-right:auto;">
      Des résultats que tu peux toi aussi reproduire<br />
      <span style="color:#E86C47;">en seulement 4 semaines</span>
    </h2>
    <div class="stats-grid">
      <div class="stat-card reveal">
        <div class="stat-number">50k€</div>
        <div class="stat-label">de CA mensuel<br />dès le 1er mois</div>
      </div>
      <div class="stat-card reveal">
        <div class="stat-number">17h</div>
        <div class="stat-label">de travail par semaine<br />maximum</div>
      </div>
      <div class="stat-card reveal">
        <div class="stat-number">100%</div>
        <div class="stat-label">en remote<br />depuis Bali</div>
      </div>
      <div class="stat-card reveal">
        <div class="stat-number">0</div>
        <div class="stat-label">ligne de code<br />écrite manuellement</div>
      </div>
    </div>
  </section>

  <!-- ============================
       HISTOIRE
       ============================ -->
  <section class="section">
    <div class="overline reveal">Mon histoire</div>
    <h2 class="heading reveal">
      Avant, j'étais comme toi.<br />
      <span style="color:#E86C47;">Un simple salarié.</span>
    </h2>
    <p class="body-text reveal">
      Je galérais. Je travaillais 40h par semaine pour un patron qui ne me voyait pas.
      Un jour, j'ai découvert <strong>Claude Code</strong>. J'ai tout quitté du jour au lendemain.
    </p>
    <p class="body-text reveal">
      J'ai ouvert un terminal. J'ai tapé mon premier prompt. Mon premier client m'a payé
      <strong>10 000€ en une soirée</strong>. C'était un mardi. Je portais encore mon pyjama.
    </p>
    <p class="body-text reveal">
      Aujourd'hui j'ai <strong>une Ferrari mentale</strong>, un MacBook Pro,
      et une vue sur l'océan. La plupart de mes concurrents ne savent pas encore que ce
      monde existe. Toi, tu es à 4 semaines de les dépasser tous.
    </p>
  </section>

  <!-- ============================
       MODULES
       ============================ -->
  <div class="section-dark">
    <div class="inner">
      <div class="overline reveal" style="color:#E86C47;">Le programme</div>
      <h2 class="heading reveal">
        5 modules pour tout changer.<br />
        <span style="color:#E86C47;">Rien de superflu.</span>
      </h2>
      <ul class="modules-list">
        <li class="reveal">
          <span class="module-num">01</span>
          <div>
            <div class="module-title">Le Mindset du Winner Digital</div>
            <div class="module-desc">Reprogramme ton cerveau. Fais vibrer ton énergie entrepreneuriale. Manifeste l'abondance financière.</div>
          </div>
        </li>
        <li class="reveal">
          <span class="module-num">02</span>
          <div>
            <div class="module-title">Prompter comme un Dieu</div>
            <div class="module-desc">Les 3 mots secrets qui font tout. Claude code à ta place pendant que tu dors. L'IA est ton esclave bienveillant.</div>
          </div>
        </li>
        <li class="reveal">
          <span class="module-num">03</span>
          <div>
            <div class="module-title">Facturer 10× plus qu'une agence</div>
            <div class="module-desc">Le script de vente qui convertit à 100%. Comment annoncer 15 000€ sans ciller. La psychologie du prix haut.</div>
          </div>
        </li>
        <li class="reveal">
          <span class="module-num">04</span>
          <div>
            <div class="module-title">L'Automatisation Totale</div>
            <div class="module-desc">Délègue tout à l'IA. Travaille 4h par semaine depuis la plage. Le client ne sait même pas que tu es en vacances.</div>
          </div>
        </li>
        <li class="reveal">
          <span class="module-num">05</span>
          <div>
            <div class="module-title">BONUS — Mon Carnet d'Adresses des Clients Riches</div>
            <div class="module-desc">200 contacts premium prêts à payer. Valeur réelle : 9 997€. Offert aux 10 premiers inscrits.</div>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <!-- ============================
       TÉMOIGNAGES
       ============================ -->
  <section class="testimonials">
    <div class="testimonials-inner">
      <div class="overline reveal" style="text-align:center;">Ils ont transformé leur vie</div>
      <h2 class="heading reveal" style="color:#1A1A1A; text-align:center;">
        Ce que disent mes élèves<br />
        <span style="color:#E86C47;">(résultats non représentatifs)</span>
      </h2>
      <div class="testimonials-grid">
        <div class="testi-card reveal">
          <div class="testi-stars">★★★★★</div>
          <p class="testi-text">
            "J'ai fait 30 000€ en 2 semaines grâce à Marc !!!
            J'avais même pas de PC, j'ai tout fait sur mon téléphone Samsung.
            Ma mère pleure de joie tous les soirs."
          </p>
          <div class="testi-author">Kevin M. — Anciennement magasinier, maintenant CEO</div>
        </div>
        <div class="testi-card reveal">
          <div class="testi-stars">★★★★★</div>
          <p class="testi-text">
            "Ma vie a CHANGÉ. Je travaille 4h par semaine depuis Tulum.
            Je sip un cocktail en regardant le coucher de soleil pendant que
            mon IA code pour moi. Merci Marc, tu es un génie."
          </p>
          <div class="testi-author">Océane D. — Digital nomade, ex-comptable</div>
        </div>
        <div class="testi-card reveal">
          <div class="testi-stars">★★★★★</div>
          <p class="testi-text">
            "J'avais zéro compétence et zéro motivation.
            Maintenant j'ai une Ferrari mentale, un Rolex sur chaque poignet
            et 47 clients en automatique. Résultats atypiques mais vrais."
          </p>
          <div class="testi-author">Baptiste R. — Coach de vie numérique</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================
       PRICING / CTA FINAL
       ============================ -->
  <section class="pricing" id="pricing">
    <div class="overline reveal" style="color:#E86C47; text-align:center; margin-bottom:0.5rem;">Offre de lancement — 1 avril seulement</div>
    <h2 class="heading reveal" style="color:#FAFAF8; text-align:center;">
      Rejoins la formation maintenant<br />
      <span style="color:#E86C47;">avant que le prix remonte</span>
    </h2>

    <div class="pricing-box reveal">
      <div class="pricing-badge">⚡ Offre expire dans…</div>

      <div class="timer" id="countdown">
        <div class="timer-block">
          <div class="timer-num" id="t-h">02</div>
          <div class="timer-label">heures</div>
        </div>
        <div class="timer-block">
          <div class="timer-num" id="t-m">47</div>
          <div class="timer-label">min</div>
        </div>
        <div class="timer-block">
          <div class="timer-num" id="t-s">33</div>
          <div class="timer-label">sec</div>
        </div>
      </div>

      <div class="old-prices">
        <span class="old-price">4 997€</span>
        <span class="old-price">2 997€</span>
        <span class="old-price">1 997€</span>
      </div>
      <div class="current-price">997€</div>
      <div class="price-sub">Paiement unique · Accès à vie · Garantie résultat*</div>

      <div class="scarcity">
        🔴 &nbsp;Plus que <strong>3 places</strong> disponibles au tarif lancement
      </div>

      <button class="btn-guru" id="cta-pricing" style="width:100%; font-size:1.05rem;">
        OUI JE VEUX CHANGER MA VIE →
      </button>

      <p style="margin-top:1rem; font-size:0.75rem; color:#B0B0B0; line-height:1.5;">
        *Garantie résultat : si tu ne fais pas 50k€ le premier mois,<br />
        tu peux relire le module 1 autant de fois que tu veux.
      </p>
    </div>
  </section>


  <!-- ============================
       REVEAL OVERLAY
       ============================ -->
  <div id="reveal-overlay">
    <div class="confetti-wrap" id="confetti-wrap"></div>
    <div class="fish-container">🐟</div>
    <div class="reveal-title">Poisson d'avril !</div>
    <p class="reveal-sub">
      Non, désolé. <strong>Il n'y a pas de formation.</strong><br />
      Pas de recette magique. Pas de 50k/mois en pyjama depuis Bali.<br /><br />
      Juste un dev web indépendant basé à Metz, qui fait du bon travail,
      <strong>à 490€, livré en 7 jours.</strong>
    </p>
    <a href="/" class="btn-real">Voir le vrai site →</a>
    <p class="reveal-fine">
      (La Ferrari mentale, par contre, elle est offerte.)
    </p>
  </div>


  <script>
    // ---- Scroll reveal ----
    const observer = new IntersectionObserver(
      (entries) => entries.forEach(e => {
        if (e.isIntersecting) e.target.classList.add('visible');
      }),
      { threshold: 0.15 }
    );
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // ---- Countdown timer (fake — resets from random high value) ----
    let secs = 2 * 3600 + 47 * 60 + 33;
    function pad(n: number) { return String(n).padStart(2, '0'); }
    function updateTimer() {
      if (secs <= 0) secs = 9999; // repart — bien sûr
      secs--;
      const h = Math.floor(secs / 3600);
      const m = Math.floor((secs % 3600) / 60);
      const s = secs % 60;
      document.getElementById('t-h')!.textContent = pad(h);
      document.getElementById('t-m')!.textContent = pad(m);
      document.getElementById('t-s')!.textContent = pad(s);
    }
    setInterval(updateTimer, 1000);

    // ---- Confetti ----
    function spawnConfetti() {
      const wrap = document.getElementById('confetti-wrap')!;
      const colors = ['#E86C47','#FAFAF8','#F5A88A','#1A1A1A','#F0EEEB','#D55A36'];
      for (let i = 0; i < 80; i++) {
        const el = document.createElement('div');
        el.className = 'confetti-piece';
        el.style.left = Math.random() * 100 + 'vw';
        el.style.background = colors[Math.floor(Math.random() * colors.length)];
        el.style.width = (8 + Math.random() * 10) + 'px';
        el.style.height = (8 + Math.random() * 10) + 'px';
        el.style.animationDuration = (1.5 + Math.random() * 2) + 's';
        el.style.animationDelay = (Math.random() * 0.8) + 's';
        wrap.appendChild(el);
        el.addEventListener('animationend', () => el.remove());
      }
    }

    // ---- Reveal ----
    function showReveal() {
      spawnConfetti();
      const overlay = document.getElementById('reveal-overlay')!;
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    document.getElementById('cta-hero')?.addEventListener('click', showReveal);
    document.getElementById('cta-pricing')?.addEventListener('click', showReveal);

    // Auto-reveal au scroll vers le bas de la page pricing
    const pricingSection = document.getElementById('pricing');
    const bottomObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach(e => {
          if (e.isIntersecting && e.intersectionRatio >= 0.85) {
            setTimeout(showReveal, 800);
            bottomObserver.disconnect();
          }
        });
      },
      { threshold: 0.85 }
    );
    if (pricingSection) bottomObserver.observe(pricingSection);

    // Fermer en cliquant sur l'overlay (sauf sur les liens/boutons)
    document.getElementById('reveal-overlay')?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') return;
      document.getElementById('reveal-overlay')!.classList.remove('active');
      document.body.style.overflow = '';
    });
  </script>

</body>
</html>
