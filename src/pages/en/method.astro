---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { business } from '../../data/business';

const whatsappMessage = encodeURIComponent("Hi Marc, I'd like to discuss a web project.");

const steps = [
  { num: '01', title: 'You order online', detail: 'Secure payment, guided questionnaire right away. You describe your business, your clients, what you want the site to do for you. 15 minutes, no more.', time: 'Day 0' },
  { num: '02', title: 'We align quickly', detail: 'A 15-minute call — phone, video, or written, your choice. I clarify the last few open questions. No lengthy meetings.', time: 'Day 1' },
  { num: '03', title: 'I build everything', detail: 'Unique design, copywriting, optimised images, SEO, Schema.org, Open Graph. Everything. You touch nothing.', time: 'Days 2–6' },
  { num: '04', title: 'You receive the preview link', detail: 'You see the site before it goes live. You send your full list of changes — I fix everything at once. Then we go live on your domain.', time: 'Day 7' },
];

const reasons = [
  { title: 'No sales rep', text: 'You talk directly to the person writing your code. No account manager, no project coordinator between you and the work.' },
  { title: 'No office costs', text: '100% remote. Clients in Paris, Lyon, Strasbourg, and across Europe. The overhead of an agency isn\'t in your quote.' },
  { title: 'Modern tools', text: 'Astro, Tailwind CSS, Cloudflare. No WordPress with 40 plugins to maintain. Sites that load in under one second and don\'t break.' },
  { title: 'A documented process', text: 'Every step is tooled and repeatable. What took weeks to build the first time now takes days. The efficiency goes back into the price.' },
  { title: 'Volume = credibility', text: '33 projects delivered. Each one taught me something. Past mistakes don\'t resurface in your pages.' },
  { title: 'One craftsperson, start to finish', text: 'Design, code, copy, SEO, deployment — one person responsible. No handoff, no brief lost between departments.' },
];
---

<BaseLayout
  title="How it works — Marc M | Process & Method"
  description="Full process: how I deliver a bespoke website in 7 days at €490. No templates, no WordPress, no middlemen."
  lang="en"
  frPath="/methode"
  enPath="/en/method"
>

  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>
    <div class="mx-auto max-w-3xl relative z-10">
      <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color: #E86C47; letter-spacing: 0.2em;">How it works</p>
      <h1 class="text-3xl font-bold text-white md:text-4xl lg:text-5xl mb-6 leading-tight">
        A site at €490.<br/>
        <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">Not a compromise.</span>
      </h1>
      <p class="text-lg text-neutral-300 max-w-xl leading-relaxed">
        It's not a template. It's not rushed. Here's why it's possible — and how it works in practice.
      </p>
    </div>
  </section>

  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-20">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] mb-3" style="letter-spacing: 0.2em;">The process</p>
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-10">4 steps, 7 days</h2>
      <div class="space-y-0">
        {steps.map((e, i) => (
          <div class="flex gap-6 pb-10 relative">
            {i < steps.length - 1 && <div class="absolute left-6 top-14 bottom-0 w-px bg-neutral-200"></div>}
            <div class="flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center font-bold text-white text-sm z-10" style="background-color: #E86C47;">{e.num}</div>
            <div class="pt-2.5">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="font-bold text-[var(--color-text)]">{e.title}</h3>
                <span class="text-xs text-neutral-400 bg-neutral-100 px-2 py-0.5 rounded-full">{e.time}</span>
              </div>
              <p class="text-[var(--color-text-muted)] text-sm leading-relaxed">{e.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="w-full px-6 py-16 md:px-8 md:py-20" style="background: #FAFAFA;">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] mb-3" style="letter-spacing: 0.2em;">The real question</p>
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-3">Why €490 and not €2,500?</h2>
      <p class="text-[var(--color-text-muted)] mb-10 max-w-2xl">A fair question. Here are the real reasons — not a marketing pitch.</p>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map(r => (
          <div class="bg-white rounded-xl border border-[var(--color-border)] p-6">
            <h3 class="font-bold text-[var(--color-text)] mb-2 text-sm">{r.title}</h3>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{r.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 bg-amber-50 border border-amber-200 rounded-xl p-6">
        <p class="text-sm text-amber-900 leading-relaxed">
          <strong>The honest comparison:</strong> An agency charging €2,500 is also billing their offices, their sales rep, their project manager, and their meetings. The code produced isn't 5× better — the overhead is 5× higher. Here, you pay for the actual work.
        </p>
      </div>
    </div>
  </section>

  <section class="w-full relative px-6 py-16 md:px-8 md:py-20 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="mx-auto max-w-2xl text-center relative z-10">
      <h2 class="text-2xl font-bold text-white mb-4">Ready to start?</h2>
      <p class="text-neutral-300 mb-8">Ordering takes 10 minutes. Your site arrives in 7 days.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <Button href="/en/services" variant="primary">See the offer — €490</Button>
        <Button href={`https://wa.me/${business.whatsapp}?text=${whatsappMessage}`} variant="secondary" external>A question first →</Button>
      </div>
    </div>
  </section>

</BaseLayout>
