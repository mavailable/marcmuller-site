---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SchemaOrg from '../../../components/SchemaOrg.astro';
import { business } from '../../../data/business';

const title = 'Help & Getting Started Guides · Marc M';
const description = 'Step-by-step guides to set up your domain, contact form, online calendar, and other tools tied to your website.';

interface Guide {
  title: string;
  slug: string;
  duration: string;
  excerpt: string;
  tag: string;
  icon: string;
}

const guides: Guide[] = [
  {
    title: 'Buy your domain name (OVH, Cloudflare, Gandi)',
    slug: 'ovh-domain',
    duration: '10 min',
    excerpt: 'Register your .com, .fr or country-specific domain, or connect the one you already own, by changing two nameservers.',
    tag: 'Domain',
    icon: 'globe',
  },
  {
    title: 'Give access to your GoDaddy domain',
    slug: 'godaddy-domain',
    duration: '5 min',
    excerpt: 'Already own a domain at GoDaddy? Give me access through delegate access, without sharing your credentials.',
    tag: 'Domain',
    icon: 'globe',
  },
  {
    title: 'Buy and delegate your Cloudflare domain',
    slug: 'cloudflare-domain',
    duration: '10 min',
    excerpt: 'Buy your domain at Cloudflare (at cost) and give me technical control by inviting me as a member, without sharing your credentials.',
    tag: 'Domain',
    icon: 'globe',
  },
  {
    title: 'Create your Web3Forms account',
    slug: 'web3forms',
    duration: '3 min',
    excerpt: 'Sign up for free and retrieve your access key to activate your site\'s contact form.',
    tag: 'Form',
    icon: 'mail',
  },
  {
    title: 'Set up your Cal.com calendar',
    slug: 'cal-com',
    duration: '10 min',
    excerpt: 'Create your free online calendar so clients can book a time slot directly from your site.',
    tag: 'Calendar',
    icon: 'calendar',
  },
  {
    title: 'Prepare your technical access',
    slug: 'technical-access',
    duration: '5 min',
    excerpt: 'Gather the info I need to put your site live: domain, email, credentials.',
    tag: 'Technical',
    icon: 'key',
  },
];

const breadcrumbs = [
  { name: 'Home', url: `${business.url}/en/` },
  { name: 'Help', url: `${business.url}/en/help/` },
];

const tagColors: Record<string, { badge: string; bar: string; heroBadge: string }> = {
  'Domain':    { badge: 'bg-sky-100 text-sky-700',         bar: 'bg-sky-400',     heroBadge: 'border-sky-400/40 bg-sky-400/15 text-sky-300' },
  'Form':      { badge: 'bg-emerald-100 text-emerald-700', bar: 'bg-emerald-400', heroBadge: 'border-emerald-400/40 bg-emerald-400/15 text-emerald-300' },
  'Calendar':  { badge: 'bg-violet-100 text-violet-700',   bar: 'bg-violet-400',  heroBadge: 'border-violet-400/40 bg-violet-400/15 text-violet-300' },
  'Technical': { badge: 'bg-orange-100 text-orange-700',   bar: 'bg-orange-400',  heroBadge: 'border-orange-400/40 bg-orange-400/15 text-orange-300' },
};

const icons: Record<string, string> = {
  globe: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 0 1 4 9 15 15 0 0 1-4 9 15 15 0 0 1-4-9 15 15 0 0 1 4-9Z',
  mail: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2Zm16 2-8 5-8-5',
  calendar: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z',
  key: 'M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.78 7.78 5.5 5.5 0 0 1 7.78-7.78Zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4',
};

const faq = [
  {
    question: 'Do I need to handle everything before you start my site?',
    answer: 'No. I can start building your site as soon as the brief is validated. The technical access (domain, Web3Forms, etc.) is only needed at launch time.',
  },
  {
    question: 'I\'m not tech-savvy, is this complicated?',
    answer: 'Each guide is written for non-technical users. If you get stuck at any step, send me a message and I\'ll walk you through it live by phone or WhatsApp.',
  },
  {
    question: 'Are these services paid?',
    answer: 'Web3Forms and Cal.com are free. Only the domain name has a cost: around 10-15 USD per year depending on the registrar and extension.',
  },
];
---

<BaseLayout title={title} description={description} lang="en" frPath="/aide" enPath="/en/help" noindex>

  <SchemaOrg type="breadcrumb" data={breadcrumbs} />
  <SchemaOrg type="faqPage" data={faq} />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-neutral-200">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]"></span>
        Help Center
      </div>

      <h1 class="mb-5 text-4xl font-bold leading-tight text-white md:text-5xl">
        Getting started guides
      </h1>
      <p class="max-w-2xl text-lg text-white/90 md:text-xl leading-relaxed">
        Everything you need to set up for your site, explained step-by-step. Each guide takes under 10 minutes.
      </p>
    </div>
  </section>

  <!-- GUIDES GRID -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-4xl">
      <div class="grid gap-5 sm:grid-cols-2">
        {guides.map((guide) => (
          <a href={`/en/help/${guide.slug}`} class="group block" data-umami-event="help-guide-click" data-umami-event-guide={guide.slug}>
            <article class="flex h-full flex-col overflow-hidden rounded-xl border border-[var(--color-border)] bg-white shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
              <div class={`h-1 w-full shrink-0 ${tagColors[guide.tag]?.bar ?? 'bg-[var(--color-accent)]'}`}></div>

              <div class="flex flex-1 flex-col p-6">
                <!-- Icon + Meta -->
                <div class="mb-3 flex items-center gap-3">
                  <div class={`flex h-9 w-9 items-center justify-center rounded-lg ${tagColors[guide.tag]?.badge ?? 'bg-neutral-100 text-neutral-600'}`}>
                    <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={icons[guide.icon]} />
                    </svg>
                  </div>
                  <div class="flex flex-wrap items-center gap-2">
                    <span class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${tagColors[guide.tag]?.badge ?? 'bg-neutral-100 text-neutral-600'}`}>
                      {guide.tag}
                    </span>
                    <span class="flex items-center gap-1 text-xs text-[var(--color-text-muted)]">
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      {guide.duration}
                    </span>
                  </div>
                </div>

                <!-- Title -->
                <h2 class="mb-3 text-base font-bold leading-snug text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent-text)] md:text-lg">
                  {guide.title}
                </h2>

                <!-- Excerpt -->
                <p class="mb-5 flex-1 text-sm leading-relaxed text-[var(--color-text-muted)]">
                  {guide.excerpt}
                </p>

                <!-- CTA -->
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-accent-text)] transition-all group-hover:gap-2.5">
                  Read the guide
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-24 border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-10 text-2xl font-bold text-[var(--color-text)] md:text-3xl">Frequently asked questions</h2>
      <div class="space-y-6">
        {faq.map((item) => (
          <details class="group rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 text-base font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-text)] transition-colors [&::-webkit-details-marker]:hidden">
              {item.question}
              <svg class="w-5 h-5 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-5 pb-5">
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full bg-gradient-to-b from-[#1A1A1A] to-[#111111] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-4 text-2xl font-bold text-white">Need a hand?</h2>
      <p class="mb-8 text-white/90 leading-relaxed">
        If you get stuck on a step, send me a message and I'll walk you through it live.
      </p>
      <a
        href="/en/contact"
        class="inline-block px-8 py-3 bg-[var(--color-accent)] text-white font-semibold rounded-xl hover:bg-[var(--color-accent-hover)] transition-all shadow-lg hover:shadow-xl"
        style="box-shadow: 0 10px 25px rgba(232, 108, 71, 0.3);"
        data-umami-event="help-cta-contact"
      >
        Contact me
      </a>
    </div>
  </section>
</BaseLayout>
