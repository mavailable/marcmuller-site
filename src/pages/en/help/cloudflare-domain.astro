---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SchemaOrg from '../../../components/SchemaOrg.astro';
import { business } from '../../../data/business';

const title = 'Buy and delegate your Cloudflare domain: step-by-step guide · Marc M';
const description = 'Step-by-step guide to buy your domain at Cloudflare (at cost) and delegate technical management by inviting me as an Administrator member. You stay the owner, revocable anytime.';

const breadcrumbs = [
  { name: 'Home', url: `${business.url}/en/` },
  { name: 'Help', url: `${business.url}/en/help/` },
  { name: 'Cloudflare domain', url: `${business.url}/en/help/cloudflare-domain/` },
];

const steps = [
  {
    name: 'Sign in to Cloudflare (or create a free account)',
    text: 'Open the Cloudflare dashboard. If you don\'t have an account yet, create one, it\'s free. Verify your email address and keep a payment card handy for the domain purchase.',
    link: { href: 'https://dash.cloudflare.com', label: 'Open the Cloudflare dashboard' },
  },
  {
    name: 'Register your domain name',
    text: 'In the menu, go to "Domain Registration" then "Register Domains". Search for the name you want, for example my-business.com, and pay by card.',
    detail: 'Cloudflare sells domains at cost, with no markup: you pay the registry price, usually around 10 to 13 USD per year for a .com, at the same price every year. The DNS zone is created automatically in your account.',
    path: 'Dashboard > Domain Registration > Register Domains',
    tip: 'You only need the domain name. Your site hosting is part of my service, on Cloudflare\'s own infrastructure, so everything ends up in one place.',
  },
  {
    name: 'Open member management',
    text: 'Still in the dashboard, click "Manage Account" then "Members". This is where you add me so I can handle the technical side.',
    path: 'Dashboard > Manage Account > Members',
  },
  {
    name: 'Invite me with my email address',
    text: 'Click the "Invite" button, then enter my email address in the field:',
    code: 'marc@muller.im',
    copyable: true,
    detail: 'It\'s the same address you use to reach me. Cloudflare will send the invitation there.',
  },
  {
    name: 'Pick the "Administrator" role',
    text: 'For the role, select "Administrator", and not "Super Administrator". This is intentional: on free Cloudflare accounts only these two roles exist, and "Administrator" gives me everything I need on the technical side without touching what belongs to you.',
    detail: 'Concretely, "Administrator" lets me manage DNS, SSL certificates, site configuration and domain settings (renewal, contacts). It touches neither your billing nor your card, and only the "Super Administrator", meaning you, can delete the domain.',
  },
  {
    name: 'Confirm the invitation',
    text: 'Click "Continue to summary" then confirm with "Invite". I receive the invitation by email and accept it on my side: that\'s it, nothing else for you to do.',
  },
  {
    name: 'Let me know it\'s done',
    text: 'Send me a message by email or WhatsApp with the registered domain name. I receive the invitation on my side and start the DNS setup to point to your site.',
  },
];

const howToSteps = steps.map(s => ({ name: s.name, text: s.text }));

const faq = [
  {
    question: 'Why buy my domain at Cloudflare?',
    answer: 'Cloudflare sells domains at cost, with no markup and no pushy add-ons. Since your site is hosted on Cloudflare\'s infrastructure anyway, the domain and the site end up in one place: simpler to manage and to track.',
  },
  {
    question: 'Does Marc have access to my card or billing?',
    answer: 'No. The "Administrator" role gives no access to billing or payment methods. I can manage the domain\'s technical side (DNS, SSL, settings), none of your banking details.',
  },
  {
    question: 'Can I remove this access later?',
    answer: 'Yes, anytime. Go to "Members", find the row with my name, click "Revoke" then confirm with "Yes, revoke access". Access is cut immediately, and you don\'t need anyone to do it.',
  },
  {
    question: 'Who pays for the domain, and how much?',
    answer: 'You do, directly at Cloudflare, at cost: usually around 10 to 13 USD per year for a .com, no markup. Renewal is charged to your card at the same price. I recommend turning on auto-renew.',
  },
  {
    question: 'Do I also need to buy hosting?',
    answer: 'No. Your site is hosted on Cloudflare Pages, that\'s part of my service. At Cloudflare, you only need the domain name.',
  },
];
---

<BaseLayout title={title} description={description} lang="en" frPath="/aide/domaine-cloudflare" enPath="/en/help/cloudflare-domain" noindex>

  <SchemaOrg type="breadcrumb" data={breadcrumbs} />
  <SchemaOrg type="howTo" data={{
    name: 'Buy and delegate your Cloudflare domain',
    description: 'Guide to register your domain at Cloudflare and invite me as an Administrator member for technical management.',
    totalTime: 'PT10M',
    steps: howToSteps,
  }} />
  <SchemaOrg type="faqPage" data={faq} />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative mx-auto max-w-3xl z-10">
      <a href="/en/help" class="inline-flex items-center gap-2 text-sm text-white/90 hover:text-white transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
        Back to all guides
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-block rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-xs font-semibold text-sky-300">
          Domain
        </span>
        <span class="text-sm text-white/90">~10 minutes</span>
        <span class="text-sm text-white/90">•</span>
        <span class="text-sm text-white/90">Domain at cost</span>
      </div>

      <h1 class="mb-6 text-3xl font-bold leading-tight text-white md:text-5xl">
        Buy and delegate your Cloudflare domain
      </h1>
      <p class="text-lg text-white/90 md:text-xl leading-relaxed">
        Register your domain at Cloudflare, then give me technical control by inviting me as a member. You stay the owner, I only handle the technical side.
      </p>
    </div>
  </section>

  <!-- GUIDE BODY -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl">
      <article class="rounded-xl bg-white border border-[var(--color-border)] p-8 md:p-12 shadow-sm">

        <!-- Steps -->
        <div class="space-y-10">
          {steps.map((step, i) => (
            <div class="flex gap-5">
              <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent)] text-white font-bold text-sm shadow-md">
                {i + 1}
              </div>
              <div class="flex-1 pt-1.5">
                <h2 class="text-lg font-bold text-[var(--color-text)] mb-2">{step.name}</h2>
                <p class="text-[var(--color-text-muted)] leading-relaxed">{step.text}</p>

                {/* Email to copy */}
                {step.code && (
                  <div class="mt-3 rounded-lg bg-[#0D0D0D] px-5 py-3 flex items-center gap-3 max-w-fit">
                    <code class="text-lg font-mono font-bold text-white tracking-wide">{step.code}</code>
                    <button
                      type="button"
                      class="copy-btn flex items-center gap-1.5 rounded-md bg-white/10 px-3 py-1.5 text-xs font-semibold text-white hover:bg-white/20 transition-colors"
                      data-copy={step.code}
                      data-umami-event="help-domain-cloudflare-copy"
                      aria-label="Copy email address"
                    >
                      <svg class="w-3.5 h-3.5 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                      <svg class="w-3.5 h-3.5 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span class="copy-label">Copy</span>
                    </button>
                  </div>
                )}

                {/* Additional detail */}
                {step.detail && (
                  <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{step.detail}</p>
                )}

                {/* Navigation path */}
                {step.path && (
                  <div class="mt-3 rounded-lg bg-neutral-50 border border-neutral-200 px-4 py-2.5">
                    <p class="text-xs font-semibold text-neutral-500 mb-1">Path in the dashboard</p>
                    <p class="text-sm font-mono text-neutral-700">{step.path}</p>
                  </div>
                )}

                {/* Tip */}
                {step.tip && (
                  <div class="mt-3 rounded-lg bg-amber-50 border border-amber-200 px-4 py-2.5">
                    <p class="text-sm text-amber-700">{step.tip}</p>
                  </div>
                )}

                {/* External link */}
                {step.link && (
                  <a href={step.link.href} target="_blank" rel="noopener noreferrer"
                    class="mt-3 inline-flex items-center gap-2 rounded-lg border border-[var(--color-accent)]/20 bg-[var(--color-accent)]/5 px-4 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] hover:bg-[var(--color-accent)]/10 transition-colors"
                    data-umami-event="help-domain-cloudflare-ext-link" data-umami-event-url={step.link.href}>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    {step.link.label}
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Reassurance callout -->
        <div class="mt-10 rounded-lg bg-emerald-50 border border-emerald-200 p-5">
          <p class="text-sm font-semibold text-emerald-800 mb-2">You stay in control</p>
          <p class="text-sm text-emerald-700 leading-relaxed">
            The "Administrator" role gives me control over the technical side, nothing more. No access to your billing or card, no member management (I can't invite or remove anyone), and no domain deletion (reserved for the "Super Administrator", which is you). You remain the sole owner of the account and the domain, and you can revoke my access anytime: "Members", the row with my name, "Revoke", then "Yes, revoke access".
          </p>
        </div>

        <!-- Tips -->
        <div class="mt-6 rounded-lg bg-amber-50 border border-amber-200 p-5">
          <p class="text-sm font-semibold text-amber-800 mb-2">Tips</p>
          <ul class="list-disc pl-4 text-sm text-amber-700 leading-relaxed space-y-1.5">
            <li>Turn on domain auto-renew so you don't risk losing it (renewal is charged to your card, at cost).</li>
            <li>Enable two-step verification (2FA) on your Cloudflare account: a simple, effective security habit.</li>
            <li>Don't touch any DNS setting yourself, I handle it.</li>
          </ul>
        </div>

        <!-- FAQ -->
        <div class="mt-10 space-y-4">
          <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-text-muted)]">Frequently asked questions</p>
          {faq.map((item) => (
            <details class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-4 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-text)] transition-colors [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-4 pb-4">
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{item.answer}</p>
              </div>
            </details>
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-10 rounded-xl bg-[#0D0D0D] p-6 text-center">
          <p class="text-white font-semibold mb-2">Once the invite is sent</p>
          <p class="text-white/90 text-sm mb-5">Send me your domain name by email or WhatsApp.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href={`mailto:${business.email}?subject=Cloudflare domain: member invite added&body=Hi Marc,%0A%0AI registered my domain at Cloudflare and invited you as an Administrator member.%0A%0AMy domain: %0A%0AThanks!`}
              class="inline-block px-6 py-2.5 bg-[var(--color-accent)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--color-accent-hover)] transition-all"
              data-umami-event="help-domain-cloudflare-email">
              Send by email
            </a>
            <a href={`https://wa.me/${business.whatsapp}?text=Hi Marc, I registered my domain at Cloudflare and invited you as an Administrator member. My domain: `}
              target="_blank" rel="noopener noreferrer"
              class="inline-block px-6 py-2.5 bg-white/10 text-white text-sm font-semibold rounded-lg border border-white/20 hover:bg-white/20 transition-all"
              data-umami-event="help-domain-cloudflare-whatsapp">
              Send by WhatsApp
            </a>
          </div>
        </div>

        <!-- Next guide -->
        <div class="mt-8 flex items-center justify-between rounded-lg border border-[var(--color-border)] p-4">
          <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-muted)]">Next guide</span>
          <a href="/en/help/web3forms" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-text)] hover:gap-3 transition-all">
            Create your Web3Forms account
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </article>
    </div>
  </section>

  <script>
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (!text) return;
        await navigator.clipboard.writeText(text);
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const label = btn.querySelector('.copy-label');
        if (copyIcon) copyIcon.classList.add('hidden');
        if (checkIcon) checkIcon.classList.remove('hidden');
        if (label) label.textContent = 'Copied!';
        setTimeout(() => {
          if (copyIcon) copyIcon.classList.remove('hidden');
          if (checkIcon) checkIcon.classList.add('hidden');
          if (label) label.textContent = 'Copy';
        }, 2000);
      });
    });
  </script>
</BaseLayout>
