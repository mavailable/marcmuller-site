---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SchemaOrg from '../../../components/SchemaOrg.astro';
import { business } from '../../../data/business';

const title = 'Give access to your GoDaddy domain — Step-by-step · Marc M';
const description = 'Guide to give me access to your GoDaddy domain through delegate access, without sharing your credentials. Secure, scoped to the domain, revocable at any time.';

const breadcrumbs = [
  { name: 'Home', url: `${business.url}/en/` },
  { name: 'Help', url: `${business.url}/en/help/` },
  { name: 'GoDaddy domain access', url: `${business.url}/en/help/godaddy-domain/` },
];

const steps = [
  {
    name: 'Sign in to your GoDaddy account',
    text: 'Open the link below and sign in with your usual GoDaddy credentials.',
    link: { href: 'https://account.godaddy.com', label: 'Open GoDaddy — My Account' },
  },
  {
    name: 'Open the "Delegate Access" page',
    text: 'Click your name (top right), then "Account Settings" and "Delegate Access". Faster: type the address below directly in the browser bar.',
    link: { href: 'https://account.godaddy.com/access', label: 'Open the Delegate Access page' },
    path: 'Your name > Account Settings > Delegate Access',
  },
  {
    name: 'Start an access invitation',
    text: 'In the "People who can access my account" section, click the "Invite to Access" button.',
    image: '/images/aide/godaddy-delegate-access.webp',
    imageAlt: '"People who can access my account" section on GoDaddy with the "Invite to Access" button',
    imageW: 550,
    imageH: 544,
  },
  {
    name: 'Fill in the form',
    text: 'Enter my name and email, then pick the most restrictive access level. Here are the exact values to enter:',
    fields: [
      { label: 'Name', value: 'Marc Muller (marcm.fr)' },
      { label: 'Email', value: 'marc@muller.im' },
    ],
    detail: 'For "Access level requested", select "Domains Only" (GoDaddy describes it as "Access to manage specific domains only."). It is the most restrictive level: I can manage the domain only, with no access to your payment methods, billing, or other products.',
    image: '/images/aide/godaddy-invite.webp',
    imageAlt: 'GoDaddy invite form filled in with the "Domains Only" option selected and the "Invite" button active',
    imageW: 1218,
    imageH: 790,
  },
  {
    name: 'Click "Invite"',
    text: 'GoDaddy then sends me an invitation by email. I accept it on my side and I can set up the connection between the domain and your site.',
    detail: 'If GoDaddy asks you to pick a specific domain, select the one for your site.',
  },
  {
    name: 'Confirm it\'s done',
    text: 'Send me a message by email or WhatsApp with the domain name. I receive the invitation on my side and I start the setup.',
  },
];

const howToSteps = steps.map(s => ({ name: s.name, text: s.text }));

const faq = [
  {
    question: 'Why delegate access instead of my credentials?',
    answer: 'With delegate access, you keep your credentials to yourself. You invite me as a delegate on your domain only. It\'s safer for you, and you can remove that access whenever you want.',
  },
  {
    question: 'Does "Domains Only" really protect me?',
    answer: 'Yes. That level gives me access to domain management and nothing else. No access to your payment methods, billing, or other GoDaddy products. It\'s the most restrictive level GoDaddy offers.',
  },
  {
    question: 'Do I remain the owner of my domain?',
    answer: 'Always. Delegation transfers nothing: you stay the sole owner of the domain and your account. I\'m simply allowed to configure the technical connection to your site.',
  },
  {
    question: 'How do I remove access later?',
    answer: 'Go back to the same "Delegate Access" page in your GoDaddy account settings. You\'ll see the list of authorized people and can revoke an access in one click, at any time.',
  },
];
---

<BaseLayout title={title} description={description} lang="en" frPath="/aide/domaine-godaddy" enPath="/en/help/godaddy-domain" noindex>

  <SchemaOrg type="breadcrumb" data={breadcrumbs} />
  <SchemaOrg type="howTo" data={{
    name: 'Give access to your GoDaddy domain',
    description: 'Guide to invite Marc Muller as a delegate on your GoDaddy domain, without sharing your credentials.',
    totalTime: 'PT5M',
    steps: howToSteps,
  }} />
  <SchemaOrg type="faqPage" data={faq} />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative mx-auto max-w-3xl z-10">
      <a href="/en/help" class="inline-flex items-center gap-2 text-sm text-white/90 hover:text-white transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
        Back to all guides
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-block rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-xs font-semibold text-sky-300">
          Domain
        </span>
        <span class="text-sm text-white/90">~5 minutes</span>
        <span class="text-sm text-white/90">•</span>
        <span class="text-sm text-white/90">No credentials to share</span>
      </div>

      <h1 class="mb-6 text-3xl font-bold leading-tight text-white md:text-5xl">
        Give access to your GoDaddy domain
      </h1>
      <p class="text-lg text-white/90 md:text-xl leading-relaxed">
        Instead of handing over your GoDaddy credentials, you invite me as a "delegate" on your domain. It's secure, scoped to the domain, revocable at any time, and you keep full ownership.
      </p>
    </div>
  </section>

  <!-- GUIDE BODY -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl">
      <article class="rounded-xl bg-white border border-[var(--color-border)] p-8 md:p-12 shadow-sm">

        <!-- Steps -->
        <div class="space-y-10">
          {steps.map((step, i) => (
            <div class="flex gap-5">
              <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent)] text-white font-bold text-sm shadow-md">
                {i + 1}
              </div>
              <div class="flex-1 pt-1.5">
                <h2 class="text-lg font-bold text-[var(--color-text)] mb-2">{step.name}</h2>
                <p class="text-[var(--color-text-muted)] leading-relaxed">{step.text}</p>

                {/* Form fields to enter (name + email) with copy buttons */}
                {step.fields && (
                  <div class="mt-3 space-y-2">
                    {step.fields.map((field) => (
                      <div class="rounded-lg bg-[#0D0D0D] px-5 py-3 flex items-center justify-between gap-3 flex-wrap">
                        <div class="flex items-baseline gap-3">
                          <span class="text-xs font-semibold uppercase tracking-wide text-neutral-400">{field.label}</span>
                          <code class="text-base font-mono font-bold text-white tracking-wide">{field.value}</code>
                        </div>
                        <button
                          type="button"
                          class="copy-btn flex items-center gap-1.5 rounded-md bg-white/10 px-3 py-1.5 text-xs font-semibold text-white hover:bg-white/20 transition-colors"
                          data-copy={field.value}
                          data-umami-event="help-domain-godaddy-copy"
                          aria-label={`Copy ${field.label}`}
                        >
                          <svg class="w-3.5 h-3.5 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                          </svg>
                          <svg class="w-3.5 h-3.5 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                          <span class="copy-label">Copy</span>
                        </button>
                      </div>
                    ))}
                  </div>
                )}

                {/* Additional detail */}
                {step.detail && (
                  <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{step.detail}</p>
                )}

                {/* Navigation path */}
                {step.path && (
                  <div class="mt-3 rounded-lg bg-neutral-50 border border-neutral-200 px-4 py-2.5">
                    <p class="text-xs font-semibold text-neutral-500 mb-1">Path in your account</p>
                    <p class="text-sm font-mono text-neutral-700">{step.path}</p>
                  </div>
                )}

                {/* External link */}
                {step.link && (
                  <a href={step.link.href} target="_blank" rel="noopener noreferrer"
                    class="mt-3 inline-flex items-center gap-2 rounded-lg border border-[var(--color-accent)]/20 bg-[var(--color-accent)]/5 px-4 py-2.5 text-sm font-semibold text-[var(--color-accent-text)] hover:bg-[var(--color-accent)]/10 transition-colors"
                    data-umami-event="help-domain-godaddy-ext-link" data-umami-event-url={step.link.href}>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    {step.link.label}
                  </a>
                )}

                {/* Screenshot */}
                {step.image && (
                  <div class="mt-4 rounded-lg border border-[var(--color-border)] overflow-hidden shadow-sm">
                    <img src={step.image} alt={step.imageAlt} width={step.imageW} height={step.imageH} loading="lazy" decoding="async" class="w-full h-auto" />
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Reassurance callout -->
        <div class="mt-10 rounded-lg bg-emerald-50 border border-emerald-200 p-5">
          <p class="text-sm font-semibold text-emerald-800 mb-2">You stay in control</p>
          <p class="text-sm text-emerald-700 leading-relaxed">
            You remain the sole owner of your domain. The "Domains Only" level gives me no access to your banking information or your purchases. You can revoke this access at any time from the same "Delegate Access" page.
          </p>
        </div>

        <!-- FAQ -->
        <div class="mt-10 space-y-4">
          <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-text-muted)]">Frequently asked questions</p>
          {faq.map((item) => (
            <details class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-4 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-text)] transition-colors [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-4 pb-4">
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{item.answer}</p>
              </div>
            </details>
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-10 rounded-xl bg-[#0D0D0D] p-6 text-center">
          <p class="text-white font-semibold mb-2">Once the invitation is sent</p>
          <p class="text-white/90 text-sm mb-5">Send me your domain name by email or WhatsApp.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href={`mailto:${business.email}?subject=GoDaddy domain access&body=Hi Marc,%0A%0AI invited you as a delegate on my GoDaddy domain.%0A%0AMy domain: %0A%0AThanks!`}
              class="inline-block px-6 py-2.5 bg-[var(--color-accent)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--color-accent-hover)] transition-all"
              data-umami-event="help-domain-godaddy-email">
              Send by email
            </a>
            <a href={`https://wa.me/${business.whatsapp}?text=Hi Marc, I invited you as a delegate on my GoDaddy domain. My domain: `}
              target="_blank" rel="noopener noreferrer"
              class="inline-block px-6 py-2.5 bg-white/10 text-white text-sm font-semibold rounded-lg border border-white/20 hover:bg-white/20 transition-all"
              data-umami-event="help-domain-godaddy-whatsapp">
              Send by WhatsApp
            </a>
          </div>
        </div>

        <!-- Next guide -->
        <div class="mt-8 flex items-center justify-between rounded-lg border border-[var(--color-border)] p-4">
          <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-muted)]">Next guide</span>
          <a href="/en/help/web3forms" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-text)] hover:gap-3 transition-all">
            Create your Web3Forms account
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </article>
    </div>
  </section>

  <script>
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (!text) return;
        await navigator.clipboard.writeText(text);
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const label = btn.querySelector('.copy-label');
        if (copyIcon) copyIcon.classList.add('hidden');
        if (checkIcon) checkIcon.classList.remove('hidden');
        if (label) label.textContent = 'Copied!';
        setTimeout(() => {
          if (copyIcon) copyIcon.classList.remove('hidden');
          if (checkIcon) checkIcon.classList.add('hidden');
          if (label) label.textContent = 'Copy';
        }, 2000);
      });
    });
  </script>
</BaseLayout>
