---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SchemaOrg from '../../../components/SchemaOrg.astro';
import { business } from '../../../data/business';

const title = 'Create your Web3Forms account & get your key · Marc M';
const description = 'Sign up for Web3Forms in 3 minutes and retrieve the access key to activate your site\'s contact form.';

const breadcrumbs = [
  { name: 'Home', url: `${business.url}/en/` },
  { name: 'Help', url: `${business.url}/en/help/` },
  { name: 'Web3Forms', url: `${business.url}/en/help/web3forms/` },
];

const howToSteps = [
  { name: 'Go to Web3Forms', text: 'Open web3forms.com. It\'s a free service, no credit card required.' },
  { name: 'Enter your professional email', text: 'In the "Create your Access Key" section, type the email where you want to receive form messages. That\'s the inbox your clients will reach.' },
  { name: 'Check your inbox', text: 'Web3Forms sends you a confirmation email. Click the link inside. Check spam if you don\'t see it.' },
  { name: 'Copy your Access Key', text: 'Once confirmed, Web3Forms shows your Access Key, a string like "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx". Copy it.' },
  { name: 'Send me the key', text: 'Send me the key by email or WhatsApp. I\'ll wire it into your contact form. Messages will then land in your inbox.' },
];

const faq = [
  {
    question: 'What does this key actually do?',
    answer: 'The key links your site form to your inbox. When a visitor fills the form, Web3Forms uses the key to know where to send the message. Sharing it with me is safe, it doesn\'t grant access to anything else.',
  },
  {
    question: 'Is Web3Forms really free?',
    answer: 'Yes. The free plan handles up to 250 messages per month, which is plenty for a small business site. No credit card needed.',
  },
  {
    question: 'Can I change the receiving email later?',
    answer: 'Yes, you can update the linked email from your Web3Forms dashboard anytime. I don\'t need to change anything on my end, the key stays the same.',
  },
];
---

<BaseLayout title={title} description={description} lang="en" frPath="/aide/web3forms" enPath="/en/help/web3forms" noindex>

  <SchemaOrg type="breadcrumb" data={breadcrumbs} />
  <SchemaOrg type="howTo" data={{
    name: 'Create a Web3Forms account and get the access key',
    description: 'Guide to create a free Web3Forms account and retrieve the access key needed for your site\'s contact form.',
    totalTime: 'PT3M',
    steps: howToSteps,
  }} />
  <SchemaOrg type="faqPage" data={faq} />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative mx-auto max-w-3xl z-10">
      <a href="/en/help" class="inline-flex items-center gap-2 text-sm text-white/90 hover:text-white transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
        Back to all guides
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-block rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-300">
          Form
        </span>
        <span class="text-sm text-white/90">~3 minutes</span>
        <span class="text-sm text-white/90">•</span>
        <span class="text-sm text-white/90">100% free</span>
      </div>

      <h1 class="mb-6 text-3xl font-bold leading-tight text-white md:text-5xl">
        Create your Web3Forms account
      </h1>
      <p class="text-lg text-white/90 md:text-xl leading-relaxed">
        Web3Forms lets visitors message you from your site. The whole setup takes 3 minutes.
      </p>
    </div>
  </section>

  <!-- GUIDE BODY -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl">
      <article class="rounded-xl bg-white border border-[var(--color-border)] p-8 md:p-12 shadow-sm">

        <!-- Intro -->
        <div class="mb-10 rounded-lg bg-emerald-50 border border-emerald-200 p-5">
          <p class="text-sm font-semibold text-emerald-800 mb-1">How does it work?</p>
          <p class="text-sm text-emerald-700 leading-relaxed">
            When a visitor fills the contact form on your site, Web3Forms emails the message straight to you. No clunky dashboard, everything lands in your usual inbox.
          </p>
        </div>

        <!-- Steps -->
        <div class="space-y-8">
          {howToSteps.map((step, i) => (
            <div class="flex gap-5">
              <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent)] text-white font-bold text-sm shadow-md">
                {i + 1}
              </div>
              <div class="flex-1 pt-1.5">
                <h2 class="text-lg font-bold text-[var(--color-text)] mb-2">{step.name}</h2>
                <p class="text-[var(--color-text-muted)] leading-relaxed">{step.text}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Key format -->
        <div class="mt-10 rounded-lg bg-neutral-50 border border-neutral-200 p-5">
          <p class="text-sm font-semibold text-neutral-700 mb-2">What does the key look like?</p>
          <code class="block bg-neutral-100 rounded-lg px-4 py-3 text-sm font-mono text-neutral-600 break-all">
            a1b2c3d4-e5f6-7890-abcd-ef1234567890
          </code>
        </div>

        <!-- FAQ -->
        <div class="mt-10 space-y-4">
          <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-text-muted)]">Frequently asked questions</p>
          {faq.map((item) => (
            <details class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-4 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-text)] transition-colors [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-4 pb-4">
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{item.answer}</p>
              </div>
            </details>
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-10 rounded-xl bg-[#0D0D0D] p-6 text-center">
          <p class="text-white font-semibold mb-2">Once your key is copied</p>
          <p class="text-white/90 text-sm mb-5">Send it to me by email or WhatsApp, I activate your form within the day.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href={`mailto:${business.email}?subject=Web3Forms key&body=Hi Marc,%0A%0AHere is my Web3Forms key: %0A%0AThanks!`}
              class="inline-block px-6 py-2.5 bg-[var(--color-accent)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--color-accent-hover)] transition-all"
              data-umami-event="help-web3forms-email">
              Send by email
            </a>
            <a href={`https://wa.me/${business.whatsapp}?text=Hi Marc, here is my Web3Forms key: `}
              target="_blank" rel="noopener noreferrer"
              class="inline-block px-6 py-2.5 bg-white/10 text-white text-sm font-semibold rounded-lg border border-white/20 hover:bg-white/20 transition-all"
              data-umami-event="help-web3forms-whatsapp">
              Send by WhatsApp
            </a>
          </div>
        </div>

        <!-- Nav between guides -->
        <div class="mt-8 flex items-center justify-between rounded-lg border border-[var(--color-border)] p-4">
          <a href="/en/help/ovh-domain" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-accent-text)] transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
            </svg>
            Domain name
          </a>
          <a href="/en/help/cal-com" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-text)] hover:gap-3 transition-all">
            Cal.com calendar
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </article>
    </div>
  </section>
</BaseLayout>
