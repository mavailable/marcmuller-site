---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SchemaOrg from '../../../components/SchemaOrg.astro';
import { business } from '../../../data/business';

const title = 'Create your Resend account and send me the key: step-by-step · Marc M';
const description = 'Create a free Resend account in a few minutes, generate a sending key and send it to me so I can activate your site\'s automatic emails.';

// Web3Forms key (same as the marcm.fr contact form)
const WEB3FORMS_KEY = 'dccda1f5-4e63-4b9f-9c66-f5ce76f0dfdd';

const breadcrumbs = [
  { name: 'Home', url: `${business.url}/en/` },
  { name: 'Help', url: `${business.url}/en/help/` },
  { name: 'Resend', url: `${business.url}/en/help/resend/` },
];

const howToSteps = [
  { name: 'Create your account on Resend', text: 'Go to resend.com and click "Sign Up" (or "Get Started"). Create your account with your email and a password, or directly with Google or GitHub. It\'s free and no credit card is required.' },
  { name: 'Confirm your email', text: 'Resend sends you a confirmation email. Open it and click the link to verify your account. Check your spam folder if you don\'t see it.' },
  { name: 'Open "API Keys"', text: 'Once signed in, in the left menu of the dashboard, click "API Keys", then the "Create API Key" button at the top right.' },
  { name: 'Set up the key', text: 'Give the key a name (for example "My site"). For the permission, choose "Sending access" (send only). Leave the domain on "All domains". Confirm ("Add" or "Create").' },
  { name: 'Copy the key', text: 'Resend displays your key, it starts with "re_". Important: it is only shown once. Copy it right away using the button next to it.' },
  { name: 'Paste the key in the form below', text: 'Come back to this page, paste the key into the form just below, enter your name, then click Send. I\'ll take care of the rest.' },
];

const faq = [
  {
    question: 'Is Resend really free?',
    answer: 'Yes. The free plan lets you send 3,000 emails per month (up to 100 per day), which is more than enough for a showcase site or a small shop. No credit card is required to sign up.',
  },
  {
    question: 'The key is only shown once and I lost it. What should I do?',
    answer: 'No problem. Go back to "API Keys", delete the old key, then create a new one following the same steps. Send me the new key, that\'s the one I\'ll use.',
  },
  {
    question: 'Do you get access to my Resend account?',
    answer: 'No. You only send me a sending key ("Sending access"), which can only be used to send emails from your site. I have no access to your account, your credentials or your other settings. And you can delete this key whenever you want.',
  },
  {
    question: 'What are these emails for exactly?',
    answer: 'It depends on your site: confirming an order or a booking to your client, sending them their invoice, or notifying you of a new request. These are emails triggered automatically, with no action needed from you.',
  },
];
---

<BaseLayout title={title} description={description} lang="en" frPath="/aide/resend" enPath="/en/help/resend" noindex>

  <SchemaOrg type="breadcrumb" data={breadcrumbs} />
  <SchemaOrg type="howTo" data={{
    name: 'Create a Resend account and send the sending key',
    description: 'Guide to create a free Resend account, generate a sending key and send it to activate the site\'s automatic emails.',
    totalTime: 'PT5M',
    steps: howToSteps,
  }} />
  <SchemaOrg type="faqPage" data={faq} />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative mx-auto max-w-3xl z-10">
      <a href="/en/help" class="inline-flex items-center gap-2 text-sm text-neutral-300 hover:text-white transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
        Back to guides
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-block rounded-full border border-teal-400/30 bg-teal-400/10 px-3 py-1 text-xs font-semibold text-teal-300">
          Emails
        </span>
        <span class="text-sm text-neutral-400">~5 minutes</span>
        <span class="text-sm text-neutral-400">•</span>
        <span class="text-sm text-neutral-400">100% free</span>
      </div>

      <h1 class="mb-6 text-3xl font-bold leading-tight text-white md:text-5xl">
        Create your Resend account
      </h1>
      <p class="text-lg text-neutral-300 md:text-xl leading-relaxed">
        A few minutes to activate your site's automatic emails.
      </p>
    </div>
  </section>

  <!-- GUIDE BODY -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl">
      <article class="rounded-xl bg-white border border-[var(--color-border)] p-8 md:p-12 shadow-sm">

        <!-- Intro -->
        <p class="text-[var(--color-text-muted)] leading-relaxed mb-6">
          Your site sends automatic emails to your clients: order or booking confirmations, invoices, notifications. To make sure these emails go out reliably, your site relies on a specialised service, Resend. You create your own Resend account (free), you generate a small key, and you send it to me through the form at the bottom of the page. I plug it into your site, and that's it.
        </p>

        <!-- Why it's safe -->
        <div class="mb-6 rounded-lg bg-teal-50 border border-teal-200 p-5">
          <p class="text-sm font-semibold text-teal-800 mb-1">Why it's safe</p>
          <p class="text-sm text-teal-700 leading-relaxed">
            The key you send me has the "send only" permission (Sending access): it can only be used to send emails, it gives no access to your account. You can delete it at any time from your Resend dashboard, in a single click. You remain the sole owner of your account.
          </p>
        </div>

        <!-- What you need -->
        <div class="mb-10 rounded-lg bg-sky-50 border border-sky-200 p-5">
          <p class="text-sm font-semibold text-sky-800 mb-1">What you need</p>
          <p class="text-sm text-sky-700 leading-relaxed">
            An email address and about 5 minutes. No credit card is required: Resend's free plan covers 3,000 emails per month, more than enough.
          </p>
        </div>

        <!-- Steps -->
        <div class="space-y-8">
          {howToSteps.map((step, i) => (
            <div class="flex gap-5">
              <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent)] text-white font-bold text-sm shadow-md">
                {i + 1}
              </div>
              <div class="flex-1 pt-1.5">
                <h2 class="text-lg font-bold text-[var(--color-text)] mb-2">{step.name}</h2>
                {i === 0 ? (
                  <p class="text-[var(--color-text-muted)] leading-relaxed">
                    Go to <a href="https://resend.com/" target="_blank" rel="noopener noreferrer" class="font-semibold text-[var(--color-accent-text)] underline hover:text-[var(--color-accent)] transition-colors">resend.com</a> and click "Sign Up" (or "Get Started"). Create your account with your email and a password, or directly with Google or GitHub. It's free and no credit card is required.
                  </p>
                ) : (
                  <p class="text-[var(--color-text-muted)] leading-relaxed">{step.text}</p>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- What the key looks like -->
        <div class="mt-10 rounded-lg bg-neutral-50 border border-neutral-200 p-5">
          <p class="text-sm font-semibold text-neutral-700 mb-2">What does the key look like?</p>
          <code class="block bg-neutral-100 rounded-lg px-4 py-3 text-sm font-mono text-neutral-600 break-all">
            re_a1b2c3d4_E5f6G7h8I9j0K1l2M3n4O5p6
          </code>
        </div>

        <!-- FORM -->
        <div class="mt-12 pt-10 border-t border-[var(--color-border)]">
          <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">Send me your key</h2>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6">
            Paste the key that starts with "re_" and enter your name so I know who it belongs to. The form sends it straight to me by email, nothing is stored on this page.
          </p>

          <div aria-live="polite" aria-atomic="true" class="sr-only" id="form-status"></div>

          <!-- Success message (hidden by default, shown after submit via JS) -->
          <div id="form-success" class="hidden rounded-xl bg-emerald-50 border border-emerald-200 p-6">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 shrink-0 text-emerald-600 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <div>
                <p class="text-base font-bold text-emerald-800 mb-1">Key received</p>
                <p class="text-sm text-emerald-700 leading-relaxed">
                  Thank you! Your key is on its way. I'll plug it into your site and confirm as soon as it's live. You have nothing else to do.
                </p>
              </div>
            </div>
          </div>

          <form
            id="resend-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-5"
          >
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="subject" value="Resend API key (new client)" />
            <input type="hidden" name="from_name" value="Resend form marcm.fr" />
            <!-- No-JavaScript fallback: redirect to the thank-you page -->
            <input type="hidden" name="redirect" value="https://marcm.fr/en/thank-you" />
            <!-- Honeypot anti-spam -->
            <input type="text" name="botcheck" tabindex="-1" autocomplete="off" style="display: none;" />

            <div>
              <label for="client" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                Your name or your site name *
              </label>
              <input
                type="text"
                id="client"
                name="client"
                required
                class="w-full rounded-lg bg-white px-4 py-3 text-[var(--color-text)] placeholder-[var(--color-text-muted)] border border-[var(--color-border)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent transition-all"
                placeholder="e.g. Martin Bakery"
              />
            </div>

            <div>
              <label for="cle_api" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                Your Resend API key *
              </label>
              <input
                type="text"
                id="cle_api"
                name="cle_api"
                required
                autocomplete="off"
                spellcheck="false"
                class="w-full rounded-lg bg-white px-4 py-3 font-mono text-sm text-[var(--color-text)] placeholder-[var(--color-text-muted)] border border-[var(--color-border)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent transition-all"
                placeholder="re_..."
              />
              <p class="mt-1 text-xs text-[var(--color-text-muted)]">The key starts with "re_".</p>
            </div>

            <button
              type="submit"
              id="resend-submit"
              class="w-full rounded-xl bg-[var(--color-accent)] px-6 py-3 text-base font-medium text-white transition-all hover:bg-[var(--color-accent-hover)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
              data-umami-event="help-resend-submit"
            >
              Send the key
            </button>

            <!-- Error message (hidden by default) -->
            <div id="form-error" class="hidden rounded-lg bg-red-50 border border-red-200 p-4" role="alert">
              <p class="text-sm text-red-700 leading-relaxed">
                The send didn't work. Try again, or email me the key at <a href={`mailto:${business.email}?subject=Resend%20API%20key`} class="font-semibold underline hover:text-red-800">{business.email}</a>.
              </p>
            </div>

            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed pt-1">
              By sending this form, your key is sent to me by email via Web3Forms.
              <a href="/en/privacy-policy" target="_blank" rel="noopener" class="text-[var(--color-accent-text)] underline hover:text-[var(--color-accent)] transition-colors">Privacy policy</a>.
            </p>
          </form>
        </div>

        <!-- FAQ -->
        <div class="mt-12 space-y-4">
          <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-text-muted)]">Frequently asked questions</p>
          {faq.map((item) => (
            <details class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-4 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-text)] transition-colors [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-4 pb-4">
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{item.answer}</p>
              </div>
            </details>
          ))}
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed pt-2">
            A question? Email me at <a href={`mailto:${business.email}`} class="font-semibold text-[var(--color-accent-text)] underline hover:text-[var(--color-accent)] transition-colors">{business.email}</a>.
          </p>
        </div>

        <!-- Reassurance -->
        <div class="mt-10 rounded-xl bg-neutral-50 border border-neutral-200 p-5">
          <p class="text-sm text-neutral-600 leading-relaxed">
            You remain the sole owner of your Resend account. The sending key gives no access to your account, your credentials or your other settings, and you can delete it whenever you want from your dashboard.
          </p>
        </div>

        <!-- Nav between guides -->
        <div class="mt-8 flex items-center justify-between rounded-lg border border-[var(--color-border)] p-4">
          <a href="/en/help/web3forms" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-accent-text)] transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
            </svg>
            Web3Forms form
          </a>
          <a href="/en/help" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-text)] hover:gap-3 transition-all">
            All guides
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </article>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.getElementById('resend-form');
      if (!form) return;
      var statusEl = document.getElementById('form-status');
      var successBox = document.getElementById('form-success');
      var errorBox = document.getElementById('form-error');
      var submitBtn = document.getElementById('resend-submit');

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (errorBox) errorBox.classList.add('hidden');

        var data = Object.fromEntries(new FormData(form).entries());
        delete data.redirect;
        var clientName = (data.client || '').toString().trim();
        data.subject = clientName ? ('Resend API key: ' + clientName) : 'Resend API key (new client)';

        var originalLabel = submitBtn ? submitBtn.textContent : '';
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending...'; }
        if (statusEl) statusEl.textContent = 'Sending';

        fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data)
        })
          .then(function (r) { return r.json(); })
          .then(function (res) {
            if (res && res.success) {
              form.classList.add('hidden');
              if (successBox) {
                successBox.classList.remove('hidden');
                if (successBox.scrollIntoView) successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }
              if (statusEl) statusEl.textContent = 'Key sent';
              if (window.umami && window.umami.track) window.umami.track('help-resend-key-sent');
            } else {
              throw new Error('error');
            }
          })
          .catch(function () {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalLabel; }
            if (errorBox) errorBox.classList.remove('hidden');
            if (statusEl) statusEl.textContent = 'An error occurred';
          });
      });
    })();
  </script>
</BaseLayout>
