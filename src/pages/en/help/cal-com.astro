---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SchemaOrg from '../../../components/SchemaOrg.astro';
import { business } from '../../../data/business';

const title = 'Set up your Cal.com calendar — Step-by-step guide · Marc M';
const description = 'Create a free online calendar with Cal.com so clients can book a time slot directly. Full guide in 10 minutes.';

const breadcrumbs = [
  { name: 'Home', url: `${business.url}/en/` },
  { name: 'Help', url: `${business.url}/en/help/` },
  { name: 'Cal.com', url: `${business.url}/en/help/cal-com/` },
];

const howToSteps = [
  { name: 'Create your account', text: 'Go to cal.com and click "Get started". Sign up with your professional email. The free plan is plenty.' },
  { name: 'Set up your profile', text: 'Enter your name, your activity and your time zone. Add a photo if you wish.' },
  { name: 'Define your availability', text: 'In "Availability", set your working days and time slots. For example: Monday to Friday, 9am to 12pm and 2pm to 6pm. Cal.com will only show those slots to your clients.' },
  { name: 'Create a meeting type', text: 'In "Event Types", edit the default event or create a new one. Give it a clear name: "Phone call — 30 min" or "Studio visit — 1h". Choose the duration.' },
  { name: 'Pick the meeting format', text: 'For a phone call: select "Phone call" and enter your number. For video: connect Google Meet or Zoom. For an in-person meeting: enter your address in "Location".' },
  { name: 'Test and copy your link', text: 'Your booking link looks like cal.com/your-name. Test it yourself to check everything works, then send me the link.' },
];

const faq = [
  {
    question: 'Why Cal.com over Calendly?',
    answer: 'Cal.com is open-source and the free plan is more generous than Calendly: no event limit, email notifications included, Google Calendar sync.',
  },
  {
    question: 'What exactly will my clients see?',
    answer: 'A simple page with a calendar and your available slots. They pick a day and time, enter their name and email, and the booking is done. You receive a confirmation email automatically.',
  },
  {
    question: 'Can I sync with my existing calendar?',
    answer: 'Yes. Cal.com syncs with Google Calendar, Outlook, Apple Calendar and others. Existing busy slots in your calendar are automatically blocked.',
  },
];
---

<BaseLayout title={title} description={description} lang="en" frPath="/aide/cal-com" enPath="/en/help/cal-com" noindex>

  <SchemaOrg type="breadcrumb" data={breadcrumbs} />
  <SchemaOrg type="howTo" data={{
    name: 'Set up a Cal.com online calendar',
    description: 'Guide to create and configure your free Cal.com calendar, set your availability and get your booking link.',
    totalTime: 'PT10M',
    steps: howToSteps,
  }} />
  <SchemaOrg type="faqPage" data={faq} />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative mx-auto max-w-3xl z-10">
      <a href="/en/help" class="inline-flex items-center gap-2 text-sm text-white/90 hover:text-white transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
        Back to all guides
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-block rounded-full border border-violet-400/30 bg-violet-400/10 px-3 py-1 text-xs font-semibold text-violet-300">
          Calendar
        </span>
        <span class="text-sm text-white/90">~10 minutes</span>
        <span class="text-sm text-white/90">•</span>
        <span class="text-sm text-white/90">100% free</span>
      </div>

      <h1 class="mb-6 text-3xl font-bold leading-tight text-white md:text-5xl">
        Set up your Cal.com calendar
      </h1>
      <p class="text-lg text-white/90 md:text-xl leading-relaxed">
        Cal.com lets your clients book a time slot directly from your site. No more 5-message back-and-forth to find a date.
      </p>
    </div>
  </section>

  <!-- GUIDE BODY -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl">
      <article class="rounded-xl bg-white border border-[var(--color-border)] p-8 md:p-12 shadow-sm">

        <!-- Intro -->
        <div class="mb-10 rounded-lg bg-violet-50 border border-violet-200 p-5">
          <p class="text-sm font-semibold text-violet-800 mb-1">Good to know</p>
          <p class="text-sm text-violet-700 leading-relaxed">
            The Cal.com admin interface is in English. The booking page your clients see can be localized to their language.
          </p>
        </div>

        <!-- Steps -->
        <div class="space-y-8">
          {howToSteps.map((step, i) => (
            <div class="flex gap-5">
              <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent)] text-white font-bold text-sm shadow-md">
                {i + 1}
              </div>
              <div class="flex-1 pt-1.5">
                <h2 class="text-lg font-bold text-[var(--color-text)] mb-2">{step.name}</h2>
                <p class="text-[var(--color-text-muted)] leading-relaxed">{step.text}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Tips -->
        <div class="mt-10 rounded-lg bg-amber-50 border border-amber-200 p-5">
          <p class="text-sm font-semibold text-amber-800 mb-2">Tips</p>
          <ul class="list-disc pl-4 text-sm text-amber-700 leading-relaxed space-y-1.5">
            <li>Connect your Google Calendar to avoid double bookings.</li>
            <li>Turn on email reminders, this cuts down on no-shows.</li>
            <li>Add a 15 min buffer between meetings to breathe.</li>
            <li>Limit bookings to 7 days ahead if your schedule shifts often.</li>
          </ul>
        </div>

        <!-- Link format -->
        <div class="mt-10 rounded-lg bg-neutral-50 border border-neutral-200 p-5">
          <p class="text-sm font-semibold text-neutral-700 mb-2">What your link looks like</p>
          <code class="block bg-neutral-100 rounded-lg px-4 py-3 text-sm font-mono text-neutral-600">
            cal.com/your-name/meeting-30min
          </code>
          <p class="mt-2 text-xs text-neutral-500">That's the link I'll embed on your site, inside a "Book a meeting" button.</p>
        </div>

        <!-- FAQ -->
        <div class="mt-10 space-y-4">
          <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-text-muted)]">Frequently asked questions</p>
          {faq.map((item) => (
            <details class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-4 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-text)] transition-colors [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-4 pb-4">
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{item.answer}</p>
              </div>
            </details>
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-10 rounded-xl bg-[#0D0D0D] p-6 text-center">
          <p class="text-white font-semibold mb-2">Once your calendar is set up</p>
          <p class="text-white/90 text-sm mb-5">Send me your Cal.com link, I'll wire it into your site.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href={`mailto:${business.email}?subject=Cal.com link&body=Hi Marc,%0A%0AHere is my Cal.com link: %0A%0AThanks!`}
              class="inline-block px-6 py-2.5 bg-[var(--color-accent)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--color-accent-hover)] transition-all"
              data-umami-event="help-calcom-email">
              Send by email
            </a>
            <a href={`https://wa.me/${business.whatsapp}?text=Hi Marc, here is my Cal.com link: `}
              target="_blank" rel="noopener noreferrer"
              class="inline-block px-6 py-2.5 bg-white/10 text-white text-sm font-semibold rounded-lg border border-white/20 hover:bg-white/20 transition-all"
              data-umami-event="help-calcom-whatsapp">
              Send by WhatsApp
            </a>
          </div>
        </div>

        <!-- Nav between guides -->
        <div class="mt-8 flex items-center justify-between rounded-lg border border-[var(--color-border)] p-4">
          <a href="/en/help/web3forms" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-accent-text)] transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
            </svg>
            Web3Forms
          </a>
          <a href="/en/help/technical-access" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-text)] hover:gap-3 transition-all">
            Technical access
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </article>
    </div>
  </section>
</BaseLayout>
