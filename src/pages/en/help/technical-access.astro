---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SchemaOrg from '../../../components/SchemaOrg.astro';
import { business } from '../../../data/business';

const title = 'Prepare your technical access — Checklist · Marc M';
const description = 'Checklist of technical info to gather for putting your site live: domain, Web3Forms key, photos, logo.';

const breadcrumbs = [
  { name: 'Home', url: `${business.url}/en/` },
  { name: 'Help', url: `${business.url}/en/help/` },
  { name: 'Technical access', url: `${business.url}/en/help/technical-access/` },
];

const checklist = [
  {
    name: 'The domain name, wherever you bought it (OVH, Ionos, GoDaddy, Gandi, other)',
    text: 'No access and no password to hand over. Send me the exact domain name, I prepare its configuration on my side, then I send you 2 nameserver addresses to paste at your registrar. It takes 2 minutes, you stay the owner, and nothing moves until you paste them.',
    guide: { href: '/en/help/ovh-domain', label: 'Domain and nameservers guide' },
  },
  {
    name: 'Professional email on that domain: yes or no',
    text: 'If an address like contact@your-domain.com already exists (Google Workspace, OVH, other), tell me before anything changes: I replicate those settings exactly so nothing gets interrupted. It\'s the one sensitive point of a launch.',
    guide: null,
  },
  {
    name: 'Cloudflare member invite (only if you buy the domain at Cloudflare)',
    text: 'In that specific case the domain already sits in your Cloudflare account: invite me as a member with the "Administrator" role (marc@muller.im). You stay the owner, this only gives me technical control (DNS, SSL, domain settings), with no access to your billing.',
    guide: { href: '/en/help/cloudflare-domain', label: 'Cloudflare domain guide' },
  },
  {
    name: 'Web3Forms key',
    text: 'The access key from your Web3Forms account (format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx). Required to activate your contact form.',
    guide: { href: '/en/help/web3forms', label: 'Web3Forms guide' },
  },
  {
    name: 'Cal.com link (if calendar)',
    text: 'Your Cal.com booking link (format: cal.com/your-name). Only relevant if you opted for an online calendar.',
    guide: { href: '/en/help/cal-com', label: 'Cal.com guide' },
  },
  {
    name: 'High-quality logo',
    text: 'Your logo as PNG or SVG, in high resolution. If you don\'t have a logo, tell me, I can build a simple visual identity.',
    guide: null,
  },
  {
    name: 'Photos of your work',
    text: 'Between 5 and 15 photos of your work, studio, team or products. Phone photos are fine, what matters is that they\'re authentic, not stock images.',
    guide: null,
  },
  {
    name: 'Texts and specific information',
    text: 'Opening hours, full address, phone number to display, contact email, links to your social profiles and Google Business listing.',
    guide: null,
  },
];

const faq = [
  {
    question: 'Do I need everything before you start?',
    answer: 'No. I can start the build as soon as the brief is validated. Technical access is only needed at launch time. Send me what you have, we\'ll fill the gaps as we go.',
  },
  {
    question: 'How should I send the photos?',
    answer: 'By email, WeTransfer, Google Drive or WhatsApp, whatever you prefer. What matters is that they\'re full resolution (no screenshots or thumbnails).',
  },
  {
    question: 'Are my credentials safe?',
    answer: 'I never ask for your registrar password. For a domain you already own, you paste the 2 nameserver addresses yourself, in your own account, in 2 minutes. For a domain bought at Cloudflare, the "Administrator" member invite is revocable in one click and touches neither your billing nor your card. The Web3Forms key and Cal.com link don\'t expose anything sensitive either.',
  },
  {
    question: 'Can the nameserver change take my site or email down?',
    answer: 'No, as long as the order is respected: I first replicate your whole current configuration (email, verifications, existing site), and only then you change the 2 nameservers. Your old site keeps answering during propagation, and we roll back by putting the previous values in if needed.',
  },
];
---

<BaseLayout title={title} description={description} lang="en" frPath="/aide/acces-techniques" enPath="/en/help/technical-access" noindex>

  <SchemaOrg type="breadcrumb" data={breadcrumbs} />
  <SchemaOrg type="faqPage" data={faq} />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative mx-auto max-w-3xl z-10">
      <a href="/en/help" class="inline-flex items-center gap-2 text-sm text-white/90 hover:text-white transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
        Back to all guides
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-block rounded-full border border-orange-400/30 bg-orange-400/10 px-3 py-1 text-xs font-semibold text-orange-300">
          Technical
        </span>
        <span class="text-sm text-white/90">~5 minutes</span>
      </div>

      <h1 class="mb-6 text-3xl font-bold leading-tight text-white md:text-5xl">
        Prepare your technical access
      </h1>
      <p class="text-lg text-white/90 md:text-xl leading-relaxed">
        Everything I need to put your site live, in one checklist.
      </p>
    </div>
  </section>

  <!-- GUIDE BODY -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl">
      <article class="rounded-xl bg-white border border-[var(--color-border)] p-8 md:p-12 shadow-sm">

        <!-- Intro -->
        <div class="mb-10 rounded-lg bg-orange-50 border border-orange-200 p-5">
          <p class="text-sm font-semibold text-orange-800 mb-1">No pressure</p>
          <p class="text-sm text-orange-700 leading-relaxed">
            You don't need everything at once. Send what you have, we'll move step by step. On the domain side, there's no access to hand over: I prepare the configuration, you paste 2 lines at your registrar when we go live.
          </p>
        </div>

        <!-- Checklist -->
        <div class="space-y-6">
          {checklist.map((item, i) => (
            <div class="flex gap-5 p-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)]">
              <div class="flex-shrink-0 flex items-start pt-0.5">
                <div class="w-6 h-6 rounded border-2 border-[var(--color-accent)]/40 flex items-center justify-center">
                  <span class="text-xs font-bold text-[var(--color-accent-text)]">{i + 1}</span>
                </div>
              </div>
              <div class="flex-1">
                <h2 class="text-base font-bold text-[var(--color-text)] mb-1">{item.name}</h2>
                <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{item.text}</p>
                {item.guide && (
                  <a href={item.guide.href} class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-accent-text)] hover:underline">
                    {item.guide.label}
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- FAQ -->
        <div class="mt-10 space-y-4">
          <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-text-muted)]">Frequently asked questions</p>
          {faq.map((item) => (
            <details class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] overflow-hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-4 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-accent-text)] transition-colors [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg class="w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-4 pb-4">
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{item.answer}</p>
              </div>
            </details>
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-10 rounded-xl bg-[#0D0D0D] p-6 text-center">
          <p class="text-white font-semibold mb-2">Ready? Send me everything in one go</p>
          <p class="text-white/90 text-sm mb-5">One single message with what you have, I'll sort it.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href={`mailto:${business.email}?subject=Technical access: my site&body=Hi Marc,%0A%0AHere is my technical info:%0A%0A- Domain: %0A- Bought at (OVH, Cloudflare, GoDaddy, other): %0A- Professional email on that domain: yes / no (if yes, with whom: )%0A- Cloudflare member invite added (if domain at Cloudflare): yes / no%0A- Web3Forms key: %0A- Cal.com link: %0A%0AThanks!`}
              class="inline-block px-6 py-2.5 bg-[var(--color-accent)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--color-accent-hover)] transition-all"
              data-umami-event="help-access-email">
              Send by email
            </a>
            <a href={`https://wa.me/${business.whatsapp}?text=Hi Marc, here is my technical info:%0A%0ADomain: %0ABought at: %0AProfessional email on that domain: yes/no%0ACloudflare member invite (if domain at Cloudflare): yes/no%0AWeb3Forms key: %0ACal.com link: `}
              target="_blank" rel="noopener noreferrer"
              class="inline-block px-6 py-2.5 bg-white/10 text-white text-sm font-semibold rounded-lg border border-white/20 hover:bg-white/20 transition-all"
              data-umami-event="help-access-whatsapp">
              Send by WhatsApp
            </a>
          </div>
        </div>

        <!-- Nav back -->
        <div class="mt-8 flex items-center justify-between rounded-lg border border-[var(--color-border)] p-4">
          <a href="/en/help/cal-com" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-accent-text)] transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
            </svg>
            Cal.com calendar
          </a>
          <a href="/en/help" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-text)] hover:gap-3 transition-all">
            All guides
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </article>
    </div>
  </section>
</BaseLayout>
