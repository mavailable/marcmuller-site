---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';

const learnings = [
  'Where to start when you begin from scratch and no one around you has ever run a business',
  'How to go find your first clients yourself, instead of waiting for them to come',
  'Knowing what to say, and to whom, to make people want to work with you',
  'The tools that save you time from day one, without drowning in them',
  'How to stop letting a prospect slip away: track, follow up, close',
  'Staying in control of it all, so you can keep going on your own once you\'re launched',
];
---

<BaseLayout
  title="The training: learn to find your clients | Marc M"
  description="The training to get started and go find your clients yourself, even if no one around you has ever run a business. I'm building it right now. Leave me your email and I'll let you know the moment it opens."
  lang="en"
  frPath="/formation"
  enPath="/en/training"
>

  <!-- HERO -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>

    <div class="mx-auto max-w-3xl relative z-10">
      <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color: #E86C47; letter-spacing: 0.2em;">The training · coming soon</p>
      <h1 class="text-3xl font-bold text-white md:text-4xl lg:text-5xl mb-6 leading-tight">
        Learn to go find<br/>
        <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">your own clients.</span>
      </h1>
      <p class="text-lg text-neutral-400 max-w-xl leading-relaxed">
        Want to get started but don't know where to begin? You know your craft, not the business of finding clients, and no one around you has ever run a company to guide you. That's exactly what this training unlocks.
      </p>
    </div>
  </section>

  <!-- EDITORIAL: what it is, why -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-2xl">

      <p class="text-xl md:text-2xl leading-relaxed text-[var(--color-text)] font-medium mb-10">
        It's the entry point. Before we work together over time, there's a spark to set off: going from "I wait for it to come" to "I know how to go find my clients".
      </p>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-6">
        Most independents struggle for the same reason: they master their craft, but no one ever taught them to find clients. And around them, only employees to ask for advice. So they hesitate, they put it off, they don't dare. This training is built for them.
      </p>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-12">
        I didn't learn this from a book. I've built companies, helped around twenty independents, and I build the tools I use every day myself. What I pass on is what actually works, not theory.
      </p>

      <!-- What you walk away knowing how to do -->
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6">What you walk away knowing how to do</h2>
      <div class="grid gap-0 sm:grid-cols-1">
        {learnings.map(item => (
          <div class="flex items-start gap-3 py-3 border-b border-neutral-100">
            <svg class="w-4 h-4 flex-shrink-0 mt-1" style="color: #E86C47;" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span class="text-[var(--color-text-muted)]">{item}</span>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- STATUS: coming soon + CPF/Qualiopi -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-20 border-y" style="border-color: var(--color-border);">
    <div class="mx-auto max-w-2xl">
      <span class="inline-flex w-fit items-center gap-2 mb-4 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-[var(--color-accent-text)]" style="background: rgba(232, 108, 71, 0.1); letter-spacing: 0.1em;">In the works</span>
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">I'm building it right now</h2>
      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-6">
        The training isn't open yet. I'm building it to be concrete and directly usable, not one more course you forget. Rather than announce a date I wouldn't keep, I'd rather tell you the truth: it's coming, and I'll let you know the moment it's ready.
      </p>
      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)]">
        I'm also working to make it <strong class="text-[var(--color-text)]">eligible for CPF funding (Qualiopi)</strong> in France. That's in the works. If it goes through, you'll be able to take it without paying out of pocket. I won't announce anything until it's confirmed.
      </p>
    </div>
  </section>

  <!-- WAITLIST: minimal Web3Forms -->
  <section class="w-full px-6 py-16 md:px-8 md:py-20" style="background: #FAFAFA;">
    <div class="mx-auto max-w-xl text-center">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-3">Let me know when it opens</h2>
      <p class="text-[var(--color-text-muted)] mb-8">
        Leave me your email. No spam, no endless follow-ups: just one message the day the training opens.
      </p>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="flex flex-col sm:flex-row gap-3 items-stretch justify-center max-w-md mx-auto"
      >
        <!-- Web3Forms Access Key -->
        <input type="hidden" name="access_key" value="dccda1f5-4e63-4b9f-9c66-f5ce76f0dfdd" />
        <input type="hidden" name="form_source" value="training-waitlist" />
        <input type="hidden" name="subject" value="Training waitlist: new email" />
        <input type="hidden" name="redirect" value="https://marcm.fr/en/thank-you" />

        <!-- Honeypot (anti-spam) -->
        <input type="text" name="botcheck" style="display: none;" tabindex="-1" autocomplete="off" />

        <label for="email" class="sr-only">Your email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="you@email.com"
          class="flex-grow rounded-xl border border-[var(--color-border)] bg-white px-4 py-3 text-[var(--color-text)] placeholder:text-neutral-400 focus:outline-none focus:border-[var(--color-accent)]"
        />
        <button
          type="submit"
          class="rounded-xl px-6 py-3 text-sm font-semibold text-white transition-all duration-200 whitespace-nowrap"
          style="background: linear-gradient(135deg, #E86C47, #D4572F);"
          data-umami-event="training-waitlist-submit"
        >
          Let me know
        </button>
      </form>

      <p class="mt-4 text-xs text-[var(--color-text-muted)]">
        Rather write to me directly? <a href="/en/contact" class="text-[var(--color-accent-text)] hover:underline font-medium">This way</a>.
      </p>
    </div>
  </section>

  <!-- TRANSITION: in the meantime -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-20 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="mx-auto max-w-2xl text-center relative z-10">
      <h2 class="text-2xl font-bold text-white mb-4">Don't want to wait?</h2>
      <p class="text-neutral-400 mb-8">
        The training is the entry point. If you want to get going right now, we work together over time: I do it with you, every week. Twenty minutes on a call, I tell you where to start.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <Button href="/en/contact" variant="primary">Let's talk</Button>
        <Button href="/en/method" variant="secondary">See how I work →</Button>
      </div>
    </div>
  </section>

</BaseLayout>
