---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { business } from '../../data/business';
import { getClientProjects, getSampleProjects } from '../../data/projects';

const whatsappMessage = encodeURIComponent("Hi Marc, I'd like to talk about finding clients.");
const totalProjects = getClientProjects().length + getSampleProjects().length;

const checkIcon = `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>`;

// Echo audit tiers, translated for EN (FR data lives in business.ts)
const echoTiers = [
  { name: 'Free', price: 0, description: '5 simulated visitors, a summary and one recommendation, sent by email.' },
  { name: 'Complete', price: 90, description: '20 simulated visitors, an interactive report, a technical audit, and recommendations ranked by impact.' },
  { name: 'Pro', price: 250, description: '100 simulated visitors, channel-by-channel analysis, a conversion score per client profile, and a 30-minute call.' },
];

const faqItems = [
  {
    question: "How exactly do you help me find clients?",
    answer: "We look at where your clients come from today, and we tackle what's missing. That can be a site that brings you enquiries, your social channels kept alive, some outreach to go find prospects and know what to say to them, and a mini-CRM to track and follow them up. We pick the right levers in the right order, and I get hands-on with you every week."
  },
  {
    question: "What is the accompaniment, exactly?",
    answer: "We work together over time. Every week we set a check-in, I work with you, we look at what comes in, we adjust. No slide decks, no pointless meetings. For the price, we work it out together based on what you need: drop me a line, I'll tell you where to start."
  },
  {
    question: "Are you a coach or a developer?",
    answer: "Both, and above all an entrepreneur. I've built companies and helped around twenty independents. I build the tools I hand you myself: the site, the outreach, the CRM. Most coaches talk without ever doing, and most developers code without ever having run a business. I do both."
  },
  {
    question: "What if I just want a site?",
    answer: "That works too. The site is one building block: delivered in 7 days, built to bring you clients. You don't have to take everything else. You can start there and build from it."
  },
  {
    question: "Is your site a template?",
    answer: "No. Every site is built from scratch, tailored to you. No WordPress, no template. A tight process lets me deliver a unique site, ready in 7 days."
  },
  {
    question: "How is a fast, custom site even possible?",
    answer: "No salesperson, no office, no WordPress to maintain. I use modern tools (Astro, Tailwind) and a streamlined process that lets me deliver in 7 days what an agency takes 3 weeks to produce. There's no middleman between you and the code, and no agency overheads. The result: a unique site, Lighthouse 100/100, delivered fast and done right.",
    link: { href: '/en/method/', label: 'See how I work →' }
  },
  {
    question: "What is the free Echo audit?",
    answer: "I run simulated visitors on your site and send you back what they actually feel: what blocks them, what makes them leave, what would make them act. The free version gives you a summary. The Complete and Pro versions go much deeper. It's often the best first step, and it costs you nothing."
  },
  {
    question: "What happens after my site's first year?",
    answer: "Your site keeps running with no monthly fees. Hosting is included for life. Only the domain name needs renewing each year, for a few euros. If you'd like me to keep an eye on it (changes, support, content), support plans are available: let's talk."
  },
  {
    question: "Can I pay in instalments?",
    answer: "Yes, instalments are available for your site. Bespoke project: 50% on signing, the rest on delivery. We adapt to you."
  },
  {
    question: "Do you work with WordPress?",
    answer: "No, I work with Astro. It's faster (better Google ranking), safer (no plugins means no vulnerabilities) and lighter. The result: a site that loads in under a second."
  },
  {
    question: "Can you rebuild a WordPress, Wix or Squarespace site?",
    answer: "Yes, often. I take your existing content (text, photos), your domain name, and I redirect the old site to the new one to preserve your Google ranking. The result: a faster, safer site, with no monthly subscription and no plugins to update. You lose nothing, you gain in performance and peace of mind."
  },
  {
    question: "Can I edit the site myself afterwards?",
    answer: "Yes. Your site comes with a simple editing space: you change your text, photos and hours, as easy as posting on Facebook. No need to touch the code. The goal is for you to be self-sufficient."
  },
  {
    question: "Do I own my site?",
    answer: "Yes. Your site and your domain are yours: zero subscription, zero lock-in. Hosting is included for life (Cloudflare). You're free to switch providers any time. Unlike Wix or Squarespace, you don't rent your site, you own it."
  },
];
---

<BaseLayout
  title="The offer: clients coming in, not just a site | Marc M"
  description="I help you find clients, for real. The accompaniment (let's talk), the pro site, the Echo audit. The site is one building block among others."
  lang="en"
  frPath="/offre"
  enPath="/en/services"
>
  <SchemaOrg type="localBusiness" />
  <SchemaOrg type="faqPage" data={faqItems} />

  <!-- HERO -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="mx-auto max-w-4xl text-center relative z-10">
      <div class="mb-6 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]">
        <span class="w-2 h-2 rounded-full" style="background-color: #E86C47;"></span>
        <span class="text-sm font-semibold text-white">Start wherever you want</span>
      </div>

      <h1 class="mb-6 text-4xl font-bold leading-tight text-white md:text-5xl">
        Clients coming in. Not just a site.
      </h1>
      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl mx-auto">
        I help you find them, for real. The site is one of the building blocks. You can start small, or work with me over time.
      </p>
      <div class="mt-8 flex justify-center">
        <a href="https://cal.com/marc-muller/15min" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center justify-center gap-2 rounded-xl px-8 py-4 text-base font-semibold text-white transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5" style="background: linear-gradient(135deg, #E86C47, #D4572F); box-shadow: 0 4px 20px rgba(232, 108, 71, 0.35);" data-umami-event="en-cal-cta-offre" data-umami-event-position="hero">
          Let's talk? 15 min, no strings attached
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <p class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-neutral-400">
        <a href="#spark" class="hover:text-[var(--color-accent-text)] transition-colors">1. The spark</a>
        <span class="text-neutral-700">·</span>
        <a href="#right-hand" class="hover:text-[var(--color-accent-text)] transition-colors">2. The right hand</a>
        <span class="text-neutral-700">·</span>
        <a href="#blocks" class="hover:text-[var(--color-accent-text)] transition-colors">3. The building blocks</a>
      </p>
    </div>
  </section>

  <!-- LEVEL 1 - THE SPARK (entry point) -->
  <section id="spark" class="w-full bg-[var(--color-bg)] px-6 py-12 md:px-8 md:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="text-center mb-10">
        <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent-text)] mb-3" style="letter-spacing: 0.2em;">Level 1 · The entry point</p>
        <h2 class="text-3xl font-bold text-[var(--color-text)]">The spark</h2>
        <p class="mt-3 text-[var(--color-text-muted)] max-w-2xl mx-auto">Want to get started, or not sure where to begin? Let's unlock that. The first step costs you nothing.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- Free Echo audit -->
        <div class="rounded-2xl border border-[var(--color-border)] bg-white p-8 flex flex-col">
          <span class="inline-flex w-fit items-center gap-2 mb-3 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50">Free</span>
          <h3 class="text-xl font-bold text-[var(--color-text)] mb-2">The Echo audit</h3>
          <p class="text-sm text-[var(--color-text-muted)] mb-6 leading-relaxed flex-grow">
            I run simulated visitors on your site and send you back what they actually feel: what blocks them, what makes them leave, what would make them act. It's the best first step, and it costs you nothing.
          </p>
          <a href="/en/free-audit/" class="block w-full py-3 px-6 text-center rounded-xl text-sm font-semibold text-white transition-all duration-200" style="background: linear-gradient(135deg, #E86C47, #D4572F);" data-umami-event="services-spark-audit">
            Get my free audit
          </a>
        </div>

        <!-- Training coming soon -->
        <div class="rounded-2xl border border-dashed border-[var(--color-border)] bg-[var(--color-bg-alt)] p-8 flex flex-col">
          <span class="inline-flex w-fit items-center gap-2 mb-3 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-[var(--color-accent-text)]" style="background: rgba(232, 108, 71, 0.1);">Coming soon</span>
          <h3 class="text-xl font-bold text-[var(--color-text)] mb-2">The training</h3>
          <p class="text-sm text-[var(--color-text-muted)] mb-6 leading-relaxed flex-grow">
            Learn to find your first clients yourself: what to say, who to say it to, and how to get going. I'm building it right now. Leave me your email and I'll let you know the moment it opens.
          </p>
          <a href="/en/training/" class="block w-full py-3 px-6 text-center rounded-xl text-sm font-semibold text-[var(--color-text)] border border-[var(--color-border)] bg-white transition-all duration-200 hover:border-[var(--color-accent)]" data-umami-event="services-spark-training">
            Discover the training
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- LEVEL 2 - THE RIGHT HAND (core, highlighted) -->
  <section id="right-hand" class="w-full relative px-6 py-16 md:px-8 md:py-24" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>

    <div class="mx-auto max-w-5xl relative z-10">
      <div class="text-center mb-10">
        <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent-text)] mb-3" style="letter-spacing: 0.2em;">Level 2 · The core</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white">The right hand</h2>
        <p class="mt-4 text-lg text-neutral-300 max-w-2xl mx-auto leading-relaxed">
          We work together every week. I do it <em class="not-italic text-white font-semibold">with</em> you, not a slide deck. Like a business partner who gets hands-on, without taking a share of your company.
        </p>
      </div>

      <!-- Highlighted core card -->
      <div class="relative rounded-2xl p-8 md:p-12" style="background: linear-gradient(135deg, #1A1A1A 0%, #141414 100%); box-shadow: 0 25px 60px -12px rgba(0,0,0,0.6), 0 0 0 1px rgba(232, 108, 71, 0.4);">
        <div class="absolute top-0 left-0 right-0 h-1 rounded-t-2xl" style="background: linear-gradient(90deg, #E86C47, #F5C8B3);"></div>

        <div class="grid gap-10 lg:grid-cols-2 items-start">
          <!-- What we do together -->
          <div>
            <p class="text-sm text-neutral-400 mb-6 leading-relaxed">
              We look at where you stand, where your clients come from, what's holding you back. We pick the right levers, in the order that matters. And every week, I move forward with you. We take what you need, when you need it:
            </p>

            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
                <span class="text-sm text-white"><strong>A site that brings you clients</strong>, not just a business card</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
                <span class="text-sm text-white"><strong>Your social channels kept alive</strong>, without spending your evenings on them</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
                <span class="text-sm text-white"><strong>Outreach</strong> to go find prospects, and know what to say to them</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
                <span class="text-sm text-white"><strong>A mini-CRM</strong> to track your prospects and follow up at the right time</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
                <span class="text-sm text-white"><strong>Your quotes and invoices</strong>, so you stop losing hours to admin</span>
              </div>
            </div>
          </div>

          <!-- Why me + CTA -->
          <div class="rounded-xl p-6 lg:p-8 h-full flex flex-col" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
            <p class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-4" style="letter-spacing: 0.15em;">Why me</p>
            <ul class="space-y-3 mb-8 flex-grow">
              <li class="flex items-start gap-3">
                <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
                <span class="text-sm text-neutral-200">I've built 8 to 10 companies and helped around twenty independents. I speak from experience, not theory.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
                <span class="text-sm text-neutral-200">I build and run the tools myself. Not a coach who just talks, not a developer who's never run a business.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
                <span class="text-sm text-neutral-200">Concrete actions every week. You stay in control: everything is editable by you, so you can keep going on your own.</span>
              </li>
            </ul>

            <div class="rounded-lg px-4 py-3 mb-5 text-center" style="background: rgba(232, 108, 71, 0.08); border: 1px solid rgba(232, 108, 71, 0.25);">
              <p class="text-sm text-white">No fixed price here: it depends on what you need. <strong>Let's talk for 20 minutes, no strings attached.</strong></p>
            </div>

            <a href="/en/contact/" class="block w-full py-4 px-6 text-center rounded-xl text-base font-semibold text-white transition-all duration-200" style="background: linear-gradient(135deg, #E86C47, #D4572F); box-shadow: 0 4px 20px rgba(232, 108, 71, 0.4);" data-umami-event="services-righthand-cta">
              Let's talk
            </a>
            <a href="/en/method/" class="block mt-3 text-center text-sm text-neutral-400 hover:text-white transition-colors" data-umami-event="services-righthand-method">
              See how I work →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LEVEL 3 - THE BUILDING BLOCKS (à la carte) -->
  <section id="blocks" class="w-full bg-[var(--color-bg)] px-6 py-12 md:px-8 md:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="text-center mb-10">
        <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent-text)] mb-3" style="letter-spacing: 0.2em;">Level 3 · À la carte</p>
        <h2 class="text-3xl font-bold text-[var(--color-text)]">The building blocks</h2>
        <p class="mt-3 text-[var(--color-text-muted)] max-w-2xl mx-auto">Just want one piece, not the full accompaniment? No problem. Take what you need.</p>
      </div>

      <div class="grid gap-10 lg:grid-cols-2 items-start">

        <!-- BLOCK: THE SITE -->
        <div class="relative rounded-2xl p-8 lg:p-10 flex flex-col" style="background-color: #111; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(232, 108, 71, 0.3);">
          <div class="absolute top-0 left-0 right-0 h-1 rounded-t-2xl" style="background: linear-gradient(90deg, #E86C47, #F5C8B3);"></div>

          <div class="mb-2">
            <span class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider text-neutral-300" style="letter-spacing: 0.15em;">One block: your site</span>
          </div>
          <h3 class="text-2xl font-bold text-white mb-2">A site that brings you clients</h3>
          <p class="text-sm text-neutral-400 mb-6 leading-relaxed">Built from scratch, in your image. Not a template.</p>

          <div class="mb-8">
            <div class="flex items-baseline gap-2">
              <span class="text-4xl font-extrabold text-white">On request</span>
              <span class="text-sm text-neutral-400">delivered in 7 days</span>
            </div>
            <p class="text-sm text-neutral-400 mt-2">We scope your needs together, then I send you a clear proposal.</p>
          </div>

          <div class="space-y-3 flex-grow mb-8">
            <div class="flex items-start gap-3">
              <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
              <span class="text-sm text-white"><strong>Unique design</strong> in your image, no template</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
              <span class="text-sm text-white"><strong>Visible on Google and AI</strong>, SEO and GEO optimised</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
              <span class="text-sm text-white"><strong>Built to convert</strong>, call, WhatsApp, contact form</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
              <span class="text-sm text-white"><strong>Ultra-fast</strong>, your site loads in under a second</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
              <span class="text-sm text-white"><strong>Ready in 7 days</strong>, one round of revisions included</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
              <span class="text-sm text-white"><strong>Copy written for you</strong>, you don't have to write a thing</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-[var(--color-accent-text)] flex-shrink-0 w-5 h-5 mt-0.5" set:html={checkIcon} />
              <span class="text-sm text-white"><strong>It's your site</strong>, you own it, zero lock-in</span>
            </div>
          </div>

          <div class="space-y-3">
            <a href="/en/contact/" class="block w-full py-4 px-6 text-center rounded-xl text-base font-semibold text-white transition-all duration-200" style="background: linear-gradient(135deg, #E86C47, #D4572F); box-shadow: 0 4px 20px rgba(232, 108, 71, 0.4);" data-umami-event="services-cta-site">
              Talk to me about my site
            </a>
            <a href="/en/contact/" class="block w-full py-3 px-6 text-center rounded-xl text-sm font-semibold text-neutral-300 border border-neutral-700 transition-all duration-200 hover:border-neutral-500 hover:text-white" data-umami-event="services-cta-question">
              Just ask a question
            </a>
            <p class="text-center text-xs text-neutral-500 mt-1">Hosting and domain included for the first year</p>
          </div>
        </div>

        <!-- HOW THE SITE IS BUILT -->
        <div class="flex flex-col gap-6">
          <h3 class="text-lg font-bold text-[var(--color-text)]">How your site gets built</h3>

          <div class="space-y-5">
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center font-bold text-white text-sm" style="background: linear-gradient(135deg, #E86C47, #D4572F);">1</div>
              <div>
                <p class="font-semibold text-[var(--color-text)]">We get on a quick call</p>
                <p class="text-sm text-[var(--color-text-muted)] mt-0.5">You tell me about your business, your text, your photos, your preferences. A guided exchange, nothing technical.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center font-bold text-white text-sm" style="background: linear-gradient(135deg, #E86C47, #D4572F);">2</div>
              <div>
                <p class="font-semibold text-[var(--color-text)]">We scope it together</p>
                <p class="text-sm text-[var(--color-text-muted)] mt-0.5">A 15-minute exchange to frame the project (phone, video or chat). If your needs go beyond the site, I point you the right way, no extra charge.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center font-bold text-white text-sm" style="background: linear-gradient(135deg, #E86C47, #D4572F);">3</div>
              <div>
                <p class="font-semibold text-[var(--color-text)]">I build your site</p>
                <p class="text-sm text-[var(--color-text-muted)] mt-0.5">Design, development, content, SEO, everything built to measure in 7 days.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center font-bold text-white text-sm" style="background: linear-gradient(135deg, #E86C47, #D4572F);">4</div>
              <div>
                <p class="font-semibold text-[var(--color-text)]">Your site goes live</p>
                <p class="text-sm text-[var(--color-text-muted)] mt-0.5">One round of revisions, then launch. You get the keys to everything.</p>
              </div>
            </div>
          </div>

          <!-- SOCIAL PROOF -->
          <div class="mt-4 flex items-center gap-4 px-5 py-4 rounded-xl bg-[var(--color-bg-alt)] border border-[var(--color-border)]">
            <div class="text-3xl font-extrabold" style="color: #E86C47;">{totalProjects}</div>
            <div>
              <p class="text-sm font-semibold text-[var(--color-text)]">projects delivered</p>
              <p class="text-xs text-[var(--color-text-muted)]">All at Lighthouse 100, <a href="/en/portfolio/" class="underline hover:text-[var(--color-accent-text)]">see the portfolio</a></p>
            </div>
          </div>
        </div>

      </div>

      <!-- THE ECHO AUDIT (priced block) -->
      <div class="mt-16">
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold text-[var(--color-text)]">The Echo audit</h3>
          <p class="mt-2 text-[var(--color-text-muted)] max-w-2xl mx-auto">See what your site really says to your visitors. Three levels, you decide how far you want to go.</p>
        </div>

