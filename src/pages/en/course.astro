---
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>How I Made $50,000/Month in 30 Days With Vibe Coding — Marc M</title>
  <meta name="description" content="I launched my web agency in one month. I make 50k/month with Claude Code. I'm selling you a course." />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Open Graph -->
  <meta property="og:title" content="How I Made $50,000/Month in 30 Days With Vibe Coding" />
  <meta property="og:description" content="Claude Code. A few prompts. A Wi-Fi connection. I'll explain everything in my exclusive course for just $997." />
  <meta property="og:image" content="https://marcm.fr/og-april-fools.svg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content="https://marcm.fr/en/course" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="How I Made $50,000/Month in 30 Days With Vibe Coding" />
  <meta name="twitter:description" content="Claude Code. A few prompts. A Wi-Fi connection. I'll explain everything in my exclusive course for just $997." />
  <meta name="twitter:image" content="https://marcm.fr/og-april-fools.svg" />

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Satoshi', system-ui, sans-serif;
      background: #FAFAF8;
      overflow-x: hidden;
    }

    .reveal {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .hero {
      background: #1A1A1A;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 4rem 1.5rem;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(232,108,71,0.25) 0%, transparent 70%);
      pointer-events: none;
    }

    .badge {
      display: inline-block;
      background: #E86C47;
      color: white;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 0.4rem 1rem;
      border-radius: 100px;
      margin-bottom: 1.5rem;
    }

    .hero h1 {
      font-size: clamp(2rem, 6vw, 4.5rem);
      font-weight: 900;
      color: #FAFAF8;
      line-height: 1.1;
      max-width: 900px;
      margin-bottom: 1.5rem;
    }
    .hero h1 em {
      font-style: normal;
      color: #E86C47;
    }

    .hero-sub {
      font-size: 1.2rem;
      color: #B0B0B0;
      max-width: 560px;
      margin-bottom: 2.5rem;
      line-height: 1.6;
    }

    .btn-guru {
      display: inline-block;
      background: #E86C47;
      color: white;
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 1.1rem 2.5rem;
      border-radius: 8px;
      text-decoration: none;
      box-shadow: 0 8px 40px rgba(232,108,71,0.4);
      transition: transform 0.2s, box-shadow 0.2s;
      cursor: pointer;
      border: none;
    }
    .btn-guru:hover {
      transform: translateY(-2px) scale(1.03);
      box-shadow: 0 12px 50px rgba(232,108,71,0.55);
    }

    .hero-proof {
      margin-top: 2.5rem;
      display: flex;
      gap: 2rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .hero-proof span { color: #6B6B6B; font-size: 0.85rem; }
    .hero-proof span strong { color: #FAFAF8; }

    .stats {
      background: #F0EEEB;
      padding: 5rem 1.5rem;
      text-align: center;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem;
      max-width: 900px;
      margin: 3rem auto 0;
    }
    .stat-card {
      background: white;
      border-radius: 16px;
      padding: 2rem 1.5rem;
      box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    }
    .stat-number {
      font-size: 2.8rem;
      font-weight: 900;
      color: #E86C47;
      line-height: 1;
      margin-bottom: 0.5rem;
    }
    .stat-label { font-size: 0.9rem; color: #6B6B6B; line-height: 1.4; }

    .section {
      padding: 5rem 1.5rem;
      max-width: 800px;
      margin: 0 auto;
    }
    .section-dark {
      background: #1A1A1A;
      max-width: 100%;
      padding: 5rem 1.5rem;
    }
    .section-dark .inner { max-width: 800px; margin: 0 auto; }

    .overline {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #E86C47;
      margin-bottom: 0.75rem;
    }

    h2.heading {
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      font-weight: 900;
      color: #1A1A1A;
      line-height: 1.15;
      margin-bottom: 1.5rem;
    }
    .section-dark h2.heading { color: #FAFAF8; }

    p.body-text {
      font-size: 1.05rem;
      color: #525252;
      line-height: 1.75;
      margin-bottom: 1rem;
    }
    .section-dark p.body-text { color: #B0B0B0; }

    .modules-list {
      list-style: none;
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .modules-list li {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }
    .module-num {
      background: #E86C47;
      color: white;
      font-size: 0.75rem;
      font-weight: 800;
      min-width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .module-title { font-weight: 700; color: #FAFAF8; margin-bottom: 0.2rem; }
    .module-desc { font-size: 0.875rem; color: #6B6B6B; }

    .testimonials {
      background: #F0EEEB;
      padding: 5rem 1.5rem;
    }
    .testimonials-inner { max-width: 800px; margin: 0 auto; }
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
      margin-top: 2.5rem;
    }
    .testi-card {
      background: white;
      border-radius: 16px;
      padding: 1.75rem;
      box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    }
    .testi-stars { color: #E86C47; font-size: 1.1rem; margin-bottom: 0.75rem; }
    .testi-text {
      font-size: 0.95rem;
      color: #3D3D3D;
      line-height: 1.6;
      margin-bottom: 1rem;
      font-style: italic;
    }
    .testi-author { font-size: 0.8rem; font-weight: 700; color: #6B6B6B; }

    .pricing {
      background: #1A1A1A;
      padding: 5rem 1.5rem;
      text-align: center;
    }
    .pricing-box {
      background: white;
      max-width: 520px;
      margin: 2.5rem auto 0;
      border-radius: 24px;
      padding: 3rem 2rem;
      position: relative;
    }
    .pricing-badge {
      position: absolute;
      top: -14px;
      left: 50%;
      transform: translateX(-50%);
      background: #E86C47;
      color: white;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 0.35rem 1.2rem;
      border-radius: 100px;
      white-space: nowrap;
    }
    .old-prices {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 0.5rem;
    }
    .old-price { font-size: 1rem; color: #B0B0B0; text-decoration: line-through; }
    .current-price {
      font-size: 4rem;
      font-weight: 900;
      color: #E86C47;
      line-height: 1;
      margin-bottom: 0.25rem;
    }
    .price-sub { font-size: 0.85rem; color: #6B6B6B; margin-bottom: 2rem; }
    .scarcity {
      background: #FEF3EF;
      border: 1px solid #FACBB8;
      border-radius: 8px;
      padding: 0.6rem 1rem;
      font-size: 0.85rem;
      color: #933A25;
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    .timer {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }
    .timer-block {
      background: #1A1A1A;
      color: white;
      border-radius: 8px;
      padding: 0.5rem 0.75rem;
      min-width: 52px;
      text-align: center;
    }
    .timer-num {
      font-size: 1.5rem;
      font-weight: 900;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .timer-label {
      font-size: 0.6rem;
      color: #6B6B6B;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    #reveal-overlay {
      position: fixed;
      inset: 0;
      background: #1A1A1A;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.6s ease;
    }
    #reveal-overlay.active {
      opacity: 1;
      pointer-events: all;
    }

    .fish-container {
      font-size: 6rem;
      margin-bottom: 1.5rem;
      animation: fishSwim 3s ease-in-out infinite;
    }
    @keyframes fishSwim {
      0%, 100% { transform: translateX(-12px) rotate(-3deg); }
      50% { transform: translateX(12px) rotate(3deg); }
    }

    .reveal-title {
      font-size: clamp(2rem, 6vw, 3.5rem);
      font-weight: 900;
      color: #E86C47;
      margin-bottom: 1rem;
      line-height: 1.1;
    }
    .reveal-sub {
      font-size: 1.15rem;
      color: #B0B0B0;
      max-width: 540px;
      line-height: 1.7;
      margin-bottom: 2.5rem;
    }
    .reveal-sub strong { color: #FAFAF8; }

    .btn-real {
      display: inline-block;
      background: #E86C47;
      color: white;
      font-size: 1rem;
      font-weight: 700;
      padding: 0.9rem 2rem;
      border-radius: 8px;
      text-decoration: none;
      transition: transform 0.2s;
    }
    .btn-real:hover { transform: translateY(-2px); }

    .reveal-fine { margin-top: 1.5rem; font-size: 0.8rem; color: #3D3D3D; }

    .confetti-wrap {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 9998;
      overflow: hidden;
    }
    .confetti-piece {
      position: absolute;
      top: -20px;
      width: 10px;
      height: 10px;
      border-radius: 2px;
      animation: confettiFall linear forwards;
      opacity: 0;
    }
    @keyframes confettiFall {
      0%   { opacity: 1; transform: translateY(0) rotate(0deg); }
      100% { opacity: 0; transform: translateY(110vh) rotate(720deg); }
    }

    @media (max-width: 640px) {
      .old-prices { flex-direction: column; align-items: center; gap: 0.25rem; }
    }
  </style>
</head>

<body>

  <!-- HERO -->
  <section class="hero">
    <div class="badge">🔥 Exclusive offer — April 1st 2026</div>
    <h1>
      How I launched my web agency<br />
      <em>in 30 days</em> and hit<br />
      <em>$50,000/month</em><br />
      with Vibe Coding
    </h1>
    <p class="hero-sub">
      Claude Code. A few prompts. A Wi-Fi connection. That's all it took.<br />
      Now I'm sharing everything in my exclusive course.
    </p>
    <button class="btn-guru" id="cta-hero">
      JOIN THE COURSE →
    </button>
    <div class="hero-proof">
      <span>✅ <strong>2,347</strong> students</span>
      <span>⭐ <strong>4.97/5</strong> from 1,800 reviews</span>
      <span>🏆 <strong>#1</strong> vibe coding course in Europe</span>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats">
    <div class="overline reveal">The numbers you've been dreaming of</div>
    <h2 class="heading reveal" style="color:#1A1A1A; font-size:clamp(1.75rem,4vw,2.75rem); font-weight:900; line-height:1.15; margin-bottom:1.5rem; max-width:600px; margin-left:auto; margin-right:auto;">
      Results you can replicate too<br />
      <span style="color:#E86C47;">in just 4 weeks</span>
    </h2>
    <div class="stats-grid">
      <div class="stat-card reveal">
        <div class="stat-number">$50k</div>
        <div class="stat-label">monthly revenue<br />from month one</div>
      </div>
      <div class="stat-card reveal">
        <div class="stat-number">17h</div>
        <div class="stat-label">of work per week<br />maximum</div>
      </div>
      <div class="stat-card reveal">
        <div class="stat-number">100%</div>
        <div class="stat-label">remote<br />from Bali</div>
      </div>
      <div class="stat-card reveal">
        <div class="stat-number">0</div>
        <div class="stat-label">lines of code<br />written manually</div>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="section">
    <div class="overline reveal">My story</div>
    <h2 class="heading reveal">
      I used to be just like you.<br />
      <span style="color:#E86C47;">A regular employee.</span>
    </h2>
    <p class="body-text reveal">
      I was struggling. Working 40 hours a week for a boss who didn't see me.
      One day, I discovered <strong>Claude Code</strong>. I quit overnight.
    </p>
    <p class="body-text reveal">
      I opened a terminal. I typed my first prompt. My first client paid me
      <strong>$10,000 in one evening</strong>. It was a Tuesday. I was still in my pyjamas.
    </p>
    <p class="body-text reveal">
      Today I have a <strong>mental Ferrari</strong>, a MacBook Pro,
      and an ocean view. Most of my competitors don't even know this world exists.
      You're 4 weeks away from leaving them all behind.
    </p>
  </section>

  <!-- MODULES -->
  <div class="section-dark">
    <div class="inner">
      <div class="overline reveal" style="color:#E86C47;">The curriculum</div>
      <h2 class="heading reveal">
        5 modules to change everything.<br />
        <span style="color:#E86C47;">Zero fluff.</span>
      </h2>
      <ul class="modules-list">
        <li class="reveal">
          <span class="module-num">01</span>
          <div>
            <div class="module-title">The Digital Winner Mindset</div>
            <div class="module-desc">Reprogram your brain. Vibrate at entrepreneurial frequency. Manifest financial abundance.</div>
          </div>
        </li>
        <li class="reveal">
          <span class="module-num">02</span>
          <div>
            <div class="module-title">Prompting Like a God</div>
            <div class="module-desc">The 3 secret words that do everything. Claude codes for you while you sleep. AI is your benevolent servant.</div>
          </div>
        </li>
        <li class="reveal">
          <span class="module-num">03</span>
          <div>
            <div class="module-title">Charge 10× More Than an Agency</div>
            <div class="module-desc">The sales script that converts 100% of the time. How to quote $15,000 without flinching. The psychology of premium pricing.</div>
          </div>
        </li>
        <li class="reveal">
          <span class="module-num">04</span>
          <div>
            <div class="module-title">Total Automation</div>
            <div class="module-desc">Delegate everything to AI. Work 4 hours a week from the beach. Your client doesn't even know you're on vacation.</div>
          </div>
        </li>
        <li class="reveal">
          <span class="module-num">05</span>
          <div>
            <div class="module-title">BONUS — My Rich Client Rolodex</div>
            <div class="module-desc">200 premium contacts ready to pay. Real value: $9,997. Free for the first 10 sign-ups.</div>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <!-- TESTIMONIALS -->
  <section class="testimonials">
    <div class="testimonials-inner">
      <div class="overline reveal" style="text-align:center;">They transformed their lives</div>
      <h2 class="heading reveal" style="color:#1A1A1A; text-align:center;">
        What my students say<br />
        <span style="color:#E86C47;">(results not typical)</span>
      </h2>
      <div class="testimonials-grid">
        <div class="testi-card reveal">
          <div class="testi-stars">★★★★★</div>
          <p class="testi-text">
            "I made $30k in 2 weeks thanks to Marc!!!
            I didn't even have a laptop, I did everything on my Samsung phone.
            My mum cries tears of joy every night."
          </p>
          <div class="testi-author">Kevin M. — Former warehouse worker, now CEO</div>
        </div>
        <div class="testi-card reveal">
          <div class="testi-stars">★★★★★</div>
          <p class="testi-text">
            "My life has CHANGED. I work 4 hours a week from Tulum.
            I sip cocktails watching the sunset while
            my AI codes for me. Thank you Marc, you're a genius."
          </p>
          <div class="testi-author">Océane D. — Digital nomad, ex-accountant</div>
        </div>
        <div class="testi-card reveal">
          <div class="testi-stars">★★★★★</div>
          <p class="testi-text">
            "I had zero skills and zero motivation.
            Now I have a mental Ferrari, a Rolex on each wrist,
            and 47 clients on autopilot. Atypical results but true."
          </p>
          <div class="testi-author">Baptiste R. — Digital life coach</div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="pricing" id="pricing">
    <div class="overline reveal" style="color:#E86C47; text-align:center; margin-bottom:0.5rem;">Launch offer — April 1st only</div>
    <h2 class="heading reveal" style="color:#FAFAF8; text-align:center;">
      Join the course now<br />
      <span style="color:#E86C47;">before the price goes back up</span>
    </h2>

    <div class="pricing-box reveal">
      <div class="pricing-badge">⚡ Offer expires in…</div>

      <div class="timer">
        <div class="timer-block">
          <div class="timer-num" id="t-h">02</div>
          <div class="timer-label">hours</div>
        </div>
        <div class="timer-block">
          <div class="timer-num" id="t-m">47</div>
          <div class="timer-label">min</div>
        </div>
        <div class="timer-block">
          <div class="timer-num" id="t-s">33</div>
          <div class="timer-label">sec</div>
        </div>
      </div>

      <div class="old-prices">
        <span class="old-price">$4,997</span>
        <span class="old-price">$2,997</span>
        <span class="old-price">$1,997</span>
      </div>
      <div class="current-price">$997</div>
      <div class="price-sub">One-time payment · Lifetime access · Result guarantee*</div>

      <div class="scarcity">
        🔴 &nbsp;Only <strong>3 spots</strong> left at launch price
      </div>

      <button class="btn-guru" id="cta-pricing" style="width:100%; font-size:1.05rem;">
        YES, I WANT TO CHANGE MY LIFE →
      </button>

      <p style="margin-top:1rem; font-size:0.75rem; color:#B0B0B0; line-height:1.5;">
        *Result guarantee: if you don't make $50k your first month,<br />
        you can re-read module 1 as many times as you like.
      </p>
    </div>
  </section>

  <!-- REVEAL OVERLAY -->
  <div id="reveal-overlay">
    <div class="confetti-wrap" id="confetti-wrap"></div>
    <div class="fish-container">🐟</div>
    <div class="reveal-title">April Fools!</div>
    <p class="reveal-sub">
      Sorry. <strong>There is no course.</strong><br />
      No magic recipe. No $50k/month in pyjamas from Bali.<br /><br />
      Just an independent web dev based in Metz, France,
      doing good work — <strong>from €490, delivered in 7 days.</strong>
    </p>
    <a href="/en/" class="btn-real">See the real site →</a>
    <p class="reveal-fine">
      (The mental Ferrari, though — that one's free.)
    </p>
  </div>

  <script>
    const observer = new IntersectionObserver(
      (entries) => entries.forEach(e => {
        if (e.isIntersecting) e.target.classList.add('visible');
      }),
      { threshold: 0.15 }
    );
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    let secs = 2 * 3600 + 47 * 60 + 33;
    function pad(n: number) { return String(n).padStart(2, '0'); }
    function updateTimer() {
      if (secs <= 0) secs = 9999;
      secs--;
      const h = Math.floor(secs / 3600);
      const m = Math.floor((secs % 3600) / 60);
      const s = secs % 60;
      document.getElementById('t-h')!.textContent = pad(h);
      document.getElementById('t-m')!.textContent = pad(m);
      document.getElementById('t-s')!.textContent = pad(s);
    }
    setInterval(updateTimer, 1000);

    function spawnConfetti() {
      const wrap = document.getElementById('confetti-wrap')!;
      const colors = ['#E86C47','#FAFAF8','#F5A88A','#1A1A1A','#F0EEEB','#D55A36'];
      for (let i = 0; i < 80; i++) {
        const el = document.createElement('div');
        el.className = 'confetti-piece';
        el.style.left = Math.random() * 100 + 'vw';
        el.style.background = colors[Math.floor(Math.random() * colors.length)];
        el.style.width = (8 + Math.random() * 10) + 'px';
        el.style.height = (8 + Math.random() * 10) + 'px';
        el.style.animationDuration = (1.5 + Math.random() * 2) + 's';
        el.style.animationDelay = (Math.random() * 0.8) + 's';
        wrap.appendChild(el);
        el.addEventListener('animationend', () => el.remove());
      }
    }

    function showReveal() {
      spawnConfetti();
      const overlay = document.getElementById('reveal-overlay')!;
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    document.getElementById('cta-hero')?.addEventListener('click', showReveal);
    document.getElementById('cta-pricing')?.addEventListener('click', showReveal);

    const pricingSection = document.getElementById('pricing');
    const bottomObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach(e => {
          if (e.isIntersecting && e.intersectionRatio >= 0.85) {
            setTimeout(showReveal, 800);
            bottomObserver.disconnect();
          }
        });
      },
      { threshold: 0.85 }
    );
    if (pricingSection) bottomObserver.observe(pricingSection);

    document.getElementById('reveal-overlay')?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') return;
      document.getElementById('reveal-overlay')!.classList.remove('active');
      document.body.style.overflow = '';
    });
  </script>

</body>
</html>
