---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { business } from '../../data/business';

const whatsappMessage = encodeURIComponent("Hi Marc, I'd like a free audit of my online visibility.");

const demoPersonas = [
  { emoji: '🔧', name: 'Tom', age: 52, job: 'Plumber', canal: 'Google', device: 'Mobile', decision: 'hesitates', color: 'amber', reason: 'Searches "emergency plumber [city]". Lands on your site. No phone number visible above the fold. Gone in 8 seconds.' },
  { emoji: '✂️', name: 'Emma', age: 34, job: 'Hairdresser', canal: 'Google Maps', device: 'Mobile', decision: 'converts', color: 'emerald', reason: 'Clicks your Maps listing. Sees 5★ reviews, a price, a "Book now" button. Calls within the hour.' },
  { emoji: '🏡', name: 'Diane', age: 58, job: 'Looking for a tradesperson', canal: 'Word of mouth', device: 'Mobile', decision: 'leaves', color: 'red', reason: 'Someone recommended you. She finds your site. Not mobile-friendly. No company number visible. She doubts. Goes to a directory instead.' },
];
---

<BaseLayout
  title="Free audit — What your visitors see that you don't — Marc M"
  description="I visit your site as a real potential client would and tell you what's making them leave. Free, within 48h, no commitment."
  lang="en"
  frPath="/audit-gratuit"
  enPath="/en/free-audit"
>

  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 right-0 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>
    <div class="mx-auto max-w-2xl relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]/40 mb-6">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
        <span class="text-sm font-medium text-white/90">Free — response within 48h</span>
      </div>
      <h1 class="text-3xl font-bold text-white md:text-4xl lg:text-5xl mb-6 leading-tight">
        What your visitors see<br/>
        <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">that you don't.</span>
      </h1>
      <p class="text-lg text-neutral-300 leading-relaxed mb-4">
        I visit your site as a real potential client would, and tell you what's making them leave. Not a generic PDF — a human look at your actual situation.
      </p>
      <p class="text-sm text-neutral-500">No automated follow-ups. No email sequence. A real answer, from me.</p>
    </div>
  </section>

  <!-- WHAT I ACTUALLY DO -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-20">
    <div class="mx-auto max-w-2xl">

      <h2 class="text-xl font-bold text-[var(--color-text)] mb-6">What I actually do</h2>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-6">
        When you submit your site, I visit it by putting myself in the shoes of a few of your typical clients. Not with automated tools — with my head, simulating what a 50-year-old tradesperson arriving from Google Maps would see on their phone, or what a young entrepreneur looking for a specific reference would find (or not find).
      </p>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-10">
        It's a lighter version of my <a href="/echo/" class="underline underline-offset-2" style="color: var(--color-accent);">Écho service</a> — where I simulate up to 100 different visitor profiles with varied channels and intentions. Here, I focus on the two or three most visible frictions: the ones costing you clients today.
      </p>

      <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--color-accent); letter-spacing: 0.15em;">Examples of what I observe</p>
      <div class="space-y-3 mb-10">
        {demoPersonas.map(p => (
          <div class={`rounded-xl border p-4 ${p.color === 'emerald' ? 'border-emerald-200 bg-emerald-50' : p.color === 'red' ? 'border-red-200 bg-red-50' : 'border-amber-200 bg-amber-50'}`}>
            <div class="flex items-start gap-3">
              <span class="text-xl flex-shrink-0">{p.emoji}</span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="font-semibold text-sm text-[var(--color-text)]">{p.name}, {p.age}</span>
                  <span class="text-xs text-neutral-500">{p.job}</span>
                  <span class="text-xs text-neutral-400">· {p.canal} · {p.device}</span>
                </div>
                <p class={`text-xs leading-relaxed ${p.color === 'emerald' ? 'text-emerald-800' : p.color === 'red' ? 'text-red-800' : 'text-amber-800'}`}>
                  {p.reason}
                </p>
              </div>
              <span class={`flex-shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full ${p.color === 'emerald' ? 'bg-emerald-100 text-emerald-700' : p.color === 'red' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>
                {p.decision}
              </span>
            </div>
          </div>
        ))}
      </div>

      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
        For your free audit, I give you 3 observations like these — targeted at your real situation, not a generic scoring grid.
      </p>

    </div>
  </section>

  <!-- FORM -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-20 border-t border-neutral-100">
    <div class="mx-auto max-w-xl">
      <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">Request your audit</h2>
      <p class="text-[var(--color-text-muted)] text-sm mb-8">2 minutes. I'll reply within 48h.</p>

      <form action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
        <input type="hidden" name="access_key" value="dccda1f5-4e63-4b9f-9c66-f5ce76f0dfdd" />
        <input type="hidden" name="form_source" value="free-audit-en" />
        <input type="text" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="redirect" value="https://marcm.fr/merci" />
        <input type="hidden" name="subject" value="Free audit requested — marcm.fr (EN)" />
        <input type="hidden" name="from_page" value="/en/free-audit" />

        <div>
          <label for="name" class="block text-sm font-medium text-[var(--color-text)] mb-2">Your first name *</label>
          <input type="text" id="name" name="nom" required placeholder="Marie" class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition" />
        </div>

        <div>
          <label for="activity" class="block text-sm font-medium text-[var(--color-text)] mb-2">Your activity *</label>
          <input type="text" id="activity" name="activite" required placeholder="Hairdresser in Paris, plumber in Lyon, physio in Bordeaux..." class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition" />
        </div>

        <div>
          <label for="situation" class="block text-sm font-medium text-[var(--color-text)] mb-2">Your current situation *</label>
          <select id="situation" name="situation" required class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition bg-white">
            <option value="">Choose...</option>
            <option value="No website at all">I have no website at all</option>
            <option value="Site that doesn't bring clients">I have a site but it doesn't bring me clients</option>
            <option value="WordPress / Wix to redo">I have a WordPress or Wix to rebuild</option>
            <option value="Recent site but not visible">I have a recent site but I'm not visible on Google</option>
            <option value="Starting my business">I'm starting my business and preparing the launch</option>
          </select>
        </div>

        <div>
          <label for="url" class="block text-sm font-medium text-[var(--color-text)] mb-2">Your current site URL <span class="text-neutral-400 font-normal">(if you have one)</span></label>
          <input type="url" id="url" name="url_site" placeholder="https://your-site.com" class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition" />
        </div>

        <div>
          <label for="problem" class="block text-sm font-medium text-[var(--color-text)] mb-2">What's your main problem right now *</label>
          <textarea id="problem" name="probleme" required rows="3" placeholder="E.g.: my competitors appear on Google Maps and I don't, my site is slow, I get no online enquiries..." class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition resize-none"></textarea>
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-[var(--color-text)] mb-2">Your email to receive the audit *</label>
          <input type="email" id="email" name="email" required placeholder="you@yourbusiness.com" class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition" />
        </div>

        <button type="submit" class="w-full py-4 px-6 rounded-xl font-bold text-white transition-opacity hover:opacity-90" style="background-color: #E86C47;" data-umami-event="free-audit-submit">
          Send my audit request →
        </button>
        <p class="text-xs text-neutral-400 text-center">Your data is never sold or used for automated marketing.</p>
      </form>
    </div>
  </section>

  <!-- WHAT YOU'LL RECEIVE -->
  <section class="w-full px-6 py-16 md:px-8 md:py-20" style="background: #FAFAFA;">
    <div class="mx-auto max-w-2xl">
      <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">What you'll receive</h2>
      <p class="text-[var(--color-text-muted)] text-sm mb-8">Not a 12-page PDF with screenshots and scores. Three specific points, written by hand.</p>
      <div class="space-y-4">
        {[
          { num: '01', title: 'The main friction', desc: 'What\'s making your visitors leave — the real reason, not "your LCP is 3.8 seconds". Something like: Tom, a 52-year-old plumber, couldn\'t find your phone number in 8 seconds.' },
          { num: '02', title: 'What your competitors are doing', desc: 'Not a list of 40 things to fix. One concrete point where a local competitor is beating your site in the eyes of a typical client.' },
          { num: '03', title: 'The first action to take', desc: 'Achievable alone if you control your site, or with my help if you want it. Zero obligation — the audit belongs to you.' },
        ].map(o => (
          <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 flex gap-4">
            <div class="text-2xl font-bold flex-shrink-0" style="color: #E86C47; opacity: 0.35;">{o.num}</div>
            <div>
              <h3 class="font-bold text-[var(--color-text)] mb-1 text-sm">{o.title}</h3>
              <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{o.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LINK TO ECHO -->
  <section class="w-full bg-white px-6 py-12 md:px-8 border-t border-neutral-100">
    <div class="mx-auto max-w-2xl">
      <div class="rounded-xl border border-neutral-200 p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="flex-1">
          <p class="font-semibold text-[var(--color-text)] text-sm mb-1">Want to go further?</p>
          <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
            My Écho service simulates up to 100 different visitors on your site — with profiles, arrival channels, and varied intentions. Results in 48h, private interactive report.
          </p>
        </div>
        <a href="/echo" class="flex-shrink-0 inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl font-semibold text-sm text-white transition-opacity hover:opacity-90 whitespace-nowrap" style="background-color: #E86C47;">
          Discover Écho →
        </a>
      </div>
    </div>
  </section>

  <section class="w-full bg-white px-6 py-10 md:px-8 border-t border-neutral-100">
    <div class="mx-auto max-w-xl text-center">
      <p class="text-neutral-500 text-sm mb-4">Don't want to wait for the audit? We can talk it through.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="https://cal.com/marc-muller/15min"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-white transition-all hover:shadow-lg hover:-translate-y-0.5"
          style="background: linear-gradient(135deg, #E86C47, #D4572F); box-shadow: 0 4px 20px rgba(232, 108, 71, 0.3);"
          data-umami-event="en-cal-cta-audit"
        >
          Let's talk? 15 min, no strings attached
        </a>
        <a href={`https://wa.me/${business.whatsapp}?text=${whatsappMessage}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl border border-neutral-200 text-sm font-medium text-[var(--color-text)] hover:bg-neutral-50 transition">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Message on WhatsApp
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
