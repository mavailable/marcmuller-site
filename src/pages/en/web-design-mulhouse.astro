---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { business } from '../../data/business';
---

<BaseLayout
  title="Web Design Mulhouse | Delivered in 7 days, from €490"
  description="Custom websites for businesses in Mulhouse and the Haut-Rhin. Fast, visible on Google, built to convert. 30+ sites delivered in Grand Est. Free quote within 24h."
  lang="en"
  frPath="/creation-site-web-mulhouse"
  enPath="/en/web-design-mulhouse"
>
  <SchemaOrg type="localBusiness" />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-20 md:px-8 md:py-28 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-[20%] right-[10%] w-[400px] h-[400px] rounded-full bg-[var(--color-accent)] opacity-[0.08] blur-[120px]"></div>

    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]">
        <span class="w-2 h-2 rounded-full" style="background-color: #E86C47;"></span>
        <span class="text-sm font-semibold text-white">Mulhouse &middot; Haut-Rhin &middot; Alsace</span>
      </div>

      <h1 class="mb-6 text-4xl font-bold leading-tight text-white md:text-5xl">
        Web Design in Mulhouse
      </h1>
      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl">
        Custom websites for freelancers, shops and practitioners in Mulhouse and the Haut-Rhin. Fast, well-ranked, delivered in 7 days. No WordPress, no templates.
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="/en/order-starter-site/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--color-accent)] px-8 py-4 font-semibold text-white transition-all duration-300 hover:bg-[var(--color-accent-hover)] hover:shadow-lg hover:-translate-y-0.5">
          Get a free quote
        </a>
        <a href="/en/portfolio" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/5 px-8 py-4 font-semibold text-white/85 transition-all duration-300 hover:bg-white/10">
          View my work
        </a>
      </div>
    </div>
  </section>

  <!-- CONTEXT -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-16 md:grid-cols-2 items-start">
        <div class="space-y-6 text-[var(--color-text-muted)] leading-relaxed">
          <h2 class="text-2xl font-bold text-[var(--color-text)]">Mulhouse: a city full of trades, mostly invisible online</h2>
          <p>Mulhouse is a town of craftspeople, shopkeepers and makers. On the web side, many are invisible.</p>
          <p>What I see most days: dated WordPress sites or no site at all, half-empty Google Business listings, better-ranked competitors taking the clients, and mobile visitors bouncing after 3 seconds of load time.</p>
          <p>When someone types "hairdresser Mulhouse", "osteopath Mulhouse" or "plumber Mulhouse" into Google, are you on that results page? If not, you're losing clients every day.</p>
          <p>Mulhouse also sits near Switzerland and Germany. A bilingual FR/DE site can pull in cross-border clients that your competitors ignore.</p>
        </div>
        <div class="space-y-4">
          <h2 class="text-2xl font-bold text-[var(--color-text)]">What you get</h2>
          {[
            { title: "Custom design", desc: "Reflects your actual business. No templates, no generic layouts." },
            { title: "Mulhouse & Haut-Rhin SEO", desc: "Localised keywords, Google Maps, structured data." },
            { title: "AI search ready", desc: "ChatGPT, Perplexity and Claude can cite you by name." },
            { title: "Mobile-first", desc: "80% of local searches happen on a phone. Your site is built for that first." },
            { title: "Lighthouse 100", desc: "Loads in under a second. No cached pages, no tricks." },
            { title: "Bilingual options", desc: "FR/DE or FR/EN for cross-border business with Switzerland and Germany." },
          ].map(({ title, desc }) => (
            <div class="flex items-start gap-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-4">
              <svg class="h-5 w-5 mt-0.5 flex-shrink-0 text-[var(--color-accent-text)]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <div>
                <div class="font-semibold text-[var(--color-text)]">{title}</div>
                <div class="text-sm text-[var(--color-text-muted)]">{desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- WHO I WORK WITH -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-20">
    <div class="mx-auto max-w-5xl">
      <h2 class="mb-3 text-2xl font-bold text-[var(--color-text)]">Who I build sites for in Mulhouse and the Haut-Rhin</h2>
      <p class="mb-10 text-[var(--color-text-muted)]">Typical situations, typical outcomes.</p>

      <div class="space-y-6">
        <div class="rounded-2xl border border-[var(--color-border)] p-6 md:p-8">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="text-lg font-bold text-[var(--color-text)]">A beauty salon or spa</h3>
            <span class="shrink-0 rounded-full bg-pink-50 border border-pink-200 px-3 py-1 text-xs font-semibold text-pink-700">Beauty</span>
          </div>
          <div class="grid md:grid-cols-2 gap-4 text-sm">
            <div class="rounded-lg bg-red-50 border border-red-100 p-4">
              <p class="font-semibold text-red-700 mb-1">Before</p>
              <p class="text-red-600">A Facebook page and an old Wix site nobody finds on Google.</p>
            </div>
            <div class="rounded-lg bg-emerald-50 border border-emerald-100 p-4">
              <p class="font-semibold text-emerald-700 mb-1">After</p>
              <p class="text-emerald-600">Before/after gallery, services, pricing, online booking. New clients come in via Google.</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-[var(--color-border)] p-6 md:p-8">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="text-lg font-bold text-[var(--color-text)]">A healthcare practitioner</h3>
            <span class="shrink-0 rounded-full bg-teal-50 border border-teal-200 px-3 py-1 text-xs font-semibold text-teal-700">Healthcare</span>
          </div>
          <div class="grid md:grid-cols-2 gap-4 text-sm">
            <div class="rounded-lg bg-red-50 border border-red-100 p-4">
              <p class="font-semibold text-red-700 mb-1">Before</p>
              <p class="text-red-600">No website at all, only Doctolib. Patients come through a platform you don't control.</p>
            </div>
            <div class="rounded-lg bg-emerald-50 border border-emerald-100 p-4">
              <p class="font-semibold text-emerald-700 mb-1">After</p>
              <p class="text-emerald-600">Sober, professional site with approach, conditions treated, pricing. Patients find you on Google, not just on the platform.</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-[var(--color-border)] p-6 md:p-8">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="text-lg font-bold text-[var(--color-text)]">A craftsperson or local shop</h3>
            <span class="shrink-0 rounded-full bg-orange-50 border border-orange-200 px-3 py-1 text-xs font-semibold text-orange-700">Crafts</span>
          </div>
          <div class="grid md:grid-cols-2 gap-4 text-sm">
            <div class="rounded-lg bg-red-50 border border-red-100 p-4">
              <p class="font-semibold text-red-700 mb-1">Before</p>
              <p class="text-red-600">Zero online presence.</p>
            </div>
            <div class="rounded-lg bg-emerald-50 border border-emerald-100 p-4">
              <p class="font-semibold text-emerald-700 mb-1">After</p>
              <p class="text-emerald-600">Showcase site with hours, services, contact form. Neighbourhood clients and beyond discover you online.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-10 text-center text-2xl font-bold text-[var(--color-text)]">Frequently asked questions</h2>
      <div class="space-y-3">
        {[
          {
            q: "You're based in Metz. Do you really work on Mulhouse projects?",
            a: "Yes. Everything happens remotely: scoping call by phone or video, back-and-forth by email and WhatsApp. I have clients across Grand Est and beyond. Distance doesn't change quality or delivery time."
          },
          {
            q: "How long until I appear on Google for Mulhouse searches?",
            a: "Your site is live in 7 days. Local ranking (Google Maps, organic results) takes 2 to 8 weeks to show up, depending on competition on your keywords. Technical SEO is in from day one."
          },
          {
            q: "Can you build a French/German bilingual site?",
            a: "Yes. It genuinely helps for Mulhouse and the cross-border zone. FR/DE or FR/EN available, with content translated and localised rather than run through Google Translate. Useful if you serve Swiss or German clients."
          },
          {
            q: "Can you rebuild a WordPress or Wix site?",
            a: "Yes, frequently. I carry over your content, your domain, and redirect the old site to the new one to preserve your Google ranking. Result: faster, more secure, no monthly subscription."
          },
          {
            q: "What's the difference with a Mulhouse web agency?",
            a: "Price (€490 vs €2,000-5,000), delivery time (7 days vs 4-8 weeks), and a single point of contact (me, from start to finish). Same technical standard: Lighthouse 100, SEO included, custom design. No account manager, no middle layer."
          },
          {
            q: "I'm a healthcare professional. Is that a fit?",
            a: "Yes. Osteopaths, physios, nurses, psychologists. I respect the deontological constraints of your profession: no comparative advertising, compliant legal notices. The site stays sober and professional."
          }
        ].map(({ q, a }, i) => (
          <details class="group rounded-xl bg-white p-6 border border-[var(--color-border)] hover:shadow-sm transition-all" open={i === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-3 font-bold text-[var(--color-text)]">
              <span>{q}</span>
              <svg class="h-5 w-5 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </summary>
            <p class="mt-4 text-[var(--color-text-muted)]">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING SUMMARY -->
  <section class="w-full bg-[var(--color-bg-alt)] px-6 py-16 md:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="mb-4 text-2xl font-bold text-[var(--color-text)]">Transparent pricing</h2>
      <p class="mb-8 text-[var(--color-text-muted)]">One product, one price. Bespoke work on request.</p>
      <div class="grid gap-4 md:grid-cols-2 max-w-2xl mx-auto">
        {business.offers.map((offer) => (
          <div class="rounded-xl border border-[var(--color-border)] bg-white p-6 hover:shadow-md transition-all">
            <div class="text-2xl font-extrabold text-[var(--color-accent-text)]">{offer.price ? `€${offer.price.toLocaleString()}` : 'On request'}</div>
            <div class="mt-1 font-bold text-[var(--color-text)]">{offer.name}</div>
          </div>
        ))}
      </div>
      <a href="/en/services" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-text)] hover:underline">
        Full pricing details &rarr;
      </a>
    </div>
  </section>

  <!-- FURTHER READING -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-12 md:px-8 md:py-16">
    <div class="mx-auto max-w-3xl">
      <a
        href="/en/blog/build-business-website-grand-est-guide"
        data-umami-event="geo-pillar-link"
        data-umami-event-ville="mulhouse"
        class="group block rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-6 md:p-8 transition-all hover:border-[var(--color-accent)] hover:shadow-md"
      >
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-[var(--color-accent-text)]">Further reading</p>
        <h3 class="mb-2 text-xl font-bold leading-snug text-[var(--color-text)] md:text-2xl">
          Building your business website in the Grand Est: the practical guide
        </h3>
        <p class="mb-4 leading-relaxed text-[var(--color-text-muted)]">
          The real steps, the actual costs, the timeline, and what changes when you run a small business in Mulhouse. A complete guide, no jargon.
        </p>
        <span class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-accent-text)]">
          Read the guide
          <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
        </span>
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-6 text-3xl font-bold text-white">Ready to launch your Mulhouse site?</h2>
      <a href="/en/order-starter-site/" class="inline-flex items-center gap-2 rounded-xl px-10 py-4 text-lg font-semibold text-white" style="background: linear-gradient(135deg, #E86C47, #D4572F); box-shadow: 0 4px 20px rgba(232, 108, 71, 0.3);">
        Order my site for €490
      </a>
    </div>
  </section>
</BaseLayout>
