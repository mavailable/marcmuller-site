---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { business } from '../../data/business';
---

<BaseLayout
  title="Web Design Metz — Marc M | Custom Websites"
  description="Custom website creation in Metz and Moselle. Fast, SEO-optimised sites for craftspeople, SMEs and local businesses. From €490. Free quote."
  lang="en"
  frPath="/creation-site-web-metz"
  enPath="/en/web-design-metz"
>
  <SchemaOrg type="localBusiness" />

  <!-- HERO -->
  <section class="relative w-full bg-[#0D0D0D] px-6 py-20 md:px-8 md:py-28 overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-[20%] right-[10%] w-[400px] h-[400px] rounded-full bg-[var(--color-accent)] opacity-[0.08] blur-[120px]"></div>

    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]">
        <span class="w-2 h-2 rounded-full" style="background-color: #E86C47;"></span>
        <span class="text-sm font-semibold text-white">Metz · Moselle · Grand Est</span>
      </div>

      <h1 class="mb-6 text-4xl font-bold leading-tight text-white md:text-5xl">
        Web Design in Metz
      </h1>
      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl">
        Custom websites for businesses in Metz, the Moselle region and the Grand Est. Fast, visible, and built to convert.
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="/en/contact" class="inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--color-accent)] px-8 py-4 font-semibold text-white transition-all duration-300 hover:bg-[var(--color-accent-hover)] hover:shadow-lg hover:-translate-y-0.5">
          Get a free quote
        </a>
        <a href="/en/portfolio" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/5 px-8 py-4 font-semibold text-white/85 transition-all duration-300 hover:bg-white/10">
          View my work
        </a>
      </div>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-16 md:grid-cols-2 items-start">
        <div class="space-y-6 text-[var(--color-text-muted)] leading-relaxed">
          <h2 class="text-2xl font-bold text-[var(--color-text)]">Your Metz-based web developer</h2>
          <p>I create custom websites for craftspeople, SMEs and local businesses in Metz, the Moselle valley and across the Grand Est region. Every site is designed from scratch — no templates, no page builders.</p>
          <p>Being local matters: I know the Metz market, I understand the types of businesses here, and I can meet in person if you prefer. Whether you're in the city centre, Montigny-lès-Metz, Woippy, or anywhere in the Moselle, I'm your web developer.</p>
          <p>All my sites are built with Astro — a modern framework that produces ultra-fast, highly-ranked static sites. Your site will load in under a second and score 100/100 on Google's performance test.</p>
        </div>
        <div class="space-y-4">
          <h2 class="text-2xl font-bold text-[var(--color-text)]">What you get</h2>
          {[
            { title: "Custom design", desc: "Tailored to your trade, your personality, your clients." },
            { title: "Local SEO", desc: "Optimised to appear when people search for your services in Metz." },
            { title: "Mobile-first", desc: "Perfect on phones — where most local searches happen." },
            { title: "Fast delivery", desc: "Delivered in 7 days on average. Metz-area or remote." },
            { title: "1-year hosting included", desc: "Cloudflare CDN hosting and your domain included." },
          ].map(({ title, desc }) => (
            <div class="flex items-start gap-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-4">
              <svg class="h-5 w-5 mt-0.5 flex-shrink-0 text-[var(--color-accent)]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <div>
                <div class="font-semibold text-[var(--color-text)]">{title}</div>
                <div class="text-sm text-[var(--color-text-muted)]">{desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CASE STUDIES -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-20">
    <div class="mx-auto max-w-5xl">
      <h2 class="mb-3 text-2xl font-bold text-[var(--color-text)]">Sites built in Metz & Moselle</h2>
      <p class="mb-10 text-[var(--color-text-muted)]">Real projects, real results — before and after.</p>

      <div class="space-y-6">
        <div class="rounded-2xl border border-[var(--color-border)] p-6 md:p-8">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="text-lg font-bold text-[var(--color-text)]">Salon Lumière — Metz</h3>
            <span class="shrink-0 rounded-full bg-emerald-50 border border-emerald-200 px-3 py-1 text-xs font-semibold text-emerald-700">Hair salon</span>
          </div>
          <div class="grid md:grid-cols-2 gap-4 text-sm">
            <div class="rounded-lg bg-red-50 border border-red-100 p-4">
              <p class="font-semibold text-red-700 mb-1">Before</p>
              <p class="text-red-600">Slow WordPress site with oversized images, no mobile optimisation, no online booking.</p>
            </div>
            <div class="rounded-lg bg-emerald-50 border border-emerald-100 p-4">
              <p class="font-semibold text-emerald-700 mb-1">After</p>
              <p class="text-emerald-600">Fast new site with before/after gallery, clear pricing, online booking form. +30% bookings via the site.</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-[var(--color-border)] p-6 md:p-8">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="text-lg font-bold text-[var(--color-text)]">Charpente Gérard — Moselle</h3>
            <span class="shrink-0 rounded-full bg-orange-50 border border-orange-200 px-3 py-1 text-xs font-semibold text-orange-700">Carpenter</span>
          </div>
          <div class="grid md:grid-cols-2 gap-4 text-sm">
            <div class="rounded-lg bg-red-50 border border-red-100 p-4">
              <p class="font-semibold text-red-700 mb-1">Before</p>
              <p class="text-red-600">No website at all. Only word-of-mouth referrals.</p>
            </div>
            <div class="rounded-lg bg-emerald-50 border border-emerald-100 p-4">
              <p class="font-semibold text-emerald-700 mb-1">After</p>
              <p class="text-emerald-600">Portfolio gallery, testimonials, indicative pricing, online quote form. 3 new quote requests in the first month — previously zero.</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-[var(--color-border)] p-6 md:p-8">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="text-lg font-bold text-[var(--color-text)]">La Boulangerie du Coin — Metz</h3>
            <span class="shrink-0 rounded-full bg-amber-50 border border-amber-200 px-3 py-1 text-xs font-semibold text-amber-700">Bakery</span>
          </div>
          <div class="grid md:grid-cols-2 gap-4 text-sm">
            <div class="rounded-lg bg-red-50 border border-red-100 p-4">
              <p class="font-semibold text-red-700 mb-1">Before</p>
              <p class="text-red-600">Facebook only, no website — invisible on Google Maps searches.</p>
            </div>
            <div class="rounded-lg bg-emerald-50 border border-emerald-100 p-4">
              <p class="font-semibold text-emerald-700 mb-1">After</p>
              <p class="text-emerald-600">Menu, opening hours, news, online orders. Stable in-store footfall, plus online orders on Sundays.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-10 text-center text-2xl font-bold text-[var(--color-text)]">Frequently asked questions</h2>
      <div class="space-y-3">
        {[
          {
            q: "Are you actually based in Metz or somewhere else?",
            a: "I'm based in Montigny-lès-Metz, right next to Metz. I know the city. We start with a video call, and I'm happy to meet in person if you prefer."
          },
          {
            q: "How long until I start getting calls from the website?",
            a: "Weeks 1–4: your site is live and climbing Google for your local keywords. Months 1–3: first inbound calls start coming in. Months 3–6: steady, reliable traffic — you're becoming the dominant result in your category locally. Not magic, but it works."
          },
          {
            q: "Is the SEO basic or actually advanced?",
            a: "A well-built site is already 80% of the SEO battle. On the Showcase Site, I handle on-page + local SEO. On Bespoke Projects, I include a more advanced strategy — city and service pages, rich structured data, content targeting."
          },
          {
            q: "What happens after delivery?",
            a: "Minor updates (text, photos, hours) you can handle yourself via the editing interface. More technical changes, I handle those. Monthly support plans start at €39/month if you want someone on call."
          }
        ].map(({ q, a }, i) => (
          <details class="group rounded-xl bg-white p-6 border border-[var(--color-border)] hover:shadow-sm transition-all" open={i === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-3 font-bold text-[var(--color-text)]">
              <span>{q}</span>
              <svg class="h-5 w-5 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </summary>
            <p class="mt-4 text-[var(--color-text-muted)]">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING SUMMARY -->
  <section class="w-full bg-[var(--color-bg-alt)] px-6 py-16 md:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="mb-4 text-2xl font-bold text-[var(--color-text)]">Transparent pricing</h2>
      <p class="mb-8 text-[var(--color-text-muted)]">One product, one price. Complex projects on request.</p>
      <div class="grid gap-4 md:grid-cols-2 max-w-2xl mx-auto">
        {business.offers.map((offer) => (
          <div class="rounded-xl border border-[var(--color-border)] bg-white p-6 hover:shadow-md transition-all">
            <div class="text-2xl font-extrabold text-[var(--color-accent)]">{offer.price ? `€${offer.price.toLocaleString()}` : 'On request'}</div>
            <div class="mt-1 font-bold text-[var(--color-text)]">{offer.name}</div>
          </div>
        ))}
      </div>
      <a href="/en/services" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent)] hover:underline">
        Full pricing details →
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full bg-[#0D0D0D] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-6 text-3xl font-bold text-white">Ready to get online?</h2>
      <a href="/en/contact" class="inline-flex items-center gap-2 rounded-xl px-10 py-4 text-lg font-semibold text-white" style="background: linear-gradient(135deg, #E86C47, #D4572F); box-shadow: 0 4px 20px rgba(232, 108, 71, 0.3);">
        Get a free quote
      </a>
    </div>
  </section>
</BaseLayout>
