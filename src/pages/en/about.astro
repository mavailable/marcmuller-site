---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { business } from '../../data/business';
---

<BaseLayout
  title="About Marc M | The Independent's Right Hand"
  description="Marc Muller, based in Grand Est, France. I help independents find clients: a website that brings them in, what you need to go and find them, and the tools that save you time. Like a business partner who rolls up his sleeves, without taking a share."
  lang="en"
  frPath="/qui-suis-je"
  enPath="/en/about"
>
  <SchemaOrg type="person" />

  <!-- HERO - Photo + tagline -->
  <section class="w-full relative overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute top-[20%] left-[50%] -translate-x-1/2 w-[500px] h-[500px] rounded-full opacity-[0.08] blur-[120px]" style="background: var(--color-accent);"></div>
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 32px 32px;"></div>

    <div class="mx-auto max-w-4xl relative z-10 px-6 pt-20 md:pt-28">
      <div class="flex flex-col md:flex-row items-center gap-0 md:gap-12">
        <div class="flex-shrink-0 w-64 md:w-80 mx-auto md:mx-0 relative">
          <picture>
            <source srcset="/images/marc-muller.webp" type="image/webp" />
            <img
              src="/images/marc-muller.png"
              alt="Marc Muller"
              class="w-full h-auto relative z-10"
              width="500"
              height="500"
              loading="eager"
            />
          </picture>
          <div class="absolute bottom-0 left-0 right-0 h-24 z-20" style="background: linear-gradient(to top, #0D0D0D, transparent);"></div>
        </div>
        <div class="text-center md:text-left pb-8 md:pb-0 pt-4 md:pt-0">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] mb-4" style="color: var(--color-accent);">About</p>
          <h1 class="text-4xl md:text-5xl font-bold leading-[1.1] text-white mb-4">Marc Muller</h1>
          <p class="text-xl md:text-2xl leading-relaxed font-light" style="color: rgba(255,255,255,0.7);">
            40. Based in Metz. Entrepreneur since forever. I help independents find clients, and I build the tools that go with it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-2xl">

      <p class="text-xl md:text-2xl leading-relaxed text-[var(--color-text)] font-medium mb-10">
        I grew up around bakeries, surrounded by entrepreneurs who get up early and build things with their hands.
      </p>
      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-6">
        That stuck. Since then, I've spent ten years in construction and real estate, then ten years in escape rooms, first physical, then online. Every time, the same instinct: build my own tools. Physical mechanisms, code, entire systems rigged together so things run exactly how I want them.
      </p>
      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-16">
        I'm not a trained developer, but I've always had my hands in tech, pushed along by people close to me who've been swimming in it for years.
      </p>

      <div class="border-l-3 pl-6 md:pl-8 mb-16" style="border-color: var(--color-accent);">
        <p class="text-lg md:text-xl leading-relaxed text-[var(--color-text)] italic">
          I built websites for every business I ran. Or rather: I struggled to. For years, it was the frustrating part: having a clear vision but not the right tools to get a clean result out.
        </p>
      </div>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-6">
        Today, I put all of that to work for independents: a website that brings you clients, what you need to go and find them, and the tools that save you time. I've already done it for my own businesses, and I build every tool I hand you myself. Like the partner I never had when I started, without taking a share of your business.
      </p>
      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)]">
        I work mainly in the Grand Est region (Strasbourg, Metz, Nancy, Colmar, Mulhouse) but I'm fully remote-friendly, with clients anywhere in France or Europe.
      </p>

    </div>
  </section>

  <!-- STATS -->
  <section class="w-full bg-white px-6 py-10 md:py-14 border-y" style="border-color: var(--color-border);">
    <div class="mx-auto max-w-3xl">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 text-center">
        <div>
          <p class="text-3xl md:text-4xl font-bold text-[var(--color-text)]">20</p>
          <p class="text-sm text-[var(--color-text-muted)] mt-1">years of entrepreneurship</p>
        </div>
        <div>
          <p class="text-3xl md:text-4xl font-bold text-[var(--color-text)]">4</p>
          <p class="text-sm text-[var(--color-text-muted)] mt-1">industries</p>
        </div>
        <div>
          <p class="text-3xl md:text-4xl font-bold" style="color: var(--color-accent);">33</p>
          <p class="text-sm text-[var(--color-text-muted)] mt-1">projects completed</p>
        </div>
        <div>
          <p class="text-3xl md:text-4xl font-bold" style="color: var(--color-accent);">100<span class="text-lg">/100</span></p>
          <p class="text-sm text-[var(--color-text-muted)] mt-1">Lighthouse score</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT I LOVE -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-16 md:grid-cols-2 items-start">

        <div class="space-y-6 text-[var(--color-text-muted)] leading-relaxed text-base">
          <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)]">What I love about this job</h2>
          <p>
            Meeting people. Every client is a different trade, a different story, a different problem to solve. After twenty years building businesses in very different worlds, that's what keeps me going: understanding what you do and making it visible.
          </p>
          <p>
            And learning. All the time. New tools, new techniques, new ways to do things. The web moves fast. People who stop moving fall behind. I'd rather stay curious. That's how I make better sites every month.
          </p>
        </div>

        <div class="space-y-6">
          <h2 class="text-2xl font-bold text-[var(--color-text)]">My approach</h2>
          <div class="space-y-4">
            {[
              { title: "Custom, not copy-paste", desc: "Every site is built from scratch. Your business is unique. Your website should be too." },
              { title: "Speed is not optional", desc: "A slow site loses visitors. Every project targets 100/100 on Lighthouse. Good for users, great for SEO." },
              { title: "SEO from day one", desc: "Visibility is built into the structure. Technical SEO, Schema.org and GEO (AI search) are included in every project." },
              { title: "Honest timelines", desc: "I deliver in 7 days on average. I don't over-promise, and I keep you in the loop at every step." },
            ].map(({ title, desc }) => (
              <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-5">
                <h3 class="mb-2 font-bold text-[var(--color-text)]">{title}</h3>
                <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DIVING NOTE -->
  <section class="w-full px-6 py-10 md:px-8 md:py-14" style="background: var(--color-bg-alt);">
    <div class="mx-auto max-w-2xl flex items-start gap-4">
      <span class="text-2xl flex-shrink-0 mt-0.5">🤿</span>
      <p class="text-[var(--color-text-muted)] leading-relaxed">
        When I'm not in front of a screen, I'm probably underwater. Certified Divemaster, I sometimes work between dives. Remote, not disconnected.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full bg-[#0D0D0D] px-6 py-24 md:px-8 md:py-32">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-6 text-3xl md:text-4xl font-bold text-white">
        Want to talk?
      </h2>
      <p class="mb-10 text-lg text-neutral-400">
        Tell me where you're at, and I'll tell you where to start to find clients. No obligation.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/en/contact/" class="inline-flex items-center gap-2 rounded-xl px-10 py-4 text-lg font-semibold text-white transition-all duration-300 hover:-translate-y-0.5" style="background: linear-gradient(135deg, #E86C47, #D4572F); box-shadow: 0 4px 20px rgba(232, 108, 71, 0.3);" data-umami-event="en-about-cta-contact">
          Let's talk
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
        <a href={`https://wa.me/${business.whatsapp}?text=${encodeURIComponent("Hi Marc, I saw your profile and I'd like to discuss a project.")}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl px-8 py-4 text-base font-semibold text-white transition-all hover:-translate-y-0.5" style="background:#25D366;" data-umami-event="en-about-whatsapp-click">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
