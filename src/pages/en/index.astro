---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { business } from '../../data/business';
import { getProjectsForCarousel, getClientProjects, getSampleProjects } from '../../data/projects';

const { sitesRealises, sitesTotal } = business;
const progressPercent = Math.round((sitesRealises / sitesTotal) * 100);
const totalProjects = getClientProjects().length + getSampleProjects().length;

// Hero projects: use portfolio carousel (EN-friendly), fallback to homepage
const rawHero = getProjectsForCarousel('portfolio').length >= 3
  ? getProjectsForCarousel('portfolio')
  : getProjectsForCarousel('homepage');
const heroProjects = rawHero.slice(0, 3).map(p => ({
  img: p.screenshot,
  name: p.titleEn || p.title,
  sub: p.sectorEn || p.sector,
  id: p.id,
  url: p.url,
}));

// Reviews come from projects.ts (French verbatim preserved, see originalLanguage note below)
const reviewProjects = getProjectsForCarousel('homepage').filter(p => p.review);

const faqItems = [
  {
    question: "How much does a website cost?",
    answer: "€490 for a professional Starter Site, delivered in 7 days. More complex projects (multi-page, blog, business-specific features) are quoted individually. Hosting and domain are included."
  },
  {
    question: "How is a €490 website possible?",
    answer: "No sales team, no office, no WordPress to maintain. I use modern tools (Astro, Tailwind) and a streamlined process that lets me ship in 7 days what an agency takes 3 weeks to produce. The price reflects efficiency, not corners cut. Every site scores 100 on Lighthouse."
  },
  {
    question: "How long does it take?",
    answer: "7 working days for a Starter Site. 2 to 4 weeks for a bespoke project. Every project starts with a short scoping call (phone, video or chat)."
  },
  {
    question: "Do you work with WordPress?",
    answer: "No. I use Astro, a modern framework that's significantly faster and more secure. The result is a site that loads in under a second and that Google loves."
  },
  {
    question: "Is SEO included?",
    answer: "Yes. Every site is optimised from the start: semantic markup, performance, structured data, and local SEO. Technical SEO is baked in across all plans."
  },
  {
    question: "I don't know what to write on my site. Is that a problem?",
    answer: "Not at all. I write all your copy from a short 15-minute chat. You tell me about your work, I handle the rest: headlines, descriptions, About page, FAQ. You review and approve."
  },
  {
    question: "Can I edit the site myself afterwards?",
    answer: "Yes. Your site ships with a simple editing dashboard where you can change text, photos and opening hours. It's as easy as posting on Facebook. No code involved."
  },
  {
    question: "Who is this for?",
    answer: "Craftspeople, shop owners, hairdressers, beauticians, osteopaths, physios, photographers, wedding planners, coaches, restaurateurs, guesthouses, freelancers, associations. Any independent or small business that needs a professional site without draining the budget or weeks of their time. I also work with healthcare professionals and beauty trades."
  },
  {
    question: "I already have Instagram (or Doctolib, or a directory listing). Why do I need a site?",
    answer: "Platforms give you visibility within their audience. A website makes you visible everywhere: Google, ChatGPT, Perplexity, Claude. Without a site, search engines and AI tools don't cite you. Plus, a site is yours. No algorithm decides whether your clients see you. A site doesn't replace social media, it completes it."
  },
  {
    question: "Do you only work in Grand Est, France?",
    answer: "I'm based in Metz but I work with clients all over France and beyond. Everything happens remotely: phone, video or chat, emails, WhatsApp. I also ship bilingual sites (FR/EN, FR/DE) for cross-border businesses."
  },
  {
    question: "Can you redo a WordPress, Wix or Squarespace site?",
    answer: "Yes, this is a common case. I carry over your existing content (text, photos), your domain name, and I redirect the old site to the new one to preserve your Google ranking. Result: a faster, more secure site without monthly subscriptions or plugins to update."
  },
  {
    question: "One round of revisions. Is that enough?",
    answer: "One round means one complete list of changes, not a single tweak. You send all your feedback at once, I fix everything. In practice, most of my clients approve on the first pass because the scoping call upfront nails the brief."
  },
  {
    question: "Not comfortable with technology?",
    answer: "No worries. Give me 15 minutes by phone, video or WhatsApp, I do all the rest. Nothing to install, nothing to configure, nothing to manage. You get a finished site, ready to use."
  }
];
---

<BaseLayout
  title="Custom websites for craftspeople and small businesses | €490, delivered in 7 days - Marc M"
  description="Custom websites for craftspeople, shops and small businesses. Unique design, local SEO, Lighthouse 100. 30+ sites delivered. Free quote within 24h."
  lang="en"
  frPath="/"
  enPath="/en/"
  preloadImages={[
    { href: heroProjects[0]?.img, media: '(max-width: 767px)' },
    { href: heroProjects[1]?.img, media: '(min-width: 768px)' },
  ]}
>
  <SchemaOrg type="person" />
  <SchemaOrg type="localBusiness" />
  <SchemaOrg type="faqPage" data={faqItems} />

  <!-- HERO -->
  <section class="relative w-full overflow-hidden bg-[#0D0D0D]">
    <!-- Blobs -->
    <div class="absolute top-[15%] left-[10%] w-[600px] h-[600px] rounded-full bg-[var(--color-accent)] blur-[180px] hero-blob" style="--blob-delay: 0s; --blob-opacity: 0.07;"></div>
    <div class="absolute bottom-[5%] right-[5%] w-[500px] h-[500px] rounded-full bg-[#4F46E5] blur-[160px] hero-blob" style="--blob-delay: 0.15s; --blob-opacity: 0.04;"></div>

    <!-- Noise -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

    <div class="relative mx-auto max-w-6xl px-6 pt-16 pb-10 md:pt-14 md:pb-12 lg:pt-16 lg:pb-12 w-full">

      <!-- Text - centered -->
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-[2.5rem] md:text-[3.5rem] lg:text-[4rem] font-bold leading-[1.06] tracking-[-0.035em] text-white hero-reveal">
          Your pro site,<br>
          <span class="hero-accent-text">live in 7 days.</span>
        </h1>

        <p class="mt-4 md:mt-5 text-[15px] md:text-lg text-neutral-400 leading-relaxed max-w-md mx-auto hero-fade" style="--hero-delay: 0.35s;">
          Custom design, visible on Google and AI tools. I handle everything: design, copy, launch. <span class="text-white font-medium">€490.</span>
        </p>
        <p class="mt-3 text-sm text-neutral-500 hero-fade" style="--hero-delay: 0.4s;">100% remote &middot; Clients all over France</p>

        <div class="mt-5 md:mt-7 flex flex-row items-center justify-center gap-3 md:gap-4">
          <a href="/en/order-starter-site/" class="hero-cta group inline-flex items-center justify-center rounded-xl bg-accent px-6 py-3.5 md:px-8 md:py-4 text-[15px] md:text-base font-semibold text-white transition-all duration-300 hover:-translate-y-0.5" data-umami-event="en-hero-cta-click">
            Order - €490
            <svg class="ml-2 h-4 w-4 md:h-5 md:w-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
          <a href="/en/contact/" class="hero-fade inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/[0.03] px-6 py-3.5 md:px-8 md:py-4 text-[15px] md:text-base font-semibold text-white/80 transition-all duration-300 hover:bg-white/[0.07] hover:text-white" style="--hero-delay: 0.5s;">
            Discuss a project
          </a>
        </div>
        <p class="mt-4 hero-fade text-sm text-neutral-500" style="--hero-delay: 0.6s;">
          Not ready yet? <a href="/en/free-audit/" class="text-neutral-400 underline underline-offset-2 hover:text-white transition-colors" data-umami-event="en-hero-audit-gratuit-click">Get a free audit of your online visibility &rarr;</a>
        </p>
      </div>

      <!-- Showcase - Desktop: 3D coverflow / Mobile: scroll -->
      <div class="mt-8 md:mt-6">

        <!-- Desktop coverflow -->
        <div class="hidden md:block hero-showcase" style="perspective: 1400px;">
          <div class="relative mx-auto flex items-end justify-center" style="height: 420px; max-width: 1050px;">
            {heroProjects.slice(0, 3).map((p, i) => (
              <a
                href={`/en/portfolio#${p.id}`}
                class={`hero-card group/card absolute overflow-hidden rounded-2xl border border-white/[0.08] shadow-2xl shadow-black/50 transition-all duration-500 hover:shadow-black/70 ${i === 1 ? 'hero-card-center z-20' : i === 0 ? 'hero-card-left z-10' : 'hero-card-right z-10'}`}
                style={`--card-delay: ${i === 1 ? '0.5' : i === 0 ? '0.65' : '0.8'}s;`}
                data-umami-event="en-hero-project-click"
                data-umami-event-project={p.id}
              >
                <div class="relative overflow-hidden">
                  <img
                    src={p.img}
                    alt={p.name}
                    width={i === 1 ? 520 : 400}
                    height={i === 1 ? 290 : 230}
                    class={`w-full object-cover object-top transition-transform duration-700 group-hover/card:scale-[1.03] ${i === 1 ? 'h-[290px]' : 'h-[230px]'}`}
                    style={`width: ${i === 1 ? '520px' : '400px'};`}
                    loading="eager"
                    fetchpriority={i === 1 ? 'high' : 'auto'}
                  />
                  <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);"></div>
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300 group-hover/card:opacity-100" style="background: rgba(0,0,0,0.3);">
                    <span class="rounded-full bg-white/15 px-5 py-2 text-sm font-medium text-white backdrop-blur-sm border border-white/20">
                      View site &rarr;
                    </span>
                  </div>
                  <div class="absolute inset-x-0 bottom-0 px-4 pb-3">
                    <p class="text-sm font-semibold text-white truncate">{p.name}</p>
                    <p class="text-xs text-white/50 truncate">{p.sub}</p>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Mobile carousel -->
        <div class="md:hidden min-w-0" id="mobile-carousel">
          <div class="relative overflow-hidden rounded-2xl">
            <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-6 z-10" style="background: linear-gradient(to right, #0D0D0D, transparent);"></div>
            <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-6 z-10" style="background: linear-gradient(to left, #0D0D0D, transparent);"></div>
            <div class="mobile-track flex gap-3" id="mobile-track" style="width: max-content;">
              {[...heroProjects, ...heroProjects].map((p, i) => (
                <div
                  class="carousel-item shrink-0 w-[260px] overflow-hidden rounded-xl border border-white/[0.08] shadow-xl shadow-black/40 transition-all duration-300 cursor-pointer relative"
                  data-url={`/en/portfolio#${p.id}`}
                  data-name={p.name}
                >
                  <div class="relative overflow-hidden">
                    <img src={p.img} alt={p.name} width="260" height="146" class="h-[146px] w-full object-cover object-top transition-transform duration-300" loading="eager" fetchpriority={i === 0 ? 'high' : 'auto'} />
                    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 55%);"></div>
                    <div class="absolute inset-x-0 bottom-0 px-3 pb-2.5">
                      <p class="text-sm font-semibold text-white truncate">{p.name}</p>
                      <p class="text-[11px] text-white/50 truncate">{p.sub}</p>
                    </div>
                    <div class="carousel-overlay absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200 pointer-events-none" style="background: rgba(0,0,0,0.45); backdrop-filter: blur(2px);">
                      <a class="pointer-events-auto rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-[#0D0D0D] shadow-lg transition-transform hover:scale-105">
                        View site &rarr;
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <button id="carousel-resume" class="mt-3 mx-auto hidden items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-xs text-white/60 transition-all active:scale-95" type="button">
            <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.841A1.5 1.5 0 004 4.11v11.78a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/></svg>
            Resume scrolling
          </button>
        </div>
      </div>

      <!-- Subtle link -->
      <div class="mt-8 md:mt-10 text-center hero-fade" style="--hero-delay: 1s;">
        <a href="/en/portfolio/" class="inline-flex items-center gap-2 text-sm text-neutral-500 transition-colors hover:text-white/70">
          {totalProjects} projects delivered - view the portfolio
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </section>


  <!-- 100 WEBSITES CHALLENGE -->
  <section class="w-full relative overflow-hidden" style="background: linear-gradient(135deg, #1A1A1A 0%, #111111 100%);">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[200px] rounded-full blur-[120px]" style="background: rgba(232, 108, 71, 0.12);"></div>

    <div class="relative mx-auto max-w-6xl px-6 py-12 md:px-8 md:py-16">
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
        <div class="flex-1 text-center md:text-left">
          <div class="mb-4 inline-flex items-center gap-2.5 rounded-full px-4 py-1.5 text-xs font-semibold uppercase tracking-widest" style="background: rgba(232, 108, 71, 0.12); border: 1px solid rgba(232, 108, 71, 0.25); color: #E86C47;">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75" style="background: #E86C47;"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full" style="background: #E86C47;"></span>
            </span>
            Challenge in progress
          </div>
          <h2 class="mb-3 text-2xl md:text-3xl font-bold text-white leading-tight">
            100 free websites for 100 craftspeople.
            <span class="block text-base md:text-lg font-normal mt-1" style="color: rgba(255,255,255,0.7);">Real. No strings attached.</span>
          </h2>
          <p class="text-sm md:text-base leading-relaxed max-w-xl mx-auto md:mx-0" style="color: rgba(255,255,255,0.75);">
            I'm building 100 free professional websites for craftspeople with no online presence. Design, hosting and domain included for the first year.
          </p>
        </div>

        <div class="flex flex-col items-center gap-5 flex-shrink-0">
          <div class="text-center">
            <div class="flex items-baseline gap-1 justify-center">
              <span class="text-5xl font-extrabold" style="color: #E86C47;">{sitesRealises}</span>
              <span class="text-xl font-bold text-white/70">/{sitesTotal}</span>
            </div>
            <p class="mt-1 text-xs text-white/70 uppercase tracking-widest">sites built</p>
            <div class="mt-3 w-48 bg-white/10 rounded-full h-1.5">
              <div class="h-1.5 rounded-full transition-all duration-1000" style={`width: ${progressPercent === 0 ? 0.5 : progressPercent}%; background: linear-gradient(90deg, #E86C47, #FF8A65);`}></div>
            </div>
          </div>

          <a
            href="/en/100-artisan-websites/"
            class="group inline-flex items-center justify-center gap-2 rounded-xl px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5"
            style="background: linear-gradient(135deg, #E86C47, #D4572F); box-shadow: 0 4px 20px rgba(232, 108, 71, 0.3);"
          >
            Apply now
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a href="/en/100-artisan-websites/" class="text-xs hover:underline" style="color: rgba(255,255,255,0.6);">
            Learn more about the initiative &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM - 2 columns: hook + pain points -->
  <section class="w-full bg-[var(--color-bg-alt)] px-6 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-12 md:grid-cols-[1fr_1.2fr] md:gap-16 items-start">

        <!-- Left - sticky hook -->
        <div class="md:sticky md:top-28">
          <p class="text-[var(--color-accent-text)] font-semibold text-sm tracking-wide uppercase mb-4">The problem</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text)] leading-tight">
            You have a <span class="text-[var(--color-accent-text)]">real craft</span>.
          </h2>
          <p class="mt-3 text-[var(--color-text-muted)] text-lg leading-relaxed">
            Your website should work as hard as you do. And yet...
          </p>
          <div class="mt-8 hidden md:block">
            <p class="text-[var(--color-text-muted)]">
              What if your site became your <span class="font-semibold text-[var(--color-text)]">best salesperson</span>?
            </p>
            <a href="#method" class="mt-3 inline-flex items-center gap-2 text-[var(--color-accent-text)] font-semibold text-sm hover:underline transition-colors">
              See how I work
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
            </a>
          </div>
        </div>

        <!-- Right - pain points -->
        <div class="space-y-4">
          <div class="group rounded-2xl border-l-4 border-l-red-400 bg-white px-6 py-5 shadow-sm transition-all duration-300 hover:shadow-md">
            <h3 class="text-[17px] font-bold text-[var(--color-text)] group-hover:text-red-500 transition-colors">
              Your WordPress site is slow and burning money
            </h3>
            <p class="mt-1.5 text-[var(--color-text-muted)] leading-relaxed text-[15px]">
              Plugins to update, caching that never quite works, hosting bills creeping up. <span class="font-medium text-[var(--color-text)]">3 seconds of load time means 53% of visitors gone.</span>
            </p>
          </div>

          <div class="group rounded-2xl border-l-4 border-l-amber-400 bg-white px-6 py-5 shadow-sm transition-all duration-300 hover:shadow-md">
            <h3 class="text-[17px] font-bold text-[var(--color-text)] group-hover:text-amber-600 transition-colors">
              You have no site and you're losing business
            </h3>
            <p class="mt-1.5 text-[var(--color-text-muted)] leading-relaxed text-[15px]">
              Your competitors show up on Google. You don't. <span class="font-medium text-[var(--color-text)]">Every day without a site means revenue walking out the door.</span>
            </p>
          </div>

          <div class="group rounded-2xl border-l-4 border-l-[var(--color-accent)] bg-white px-6 py-5 shadow-sm transition-all duration-300 hover:shadow-md">
            <h3 class="text-[17px] font-bold text-[var(--color-text)] group-hover:text-[var(--color-accent-text)] transition-colors">
              Your site is generic and feels nothing like you
            </h3>
            <p class="mt-1.5 text-[var(--color-text-muted)] leading-relaxed text-[15px]">
              Template seen a thousand times, stock colours, zero personality. <span class="font-medium text-[var(--color-text)]">Visitors leave without remembering a thing about you.</span>
            </p>
          </div>
        </div>

      </div>

      <!-- Mobile CTA -->
      <div class="mt-10 text-center md:hidden">
        <p class="text-[var(--color-text-muted)]">
          What if your site became your <span class="font-semibold text-[var(--color-text)]">best salesperson</span>?
        </p>
        <a href="#method" class="mt-3 inline-flex items-center gap-2 text-[var(--color-accent-text)] font-semibold text-sm hover:underline transition-colors">
          See how I work
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF -->
  <section class="w-full bg-white px-6 py-24 md:px-8 md:py-32">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center text-3xl md:text-4xl font-bold text-[var(--color-text)] mb-4">It works</h2>
      <p class="text-center text-[var(--color-text-muted)] mb-16 text-lg">Numbers, not promises.</p>
      <div class="grid gap-12 md:grid-cols-3">
        <div class="text-center">
          <div class="mb-3 text-6xl font-bold text-[var(--color-accent-text)]"><span class="count-up" data-target={totalProjects}>{totalProjects}</span><span class="text-3xl">+</span></div>
          <p class="text-[var(--color-text-muted)]">Projects delivered and live</p>
        </div>
        <div class="text-center">
          <div class="mb-3 text-4xl font-bold text-[var(--color-accent-text)]">7<span class="text-2xl">d</span></div>
          <p class="text-[var(--color-text-muted)]">Average delivery time, brief to launch</p>
        </div>
        <div class="text-center">
          <div class="mb-3 text-6xl font-bold text-[var(--color-accent-text)]">100<span class="text-3xl">%</span></div>
          <p class="text-[var(--color-text-muted)]">Client satisfaction rate</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GOOGLE REVIEWS - pulled from projects.ts -->
  <section class="w-full bg-[var(--color-bg-alt)] px-6 py-24 md:px-8 md:py-32">
    <div class="mx-auto max-w-5xl">
      <div class="mb-6 text-center">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-[var(--color-accent-text)]">Google Reviews</p>
        <h2 class="text-3xl font-bold text-[var(--color-text)] md:text-4xl">Clients who trust me</h2>
        <p class="mt-3 text-sm text-[var(--color-text-muted)]">Reviews shown in the original French. Hover or translate if needed.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 mt-10">
        {reviewProjects.map((p) => (
          <a href={`/en/portfolio#${p.id}`} class="rounded-2xl border border-[var(--color-border)] bg-white p-7 shadow-sm flex flex-col transition-all hover:shadow-md hover:-translate-y-0.5 group">
            <div class="mb-4 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-accent)] text-sm font-bold text-white">{p.review!.author[0]}</div>
                <div>
                  <p class="font-semibold text-[var(--color-text)]">{p.review!.author}</p>
                  <p class="text-xs text-[var(--color-text-muted)]">{p.review!.role} &middot; March 2026</p>
                </div>
              </div>
