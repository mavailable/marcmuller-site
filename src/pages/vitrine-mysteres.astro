        </div>

        <!-- Email -->
        <div>
          <label for="vm-email" class="block text-sm font-medium mb-1.5" style="color: rgba(255,255,255,0.7);">Votre email *</label>
          <input type="email" id="vm-email" name="email" placeholder="vous@exemple.fr" required class="w-full px-4 py-3.5 rounded-xl text-white placeholder:text-neutral-600 focus:outline-none transition-colors" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);" onfocus="this.style.borderColor='#E86C47'" onblur="this.style.borderColor='rgba(255,255,255,0.12)'" />
        </div>

        <!-- Prénom + Activité -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="vm-prenom" class="block text-sm font-medium mb-1.5" style="color: rgba(255,255,255,0.7);">Prénom</label>
            <input type="text" id="vm-prenom" name="prenom" placeholder="Marc" class="w-full px-4 py-3.5 rounded-xl text-white placeholder:text-neutral-600 focus:outline-none transition-colors" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);" onfocus="this.style.borderColor='#E86C47'" onblur="this.style.borderColor='rgba(255,255,255,0.12)'" />
          </div>
          <div>
            <label for="vm-activite" class="block text-sm font-medium mb-1.5" style="color: rgba(255,255,255,0.7);">Activité</label>
            <select id="vm-activite" name="activite" class="w-full px-4 py-3.5 rounded-xl text-white focus:outline-none transition-colors" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);" onfocus="this.style.borderColor='#E86C47'" onblur="this.style.borderColor='rgba(255,255,255,0.12)'">
              <option value="" style="background: #1a1a1a;">Sélectionner</option>
              <option value="Artisan" style="background: #1a1a1a;">Artisan</option>
              <option value="Commerce" style="background: #1a1a1a;">Commerce</option>
              <option value="Therapeute" style="background: #1a1a1a;">Thérapeute</option>
              <option value="Restaurant" style="background: #1a1a1a;">Restaurant</option>
              <option value="Freelance" style="background: #1a1a1a;">Freelance</option>
              <option value="Association" style="background: #1a1a1a;">Association</option>
              <option value="Autre" style="background: #1a1a1a;">Autre</option>
            </select>
          </div>
        </div>

        <!-- Formule -->
        <div>
          <label class="block text-sm font-medium mb-3" style="color: rgba(255,255,255,0.7);">Formule</label>
          <div class="grid grid-cols-3 gap-3">
            <label class="relative flex flex-col items-center justify-center gap-1 px-3 py-4 rounded-xl cursor-pointer transition-all duration-200 has-[:checked]:border-[var(--color-accent)] has-[:checked]:bg-[rgba(232,108,71,0.08)]" style="background: rgba(255,255,255,0.04); border: 2px solid rgba(255,255,255,0.1);">
              <input type="radio" name="formule" value="Gratuit (5 visiteurs)" checked class="sr-only" />
              <span class="text-sm font-semibold text-white">Gratuit</span>
              <span class="text-[10px]" style="color: rgba(255,255,255,0.35);">5 visiteurs</span>
            </label>
            <label class="relative flex flex-col items-center justify-center gap-1 px-3 py-4 rounded-xl cursor-pointer transition-all duration-200 has-[:checked]:border-[var(--color-accent)] has-[:checked]:bg-[rgba(232,108,71,0.08)]" style="background: rgba(255,255,255,0.04); border: 2px solid rgba(255,255,255,0.1);">
              <input type="radio" name="formule" value="Complet — 90€ HT (20 visiteurs)" class="sr-only" />
              <span class="text-sm font-semibold text-white">90€</span>
              <span class="text-[10px]" style="color: rgba(255,255,255,0.35);">20 visiteurs</span>
            </label>
            <label class="relative flex flex-col items-center justify-center gap-1 px-3 py-4 rounded-xl cursor-pointer transition-all duration-200 has-[:checked]:border-[var(--color-accent)] has-[:checked]:bg-[rgba(232,108,71,0.08)]" style="background: rgba(255,255,255,0.04); border: 2px solid rgba(255,255,255,0.1);">
              <input type="radio" name="formule" value="Pro — 250€ HT (100 visiteurs + appel)" class="sr-only" />
              <span class="text-sm font-semibold text-white">250€</span>
              <span class="text-[10px]" style="color: rgba(255,255,255,0.35);">100 visiteurs</span>
            </label>
          </div>
        </div>

        <!-- RGPD -->
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" name="rgpd" required class="mt-1 rounded" style="accent-color: #E86C47;" />
          <span class="text-xs" style="color: rgba(255,255,255,0.35);">
            J'accepte que mes données soient utilisées pour générer mon rapport. <a href="/politique-confidentialite" class="underline hover:text-white transition-colors">Politique de confidentialité</a>
          </span>
        </label>

        <button type="submit" class="w-full px-8 py-4 rounded-xl text-base font-semibold text-white transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5" style="background: linear-gradient(135deg, #E86C47, #D4572F); box-shadow: 0 4px 20px rgba(232, 108, 71, 0.4);">
          Lancer mes Vitrines Mystères
        </button>

        <p class="text-center text-xs" style="color: rgba(255,255,255,0.25);">
          Sans engagement. Rapport confidentiel sous 48h.
        </p>
      </form>
    </div>
  </section>

