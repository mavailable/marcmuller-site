      <h2 class="text-3xl md:text-4xl font-bold leading-tight tracking-[-0.02em] text-center text-white mb-3">
        Lancez votre Vitrines Mystères
      </h2>
      <p class="text-center mb-10" style="color: rgba(255,255,255,0.4);">
        Remplissez le formulaire. Résultats sous 48h.
      </p>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="space-y-5"
      >
        <input type="hidden" name="access_key" value="dccda1f5-4e63-4b9f-9c66-f5ce76f0dfdd" />
        <input type="text" name="botcheck" style="display: none;" />
        <input type="hidden" name="redirect" value="https://marcm.fr/merci" />
        <input type="hidden" name="subject" value="Vitrines Mysteres — Nouvelle demande" />
        <input type="hidden" name="from_name" value="Vitrines Mysteres — marcm.fr" />

        <!-- URL -->
