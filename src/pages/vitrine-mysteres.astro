  <!-- ═══════════════════ FORMULAIRE ═══════════════════ -->
  <section id="formulaire" class="w-full px-6 py-20 md:px-8 md:py-28 overflow-hidden" style="background: #0A0A0A;">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(232,108,71,0.12) 0%, transparent 70%);"></div>
