---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX + Technique — Studio Salvucci | Marc M';
const description = 'Audit du site studiosalvucci.fr : 10 personas simulees, scores securite, SEO, Schema.org — rapport avec recommandations priorisees.';

// ─── DONNEES PROSPECT ───
const prospect = {
  name: 'Studio Salvucci',
  url: 'https://studiosalvucci.fr',
  date: '29 mars 2026',
  activity: 'Photographe portraitiste & mariage a Metz',
  location: '55 rue des Volontaires, 57950 Montigny-les-Metz',
  avis: 303,
};

// ─── KPIs ───
const kpis = {
  conversion: 30,
  experience: 5.3,
  confiance: 5.8,
  clarte: 4.4,
  convertissent: 3,
  hesitent: 4,
  quittent: 3,
};

// ─── CONSTAT ───
const constat = "Aurelien Salvucci est finaliste national (Objectif d'Or 2025) avec 303 avis Google — mais son site ne le dit nulle part : pas de prix mariage, pas d'avis visibles, pas de formulaire contact, securite grade D.";

// ─── CONVERSION PAR CANAL ───
const conversionByCanal = [
  { canal: 'Bouche-a-oreille', taux: 67, color: 'text-green-600', bg: 'bg-green-500' },
  { canal: 'Google Maps', taux: 50, color: 'text-amber-600', bg: 'bg-amber-500' },
  { canal: 'IA (ChatGPT / Claude)', taux: 50, color: 'text-amber-600', bg: 'bg-amber-500' },
  { canal: 'Google Search', taux: 33, color: 'text-amber-600', bg: 'bg-amber-500' },
  { canal: 'Reseaux sociaux (Instagram)', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
];

// ─── TOP 5 FRICTIONS ───
const topFrictions = [
  { titre: 'Pas de prix mariage (ni fourchette)', count: 7, detail: 'La question numero 1 de tout prospect mariage reste sans reponse — les concurrents transparents gagnent automatiquement la comparaison.' },
  { titre: 'Pas de temoignages visibles sur le site', count: 6, detail: '303 avis Google non valorises = preuve sociale inexploitee. Un simple bandeau "5/5 etoiles, 303 avis" changerait tout.' },
  { titre: 'Pas de formulaire de contact', count: 6, detail: 'La page contact ne propose que l\'email et le telephone. Pas de formulaire = barriere a l\'entree pour les profils qui n\'aiment pas appeler.' },
  { titre: 'Galerie / portfolio difficile a trouver', count: 5, detail: 'Un photographe doit montrer son travail immediatement. Les visiteurs cherchent la galerie et ne la trouvent pas d\'emblee.' },
  { titre: 'Mixed content (images HTTP dans page HTTPS)', count: 4, detail: 'Certaines images se chargent en HTTP — certains navigateurs les bloquent, creant des zones vides inexplicables pour les visiteurs.' },
];

// ─── AUDIT TECHNIQUE ───
const pagespeed = {
  mobile: { performance: 52, accessibility: 80, bestPractices: 72, seo: 85 },
  desktop: { performance: 71, accessibility: 82, bestPractices: 75, seo: 88 },
};
const coreWebVitals = [
  { name: 'LCP estimé (mobile)', value: '3.8s', status: 'warning' },
  { name: 'TTFB mesure', value: '178ms', status: 'good' },
  { name: 'JS files homepage', value: '22 fichiers', status: 'bad' },
  { name: 'Taille HTML', value: '371 KB', status: 'bad' },
];
const observatory = { grade: 'D', score: 30, testsPassed: 5, testsTotal: 10 };
const techChecks = [
  { label: 'HTTPS actif et redirection HTTP', present: true },
  { label: 'Meta title optimise (57 chars)', present: true },
  { label: 'Meta description presente', present: true },
  { label: 'H1 unique par page', present: true },
  { label: 'Alt textes images (0 manquant sur 47)', present: true },
  { label: 'Sitemap XML accessible', present: true },
  { label: 'robots.txt configuré', present: true },
  { label: 'Schema.org LocalBusiness present', present: true },
  { label: 'Open Graph complet', present: true },
  { label: 'HSTS (Strict-Transport-Security)', present: false, critical: true },
  { label: 'X-Frame-Options (anti-clickjacking)', present: false, critical: true },
  { label: 'X-Content-Type-Options', present: false, critical: true },
  { label: 'Schema aggregateRating (303 avis)', present: false, critical: true },
  { label: 'Schema telephone valide (+33...)', present: false },
  { label: 'Mixed content corrige (images HTTP)', present: false, critical: true },
  { label: 'Image OG format 1200x630', present: false },
];

// ─── PERSONAS ───
const personas = [
  {
    id: 1, name: 'Lea', age: 32, emoji: '👨‍👩‍👧',
    canal: 'Google Search', device: 'Mobile', maturite: 'Comparaison',
    situation: 'Mere de famille, infirmiere a Metz, cherche cadeau Noel pour mari',
    contexte: 'Tape "photographe famille metz" sur Google, compare 3 studios simultanement depuis son telephone entre deux gardes',
    parcours: ['Accueil', 'Portraits > Famille', 'Bon cadeau', 'Contact'],
    decision: 'hesite',
    scores: { exp: 5, conf: 6, clarte: 4 },
    premierImpression: "Page d'accueil sobre et professionnelle. Photos de famille immediatement visibles. Cherche instinctivement un tarif ou une section 'Nos offres'.",
    questionCle: "C'est combien une seance famille ? Je veux un bon cadeau pour Noel.",
    reponse: 'Partiellement',
    commentReponse: "Le bon cadeau existe mais sans montant affiche — impossible de budgeter le cadeau",
    impactTechnique: "22 fichiers JS ralentissent le chargement mobile : elle attend 4-5 secondes entre chaque page",
    pointsPositifs: ["303 avis Google reperes depuis la fiche GBP = confiance etablie", "Photos de famille belles et naturelles", "Adresse Montigny visible = 10 min de chez elle"],
    frictions: ["Aucun prix affiché sur le bon cadeau ni sur la seance famille", "Pas de temoignages visibles pour rassurer sur l'experience", "Pas de formulaire — doit envoyer un email ou appeler"],
  },
  {
    id: 2, name: 'Thomas', age: 28, emoji: '💼',
    canal: 'Instagram', device: 'Mobile', maturite: 'Decouverte',
    situation: 'Assistant RH a Metz, vient d\'etre promu, veut une photo LinkedIn professionnelle',
    contexte: 'A vu un Reel Studio Salvucci sur Instagram, a toque le profil, arrive sur le site',
    parcours: ['Accueil', 'Portraits > Portrait Pro', 'Contact'],
    decision: 'convertit',
    scores: { exp: 7, conf: 8, clarte: 7 },
    premierImpression: "Les portraits LinkedIn sont immediatement visibles. Prix 79-129€ affiches clairement. Budget OK. Professionnel reassurant.",
    questionCle: "Vous faites des photos LinkedIn ? C'est combien ?",
    reponse: 'Oui',
    commentReponse: "Prix 79-129€ affiches, page dedicee portrait pro existante",
    impactTechnique: "Chargement Instagram in-app un peu lent mais tolere car le prix repondu immediatement",
    pointsPositifs: ["Prix portrait pro affiches clairement (79-129€)", "Badge Objectif d'Or 2025 et FFPMI visible sur la page", "Exemples LinkedIn portraits convaincants"],
    frictions: ["Pas de systeme de reservation en ligne (doit appeler ou ecrire)", "Pas d'info sur la duree de la seance"],
  },
  {
    id: 3, name: 'Marie-Christine', age: 68, emoji: '🎁',
    canal: 'Bouche-a-oreille', device: 'Tablette', maturite: 'Decision',
    situation: 'Retraitee, son amie lui a recommande le studio pour un cadeau Noel pour ses enfants',
    contexte: 'A note l\'URL sur un post-it. Tape l\'adresse sur sa tablette le soir au salon.',
    parcours: ['Accueil', 'Services', 'Bon cadeau', 'Contact (telephone)'],
    decision: 'convertit',
    scores: { exp: 6, conf: 8, clarte: 5 },
    premierImpression: "Le site lui parait 'serieux et joli'. Elle cherche 'les bons cadeaux' qu'on lui a parle. Les trouve rapidement.",
    questionCle: "Comment je commande un bon cadeau ? C'est combien ?",
    reponse: 'Partiellement',
