  },
  {
    id: 8, name: 'Patrick', age: 55, emoji: '🎭',
    canal: 'Bouche-a-oreille', device: 'Desktop', maturite: 'Decision',
    situation: 'Vient de la part d\'un collegue pour faire restaurer des photos de famille anciennes abimees',
    contexte: 'Son collegue lui a conseille le studio pour la restauration. Cherche le service directement.',
    parcours: ['Accueil', 'Services', 'Restauration', 'Contact'],
    decision: 'convertit',
    scores: { exp: 6, conf: 7, clarte: 6 },
    premierImpression: "Trouve la page restauration. L'exemple avant/apres est convainquant. Recommandation collegue + preuve visuelle = decision rapide.",
    questionCle: "Vous pouvez restaurer des vieilles photos tres abimees ? C'est combien ?",
    reponse: 'Partiellement',
    commentReponse: "Le service existe avec demo avant/apres mais pas de prix indiques",
    impactTechnique: "Desktop, chargement acceptable. Tolere l'absence de prix car decision prise avant d'arriver.",
    pointsPositifs: ["Exemple avant/apres concret et impressionnant", "Service clairement decrit", "Telephone visible — appelle pour le devis"],
