    frictions: ["Pas de precision 'sans rendez-vous accepte' ou 'sur RDV uniquement'", "Pas de systeme de reservation en ligne pour eviter l'attente"],
  },
  {
    id: 10, name: 'Lucas', age: 38, emoji: '🤖',
    canal: 'IA (Claude / Perplexity)', device: 'Desktop', maturite: 'Comparaison',
