// ─── AMELIORATIONS ───
const ameliorationsCritiques = [
  {
    titre: 'Ajouter les tarifs mariage (au moins une fourchette)',
    detail: '7 personas sur 10 buttent sur cette absence. Les concurrents qui affichent "a partir de 1500€" captent les comparateurs actifs. Une fourchette suffit.',
    action: 'Ajouter sur la page /mariages/ : "Tarifs a partir de X€ — devis personnalise gratuit" avec un bouton de contact direct.',
  },
  {
    titre: 'Valeur de securite : headers HTTP manquants',
    detail: 'Grade D (30/100) a l\'Observatory MDN. HSTS, X-Frame-Options et X-Content-Type-Options absents — le site est vulnerable au clickjacking et au MIME sniffing.',
    action: 'Ajouter les headers dans le .htaccess ou via le plugin WordPress "Security Headers". Correction < 30 min.',
  },
  {
    titre: 'Integrer les 303 avis Google en preuve sociale visible',
    detail: '303 avis = ressource immense non exploitee. Aucun visiteur ne voit cette social proof en arrivant sur le site.',
    action: 'Ajouter un bandeau "5 etoiles — 303 avis Google" en hero et footer. Widget Elfsight ou simple extrait HTML.',
  },
];
const ameliorationsUtiles = [
  {
    titre: 'Ajouter un formulaire de contact integre aux pages services',
    detail: 'La page contact ne propose que l\'email et le telephone. Un formulaire simple reduirait la friction pour les prospects qui n\'aiment pas appeler.',
  },
  {
    titre: 'Corriger le mixed content (images HTTP dans HTTPS)',
    detail: 'Plusieurs images sont servies en http:// — bloquees par certains navigateurs, penalisent le score securite et creent des zones vides.',
