    pointsPositifs: ["Certifie FFPMI et Objectif d'Or = credibilite pour une PME", "Page portrait pro professionnelle et explicite", "Background ingenieur parle a un profil technique"],
    frictions: ["Pas de tarif equipe / volume", "Pas de reference client entreprise visible", "Pas de portfolio portrait equipe / corporate"],
  },
  {
    id: 7, name: 'Amira', age: 31, emoji: '🤰',
    canal: 'Instagram', device: 'Mobile', maturite: 'Decouverte',
    situation: 'Enceinte de 6 mois, a vu une belle photo de grossesse sur Instagram, veut une seance',
