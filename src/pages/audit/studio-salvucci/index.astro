    questionCle: "C'est combien un reportage mariage ? Combien de photos livrees ?",
    reponse: 'Non',
    commentReponse: "Aucun prix affiché, aucune info sur le nombre de photos — doit demander un devis",
    impactTechnique: "Sur desktop le site est acceptable en performance mais l'absence d'info cree une frustration cognitive",
    pointsPositifs: ["Style mariage naturel et authentique correspond exactement", "Finaliste Objectif d'Or 2025 = credibilite nationale", "Zone Lorraine/Luxembourg couverte"],
    frictions: ["Aucun tarif mariage ni fourchette — les 3 concurrents comparés affichent au moins '1500€ a partir de'", "Pas d'info sur le nombre de photos ou le format de livraison", "Galerie mariage difficile a trouver en navigation", "Pas de temoignages de couples maries"],
  },
  {
    id: 6, name: 'Julien', age: 42, emoji: '📸',
    canal: 'Google Search', device: 'Desktop', maturite: 'Comparaison',
    situation: 'Directeur regional PME, cherche photographe pour portraits equipe de 15 personnes',
    contexte: 'Cherche "photographe corporate metz portrait equipe", trouve Studio Salvucci',
    parcours: ['Accueil', 'Portraits > Portrait Pro', 'A propos', 'Contact'],
    decision: 'hesite',
    scores: { exp: 5, conf: 6, clarte: 4 },
    premierImpression: "Page portrait pro existe. Tarif 79-129€ vu. Pour 15 personnes, cherche un tarif groupe et references corporate.",
    questionCle: "Vous faites des portraits corporate equipe ? Tarif pour 15 personnes ?",
