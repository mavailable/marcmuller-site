    impactTechnique: "Tablette wifi, site un peu lent mais patiente",
    pointsPositifs: ["Recommandation amie = confiance totale", "Telephone bien visible, appelle sans hesiter", "Horaires affiches — sait quand appeler"],
    frictions: ["Prix bon cadeau absent = doit appeler pour savoir", "Pas de commande en ligne du bon cadeau"],
  },
  {
    id: 4, name: 'Rayan', age: 24, emoji: '🛂',
    canal: 'Google Maps', device: 'Mobile', maturite: 'Decouverte',
    situation: 'Etudiant marocain a Metz, besoin photo identite pour visa USA pour stage',
    contexte: 'Cherche "photo identite metz" sur Google Maps, voit Studio Salvucci avec 303 avis et 4.9 etoiles',
    parcours: ['Fiche Google Maps', 'Photos ID > USA', 'Contact'],
    decision: 'convertit',
    scores: { exp: 8, conf: 9, clarte: 9 },
    premierImpression: "La page photos identite USA est exactement ce qu'il cherche. Prix 15€ affiches immediatement. Format USA explicite.",
    questionCle: "Photo identite format USA pour visa ESTA ? C'est combien ?",
