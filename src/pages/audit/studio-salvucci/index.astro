---

<BaseLayout {title} {description} noindex={true} lang="fr" frPath="/audit/studio-salvucci">
  <!-- Hero impact -->
  <section class="bg-neutral-900 text-white py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-4">Rapport personnalise</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2">{prospect.name} — ce que vos visiteurs pensent vraiment</h1>
      <p class="text-neutral-400 mb-2">{prospect.activity} — <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener">{prospect.url}</a></p>
      <p class="text-neutral-500 text-sm mb-6">{prospect.location} &mdash; {prospect.avis} avis Google &mdash; analyse du {prospect.date}</p>
      <div class="grid grid-cols-3 gap-4 max-w-lg">
        <div class="text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.conversion}%</span>
          <span class="text-xs text-neutral-400">convertissent</span>
        </div>
        <div class="text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.experience}/10</span>
          <span class="text-xs text-neutral-400">experience</span>
        </div>
        <div class="text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.confiance}/10</span>
          <span class="text-xs text-neutral-400">confiance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Le constat -->
  <section class="py-10 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-amber-900 font-medium">{constat}</p>
      </div>

      <!-- Conversion par canal -->
      <div class="mb-8">
        <h3 class="text-sm font-semibold text-neutral-500 uppercase tracking-wider mb-4">Conversion par canal d'arrivee</h3>
        <div class="space-y-3">
          {conversionByCanal.map(item => (
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-neutral-700">{item.canal}</span>
                <span class={`text-sm font-bold ${item.color}`}>{item.taux}%</span>
              </div>
              <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
                <div class={`h-full rounded-full ${item.bg}`} style={`width: ${item.taux}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Top frictions -->
      <div>
        <h3 class="text-sm font-semibold text-neutral-500 uppercase tracking-wider mb-4">Top 5 frictions identifies</h3>
        <ol class="space-y-4">
          {topFrictions.map((f, i) => (
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-7 h-7 rounded-full bg-red-100 text-red-700 text-sm font-bold flex items-center justify-center">{i + 1}</span>
              <div>
                <p class="font-semibold text-neutral-800 text-sm">{f.titre} <span class="text-neutral-400 font-normal">({f.count}/10 personas)</span></p>
                <p class="text-neutral-600 text-xs mt-0.5">{f.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Section Audit technique -->
  <section class="py-10 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">L'audit technique</h2>

      <!-- PageSpeed scores -->
      <div class="mb-8">
        <h3 class="text-sm font-semibold text-neutral-500 uppercase tracking-wider mb-4">Scores Lighthouse (estimation)</h3>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-white rounded-xl p-4 border border-neutral-200">
            <p class="text-xs font-semibold text-neutral-500 mb-4 uppercase">Mobile</p>
            <div class="grid grid-cols-4 gap-2">
              {[
                { label: 'Perf.', score: pagespeed.mobile.performance },
                { label: 'Access.', score: pagespeed.mobile.accessibility },
                { label: 'Pratiques', score: pagespeed.mobile.bestPractices },
                { label: 'SEO', score: pagespeed.mobile.seo },
              ].map(s => {
                const color = s.score >= 90 ? '#22c55e' : s.score >= 50 ? '#f59e0b' : '#ef4444';
                const textColor = s.score >= 90 ? 'text-green-600' : s.score >= 50 ? 'text-amber-600' : 'text-red-600';
                return (
                  <div class="text-center">
                    <div class="relative w-14 h-14 mx-auto mb-1">
                      <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
                        <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e5e7eb" stroke-width="3" />
                        <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke={color} stroke-width="3" stroke-dasharray={`${s.score}, 100`} stroke-linecap="round" />
                      </svg>
                      <span class={`absolute inset-0 flex items-center justify-center text-sm font-bold ${textColor}`}>{s.score}</span>
                    </div>
                    <p class="text-[10px] text-neutral-600">{s.label}</p>
                  </div>
                );
              })}
            </div>
          </div>
          <div class="bg-white rounded-xl p-4 border border-neutral-200">
            <p class="text-xs font-semibold text-neutral-500 mb-4 uppercase">Desktop</p>
            <div class="grid grid-cols-4 gap-2">
              {[
                { label: 'Perf.', score: pagespeed.desktop.performance },
                { label: 'Access.', score: pagespeed.desktop.accessibility },
                { label: 'Pratiques', score: pagespeed.desktop.bestPractices },
                { label: 'SEO', score: pagespeed.desktop.seo },
              ].map(s => {
                const color = s.score >= 90 ? '#22c55e' : s.score >= 50 ? '#f59e0b' : '#ef4444';
                const textColor = s.score >= 90 ? 'text-green-600' : s.score >= 50 ? 'text-amber-600' : 'text-red-600';
                return (
                  <div class="text-center">
                    <div class="relative w-14 h-14 mx-auto mb-1">
                      <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
                        <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e5e7eb" stroke-width="3" />
                        <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke={color} stroke-width="3" stroke-dasharray={`${s.score}, 100`} stroke-linecap="round" />
                      </svg>
                      <span class={`absolute inset-0 flex items-center justify-center text-sm font-bold ${textColor}`}>{s.score}</span>
                    </div>
                    <p class="text-[10px] text-neutral-600">{s.label}</p>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
        <p class="text-xs text-neutral-400 mt-2">* Scores estimes — quota API PageSpeed depasse au moment de l'audit. A re-verifier via pagespeed.web.dev</p>
      </div>

      <!-- Core Web Vitals + Observatory -->
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        <div class="bg-white rounded-xl p-4 border border-neutral-200">
          <h3 class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-3">Indicateurs mesures</h3>
          <div class="space-y-2">
            {coreWebVitals.map(v => (
              <div class="flex items-center justify-between">
                <span class="text-sm text-neutral-700">{v.name}</span>
                <span class={`text-sm font-semibold ${v.status === 'good' ? 'text-green-600' : v.status === 'warning' ? 'text-amber-600' : 'text-red-600'}`}>{v.value}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-neutral-200">
          <h3 class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-3">Securite (Mozilla Observatory)</h3>
          <div class="flex items-center gap-4 mb-3">
            <span class="text-5xl font-black text-red-600">{observatory.grade}</span>
            <div>
              <p class="text-sm font-semibold text-neutral-800">{observatory.score}/100</p>
              <p class="text-xs text-neutral-500">{observatory.testsPassed}/{observatory.testsTotal} tests passes</p>
              <p class="text-xs text-red-600 mt-1">Headers HSTS, X-Frame, X-Content-Type manquants</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Checklist SEO / Schema / OG -->
      <div class="bg-white rounded-xl p-4 border border-neutral-200">
        <h3 class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-3">Checklist SEO, Schema.org & Open Graph</h3>
        <div class="grid sm:grid-cols-2 gap-1">
          {techChecks.map(check => (
            <div class={`flex items-start gap-2 py-1.5 px-2 rounded ${!check.present && check.critical ? 'bg-red-50' : ''}`}>
              <span class={`text-sm mt-0.5 flex-shrink-0 ${check.present ? 'text-green-600' : check.critical ? 'text-red-600' : 'text-amber-600'}`}>
                {check.present ? '✓' : '✗'}
              </span>
              <span class={`text-xs ${check.present ? 'text-neutral-700' : check.critical ? 'text-red-700 font-medium' : 'text-amber-700'}`}>{check.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Section Vos visiteurs -->
  <section class="py-10 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
      <p class="text-neutral-600 mb-6">
        Sur 10 visiteurs simules : <strong class="text-green-700">{kpis.convertissent} contactent</strong>, <strong class="text-amber-700">{kpis.hesitent} hesitent</strong>, <strong class="text-neutral-700">{kpis.quittent} repartent</strong>.
        Experience moyenne : <strong>{kpis.experience}/10</strong> — Confiance : <strong>{kpis.confiance}/10</strong> — Clarte : <strong>{kpis.clarte}/10</strong>.
      </p>
      <div class="space-y-3">
        {personas.map(p => {
          const decisionLabel = p.decision === 'convertit' ? 'Contacte' : p.decision === 'hesite' ? 'Hesite' : 'Repart';
          const borderColor = p.decision === 'convertit' ? 'border-green-200' : p.decision === 'hesite' ? 'border-amber-200' : 'border-neutral-200';
          const bgColor = p.decision === 'convertit' ? 'bg-green-50/40' : p.decision === 'hesite' ? 'bg-amber-50/40' : 'bg-neutral-50/40';
          const badgeColor = p.decision === 'convertit' ? 'text-green-700 bg-green-100' : p.decision === 'hesite' ? 'text-amber-700 bg-amber-100' : 'text-neutral-700 bg-neutral-100';
          const borderColorInner = p.decision === 'convertit' ? 'border-green-200' : p.decision === 'hesite' ? 'border-amber-200' : 'border-neutral-200';
          return (
            <details class={`group border ${borderColor} ${bgColor} rounded-xl overflow-hidden`}>
              <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                    <h3 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h3>
                    <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                    <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                    <span class="text-[11px] text-purple-600 bg-purple-50 px-1.5 py-0.5 rounded">{p.maturite}</span>
                    <span class={`text-[11px] font-semibold px-1.5 py-0.5 rounded ${badgeColor}`}>{decisionLabel}</span>
                  </div>
                  <p class="text-xs text-neutral-500">{p.situation}</p>
                </div>
                <svg class="w-5 h-5 text-neutral-400 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class={`px-4 pb-4 pt-0 border-t ${borderColorInner} bg-white/50`}>
                <div class="grid gap-3 text-xs mt-3">
                  <div>
                    <p class="font-semibold text-neutral-700 mb-1">Contexte d'arrivee</p>
                    <p class="text-neutral-600">{p.contexte}</p>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-700 mb-1">Parcours</p>
                    <p class="text-neutral-500">{p.parcours.join(' → ')}</p>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-700 mb-1">Premiere impression</p>
                    <p class="text-neutral-600">{p.premierImpression}</p>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-700 mb-1">Question cle</p>
                    <p class="text-neutral-600 italic">"{p.questionCle}"</p>
                    <p class="text-neutral-600 mt-1">Reponse du site : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-700' : 'text-amber-700'}>{p.reponse}</strong> — {p.commentReponse}</p>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-700 mb-1">Impact technique</p>
                    <p class="text-neutral-600">{p.impactTechnique}</p>
                  </div>
                  <div class="flex gap-4">
                    <div class="flex-1">
                      <p class="font-semibold text-green-700 mb-1">Points positifs</p>
                      <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                        {p.pointsPositifs.map(pt => <li>{pt}</li>)}
                      </ul>
                    </div>
                    <div class="flex-1">
                      <p class="font-semibold text-amber-700 mb-1">Frictions</p>
                      <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                        {p.frictions.map(f => <li>{f}</li>)}
                      </ul>
                    </div>
                  </div>
                  <div class="flex gap-4 pt-1 border-t border-neutral-100">
                    <div class="text-center">
                      <span class={`text-base font-black ${p.scores.exp >= 7 ? 'text-green-600' : p.scores.exp >= 5 ? 'text-amber-600' : 'text-red-600'}`}>{p.scores.exp}/10</span>
                      <p class="text-neutral-400 text-[10px]">Experience</p>
                    </div>
                    <div class="text-center">
                      <span class={`text-base font-black ${p.scores.conf >= 7 ? 'text-green-600' : p.scores.conf >= 5 ? 'text-amber-600' : 'text-red-600'}`}>{p.scores.conf}/10</span>
                      <p class="text-neutral-400 text-[10px]">Confiance</p>
                    </div>
                    <div class="text-center">
                      <span class={`text-base font-black ${p.scores.clarte >= 7 ? 'text-green-600' : p.scores.clarte >= 5 ? 'text-amber-600' : 'text-red-600'}`}>{p.scores.clarte}/10</span>
                      <p class="text-neutral-400 text-[10px]">Clarte</p>
                    </div>
                  </div>
                </div>
              </div>
            </details>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Section Nos recommandations -->
  <section class="py-10 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Nos recommandations</h2>

      <h3 class="text-sm font-semibold text-red-700 uppercase tracking-wider mb-3">Le plus important</h3>
      <div class="grid gap-4 mb-8">
        {ameliorationsCritiques.map(a => (
          <div class="bg-white border border-red-200 rounded-xl p-5">
            <h4 class="font-semibold text-neutral-900 mb-2">{a.titre}</h4>
            <p class="text-neutral-600 text-sm mb-3">{a.detail}</p>
            <div class="bg-red-50 rounded-lg px-3 py-2">
              <p class="text-red-800 text-xs font-medium">Action concrete : {a.action}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-sm font-semibold text-amber-700 uppercase tracking-wider mb-3">Utile aussi</h3>
      <div class="grid sm:grid-cols-2 gap-4">
        {ameliorationsUtiles.map(a => (
          <div class="bg-white border border-amber-200 rounded-xl p-4">
            <h4 class="font-semibold text-neutral-900 text-sm mb-1">{a.titre}</h4>
            <p class="text-neutral-600 text-xs">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="bg-neutral-900 text-white py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4">
        {kpis.conversion}% de vos visiteurs vous contactent.<br/>
        <span class="text-amber-400">On peut faire beaucoup mieux.</span>
      </h2>
      <p class="text-neutral-300 mb-8 max-w-xl mx-auto">
        Ce rapport identifie des opportunites concretes. Je construis des sites qui convertissent vraiment — a partir de 990€, livre en 7 jours.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/commander" class="inline-flex items-center gap-2 px-8 py-3.5 bg-[var(--color-accent-500)] text-white font-semibold rounded-xl hover:opacity-90 transition-all shadow-md">
          Je veux un site qui convertit
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-3.5 border border-neutral-600 text-neutral-300 font-semibold rounded-xl hover:border-amber-400 hover:text-amber-400 transition-all">
          En discuter d'abord
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
