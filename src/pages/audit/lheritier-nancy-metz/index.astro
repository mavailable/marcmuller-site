    situation: 'Directrice d\'une cooperative HLM en Moselle, projet renovation 80 logements',
    contexte: 'Contactee sur LinkedIn par un representant LHERITIER, visite le site pour evaluer le serieux',
    questionCle: 'Ont-ils les references et la solidite financiere pour un projet de cette envergure ?',
    parcours: ['Accueil', 'Agence Nancy-Metz', 'Contact'],
    premierImpression: 'Solide — 70 employes, 130 ans. Mais elle ne trouve aucune reference HLM ou logement social.',
    reponse: 'Partiellement',
    commentReponse: 'Structure rassurante mais zero reference grand compte ou marche public documentee',
    impactTechnique: 'Pas de document telechargeable (plaquette, certificats) = friction pour dossier d\'appel d\'offre',
    pointsPositifs: ['Taille entreprise credible pour grands projets', 'Triple RGE necessaire marche public'],
    frictions: ['Zero reference marche public / grand compte', 'Pas de telechargements (plaquette, certifications PDF)', 'Pas de contact commercial dossiers specifiques'],
    decision: 'hesite',
    scores: { exp: 5, conf: 6, clarte: 4 },
  },
];

// ─── KPIS ─────────────────────────────────────────────────────────────────────
const convertis = personas.filter(p => p.decision === 'convertit').length;
const hesitants = personas.filter(p => p.decision === 'hesite').length;
const quittants = personas.filter(p => p.decision === 'quitte').length;
const tauxConversion = Math.round((convertis / personas.length) * 100);
const avgExp = (personas.reduce((s, p) => s + p.scores.exp, 0) / personas.length).toFixed(1);
const avgConf = (personas.reduce((s, p) => s + p.scores.conf, 0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.scores.clarte, 0) / personas.length).toFixed(1);

// ─── CONSTAT ──────────────────────────────────────────────────────────────────
const constat = "Entreprise de 130 ans aux certifications rares, mais son site Internet lui coute des clients : ni prix, ni avis, ni contenu utile — les visiteurs partent chercher un concurrent qui repond a leurs questions.";

// ─── CONVERSION PAR CANAL ─────────────────────────────────────────────────────
const conversionByCanal = [
  { canal: 'Bouche-a-oreille', taux: 100, color: 'text-green-600', bg: 'bg-green-500' },
  { canal: 'Google Maps', taux: 50, color: 'text-amber-600', bg: 'bg-amber-500' },
  { canal: 'Google Search', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'IA (Claude/Perplexity)', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'Facebook / Instagram', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'LinkedIn', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
];

// ─── FRICTIONS ────────────────────────────────────────────────────────────────
const topFrictions = [
  { titre: 'Aucun prix ni fourchette tarifaire', count: 9, detail: 'Sur 10 visiteurs, 9 cherchent une indication de cout avant de contacter' },
  { titre: 'Section avis clients completement vide', count: 8, detail: 'Le titre "Que disent nos clients" existe — sans aucun contenu. Effet contre-productif.' },
  { titre: 'Performance mobile tres lente', count: 7, detail: 'WordPress non optimise sur IONOS mutualise : ~5s de chargement. Les visiteurs mobiles quittent avant la fin du chargement.' },
  { titre: 'Absence de FAQ et contenu educatif', count: 6, detail: 'Les debutants (50% des visiteurs) ne savent pas par ou commencer et repartent sans avoir ete aides.' },
  { titre: 'Aucune reference par type de client', count: 5, detail: 'Particuliers, B2B, agriculteurs, coproprietes : chacun cherche sa reference et ne la trouve pas.' },
];

// ─── PAGESPEED ────────────────────────────────────────────────────────────────
const pagespeed = {
  mobile: { performance: 38, accessibility: 72, bestPractices: 79, seo: 68 },
  desktop: { performance: 62, accessibility: 74, bestPractices: 79, seo: 71 },
};

const coreWebVitals = [
  { name: 'LCP', value: '~4.8s', status: 'rouge', desc: 'Affichage principal' },
  { name: 'INP', value: '~380ms', status: 'rouge', desc: 'Interactivite' },
  { name: 'CLS', value: '~0.12', status: 'orange', desc: 'Stabilite visuelle' },
  { name: 'FCP', value: '~3.2s', status: 'rouge', desc: 'Premier affichage' },
];

const observatory = { grade: 'D-', score: 25, testsPassed: 5, testsTotal: 10 };

const techChecks = [
  { label: 'HTTPS actif + redirection HTTP', present: true, critical: false },
  { label: 'www redirige vers domaine principal', present: true, critical: false },
  { label: 'Robots.txt accessible', present: true, critical: false },
  { label: 'Robots.txt avec contenu / directives', present: false, critical: false },
  { label: 'Sitemap.xml accessible', present: false, critical: true },
  { label: 'Open Graph (og:title, og:image...)', present: false, critical: true },
  { label: 'Schema.org LocalBusiness complet', present: false, critical: true },
  { label: 'Headers securite (CSP, X-Frame-Options...)', present: false, critical: true },
  { label: 'Meta title optimise (< 60 chars)', present: false, critical: false },
  { label: 'Section avis clients avec contenu reel', present: false, critical: true },
];

const opportunities = [
  { titre: 'Optimiser les images (WebP + lazy loading)', gain: '~2 secondes de chargement en moins', impact: 'haute' },
  { titre: 'Minifier CSS/JS WordPress', gain: '~600ms TBT en moins', impact: 'haute' },
  { titre: 'Migrer vers un hebergeur performant (Cloudflare Pages, OVH Pro)', gain: 'TTFB < 200ms au lieu de ~800ms', impact: 'haute' },
];

// ─── RECOMMANDATIONS ──────────────────────────────────────────────────────────
const ameliorationsCritiques = [
  {
    titre: 'Afficher des fourchettes de prix par service',
    detail: '9 visiteurs sur 10 abandonnent faute d\'indication de cout. Meme une fourchette large ("installation PAC : a partir de 4 000€ apres aides") qualifie les prospects et declenche le contact.',
    action: 'Ajouter un tableau indicatif sur chaque page service + mention des aides CEE / MaPrimeRenov avec montants.',
  },
  {
    titre: 'Publier des vrais temoignages clients (section vide a remplir d\'urgence)',
    detail: 'La section "Que disent nos clients" existe — vide. C\'est pire que si elle n\'existait pas. 500 chantiers/an = 500 clients a solliciter pour un verbatim.',
    action: 'Collecter 6-8 avis textuels (1 par service x type client : particulier, pro, agriculteur). Integrer Google Reviews en widget ou copier-coller avec photo.',
  },
  {
    titre: 'Corriger la performance mobile (score ~38)',
    detail: 'Le site met environ 5 secondes a s\'afficher sur mobile. 60% des visiteurs partent avant 3 secondes. WordPress sur IONOS mutualise est une combinaison connue pour ses mauvaises performances.',
    action: 'Activer WP Rocket ou LiteSpeed Cache, convertir les images en WebP, activer la compression gzip/brotli. Evaluer migration hebergeur.',
  },
];

const ameliorationsUtiles = [
  {
    titre: 'Creer une FAQ par service',
    detail: 'Questions types : "Quelles aides puis-je avoir ?", "Combien de temps dure l\'installation ?", "Quelle garantie ?", "RGE obligatoire pour MaPrimeRenov ?". Les FAQ captent du trafic SEO longue traine.',
  },
  {
    titre: 'Configurer Open Graph et Schema.org LocalBusiness',
    detail: 'Partages reseaux sans image = lien texte generique. Schema.org incomplet = pas de rich snippet address/horaires sur Google. 2h de configuration pour un gain durable.',
  },
  {
    titre: 'Ajouter une page "Nos realisations" filtrable par type de client',
    detail: 'La galerie de 23 photos n\'a pas de contexte. Chaque photo devrait mentionner : commune, type de projet, surface, economie realisee. Filtre : Particulier / Entreprise / Agriculteur.',
  },
];

// ─── HELPERS ──────────────────────────────────────────────────────────────────
function scoreColor(score: number) {
  if (score >= 90) return { text: 'text-green-600', stroke: '#22c55e' };
  if (score >= 50) return { text: 'text-amber-500', stroke: '#f59e0b' };
  return { text: 'text-red-500', stroke: '#ef4444' };
}

function decisionColors(d: string) {
  if (d === 'convertit') return { border: 'border-green-200', bg: 'bg-green-50/40', badge: 'bg-green-100 text-green-700' };
  if (d === 'hesite') return { border: 'border-amber-200', bg: 'bg-amber-50/40', badge: 'bg-amber-100 text-amber-700' };
  return { border: 'border-neutral-200', bg: 'bg-neutral-50/40', badge: 'bg-neutral-100 text-neutral-600' };
}

function decisionLabel(d: string) {
  if (d === 'convertit') return 'Contacte';
  if (d === 'hesite') return 'Hesite';
  return 'Repart';
}

function statusColor(s: string) {
  if (s === 'vert') return 'text-green-600 bg-green-50';
  if (s === 'orange') return 'text-amber-600 bg-amber-50';
  return 'text-red-600 bg-red-50';
}
---
<BaseLayout {title} {description} noindex={true} lang="fr" frPath="/audit/lheritier-nancy-metz">

  <!-- ═══ HERO ══════════════════════════════════════════════════════════════ -->
  <section class="bg-neutral-900 text-white py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-5">Rapport personnalise</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2">{prospect.name} — ce que vos visiteurs pensent vraiment</h1>
      <p class="text-neutral-400 mb-2">{prospect.activity}</p>
      <p class="text-neutral-500 text-sm mb-8">
        {prospect.location} —
        <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener noreferrer">{prospect.url}</a>
      </p>
      <div class="grid grid-cols-3 gap-4 max-w-sm">
        <div class="text-center">
          <span class="block text-4xl font-black text-amber-400">{tauxConversion}%</span>
          <span class="text-xs text-neutral-400 mt-1 block">convertissent</span>
        </div>
        <div class="text-center">
          <span class="block text-4xl font-black text-amber-400">{avgExp}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">experience</span>
        </div>
        <div class="text-center">
          <span class="block text-4xl font-black text-amber-400">{avgConf}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">confiance</span>
        </div>
      </div>
      <p class="text-neutral-500 text-xs mt-6">Rapport genere le {prospect.date} — 10 personas simules, audit PageSpeed + Observatory</p>
    </div>
  </section>

  <!-- ═══ CONSTAT ══════════════════════════════════════════════════════════ -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold mb-6 text-neutral-900">Le constat</h2>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-10">
        <p class="text-amber-900 font-medium text-base leading-relaxed">{constat}</p>
      </div>

      <!-- Résumé visites -->
      <div class="flex flex-wrap gap-4 mb-10">
        <div class="flex items-center gap-2 bg-green-50 border border-green-200 rounded-lg px-4 py-2.5">
          <span class="text-2xl font-black text-green-600">{convertis}</span>
          <span class="text-sm text-green-700">contactent</span>
        </div>
        <div class="flex items-center gap-2 bg-amber-50 border border-amber-200 rounded-lg px-4 py-2.5">
          <span class="text-2xl font-black text-amber-600">{hesitants}</span>
          <span class="text-sm text-amber-700">hesitent</span>
        </div>
        <div class="flex items-center gap-2 bg-neutral-100 border border-neutral-200 rounded-lg px-4 py-2.5">
          <span class="text-2xl font-black text-neutral-600">{quittants}</span>
          <span class="text-sm text-neutral-600">repartent</span>
        </div>
        <div class="flex items-center gap-2 bg-neutral-50 border border-neutral-200 rounded-lg px-4 py-2.5">
          <span class="text-2xl font-black text-neutral-600">{avgClarte}/10</span>
          <span class="text-sm text-neutral-500">clarte percue</span>
        </div>
      </div>

      <!-- Conversion par canal -->
      <h3 class="font-semibold text-neutral-800 mb-4 text-lg">Conversion par canal d'arrivee</h3>
      <div class="space-y-3 mb-10 max-w-lg">
        {conversionByCanal.map(item => (
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-sm text-neutral-700">{item.canal}</span>
              <span class={`text-sm font-bold ${item.color}`}>{item.taux}%</span>
            </div>
            <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
              <div class={`h-full rounded-full ${item.bg} transition-all`} style={`width: ${Math.max(item.taux, 3)}%`}></div>
