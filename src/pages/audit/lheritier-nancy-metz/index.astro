    pointsPositifs: ['Devis gratuit clair', 'Triple RGE = eligible PCAE (aides agricoles)', '130 ans = serieux'],
    frictions: ['Pas de mention batiments agricoles', 'Hangar/photovoltaique absent du vocabulaire', 'Aucun temoignage agriculteur'],
