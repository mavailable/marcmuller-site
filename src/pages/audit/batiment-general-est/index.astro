// ============================================================
// RECOMMANDATIONS
// ============================================================
const ameliorationsCritiques = [
  {
    titre: 'Creer une galerie de realisations avec photos avant/apres',
    detail: '8 personas sur 10 ont cherche des photos de chantiers. C\'est LE manque le plus bloquant. Sans preuves visuelles, l\'artisan ne se differencie pas.',
    action: 'Creer une page /realisations avec 10-15 chantiers categories par service, photos avant/apres, type de bien, ville.',
  },
  {
    titre: 'Integrer les avis Google et afficher les certifications',
    detail: '7 personas ont cherche des preuves sociales. L\'absence d\'avis visibles et de labels (RGE, Qualibat) fait fuir les projets isolation eligibles aux aides.',
    action: 'Integrer Google Reviews widget + afficher labels RGE/assurance decennale en page d\'accueil et pages services isolation/facade.',
  },
  {
    titre: 'Remplacer l\'email Gmail par une adresse professionnelle',
    detail: '5 personas B2B et B2C de decision ont note l\'email Gmail comme signal negatif. Cout : quelques euros/mois pour un email @batiment-general-de-lest.fr.',
    action: 'Migrer vers contact@batiment-general-de-lest.fr — signal de professionnalisme immediat.',
  },
