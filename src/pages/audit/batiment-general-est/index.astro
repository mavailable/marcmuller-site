---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX — Batiment General de l\'Est BGE | Marc M';
const description = 'Simulation de 10 visites personas sur batiment-general-de-lest.fr — rapport UX et technique avec recommandations priorisees.';

// ============================================================
// DONNEES PROSPECT
// ============================================================
const prospect = {
  name: 'Batiment General de l\'Est BGE',
  url: 'https://www.batiment-general-de-lest.fr',
  date: '29 mars 2026',
  activity: 'Macon / Renovation tous corps d\'etat',
  location: 'Metz (57) — Moselle, Grand Est',
};

// ============================================================
// KPIs GLOBAUX
// ============================================================
const kpis = {
  conversion: 30,
  experience: 4.8,
  confiance: 5.1,
  clarte: 4.3,
  convertissent: 3,
  hesitent: 3,
  quittent: 4,
};

const constat = "Un artisan serieux avec 20 ans d'experience dont le site ne montre ni realisations, ni avis clients, ni certifications — les visiteurs ne peuvent pas justifier de lui faire confiance face a la concurrence.";

// ============================================================
// CONVERSION PAR CANAL
// ============================================================
const conversionByCanal = [
  { canal: 'Bouche-a-oreille', taux: 100, color: 'text-green-700', bg: 'bg-green-500' },
  { canal: 'Google Maps / GBP', taux: 50, color: 'text-amber-700', bg: 'bg-amber-500' },
  { canal: 'Google Search', taux: 33, color: 'text-amber-600', bg: 'bg-amber-400' },
  { canal: 'Reseaux sociaux', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'IA (ChatGPT/Claude)', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
];

// ============================================================
// TOP FRICTIONS
// ============================================================
const topFrictions = [
  { titre: 'Aucune galerie de realisations', count: 8, detail: 'Les visiteurs veulent voir du concret avant de demander un devis. Pas une seule photo avant/apres.' },
  { titre: 'Pas d\'avis clients ni de notes', count: 7, detail: 'Aucun temoignage, pas d\'integration Google Reviews. La confiance ne se declare pas, elle se prouve.' },
  { titre: 'Aucune certification visible (RGE)', count: 6, detail: 'Sur isolation et facade, l\'absence du label RGE bloque directement les projets eligibles aux aides.' },
  { titre: 'Email Gmail non professionnel', count: 5, detail: 'bge.batiment57@gmail.com inspire peu de confiance pour des chantiers a 10 000-50 000 EUR.' },
  { titre: 'Formulaire avec bouton "Participer"', count: 5, detail: 'Wording incomprehensible pour un formulaire de contact — confusion et taux d\'abandon eleve.' },
];

// ============================================================
// PAGESPEED (ESTIMES — API quota depasse)
// ============================================================
const pagespeed = {
  mobile: { performance: 42, accessibility: 72, bestPractices: 78, seo: 81 },
  desktop: { performance: 68, accessibility: 72, bestPractices: 78, seo: 81 },
};

const coreWebVitals = [
  { name: 'LCP', value: '~4.2s', status: 'bad' },
  { name: 'INP', value: '~380ms', status: 'bad' },
  { name: 'CLS', value: '~0.08', status: 'good' },
];

const opportunities = [
  { label: 'Optimisation images WebP + compression', saving: '~2.1s' },
  { label: 'Elimination ressources bloquant le rendu (JS Duda)', saving: '~1.4s' },
  { label: 'Reduction JavaScript inutilise', saving: '~0.8s' },
];

// ============================================================
// OBSERVATORY
// ============================================================
const observatory = {
  grade: 'B',
  score: 70,
  testsPassed: 7,
  testsTotal: 10,
};

// ============================================================
// CHECKLIST TECHNIQUE
// ============================================================
const techChecks = [
  { label: 'HTTPS actif + HSTS', present: true },
  { label: 'robots.txt + sitemap.xml', present: true },
  { label: 'Meta title + description', present: true },
  { label: 'Un seul H1 par page', present: true },
  { label: 'Schema.org LocalBusiness', present: true, note: 'Type generique — devrait etre GeneralContractor' },
  { label: 'Open Graph (og:title, og:image)', present: false, critical: true },
  { label: 'Balise canonical', present: false },
  { label: 'Alt text images systematique', present: false },
  { label: 'Email professionnel (domaine)', present: false, critical: true },
  { label: 'aggregateRating Schema.org', present: false, critical: true },
];

// ============================================================
// PERSONAS (10)
// ============================================================
const personas = [
  {
    id: 1, name: 'Michel', age: 58, emoji: '👷',
    canal: 'Google Search', device: 'Mobile', maturite: 'Decision',
    situation: 'Proprietaire maison des annees 70, toiture qui fuit depuis l\'hiver dernier',
    contexte: 'Tape "maconnerie toiture fuite Metz" sur Google, tombe sur BGE en position 3',
    parcours: ['Accueil', 'Couverture', 'Contact'],
    decision: 'convertit',
