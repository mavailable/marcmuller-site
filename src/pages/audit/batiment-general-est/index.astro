    scores: { exp: 4, conf: 4, clarte: 5 },
    premierImpression: 'La fiche Google est basique, pas beaucoup d\'avis. Le site est plus complet mais manque de preuves.',
    questionCle: 'Quel est votre delai pour demarrer ? Vous avez fait d\'autres extensions comme la mienne ?',
    reponse: 'Non',
    commentReponse: 'Aucune info sur les delais ni portfolio. Elle va demander des devis a 3 entreprises dont une avec galerie de realisations.',
    impactTechnique: 'Navigation mobile acceptable mais transitions lentes entre les pages de services.',
    pointsPositifs: ['Interlocuteur unique mentionne', 'Zone Luxembourg/Moselle claire', 'Polyvalence tous corps d\'etat'],
