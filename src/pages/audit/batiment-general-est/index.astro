const ameliorationsUtiles = [
  {
    titre: 'Ajouter les aides financieres sur les pages isolation et facade',
    detail: 'MaPrimeRenov, CEE, TVA 5.5% — ces mentions attirent des projets a haute valeur et qualifient l\'audience.',
  },
