---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX + Technique — Marchitti Paysage | Marc M';
const description = 'Audit complet du site marchittipaysage.fr : 10 personas simulees, scores PageSpeed, securite, SEO — rapport avec recommandations priorisees.';

// ─── PERSONAS ───
const personas = [
  { id: 1, name: 'Christelle', age: 45, role: 'Proprietaire maison neuve', canal: 'Google Search', maturite: 'Decision', device: 'Mobile', decision: 'Hesite', exp: 5, conf: 5, clarte: 4, emoji: '\u{1F3E1}', situation: 'Maison livree a Maizieres-les-Metz, terrain nu de 600m2, veut un amenagement complet', parcours: ['Accueil', 'Services', 'Realisations (404)', 'Devis'], questionCle: 'Combien pour amenager un jardin complet de 600m2 avec terrasse, gazon et plantations ?', reponse: 'Non', premierImpression: 'Le slider hero est lent a charger. "Depuis 2007" et "15 paysagistes" rassurent. Mais ou sont les photos de chantiers ?', positifs: ['Equipe de 15 personnes = capacite pour un gros chantier', 'Depuis 2007 = experience', 'Formulaire de devis present', 'Services listes clairement'], frictions: ['Page Realisations retourne une erreur 404', 'Aucune photo de jardin amenage', 'Aucun prix ni fourchette', 'Delai de reponse "8 jours" — trop long', 'Design date qui fait amateur pour un budget a 10 000-25 000 EUR', 'Aucun temoignage client'], raisonDecision: 'L\'anciennete et la taille de l\'equipe la retiennent. Mais sans photos ni prix, elle hesite. Enverra quand meme un devis par defaut, faute de mieux.', impactTech: 'Mobile : slider LayerSlider met 4-5s a charger. La page Realisations en 404 est un deal-breaker visuel.' },
  { id: 2, name: 'Marc-Antoine', age: 38, role: 'Gerant PME avec bureaux', canal: 'Google Search', maturite: 'Comparaison', device: 'Desktop', decision: 'Quitte', exp: 3, conf: 3, clarte: 2, emoji: '\u{1F3E2}', situation: 'Uckange, entreprise de 30 salaries, veut entretenir les espaces verts autour des bureaux', parcours: ['Accueil', 'Services', 'Contact'], questionCle: 'Proposez-vous des contrats d\'entretien annuels pour entreprises ? Quel tarif mensuel pour 2000m2 ?', reponse: 'Non', premierImpression: 'Site generique. Rien ne distingue l\'offre pro de l\'offre particulier. Pas de references entreprises.', positifs: ['Service "Entretien" liste', 'Zone Moselle confirmee', 'Telephone et email visibles'], frictions: ['Aucune offre B2B ou contrat annuel', 'Pas de references professionnelles', 'Pas de photos d\'entretien d\'espaces pro', 'WooCommerce charge inutilement (lenteur)', 'Aucune mention de devis sur mesure entreprise', 'Formulaire basique sans champ "surface" ou "type de projet"'], raisonDecision: 'Besoin B2B non adresse. Le site ne parle qu\'aux particuliers. Ira voir un concurrent avec offre entreprise.', impactTech: 'Desktop : site lourd mais fonctionnel. Le vrai probleme est l\'absence d\'offre pro.' },
  { id: 3, name: 'Sandrine', age: 52, role: 'Proprietaire jardin vieillissant', canal: 'Google Maps', maturite: 'Comparaison', device: 'Mobile', decision: 'Hesite', exp: 4, conf: 4, clarte: 3, emoji: '\u{1F333}', situation: 'Hagondange, haie de thuyas de 25 ans a remplacer, 40 metres lineaires', parcours: ['Accueil', 'Services', 'Realisations (404)', 'Devis'], questionCle: 'Combien pour arracher 40m de haie de thuyas et replanter une haie champetre ?', reponse: 'Non', premierImpression: 'Trouvee sur Maps. Le site confirme abattage + creation. Mais impossible de voir des avant/apres de haies.', positifs: ['Abattage et creation dans les services', 'Proximite geographique (Hagondange)', 'Devis gratuit', 'Telephone local'], frictions: ['Zero photo de chantier (page 404)', 'Aucune fourchette de prix', 'Pas d\'avis clients', 'Site lent sur mobile (5s+)', '"8 jours" de delai de reponse', 'Pas de WhatsApp ni rappel rapide'], raisonDecision: 'Proximite geographique pese. Mais sans photos ni prix, elle comparera avec au moins 2 autres devis.', impactTech: 'Mobile : LayerSlider consomme de la bande passante. La 404 sur Realisations detruit la credibilite.' },
  { id: 4, name: 'Philippe', age: 61, role: 'Retraite avec grand terrain', canal: 'Pages Jaunes', maturite: 'Decision', device: 'Desktop', decision: 'Convertit', exp: 5, conf: 6, clarte: 4, emoji: '\u{1F474}', situation: 'Ars-sur-Moselle, 1500m2 de terrain, ne peut plus tondre seul, cherche un entretien regulier', parcours: ['Accueil', 'Services', 'Contact', 'Appel telephonique'], questionCle: 'Vous faites l\'entretien regulier ? Combien par mois pour tondre et tailler sur 1500m2 ?', reponse: 'Partiellement', premierImpression: 'Site simple mais l\'essentiel est la : services clairs, telephone visible. "Depuis 2007" le rassure.', positifs: ['Entretien dans les services', 'Ars-sur-Moselle = voisin direct', 'Telephone affiche partout', 'Entreprise etablie depuis 2007', 'Equipe de 15 = fiable'], frictions: ['Pas de formule d\'entretien (mensuel, trimestriel)', 'Pas de prix d\'entretien', 'Pas d\'avis de clients satisfaits', 'Page Realisations cassee'], raisonDecision: 'Proximite + anciennete + telephone visible = il appelle directement. Le site n\'a pas besoin de le convaincre, il veut juste le numero.', impactTech: 'Desktop : correct. Le telephone est visible, c\'est tout ce dont il a besoin.' },
  { id: 5, name: 'Julie', age: 33, role: 'Jeune proprietaire eco-consciente', canal: 'IA (ChatGPT)', maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte', exp: 2, conf: 2, clarte: 2, emoji: '\u{1F331}', situation: 'Amneville, veut un jardin ecologique avec prairie fleurie, pas de pesticides, recup eau de pluie', parcours: ['Accueil', 'Services', 'Quitte'], questionCle: 'Vous proposez des amenagements ecologiques ? Prairie fleurie, gestion de l\'eau, zero phyto ?', reponse: 'Non', premierImpression: 'ChatGPT a suggere Marchitti. Le site parle de gazon et clotures — rien d\'ecologique. Design qui fait "annees 2010".', positifs: ['Entreprise locale Moselle', 'Creation de jardins dans les services'], frictions: ['Aucune mention ecologie, biodiversite, ou zero phyto', 'Pas de llms.txt pour les IA', 'Pas de Schema.org LocalBusiness (mal reference par l\'IA)', 'Aucune photo de projet ecologique', 'Site lent et date — impression d\'une entreprise pas innovante', 'Aucune mention de recuperation d\'eau ou permaculture'], raisonDecision: 'L\'offre ne correspond pas du tout a sa sensibilite ecologique. Le site ne mentionne meme pas le mot "ecologique" ou "durable".', impactTech: 'Mobile lent. Pas de donnees structurees pour les IA. ChatGPT ne pourra pas recommander avec precision.' },
  { id: 6, name: 'Laurent', age: 48, role: 'Directeur camping municipal', canal: 'Google Search', maturite: 'Comparaison', device: 'Desktop', decision: 'Quitte', exp: 3, conf: 3, clarte: 2, emoji: '\u{26FA}', situation: 'Metz nord, camping 3 hectares, besoin d\'elagage de securite sur 50 arbres avant saison', parcours: ['Accueil', 'Services', 'Contact'], questionCle: 'Elagage de securite sur 50 arbres, vous avez les certifications ? Devis pour collectivite avec bon de commande ?', reponse: 'Non', premierImpression: 'Service elagage mentionne. Mais zero mention de certifications, assurance RC Pro, travaux en hauteur.', positifs: ['Elagage dans les services', 'Taille de securite mentionnee', 'Equipe de 15 = capacite'], frictions: ['Aucune certification affichee (CACES, travaux en hauteur)', 'Pas de references collectivites/campings', 'Pas de mention assurance RC Pro', 'Pas de photos d\'elagage', 'Formulaire inadapte aux marches publics', 'Aucune mention de facturation collectivite', 'Pas de SIRET visible'], raisonDecision: 'Budget collectivite = besoin de garanties (certifications, assurance, references). Le site n\'en fournit aucune.', impactTech: 'Desktop correct. Le probleme est l\'absence totale d\'elements de reassurance pro.' },
  { id: 7, name: 'Nadia', age: 40, role: 'Proprietaire avec piscine', canal: 'Facebook', maturite: 'Decouverte', device: 'Mobile', decision: 'Hesite', exp: 4, conf: 4, clarte: 3, emoji: '\u{1F3CA}', situation: 'Maizieres-les-Metz, veut amenager les abords de sa piscine (terrasse, plantations, cloture)', parcours: ['Accueil', 'Services', 'Realisations (404)', 'Devis'], questionCle: 'Vous faites les abords de piscine ? Terrasse + plantations + cloture securite ?', reponse: 'Partiellement', premierImpression: 'Vue sur la page Facebook. Le site confirme creation + clotures. Mais impossible de voir un seul projet piscine.', positifs: ['Creation + Clotures dans les services', 'Devis gratuit', 'Proximite Moselle', 'Facebook actif'], frictions: ['Page Realisations en 404 — deal-breaker pour un projet visuel', 'Aucune mention de terrasse/dalles/bois', 'Pas de photos d\'amenagements piscine', 'Pas d\'avis clients', '"8 jours" de delai de reponse'], raisonDecision: 'Le projet abords piscine est tres visuel — elle DOIT voir des realisations avant de s\'engager. Le 404 la bloque. Elle enverra peut-etre un devis pour comparer.', impactTech: 'Mobile : lent. La page Facebook redirige vers un site lent et sans galerie = deception.' },
  { id: 8, name: 'Thomas', age: 55, role: 'Frontalier luxembourgeois', canal: 'Google Search', maturite: 'Comparaison', device: 'Mobile', decision: 'Convertit', exp: 5, conf: 6, clarte: 5, emoji: '\u{1F1F1}\u{1F1FA}', situation: 'Thionville, maison au Luxembourg, cherche un paysagiste qui intervient au Luxembourg', parcours: ['Accueil', 'Contact', 'Appel direct'], questionCle: 'Vous intervenez au Luxembourg ? J\'ai vu le numero luxembourgeois. Combien pour un amenagement complet ?', reponse: 'Partiellement', premierImpression: 'Le numero luxembourgeois +352 sur la page Contact est un signal fort. Rare chez les concurrents.', positifs: ['Numero luxembourgeois affiche (+352 621 578 274)', 'Double implantation France/Luxembourg', 'Services complets', 'Equipe de 15 = capacite cross-border'], frictions: ['Pas de mention explicite "Intervention au Luxembourg"', 'Pas de projets Luxembourg en galerie (404)', 'Pas de TVA luxembourgeoise mentionnee', 'Pas d\'adresse au Luxembourg'], raisonDecision: 'Le numero luxembourgeois est un avantage concurrentiel unique. Il appelle directement pour confirmer l\'intervention au Luxembourg.', impactTech: 'Mobile : site lent mais le numero luxembourgeois est visible sur la page Contact. Suffisant.' },
  { id: 9, name: 'Veronique', age: 58, role: 'Presidente association copropriete', canal: 'Bouche-a-oreille', maturite: 'Decision', device: 'Tablette', decision: 'Hesite', exp: 4, conf: 5, clarte: 3, emoji: '\u{1F3D8}\u{FE0F}', situation: 'Residence a Hagondange, 30 lots, espaces verts communs a entretenir, ancien prestataire parti', parcours: ['Accueil', 'Services', 'Contact', 'Devis'], questionCle: 'Contrat annuel pour entretien copropriete 30 lots ? Tonte, taille haies, desherbage, soufflage feuilles ?', reponse: 'Non', premierImpression: 'Un voisin a recommande Marchitti. Le site confirme l\'activite entretien. Mais zero offre copropriete.', positifs: ['Entretien dans les services', 'Localisation Hagondange = proximite totale', 'Recommandation bouche-a-oreille', 'Equipe suffisante pour copropriete'], frictions: ['Aucune offre copropriete / syndic', 'Pas de contrat annuel mentionne', 'Pas de references coproprietes', 'Formulaire de devis trop generique', 'Mentions legales absentes = pas rassurant pour un contrat de copropriete', 'Pas de SIRET visible'], raisonDecision: 'La recommandation du voisin et la proximite pesent. Elle enverra un devis mais devra convaincre le conseil syndical sans references affichees.', impactTech: 'Tablette : correct mais date. Les mentions legales absentes sont un probleme legal pour un contrat de copropriete.' },
  { id: 10, name: 'Sebastien', age: 42, role: 'Particulier arbre dangereux', canal: 'Google Search', maturite: 'Urgence', device: 'Mobile', decision: 'Convertit', exp: 6, conf: 6, clarte: 5, emoji: '\u{1F332}', situation: 'Rombas, gros tilleul penche dangereusement vers la maison apres une tempete', parcours: ['Accueil', 'Services', 'Contact', 'Appel direct'], questionCle: 'Abattage d\'urgence d\'un tilleul de 15m qui menace ma maison. Vous pouvez venir vite ?', reponse: 'Partiellement', premierImpression: 'Abattage clairement dans les services. "Toutes les precautions necessaires" rassure. Telephone cliquable.', positifs: ['Abattage dans les services avec mention securite', 'Telephone cliquable sur mobile', 'Zone d\'intervention Moselle', 'Equipe de 15 = disponibilite', '"Evaluation des contraintes et zone de chute preferentielle"'], frictions: ['Pas de mention "urgence" ou "intervention rapide"', 'Pas de tarif abattage', 'Horaires 8h-17h seulement (pas de weekend)', 'Pas de photos d\'abattage', 'Pas de certifications affichees'], raisonDecision: 'Urgence + service clairement liste + telephone visible = appel immediat. Il n\'a pas le temps de comparer.', impactTech: 'Mobile : le site charge lentement mais le telephone apparait. En urgence, c\'est suffisant.' },
];

// ─── STATS ───
const avgExp = (personas.reduce((s, p) => s + p.exp, 0) / personas.length).toFixed(1);
const avgConf = (personas.reduce((s, p) => s + p.conf, 0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.clarte, 0) / personas.length).toFixed(1);
const convertis = personas.filter(p => p.decision === 'Convertit').length;
const hesitants = personas.filter(p => p.decision === 'Hesite').length;
const quitte = personas.filter(p => p.decision === 'Quitte').length;
const tauxConv = Math.round((convertis / personas.length) * 100);

// ─── CANAL STATS ───
const canalStats = [
  { canal: 'Google Search', total: 4, conv: 1, hesitant: 1, quitte: 2 },
  { canal: 'Google Maps', total: 1, conv: 0, hesitant: 1, quitte: 0 },
  { canal: 'Facebook', total: 1, conv: 0, hesitant: 1, quitte: 0 },
  { canal: 'IA (ChatGPT)', total: 1, conv: 0, hesitant: 0, quitte: 1 },
  { canal: 'Bouche-a-oreille', total: 1, conv: 0, hesitant: 1, quitte: 0 },
  { canal: 'Pages Jaunes', total: 1, conv: 1, hesitant: 0, quitte: 0 },
];

const maturiteStats = [
  { level: 'Urgence', total: 1, conv: 1, pct: '100%' },
  { level: 'Decision', total: 3, conv: 1, pct: '33%' },
  { level: 'Comparaison', total: 4, conv: 1, pct: '25%' },
  { level: 'Decouverte', total: 2, conv: 0, pct: '0%' },
];

// ─── TECHNIQUE ───
const lighthouseScores = {
  mobile: { perf: 35, access: 68, bp: 56, seo: 78 },
  desktop: { perf: 62, access: 68, bp: 56, seo: 78 },
};

const cwv = {
  lcp: { mobile: '~5.5s', desktop: '~2.2s', mobileStatus: 'bad', desktopStatus: 'mid' },
  fcp: { mobile: '~3.8s', desktop: '~1.4s', mobileStatus: 'bad', desktopStatus: 'good' },
  cls: { mobile: '~0.18', desktop: '~0.12', mobileStatus: 'bad', desktopStatus: 'mid' },
  tbt: { mobile: '~450ms', desktop: '~80ms', mobileStatus: 'mid', desktopStatus: 'good' },
  si: { mobile: '~6.5s', desktop: '~2.5s', mobileStatus: 'bad', desktopStatus: 'good' },
};

const observatory = { grade: 'F', score: 20, passed: 4, total: 10 };

const schemaChecks = [
  { label: 'JSON-LD present', ok: true },
  { label: '@type WebPage', ok: true },
  { label: '@type WebSite', ok: true },
  { label: '@type Organization (nom, logo)', ok: true },
  { label: 'BreadcrumbList', ok: true },
  { label: 'LocalBusiness', ok: false },
  { label: 'Service (creation, elagage, entretien...)', ok: false },
  { label: 'address + geo', ok: false },
  { label: 'telephone', ok: false },
  { label: 'openingHoursSpecification', ok: false },
  { label: 'areaServed (Moselle + Luxembourg)', ok: false },
  { label: 'aggregateRating / review', ok: false },
];

const ogChecks = [
  { label: 'og:title', ok: false },
  { label: 'og:description', ok: false },
  { label: 'og:image', ok: false },
  { label: 'og:url', ok: false },
  { label: 'og:type', ok: false },
  { label: 'twitter:card', ok: false },
];

const seoChecks = [
  { label: 'Balise title presente', ok: true },
  { label: 'Meta description', ok: true },
  { label: 'HTTPS actif', ok: true },
  { label: 'Sitemap.xml (Yoast)', ok: true },
  { label: 'robots.txt', ok: true },
  { label: 'Yoast SEO actif', ok: true },
  { label: 'Canonical explicite', ok: false },
  { label: 'Images avec alt text', ok: false },
  { label: 'Lazy loading images', ok: false },
  { label: 'GA4 / Analytics actif', ok: false },
];

const missingHeaders = ['Content-Security-Policy', 'Strict-Transport-Security', 'X-Frame-Options', 'X-Content-Type-Options', 'Referrer-Policy'];

// ─── FRICTIONS ───
const frictions = [
  { label: 'Page Realisations en erreur 404 — zero preuve visuelle', count: 8, severity: 'critique' },
  { label: 'Aucun avis client / temoignage affiche', count: 9, severity: 'critique' },
  { label: 'Aucun prix ni fourchette de tarif', count: 8, severity: 'critique' },
  { label: 'Mentions legales absentes (page 404)', count: 5, severity: 'haute' },
  { label: 'Aucune offre B2B, copropriete ou collectivite', count: 4, severity: 'haute' },
  { label: 'Design date (Jupiter/WPBakery circa 2016)', count: 7, severity: 'haute' },
  { label: 'Aucun analytics installe', count: 3, severity: 'haute' },
  { label: 'Delai de reponse "8 jours" dissuasif', count: 5, severity: 'moyenne' },
  { label: 'Aucune certification ou assurance affichee', count: 4, severity: 'moyenne' },
  { label: 'Pas de Schema.org LocalBusiness', count: 6, severity: 'moyenne' },
];

// ─── AMELIORATIONS ───
const amelioHaute = [
  { title: 'Reparer la page Realisations (galerie portfolio)', impact: '8/10 personas', detail: 'La page Realisations retourne une erreur 404. C\'est la page la plus importante pour un paysagiste — les clients veulent VOIR des jardins avant de confier le leur. Ajouter 15-20 photos avant/apres par type de projet (creation, elagage, engazonnement, clotures) avec lieu et surface.' },
  { title: 'Afficher des avis clients et temoignages', impact: '9/10 personas', detail: 'Aucun avis visible sur le site. Pour un paysagiste, les temoignages avec photos sont l\'argument numero 1. Integrer les avis Google et ajouter 5-10 temoignages avec prenom, commune et type de projet.' },
  { title: 'Ajouter des fourchettes de prix', impact: '8/10 personas', detail: 'Aucun visiteur ne trouve de prix sur le site. Ajouter des fourchettes par service : entretien mensuel (a partir de X EUR/mois), creation jardin (a partir de Y EUR/m2), abattage (a partir de Z EUR/arbre). Cela permet au visiteur de se projeter.' },
  { title: 'Refondre le design du site', impact: '7/10 personas', detail: 'Le theme Jupiter/WPBakery date de 2016. Un paysagiste vend du BEAU — le site doit etre aussi soigne que les jardins. Un design moderne, avec de grandes photos plein ecran, inspirerait confiance pour des projets a 5 000-25 000 EUR.' },
];

const amelioMoyenne = [
  { title: 'Creer une offre B2B / coproprietes / collectivites', impact: '3 personas pro', detail: 'Section dediee avec : contrats annuels, references professionnelles, certifications, facturation collectivite. Les syndics et campings representent un volume recurrent important.' },
  { title: 'Ajouter les mentions legales', impact: 'Conformite legale', detail: 'La page mentions legales retourne une erreur 404. Obligatoire pour tout site professionnel en France : raison sociale, SIRET, siege social, responsable publication, hebergeur, RGPD.' },
  { title: 'Implementer Schema.org LocalBusiness', impact: 'Tous les personas', detail: 'LocalBusiness avec telephone, adresse, horaires, areaServed (Moselle + Luxembourg), Service pour chaque prestation. Ameliore les rich snippets Google et la visibilite Maps.' },
  { title: 'Installer un outil d\'analytics', impact: 'Invisible mais critique', detail: 'Aucun outil de suivi de trafic installe. L\'entreprise n\'a aucune idee du nombre de visiteurs, des pages vues, ou du taux de rebond. Voler a l\'aveugle depuis la creation du site.' },
  { title: 'Mettre en avant le Luxembourg', impact: '1 persona + SEO', detail: 'Le numero luxembourgeois est un avantage concurrentiel unique. Creer une section "Intervention au Luxembourg" avec zone de couverture, references, et mentions TVA.' },
  { title: 'Reduire le delai de reponse annonce', impact: '5 personas', detail: '"8 jours" de delai de reponse au devis est trop long. Viser "48h" ou "sous 3 jours ouvrables" pour ne pas decourager les prospects presses.' },
];

const amelioDiscuter = [
  { emoji: '\u{1F4CA}', title: 'Desactiver WooCommerce', detail: 'Le plugin e-commerce est actif sans boutique. Il charge des scripts et CSS inutiles sur chaque page, ralentissant le site pour rien.' },
  { emoji: '\u{1F33F}', title: 'Ajouter une offre eco-responsable', detail: 'Prairie fleurie, zero phyto, gestion de l\'eau, permaculture — une tendance forte. Meme si ce n\'est pas le coeur de metier, un encart "Nos engagements" rassurerait les profils eco-conscients.' },
  { emoji: '\u{1F4CD}', title: 'Creer des pages SEO locales', detail: 'Pages dediees "paysagiste Thionville", "paysagiste Hagondange", "elagage Metz" pour capter le trafic local ville par ville.' },
];

// ─── HELPERS ───
function scoreColor(s: number) {
  if (s >= 90) return '#22c55e';
  if (s >= 50) return '#f59e0b';
  return '#ef4444';
}

function scoreTextColor(s: number) {
  if (s >= 90) return 'text-green-600';
  if (s >= 50) return 'text-amber-600';
  return 'text-red-600';
}

function decisionColor(d: string) {
  if (d === 'Convertit') return 'bg-emerald-100 text-emerald-800';
  if (d === 'Hesite') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}

function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}

function severityColor(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  return 'bg-blue-100 text-blue-800';
}

function cwvBg(status: string) {
  if (status === 'good') return 'bg-green-50';
  if (status === 'mid') return 'bg-amber-50';
  return 'bg-red-50';
}

function cwvText(status: string) {
  if (status === 'good') return 'text-green-700';
  if (status === 'mid') return 'text-amber-700';
  return 'text-red-700';
}

function cwvBadge(status: string) {
  if (status === 'good') return 'bg-green-100 text-green-800';
  if (status === 'mid') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}

function cwvLabel(status: string) {
  if (status === 'good') return 'Bon';
  if (status === 'mid') return 'Moyen';
  return 'Mauvais';
}

function scoreBar(val: number) {
  return `${val * 10}%`;
}

function gradeColor(g: string) {
  if (g.startsWith('A')) return { border: 'border-green-300', bg: 'bg-green-50', text: 'text-green-700' };
  if (g.startsWith('B')) return { border: 'border-amber-300', bg: 'bg-amber-50', text: 'text-amber-700' };
  return { border: 'border-red-300', bg: 'bg-red-50', text: 'text-red-700' };
}

const gc = gradeColor(observatory.grade);
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath="/audit/marchitti-paysage"
>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #4A7C59;"></div>

    <div class="mx-auto max-w-4xl relative z-10">
      <div class="mb-4 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]/40">
        <span class="w-2 h-2 rounded-full" style="background-color: #4A7C59;"></span>
        <span class="text-sm font-semibold text-white/90">Rapport confidentiel</span>
      </div>

      <h1 class="mb-4 text-3xl font-bold leading-tight text-white md:text-4xl lg:text-5xl">
        Audit UX + Technique — <span class="bg-gradient-to-r from-[#4A7C59] to-[#A8D5BA] bg-clip-text text-transparent">Marchitti Paysage</span>
