const getScoreColor = (score: number) => {
  if (score >= 75) return 'text-green-600';
  if (score >= 55) return 'text-amber-600';
  return 'text-red-600';
};

const getScoreBg = (score: number) => {
  if (score >= 75) return 'bg-green-500';
  if (score >= 55) return 'bg-amber-500';
  return 'bg-red-500';
};

const getVitalColor = (status: string) => {
  if (status === 'vert') return 'bg-green-100 text-green-800';
  if (status === 'orange') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
};

const conversionTotal = personas.filter(p => p.decision === 'convertit').length;
const hesitationTotal = personas.filter(p => p.decision === 'hesite').length;
const quitteTotal = personas.filter(p => p.decision === 'quitte').length;
---

<BaseLayout title={title} description={description} noindex={true}>
  <div class="max-w-5xl mx-auto px-4 py-12">

    <!-- En-tête -->
    <div class="mb-10">
      <div class="inline-block bg-amber-100 text-amber-800 text-xs font-semibold px-3 py-1 rounded-full mb-4">
        Audit prospect — confidentiel
      </div>
      <h1 class="text-3xl font-bold text-neutral-900 mb-2">{prospect.name}</h1>
      <p class="text-neutral-500 text-sm mb-1">{prospect.activity}</p>
      <p class="text-neutral-500 text-sm mb-1">{prospect.location} — {prospect.avis}</p>
      <a href={prospect.url} target="_blank" rel="noopener noreferrer"
         class="text-amber-600 text-sm underline hover:text-amber-700 break-all">
        {prospect.url}
      </a>
      <p class="text-neutral-400 text-xs mt-1">Audité le {prospect.date}</p>
    </div>

    <!-- Constat principal -->
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-6 mb-10">
      <h2 class="text-lg font-semibold text-amber-900 mb-2">Constat</h2>
      <p class="text-amber-800 leading-relaxed">{constat}</p>
    </div>

    <!-- KPIs résumés -->
    <div class="grid grid-cols-3 gap-4 mb-10">
      <div class="bg-white border border-neutral-200 rounded-xl p-5 text-center">
        <div class="text-3xl font-bold text-amber-600">{conversionTotal}/10</div>
        <div class="text-sm text-neutral-500 mt-1">Personas convertis</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-5 text-center">
        <div class="text-3xl font-bold text-amber-500">{hesitationTotal}/10</div>
        <div class="text-sm text-neutral-500 mt-1">Personas hésitants</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-5 text-center">
        <div class="text-3xl font-bold text-red-500">{quitteTotal}/10</div>
        <div class="text-sm text-neutral-500 mt-1">Personas qui quittent</div>
      </div>
    </div>

    <!-- Conversion par canal -->
    <div class="bg-white border border-neutral-200 rounded-xl p-6 mb-10">
      <h2 class="text-xl font-semibold text-neutral-900 mb-5">Taux de conversion estimé par canal</h2>
      <div class="space-y-4">
        {conversionByCanal.map(c => (
          <div>
            <div class="flex justify-between items-center mb-1">
              <span class="text-sm text-neutral-700 font-medium">{c.canal}</span>
              <span class={`text-sm font-bold ${c.color}`}>{c.taux}%</span>
            </div>
            <div class="w-full bg-neutral-100 rounded-full h-2">
              <div class={`${c.bg} h-2 rounded-full`} style={`width: ${c.taux}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Top frictions -->
    <div class="bg-white border border-neutral-200 rounded-xl p-6 mb-10">
      <h2 class="text-xl font-semibold text-neutral-900 mb-5">Top 5 frictions détectées</h2>
      <div class="space-y-5">
        {topFrictions.map((f, i) => (
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-red-100 text-red-700 font-bold text-sm flex items-center justify-center">
              {i + 1}
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <h3 class="font-semibold text-neutral-900">{f.titre}</h3>
                <span class="bg-red-100 text-red-700 text-xs px-2 py-0.5 rounded-full">{f.count}/10 personas</span>
              </div>
              <p class="text-neutral-600 text-sm leading-relaxed">{f.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Audit technique -->
    <div class="bg-white border border-neutral-200 rounded-xl p-6 mb-10">
      <h2 class="text-xl font-semibold text-neutral-900 mb-6">Audit technique</h2>

      <!-- PageSpeed -->
      <h3 class="font-semibold text-neutral-800 mb-4">PageSpeed Insights (estimé — quota API épuisé)</h3>
      <div class="grid grid-cols-2 gap-6 mb-6">
        <div>
          <h4 class="text-sm font-medium text-neutral-600 mb-3">Mobile</h4>
          {(['performance', 'accessibility', 'bestPractices', 'seo'] as const).map(key => (
            <div class="mb-3">
              <div class="flex justify-between text-sm mb-1">
                <span class="text-neutral-600 capitalize">{key === 'bestPractices' ? 'Meilleures pratiques' : key === 'accessibility' ? 'Accessibilité' : key.charAt(0).toUpperCase() + key.slice(1)}</span>
                <span class={`font-bold ${getScoreColor(pagespeed.mobile[key])}`}>{pagespeed.mobile[key]}</span>
              </div>
              <div class="w-full bg-neutral-100 rounded-full h-1.5">
                <div class={`${getScoreBg(pagespeed.mobile[key])} h-1.5 rounded-full`} style={`width: ${pagespeed.mobile[key]}%`}></div>
              </div>
            </div>
          ))}
        </div>
        <div>
          <h4 class="text-sm font-medium text-neutral-600 mb-3">Desktop</h4>
          {(['performance', 'accessibility', 'bestPractices', 'seo'] as const).map(key => (
            <div class="mb-3">
              <div class="flex justify-between text-sm mb-1">
                <span class="text-neutral-600 capitalize">{key === 'bestPractices' ? 'Meilleures pratiques' : key === 'accessibility' ? 'Accessibilité' : key.charAt(0).toUpperCase() + key.slice(1)}</span>
                <span class={`font-bold ${getScoreColor(pagespeed.desktop[key])}`}>{pagespeed.desktop[key]}</span>
              </div>
              <div class="w-full bg-neutral-100 rounded-full h-1.5">
                <div class={`${getScoreBg(pagespeed.desktop[key])} h-1.5 rounded-full`} style={`width: ${pagespeed.desktop[key]}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Core Web Vitals -->
      <h4 class="text-sm font-medium text-neutral-600 mb-3">Core Web Vitals (estimés)</h4>
      <div class="flex flex-wrap gap-2 mb-6">
        {coreWebVitals.map(v => (
          <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold ${getVitalColor(v.status)}`}>
            {v.name}: {v.value}
          </span>
        ))}
      </div>

      <!-- Observatory -->
      <h3 class="font-semibold text-neutral-800 mb-3">Observatory MDN</h3>
      <div class="flex items-center gap-4 mb-6">
        <div class="w-16 h-16 rounded-full bg-amber-100 flex items-center justify-center">
          <span class="text-2xl font-bold text-amber-700">{observatory.grade}</span>
        </div>
        <div>
          <div class="text-2xl font-bold text-neutral-900">{observatory.score}<span class="text-neutral-400 text-base font-normal">/100</span></div>
          <div class="text-sm text-neutral-500">{observatory.testsPassed}/{observatory.testsTotal} tests réussis</div>
          <div class="text-xs text-red-600 mt-0.5">CSP absent · X-Frame-Options absent · Referrer-Policy absent · Cookies insuffisants</div>
        </div>
      </div>

      <!-- Checklist -->
      <h3 class="font-semibold text-neutral-800 mb-3">Checklist technique</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        {techChecks.map(c => (
          <div class="flex items-start gap-2">
            <span class={`mt-0.5 flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold ${c.present ? 'bg-green-100 text-green-700' : c.critical ? 'bg-red-100 text-red-700' : 'bg-neutral-100 text-neutral-500'}`}>
              {c.present ? '✓' : '✗'}
            </span>
            <span class={`text-sm ${c.present ? 'text-neutral-700' : c.critical ? 'text-red-700 font-medium' : 'text-neutral-500'}`}>
              {c.label}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Personas -->
    <div class="mb-10">
      <h2 class="text-xl font-semibold text-neutral-900 mb-6">10 personas — Simulations de visite</h2>
      <div class="space-y-6">
        {personas.map(p => (
          <div class={`bg-white border rounded-xl p-6 ${p.decision === 'convertit' ? 'border-green-200' : p.decision === 'hesite' ? 'border-amber-200' : 'border-red-200'}`}>
            <div class="flex items-start justify-between mb-4">
              <div class="flex items-center gap-3">
                <span class="text-3xl">{p.emoji}</span>
                <div>
                  <h3 class="font-bold text-neutral-900">{p.name}, {p.age} ans</h3>
                  <p class="text-xs text-neutral-500">{p.canal} · {p.device} · {p.maturite}</p>
                </div>
              </div>
              <span class={`text-xs font-semibold px-3 py-1.5 rounded-full ${p.decision === 'convertit' ? 'bg-green-100 text-green-800' : p.decision === 'hesite' ? 'bg-amber-100 text-amber-800' : 'bg-red-100 text-red-800'}`}>
                {p.decision === 'convertit' ? 'Converti' : p.decision === 'hesite' ? 'Hésite' : 'Quitte'}
              </span>
            </div>

            <p class="text-sm text-neutral-700 mb-3 italic">« {p.situation} »</p>
            <p class="text-xs text-neutral-500 mb-3">{p.contexte}</p>

            <div class="flex flex-wrap gap-1.5 mb-3">
              {p.parcours.map(etape => (
                <span class="bg-neutral-100 text-neutral-600 text-xs px-2 py-1 rounded">
                  {etape}
                </span>
              ))}
            </div>

            <div class="grid grid-cols-3 gap-3 mb-3">
              {Object.entries(p.scores).map(([k, v]) => (
                <div class="text-center">
                  <div class={`text-lg font-bold ${getScoreColor(v * 10)}`}>{v}/10</div>
                  <div class="text-xs text-neutral-400">{k === 'exp' ? 'Expérience' : k === 'conf' ? 'Confiance' : 'Clarté'}</div>
                </div>
              ))}
            </div>

            <div class="bg-neutral-50 rounded-lg p-3 mb-3">
              <p class="text-xs font-semibold text-neutral-600 mb-1">Question clé :</p>
              <p class="text-sm text-neutral-800 italic">« {p.questionCle} »</p>
              <p class="text-xs text-neutral-500 mt-1">{p.commentReponse}</p>
            </div>

            <p class="text-xs text-neutral-500 mb-3">{p.impactTechnique}</p>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <p class="text-xs font-semibold text-green-700 mb-1">Points positifs</p>
                <ul class="space-y-0.5">
                  {p.pointsPositifs.map(pt => (
                    <li class="text-xs text-neutral-600 flex gap-1.5">
                      <span class="text-green-500 flex-shrink-0">+</span>{pt}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="text-xs font-semibold text-red-700 mb-1">Frictions</p>
                <ul class="space-y-0.5">
                  {p.frictions.map(fr => (
                    <li class="text-xs text-neutral-600 flex gap-1.5">
                      <span class="text-red-500 flex-shrink-0">−</span>{fr}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Améliorations -->
    <div class="bg-white border border-neutral-200 rounded-xl p-6 mb-10">
      <h2 class="text-xl font-semibold text-neutral-900 mb-5">Améliorations prioritaires</h2>
      <div class="space-y-5">
        {ameliorationsCritiques.map((a, i) => (
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-100 text-amber-700 font-bold text-sm flex items-center justify-center">
              {i + 1}
            </div>
            <div>
              <h3 class="font-semibold text-neutral-900 mb-1">{a.titre}</h3>
              <p class="text-neutral-600 text-sm leading-relaxed">{a.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Score global -->
    <div class="bg-neutral-900 rounded-xl p-6 text-white mb-10">
      <h2 class="text-lg font-semibold mb-4">Score global du site actuel</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[
          { label: 'Performance mobile', score: 47 },
          { label: 'Sécurité (Observatory)', score: 45 },
          { label: 'SEO on-page', score: 55 },
          { label: 'Schema.org / GEO', score: 10 },
          { label: 'Open Graph', score: 65 },
          { label: 'Contenu / Blog', score: 78 },
          { label: 'UX commande', score: 58 },
          { label: 'Score global', score: 51 },
        ].map(s => (
          <div class="text-center">
            <div class={`text-2xl font-bold ${s.score >= 70 ? 'text-green-400' : s.score >= 50 ? 'text-amber-400' : 'text-red-400'}`}>
              {s.score}
            </div>
            <div class="text-neutral-400 text-xs mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-6 text-center">
      <h2 class="text-lg font-semibold text-amber-900 mb-2">Proposition Web Factory</h2>
      <p class="text-amber-800 text-sm mb-4">
        Migration Wix → Astro + Cloudflare Pages. Schema.org Bakery complet. Blog Keystatic natif.
        Module boutique. Performance mobile A. Score GEO 90+. Livraison en 7 jours.
      </p>
      <p class="text-amber-700 font-bold text-lg">À partir de 990 €</p>
    </div>

  </div>
</BaseLayout>
