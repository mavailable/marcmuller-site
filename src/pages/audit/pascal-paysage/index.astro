---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX + Technique — Pascal Paysage | Marc M';
const description = 'Audit complet du site pascal-paysage.fr : 10 personas simulees, scores PageSpeed, securite, SEO — rapport avec recommandations priorisees.';

// ─── PERSONAS ───
const personas = [
  { id: 1, name: 'Isabelle', age: 52, role: 'Proprietaire maison avec grand jardin', canal: 'Google Search', maturite: 'Comparaison', device: 'Desktop', decision: 'Hesite', exp: 5, conf: 5, clarte: 4, emoji: '\u{1F3E1}', situation: 'Montigny-les-Metz, 3 grands tilleuls a elaguer avant l\'hiver, compare 3 paysagistes', parcours: ['Accueil', 'Elagage', 'Contact'], questionCle: 'Combien coute l\'elagage de 3 tilleuls de 12m ? Vous avez des photos de chantiers similaires ?', reponse: 'Non', premierImpression: 'Site propre, services bien listes. Mais aucun prix, aucune photo de realisation. Impossible de comparer.', positifs: ['Services clairement listes', '7j/7 affiche', 'Telephone cliquable', 'Schema.org LocalBusiness present'], frictions: ['Aucun tarif ni fourchette de prix', 'Zero photo de realisation / avant-apres', 'Pas de temoignage client', 'Email numericable.fr pas professionnel', 'Contenu generique sans personnalite'], raisonDecision: 'Elle a besoin de comparer. Sans prix ni photos, elle ne peut pas evaluer. Demandera un devis mais sans conviction — le concurrent avec galerie aura l\'avantage.', impactTech: 'Desktop : site charge correctement. Design template generique mais fonctionnel.' },
  { id: 2, name: 'Marc', age: 44, role: 'Proprietaire apres tempete', canal: 'Google Search', maturite: 'Urgence', device: 'Mobile', decision: 'Convertit', exp: 6, conf: 7, clarte: 5, emoji: '\u{1F32A}\u{FE0F}', situation: 'Metz Queuleu, arbre tombe sur la cloture du voisin apres tempete nocturne, dimanche matin', parcours: ['Accueil', 'Appel direct'], questionCle: 'Vous intervenez en urgence un dimanche pour un arbre tombe ? C\'est combien ?', reponse: 'Partiellement', premierImpression: '"7j/7" et "intervention tempete" le rassurent immediatement. Le numero est la. Il appelle.', positifs: ['7j/7 clairement affiche', 'Mention "intervention tempete"', 'Numero cliquable en haut de page', 'Rayon 50 km couvre Metz'], frictions: ['Pas de tarif urgence / majoration weekend', 'Pas de temps de reponse annonce', 'Pas de photos d\'interventions d\'urgence', 'Pas de garantie / assurance mentionnee clairement'], raisonDecision: 'Urgence + "7j/7 intervention tempete" + numero visible = appel immediat. Le site fait le minimum vital.', impactTech: 'Mobile : charge en 3-4s sur 4G. Le numero est accessible avant la fin du chargement.' },
  { id: 3, name: 'Sophie', age: 38, role: 'Jeune proprietaire premiere maison', canal: 'Google Maps', maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte', exp: 4, conf: 4, clarte: 3, emoji: '\u{1F331}', situation: 'Montigny-les-Metz, vient d\'acheter une maison avec jardin en friche, ne sait pas par ou commencer', parcours: ['Accueil', 'Entretien jardin', 'Creation gazon', 'Contact'], questionCle: 'Je pars de zero avec mon jardin. Vous pouvez me faire un plan d\'amenagement complet ? Budget ?', reponse: 'Non', premierImpression: 'Trouvee sur Maps. Le site liste des services mais ne propose pas de "projet complet". Pas d\'inspiration visuelle.', positifs: ['Trouvee facilement sur Google Maps', 'Services varies (gazon, entretien, haies)', 'Devis gratuit propose'], frictions: ['Pas de service "amenagement complet" visible', 'Aucune photo inspirante de jardins realises', 'Pas de fourchette budgetaire', 'Contenu froid et technique, pas inspirant', 'Pas d\'accompagnement projet mentionne', 'Design template sans ame'], raisonDecision: 'Cherche de l\'inspiration et un partenaire projet. Le site ne montre rien de concret. Elle ira sur Pinterest puis contactera un paysagiste avec portfolio.', impactTech: 'Mobile correct mais lent. Pas d\'images inspirantes a montrer de toute facon.' },
  { id: 4, name: 'Jean-Pierre', age: 67, role: 'Retraite, proprietaire verger', canal: 'Pages Jaunes', maturite: 'Decision', device: 'Desktop', decision: 'Convertit', exp: 6, conf: 6, clarte: 5, emoji: '\u{1F333}', situation: 'Ars-sur-Moselle, 8 fruitiers a tailler avant le printemps, voisin a recommande Pascal', parcours: ['Accueil', 'Elagage', 'Mentions legales', 'Contact'], questionCle: 'Mon voisin m\'a parle de vous. Vous taillez les fruitiers ? Quand pouvez-vous passer ?', reponse: 'Partiellement', premierImpression: 'Site confirme l\'existence de l\'entreprise. SIRET verifie dans les mentions legales. L\'elagage est bien liste.', positifs: ['Elagage clairement presente', 'Mention desinfection des coupes (pro)', 'SIRET verifiable', 'Devis gratuit', 'Rayon 50 km couvre Ars-sur-Moselle'], frictions: ['Pas de mention specifique "fruitiers"', 'Pas d\'avis clients alors que le voisin est content', 'Formulaire avec reCAPTCHA Google (penible)', 'Pas de calendrier/disponibilite'], raisonDecision: 'La recommandation du voisin fait le travail. Le site confirme le serieux (SIRET, services). Il appelle.', impactTech: 'Desktop : correct. Le formulaire est un peu lourd mais il preferera appeler.' },
  { id: 5, name: 'Karim', age: 35, role: 'Locataire maison avec haie mitoyenne', canal: 'Google Search', maturite: 'Urgence', device: 'Mobile', decision: 'Convertit', exp: 5, conf: 6, clarte: 5, emoji: '\u{1F33F}', situation: 'Metz Devant-les-Ponts, proprietaire exige taille de haie sous 15 jours sinon retenue sur caution', parcours: ['Accueil', 'Taille haies', 'Appel direct'], questionCle: 'Taille de haie de lauriers 25m lineaires, vous pouvez venir cette semaine ? C\'est combien ?', reponse: 'Partiellement', premierImpression: 'Page taille de haies existe. 7j/7 le rassure. Prix absent mais il est presse — il appelle.', positifs: ['Page dediee taille de haies', '2 passages/an recommandes (conseil pro)', '7j/7 disponible', 'Numero cliquable'], frictions: ['Pas de tarif au metre lineaire', 'Pas de delai annonce', 'Pas de photos de haies taillees', 'Contenu un peu court'], raisonDecision: 'Pression du proprietaire + service clairement propose + 7j/7 = appel. Le prix, il le demandera au telephone.', impactTech: 'Mobile : site charge assez vite. L\'essentiel est accessible.' },
  { id: 6, name: 'Catherine', age: 61, role: 'Presidente association de copropriete', canal: 'Google Search', maturite: 'Comparaison', device: 'Tablette', decision: 'Quitte', exp: 3, conf: 3, clarte: 2, emoji: '\u{1F3E2}', situation: 'Metz Nouvelle Ville, copropriete de 12 lots, entretien annuel espaces verts a renouveler', parcours: ['Accueil', 'Entretien jardin', 'Entretien pelouse', 'Contact', 'Mentions legales'], questionCle: 'Contrat annuel d\'entretien pour copropriete : tonte, taille haies, elagage 2x/an. Devis pour 800m2 ?', reponse: 'Non', premierImpression: 'Rien pour les coproprietes ou les pros. Le site parle uniquement aux particuliers.', positifs: ['Services de base couverts', 'SIRET verifiable', 'Zone Metz confirmee'], frictions: ['Aucune offre copropriete/contrat annuel', 'Pas de references professionnelles', 'Pas de distinction particulier/professionnel', 'Pas de devis type ou fourchette pour surface', 'Email numericable.fr ne fait pas pro', 'Formulaire basique sans champ "surface" ou "nombre de passages"'], raisonDecision: 'Besoin d\'un prestataire structure avec contrat annuel. Le site ne repond pas a ce besoin. Elle contactera un paysagiste avec offre B2B.', impactTech: 'Tablette : fonctionnel mais design date. L\'absence de contenu B2B est le vrai probleme.' },
  { id: 7, name: 'Antoine', age: 31, role: 'Proprietaire terrain a batir', canal: 'IA (ChatGPT)', maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte', exp: 3, conf: 3, clarte: 2, emoji: '\u{1F3D7}\u{FE0F}', situation: 'Scy-Chazelles, terrain avec arbres a abattre avant construction maison, cherche devis', parcours: ['Accueil', 'Abattage', 'Contact'], questionCle: 'Abattage de 5 arbres (chenes 15-20m) sur terrain a batir + dessouchage + evacuation. Budget ?', reponse: 'Non', premierImpression: 'ChatGPT a suggere le site. La page abattage existe mais zero indication de prix ou de capacite pour gros arbres. Design qui fait "petit artisan" pas "entreprise equipee pour gros chantiers".', positifs: ['Page abattage dediee', 'Techniques manuelles + mecaniques mentionnees', 'Rayon 50 km couvre Scy-Chazelles'], frictions: ['Aucun tarif abattage', 'Pas de mention dessouchage', 'Pas de photos de gros chantiers', 'Pas de certification ou assurance visible', 'Site non optimise pour les IA (pas de llms.txt)', 'Design qui n\'inspire pas confiance pour un chantier a 3000-8000 EUR'], raisonDecision: 'Gros budget. Le site ne prouve rien : pas de photos, pas de certifications, pas de references. Il cherchera un concurrent avec portfolio.', impactTech: 'Mobile : correct. ChatGPT a trouve l\'entreprise mais le site ne retient pas.' },
  { id: 8, name: 'Nadia', age: 45, role: 'Gerante chambre d\'hotes', canal: 'Bouche-a-oreille', maturite: 'Comparaison', device: 'Desktop', decision: 'Hesite', exp: 5, conf: 5, clarte: 4, emoji: '\u{1F3E8}', situation: 'Gorze, jardin de 2000m2 autour de la chambre d\'hotes, veut un entretien regulier pour l\'image', parcours: ['Accueil', 'Entretien jardin', 'Entretien pelouse', 'Creation gazon', 'Contact'], questionCle: 'Entretien mensuel du jardin de ma chambre d\'hotes : tonte, taille, desherbage. Tarif annuel ?', reponse: 'Non', premierImpression: 'Un ami l\'a recommande. Les services sont la mais rien sur l\'entretien regulier pro. Pas de photos pour montrer le niveau de qualite.', positifs: ['Gamme de services complete', '7j/7 rassurant', 'Rayon couvre Gorze (30 km)', 'Recommandation d\'un ami'], frictions: ['Pas d\'offre d\'entretien regulier/contrat', 'Aucune photo montrant la qualite du travail', 'Pas de temoignage hotelier/pro', 'Pas de tarif indicatif', 'Email pas professionnel'], raisonDecision: 'La recommandation pese. Mais l\'absence de photos et de tarifs la freine. Elle appellera pour un devis mais sans urgence — un concurrent avec beau portfolio pourrait la convaincre avant.', impactTech: 'Desktop : fonctionnel. Le design template n\'aide pas a vendre de la qualite paysagere.' },
  { id: 9, name: 'Thierry', age: 55, role: 'Proprietaire 2 immeubles locatifs', canal: 'Google Maps', maturite: 'Decision', device: 'Mobile', decision: 'Hesite', exp: 5, conf: 5, clarte: 4, emoji: '\u{1F3E0}', situation: 'Metz Sablon, 2 immeubles avec cours arborees, veut elaguer les branches qui depassent chez les voisins', parcours: ['Accueil', 'Elagage', 'Abattage', 'Contact'], questionCle: 'Elagage sur 2 sites differents a Metz, branches en surplomb sur propriete voisine. Vous gerez les autorisations ?', reponse: 'Non', premierImpression: 'Vu sur Maps, bien note. Le site confirme l\'elagage. Mais rien sur les situations juridiques (branches chez le voisin, autorisations...).', positifs: ['Avis Google Maps visibles (hors site)', 'Elagage clairement propose', 'Zone Metz confirmee', 'SIRET verifiable'], frictions: ['Pas de mention aspects juridiques/reglementaires', 'Pas de tarif multi-sites', 'Pas d\'assurance responsabilite civile mentionnee', 'Pas de photos de chantiers "delicats"', 'Avis Google non integres au site'], raisonDecision: 'Il a presque decide grace aux avis Google Maps. Le site ne le fait pas changer d\'avis mais ne le convainc pas non plus. Il appellera pour poser ses questions techniques.', impactTech: 'Mobile : correct. Les avis Google compensent les faiblesses du site.' },
  { id: 10, name: 'Lucie', age: 28, role: 'Jeune active location maison', canal: 'Facebook', maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte', exp: 3, conf: 3, clarte: 2, emoji: '\u{1F4F1}', situation: 'Montigny-les-Metz, jardin de la location envahi par les ronces, proprietaire demande de nettoyer', parcours: ['Accueil', 'Debarras dechets'], questionCle: 'Debroussaillage + evacuation ronces sur 100m2, c\'est combien a peu pres ?', reponse: 'Non', premierImpression: 'Vu via la page Facebook. Le site ne mentionne pas le debroussaillage. "Debarras dechets" c\'est pas pareil. Aucun prix. Design qui fait "pas pour moi" — elle a 28 ans, le site a l\'air d\'un annuaire 2015.', positifs: ['Page Facebook active', 'Numero cliquable'], frictions: ['Pas de service "debroussaillage" identifie', 'Aucun prix, meme indicatif', 'Design tres date pour une jeune generation', 'Pas de photos inspirantes', 'Pas de partage reseaux sociaux facile', 'Open Graph absent — le lien Facebook n\'a pas de preview'], raisonDecision: 'Service pas clairement propose + zero prix + design date = elle ferme. Cherchera sur Leboncoin ou demandera sur un groupe Facebook local.', impactTech: 'Mobile : le lien depuis Facebook ne montre aucune preview (pas d\'OG). Premiere impression deja mauvaise avant d\'arriver sur le site.' },
];

// ─── STATS ───
const avgExp = (personas.reduce((s, p) => s + p.exp, 0) / personas.length).toFixed(1);
const avgConf = (personas.reduce((s, p) => s + p.conf, 0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.clarte, 0) / personas.length).toFixed(1);
const convertis = personas.filter(p => p.decision === 'Convertit').length;
const hesitants = personas.filter(p => p.decision === 'Hesite').length;
const quitte = personas.filter(p => p.decision === 'Quitte').length;
const tauxConv = Math.round((convertis / personas.length) * 100);

// ─── CANAL STATS ───
const canalStats = [
  { canal: 'Google Search', total: 4, conv: 2, hesitant: 1, quitte: 1 },
  { canal: 'Google Maps', total: 2, conv: 1, hesitant: 1, quitte: 0 },
  { canal: 'IA (ChatGPT)', total: 1, conv: 0, hesitant: 0, quitte: 1 },
  { canal: 'Bouche-a-oreille', total: 1, conv: 0, hesitant: 1, quitte: 0 },
  { canal: 'Pages Jaunes', total: 1, conv: 1, hesitant: 0, quitte: 0 },
  { canal: 'Facebook', total: 1, conv: 0, hesitant: 0, quitte: 1 },
];

const maturiteStats = [
  { level: 'Urgence', total: 2, conv: 2, pct: '100%' },
  { level: 'Comparaison', total: 3, conv: 0, pct: '0%' },
  { level: 'Decouverte', total: 3, conv: 0, pct: '0%' },
  { level: 'Decision', total: 2, conv: 1, pct: '50%' },
];

// ─── TECHNIQUE ───
const lighthouseScores = {
  mobile: { perf: 55, access: 68, bp: 52, seo: 75 },
  desktop: { perf: 72, access: 68, bp: 52, seo: 75 },
};

const cwv = {
  lcp: { mobile: '~3.8s', desktop: '~1.5s', mobileStatus: 'bad', desktopStatus: 'good' },
  fcp: { mobile: '~2.8s', desktop: '~0.9s', mobileStatus: 'mid', desktopStatus: 'good' },
  cls: { mobile: '~0.12', desktop: '~0.08', mobileStatus: 'mid', desktopStatus: 'good' },
  tbt: { mobile: '~300ms', desktop: '~80ms', mobileStatus: 'mid', desktopStatus: 'good' },
  si: { mobile: '~4.5s', desktop: '~1.8s', mobileStatus: 'bad', desktopStatus: 'good' },
};

const observatory = { grade: 'F', score: 5, passed: 4, total: 10 };

const schemaChecks = [
  { label: 'JSON-LD present', ok: true },
  { label: '@type LocalBusiness', ok: true },
  { label: 'name, url', ok: true },
  { label: 'address', ok: true },
  { label: 'telephone', ok: true },
  { label: 'email', ok: true },
  { label: 'sameAs (Facebook, Maps)', ok: true },
  { label: 'openingHoursSpecification', ok: false },
  { label: 'areaServed (50 km)', ok: false },
  { label: 'Service (elagage, abattage...)', ok: false },
  { label: 'geo (lat/lng)', ok: false },
  { label: 'priceRange', ok: false },
  { label: 'aggregateRating', ok: false },
  { label: 'image', ok: false },
];

const ogChecks = [
  { label: 'og:title', ok: false },
  { label: 'og:description', ok: false },
  { label: 'og:image', ok: false },
  { label: 'og:url', ok: false },
  { label: 'og:type', ok: false },
  { label: 'twitter:card', ok: false },
];

const seoChecks = [
  { label: 'Balise title presente', ok: true },
  { label: 'Meta description', ok: false },
  { label: 'HTTPS + redirection', ok: true },
  { label: 'H1 unique par page', ok: true },
  { label: 'Canonical explicite', ok: false },
  { label: 'Schema.org LocalBusiness', ok: true },
  { label: 'Pages SEO locales', ok: true },
  { label: 'GA4 actif', ok: true },
  { label: 'Sitemap.xml', ok: false },
  { label: 'robots.txt', ok: false },
];

const missingHeaders = ['Content-Security-Policy', 'Strict-Transport-Security', 'X-Frame-Options', 'X-Content-Type-Options', 'Referrer-Policy', 'Permissions-Policy'];

// ─── FRICTIONS ───
const frictions = [
  { label: 'Aucun tarif ni fourchette de prix affiches', count: 9, severity: 'critique' },
  { label: 'Zero photo de realisations / avant-apres', count: 8, severity: 'critique' },
  { label: 'Pas de temoignages / avis clients sur le site', count: 8, severity: 'critique' },
  { label: 'Contenu generique sans personnalite ni ancres d\'authenticite', count: 7, severity: 'haute' },
  { label: 'Design template Linkeo date — pas de personnalite visuelle', count: 6, severity: 'haute' },
  { label: 'Aucune offre copropriete, contrat annuel ou B2B', count: 4, severity: 'haute' },
  { label: 'Email numericable.fr pas professionnel', count: 4, severity: 'moyenne' },
  { label: 'Open Graph absent — zero preview au partage', count: 3, severity: 'moyenne' },
  { label: 'PHP 5.6 expose via X-Powered-By (fin de vie 2018)', count: 3, severity: 'moyenne' },
  { label: 'reCAPTCHA Google sur formulaire (friction + RGPD)', count: 3, severity: 'moyenne' },
];

// ─── AMELIORATIONS ───
const amelioHaute = [
  { title: 'Afficher des fourchettes de prix', impact: '9/10 personas', detail: 'Pas un seul prix sur tout le site. Afficher des "a partir de" pour chaque service : elagage a partir de X EUR/arbre, taille de haie a partir de Y EUR/ml, abattage selon diametre. 9 personas sur 10 cherchent un indicateur de prix.' },
  { title: 'Ajouter une galerie de realisations avant/apres', impact: '8/10 personas', detail: 'Le paysage, ca se montre. Une galerie avec photos avant/apres (elagage, abattage, creation de gazon, jardin entretenu) donnerait la preuve du savoir-faire. Absolument essentiel pour un metier visuel.' },
  { title: 'Integrer des temoignages clients', impact: '8/10 personas', detail: 'Les avis Google existent probablement mais ne sont pas sur le site. Ajouter 5-10 temoignages avec prenom, commune et type d\'intervention (elagage, entretien, urgence tempete) donnerait un capital confiance immediat.' },
  { title: 'Refondre le site avec un design moderne', impact: '7/10 personas', detail: 'Le template Linkeo fait generique et date. Un site moderne, rapide, avec de belles photos de jardins inspirerait confiance — crucial pour un metier ou l\'esthetique compte. Performance mobile a ameliorer (LCP sous 2.5s).' },
];

const amelioMoyenne = [
  { title: 'Creer une offre coproprietes / contrat annuel', impact: '3 personas pro', detail: 'Section dediee : contrat d\'entretien annuel, tarif au m2, nombre de passages, references de coproprietes gerees. Les syndics et gestionnaires immobiliers representent un volume recurrent.' },
  { title: 'Completer le Schema.org', impact: 'Tous les personas', detail: 'La base LocalBusiness existe. Ajouter openingHoursSpecification (7j/7), areaServed (50 km), Service (elagage, abattage...), geo, image. Ameliore le rich snippet Google.' },
  { title: 'Ajouter les meta Open Graph', impact: '3 personas (partage social)', detail: 'Zero OG = zero preview quand quelqu\'un partage le lien sur Facebook, WhatsApp ou LinkedIn. Le lien apparait "nu" — pas de titre, pas d\'image, pas de description.' },
  { title: 'Migrer hors PHP 5.6', impact: 'Securite critique', detail: 'PHP 5.6 est en fin de vie depuis decembre 2018. 7 ans de failles non corrigees. Le header X-Powered-By expose cette version aux attaquants.' },
  { title: 'Securiser les headers HTTP', impact: 'Score Observatory F → A', detail: 'Score 5/100. Ajouter CSP, HSTS, X-Frame-Options, X-Content-Type-Options, Referrer-Policy. Retirer X-Powered-By.' },
  { title: 'Adopter une adresse email professionnelle', impact: 'Credibilite', detail: 'pascal.parizot@numericable.fr fait artisan 2010. Une adresse contact@pascal-paysage.fr ou pascal@pascal-paysage.fr (le domaine existe deja) renforcerait le serieux.' },
];

const amelioDiscuter = [
  { emoji: '\u{1F4F8}', title: 'Creer un portfolio Instagram/Facebook avec renvoi site', detail: 'Le paysagisme est ultra-visuel. Un flux de photos de chantiers sur Instagram (lie au site) servirait a la fois de vitrine et de contenu frais pour Google.' },
  { emoji: '\u{1F4CD}', title: 'Afficher une carte de zone d\'intervention', detail: 'Le "rayon 50 km" est mentionne en texte. Une carte visuelle montrant les communes couvertes rassurerait les visiteurs hors Montigny.' },
  { emoji: '\u{1F4CB}', title: 'Ajouter un formulaire de devis structure', detail: 'Le formulaire actuel est generique. Un formulaire avec champs specifiques (type de service, surface, nombre d\'arbres, acces) permettrait des devis plus rapides et qualifierait les leads.' },
];

// ─── HELPERS ───
function scoreColor(s: number) {
  if (s >= 90) return '#22c55e';
  if (s >= 50) return '#f59e0b';
  return '#ef4444';
}

function scoreTextColor(s: number) {
  if (s >= 90) return 'text-green-600';
  if (s >= 50) return 'text-amber-600';
  return 'text-red-600';
}

function decisionColor(d: string) {
  if (d === 'Convertit') return 'bg-emerald-100 text-emerald-800';
  if (d === 'Hesite') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}

function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}

function severityColor(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  return 'bg-blue-100 text-blue-800';
}

function cwvBg(status: string) {
  if (status === 'good') return 'bg-green-50';
  if (status === 'mid') return 'bg-amber-50';
  return 'bg-red-50';
}

function cwvText(status: string) {
  if (status === 'good') return 'text-green-700';
  if (status === 'mid') return 'text-amber-700';
  return 'text-red-700';
}

function cwvBadge(status: string) {
  if (status === 'good') return 'bg-green-100 text-green-800';
  if (status === 'mid') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}

function cwvLabel(status: string) {
  if (status === 'good') return 'Bon';
  if (status === 'mid') return 'Moyen';
  return 'Mauvais';
}

function scoreBar(val: number) {
  return `${val * 10}%`;
}

function gradeColor(g: string) {
  if (g.startsWith('A')) return { border: 'border-green-300', bg: 'bg-green-50', text: 'text-green-700' };
  if (g.startsWith('B')) return { border: 'border-amber-300', bg: 'bg-amber-50', text: 'text-amber-700' };
  return { border: 'border-red-300', bg: 'bg-red-50', text: 'text-red-700' };
}

const gc = gradeColor(observatory.grade);
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath="/audit/pascal-paysage"
>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #4A7C59;"></div>

    <div class="mx-auto max-w-4xl relative z-10">
      <div class="mb-4 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]/40">
        <span class="w-2 h-2 rounded-full" style="background-color: #4A7C59;"></span>
        <span class="text-sm font-semibold text-white/90">Rapport confidentiel</span>
