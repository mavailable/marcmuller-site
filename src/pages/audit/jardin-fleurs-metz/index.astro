---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX — Le Jardin des Fleurs Metz | Marc M.';
const description = 'Audit complet du site lejardindesfleurs.com : 10 personas simules, PrestaShop lent, Schema.org absent, pas de SEO local — recommandations actionnables pour fleuriste Metz.';

// ─── PROSPECT ───
const prospect = {
  name: 'Le Jardin des Fleurs — Metz Centre',
  url: 'https://www.lejardindesfleurs.com/',
  date: '29 mars 2026',
  activity: 'Fleuriste de proximite — Bouquets, Plantes, Mariage, Deuil, Livraison',
  location: 'Metz (57) — 3 boutiques : Malraux, Nancy, Strasbourg',
};

// ─── KPIs ───
const kpis = {
  conversion: 30,
  experience: 5.2,
  confiance: 5.0,
  clarte: 4.8,
};

// ─── CONSTAT ───
const constat = "Le site existe et vend en ligne, mais il ne convertit pas localement : pas de SEO local Metz, pas de Schema.org Florist, pas de telephone visible en hero, et un PrestaShop trop lent sur mobile — les Messins qui cherchent un fleuriste ne trouvent pas ces boutiques.";

// ─── CONVERSION PAR CANAL ───
const conversionByCanal = [
  { canal: 'Bouche-a-oreille', taux: 80, color: 'text-green-600', bg: 'bg-green-500' },
  { canal: 'Google Maps / GBP', taux: 50, color: 'text-green-600', bg: 'bg-green-500' },
  { canal: 'Google Search', taux: 20, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'Reseaux sociaux', taux: 25, color: 'text-amber-600', bg: 'bg-amber-500' },
  { canal: 'IA (ChatGPT / Perplexity)', taux: 0, color: 'text-red-700', bg: 'bg-red-700' },
  { canal: 'Autre (direct)', taux: 50, color: 'text-green-600', bg: 'bg-green-500' },
];

// ─── TOP FRICTIONS ───
const topFrictions = [
  { titre: 'Pas de SEO local — Metz invisible', count: 8, detail: 'Le site est national (reseau 80+ boutiques). Les pages boutiques Metz sont des sous-pages generiques sans H1 local, sans Schema Florist, sans contenu localise.' },
  { titre: 'Site PrestaShop lent sur mobile', count: 7, detail: 'Google Fonts en render-blocking, Creative Elements 2.5.9, cache desactive (no-store), multiples scripts JS — chargement estime 3-4 secondes sur 4G.' },
  { titre: 'Aucun telephone cliquable en header', count: 7, detail: 'Le numero n\'apparait que sur les pages boutiques individuelles. Sur mobile, pas de bouton d\'appel direct en premier ecran.' },
  { titre: 'Pas d\'avis clients visibles', count: 6, detail: 'Aucun temoignage, aucune note, aucun avis Google integre. La seule note trouvable (PagesJaunes) est 2/5.' },
  { titre: 'og:image absente — partages sociaux sans visuel', count: 5, detail: 'Quand quelqu\'un partage le site sur Facebook ou LinkedIn, aucune image n\'apparait — impact majeur sur les clics depuis les reseaux.' },
];

// ─── PAGESPEED ───
const pagespeed = {
  mobile: { performance: 38, accessibility: 68, bestPractices: 72, seo: 78 },
  desktop: { performance: 62, accessibility: 68, bestPractices: 72, seo: 82 },
};
const coreWebVitals = [
  { name: 'LCP mobile', value: '~3,8 s', status: 'rouge' },
  { name: 'INP', value: '~250 ms', status: 'orange' },
  { name: 'CLS', value: '~0,12', status: 'orange' },
  { name: 'FCP', value: '~2,4 s', status: 'orange' },
  { name: 'TTFB', value: '0,9 s', status: 'vert' },
];

// ─── OBSERVATORY ───
const observatory = { grade: 'B+', score: 65, testsPassed: 7, testsTotal: 10 };

// ─── CHECKLIST TECHNIQUE ───
const techChecks = [
  { label: 'HTTPS + HTTP/2 actif', present: true, critical: false },
  { label: 'HSTS (max-age court : 180j)', present: true, critical: false },
  { label: 'X-Content-Type-Options: nosniff', present: true, critical: false },
  { label: 'Content-Security-Policy (enforce)', present: false, critical: true },
  { label: 'X-Frame-Options: SAMEORIGIN', present: true, critical: false },
  { label: 'Referrer-Policy', present: true, critical: false },
  { label: 'Schema.org Florist / LocalBusiness', present: false, critical: true },
  { label: 'Open Graph image', present: false, critical: true },
  { label: 'sitemap.xml accessible', present: false, critical: true },
  { label: 'Canonical URL en head', present: false, critical: true },
  { label: 'Telephone cliquable en header mobile', present: false, critical: true },
  { label: 'robots.txt avec Content-Signal', present: true, critical: false },
