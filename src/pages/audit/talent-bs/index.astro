---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX + Technique — Talent Business Solutions | Marc M';
const description = 'Simulation de 20 visites personas sur talent-bs.com — rapport complet UX, technique, securite et recommandations priorisees.';

// ═══════════════════════════════════════════════
// DATA
// ═══════════════════════════════════════════════

const personas = [
  { id: 1,  name: 'Laurent',    age: 48, role: 'DAF PME BTP',               canal: 'LinkedIn',            maturite: 'Comparaison', device: 'Desktop',  decision: 'Convertit', exp: 7, conf: 8, clarte: 7 },
  { id: 2,  name: 'Sophie',     age: 41, role: 'DSI ETI industrie',          canal: 'Google Search',       maturite: 'Decision',    device: 'Desktop',  decision: 'Convertit', exp: 8, conf: 9, clarte: 8 },
  { id: 3,  name: 'Mickael',    age: 35, role: 'Responsable IT PME',         canal: 'IA (ChatGPT)',         maturite: 'Decouverte',  device: 'Desktop',  decision: 'Hesite',    exp: 6, conf: 7, clarte: 5 },
  { id: 4,  name: 'Isabelle',   age: 52, role: 'DG PME agroalimentaire',     canal: 'Bouche-a-oreille',    maturite: 'Decision',    device: 'Mobile',   decision: 'Convertit', exp: 6, conf: 9, clarte: 7 },
  { id: 5,  name: 'Thomas',     age: 29, role: 'Resp. commercial startup',   canal: 'Google Search',       maturite: 'Decouverte',  device: 'Mobile',   decision: 'Quitte',    exp: 3, conf: 4, clarte: 3 },
  { id: 6,  name: 'Nathalie',   age: 44, role: 'DRH + referente numerique',  canal: 'LinkedIn',            maturite: 'Comparaison', device: 'Desktop',  decision: 'Convertit', exp: 8, conf: 8, clarte: 8 },
  { id: 7,  name: 'Frederic',   age: 57, role: 'PDG TPE BTP',                canal: 'Google Maps',         maturite: 'Comparaison', device: 'Mobile',   decision: 'Hesite',    exp: 5, conf: 7, clarte: 4 },
  { id: 8,  name: 'Amira',      age: 33, role: 'Consultante independante',   canal: 'Google Search',       maturite: 'Decouverte',  device: 'Mobile',   decision: 'Quitte',    exp: 5, conf: 7, clarte: 6 },
  { id: 9,  name: 'Patrick',    age: 61, role: 'DAF groupe familial',        canal: 'Bouche-a-oreille',    maturite: 'Decision',    device: 'Desktop',  decision: 'Convertit', exp: 8, conf: 9, clarte: 8 },
  { id: 10, name: 'Clara',      age: 27, role: 'Chef de projet digital',     canal: 'IA (Perplexity)',      maturite: 'Comparaison', device: 'Desktop',  decision: 'Convertit', exp: 8, conf: 8, clarte: 7 },
  { id: 11, name: 'Jean-Pierre',age: 55, role: 'PDG PME services',           canal: 'LinkedIn',            maturite: 'Comparaison', device: 'Desktop',  decision: 'Hesite',    exp: 6, conf: 7, clarte: 5 },
  { id: 12, name: 'Valerie',    age: 46, role: 'Resp. achats ETI',           canal: 'Google Search',       maturite: 'Decouverte',  device: 'Mobile',   decision: 'Quitte',    exp: 4, conf: 6, clarte: 4 },
  { id: 13, name: 'Romain',     age: 38, role: 'CTO scale-up',               canal: 'IA (Claude)',          maturite: 'Decision',    device: 'Desktop',  decision: 'Convertit', exp: 8, conf: 9, clarte: 8 },
  { id: 14, name: 'Christine',  age: 50, role: 'Directrice association',     canal: 'Google Search',       maturite: 'Decouverte',  device: 'Mobile',   decision: 'Quitte',    exp: 2, conf: 5, clarte: 2 },
  { id: 15, name: 'David',      age: 43, role: 'IT Manager RCSA',            canal: 'Bouche-a-oreille',    maturite: 'Comparaison', device: 'Desktop',  decision: 'Convertit', exp: 8, conf: 9, clarte: 8 },
  { id: 16, name: 'Margot',     age: 31, role: 'Assistante de direction',    canal: 'Google Maps',         maturite: 'Decision',    device: 'Mobile',   decision: 'Hesite',    exp: 5, conf: 7, clarte: 6 },
  { id: 17, name: 'Bruno',      age: 59, role: 'Gerant PME retail',          canal: 'LinkedIn',            maturite: 'Decouverte',  device: 'Mobile',   decision: 'Quitte',    exp: 3, conf: 5, clarte: 2 },
  { id: 18, name: 'Helene',     age: 36, role: 'RSSI PME industrielle',      canal: 'Google Search',       maturite: 'Decision',    device: 'Desktop',  decision: 'Convertit', exp: 8, conf: 8, clarte: 7 },
  { id: 19, name: 'Youssef',    age: 34, role: 'Developpeur interne',        canal: 'Google Search',       maturite: 'Decouverte',  device: 'Desktop',  decision: 'Quitte',    exp: 4, conf: 6, clarte: 4 },
  { id: 20, name: 'Anne-Marie', age: 53, role: 'DG organisme de formation',  canal: 'Microsoft referral',  maturite: 'Decision',    device: 'Desktop',  decision: 'Convertit', exp: 9, conf: 9, clarte: 8 },
];

const avgExp    = (personas.reduce((s, p) => s + p.exp,    0) / personas.length).toFixed(1);
const avgConf   = (personas.reduce((s, p) => s + p.conf,   0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.clarte, 0) / personas.length).toFixed(1);
const convertis = personas.filter(p => p.decision === 'Convertit').length;
const hesitants = personas.filter(p => p.decision === 'Hesite').length;
const quitte    = personas.filter(p => p.decision === 'Quitte').length;
const tauxConv  = Math.round((convertis / personas.length) * 100);

const frictions = [
  { label: 'Navigation mobile insuffisante + site lent sur mobile',       count: 7,  severity: 'critique' },
  { label: 'Taille cible cliente non explicite (peur du "trop grand")',   count: 6,  severity: 'critique' },
  { label: 'Aucun prix affiche (hors formations et Zenisys)',             count: 5,  severity: 'critique' },
  { label: 'Success stories sans chiffres de ROI concrets',              count: 4,  severity: 'haute' },
  { label: 'Tel non clickable sur mobile (Google Maps)',                  count: 4,  severity: 'haute' },
  { label: 'Aucun contenu pour les visiteurs en phase Decouverte',       count: 3,  severity: 'haute' },
  { label: 'Agences regionales invisibles dans la navigation',           count: 4,  severity: 'haute' },
  { label: 'Paradoxe : vend la cybersecurite, grade F Observatory',      count: 2,  severity: 'haute' },
  { label: 'Financement OPCO non mentionne pour les formations',         count: 2,  severity: 'moyenne' },
  { label: 'Profils consultants absents (certifications individuelles)', count: 2,  severity: 'moyenne' },
];

const ameliorations = [
  { priority: 'haute', title: 'Tel clickable sticky mobile', impact: '7/20 personas', detail: 'Ajouter <a href="tel:+33388870014"> partout + bouton Appeler sticky dans le header mobile. Le site perd tous les visiteurs Google Maps qui cherchent juste a appeler.' },
  { priority: 'haute', title: 'Afficher la taille cible cliente', impact: '6/20 personas', detail: 'Une phrase sur la home et la page A propos : "Nous accompagnons les PME et ETI de 25 a 1000 salaries". Elimine le doute "suis-je trop petit pour TBS ?".' },
  { priority: 'haute', title: 'Fourchettes de prix sur les offres', impact: '5/20 personas', detail: 'Meme une fourchette large ("Pilot Copilot Chat a partir de X €") qualifie les prospects et elimine les curieux sans budget.' },
  { priority: 'haute', title: 'Refonte mobile-first', impact: '7/20 personas', detail: 'Navigation simplifiee sur mobile, reduction des scripts tiers (3 analytics !), images optimisees. Taux de conversion mobile actuel : 13% vs 67% desktop — ecart eliminatoire.' },
  { priority: 'haute', title: 'Chiffres ROI dans les success stories', impact: '4/20 personas', detail: 'Duree du projet, gain de productivite en %, nombre d\'utilisateurs formes. Le projet Lingenheld est excellent mais manque de preuves chiffrees.' },
  { priority: 'haute', title: 'Page "Nos agences" dans le menu principal', impact: '4/20 personas', detail: 'Avec pages locales SEO par ville (Nancy, Lyon, Paris, Mulhouse...). 13 agences = avantage concurrentiel non exploite en SEO local.' },
  { priority: 'haute', title: 'Headers securite HTTP (grade F)', impact: 'Reputation', detail: 'Ajouter CSP, Referrer-Policy, X-Frame-Options, Permissions-Policy. Un vendeur de cybersecurite avec un grade F = signal contradictoire majeur pour les DSI.' },
  { priority: 'haute', title: 'Section "Par ou commencer" sur l\'accueil', impact: '3/20 personas', detail: 'Guide visuel selon la taille et le besoin. Actuellement 0% de conversion pour les visiteurs en phase Decouverte — aucun contenu d\'eveil.' },
  { priority: 'moyenne', title: 'Mention financement OPCO pour les formations', impact: '2/20 personas', detail: 'Une ligne sur la page Formations. Question recurrente qui reste sans reponse, force un contact supplementaire inutile.' },
  { priority: 'moyenne', title: 'Profils consultants anonymises', impact: '2/20 personas', detail: '3-4 profils type avec certifications Microsoft individuelles. Les DSI et CTO veulent savoir qui interviendra sur leur projet.' },
  { priority: 'basse', title: 'Rafraichissement contenu solutions', impact: 'SEO', detail: 'Les pages solutions ont un dateModified de 2021 — signal d\'abandon pour Google. Actualiser le contenu et la date.' },
  { priority: 'basse', title: 'Temoignages clients verbatim sur l\'accueil', impact: '2/20 personas', detail: 'Une citation par secteur (BTP, sport, industrie). Les success stories sont descriptives mais manquent de la voix du client.' },
];

const canalStats = [
  { canal: 'Bouche-a-oreille / Referral', total: 4, conv: 4, pct: 100 },
  { canal: 'IA (ChatGPT / Perplexity / Claude)', total: 3, conv: 2, pct: 67 },
  { canal: 'LinkedIn', total: 4, conv: 2, pct: 50 },
  { canal: 'Google Search', total: 6, conv: 2, pct: 33 },
  { canal: 'Google Maps', total: 2, conv: 0, pct: 0 },
];

const maturiteStats = [
  { level: 'Decision',    total: 7, conv: 6, pct: '86%' },
  { level: 'Comparaison', total: 7, conv: 4, pct: '57%' },
  { level: 'Decouverte',  total: 6, conv: 0, pct: '0%' },
];

const techScores = {
  observatory: { grade: 'F', score: 20, passed: 4, total: 10, color: 'red' },
  schema: { score: 3, total: 10, label: 'WebPage generique uniquement' },
  og: { score: 5, total: 8, label: 'og:image absent sur plusieurs pages' },
  seo: { score: 6, total: 10, label: 'robots.txt OK, sitemap OK, contenu date 2021' },
};

// ═══════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════

function decisionColor(d: string) {
  if (d === 'Convertit') return 'border-emerald-200 bg-emerald-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}

function decisionBadge(d: string) {
  if (d === 'Convertit') return 'bg-emerald-600 text-white';
  if (d === 'Hesite') return 'bg-amber-500 text-white';
  return 'bg-neutral-400 text-white';
}

function decisionLabel(d: string) {
  if (d === 'Convertit') return 'Contacte';
  if (d === 'Hesite') return 'Hesite';
  return 'Quitte';
}

function severityBadge(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  return 'bg-blue-100 text-blue-800';
}

function priorityBorder(p: string) {
  if (p === 'haute') return 'border-l-4 border-l-red-500';
  if (p === 'moyenne') return 'border-l-4 border-l-amber-500';
  return 'border-l-4 border-l-blue-400';
}

function scoreColor(val: number) {
  if (val >= 7) return 'text-emerald-600';
  if (val >= 5) return 'text-amber-600';
  return 'text-red-600';
}

function canalColor(pct: number) {
  if (pct >= 67) return 'bg-emerald-500';
  if (pct >= 33) return 'bg-amber-500';
  return 'bg-red-400';
}

function deviceEmoji(d: string) {
  if (d === 'Mobile') return '📱';
  if (d === 'Desktop') return '💻';
  return '📟';
}

function maturiteEmoji(m: string) {
  if (m === 'Decision') return '🎯';
  if (m === 'Comparaison') return '🔍';
  return '💡';
}
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath="/audit/talent-bs"
>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>
    <div class="absolute bottom-10 right-10 w-64 h-64 rounded-full opacity-5 blur-3xl" style="background: #4FC3F7;"></div>

    <div class="mx-auto max-w-4xl relative z-10">
      <div class="mb-4 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]/40">
        <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: #E86C47;"></span>
        <span class="text-sm font-semibold text-white/90">Rapport confidentiel</span>
      </div>

      <h1 class="mb-4 text-3xl font-bold leading-tight text-white md:text-4xl lg:text-5xl">
        Audit UX + Technique —<br>
        <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">Talent Business Solutions</span>
      </h1>

      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl mb-8">
        Analyse complete de <strong class="text-white">talent-bs.com</strong> : scraping de 14 pages, audit securite et SEO, simulation de 20 visites personas realistes. Rapport genere le 1 avril 2026.
      </p>

      <div class="flex flex-wrap gap-3">
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">20 personas testes</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">5 canaux d'arrivee</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">14 pages scrapees</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">Securite : grade F</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">1 avril 2026</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ TAB BAR ═══════════════════ -->
  <nav class="sticky top-16 md:top-20 z-40 bg-white/95 backdrop-blur border-b border-neutral-200" id="tab-bar">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-1 h-12 text-sm overflow-x-auto">
      <button data-tab="0" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-[var(--color-accent-text)] bg-orange-50">Synthese</button>
      <button data-tab="1" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">Technique</button>
      <button data-tab="2" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">
        Visiteurs <span class="ml-1 text-xs text-neutral-400">20</span>
      </button>
      <button data-tab="3" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">
        Ameliorations <span class="ml-1 text-xs text-neutral-400">{ameliorations.length}</span>
      </button>
    </div>
  </nav>

  <div id="panels" class="flex overflow-x-auto snap-x snap-mandatory" style="-webkit-overflow-scrolling: touch; scrollbar-width: none;">

    <!-- ═══════════════════ PANEL 1 : SYNTHESE ═══════════════════ -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0 bg-neutral-50 py-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto space-y-10">

        <!-- KPIs -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="rounded-xl border border-neutral-200 bg-white p-5 text-center shadow-sm">
            <p class="text-3xl md:text-4xl font-bold text-amber-600">{tauxConv}%</p>
            <p class="mt-1 text-sm text-neutral-500">Taux de conversion</p>
            <p class="mt-2 text-xs text-neutral-400">{convertis} convertis · {hesitants} hesitants · {quitte} partis</p>
          </div>
          <div class="rounded-xl border border-neutral-200 bg-white p-5 text-center shadow-sm">
            <p class={`text-3xl md:text-4xl font-bold ${scoreColor(Number(avgExp))}`}>{avgExp}<span class="text-lg text-neutral-400">/10</span></p>
            <p class="mt-1 text-sm text-neutral-500">Experience</p>
            <div class="mt-2 h-2 rounded-full bg-neutral-100 overflow-hidden">
              <div class="h-full rounded-full bg-amber-500" style={`width: ${Number(avgExp) * 10}%`}></div>
            </div>
          </div>
          <div class="rounded-xl border border-neutral-200 bg-white p-5 text-center shadow-sm">
            <p class={`text-3xl md:text-4xl font-bold ${scoreColor(Number(avgConf))}`}>{avgConf}<span class="text-lg text-neutral-400">/10</span></p>
            <p class="mt-1 text-sm text-neutral-500">Confiance</p>
            <div class="mt-2 h-2 rounded-full bg-neutral-100 overflow-hidden">
              <div class="h-full rounded-full bg-emerald-500" style={`width: ${Number(avgConf) * 10}%`}></div>
            </div>
          </div>
          <div class="rounded-xl border border-neutral-200 bg-white p-5 text-center shadow-sm">
            <p class={`text-3xl md:text-4xl font-bold ${scoreColor(Number(avgClarte))}`}>{avgClarte}<span class="text-lg text-neutral-400">/10</span></p>
            <p class="mt-1 text-sm text-neutral-500">Clarte</p>
            <div class="mt-2 h-2 rounded-full bg-neutral-100 overflow-hidden">
              <div class="h-full rounded-full bg-blue-500" style={`width: ${Number(avgClarte) * 10}%`}></div>
            </div>
          </div>
        </div>

        <!-- Paradoxe principal -->
        <div class="rounded-xl border border-orange-200 bg-orange-50 p-6">
          <p class="text-xs font-semibold text-orange-600 uppercase tracking-widest mb-2">Paradoxe principal</p>
          <p class="text-lg font-semibold text-neutral-900 mb-2">Un site concu pour convaincre les experts, qui rebute les debutants</p>
          <p class="text-sm text-neutral-700">Les visiteurs en phase Decision convertissent a <strong>86%</strong> — le site est excellent pour ceux qui savent deja ce qu'ils veulent. Mais les visiteurs en phase Decouverte convertissent a <strong>0%</strong>. TBS gagne le fond du tunnel de conversion mais perd toute la partie haute. Or, ce sont les prospects en exploration d'aujourd'hui qui deviennent les clients de demain.</p>
        </div>

        <!-- Conversion par canal -->
        <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
          <h2 class="text-base font-semibold text-neutral-900 mb-5">Conversion par canal d'arrivee</h2>
          <div class="space-y-4">
            {canalStats.map(c => (
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-sm text-neutral-700">{c.canal}</span>
                  <span class="text-sm font-semibold text-neutral-900">{c.pct}% ({c.conv}/{c.total})</span>
                </div>
                <div class="h-2.5 rounded-full bg-neutral-100 overflow-hidden">
                  <div class={`h-full rounded-full ${canalColor(c.pct)}`} style={`width: ${c.pct}%`}></div>
                </div>
              </div>
            ))}
          </div>
          <p class="mt-4 text-xs text-neutral-500">Google Maps = 0% car le numero de telephone n'est pas clickable sur mobile.</p>
        </div>

        <!-- Conversion par maturite -->
        <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
          <h2 class="text-base font-semibold text-neutral-900 mb-5">Conversion par niveau de maturite</h2>
          <div class="grid grid-cols-3 gap-4">
            {maturiteStats.map(m => (
              <div class="text-center p-4 rounded-lg bg-neutral-50 border border-neutral-200">
                <p class="text-2xl mb-1">{maturiteEmoji(m.level)}</p>
                <p class="text-2xl font-bold text-neutral-900">{m.pct}</p>
                <p class="text-xs text-neutral-500 mt-0.5">{m.level}</p>
                <p class="text-xs text-neutral-400">{m.conv}/{m.total} personas</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Conversion par device -->
        <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
          <h2 class="text-base font-semibold text-neutral-900 mb-4">Conversion par device</h2>
          <div class="grid grid-cols-2 gap-4">
            <div class="p-4 rounded-lg bg-emerald-50 border border-emerald-200 text-center">
              <p class="text-3xl mb-1">💻</p>
              <p class="text-2xl font-bold text-emerald-700">67%</p>
              <p class="text-sm text-neutral-600 mt-0.5">Desktop</p>
              <p class="text-xs text-neutral-500">8/12 personas convertissent</p>
            </div>
            <div class="p-4 rounded-lg bg-red-50 border border-red-200 text-center">
              <p class="text-3xl mb-1">📱</p>
              <p class="text-2xl font-bold text-red-600">13%</p>
              <p class="text-sm text-neutral-600 mt-0.5">Mobile</p>
              <p class="text-xs text-neutral-500">1/8 personas convertit</p>
            </div>
          </div>
          <p class="mt-3 text-xs text-neutral-500">L'ecart desktop/mobile est critique. Le site WordPress est concu pour desktop — les visiteurs mobiles quittent massivement.</p>
        </div>

      </div>
    </section>

    <!-- ═══════════════════ PANEL 2 : TECHNIQUE ═══════════════════ -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0 bg-neutral-50 py-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto space-y-8">

        <!-- PageSpeed -->
        <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
          <h2 class="text-base font-semibold text-neutral-900 mb-2">Performance — PageSpeed Insights</h2>
          <p class="text-xs text-neutral-500 mb-5">L'API Google PageSpeed a atteint son quota journalier lors de l'audit. Mesures a effectuer sur <a href="https://pagespeed.web.dev/" target="_blank" class="text-blue-600 underline">pagespeed.web.dev</a>. Estimation ci-dessous basee sur l'analyse du code source.</p>

          <div class="grid grid-cols-2 gap-6 mb-6">
            <div>
              <p class="text-xs font-semibold text-neutral-500 mb-3 uppercase tracking-wide">Mobile (estime)</p>
              <div class="grid grid-cols-2 gap-3">
                {[
                  { label: 'Performance', val: 45, color: '#f59e0b' },
                  { label: 'Accessibilite', val: 72, color: '#f59e0b' },
                  { label: 'Bonnes pratiques', val: 75, color: '#f59e0b' },
                  { label: 'SEO', val: 82, color: '#f59e0b' },
                ].map(s => (
                  <div class="text-center">
                    <div class="relative w-14 h-14 mx-auto mb-1.5">
                      <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
                        <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e5e7eb" stroke-width="3"/>
