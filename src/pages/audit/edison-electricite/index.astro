---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX — Edison Electricite Generale | Marc M.';
const description = 'Audit complet du site electricien-metz.info : 10 personas simules, WordPress/Breakdance lourd, aucun telephone ni adresse visible, zero temoignage, recommandations actionnables pour electricien Montigny-les-Metz.';

// ─── PROSPECT ───
const prospect = {
  name: 'Edison - Electricite Generale',
  url: 'https://electricien-metz.info/',
  date: '29 mars 2026',
  activity: 'Electricien — Electricite generale, Depannage 24/7',
  location: 'Montigny-les-Metz (57) — Metz Metropole, Grand Est',
};

// ─── KPIs ───
const kpis = {
  conversion: 20,
  experience: 4.4,
  confiance: 3.9,
  clarte: 4.8,
};

// ─── CONSTAT ───
const constat = "Le site presente 10 services et 13 realisations photo, mais ne convertit qu'un visiteur sur cinq : aucun telephone visible, aucune adresse, zero temoignage, descriptions generiques sans ancrage local — et une page contact sans coordonnees qui oblige le visiteur a remplir un formulaire a l'aveugle.";

// ─── CONVERSION PAR CANAL ───
const conversionByCanal = [
  { canal: 'Bouche-a-oreille', taux: 60, color: 'text-green-600', bg: 'bg-green-500' },
  { canal: 'Google Maps / GBP', taux: 40, color: 'text-green-600', bg: 'bg-green-500' },
  { canal: 'Google Search', taux: 10, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'Reseaux sociaux', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'IA (ChatGPT / Perplexity)', taux: 0, color: 'text-red-700', bg: 'bg-red-700' },
  { canal: 'Autre (direct)', taux: 20, color: 'text-amber-600', bg: 'bg-amber-500' },
];

// ─── TOP FRICTIONS ───
const topFrictions = [
  { titre: 'Aucun telephone visible sur le site', count: 10, detail: 'Pas de numero de telephone en header, footer, ni sur la page contact. Pour un electricien proposant du depannage 24/7, c\'est un frein majeur — les urgences appellent, elles ne remplissent pas de formulaire.' },
  { titre: 'Aucune adresse physique ni zone d\'intervention', count: 9, detail: 'Montigny-les-Metz n\'apparait nulle part. Le mot "Metz" est dans le titre SEO mais pas dans le contenu visible. Le visiteur ne sait pas ou l\'entreprise se situe ni si elle intervient chez lui.' },
  { titre: 'Zero temoignage ni avis client', count: 9, detail: 'Aucun verbatim, aucun avis Google integre, aucune note — les visiteurs en phase de comparaison n\'ont aucune preuve sociale pour se decider.' },
  { titre: 'Descriptions de services generiques sans specificite', count: 7, detail: 'Les 10 services sont decrits en une phrase marketing creuse ("Offrez une dimension nouvelle a vos espaces"). Pas de chiffres, pas d\'exemples concrets, pas de tarifs indicatifs.' },
  { titre: 'Page contact sans coordonnees', count: 8, detail: 'La page contact ne contient qu\'un formulaire et des liens Facebook/Instagram. Pas de telephone, pas d\'email, pas d\'adresse, pas d\'horaires, pas de carte — un visiteur presse ne peut pas appeler.' },
];

// ─── PAGESPEED ───
const pagespeed = {
  mobile: { performance: 40, accessibility: 72, bestPractices: 78, seo: 85 },
  desktop: { performance: 62, accessibility: 72, bestPractices: 78, seo: 85 },
};
const coreWebVitals = [
  { name: 'LCP mobile', value: '~3,8 s', status: 'rouge' },
  { name: 'INP/TBT', value: '~250 ms', status: 'orange' },
  { name: 'CLS', value: '~0,15', status: 'orange' },
  { name: 'FCP', value: '~2,5 s', status: 'orange' },
  { name: 'TTFB', value: '~0,6 s', status: 'orange' },
];

// ─── OBSERVATORY ───
const observatory = { grade: 'B+', score: 80, testsPassed: 9, testsTotal: 10 };

// ─── CHECKLIST TECHNIQUE ───
const techChecks = [
  { label: 'HTTPS + HTTP/2 actif', present: true, critical: false },
  { label: 'Meta title + description (Yoast)', present: true, critical: false },
  { label: 'Open Graph image + tags complets', present: true, critical: false },
  { label: 'robots.txt + sitemap.xml accessibles', present: true, critical: false },
  { label: 'HSTS (Strict-Transport-Security)', present: true, critical: false },
  { label: 'X-Content-Type-Options: nosniff', present: true, critical: false },
  { label: 'Referrer-Policy + Permissions-Policy', present: true, critical: false },
  { label: 'Schema.org type Electrician / LocalBusiness', present: false, critical: true },
  { label: 'NAP (Name, Address, Phone) visible', present: false, critical: true },
  { label: 'Telephone cliquable en header', present: false, critical: true },
  { label: 'Temoignages / avis clients visibles', present: false, critical: true },
  { label: 'FAQ structuree (Schema FAQPage)', present: false, critical: true },
  { label: 'Images avec alt descriptif (pas IMG_...)', present: false, critical: false },
  { label: 'CSP stricte (default-src)', present: false, critical: false },
  { label: 'PHP version masquee (X-Powered-By)', present: false, critical: false },
  { label: 'llms.txt pour visibilite IA', present: false, critical: false },
];

// ─── PERSONAS ───
const personas = [
  {
    id: 1,
    name: 'Gerard',
    age: 65,
    emoji: '\u{1F3E0}',
    canal: 'Google Search',
