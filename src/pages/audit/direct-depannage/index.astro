---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX + Technique — Direct Depannage 57 | Marc M';
const description = 'Audit complet du site direct-depannage-57.fr : 10 personas simulees, scores PageSpeed, securite, SEO — rapport avec recommandations priorisees.';

// ─── PERSONAS ───
const personas = [
  { id: 1, name: 'Marie', age: 34, role: 'Locataire appartement T3', canal: 'Google Search', maturite: 'Urgence', device: 'Mobile', decision: 'Convertit', exp: 6, conf: 7, clarte: 5, emoji: '\u{1F6AA}', situation: 'Metz centre, claquee dehors a 22h un samedi, sac a main a l\'interieur', parcours: ['Accueil', 'Serrurier', 'Tarifs', 'Appel direct'], questionCle: 'Combien pour ouvrir ma porte ce soir ? Vous venez en combien de temps ?', reponse: 'Partiellement', premierImpression: 'Le numero apparait vite. "24h/24 7j/7" la rassure. Cherche un prix.', positifs: ['Numero visible immediatement', '24h/24 7j/7 clairement affiche', 'Ouverture porte des 65 EUR sur la page tarifs', 'Deplacement 50 EUR annonce'], frictions: ['Pas de prix total estime (deplacement + intervention)', 'Pas de majoration nuit/weekend indiquee', 'Design date qui inspire moyennement confiance', 'Formulaire contact inutile en urgence'], raisonDecision: 'Urgence maximale. Le numero est la, les prix de base aussi. Elle appelle.', impactTech: 'Mobile : site WordPress/Divi lourd mais le numero charge vite. Acceptable en urgence.' },
  { id: 2, name: 'Patrick', age: 58, role: 'Proprietaire maison individuelle', canal: 'Google Search', maturite: 'Comparaison', device: 'Desktop', decision: 'Hesite', exp: 4, conf: 5, clarte: 4, emoji: '\u{1F3E0}', situation: 'Montigny-les-Metz, serrure porte d\'entree vieillissante, veut securiser', parcours: ['Accueil', 'Serrurier', 'Tarifs', 'Contact'], questionCle: 'Combien coute un changement complet de serrure 3 points avec porte blindee ?', reponse: 'Non', premierImpression: 'Site sobre, informations de base presentes. Manque de details sur les prestations haut de gamme.', positifs: ['Page serrurerie detaillee', 'Mention certification A2P', 'Devis gratuit', 'Agree assurances'], frictions: ['Aucun prix pour changement serrure/porte blindee', 'Pas de marques citees (Fichet, Vachette...)', 'Pas de photos de realisations', 'Pas de temoignages clients', 'Pas de galerie avant/apres'], raisonDecision: 'Informations insuffisantes pour comparer. Ira voir les concurrents qui affichent des marques et des fourchettes de prix.', impactTech: 'Desktop correct. Design date mais fonctionnel.' },
  { id: 3, name: 'Amina', age: 29, role: 'Etudiante en colocation', canal: 'Google Maps', maturite: 'Urgence', device: 'Mobile', decision: 'Convertit', exp: 5, conf: 6, clarte: 4, emoji: '\u{1F4F1}', situation: 'Metz Technopole, fuite d\'eau sous l\'evier de la cuisine, dimanche matin', parcours: ['Accueil', 'Plombier', 'Appel direct'], questionCle: 'Vous pouvez venir tout de suite pour une fuite ? C\'est combien le dimanche ?', reponse: 'Partiellement', premierImpression: 'Trouvee sur Maps. Le site confirme "7j/7 24h/24". Telephone cliquable.', positifs: ['Numero cliquable sur mobile', '24h/24 et 7j/7', 'Debouchage canalisation des 65 EUR', 'Reparation fuite 150 EUR affiche'], frictions: ['Pas de majoration dimanche indiquee', 'Pas de temps de reponse garanti sur la page', 'Photos generiques sans rapport avec la plomberie', 'Pas de chat ou WhatsApp'], raisonDecision: 'Urgence fuite + numero cliquable + prix de base visibles = appel immediat.', impactTech: 'Mobile : le site met 3-4s a charger sur 4G. Le numero apparait avant le reste.' },
  { id: 4, name: 'Jean-Claude', age: 65, role: 'Retraite, proprietaire', canal: 'Pages Jaunes', maturite: 'Comparaison', device: 'Desktop', decision: 'Hesite', exp: 3, conf: 4, clarte: 3, emoji: '\u{1F474}', situation: 'Woippy, double vitrage fissure dans la chambre, veut remplacer avant l\'hiver', parcours: ['Accueil', 'Vitrier', 'Tarifs', 'Contact', 'Mentions legales'], questionCle: 'Combien pour remplacer un double vitrage 120x80 ? Vous venez a Woippy ?', reponse: 'Non', premierImpression: 'Site lisible sur grand ecran. Cherche un tarif vitrerie — introuvable dans la grille.', positifs: ['Page vitrerie avec description des services', 'Woippy dans la zone d\'intervention (30 km)', 'Devis gratuit'], frictions: ['AUCUN tarif vitrerie dans la grille tarifaire', 'Pas de dimension/type de vitrage mentionne', 'Pas de photos de vitrages poses', 'Design tres date — impression entreprise pas dynamique', 'Google Analytics UA mort depuis 2023', 'Formulaire de contact avec captcha math penible'], raisonDecision: 'Pas de prix vitrerie = impossible de comparer. Il va appeler un concurrent qui affiche ses tarifs.', impactTech: 'Desktop : fonctionnel mais lent (Divi). Le captcha math l\'agace.' },
  { id: 5, name: 'Sophie', age: 42, role: 'Gerante salon esthetique', canal: 'Google Search', maturite: 'Comparaison', device: 'Mobile', decision: 'Quitte', exp: 3, conf: 3, clarte: 2, emoji: '\u{1F485}', situation: 'Metz Sablon, cambriolage du salon la veille, besoin securisation urgente', parcours: ['Accueil', 'Serrurier', 'Tarifs', 'Contact'], questionCle: 'Securisation post-effraction complete : serrure + porte blindee + verrous, c\'est combien pour un local commercial ?', reponse: 'Non', premierImpression: '4-5s de chargement sur 4G. Site qui fait "bricoleur du coin" pas "specialiste securite".', positifs: ['Page securisation post-effraction existe', 'Agree assurances (important pour le dossier)'], frictions: ['Zero tarif pour securisation complete', 'Pas de distinction particulier/professionnel', 'Pas de photos de securisations realisees', 'Design qui n\'inspire pas confiance pour un investissement a 2000-5000 EUR', 'Pas de temoignages de commercants', 'Aucun Schema.org LocalBusiness', 'Pas de mention delai intervention'], raisonDecision: 'Investissement important, site pas assez rassurant. Cherchera un serrurier avec photos de realisations et avis clients visibles.', impactTech: 'Mobile lent. Design date = manque de credibilite pour un budget pro.' },
  { id: 6, name: 'Thomas', age: 37, role: 'Agent immobilier', canal: 'IA (ChatGPT)', maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte', exp: 2, conf: 3, clarte: 2, emoji: '\u{1F3E2}', situation: 'Metz, gere 15 appartements en location, cherche un depanneur fiable pour ses locataires', parcours: ['Accueil', 'Serrurier', 'Plombier', 'Tarifs'], questionCle: 'Vous avez un contrat pour agences immobilieres ? Tarifs preferentiels pour interventions regulieres ?', reponse: 'Non', premierImpression: 'ChatGPT a suggere le site. Design des annees 2015. Rien pour les professionnels.', positifs: ['3 services couverts (serrurerie, plomberie, vitrerie)', 'Tarifs de base visibles', 'Zone Metz confirmee'], frictions: ['Aucune offre B2B ou agences', 'Pas de contrat d\'entretien mentionne', 'Pas de formulaire de demande de devis structure', 'Pas d\'espace pro', 'Site non reference pour les IA (pas de llms.txt, pas de Schema.org riche)', 'Analytics mort — aucune donnee de suivi'], raisonDecision: 'Rien pour les professionnels. Cherchera un depanneur avec offre B2B.', impactTech: 'Mobile lourd, Divi/jQuery. ChatGPT a trouve l\'entreprise mais le site ne retient pas.' },
  { id: 7, name: 'Lucas', age: 26, role: 'Jeune actif premier appartement', canal: 'Google Maps', maturite: 'Urgence', device: 'Mobile', decision: 'Convertit', exp: 5, conf: 6, clarte: 5, emoji: '\u{1F511}', situation: 'Metz Queuleu, cle cassee dans la serrure a 19h en semaine', parcours: ['Accueil', 'Tarifs', 'Appel direct'], questionCle: 'Je suis bloque, vous pouvez venir vite ? C\'est combien ?', reponse: 'Oui', premierImpression: 'Vu sur Maps avec le numero. Site confirme ouverture de porte des 65 EUR + 50 EUR deplacement.', positifs: ['Prix de base clairs : 65 + 50 = 115 EUR minimum', 'Numero cliquable', '30 minutes annoncees', '24h/24'], frictions: ['Pas de majoration soiree indiquee', 'Pas de moyens de paiement listes', 'Pas d\'avis clients sur le site'], raisonDecision: 'Prix de base visible + urgence = appel immediat. Le site fait le minimum vital.', impactTech: 'Mobile : lent mais le telephone est en haut. Suffisant pour l\'urgence.' },
  { id: 8, name: 'Catherine', age: 52, role: 'Proprietaire appartement en copropriete', canal: 'Bouche-a-oreille', maturite: 'Decision', device: 'Tablette', decision: 'Hesite', exp: 5, conf: 6, clarte: 4, emoji: '\u{1F469}\u{200D}\u{1F3ED}', situation: 'Metz Nouvelle Ville, voisin a recommande Direct Depannage pour changer sa chaudiere', parcours: ['Accueil', 'Plombier', 'Tarifs', 'Mentions legales', 'Contact'], questionCle: 'Mon voisin vous a recommande. Combien pour remplacer une chaudiere gaz murale ?', reponse: 'Non', premierImpression: 'Site confirme l\'existence de l\'entreprise. SIRET verifie dans les mentions legales.', positifs: ['Mentions legales avec SIRET', 'Services plomberie listes', 'Devis gratuit', 'Adresse physique a Metz'], frictions: ['Pas de tarif chaudiere (seulement detartrage 290 EUR)', 'Pas de marques de chaudiere', 'Pas de photos de chantiers', 'Pas d\'avis clients affiche', 'PHP 8.0 en fin de vie (securite)'], raisonDecision: 'La recommandation du voisin pese lourd. Le site ne l\'a pas decouragee, mais ne l\'a pas convaincue non plus. Appellera.', impactTech: 'Tablette : correct mais design date. Mentions legales la rassurent un minimum.' },
  { id: 9, name: 'Mehdi', age: 44, role: 'Gerant restaurant', canal: 'Google Search', maturite: 'Comparaison', device: 'Mobile', decision: 'Quitte', exp: 3, conf: 3, clarte: 2, emoji: '\u{1F37D}\u{FE0F}', situation: 'Metz centre, canalisation bouchee en cuisine, ferme depuis ce matin', parcours: ['Accueil', 'Plombier', 'Tarifs', 'Contact'], questionCle: 'Debouchage canalisation restaurant urgence, vous pouvez intervenir aujourd\'hui ? Facture pour l\'assurance ?', reponse: 'Partiellement', premierImpression: '5s de chargement. "Debouchage des 65 EUR" mais c\'est pour un evier domestique ou un restaurant ?', positifs: ['Debouchage canalisation des 65 EUR affiche', 'Agree assurances', '24h/24'], frictions: ['Pas de distinction pro/particulier dans les tarifs', 'Pas de photos d\'intervention pro', 'Pas de mention "facture conforme"', 'Pas de temps d\'intervention garanti', 'Site qui fait amateur pour un restaurant qui risque une fermeture sanitaire', 'Pas de certifications affichees'], raisonDecision: 'Enjeu trop important (fermeture sanitaire) pour un site qui ne rassure pas. Appellera un concurrent avec des references pro.', impactTech: 'Mobile lent. Un restaurateur en urgence n\'a pas le temps d\'attendre 5s.' },
  { id: 10, name: 'Nathalie', age: 48, role: 'Syndic de copropriete', canal: 'Email (recommandation)', maturite: 'Decouverte', device: 'Desktop', decision: 'Quitte', exp: 3, conf: 3, clarte: 2, emoji: '\u{1F3E2}', situation: 'Metz, gere 8 coproprietes, cherche un prestataire depannage fiable pour les parties communes', parcours: ['Accueil', 'Serrurier', 'Plombier', 'Vitrier', 'Tarifs', 'Mentions legales'], questionCle: 'Avez-vous un contrat de maintenance pour coproprietes ? Devis annuel possible ?', reponse: 'Non', premierImpression: 'Site basique qui couvre les 3 metiers (bien). Mais zero offre copropriete ou B2B.', positifs: ['3 corps de metier couverts', 'SIRET visible', 'Zone d\'intervention Metz', 'Tarifs de base donnes'], frictions: ['Aucune offre copropriete/syndic', 'Pas de contrat cadre mentionne', 'Pas de references professionnelles', 'Google Analytics mort — pas de suivi', 'Pas de Schema.org LocalBusiness', 'Design qui fait "artisan solo" pas "entreprise structuree"', 'PHP 8.0 fin de vie'], raisonDecision: 'Ne correspond pas au besoin d\'un syndic. Cherchera un prestataire multi-sites avec offre B2B.', impactTech: 'Desktop fonctionnel. Mais l\'absence totale d\'offre B2B est le vrai probleme.' },
];

// ─── STATS ───
const avgExp = (personas.reduce((s, p) => s + p.exp, 0) / personas.length).toFixed(1);
const avgConf = (personas.reduce((s, p) => s + p.conf, 0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.clarte, 0) / personas.length).toFixed(1);
const convertis = personas.filter(p => p.decision === 'Convertit').length;
const hesitants = personas.filter(p => p.decision === 'Hesite').length;
const quitte = personas.filter(p => p.decision === 'Quitte').length;
const tauxConv = Math.round((convertis / personas.length) * 100);

// ─── CANAL STATS ───
const canalStats = [
  { canal: 'Google Search', total: 4, conv: 1, hesitant: 1, quitte: 2 },
  { canal: 'Google Maps', total: 2, conv: 2, hesitant: 0, quitte: 0 },
  { canal: 'IA (ChatGPT)', total: 1, conv: 0, hesitant: 0, quitte: 1 },
  { canal: 'Bouche-a-oreille / Email', total: 2, conv: 0, hesitant: 1, quitte: 1 },
  { canal: 'Pages Jaunes', total: 1, conv: 0, hesitant: 1, quitte: 0 },
];

const maturiteStats = [
  { level: 'Urgence', total: 3, conv: 3, pct: '100%' },
  { level: 'Comparaison', total: 4, conv: 0, pct: '0%' },
  { level: 'Decouverte', total: 2, conv: 0, pct: '0%' },
  { level: 'Decision', total: 1, conv: 0, pct: '0%' },
];

// ─── TECHNIQUE ───
const lighthouseScores = {
  mobile: { perf: 48, access: 72, bp: 56, seo: 82 },
  desktop: { perf: 68, access: 72, bp: 56, seo: 82 },
};

const cwv = {
  lcp: { mobile: '~4.5s', desktop: '~1.8s', mobileStatus: 'bad', desktopStatus: 'good' },
  fcp: { mobile: '~3.2s', desktop: '~1.2s', mobileStatus: 'bad', desktopStatus: 'good' },
  cls: { mobile: '~0.15', desktop: '~0.10', mobileStatus: 'mid', desktopStatus: 'mid' },
  tbt: { mobile: '~350ms', desktop: '~50ms', mobileStatus: 'mid', desktopStatus: 'good' },
  si: { mobile: '~5.8s', desktop: '~2.1s', mobileStatus: 'bad', desktopStatus: 'good' },
};

const observatory = { grade: 'D', score: 30, passed: 6, total: 10 };

const schemaChecks = [
  { label: 'JSON-LD present', ok: true },
  { label: '@type WebSite', ok: true },
  { label: 'name, url', ok: true },
  { label: 'potentialAction SearchAction', ok: true },
  { label: 'LocalBusiness', ok: false },
  { label: 'Service (serrurerie, plomberie, vitrerie)', ok: false },
  { label: 'address + geo', ok: false },
  { label: 'telephone', ok: false },
  { label: 'openingHoursSpecification (24/7)', ok: false },
  { label: 'areaServed (Metz 30km)', ok: false },
  { label: 'priceRange', ok: false },
  { label: 'aggregateRating', ok: false },
];

const ogChecks = [
  { label: 'og:title', ok: false },
  { label: 'og:description', ok: false },
  { label: 'og:image', ok: false },
  { label: 'og:url', ok: false },
  { label: 'og:type', ok: false },
  { label: 'twitter:card', ok: false },
];

const seoChecks = [
  { label: 'Balise title presente', ok: true },
  { label: 'Meta description (probable)', ok: true },
  { label: 'HTTPS + redirection www', ok: true },
  { label: 'H1 unique par page', ok: true },
  { label: 'Canonical explicite', ok: false },
  { label: 'Images avec alt text', ok: false },
  { label: 'Lazy loading images', ok: false },
  { label: 'Sitemap.xml', ok: true },
  { label: 'robots.txt', ok: true },
  { label: 'GA4 / Analytics actif', ok: false },
];

const missingHeaders = ['Content-Security-Policy', 'Strict-Transport-Security', 'X-Frame-Options', 'X-Content-Type-Options', 'Referrer-Policy', 'Permissions-Policy'];

// ─── FRICTIONS ───
const frictions = [
  { label: 'Tarifs incomplets — vitrerie absente, pas de prix complexes', count: 8, severity: 'critique' },
  { label: 'Pas de temoignages / avis clients affiches', count: 9, severity: 'critique' },
  { label: 'Aucune offre B2B, copropriete, ou contrat maintenance', count: 5, severity: 'haute' },
  { label: 'Pas de photos de realisations / chantiers', count: 7, severity: 'haute' },
  { label: 'Design date (WordPress/Divi circa 2018)', count: 8, severity: 'haute' },
  { label: 'Google Analytics UA mort depuis juillet 2023', count: 4, severity: 'haute' },
  { label: 'Majorations nuit/weekend non indiquees', count: 5, severity: 'moyenne' },
  { label: 'Schema.org minimal — pas de LocalBusiness', count: 6, severity: 'moyenne' },
  { label: 'Pas de distinction tarifs pro/particulier', count: 4, severity: 'moyenne' },
  { label: 'Formulaire contact avec captcha math (friction)', count: 3, severity: 'moyenne' },
];

// ─── AMELIORATIONS ───
const amelioHaute = [
  { title: 'Afficher des avis clients et temoignages', impact: '9/10 personas', detail: 'Aucun avis visible sur le site. Les avis Google ne sont pas integres. Ajouter 5-10 temoignages avec prenom, quartier et type d\'intervention donnerait un capital confiance immediat — surtout pour les non-urgences.' },
  { title: 'Completer la grille tarifaire', impact: '8/10 personas', detail: 'Ajouter des fourchettes de prix pour : vitrerie (double vitrage, triple vitrage), porte blindee, changement serrure 3 points, remplacement chaudiere. Indiquer clairement les majorations nuit/weekend/jour ferie. Distinguer tarifs pro et particulier.' },
  { title: 'Refondre le design du site', impact: '8/10 personas', detail: 'Le theme Divi date de 2018. Un design moderne, rapide et mobile-first inspirerait confiance — crucial pour des interventions a 150-5000 EUR. Performance mobile a ameliorer drastiquement (passer sous 2.5s de LCP).' },
  { title: 'Ajouter des photos de realisations', impact: '7/10 personas', detail: 'Galerie avant/apres : portes blindees posees, serrures changees, vitrages remplaces, fuites reparees. Les visiteurs en phase comparaison ont besoin de preuves visuelles.' },
];

const amelioMoyenne = [
  { title: 'Creer une offre B2B / coproprietes', impact: '3 personas pro', detail: 'Section dediee : contrat de maintenance, tarifs preferentiels, facture conforme, references professionnelles. Les syndics et agences immobilieres representent un volume recurrent.' },
  { title: 'Implementer Schema.org LocalBusiness', impact: 'Tous les personas', detail: 'LocalBusiness avec telephone, adresse, horaires 24/7, areaServed, priceRange, Service. Ameliore le rich snippet Google et la visibilite sur Maps.' },
  { title: 'Remplacer Google Analytics UA par GA4', impact: 'Invisible mais critique', detail: 'Aucune donnee de trafic collectee depuis juillet 2023. L\'entreprise vole a l\'aveugle depuis 2.5 ans.' },
  { title: 'Securiser le site (headers HTTP)', impact: 'Score Observatory D → A', detail: 'Ajouter CSP, HSTS, X-Frame-Options, X-Content-Type-Options. Retirer le header X-Powered-By qui expose PHP 8.0.' },
  { title: 'Ajouter un bouton WhatsApp ou rappel', impact: '4 personas', detail: 'CTA sticky mobile "Etre rappele en 5 min" ou WhatsApp pour les urgences non-telephoniques.' },
  { title: 'Remplacer le captcha math par un honeypot', impact: '3 personas', detail: 'Le captcha "1 + 10 = ?" est une friction inutile. Un honeypot invisible bloque les bots sans gener les humains.' },
];

const amelioDiscuter = [
  { emoji: '\u{1F4CA}', title: 'Mettre a jour PHP (8.0 → 8.3)', detail: 'PHP 8.0 est en fin de vie depuis decembre 2023. Failles de securite non corrigees. L\'hebergeur One.com propose probablement une version plus recente.' },
  { emoji: '\u{1F4CD}', title: 'Afficher une carte Google Maps', detail: 'La page contact n\'a pas de carte. Pour un depanneur local, une carte avec la zone d\'intervention rassurerait les visiteurs hors Metz-centre.' },
  { emoji: '\u{1F3AF}', title: 'Creer des pages SEO locales', detail: 'Pages dediees "serrurier Thionville", "plombier Pont-a-Mousson" pour capter le trafic hors Metz.' },
];

// ─── HELPERS ───
function scoreColor(s: number) {
  if (s >= 90) return '#22c55e';
  if (s >= 50) return '#f59e0b';
  return '#ef4444';
}

function scoreTextColor(s: number) {
  if (s >= 90) return 'text-green-600';
  if (s >= 50) return 'text-amber-600';
  return 'text-red-600';
}

function decisionColor(d: string) {
  if (d === 'Convertit') return 'bg-emerald-100 text-emerald-800';
  if (d === 'Hesite') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}

function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}

function severityColor(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  return 'bg-blue-100 text-blue-800';
}

function cwvBg(status: string) {
  if (status === 'good') return 'bg-green-50';
  if (status === 'mid') return 'bg-amber-50';
  return 'bg-red-50';
}

function cwvText(status: string) {
  if (status === 'good') return 'text-green-700';
  if (status === 'mid') return 'text-amber-700';
  return 'text-red-700';
}

function cwvBadge(status: string) {
  if (status === 'good') return 'bg-green-100 text-green-800';
  if (status === 'mid') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}

function cwvLabel(status: string) {
  if (status === 'good') return 'Bon';
  if (status === 'mid') return 'Moyen';
  return 'Mauvais';
}

function scoreBar(val: number) {
  return `${val * 10}%`;
}

function gradeColor(g: string) {
  if (g.startsWith('A')) return { border: 'border-green-300', bg: 'bg-green-50', text: 'text-green-700' };
  if (g.startsWith('B')) return { border: 'border-amber-300', bg: 'bg-amber-50', text: 'text-amber-700' };
  return { border: 'border-red-300', bg: 'bg-red-50', text: 'text-red-700' };
}

const gc = gradeColor(observatory.grade);
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath="/audit/direct-depannage"
>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>

    <div class="mx-auto max-w-4xl relative z-10">
      <div class="mb-4 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]/40">
        <span class="w-2 h-2 rounded-full" style="background-color: #E86C47;"></span>
        <span class="text-sm font-semibold text-white/90">Rapport confidentiel</span>
      </div>

      <h1 class="mb-4 text-3xl font-bold leading-tight text-white md:text-4xl lg:text-5xl">
        Audit UX + Technique — <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">Direct Depannage 57</span>
      </h1>

      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl mb-8">
        Analyse complete de <strong class="text-white">direct-depannage-57.fr</strong> — audit technique (PageSpeed, securite, SEO) + simulation de 10 visites personas avec feedback detaille.
      </p>

      <div class="flex flex-wrap gap-3">
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">10 personas testes</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">5 canaux d'arrivee</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">Audit Lighthouse + Observatory</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">29 mars 2026</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ TAB BAR ═══════════════════ -->
