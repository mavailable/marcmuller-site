---

<BaseLayout
  title="Audit UX + Technique — Coco-Eco | Marc M. Agence Web"
  description="Rapport confidentiel : audit UX et technique du site coco-eco.fr — 20 personas simulees, 4 onglets interactifs, ameliorations priorisees."
  noindex={true}
  lang="fr"
  frPath="/audit/coco-eco/"
>

  <!-- HERO -->
  <section class="bg-neutral-900 text-white py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-4">Rapport confidentiel</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-3">Audit UX + Technique — Coco-Eco</h1>
      <p class="text-neutral-300 mb-5 max-w-2xl">
        Marketplace d'oeufs a couver de races pures &mdash; <a href="https://coco-eco.fr/" class="text-amber-400 hover:underline" target="_blank" rel="noopener">coco-eco.fr</a>
      </p>
      <div class="flex flex-wrap gap-2 text-xs">
        <span class="bg-white/10 px-3 py-1 rounded-full">20 personas simulees</span>
        <span class="bg-white/10 px-3 py-1 rounded-full">6 canaux d'arrivee</span>
        <span class="bg-white/10 px-3 py-1 rounded-full">29 mars 2026</span>
        <span class="bg-white/10 px-3 py-1 rounded-full">Taux de conversion : 25%</span>
      </div>
    </div>
  </section>

  <!-- TAB BAR STICKY -->
  <nav class="sticky top-16 md:top-20 z-40 bg-white/95 backdrop-blur border-b border-neutral-200" id="tab-bar">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 h-12 text-sm overflow-x-auto">
      <button data-tab="0" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-primary-700 bg-primary-50">Synthese</button>
      <button data-tab="1" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">Technique</button>
      <button data-tab="2" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">
        Visiteurs <span class="ml-1 text-xs text-neutral-400">20</span>
      </button>
      <button data-tab="3" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">
        Ameliorations <span class="ml-1 text-xs text-neutral-400">9</span>
      </button>
    </div>
  </nav>

  <!-- PANELS CONTAINER -->
  <div id="panels" class="flex overflow-x-auto snap-x snap-mandatory" style="-webkit-overflow-scrolling: touch; scrollbar-width: none;">

    <!-- PANEL 1 : SYNTHESE -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0 py-10 px-4">
      <div class="max-w-5xl mx-auto space-y-10">

        <!-- KPI CARDS -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center shadow-sm">
            <span class="block text-3xl font-black text-amber-500">{kpis.conversion}%</span>
            <span class="text-xs text-neutral-500 mt-1 block">Taux de conversion</span>
          </div>
          <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center shadow-sm">
            <span class="block text-3xl font-black text-amber-500">{kpis.experience}/10</span>
            <span class="text-xs text-neutral-500 mt-1 block">Score experience</span>
          </div>
          <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center shadow-sm">
            <span class="block text-3xl font-black text-amber-500">{kpis.confiance}/10</span>
            <span class="text-xs text-neutral-500 mt-1 block">Score confiance</span>
          </div>
          <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center shadow-sm">
            <span class="block text-3xl font-black text-amber-500">{kpis.clarte}/10</span>
            <span class="text-xs text-neutral-500 mt-1 block">Score clarte</span>
          </div>
        </div>

        <!-- PARADOXE PRINCIPAL -->
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-5">
          <h2 class="font-semibold text-amber-900 mb-2 flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Paradoxe principal
          </h2>
          <p class="text-amber-800 text-sm">{paradox}</p>
        </div>

        <!-- CONVERSION PAR CANAL -->
        <div>
          <h2 class="font-heading text-lg font-bold text-neutral-900 mb-4">Conversion par canal d'arrivee</h2>
          <div class="space-y-3">
            {conversionByCanal.map(item => (
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm text-neutral-700">{item.canal}</span>
                  <span class={`text-sm font-bold ${item.color === 'green' ? 'text-green-600' : item.color === 'orange' ? 'text-amber-600' : 'text-red-500'}`}>{item.taux}%</span>
                </div>
                <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
                  <div
                    class={`h-full rounded-full ${item.color === 'green' ? 'bg-green-500' : item.color === 'orange' ? 'bg-amber-400' : 'bg-red-400'}`}
                    style={`width: ${item.taux}%`}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- CONVERSION PAR MATURITE + DEVICE -->
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <h2 class="font-heading text-lg font-bold text-neutral-900 mb-4">Par maturite</h2>
            <div class="grid grid-cols-3 gap-3">
              {conversionByMaturite.map(item => (
                <div class="bg-white border border-neutral-200 rounded-xl p-3 text-center">
                  <span class={`block text-xl font-black ${item.taux >= 40 ? 'text-green-600' : item.taux >= 20 ? 'text-amber-500' : 'text-red-500'}`}>{item.taux}%</span>
                  <span class="text-xs text-neutral-500 block mt-0.5">{item.label}</span>
                  <span class="text-[10px] text-neutral-400">{item.convertis}/{item.total}</span>
                </div>
              ))}
            </div>
          </div>
          <div>
            <h2 class="font-heading text-lg font-bold text-neutral-900 mb-4">Par device</h2>
            <div class="grid grid-cols-3 gap-3">
              {conversionByDevice.map(item => (
                <div class="bg-white border border-neutral-200 rounded-xl p-3 text-center">
                  <span class={`block text-xl font-black ${item.taux >= 40 ? 'text-green-600' : item.taux >= 20 ? 'text-amber-500' : 'text-red-500'}`}>{item.taux}%</span>
                  <span class="text-xs text-neutral-500 block mt-0.5">{item.label}</span>
                  <span class="text-[10px] text-neutral-400">{item.convertis}/{item.total}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- FRICTIONS RECURRENTES -->
        <div>
          <h2 class="font-heading text-lg font-bold text-neutral-900 mb-4">Frictions les plus citees</h2>
          <div class="space-y-2">
            {[
              { label: 'Blog inactif depuis 2020 — signal "plateforme abandonnee"', n: 9, sev: 'critique' },
              { label: 'Aucune preuve sociale (stats, temoignages) en page d\'accueil', n: 7, sev: 'critique' },
              { label: 'Absence de numero de telephone public', n: 6, sev: 'critique' },
              { label: 'Pas d\'indicateur d\'activite recente visible', n: 5, sev: 'haute' },
              { label: 'Prix non visibles au niveau des categories', n: 5, sev: 'haute' },
              { label: 'Double H1 en page d\'accueil', n: 5, sev: 'haute' },
              { label: 'Pas de guide "quelle race pour debuter ?"', n: 4, sev: 'haute' },
              { label: 'Open Graph absent — partages sociaux sans preview', n: 3, sev: 'haute' },
              { label: 'Meta description absente — CTR degrade dans Google', n: 3, sev: 'haute' },
            ].map(f => (
              <div class="flex items-center justify-between p-3 bg-white border border-neutral-100 rounded-lg">
                <span class="text-sm text-neutral-700 flex-1 mr-3">{f.label}</span>
                <div class="flex items-center gap-2 shrink-0">
                  <span class="text-xs text-neutral-500">{f.n} personas</span>
                  <span class={`text-[10px] px-1.5 py-0.5 rounded font-medium ${f.sev === 'critique' ? 'bg-red-100 text-red-600' : 'bg-amber-100 text-amber-600'}`}>{f.sev}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- PANEL 2 : TECHNIQUE -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0 py-10 px-4">
      <div class="max-w-5xl mx-auto space-y-8">

        <!-- PAGESPEED NOTE -->
        <div class="bg-neutral-100 border border-neutral-200 rounded-xl p-4">
          <h2 class="font-heading text-lg font-bold text-neutral-900 mb-2">PageSpeed Insights</h2>
