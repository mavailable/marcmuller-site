const ameliorationsUtiles = [
  { titre: 'Corriger le double H1 en page d\'accueil', detail: 'Deux H1 sur une meme page confondent Google sur le sujet principal. Conserver "Oeufs a couver d\'eleveur a eleveur" et transformer "Rejoignez la communaute des eleveurs" en H2.' },
  { titre: 'Ajouter meta description + balises Open Graph sur toutes les pages', detail: 'Meta description absente = resultats Google peu engageants. Open Graph absent = partages Facebook/Instagram sans image ni description. Maurice a clique par erreur — une meta precise l\'aurait filtre.' },
