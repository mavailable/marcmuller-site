        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">30 mars 2026</span>
        <span class="px-4 py-2 rounded-lg bg-red-900/60 text-red-300 text-sm font-medium">Zero Schema.org</span>
        <span class="px-4 py-2 rounded-lg bg-amber-900/50 text-amber-300 text-sm font-medium">SPA jQuery non-crawlable</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ TAB BAR ═══════════════════ -->
  <nav class="sticky top-16 md:top-20 z-40 bg-white/95 backdrop-blur border-b border-neutral-200" id="tab-bar">
