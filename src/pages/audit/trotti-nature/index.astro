    title: 'Zone d\'intervention explicite',
    impact: '4/10 personas',
    detail: 'Aucune mention de la zone d\'intervention sur le site. Plusieurs personas hesitent ou quittent en ne sachant pas si Trotti\'Nature intervient dans leur commune. Ajouter : "Nous intervenons dans un rayon de X km autour de Montigny-les-Metz : Metz, Woippy, Marly, Montigny, Plappeville, Scy-Chazelles, Ancy-sur-Moselle..."'
  },
  {
    title: 'Polices Google Fonts → locales (RGPD)',
    impact: 'RGPD + performance',
    detail: 'La police Lobster est chargee depuis fonts.googleapis.com = transfert d\'IP vers Google sans consentement, violation confirmee par la CNIL. Telecharger Lobster en woff2 et l\'heberger localement elimine ce risque legal et ameliore les performances (1 requete externe de moins).'
  },
];

const amelioDiscuter = [
  { emoji: '\u{1F4CD}', title: 'Carte zone d\'intervention', detail: 'Une carte visuelle des communes couvertes rassurerait les visiteurs en limite de zone (Woippy, Gorze, Ancy-sur-Moselle, Jouy-aux-Arches...). Simple a creer en SVG ou embed Google Maps.' },
  { emoji: '\u{1F4F8}', title: 'Portfolio Instagram + galerie site', detail: 'Le paysagisme est ultra-visuel. Un compte Instagram actif (avant/apres, saisons, conseils jardin) lierait a la galerie site et genererait du contenu frais pour le SEO et les IA.' },
  { emoji: '\u{1F4CB}', title: 'Offre contrat annuel structuree', detail: 'Coproprietes, gites, maisons secondaires = clients recurrents a fort LTV. Une section dediee avec une offre contrat annuelle (tarifs m2, nombre de passages, reporting) ouvrirait un segment B2B/semi-pro.' },
];

// ─── HELPERS ───
function scoreColor(s: number) {
  if (s >= 90) return '#22c55e';
  if (s >= 50) return '#f59e0b';
  return '#ef4444';
}

function scoreTextColor(s: number) {
  if (s >= 90) return 'text-green-600';
  if (s >= 50) return 'text-amber-600';
  return 'text-red-600';
}

function decisionColor(d: string) {
  if (d === 'Convertit') return 'bg-emerald-100 text-emerald-800';
  if (d === 'Hesite') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}

function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}

function severityColor(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  return 'bg-blue-100 text-blue-800';
}

function cwvBg(status: string) {
  if (status === 'good') return 'bg-green-50';
  if (status === 'mid') return 'bg-amber-50';
  return 'bg-red-50';
}

function cwvText(status: string) {
  if (status === 'good') return 'text-green-700';
  if (status === 'mid') return 'text-amber-700';
  return 'text-red-700';
}

function cwvBadge(status: string) {
  if (status === 'good') return 'bg-green-100 text-green-800';
  if (status === 'mid') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}

function cwvLabel(status: string) {
  if (status === 'good') return 'Bon';
  if (status === 'mid') return 'Moyen';
  return 'Mauvais';
}

function scoreBar(val: number) {
  return `${val * 10}%`;
}

function gradeColor(g: string) {
  if (g.startsWith('A')) return { border: 'border-green-300', bg: 'bg-green-50', text: 'text-green-700' };
  if (g.startsWith('B')) return { border: 'border-amber-300', bg: 'bg-amber-50', text: 'text-amber-700' };
  return { border: 'border-red-300', bg: 'bg-red-50', text: 'text-red-700' };
}

const gc = gradeColor(observatory.grade);
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath="/audit/trotti-nature"
>

  <!-- ═══════════════════ HERO ═══════════════════ -->
