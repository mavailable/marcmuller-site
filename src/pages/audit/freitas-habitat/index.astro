---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX — Freitas Habitat | Marc M';
const description = 'Simulation de 10 visites personas sur freitashabitat.com — rapport UX et technique avec recommandations priorisees.';

// ============================================================
// DONNEES PROSPECT
// ============================================================
const prospect = {
  name: 'Freitas Habitat',
  url: 'https://freitashabitat.com',
  date: '29 mars 2026',
  activity: 'Macon / Renovation — Amenagement exterieur',
  location: 'Marly (57) — Moselle, Grand Est',
};

// ============================================================
// KPIs GLOBAUX
// ============================================================
const kpis = {
  conversion: 40,
  experience: 5.9,
  confiance: 6.2,
  clarte: 5.5,
  convertissent: 4,
  hesitent: 3,
  quittent: 3,
};

const constat = "Un artisan avec 60 avis Google a 5 etoiles dont le site ne montre ni l'equipe, ni les prix indicatifs, ni une page a-propos — les visiteurs voient les belles realisations mais ne trouvent pas assez d'elements humains et concrets pour franchir le pas de la demande de devis.";

// ============================================================
// CONVERSION PAR CANAL
// ============================================================
const conversionByCanal = [
  { canal: 'Bouche-a-oreille', taux: 100, color: 'text-green-700', bg: 'bg-green-500' },
  { canal: 'Google Maps / GBP', taux: 67, color: 'text-green-600', bg: 'bg-green-400' },
  { canal: 'Google Search', taux: 33, color: 'text-amber-600', bg: 'bg-amber-400' },
  { canal: 'Reseaux sociaux', taux: 50, color: 'text-amber-600', bg: 'bg-amber-500' },
  { canal: 'IA (ChatGPT/Claude)', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
];

// ============================================================
// TOP FRICTIONS
// ============================================================
const topFrictions = [
  { titre: 'Aucun prix indicatif ni fourchette de budget', count: 8, detail: 'Pas de "a partir de", pas de fourchette par type de prestation. Les visiteurs en phase de comparaison quittent faute de pouvoir estimer le budget.' },
  { titre: 'Pas de page A propos / Pas de presentation de l\'equipe', count: 7, detail: 'L\'entreprise familiale "Freitas pere et fils" est un atout de confiance enorme, mais le site ne le met pas en avant. Aucune photo de l\'equipe, aucune histoire.' },
  { titre: 'Galerie de 45 photos sans categories ni descriptions', count: 6, detail: 'La page Realisations est un mur d\'images sans contexte — on ne sait pas quel type de projet, quels materiaux, quel budget.' },
  { titre: 'Site lent sur mobile — HTML de 358 Ko', count: 5, detail: 'La page d\'accueil fait 358 Ko de HTML (60 reviews Schema.org embarques). Sur un mobile moyen, le chargement est perceptiblement lent.' },
  { titre: 'Aucune certification ou qualification visible', count: 5, detail: 'Qualibat, RGE, assurance decennale — aucune mention. Pour les projets de renovation energetique, c\'est un critere eliminatoire.' },
];

// ============================================================
// PAGESPEED (ESTIMES — API quota depasse)
// ============================================================
const pagespeed = {
  mobile: { performance: 55, accessibility: 72, bestPractices: 78, seo: 75 },
  desktop: { performance: 72, accessibility: 72, bestPractices: 78, seo: 75 },
};

const coreWebVitals = [
  { name: 'LCP', value: '~3.8s', status: 'bad' },
  { name: 'INP', value: '~280ms', status: 'bad' },
  { name: 'CLS', value: '~0.07', status: 'good' },
];

const opportunities = [
  { label: 'Reduire la taille du HTML (60 reviews Schema.org inline)', saving: '~1.8s' },
  { label: 'Eliminer les ressources bloquantes (7 CSS Simplebo)', saving: '~1.2s' },
  { label: 'Servir les images en format WebP moderne', saving: '~0.6s' },
];

// ============================================================
// OBSERVATORY
// ============================================================
const observatory = {
  grade: 'B',
  score: 70,
  testsPassed: 8,
  testsTotal: 10,
};

// ============================================================
// CHECKLIST TECHNIQUE
// ============================================================
const techChecks = [
  { label: 'HTTPS actif + HSTS', present: true },
  { label: 'robots.txt + sitemap.xml', present: true },
  { label: 'Meta title', present: true },
  { label: 'Un seul H1 par page', present: true },
  { label: 'Schema.org HomeAndConstructionBusiness', present: true, note: '60 reviews integres — lourd mais complet' },
  { label: 'Redirect HTTP vers HTTPS', present: true },
  { label: 'Meta description', present: false, critical: true },
  { label: 'Open Graph (og:title, og:image)', present: false, critical: true },
  { label: 'Balise canonical', present: false, critical: true },
  { label: 'Content-Security-Policy (header)', present: false },
];

// ============================================================
// PERSONAS (10)
// ============================================================
const personas = [
  {
    id: 1, name: 'Christophe', age: 52, emoji: '\u{1F3E0}',
    canal: 'Google Search', device: 'Mobile', maturite: 'Decision',
    situation: 'Proprietaire a Metz, veut refaire l\'allee de son garage en paves avant l\'ete',
    contexte: 'Tape "amenagement entree paves Metz" sur Google, trouve Freitas Habitat en 1ere page',
    parcours: ['Accueil', 'Paves', 'Realisations', 'Contact'],
    decision: 'convertit',
    scores: { exp: 6, conf: 7, clarte: 6 },
    premierImpression: 'Le site est propre, les photos de paves sont belles. Je vois que c\'est une entreprise locale, ca me rassure.',
    questionCle: 'Combien ca coute pour une allee de 40m2 en paves granit ?',
    reponse: 'Non',
    commentReponse: 'Aucun prix indicatif nulle part. Mais les realisations le convainquent de demander un devis quand meme.',
    impactTechnique: 'Chargement un peu lent sur mobile 4G — 4 secondes avant d\'avoir la page complete.',
    pointsPositifs: ['Photos de realisations de qualite', 'Page dediee au pavage detaillee', 'Numero de telephone bien visible'],
    frictions: ['Pas de prix indicatif', 'Galerie sans filtre par type de projet', 'Pas de delai estime'],
