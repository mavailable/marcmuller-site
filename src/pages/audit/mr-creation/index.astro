    detail: 'Trois familles de polices (Roboto, Roboto Slab, Mukta Mahee) sont chargees depuis fonts.googleapis.com sans consentement prealable. C\'est une violation RGPD confirmee (transfert d\'IP vers Google). Remplacer par des fichiers woff2 en local : gain RGPD + elimination de 2-3 requetes bloquantes = gain ~400ms sur LCP mobile.'
  },
  {
    title: 'Completer le Schema.org LocalBusiness',
    impact: 'SEO + Knowledge Panel',
    detail: 'Le JSON-LD actuel (Yoast SEO) ne declare que WebPage + Organization. Ajouter : LocalBusiness (ou LandscapingBusiness), address, telephone, email, geo (lat/lng Metz), openingHours, areaServed (Moselle + Luxembourg), aggregateRating (4.8/5 - 28 reviews), sameAs (Instagram, GBP). Potentiel : Knowledge Panel Google + rich snippets notations.'
  },
  {
    title: 'Securiser les headers HTTP (Observatory F → C minimum)',
    impact: 'Securite + credibilite',
    detail: 'Score Observatory 20/100 — Grade F avec 6 tests echoues. Ajouter via configuration serveur LiteSpeed : X-Frame-Options, X-Content-Type-Options, Strict-Transport-Security, Content-Security-Policy de base, Permissions-Policy. Correction possible en <1h par le webmaster. Potentiel : passer de F a C/B.'
  },
  {
    title: 'Corriger H1 et title pour inclure mots-cles locaux',
    impact: 'SEO local',
    detail: 'H1 actuel : "Embellissons vos exterieurs" — aucun mot-cle. Title actuel : "Conception et amenagement de jardins et piscines" — sans "Metz" ni "paysagiste". Cibles SEO a inclure : "paysagiste Metz", "amenagement jardin Metz 57", "piscine Moselle". Ces corrections simples amelioreraient le positionnement sur les requetes locales prioritaires.'
  },
  {
    title: 'Creer des mentions legales et une page /contact',
    impact: 'Legal + confiance',
    detail: 'Les mentions legales sont absentes (obligation legale Art. 6 LCEN). La politique de confidentialite est un boilerplate WordPress qui ne couvre pas CF7 ni ReCAPTCHA. Creer : /mentions-legales (SIRET, responsable, hebergeur), /politique-de-confidentialite complete, page /contact (plutot que formulaire inline).'
  },
  {
    title: 'Illustrer les plans et esquisses paysageres',
    impact: '3/10 personas (projets neufs)',
    detail: 'Le site mentionne "plans et esquisses paysageres vous permettant de vous projeter dans vos futurs amenagements" — c\'est un differenciateur fort. Mais aucune illustration de ces plans n\'est presente. Un exemple de croquis ou plan 2D/3D avec le rendu final montrerait la valeur ajoutee de cette etape et justifierait le budget.'
  },
];

const amelioDiscuter = [
  { emoji: '\u{1F4CD}', title: 'Carte zone intervention Metz-Luxembourg', detail: 'L\'axe Metz-Luxembourg est un atout distinctif (clientele franco-luxembourgeoise aisee). Une carte visuelle des communes couvertes (Moselle + frontaliers) rassurerait les prospects hors Metz-centre et valoriserait la double clientele.' },
  { emoji: '\u{1F4F8}', title: 'Intégration Instagram sur le site', detail: '@mrcreation_metz est actif et attire des prospects (persona Yasmine). Afficher un flux Instagram sur la page d\'accueil ou realisations donnerait du contenu frais automatique et relirait les deux canaux.' },
  { emoji: '\u{1F4CB}', title: 'Formulaire devis structure par type de projet', detail: 'Le formulaire CF7 actuel est generique. Un wizard simple (type de projet → surface → commune → budget approx → coordonnees) qualifierait mieux les leads et accelererait le premier contact.' },
];

// ─── HELPERS ───
function scoreColor(s: number) {
  if (s >= 90) return '#22c55e';
  if (s >= 50) return '#f59e0b';
  return '#ef4444';
}

function scoreTextColor(s: number) {
  if (s >= 90) return 'text-green-600';
  if (s >= 50) return 'text-amber-600';
  return 'text-red-600';
}

function decisionColor(d: string) {
  if (d === 'Convertit') return 'bg-emerald-100 text-emerald-800';
  if (d === 'Hesite') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}

function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}

function severityColor(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  return 'bg-blue-100 text-blue-800';
}

function cwvBg(status: string) {
  if (status === 'good') return 'bg-green-50';
  if (status === 'mid') return 'bg-amber-50';
  return 'bg-red-50';
}

function cwvText(status: string) {
  if (status === 'good') return 'text-green-700';
  if (status === 'mid') return 'text-amber-700';
  return 'text-red-700';
}

function cwvBadge(status: string) {
  if (status === 'good') return 'bg-green-100 text-green-800';
  if (status === 'mid') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}

function cwvLabel(status: string) {
  if (status === 'good') return 'Bon';
  if (status === 'mid') return 'Moyen';
  return 'Mauvais';
}

function scoreBar(val: number) {
  return `${val * 10}%`;
}

function gradeColor(g: string) {
  if (g.startsWith('A')) return { border: 'border-green-300', bg: 'bg-green-50', text: 'text-green-700' };
  if (g.startsWith('B')) return { border: 'border-amber-300', bg: 'bg-amber-50', text: 'text-amber-700' };
  return { border: 'border-red-300', bg: 'bg-red-50', text: 'text-red-700' };
}

const gc = gradeColor(observatory.grade);
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath="/audit/mr-creation"
>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D1F0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-15 blur-3xl" style="background: #3A6B3A;"></div>
    <div class="absolute bottom-10 right-10 w-64 h-64 rounded-full opacity-10 blur-3xl" style="background: #6B9B3A;"></div>

    <div class="mx-auto max-w-4xl relative z-10">
      <div class="mb-4 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-green-500/40">
        <span class="w-2 h-2 rounded-full bg-green-500"></span>
        <span class="text-sm font-semibold text-white/90">Rapport confidentiel</span>
      </div>

      <h1 class="mb-4 text-3xl font-bold leading-tight text-white md:text-4xl lg:text-5xl">
        Audit UX + Technique — <span class="bg-gradient-to-r from-green-400 to-emerald-300 bg-clip-text text-transparent">MR Creation Paysagiste</span>
      </h1>

      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl mb-8">
        Analyse complete de <strong class="text-white">mrcreation.fr</strong> — audit technique (securite, SEO, Schema.org) + simulation de 10 visites personas avec feedback detaille.
      </p>

      <div class="flex flex-wrap gap-3">
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">10 personas testes</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">7 canaux d'arrivee</span>
        <span class="px-4 py-2 rounded-lg bg-red-900/60 text-red-300 text-sm font-medium">Observatory F · 20/100</span>
        <span class="px-4 py-2 rounded-lg bg-red-900/60 text-red-300 text-sm font-medium">Google Fonts CDN = RGPD</span>
        <span class="px-4 py-2 rounded-lg bg-red-900/60 text-red-300 text-sm font-medium">/a-propos en 404</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">30 mars 2026</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ TAB BAR ═══════════════════ -->
  <nav class="sticky top-16 md:top-20 z-40 bg-white/95 backdrop-blur border-b border-neutral-200" id="tab-bar">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 h-12 text-sm overflow-x-auto">
      <button data-tab="0" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-green-700 bg-green-50">Synthese</button>
      <button data-tab="1" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">Technique</button>
      <button data-tab="2" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">
        Visiteurs <span class="ml-1 text-xs text-neutral-400">10</span>
      </button>
      <button data-tab="3" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">
        Ameliorations <span class="ml-1 text-xs text-neutral-400">{amelioHaute.length + amelioMoyenne.length + amelioDiscuter.length}</span>
      </button>
    </div>
  </nav>

  <div id="panels" class="flex overflow-x-auto snap-x snap-mandatory" style="-webkit-overflow-scrolling: touch; scrollbar-width: none;">

    <!-- ═══════════════════ PANEL 1 : SYNTHESE ═══════════════════ -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0">

      <!-- KPI Cards -->
      <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-[var(--color-bg)]">
        <div class="mx-auto max-w-5xl">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-5 text-center">
              <p class={`text-3xl md:text-4xl font-bold ${tauxConv < 20 ? 'text-red-600' : tauxConv < 40 ? 'text-amber-600' : 'text-emerald-600'}`}>{tauxConv}%</p>
              <p class="mt-1 text-sm text-[var(--color-text-muted)]">Taux de conversion</p>
              <p class="mt-2 text-xs text-[var(--color-text-muted)]">{convertis} convertis · {hesitants} hesitants · {quitte} partis</p>
            </div>
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-5 text-center">
              <p class="text-3xl md:text-4xl font-bold text-amber-600">{avgExp}<span class="text-lg text-[var(--color-text-muted)]">/10</span></p>
              <p class="mt-1 text-sm text-[var(--color-text-muted)]">Experience</p>
              <div class="mt-2 h-2 rounded-full bg-neutral-100 overflow-hidden">
                <div class="h-full rounded-full bg-amber-500" style={`width: ${scoreBar(Number(avgExp))}`}></div>
              </div>
            </div>
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-5 text-center">
              <p class="text-3xl md:text-4xl font-bold text-blue-600">{avgConf}<span class="text-lg text-[var(--color-text-muted)]">/10</span></p>
              <p class="mt-1 text-sm text-[var(--color-text-muted)]">Confiance</p>
              <div class="mt-2 h-2 rounded-full bg-neutral-100 overflow-hidden">
                <div class="h-full rounded-full bg-blue-500" style={`width: ${scoreBar(Number(avgConf))}`}></div>
              </div>
            </div>
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-5 text-center">
              <p class="text-3xl md:text-4xl font-bold text-orange-600">{avgClarte}<span class="text-lg text-[var(--color-text-muted)]">/10</span></p>
              <p class="mt-1 text-sm text-[var(--color-text-muted)]">Clarte</p>
              <div class="mt-2 h-2 rounded-full bg-neutral-100 overflow-hidden">
                <div class="h-full rounded-full bg-orange-500" style={`width: ${scoreBar(Number(avgClarte))}`}></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Info prospect -->
      <div class="w-full px-6 pb-8 md:px-8">
        <div class="mx-auto max-w-5xl">
          <div class="rounded-xl border border-green-200 bg-green-50 p-6 mb-8">
            <h2 class="text-lg font-bold text-green-900 mb-3">MR Creation — Paysagiste Metz (57)</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-green-800">
              <div>
                <p><strong>Activite :</strong> Paysagiste — Conception et amenagement de jardins et piscines</p>
                <p><strong>Zone :</strong> Axe Metz-Luxembourg, Moselle et departements limitrophes</p>
                <p><strong>Adresse :</strong> 26, avenue Foch, 57000 METZ</p>
                <p><strong>Tel :</strong> 06 17 04 88 81</p>
              </div>
              <div>
                <p><strong>Avis Google :</strong> <span class="font-bold text-green-700">4.8/5 sur 28 avis</span> (excellent)</p>
                <p><strong>Email :</strong> contact@mrcreation.fr (professionnel)</p>
                <p><strong>Garantie :</strong> Decennale sur toutes les prestations</p>
                <p><strong>Site :</strong> WordPress 6.1.5 + Elementor 3.35.5 — LiteSpeed N0C</p>
              </div>
            </div>
          </div>

          <!-- Bug critique -->
          <div class="rounded-xl border border-red-200 bg-red-50 p-5 mb-8">
            <h3 class="font-semibold text-red-900 mb-2">Bug critique detecte : page /a-propos en 404</h3>
            <p class="text-sm text-red-700">La page <strong>/a-propos</strong> est listee dans le menu de navigation principal mais retourne une erreur 404. Ce bug casse la navigation et disqualifie le site pour les visiteurs B2B (architectes, syndics, collectivites) qui cherchent a verifier l'entreprise.</p>
          </div>

          <!-- Maturite x Conversion -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
              <h3 class="font-semibold text-[var(--color-text)] mb-4">Conversion par maturite</h3>
              <div class="space-y-3">
                {maturiteStats.map(m => (
                  <div class="flex items-center gap-3">
                    <span class="w-28 text-sm text-[var(--color-text-muted)] shrink-0">{m.level}</span>
                    <div class="flex-1 h-2 rounded-full bg-neutral-100 overflow-hidden">
                      <div class="h-full rounded-full bg-emerald-500" style={`width: ${m.pct}`}></div>
                    </div>
                    <span class="w-8 text-right text-sm font-medium text-[var(--color-text)]">{m.pct}</span>
                    <span class="text-xs text-neutral-400">({m.total})</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
              <h3 class="font-semibold text-[var(--color-text)] mb-4">Canaux d'arrivee</h3>
              <div class="space-y-2">
                {canalStats.map(c => (
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-[var(--color-text-muted)]">{c.canal}</span>
                    <div class="flex items-center gap-2">
                      {c.conv > 0 && <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-xs">{c.conv} conv.</span>}
                      {c.hesitant > 0 && <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 text-xs">{c.hesitant} hesit.</span>}
                      {c.quitte > 0 && <span class="px-2 py-0.5 rounded-full bg-red-100 text-red-700 text-xs">{c.quitte} parti</span>}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Frictions -->
          <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
            <h3 class="font-semibold text-[var(--color-text)] mb-4">Frictions identifiees par les personas</h3>
            <div class="space-y-2">
              {frictions.map(f => (
                <div class="flex items-start gap-3">
                  <span class={`shrink-0 px-2 py-0.5 rounded-full text-xs font-medium ${severityColor(f.severity)}`}>{f.severity}</span>
                  <span class="text-sm text-[var(--color-text)]">{f.label}</span>
                  {f.count > 0 && <span class="ml-auto shrink-0 text-xs text-neutral-400">{f.count}/10</span>}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ PANEL 2 : TECHNIQUE ═══════════════════ -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0">
      <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-[var(--color-bg)]">
        <div class="mx-auto max-w-5xl space-y-8">

          <!-- Scores -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {(['mobile', 'desktop'] as const).map(device => (
              <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
                <h3 class="font-semibold text-[var(--color-text)] mb-4 capitalize">{device} — Lighthouse (estimation stack)</h3>
                <div class="space-y-3">
                  {Object.entries(lighthouseScores[device]).map(([key, val]) => (
                    <div class="flex items-center gap-3">
                      <span class="w-28 text-sm text-[var(--color-text-muted)] capitalize">{key === 'perf' ? 'Performance' : key === 'access' ? 'Accessibilite' : key === 'bp' ? 'Bonnes pratiques' : 'SEO'}</span>
                      <div class="flex-1 h-3 rounded-full bg-neutral-100 overflow-hidden">
                        <div class="h-full rounded-full transition-all" style={`width: ${val}%; background-color: ${scoreColor(val)}`}></div>
                      </div>
                      <span class={`w-10 text-right text-sm font-bold ${scoreTextColor(val)}`}>{val}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- Stack details -->
          <div class="rounded-xl border border-amber-200 bg-amber-50 p-6">
            <h3 class="font-semibold text-amber-900 mb-3">Stack technique identifiee — facteurs de degradation performance</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-amber-800">
              <div>
                <p class="font-medium mb-2">Charge JS excessive :</p>
                <ul class="space-y-1 text-xs">
                  <li>• Elementor 3.35.5 : webpack.runtime + frontend-modules</li>
                  <li>• SmartSlider3 : 3 fichiers JS (n2.min.js, smartslider-frontend.min.js, ss-simple.min.js)</li>
                  <li>• jQuery 3.7.1 + jQuery Migrate 3.4.1 (2 fichiers legacy)</li>
                  <li>• Contact Form 7 (CF7) charge globalement</li>
                  <li>• Hu-Manity (cookies) via CDN externe</li>
                </ul>
              </div>
              <div>
                <p class="font-medium mb-2">Autres problemes :</p>
                <ul class="space-y-1 text-xs">
                  <li>• HTML brut : 174,8 KB (tres lourd pour 4 sections)</li>
                  <li>• Google Fonts CDN : 3 familles Roboto/Roboto Slab/Mukta Mahee</li>
                  <li>• Pas de preload hints ni fetchpriority sur hero</li>
                  <li>• Cache HTTP 1h seulement (devrait etre 1 an assets)</li>
                  <li>• AutoOptimize : concaténation partielle insuffisante</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- CWV -->
          <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
            <h3 class="font-semibold text-[var(--color-text)] mb-4">Core Web Vitals (estimation WordPress+Elementor+SmartSlider3)</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-neutral-100">
                    <th class="text-left py-2 pr-4 text-[var(--color-text-muted)] font-medium">Metrique</th>
                    <th class="text-center py-2 px-2 text-[var(--color-text-muted)] font-medium">Mobile</th>
                    <th class="text-center py-2 px-2 text-[var(--color-text-muted)] font-medium">Status</th>
                    <th class="text-center py-2 px-2 text-[var(--color-text-muted)] font-medium">Desktop</th>
                    <th class="text-center py-2 pl-2 text-[var(--color-text-muted)] font-medium">Status</th>
                  </tr>
                </thead>
                <tbody>
                  {Object.entries(cwv).map(([key, val]) => (
                    <tr class="border-b border-neutral-50">
                      <td class="py-2 pr-4 font-medium text-[var(--color-text)] uppercase text-xs">{key}</td>
                      <td class={`py-2 px-2 text-center font-mono ${cwvText(val.mobileStatus)}`}>{val.mobile}</td>
                      <td class="py-2 px-2 text-center">
                        <span class={`px-2 py-0.5 rounded-full text-xs font-medium ${cwvBadge(val.mobileStatus)}`}>{cwvLabel(val.mobileStatus)}</span>
                      </td>
                      <td class={`py-2 px-2 text-center font-mono ${cwvText(val.desktopStatus)}`}>{val.desktop}</td>
                      <td class="py-2 pl-2 text-center">
                        <span class={`px-2 py-0.5 rounded-full text-xs font-medium ${cwvBadge(val.desktopStatus)}`}>{cwvLabel(val.desktopStatus)}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Observatory + Schema + OG + SEO -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <!-- Observatory -->
            <div class={`rounded-xl border p-6 ${gc.border} ${gc.bg}`}>
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-semibold text-[var(--color-text)]">Observatory MDN</h3>
                <span class={`text-4xl font-black ${gc.text}`}>{observatory.grade}</span>
              </div>
              <p class={`text-2xl font-bold ${gc.text} mb-1`}>{observatory.score}<span class="text-base font-normal text-neutral-400">/100</span></p>
              <p class="text-sm text-neutral-500 mb-4">{observatory.passed}/{observatory.total} tests reussis</p>
              <div class="space-y-1 text-xs">
                {missingHeaders.map(h => (
                  <div class="flex items-start gap-2">
                    <span class="text-red-500 mt-0.5">x</span>
                    <span class="text-neutral-600">{h}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Schema.org -->
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
              <h3 class="font-semibold text-[var(--color-text)] mb-4">Schema.org JSON-LD</h3>
              <div class="space-y-1.5 max-h-72 overflow-y-auto">
                {schemaChecks.map(c => (
                  <div class="flex items-center gap-2 text-sm">
                    <span class={c.ok ? 'text-emerald-500' : 'text-red-500'}>{c.ok ? '✓' : '✗'}</span>
                    <span class={c.ok ? 'text-neutral-700' : 'text-neutral-500'}>{c.label}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- OG -->
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
              <h3 class="font-semibold text-[var(--color-text)] mb-4">Open Graph</h3>
              <div class="space-y-1.5">
                {ogChecks.map(c => (
                  <div class="flex items-center gap-2 text-sm">
                    <span class={c.ok ? 'text-emerald-500' : 'text-red-500'}>{c.ok ? '✓' : '✗'}</span>
