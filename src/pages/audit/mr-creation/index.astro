<script>
const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
const panels = document.getElementById('panels');

function activateTab(idx: number) {
  tabs.forEach((t, i) => {
    if (i === idx) {
      t.classList.remove('text-neutral-500', 'hover:text-neutral-700');
      t.classList.add('text-green-700', 'bg-green-50');
    } else {
      t.classList.remove('text-green-700', 'bg-green-50');
      t.classList.add('text-neutral-500', 'hover:text-neutral-700');
    }
  });
  if (panels) {
    panels.scrollTo({ left: idx * panels.offsetWidth, behavior: 'smooth' });
  }
}

tabs.forEach((btn, i) => {
  btn.addEventListener('click', () => activateTab(i));
});

if (panels) {
  panels.addEventListener('scroll', () => {
    const idx = Math.round(panels.scrollLeft / panels.offsetWidth);
    tabs.forEach((t, i) => {
      if (i === idx) {
        t.classList.remove('text-neutral-500', 'hover:text-neutral-700');
        t.classList.add('text-green-700', 'bg-green-50');
      } else {
        t.classList.remove('text-green-700', 'bg-green-50');
        t.classList.add('text-neutral-500', 'hover:text-neutral-700');
      }
    });
  });
}
</script>
