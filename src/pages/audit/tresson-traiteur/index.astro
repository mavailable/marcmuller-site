  { titre: '124 avis Google inexploites sur le site', count: 8, detail: 'La preuve sociale la plus forte reste cachee sur Maps' },
  { titre: 'Site lent et non securise (HTTP)', count: 7, detail: 'Chrome signale "site non securise", abandon massif mobile' },
  { titre: 'Aucun temoignage client visible', count: 7, detail: 'Confiance non etablie sans verbatims de clients satisfaits' },
  { titre: 'Open Graph absent — partage reseaux sociaux inutile', count: 5, detail: 'Liens partages sans image = perte de 70% des clics potentiels' },
];

// ── AMELIORATIONS CRITIQUES ───────────────────────────────────────────────────
const ameliorationsCritiques = [
  {
    titre: 'Ajouter des fourchettes tarifaires (meme larges)',
    detail: '9 personas sur 10 sont bloques par l\'absence de prix. Meme "cocktail a partir de X€/pers" suffit a qualifier les prospects et eviter les devis hors-budget.',
    action: 'Page Tarifs : ajouter au moins 3 fourchettes indicatives par type de prestation',
  },
  {
    titre: 'Migrer en HTTPS + passer au SSL valide',
    detail: 'Chrome mobile affiche "site non securise" en HTTP. -50 pts Observatory. Vecteur d\'attaque XSS via scripts tiers. Urgence absolue pour la confiance et le SEO.',
    action: 'Renouveler le certificat SSL + configurer redirection HTTP→HTTPS',
  },
  {
    titre: 'Afficher les 124 avis Google sur le site',
    detail: 'La preuve sociale la plus puissante est invisible pour les visiteurs web. Integrer 5-6 verbatims avec etoiles directement sur la page d\'accueil convertit les hesitants.',
    action: 'Section temoignages accueil : 6 verbatims reels issus des avis Google',
  },
];

const ameliorationsUtiles = [
  {
    titre: 'Ajouter alt text sur les 45 images',
    detail: 'Zero accessibilite + penalite SEO directe. Correctif en moins d\'une heure, gains immediats.',
  },
  {
    titre: 'Integrer Schema.org LocalBusiness + AggregateRating',
    detail: 'Rend eligible aux rich snippets Google (etoiles dans les resultats). Direct impact visibilite locale.',
  },
  {
    titre: 'Ajouter balises Open Graph pour le partage social',
    detail: 'Facebook, Instagram, WhatsApp, LinkedIn afficheront une belle image + titre au lieu d\'un rectangle gris.',
  },
