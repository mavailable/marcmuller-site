---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit — Tresson Traiteur Metz | Marc M';
const description = 'Simulation de 10 visites personas sur tressontraiteur.fr — audit UX, technique et recommandations.';

// ── PROSPECT ──────────────────────────────────────────────────────────────────
const prospect = {
  name: 'Tresson Traiteur',
  url: 'http://www.tressontraiteur.fr/',
  date: '29 mars 2026',
  activity: 'Traiteur artisanal — evenements prives & entreprises, chef a domicile, cake design',
  location: 'Metz (57 Moselle) — rayon 50 km',
  avis: 124,
};

// ── PAGESPEED (estimes — API quota depassee) ───────────────────────────────────
const pagespeed = {
  mobile:  { performance: 25, accessibility: 35, bestPractices: 30, seo: 55 },
  desktop: { performance: 45, accessibility: 40, bestPractices: 30, seo: 60 },
};

const coreWebVitals = [
  { name: 'LCP', value: '~6-8s', status: 'bad' },
  { name: 'INP', value: '~500ms', status: 'warn' },
  { name: 'CLS', value: '~0.20', status: 'warn' },
  { name: 'FCP', value: '~4-6s', status: 'bad' },
];

// ── OBSERVATORY ───────────────────────────────────────────────────────────────
const observatory = { grade: 'F', score: 0, testsPassed: 4, testsTotal: 10 };

// ── SEO / SCHEMA / OG CHECKS ─────────────────────────────────────────────────
const techChecks = [
  { label: 'Schema.org JSON-LD', present: false, critical: true },
  { label: 'Open Graph (og:title, og:image)', present: false, critical: true },
  { label: 'Redirection HTTP → HTTPS', present: false, critical: true },
  { label: 'Certificat SSL valide', present: false, critical: true },
  { label: 'Alt text sur les images (45 images)', present: false, critical: true },
  { label: 'Meta title (longueur OK < 60 chars)', present: false, critical: false },
  { label: 'Meta description presente', present: true, critical: false },
  { label: 'Un seul H1 par page', present: true, critical: false },
  { label: 'Structure H2/H3 sur les pages', present: false, critical: false },
  { label: 'robots.txt accessible', present: true, critical: false },
  { label: 'sitemap.xml accessible', present: true, critical: false },
  { label: 'Scripts securises (HTTPS + SRI)', present: false, critical: true },
  { label: 'Analytics moderne (GA4 / Umami)', present: false, critical: false },
  { label: 'Avis Google sur le site', present: false, critical: true },
];

// ── PERSONAS ──────────────────────────────────────────────────────────────────
const personas = [
