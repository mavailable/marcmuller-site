// ── HELPERS ───────────────────────────────────────────────────────────────────
function scoreColor(s: number) {
  if (s >= 90) return '#22c55e';
  if (s >= 50) return '#f59e0b';
  return '#ef4444';
}
function scoreTextClass(s: number) {
  if (s >= 90) return 'text-green-600';
  if (s >= 50) return 'text-amber-500';
  return 'text-red-500';
}
function decisionBorder(d: string) {
  if (d === 'convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'hesite')    return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}
function decisionBadge(d: string) {
  if (d === 'convertit') return 'bg-green-100 text-green-700';
  if (d === 'hesite')    return 'bg-amber-100 text-amber-700';
  return 'bg-neutral-100 text-neutral-600';
}
function decisionLabel(d: string) {
  if (d === 'convertit') return 'Contacte';
  if (d === 'hesite')    return 'Hesite';
  return 'Quitte';
}
function canalColor(t: number) {
  if (t >= 70) return { text: 'text-green-600 font-bold', bar: 'bg-green-500' };
  if (t >= 40) return { text: 'text-amber-600 font-bold', bar: 'bg-amber-400' };
  return { text: 'text-red-500 font-bold', bar: 'bg-red-400' };
}
function cwvColor(s: string) {
  if (s === 'good') return 'text-green-600 bg-green-50';
  if (s === 'warn') return 'text-amber-600 bg-amber-50';
  return 'text-red-600 bg-red-50';
}
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath={`/audit/tresson-traiteur/`}
>

  <!-- ═══════════════════════════════════════════════════════════ HERO -->
  <section class="bg-neutral-900 text-white py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-4">Rapport personnalise</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2">{prospect.name} — ce que vos visiteurs pensent vraiment</h1>
      <p class="text-neutral-400 mb-2">{prospect.activity}</p>
      <p class="text-neutral-500 text-sm mb-6">
        <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener noreferrer">{prospect.url}</a>
        &nbsp;·&nbsp; {prospect.location} &nbsp;·&nbsp; {prospect.avis} avis Google
      </p>
      <div class="grid grid-cols-3 gap-4 max-w-md">
        <div class="text-center bg-neutral-800 rounded-xl p-3">
          <span class="block text-3xl font-black text-amber-400">{kpis.conversion}%</span>
          <span class="text-xs text-neutral-400 mt-1 block">convertissent</span>
        </div>
        <div class="text-center bg-neutral-800 rounded-xl p-3">
          <span class="block text-3xl font-black text-amber-400">{kpis.experience}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">experience</span>
        </div>
        <div class="text-center bg-neutral-800 rounded-xl p-3">
          <span class="block text-3xl font-black text-amber-400">{kpis.confiance}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">confiance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ CONSTAT -->
  <section class="bg-white py-12 px-4 border-b border-neutral-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-amber-900 font-medium leading-relaxed">{constat}</p>
      </div>

      <!-- Conversion par canal -->
      <h3 class="text-sm font-semibold text-neutral-500 uppercase tracking-wide mb-4">Conversion par canal d'arrivee</h3>
      <div class="space-y-3 mb-10">
        {conversionByCanal.map(item => {
          const c = canalColor(item.taux);
          return (
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-neutral-700">{item.canal}</span>
                <span class={`text-sm ${c.text}`}>{item.taux}%</span>
              </div>
              <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
                <div class={`h-full rounded-full ${c.bar}`} style={`width: ${item.taux}%`}></div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Top frictions -->
      <h3 class="text-sm font-semibold text-neutral-500 uppercase tracking-wide mb-4">Top 5 frictions identifiees</h3>
      <ol class="space-y-3">
        {topFrictions.map((f, i) => (
          <li class="flex gap-3 items-start">
            <span class="shrink-0 w-6 h-6 rounded-full bg-red-100 text-red-600 text-xs font-bold flex items-center justify-center mt-0.5">{i + 1}</span>
            <div>
              <p class="font-medium text-neutral-800 text-sm">{f.titre}</p>
              <p class="text-neutral-500 text-xs mt-0.5">{f.detail} <span class="font-semibold text-neutral-600">({f.count}/10 personas)</span></p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ AUDIT TECHNIQUE -->
  <section class="bg-neutral-50 py-12 px-4 border-b border-neutral-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">L'audit technique</h2>

      <!-- PageSpeed -->
      <div class="bg-white rounded-xl border border-neutral-200 p-6 mb-6">
        <h3 class="text-sm font-semibold text-neutral-500 uppercase tracking-wide mb-5">Scores PageSpeed (estimes)</h3>

        <div class="mb-6">
          <p class="text-xs font-semibold text-neutral-400 mb-3">MOBILE</p>
          <div class="grid grid-cols-4 gap-3">
            {[
              { label: 'Performance', score: pagespeed.mobile.performance },
              { label: 'Accessibilite', score: pagespeed.mobile.accessibility },
              { label: 'Bonnes pratiques', score: pagespeed.mobile.bestPractices },
              { label: 'SEO', score: pagespeed.mobile.seo },
            ].map(item => (
              <div class="text-center">
                <div class="relative w-14 h-14 mx-auto mb-2">
                  <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e5e7eb" stroke-width="3"/>
                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke={scoreColor(item.score)} stroke-width="3" stroke-dasharray={`${item.score}, 100`} stroke-linecap="round"/>
                  </svg>
                  <span class={`absolute inset-0 flex items-center justify-center text-base font-black ${scoreTextClass(item.score)}`}>{item.score}</span>
                </div>
                <p class="text-xs text-neutral-500 leading-tight">{item.label}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <p class="text-xs font-semibold text-neutral-400 mb-3">DESKTOP</p>
          <div class="grid grid-cols-4 gap-3">
            {[
              { label: 'Performance', score: pagespeed.desktop.performance },
              { label: 'Accessibilite', score: pagespeed.desktop.accessibility },
              { label: 'Bonnes pratiques', score: pagespeed.desktop.bestPractices },
              { label: 'SEO', score: pagespeed.desktop.seo },
            ].map(item => (
              <div class="text-center">
                <div class="relative w-14 h-14 mx-auto mb-2">
                  <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e5e7eb" stroke-width="3"/>
                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke={scoreColor(item.score)} stroke-width="3" stroke-dasharray={`${item.score}, 100`} stroke-linecap="round"/>
                  </svg>
                  <span class={`absolute inset-0 flex items-center justify-center text-base font-black ${scoreTextClass(item.score)}`}>{item.score}</span>
                </div>
                <p class="text-xs text-neutral-500 leading-tight">{item.label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- CWV -->
        <div class="mt-6 grid grid-cols-4 gap-2">
          {coreWebVitals.map(v => (
            <div class={`rounded-lg p-2 text-center ${cwvColor(v.status)}`}>
              <p class="text-xs font-semibold">{v.name}</p>
              <p class="text-sm font-bold mt-0.5">{v.value}</p>
            </div>
          ))}
        </div>

        <p class="text-xs text-neutral-400 mt-3 italic">* Scores estimes par analyse statique du code source — API PageSpeed quota depassee au moment de l'audit.</p>
      </div>

      <!-- Observatory -->
      <div class="bg-white rounded-xl border border-neutral-200 p-6 mb-6">
        <h3 class="text-sm font-semibold text-neutral-500 uppercase tracking-wide mb-4">Securite — Mozilla Observatory</h3>
        <div class="flex items-center gap-4 mb-4">
          <div class="w-16 h-16 rounded-xl bg-red-100 flex items-center justify-center">
            <span class="text-3xl font-black text-red-600">{observatory.grade}</span>
          </div>
          <div>
            <p class="font-bold text-neutral-900">{observatory.score}/100 — Note F</p>
            <p class="text-sm text-neutral-500">{observatory.testsPassed} tests passes sur {observatory.testsTotal}</p>
            <p class="text-xs text-red-600 mt-1">Pire score possible : scripts tiers non securises (-50 pts)</p>
          </div>
        </div>
        <div class="bg-red-50 rounded-lg p-3 text-sm text-red-800">
          <strong>Risque principal :</strong> 12 scripts jQuery charges depuis silverlib.fr en HTTP sans verification d'integrite — vecteur d'attaque Man-in-the-Middle actif.
        </div>
      </div>

      <!-- Checklist SEO/OG/Schema -->
      <div class="bg-white rounded-xl border border-neutral-200 p-6">
        <h3 class="text-sm font-semibold text-neutral-500 uppercase tracking-wide mb-4">Checklist SEO + Schema.org + Open Graph</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {techChecks.map(item => (
            <div class={`flex items-center gap-2 text-sm py-1.5 px-2 rounded-lg ${item.present ? 'bg-green-50' : item.critical ? 'bg-red-50' : 'bg-neutral-50'}`}>
              <span class={`text-base shrink-0 ${item.present ? 'text-green-500' : item.critical ? 'text-red-500' : 'text-neutral-400'}`}>
                {item.present ? '✓' : '✗'}
              </span>
              <span class={`${item.present ? 'text-green-800' : item.critical ? 'text-red-800 font-medium' : 'text-neutral-600'}`}>
                {item.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ VISITEURS -->
  <section class="bg-white py-12 px-4 border-b border-neutral-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
      <p class="text-neutral-500 mb-6">
        Sur <strong>10 visiteurs simules</strong> :
        <span class="inline-flex items-center gap-1 ml-2 text-green-700 font-semibold">{convertis} contactent</span> ·
        <span class="inline-flex items-center gap-1 ml-1 text-amber-600 font-semibold">{hesitants} hesitent</span> ·
        <span class="inline-flex items-center gap-1 ml-1 text-neutral-500 font-semibold">{quittent} repartent</span>
      </p>

      <!-- Personas groupees par decision -->
      {(['convertit', 'hesite', 'quitte'] as const).map(dec => {
        const group = personas.filter(p => p.decision === dec);
        if (group.length === 0) return null;
        const label = dec === 'convertit' ? 'Contactent' : dec === 'hesite' ? 'Hesitent' : 'Repartent';
        const headerColor = dec === 'convertit' ? 'text-green-700 bg-green-50' : dec === 'hesite' ? 'text-amber-700 bg-amber-50' : 'text-neutral-600 bg-neutral-100';
        return (
          <div class="mb-6">
            <h3 class={`text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full inline-block mb-3 ${headerColor}`}>
              {label} ({group.length})
            </h3>
            <div class="space-y-2">
              {group.map(p => (
                <details class={`group border rounded-xl overflow-hidden ${decisionBorder(p.decision)}`}>
                  <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                        <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                        <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                        <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                        <span class={`text-[11px] px-1.5 py-0.5 rounded font-medium ${decisionBadge(p.decision)}`}>{decisionLabel(p.decision)}</span>
                      </div>
                      <p class="text-xs text-neutral-500">{p.situation}</p>
                      <div class="flex gap-3 mt-1.5">
                        <span class="text-[11px] text-neutral-400">Exp <strong class={scoreTextClass(p.scores.exp * 10)}>{p.scores.exp}/10</strong></span>
                        <span class="text-[11px] text-neutral-400">Conf <strong class={scoreTextClass(p.scores.conf * 10)}>{p.scores.conf}/10</strong></span>
                        <span class="text-[11px] text-neutral-400">Clarte <strong class={scoreTextClass(p.scores.clarte * 10)}>{p.scores.clarte}/10</strong></span>
                      </div>
                    </div>
                    <svg class="w-5 h-5 text-neutral-400 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </summary>

                  <div class="px-4 pb-4 pt-0 border-t border-neutral-200/60 bg-white/60">
                    <div class="grid gap-3 text-xs mt-3">

                      <div>
                        <p class="font-semibold text-neutral-700 mb-1">Premiere impression</p>
                        <p class="text-neutral-600 italic">{p.premierImpression}</p>
                      </div>

                      <div>
                        <p class="font-semibold text-neutral-700 mb-1">Parcours</p>
                        <p class="text-neutral-500">{p.parcours.join(' → ')}</p>
                      </div>

                      <div>
                        <p class="font-semibold text-neutral-700 mb-1">Question cle</p>
                        <p class="text-neutral-600">"{p.questionCle}"</p>
                        <p class="mt-1">
                          <span class={`font-semibold ${p.reponse === 'Oui' ? 'text-green-600' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}`}>Reponse du site : {p.reponse}</span>
                          <span class="text-neutral-500"> — {p.commentReponse}</span>
                        </p>
                      </div>

                      <div>
                        <p class="font-semibold text-neutral-700 mb-1">Impact technique</p>
                        <p class="text-neutral-600">{p.impactTechnique}</p>
                      </div>

                      <div class="grid grid-cols-2 gap-3">
                        <div>
                          <p class="font-semibold text-green-700 mb-1">Points positifs</p>
                          <ul class="space-y-0.5">
                            {p.pointsPositifs.map(pt => (
                              <li class="flex gap-1.5 text-neutral-600"><span class="text-green-500 shrink-0">+</span>{pt}</li>
                            ))}
                          </ul>
                        </div>
                        <div>
                          <p class="font-semibold text-amber-700 mb-1">Frictions</p>
                          <ul class="space-y-0.5">
                            {p.frictions.map(fr => (
                              <li class="flex gap-1.5 text-neutral-600"><span class="text-amber-500 shrink-0">-</span>{fr}</li>
                            ))}
                          </ul>
                        </div>
                      </div>

                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ RECOMMANDATIONS -->
  <section class="bg-neutral-50 py-12 px-4 border-b border-neutral-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-8">Nos recommandations</h2>

      <h3 class="text-sm font-semibold text-red-600 uppercase tracking-wide mb-4">Le plus important</h3>
      <div class="grid gap-4 mb-10">
        {ameliorationsCritiques.map((a, i) => (
          <div class="bg-white border border-red-200 rounded-xl p-5">
            <div class="flex items-start gap-3">
              <span class="shrink-0 w-7 h-7 rounded-full bg-red-100 text-red-600 text-sm font-black flex items-center justify-center">{i + 1}</span>
              <div>
                <h4 class="font-bold text-neutral-900 mb-1">{a.titre}</h4>
                <p class="text-sm text-neutral-600 mb-2">{a.detail}</p>
                <p class="text-xs bg-red-50 text-red-700 px-3 py-1.5 rounded-lg inline-block">Action : {a.action}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-sm font-semibold text-neutral-500 uppercase tracking-wide mb-4">Utile aussi</h3>
      <div class="grid sm:grid-cols-3 gap-4">
        {ameliorationsUtiles.map(a => (
          <div class="bg-white border border-neutral-200 rounded-xl p-4">
            <h4 class="font-semibold text-neutral-800 text-sm mb-1">{a.titre}</h4>
            <p class="text-xs text-neutral-500">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ CTA FINAL -->
  <section class="bg-neutral-900 text-white py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4">
        {kpis.conversion}% de vos visiteurs vous contactent.<br/>
        <span class="text-amber-400">Vous meritez bien mieux.</span>
      </h2>
      <p class="text-neutral-300 mb-3 max-w-xl mx-auto">
        Un second de cuisine etoile, 124 avis Google, un duo unique a Metz — et un site qui date de 2010.
        Ce rapport identifie exactement ce qui coute des devis chaque semaine.
      </p>
      <p class="text-neutral-400 text-sm mb-8 max-w-lg mx-auto">
        Je construis des sites qui convertissent vraiment — a partir de 990 €, livre en 7 jours.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/commander/" class="inline-flex items-center gap-2 px-8 py-3.5 bg-[var(--color-accent)] text-white font-semibold rounded-xl hover:opacity-90 transition-all shadow-md">
          Je veux un site qui convertit
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="/contact/" class="inline-flex items-center gap-2 px-8 py-3.5 border border-neutral-600 text-neutral-300 font-semibold rounded-xl hover:border-amber-400 hover:text-amber-400 transition-all">
          En discuter d'abord
        </a>
      </div>
      <p class="text-neutral-600 text-xs mt-6">{prospect.date} — Rapport Web Factory (usage interne, noindex)</p>
    </div>
  </section>

</BaseLayout>
