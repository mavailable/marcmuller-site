    titre: 'Migrer vers un site statique Astro avec URLs sémantiques',
    detail: 'Les URLs Wix (/general-8, /general-8-1...) sont un double problème : elles nuisent au SEO (Google ne comprend pas le contenu) et dégradent la confiance des utilisateurs qui les voient. En parallèle, Wix impose React 18 côté client, une page HTML de 764 Ko et des headers de sécurité impossibles à configurer — score Observatory C- (45/100) structurellement bloqué.',
    action: 'Migration vers Astro + Cloudflare Pages : URLs /peinture-interieure-metz, /moulures-orac-metz, /fresques-murales-metz. PageSpeed 90+, Observatory A, temps de chargement < 1,5s mobile. Cloudflare permet de configurer tous les headers de sécurité manquants.',
  },
  {
    titre: 'Installer des analytics et creer une page dedie professionnels',
    detail: 'Neroza ne sait pas combien de visiteurs viennent sur le site, ni d\'où. Aucune décision commerciale ne peut être basée sur des données concrètes. Par ailleurs, 3 personas sur 10 étaient des professionnels (gérant de brasserie, décoratrice, architecte) — un segment lucratif totalement ignoré par le site actuel.',
    action: 'Installer Umami (RGPD, sans cookies) pour mesurer trafic + conversions. Créer une page /professionnels avec références commerciales, flexibilité horaire, capacité d\'équipe. Ajouter un champ "professionnel/particulier" dans le formulaire de devis.',
  },
];

const ameliorationsUtiles = [
  {
    titre: 'Galerie filtree par type de chantier et activer le lien Instagram',
    detail: '6 personas sur 10 ont cherché des photos de réalisations spécifiques (velours, moulures Orac, style contemporain) et ont été déçus par la galerie générique non filtrable. En parallèle, le compte Instagram @neroza.peinture contient des photos magnifiques que le site ignore complètement.',
  },
  {
    titre: 'Ajouter un email professionnel et les certifications/labels',
    detail: 'neroza.info@gmail.com est le seul email de contact. Pour un positionnement haut de gamme, un email @neroza.fr serait cohérent avec la promesse de marque. Les certifications éventuelles (Qualibat, etc.) ne sont pas mentionnées — manque de preuves objectives du savoir-faire.',
  },
  {
    titre: 'Activer le GEO avec llms.txt et ameliorer Schema.org',
    detail: 'Clara (décoratrice) a cherché Neroza sur ChatGPT et l\'a trouvé invisible. Le secteur des artisans haut de gamme commence à être influencé par les IA génératives. Un llms.txt + Schema.org speakable + blog développé rendraient Neroza citable par ChatGPT, Claude et Perplexity.',
  },
];

// ============================================================
// HELPERS
// ============================================================
function scoreColor(score: number) {
  if (score >= 90) return '#22c55e';
  if (score >= 50) return '#f59e0b';
  return '#ef4444';
}

function scoreTextClass(score: number) {
  if (score >= 90) return 'text-green-600';
  if (score >= 50) return 'text-amber-500';
  return 'text-red-500';
}

function decisionColor(decision: string) {
  if (decision === 'convertit') return 'border-green-200 bg-green-50/40';
  if (decision === 'hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}

function decisionBadge(decision: string) {
  if (decision === 'convertit') return 'bg-green-100 text-green-700';
  if (decision === 'hesite') return 'bg-amber-100 text-amber-700';
  return 'bg-neutral-100 text-neutral-600';
}

function decisionLabel(decision: string) {
  if (decision === 'convertit') return 'Contacte';
  if (decision === 'hesite') return 'Hesite';
  return 'Repart';
}

function maturiteColor(m: string) {
  if (m === 'Decision') return 'text-purple-600 bg-purple-50';
  if (m === 'Comparaison') return 'text-blue-600 bg-blue-50';
  return 'text-neutral-500 bg-neutral-100';
}
---

<BaseLayout title={title} description={description} noindex={true} lang="fr" frPath="/audit/neroza-peinture">

  <!-- ========================================================
       HERO + KPIs
  ======================================================== -->
  <section class="bg-neutral-900 text-white py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-4">Rapport personnalise</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2 leading-tight">
        {prospect.name}<br/>
        <span class="text-neutral-300 font-normal text-2xl">ce que vos visiteurs pensent vraiment</span>
      </h1>
      <p class="text-neutral-400 mb-2">{prospect.activity} &mdash; {prospect.location}</p>
      <p class="text-neutral-500 text-sm mb-8">
        <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener noreferrer">{prospect.url}</a>
        &mdash; Rapport du {prospect.date}
      </p>

      <!-- KPI Cards -->
      <div class="grid grid-cols-3 gap-4 max-w-lg">
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.conversion}%</span>
          <span class="text-xs text-neutral-400 mt-1 block">convertissent</span>
        </div>
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.experience}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">experience</span>
        </div>
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.confiance}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">confiance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       LE CONSTAT
  ======================================================== -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>

      <!-- Constat principal -->
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-amber-900 font-medium text-base leading-relaxed">{constat}</p>
      </div>

      <!-- Resume visiteurs -->
      <div class="flex flex-wrap gap-3 mb-8">
        <div class="flex items-center gap-2 bg-green-50 border border-green-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
          <span class="text-sm font-semibold text-green-800">{kpis.convertissent} contactent</span>
        </div>
        <div class="flex items-center gap-2 bg-amber-50 border border-amber-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
          <span class="text-sm font-semibold text-amber-800">{kpis.hesitent} hesitent</span>
        </div>
        <div class="flex items-center gap-2 bg-neutral-100 border border-neutral-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-neutral-400 shrink-0"></span>
          <span class="text-sm font-semibold text-neutral-700">{kpis.quittent} repartent</span>
        </div>
      </div>

      <!-- Conversion par canal -->
      <h3 class="font-heading text-lg font-bold text-neutral-900 mb-4">Taux de conversion estime par canal</h3>
      <div class="space-y-3 mb-8">
        {conversionByCanal.map(c => (
          <div class="flex items-center gap-3">
            <span class="w-40 text-sm text-neutral-600 shrink-0">{c.canal}</span>
            <div class="flex-1 bg-neutral-100 rounded-full h-3 overflow-hidden">
              <div class={`h-3 rounded-full ${c.bg}`} style={`width: ${c.taux}%`}></div>
            </div>
            <span class={`w-10 text-sm font-bold text-right ${c.color}`}>{c.taux}%</span>
          </div>
        ))}
      </div>

      <!-- Top frictions -->
      <h3 class="font-heading text-lg font-bold text-neutral-900 mb-4">Top frictions identifiees</h3>
      <div class="space-y-3">
        {topFrictions.map(f => (
          <div class="border border-neutral-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-red-100 text-red-700 text-xs font-bold shrink-0 mt-0.5">{f.count}/10</span>
              <div>
                <p class="font-semibold text-neutral-900 text-sm">{f.titre}</p>
                <p class="text-neutral-500 text-xs mt-1 leading-relaxed">{f.detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       AUDIT TECHNIQUE
  ======================================================== -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-8">Audit technique</h2>

      <!-- PageSpeed -->
      <h3 class="font-heading text-lg font-bold text-neutral-800 mb-5">PageSpeed Insights (profil estime — Wix Thunderbolt + React 18)</h3>
      <div class="grid grid-cols-2 gap-6 mb-8">
        <!-- Mobile -->
        <div class="bg-white rounded-xl border border-neutral-200 p-5">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-4">Mobile</p>
          {Object.entries(pagespeed.mobile).map(([k, v]) => (
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm text-neutral-600 capitalize">{k.replace(/([A-Z])/g, ' $1')}</span>
              <span class={`text-sm font-bold ${scoreTextClass(v)}`}>{v}/100</span>
            </div>
          ))}
          <div class="mt-4 pt-4 border-t border-neutral-100">
            {coreWebVitals.map(cv => (
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs text-neutral-500">{cv.name}</span>
                <span class={`text-xs font-bold ${cv.status === 'bad' ? 'text-red-500' : 'text-amber-500'}`}>{cv.value}</span>
              </div>
            ))}
          </div>
        </div>
        <!-- Desktop -->
        <div class="bg-white rounded-xl border border-neutral-200 p-5">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-4">Desktop</p>
          {Object.entries(pagespeed.desktop).map(([k, v]) => (
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm text-neutral-600 capitalize">{k.replace(/([A-Z])/g, ' $1')}</span>
              <span class={`text-sm font-bold ${scoreTextClass(v)}`}>{v}/100</span>
            </div>
          ))}
          <div class="mt-4 pt-4 border-t border-neutral-100">
            <p class="text-xs text-neutral-400 italic">Optimisations possibles :</p>
            {opportunities.slice(0, 3).map(o => (
              <div class="flex items-center justify-between mt-1">
                <span class="text-xs text-neutral-500 leading-tight pr-2">{o.label.slice(0, 45)}...</span>
                <span class="text-xs font-bold text-green-600 shrink-0">{o.saving}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Observatory -->
      <h3 class="font-heading text-lg font-bold text-neutral-800 mb-4">MDN Observatory — Sécurité HTTP</h3>
      <div class="bg-white rounded-xl border border-neutral-200 p-5 mb-8">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-16 h-16 rounded-xl flex items-center justify-center text-2xl font-black text-white"
               style={`background: ${scoreColor(observatory.score)}`}>
            {observatory.grade}
          </div>
          <div>
            <p class="text-2xl font-black text-neutral-900">{observatory.score}/100</p>
            <p class="text-sm text-neutral-500">{observatory.testsPassed}/{observatory.testsTotal} tests reussis — scan officiel POST 29/03/2026</p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 mt-4">
          <div class="flex items-center gap-2 text-sm"><span class="text-green-500">✓</span><span class="text-neutral-600">HTTPS + HTTP/2 actif (Fastly CDN)</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="text-green-500">✓</span><span class="text-neutral-600">HSTS (max-age=31556952)</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="text-green-500">✓</span><span class="text-neutral-600">X-Content-Type-Options: nosniff</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="text-red-500">✗</span><span class="text-neutral-600">Content-Security-Policy — absent</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="text-red-500">✗</span><span class="text-neutral-600">X-Frame-Options — absent</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="text-red-500">✗</span><span class="text-neutral-600">Permissions-Policy — absent</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="text-red-500">✗</span><span class="text-neutral-600">Referrer-Policy — absent</span></div>
          <div class="flex items-center gap-2 text-sm text-neutral-400 text-xs col-span-2">Note : les headers manquants sont non configurables sur Wix — blocage structurel</div>
        </div>
      </div>

      <!-- Checklist -->
      <h3 class="font-heading text-lg font-bold text-neutral-800 mb-4">Checklist complete</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        {techChecks.map(c => (
          <div class={`flex items-start gap-2 p-2 rounded-lg ${c.critical && !c.present ? 'bg-red-50' : 'bg-white border border-neutral-100'}`}>
            <span class={`shrink-0 mt-0.5 ${c.present ? 'text-green-500' : 'text-red-400'}`}>{c.present ? '✓' : '✗'}</span>
            <div>
              <span class={`text-sm ${c.present ? 'text-neutral-700' : c.critical ? 'text-red-700 font-medium' : 'text-neutral-500'}`}>{c.label}</span>
              {c.note && <p class="text-xs text-neutral-400 mt-0.5">{c.note}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       PERSONAS — VISITES SIMULEES
  ======================================================== -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">10 visites simulees</h2>
      <p class="text-neutral-500 text-sm mb-8">10 profils typiques de prospects Neroza. Chaque persona parcourt le site independamment et partage son experience reelle.</p>

      <div class="space-y-5">
        {personas.map(p => (
          <div class={`rounded-xl border p-5 ${decisionColor(p.decision)}`}>
            <!-- Header persona -->
            <div class="flex items-start gap-3 mb-4">
              <span class="text-3xl">{p.emoji}</span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="font-heading font-bold text-neutral-900">{p.name}</span>
                  <span class="text-neutral-500 text-sm">{p.age} ans</span>
                  <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${maturiteColor(p.maturite)}`}>{p.maturite}</span>
                  <span class={`text-xs px-2 py-0.5 rounded-full font-semibold ${decisionBadge(p.decision)}`}>{decisionLabel(p.decision)}</span>
                </div>
                <div class="flex flex-wrap gap-2 text-xs text-neutral-500">
                  <span>{p.canal}</span>
                  <span>·</span>
                  <span>{p.device}</span>
                  {p.parcours.length > 0 && (
                    <>
                      <span>·</span>
                      <span>{p.parcours.join(' → ')}</span>
                    </>
                  )}
                </div>
              </div>
              <div class="shrink-0 text-right">
                {p.scores.exp > 0 && (
                  <div class="text-xs text-neutral-500">
                    <span>Exp: <strong class={scoreTextClass(p.scores.exp * 10)}>{p.scores.exp}/10</strong></span>
                    <span class="mx-1">·</span>
                    <span>Conf: <strong class={scoreTextClass(p.scores.conf * 10)}>{p.scores.conf}/10</strong></span>
                  </div>
                )}
              </div>
            </div>

            <p class="text-sm text-neutral-600 mb-3 leading-relaxed">{p.situation}</p>

            <!-- Premier impression -->
            <div class="bg-white/70 rounded-lg p-3 mb-3 border border-neutral-100">
              <p class="text-xs font-semibold text-neutral-500 mb-1">Premiere impression</p>
              <p class="text-sm text-neutral-700 italic">"{p.premierImpression}"</p>
            </div>

            <!-- Question cle + reponse -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
              <div class="bg-white/70 rounded-lg p-3 border border-neutral-100">
                <p class="text-xs font-semibold text-neutral-500 mb-1">Question cle</p>
                <p class="text-sm text-neutral-700">"{p.questionCle}"</p>
              </div>
              <div class="bg-white/70 rounded-lg p-3 border border-neutral-100">
                <p class="text-xs font-semibold text-neutral-500 mb-1">Le site repond ? <span class={p.reponse === 'Oui' ? 'text-green-600' : p.reponse === 'Invisible' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</span></p>
                <p class="text-sm text-neutral-600">{p.commentReponse}</p>
              </div>
            </div>

            <!-- Points + frictions -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              {p.pointsPositifs.length > 0 && (
                <div>
                  <p class="text-xs font-semibold text-green-700 mb-1">Points positifs</p>
                  <ul class="space-y-1">
                    {p.pointsPositifs.map(pt => (
                      <li class="text-xs text-neutral-600 flex items-start gap-1"><span class="text-green-500 shrink-0">+</span>{pt}</li>
                    ))}
                  </ul>
                </div>
              )}
              {p.frictions.length > 0 && (
                <div>
                  <p class="text-xs font-semibold text-red-600 mb-1">Frictions</p>
                  <ul class="space-y-1">
                    {p.frictions.map(fr => (
                      <li class="text-xs text-neutral-600 flex items-start gap-1"><span class="text-red-400 shrink-0">−</span>{fr}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            {p.impactTechnique && (
              <p class="text-xs text-neutral-400 mt-3 pt-3 border-t border-neutral-200/60 italic">{p.impactTechnique}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       RECOMMANDATIONS
  ======================================================== -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-8">Plan d'action</h2>

      <!-- Critiques -->
      <h3 class="font-heading text-base font-bold text-red-700 uppercase tracking-wider mb-4">Priorite haute — impact immédiat</h3>
      <div class="space-y-4 mb-10">
        {ameliorationsCritiques.map((a, i) => (
          <div class="bg-white rounded-xl border border-red-100 p-5">
            <div class="flex items-start gap-3">
              <span class="inline-flex w-7 h-7 rounded-full bg-red-600 text-white text-sm font-bold items-center justify-center shrink-0">{i + 1}</span>
              <div>
                <p class="font-heading font-semibold text-neutral-900 mb-2">{a.titre}</p>
                <p class="text-sm text-neutral-600 leading-relaxed mb-2">{a.detail}</p>
                <p class="text-xs text-red-700 font-medium bg-red-50 rounded-lg px-3 py-2">{a.action}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Utiles -->
      <h3 class="font-heading text-base font-bold text-amber-700 uppercase tracking-wider mb-4">Priorite moyenne — ameliorations durables</h3>
      <div class="space-y-4 mb-10">
        {ameliorationsUtiles.map((a, i) => (
          <div class="bg-white rounded-xl border border-amber-100 p-5">
            <div class="flex items-start gap-3">
              <span class="inline-flex w-7 h-7 rounded-full bg-amber-500 text-white text-sm font-bold items-center justify-center shrink-0">{i + 4}</span>
              <div>
                <p class="font-heading font-semibold text-neutral-900 mb-1">{a.titre}</p>
                <p class="text-sm text-neutral-600 leading-relaxed">{a.detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="bg-neutral-900 rounded-2xl p-8 text-center text-white">
        <p class="text-xs font-semibold text-amber-400 uppercase tracking-widest mb-3">Proposition Web Factory</p>
        <h3 class="font-heading text-2xl font-bold mb-3">Neroza merite un site a la hauteur de sa reputation</h3>
        <p class="text-neutral-400 text-sm mb-6 max-w-lg mx-auto">
          49 avis 5 etoiles. Un savoir-faire haut de gamme reconnu. Un site Wix qui ne le montre pas.
          Migration Astro + Cloudflare Pages : PageSpeed 90+, Observatory A, temoignages integres, analytics, Schema.org complet.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="/contact" class="inline-block bg-amber-400 text-neutral-900 font-bold text-sm px-6 py-3 rounded-xl hover:bg-amber-300 transition-colors">
            Proposer ce rapport
          </a>
          <a href="/offre" class="inline-block border border-neutral-600 text-neutral-300 font-medium text-sm px-6 py-3 rounded-xl hover:border-neutral-400 transition-colors">
            Voir l'offre Web Factory
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
