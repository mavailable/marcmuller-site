  { nom: 'CLS', description: 'Cumulative Layout Shift', valeur: '~0.08', label: 'BON', bgCouleur: 'bg-green-50', couleurTexte: 'text-green-700', badgeCouleur: 'bg-green-100 text-green-800' },
];

const observatoryGrade = { grade: 'D', score: 30, passed: 6, total: 10 };

const schemaTypes = [
  { name: 'Organization', present: true },
  { name: 'WebSite', present: true },
  { name: 'WebPage', present: true },
  { name: 'BreadcrumbList', present: true },
  { name: 'ProfessionalService', present: false },
  { name: 'telephone', present: false },
  { name: 'openingHours', present: false },
  { name: 'aggregateRating', present: false },
  { name: 'hasOfferCatalog', present: false },
  { name: 'knowsAbout (GEO)', present: false },
];

const ogTags = [
  { name: 'og:title', present: true },
  { name: 'og:description', present: true },
  { name: 'og:image', present: false },
  { name: 'og:url', present: true },
  { name: 'og:type', present: true },
  { name: 'og:locale', present: true },
  { name: 'twitter:card', present: true },
  { name: 'twitter:image', present: false },
  { name: 'canonical', present: false },
];

const securityHeaders = [
  { name: 'Content-Security-Policy (CSP)', present: false },
  { name: 'Strict-Transport-Security (HSTS)', present: false },
  { name: 'X-Frame-Options', present: false },
  { name: 'X-Content-Type-Options', present: false },
  { name: 'HTTPS redirect', present: true },
  { name: 'CORS securise', present: true },
];

const pagespeedOpps = [
  { label: 'Reduire le JavaScript inutilise (Divi ~800Ko)', gain: '~1.5s LCP' },
  { label: 'Supprimer les CSS inutilises (Divi excessif)', gain: '~0.8s' },
  { label: 'Optimiser les images (EWWW actif mais incomplet)', gain: '~0.5s' },
  { label: 'Reduire les ressources bloquant le rendu (polices)', gain: '~0.4s' },
  { label: 'Preconnexion domaines tiers (GA4, CookieYes)', gain: '~0.2s' },
];

const ameliorations = {
  haute: [
    { titre: 'Afficher une fourchette tarifaire', detail: '12 personas sur 20 sont bloques par l\'absence de prix. Meme "a partir de X€/jour" suffit pour debloquer les decisions en mode comparaison.', action: 'Ajouter une section tarifaire sur chaque page de prestation, ou une page "/tarifs" avec taux journalier indicatif et conditions de devis.' },
    { titre: 'Ajouter un numero de telephone cliquable', detail: '10 personas sur 20 auraient prefere appeler directement. Les directeurs d\'etablissements (50 ans+) sont des telephoneurs, pas des formulaires.', action: 'Telephone cliquable en header mobile, dans le formulaire de contact, et en footer. Format : 06 XX XX XX XX avec call-to-action "Appelez directement".' },
    { titre: 'Ajouter des references par type d\'etablissement', detail: '9 personas cherchent la correspondance avec leur type d\'etablissement (EHPAD, IME, SSIAD, AEMO, CPTS, SIAO...). Sans cette correspondance, la confiance reste partielle.', action: 'Sur chaque page de prestation, ajouter une liste "J\'ai accompagne : [type 1], [type 2], [type 3]..." avec si possible des logos ou noms d\'etablissements (avec accord).' },
    { titre: 'Optimiser la performance mobile', detail: '8 personas percus negativement par les 3-4s de chargement. Pour une professionnelle du secteur medico-social, un site lent signale un manque de professionnalisme.', action: 'Desactiver les modules Divi inutilises, optimiser les images a la source, ou envisager une migration vers un outil moderne (Astro + Cloudflare Pages = LCP < 1.5s garanti).' },
    { titre: 'Creer une FAQ sur chaque page de prestation', detail: '7 personas ont des questions specifiques que le site ne resout pas (comment ca se deroule ? combien de jours ? quels livrables ? quel calendrier ?).', action: 'Ajouter une section FAQ sur chaque page : "Comment se deroule une evaluation externe ESSMS ?" / "Que comprend un accompagnement MSP ?" etc.' },
  ],
  moyenne: [
    { titre: 'Afficher le numero d\'agrement evaluatrice externe', detail: 'Les DG et directeurs de federations verifient l\'agrement officiel avant tout appel d\'offres ou convention. L\'absence du numero cree un doute.' },
    { titre: 'Ameliorer la securite HTTP (grade D → A)', detail: 'Headers manquants : CSP, HSTS, X-Frame-Options, X-Content-Type-Options. Pour un cabinet traitant des donnees sensibles (RGPD secteur social), le grade D est un signal de risque.' },
    { titre: 'Ajouter une og:image de qualite', detail: '5 personas sont genes par les partages LinkedIn/email sans visuel. Une image professionnelle de Caroline ou un visuel de marque suffit.' },
    { titre: 'Creer un contenu educatif pour les phases de decouverte', detail: '4 personas en decouverte repartent sans laisser de trace. Un guide gratuit (PDF) ou une newsletter sectorielle les aurait captures dans un tunnel de conversion long.' },
  ],
  discuter: [
    { emoji: '🚀', titre: 'Refonte avec un outil moderne', detail: 'Migrer de WordPress/Divi vers Astro + Cloudflare Pages : LCP < 1.5s, grade A Observatory natif, cout de maintenance reduit. Cout unique vs maintenance WordPress perpetuelle.' },
    { emoji: '✍️', titre: 'Activer un blog sectoriel', detail: 'Articles sur la loi 2022 (evaluation ESSMS), creation de MSP, CPTS, etc. Capture les personas en phase decouverte (Laure, Mohamed niveau 1) et ameliore le SEO de longue traine.' },
    { emoji: '📣', titre: 'Temoignages clients structures', detail: 'Meme anonymises ("Directrice d\'EHPAD, Grand Est"), les temoignages augmentent la confiance de 30% sur les personas en mode comparaison.' },
  ],
};

function scoreColor(score: number): string {
  if (score >= 90) return '#22c55e';
  if (score >= 50) return '#f59e0b';
  return '#ef4444';
}
function scoreTextColor(score: number): string {
  if (score >= 90) return 'text-green-600';
  if (score >= 50) return 'text-amber-600';
  return 'text-red-500';
}
---

<BaseLayout title={title} description={description} noindex={true} lang="fr" frPath="/audit/service-social-independant">

  <!-- HERO -->
  <section class="bg-primary-900 text-white py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <span class="inline-block text-xs font-semibold bg-white/10 text-white/80 px-3 py-1 rounded-full mb-4">Rapport confidentiel</span>
      <h1 class="font-heading text-2xl md:text-4xl font-bold text-white mb-3">
        Audit UX + Technique<br/><span class="text-accent-400">Service Social Independant</span>
      </h1>
      <p class="text-white/70 mb-5 max-w-2xl">
        Site teste : service-social-independant.fr — {personas.length} personas simules — Rapport genere le 29 mars 2026
      </p>
      <div class="flex flex-wrap gap-2">
        <span class="text-xs bg-white/10 text-white/80 px-2.5 py-1 rounded-full">{personas.length} personas</span>
        <span class="text-xs bg-white/10 text-white/80 px-2.5 py-1 rounded-full">5 canaux</span>
        <span class="text-xs bg-white/10 text-white/80 px-2.5 py-1 rounded-full">WordPress + Divi</span>
        <span class="text-xs bg-white/10 text-white/80 px-2.5 py-1 rounded-full">France entiere</span>
      </div>
    </div>
  </section>

  <!-- TAB BAR STICKY -->
  <nav class="sticky top-16 md:top-20 z-40 bg-white/95 backdrop-blur border-b border-neutral-200" id="tab-bar">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 h-12 text-sm overflow-x-auto">
      <button data-tab="0" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-primary-700 bg-primary-50">Synthese</button>
      <button data-tab="1" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">Technique</button>
      <button data-tab="2" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">
        Visiteurs <span class="ml-1 text-xs text-neutral-400">{personas.length}</span>
      </button>
      <button data-tab="3" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">
        Ameliorations <span class="ml-1 text-xs text-neutral-400">{ameliorations.haute.length + ameliorations.moyenne.length}</span>
      </button>
    </div>
  </nav>

  <!-- PANELS -->
  <div id="panels" class="flex overflow-x-auto snap-x snap-mandatory" style="-webkit-overflow-scrolling: touch; scrollbar-width: none;">

    <!-- PANEL 1 : SYNTHESE -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0 bg-neutral-50 py-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- KPI Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <div class="bg-white rounded-xl p-5 border border-neutral-200 text-center shadow-sm">
            <p class="text-3xl font-black text-accent-500 mb-1">{tauxConv}%</p>
            <p class="text-xs text-neutral-500 font-medium">Taux de conversion</p>
          </div>
          <div class="bg-white rounded-xl p-5 border border-neutral-200 text-center shadow-sm">
            <p class="text-3xl font-black text-primary-700 mb-1">{avgExp}</p>
            <p class="text-xs text-neutral-500 font-medium">Score experience</p>
          </div>
          <div class="bg-white rounded-xl p-5 border border-neutral-200 text-center shadow-sm">
            <p class="text-3xl font-black text-primary-700 mb-1">{avgConf}</p>
            <p class="text-xs text-neutral-500 font-medium">Score confiance</p>
          </div>
          <div class="bg-white rounded-xl p-5 border border-neutral-200 text-center shadow-sm">
            <p class="text-3xl font-black text-primary-700 mb-1">{avgClarte}</p>
            <p class="text-xs text-neutral-500 font-medium">Score clarte</p>
          </div>
        </div>

        <!-- Paradoxe principal -->
        <div class="bg-accent-50 border border-accent-200 rounded-xl p-5 mb-8">
          <p class="text-xs font-bold text-accent-700 uppercase tracking-wide mb-2">Paradoxe principal</p>
          <p class="text-sm text-neutral-800 font-medium leading-relaxed">
            Ce site a un taux de conversion de 50% — mais <strong>100% des conversions viennent des personas deja convaincus avant d'arriver</strong> (recommandation, email direct, IA avec besoin clair). Les personas arrivant par Google Search ne convertissent qu'a 29%. Le site confirme les decides mais ne convainc pas les indecis.
          </p>
        </div>

        <!-- Conversion par canal -->
        <div class="bg-white rounded-xl border border-neutral-200 p-6 mb-6 shadow-sm">
          <h3 class="font-semibold text-neutral-900 mb-4">Conversion par canal</h3>
          <div class="space-y-3">
            {canalStats.map(c => {
              const pct = Math.round((c.conv / c.total) * 100);
              const color = pct >= 70 ? 'bg-green-500' : pct >= 30 ? 'bg-amber-400' : 'bg-red-400';
              return (
                <div class="flex items-center gap-3">
                  <span class="text-sm text-neutral-700 w-52 shrink-0">{c.canal}</span>
                  <div class="flex-1 bg-neutral-100 rounded-full h-2">
                    <div class={`h-2 rounded-full ${color}`} style={`width: ${pct}%`}></div>
                  </div>
                  <span class={`text-sm font-bold w-10 text-right ${pct >= 70 ? 'text-green-600' : pct >= 30 ? 'text-amber-600' : 'text-red-500'}`}>{pct}%</span>
                  <span class="text-xs text-neutral-400">{c.conv}/{c.total}</span>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Conversion par maturite + device -->
        <div class="grid md:grid-cols-2 gap-6 mb-6">
          <div class="bg-white rounded-xl border border-neutral-200 p-5 shadow-sm">
            <h3 class="font-semibold text-neutral-900 mb-4">Par niveau de maturite</h3>
            <div class="space-y-3">
              {maturiteStats.map(m => (
                <div class="flex items-center justify-between">
                  <span class="text-sm text-neutral-700">{m.level}</span>
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-neutral-400">{m.total} personas</span>
                    <span class={`text-sm font-bold ${m.level === 'Decision' ? 'text-green-600' : m.level === 'Comparaison' ? 'text-amber-600' : 'text-red-500'}`}>{m.pct}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-white rounded-xl border border-neutral-200 p-5 shadow-sm">
            <h3 class="font-semibold text-neutral-900 mb-4">Par device</h3>
            <div class="space-y-3">
              {[
                { device: 'Desktop', conv: 5, total: 7 },
                { device: 'Tablette', conv: 2, total: 3 },
                { device: 'Mobile', conv: 3, total: 10 },
              ].map(d => {
                const pct = Math.round((d.conv / d.total) * 100);
                const color = pct >= 60 ? 'text-green-600' : pct >= 30 ? 'text-amber-600' : 'text-red-500';
                return (
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-neutral-700">{d.device}</span>
                    <div class="flex items-center gap-2">
                      <span class="text-xs text-neutral-400">{d.conv}/{d.total}</span>
                      <span class={`text-sm font-bold ${color}`}>{pct}%</span>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        <!-- Frictions recurrentes -->
        <div class="bg-white rounded-xl border border-neutral-200 p-6 shadow-sm">
          <h3 class="font-semibold text-neutral-900 mb-4">Frictions recurrentes</h3>
          <div class="space-y-2">
            {[
              { f: 'Pas de prix / fourchette tarifaire', n: 12, sev: 'critique' },
              { f: 'Pas de telephone cliquable', n: 10, sev: 'haute' },
              { f: 'Pas de references par type d\'etablissement', n: 9, sev: 'haute' },
              { f: 'Site lent sur mobile (3-4s+)', n: 8, sev: 'haute' },
              { f: 'Pas de FAQ sur les prestations', n: 7, sev: 'haute' },
              { f: 'Pas de description detaillee des missions', n: 7, sev: 'haute' },
            ].map(fr => (
              <div class="flex items-center justify-between py-2 border-b border-neutral-100 last:border-0">
                <span class="text-sm text-neutral-700">{fr.f}</span>
                <div class="flex items-center gap-2">
                  <span class={`text-[10px] px-2 py-0.5 rounded font-medium ${fr.sev === 'critique' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>{fr.sev}</span>
                  <span class="text-xs text-neutral-500">{fr.n}/20</span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- PANEL 2 : TECHNIQUE -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0 bg-white py-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

        <p class="text-xs text-neutral-500 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2 mb-6">
          Scores PageSpeed estimes (API rate-limitee) a partir de l'analyse de la stack : WordPress 6.9.4 + Divi 4.27.5 + WP Rocket 3.20. Securite verifiee via Mozilla Observatory.
        </p>

        <!-- PageSpeed scores -->
        <h3 class="font-semibold text-neutral-900 mb-4">Scores Lighthouse</h3>
        <div class="grid md:grid-cols-2 gap-6 mb-8">
          {(['mobile', 'desktop']).map(strategy => (
            <div class="bg-neutral-50 rounded-xl border border-neutral-200 p-5">
              <p class="text-sm font-bold text-neutral-700 mb-4 capitalize">{strategy}</p>
              <div class="grid grid-cols-4 gap-3">
                {Object.entries(lighthouseScores[strategy as 'mobile' | 'desktop']).map(([key, score]) => {
                  const labels = { perf: 'Perf', access: 'Access', bp: 'Pratiques', seo: 'SEO' } as { [k: string]: string };
                  const c = scoreColor(score);
                  const tc = scoreTextColor(score);
                  return (
                    <div class="text-center">
                      <div class="relative w-14 h-14 mx-auto mb-1.5">
                        <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
                          <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e5e7eb" stroke-width="3"/>
                          <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke={c} stroke-width="3" stroke-dasharray={`${score}, 100`} stroke-linecap="round"/>
                        </svg>
                        <span class={`absolute inset-0 flex items-center justify-center text-base font-bold ${tc}`}>{score}</span>
                      </div>
                      <p class="text-[10px] text-neutral-500 font-medium">{labels[key]}</p>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>

        <!-- Core Web Vitals -->
        <h3 class="font-semibold text-neutral-900 mb-3">Core Web Vitals (mobile)</h3>
        <div class="space-y-2 mb-8">
          {coreWebVitals.map(v => (
            <div class={`flex items-center justify-between p-3 rounded-lg ${v.bgCouleur}`}>
              <div>
                <span class="text-xs font-bold text-neutral-700">{v.nom}</span>
                <span class="text-xs text-neutral-500 ml-1">({v.description})</span>
              </div>
              <div class="flex items-center gap-2">
                <span class={`text-sm font-bold ${v.couleurTexte}`}>{v.valeur}</span>
                <span class={`text-[10px] px-1.5 py-0.5 rounded font-medium ${v.badgeCouleur}`}>{v.label}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Observatory -->
        <h3 class="font-semibold text-neutral-900 mb-3">Securite HTTP — Mozilla Observatory</h3>
        <div class="flex items-center gap-4 p-4 rounded-xl border-2 border-red-200 bg-red-50 mb-4">
          <div class="text-4xl font-black text-red-600">{observatoryGrade.grade}</div>
          <div>
            <p class="text-sm font-semibold text-neutral-900">Securite insuffisante</p>
            <p class="text-xs text-neutral-500">{observatoryGrade.passed}/{observatoryGrade.total} tests passes — Score {observatoryGrade.score}/100</p>
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-3 mb-8">
          {securityHeaders.map(h => (
            <div class="flex items-center gap-2 py-1.5">
              {h.present ? (
                <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              ) : (
                <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              )}
              <span class={`text-sm ${h.present ? 'text-neutral-700' : 'text-neutral-400 line-through'}`}>{h.name}</span>
            </div>
          ))}
        </div>

        <!-- Schema.org -->
        <h3 class="font-semibold text-neutral-900 mb-3">Schema.org (donnees structurees)</h3>
        <div class="bg-neutral-50 rounded-xl border border-neutral-200 p-5 mb-6">
          <p class="text-xs text-neutral-500 mb-3">Via Yoast SEO — {schemaTypes.filter(s => s.present).length}/{schemaTypes.length} champs cles presents</p>
          <div class="grid md:grid-cols-2 gap-x-4">
            {schemaTypes.map(s => (
              <div class="flex items-center gap-2 py-1">
                {s.present ? (
                  <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                ) : (
                  <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                )}
                <span class={`text-sm ${s.present ? 'text-neutral-700' : 'text-neutral-400 line-through'}`}>{s.name}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Open Graph -->
        <h3 class="font-semibold text-neutral-900 mb-3">Open Graph & meta SEO</h3>
        <div class="bg-neutral-50 rounded-xl border border-neutral-200 p-5 mb-6">
          <p class="text-xs text-neutral-500 mb-3">{ogTags.filter(t => t.present).length}/{ogTags.length} tags presents</p>
          <div class="grid md:grid-cols-2 gap-x-4">
            {ogTags.map(t => (
              <div class="flex items-center gap-2 py-1">
                {t.present ? (
                  <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                ) : (
                  <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                )}
                <span class={`text-sm ${t.present ? 'text-neutral-700' : 'text-neutral-400 line-through'}`}>{t.name}</span>
              </div>
            ))}
          </div>
          <div class="mt-4 p-3 bg-amber-50 rounded-lg border border-amber-200">
            <p class="text-xs text-amber-800"><strong>Impact LinkedIn :</strong> og:image absente = partages sans visuel. Les directeurs et coordinateurs qui partagent le profil de Caroline a leur hierarchie voient un lien texte brut, pas une carte attractive.</p>
          </div>
        </div>

        <!-- PageSpeed Opportunites -->
        <h3 class="font-semibold text-neutral-900 mb-3">Top 5 opportunites de performance</h3>
        <div class="space-y-2">
          {pagespeedOpps.map((o, i) => (
            <div class="flex items-start gap-3 p-3 bg-neutral-50 rounded-lg border border-neutral-200">
              <span class="text-xs font-bold text-neutral-400 mt-0.5 w-4 shrink-0">{i+1}</span>
              <div class="flex-1">
                <p class="text-sm text-neutral-700">{o.label}</p>
              </div>
              <span class="text-xs font-semibold text-green-600 shrink-0">{o.gain}</span>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- PANEL 3 : VISITEURS -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0 bg-neutral-50 py-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Stats row -->
        <div class="flex flex-wrap gap-4 mb-8">
          <div class="flex items-center gap-2 bg-green-50 border border-green-200 rounded-xl px-5 py-3">
            <span class="text-2xl font-black text-green-600">{convertis}</span>
            <span class="text-sm text-green-700 font-medium">contactent</span>
          </div>
