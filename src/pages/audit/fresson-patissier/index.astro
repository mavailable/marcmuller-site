      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-4">Rapport personnalisé</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2">{prospect.name} — ce que vos visiteurs pensent vraiment</h1>
      <p class="text-neutral-400 mb-1">{prospect.activity} — <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener noreferrer">{prospect.url}</a></p>
      <p class="text-neutral-500 text-sm mb-8">{prospect.location} · Analyse du {prospect.date}</p>
      <div class="grid grid-cols-3 gap-4 max-w-lg">
        <div class="text-center bg-neutral-800/60 rounded-xl p-4">
          <span class="block text-3xl font-black text-amber-400">{kpis.conversion}%</span>
          <span class="text-xs text-neutral-400">convertissent</span>
        </div>
        <div class="text-center bg-neutral-800/60 rounded-xl p-4">
          <span class="block text-3xl font-black text-amber-400">{kpis.experience}/10</span>
          <span class="text-xs text-neutral-400">expérience</span>
        </div>
        <div class="text-center bg-neutral-800/60 rounded-xl p-4">
          <span class="block text-3xl font-black text-amber-400">{kpis.confiance}/10</span>
          <span class="text-xs text-neutral-400">confiance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CONSTAT -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-amber-900 font-medium text-base">{constat}</p>
      </div>

      <!-- Conversion par canal -->
      <h3 class="font-semibold text-neutral-700 mb-4 text-sm uppercase tracking-wide">Conversion par canal d'arrivée</h3>
      <div class="space-y-3 mb-10">
        {conversionByCanal.map(item => (
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-sm text-neutral-700">{item.canal}</span>
              <span class={`text-sm font-bold ${item.color}`}>{item.taux}%</span>
            </div>
            <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
              <div class={`h-full rounded-full ${item.bg}`} style={`width: ${item.taux}%`}></div>
            </div>
          </div>
        ))}
      </div>

      <!-- Top frictions -->
      <h3 class="font-semibold text-neutral-700 mb-4 text-sm uppercase tracking-wide">Top 5 frictions identifiées</h3>
      <ol class="space-y-3">
        {topFrictions.map((f, i) => (
          <li class="flex gap-3 p-4 bg-neutral-50 border border-neutral-100 rounded-xl">
            <span class="shrink-0 w-7 h-7 flex items-center justify-center bg-red-100 text-red-700 font-bold text-sm rounded-full">{i + 1}</span>
            <div>
              <p class="font-semibold text-neutral-900 text-sm">{f.titre} <span class="font-normal text-neutral-500">({f.count}/10 personas)</span></p>
              <p class="text-xs text-neutral-600 mt-0.5">{f.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- AUDIT TECHNIQUE -->
  <section class="py-12 px-4 bg-neutral-50 border-y border-neutral-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">L'audit technique</h2>

      <!-- PageSpeed mobile -->
      <div class="bg-white rounded-xl border border-neutral-100 p-6 mb-6">
        <h3 class="font-semibold text-neutral-700 mb-1 text-sm">Lighthouse Mobile <span class="text-neutral-400 font-normal">(scores estimés — PHP 7.4, jQuery Superslides, images non optimisées, pas de compression)</span></h3>
        <p class="text-xs text-neutral-400 mb-5">Base : PHP 7.4 custom fin de vie, jQuery legacy, pas de WebP, pas de lazy loading, pas de cache headers</p>
        <div class="grid grid-cols-4 gap-4">
          {[
            { label: 'Performance', score: pagespeed.mobile.performance },
            { label: 'Accessibilité', score: pagespeed.mobile.accessibility },
            { label: 'Bonnes pratiques', score: pagespeed.mobile.bestPractices },
            { label: 'SEO', score: pagespeed.mobile.seo },
          ].map(item => (
            <div class="text-center">
              <div class="relative w-16 h-16 mx-auto mb-2">
                <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e5e7eb" stroke-width="3"/>
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke={scoreColor(item.score)} stroke-width="3" stroke-dasharray={`${item.score}, 100`} stroke-linecap="round"/>
                </svg>
                <span class={`absolute inset-0 flex items-center justify-center text-sm font-bold ${scoreLabel(item.score)}`}>{item.score}</span>
              </div>
              <p class="text-xs text-neutral-600">{item.label}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- PageSpeed desktop -->
      <div class="bg-white rounded-xl border border-neutral-100 p-6 mb-6">
        <h3 class="font-semibold text-neutral-700 mb-1 text-sm">Lighthouse Desktop</h3>
        <div class="grid grid-cols-4 gap-4">
          {[
            { label: 'Performance', score: pagespeed.desktop.performance },
            { label: 'Accessibilité', score: pagespeed.desktop.accessibility },
            { label: 'Bonnes pratiques', score: pagespeed.desktop.bestPractices },
            { label: 'SEO', score: pagespeed.desktop.seo },
          ].map(item => (
            <div class="text-center">
              <div class="relative w-16 h-16 mx-auto mb-2">
                <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e5e7eb" stroke-width="3"/>
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke={scoreColor(item.score)} stroke-width="3" stroke-dasharray={`${item.score}, 100`} stroke-linecap="round"/>
                </svg>
                <span class={`absolute inset-0 flex items-center justify-center text-sm font-bold ${scoreLabel(item.score)}`}>{item.score}</span>
              </div>
              <p class="text-xs text-neutral-600">{item.label}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Core Web Vitals + Observatory -->
      <div class="grid md:grid-cols-2 gap-4 mb-6">
        <div class="bg-white rounded-xl border border-neutral-100 p-5">
          <h3 class="font-semibold text-neutral-700 mb-3 text-sm">Core Web Vitals (mobile)</h3>
          <div class="space-y-2">
            {coreWebVitals.map(v => (
              <div class="flex items-center justify-between text-sm">
                <span class="text-neutral-600">{v.name}</span>
                <span class={`font-semibold px-2 py-0.5 rounded text-xs ${v.status === 'vert' ? 'bg-green-100 text-green-700' : v.status === 'orange' ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700'}`}>{v.value}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-white rounded-xl border border-neutral-100 p-5">
          <h3 class="font-semibold text-neutral-700 mb-3 text-sm">Sécurité — Headers HTTP</h3>
          <div class="flex items-center gap-4 mb-3">
            <div class={`text-4xl font-black ${observatory.grade.startsWith('A') ? 'text-green-600' : observatory.grade.startsWith('B') ? 'text-amber-500' : 'text-red-500'}`}>{observatory.grade}</div>
            <div>
              <p class="text-2xl font-bold text-neutral-800">{observatory.score}/100</p>
              <p class="text-xs text-neutral-500">{observatory.testsPassed}/{observatory.testsTotal} tests passés</p>
            </div>
          </div>
          <p class="text-xs text-neutral-500">0 header de sécurité (HSTS, CSP, X-Frame-Options, X-Content-Type-Options...). PHP 7.4 exposé via X-Powered-By — faille informationnelle critique.</p>
        </div>
      </div>

      <!-- Checklist SEO + Schema -->
      <div class="bg-white rounded-xl border border-neutral-100 p-5">
        <h3 class="font-semibold text-neutral-700 mb-3 text-sm">Checklist Schema.org / OG / SEO / Sécurité</h3>
        <div class="grid sm:grid-cols-2 gap-1.5">
          {techChecks.map(c => (
            <div class={`flex items-start gap-2 text-xs p-2 rounded-lg ${c.present ? 'bg-green-50' : c.critical ? 'bg-red-50' : 'bg-neutral-50'}`}>
              <span class={`shrink-0 font-bold ${c.present ? 'text-green-600' : 'text-red-500'}`}>{c.present ? '\u2713' : '\u2717'}</span>
              <span class={c.present ? 'text-neutral-700' : c.critical ? 'text-red-700 font-medium' : 'text-neutral-500'}>{c.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- VISITEURS SIMULES -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs simulés</h2>
      <p class="text-neutral-500 mb-6 text-sm">
        Sur 10 visiteurs simulés :
        <span class="font-semibold text-green-600">{convertissent} contactent</span>,
        <span class="font-semibold text-amber-600">{hesitent} hésitent</span>,
        <span class="font-semibold text-neutral-600">{quittent} repartent</span> sans agir.
      </p>

      <div class="space-y-3">
        {personas.map(p => {
          const ds = decisionStyle(p.decision);
          const avgScore = Math.round((p.scores.exp + p.scores.conf + p.scores.clarte) / 3 * 10) / 10;
          return (
            <details class={`group border ${ds.border} ${ds.bg} rounded-xl overflow-hidden`}>
              <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                    <h3 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h3>
                    <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                    <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                    <span class={`text-[11px] px-1.5 py-0.5 rounded font-medium ${ds.badge}`}>{decisionLabel(p.decision)}</span>
                  </div>
                  <p class="text-xs text-neutral-500">{p.situation}</p>
                </div>
                <div class="text-right shrink-0">
                  <span class="text-xs font-bold text-neutral-600">{avgScore}/10</span>
                  <svg class="w-5 h-5 text-neutral-400 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </div>
              </summary>
              <div class="px-4 pb-4 pt-3 border-t border-neutral-100 bg-white/70">
                <div class="grid gap-3 text-xs">
                  <div>
                    <p class="font-semibold text-neutral-700 mb-1">Première impression</p>
                    <p class="text-neutral-600">{p.premierImpression}</p>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-700 mb-1">Parcours</p>
                    <p class="text-neutral-500">{p.parcours.join(' \u2192 ')}</p>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-700 mb-1">Question clé</p>
                    <p class="text-neutral-600 italic">"{p.questionCle}"</p>
                    <p class="text-neutral-600 mt-1">Réponse du site : <strong>{p.reponse}</strong> — {p.commentReponse}</p>
                  </div>
                  <div class="text-xs text-neutral-500 bg-neutral-50 rounded-lg px-3 py-2">
                    Impact technique : {p.impactTechnique}
                  </div>
                  <div class="grid sm:grid-cols-2 gap-3">
                    <div>
                      <p class="font-semibold text-green-700 mb-1">Points positifs</p>
                      <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                        {p.pointsPositifs.map(pp => <li>{pp}</li>)}
                      </ul>
                    </div>
                    <div>
                      <p class="font-semibold text-amber-700 mb-1">Frictions</p>
                      <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                        {p.frictions.map(fr => <li>{fr}</li>)}
                      </ul>
                    </div>
                  </div>
                  <div class="flex gap-4 text-xs">
                    <span class="text-neutral-500">Expérience : <strong>{p.scores.exp}/10</strong></span>
                    <span class="text-neutral-500">Confiance : <strong>{p.scores.conf}/10</strong></span>
                    <span class="text-neutral-500">Clarté : <strong>{p.scores.clarte}/10</strong></span>
                  </div>
                </div>
              </div>
            </details>
          );
        })}
      </div>
    </div>
  </section>

  <!-- RECOMMANDATIONS -->
  <section class="py-12 px-4 bg-neutral-50 border-y border-neutral-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Nos recommandations</h2>

      <h3 class="text-sm font-semibold uppercase tracking-wide text-red-600 mb-4">Le plus important — 3 actions critiques</h3>
      <div class="grid gap-4 mb-10">
        {ameliorationsCritiques.map((a, i) => (
          <div class="bg-white border-l-4 border-red-400 rounded-r-xl p-5 shadow-sm">
            <div class="flex items-start gap-3">
              <span class="shrink-0 w-7 h-7 flex items-center justify-center bg-red-100 text-red-700 font-bold text-sm rounded-full">{i + 1}</span>
              <div>
                <h4 class="font-semibold text-neutral-900 mb-1">{a.titre}</h4>
                <p class="text-sm text-neutral-600 mb-2">{a.detail}</p>
                <p class="text-xs bg-red-50 text-red-800 px-3 py-2 rounded-lg"><strong>Action :</strong> {a.action}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-sm font-semibold uppercase tracking-wide text-amber-600 mb-4">Utile aussi — 3 améliorations recommandées</h3>
      <div class="grid sm:grid-cols-3 gap-4">
        {ameliorationsUtiles.map(a => (
          <div class="bg-white border border-amber-200 rounded-xl p-4">
            <h4 class="font-semibold text-neutral-900 text-sm mb-2">{a.titre}</h4>
            <p class="text-xs text-neutral-600">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-neutral-900 text-white py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4">
        {kpis.conversion}% de vos visiteurs vous contactent.<br/>
        <span class="text-amber-400">Votre savoir-faire mérite mieux.</span>
      </h2>
      <p class="text-neutral-300 mb-8 max-w-xl mx-auto text-sm">
        MOF, Tablette d'Or 2024, plus d'un siècle d'histoire — et un site qui n'en parle presque pas.
        Ce rapport identifie 3 leviers critiques : les prix, l'adresse Metz, et le storytelling MOF.
        Je construis des sites qui font honneur à votre réputation — à partir de 990 euros, livré en 7 jours.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/commander/" class="inline-flex items-center gap-2 px-8 py-3.5 bg-[var(--color-accent)] text-white font-semibold rounded-xl hover:opacity-90 transition-all shadow-md">
          Je veux un site à la hauteur
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="/contact/" class="inline-flex items-center gap-2 px-8 py-3.5 border border-neutral-600 text-neutral-300 font-semibold rounded-xl hover:border-amber-400 hover:text-amber-400 transition-all">
          En discuter d'abord
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
