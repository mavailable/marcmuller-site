  { label: 'Meta title (55 car.) + meta description (131 car.)', present: true, critical: false },
  { label: 'H1 unique sur accueil', present: true, critical: false },
  { label: 'robots.txt accessible', present: true, critical: false },
  { label: 'Attributs alt sur toutes les images (30/30)', present: true, critical: false },
  { label: 'Images WebP partiellement (25/30)', present: true, critical: false },
  { label: 'HSTS + X-Frame-Options + X-Content-Type', present: true, critical: false },
  { label: 'Schema.org JSON-LD (LocalBusiness / RoofingContractor)', present: false, critical: true },
  { label: 'Open Graph (og:title, og:image, og:description)', present: false, critical: true },
  { label: 'Balise canonical (risque duplicate content pages villes)', present: false, critical: true },
  { label: 'Sitemap.xml accessible', present: false, critical: false },
