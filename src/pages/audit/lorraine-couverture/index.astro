---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX — Lorraine Couverture 57 | Marc M.';
const description = 'Audit complet du site lorraine-couverture-57.fr : 10 personas simules, zero Schema.org, 43 avis 4.8/5 totalement inexploites, jQuery superflu, recommandations actionnables pour couvreur Metz.';

