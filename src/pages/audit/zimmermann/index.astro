---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit Presence Digitale — Entreprise Zimmermann | Marc M';
const description = 'Audit complet de la presence digitale de l\'Entreprise Zimmermann (couvreur/zingueur/charpentier, Metz 57) : 10 personas simules, diagnostic site mort, recommandations actionnables.';

// ─── PROSPECT ───
const prospect = {
  name: 'Entreprise Zimmermann',
  url: 'https://entreprise-zimmermann.business.site/',
  date: '29 mars 2026',
  activity: 'Couvreur / Zingueur / Charpentier',
  location: 'Metz (57) — Moselle, Grand Est',
};

// ─── PERSONAS ───
const personas = [
  {
    id: 1,
    name: 'Bernard',
    age: 58,
    emoji: '🏠',
    canal: 'Google Search',
    maturite: 'Decision',
    device: 'Mobile',
    situation: 'Proprietaire Metz-Nord, fuite toiture apres tempete, urgence',
    contexte: 'Cherche "couvreur urgence metz" a 22h depuis son smartphone',
    parcours: ['URL morte', 'Erreur 404', 'Revient sur Google'],
    decision: 'quitte',
    scores: { exp: 1, conf: 0, clarte: 0 },
    premierImpression: 'Il clique sur le lien de la fiche Google, arrive sur une page d\'erreur 404. Incomprehension totale — il pense avoir mal tape.',
    questionCle: 'Vous pouvez venir en urgence reparer ma toiture ce soir ou demain matin ?',
    reponse: 'Non',
    commentReponse: 'Le site n\'existe plus, aucune reponse possible',
    impactTechnique: 'Site mort — visiteur perd confiance et appelle un concurrent trouve en 2e position',
    pointsPositifs: ['Fiche GBP visible sur Maps', 'Telephone probablement disponible sur la fiche'],
    frictions: ['Site 404 — impression d\'entreprise fermee', 'Aucun formulaire d\'urgence', 'Aucune info sur les urgences nuit/week-end', 'Perte de confiance immediate'],
  },
  {
    id: 2,
    name: 'Celine',
    age: 42,
    emoji: '👩',
    canal: 'Google Maps',
    maturite: 'Comparaison',
    device: 'Mobile',
    situation: 'Proprietaire Montigny-les-Metz, renovation toiture en 2026, 3 devis en cours',
    contexte: 'Consulte la fiche GBP Zimmermann depuis Maps, clique sur le lien site web',
    parcours: ['Fiche GBP', 'Lien site web', 'Erreur 404', 'Retour Maps'],
    decision: 'quitte',
    scores: { exp: 2, conf: 2, clarte: 1 },
    premierImpression: 'La fiche Maps semblait serieuse avec les avis. Mais le site web renvoie une erreur. "Sont-ils encore en activite ?"',
    questionCle: 'Faites-vous les ardoises et l\'isolation simultanement ? Quel est votre delai pour un devis ?',
    reponse: 'Non',
    commentReponse: 'Impossible d\'acceder a la moindre information',
    impactTechnique: 'Lien mort depuis la fiche GBP = signal de credibilite negatif fort',
    pointsPositifs: ['Avis GBP (si presents) peuvent rassurer avant clic'],
    frictions: ['Lien site web brise depuis la fiche GBP', 'Aucune galerie realisations accessible', 'Aucun formulaire devis', 'Concurrent avec site clair gagne la comparaison'],
  },
  {
    id: 3,
    name: 'Jacques',
    age: 67,
    emoji: '👴',
    canal: 'Bouche-a-oreille',
    maturite: 'Decision',
    device: 'Desktop',
    situation: 'Retraite Metz, voisin l\'a recommande, cherche le site pour confirmer le serieux',
    contexte: 'Tape "Entreprise Zimmermann Metz" dans Google sur son PC',
    parcours: ['Google', 'Lien business.site', 'Erreur 404', 'Cherche un autre lien'],
    decision: 'hesite',
    scores: { exp: 2, conf: 3, clarte: 1 },
    premierImpression: 'Le voisin lui a donne le numero ET le site. Le site ne fonctionne pas. Se demande s\'il a fait une erreur.',
    questionCle: 'Vous intervenez sur les maisons anciennes avec charpente du XIXe siecle ?',
    reponse: 'Non',
    commentReponse: 'Aucun site, aucune reponse possible',
    impactTechnique: 'Le bouche-a-oreille a pre-converti, mais le site mort cree un doute residuel',
    pointsPositifs: ['Recommandation directe tres forte', 'Probablement appelle quand meme'],
    frictions: ['Site mort fait douter de l\'activite de l\'entreprise', 'Pas de rassurance visuelle (photos realisations)', 'Pas de confirmation zone intervention', 'Pas de mention charpente ancienne'],
  },
  {
    id: 4,
    name: 'Aurelie',
    age: 35,
    emoji: '🧑‍💼',
    canal: 'IA (ChatGPT)',
    maturite: 'Comparaison',
    device: 'Desktop',
    situation: 'Gestionnaire patrimoine immobilier, 12 appartements, toitures a renover',
    contexte: 'Demande a ChatGPT les meilleurs couvreurs a Metz, verifie chaque nom trouve',
    parcours: ['ChatGPT', 'Recherche Google', 'Site mort', 'Passe au suivant'],
    decision: 'quitte',
    scores: { exp: 1, conf: 1, clarte: 0 },
    premierImpression: 'ChatGPT ne cite pas Zimmermann (pas de site = pas indexe). Elle tombe dessus via une autre source mais le site mort confirme son exclusion.',
    questionCle: 'Gerez-vous des chantiers multiples simultanes ? Etes-vous certifie RGE pour les aides ?',
    reponse: 'Non',
    commentReponse: 'Inexistant en ligne, invisible pour les outils IA',
    impactTechnique: 'Sans site structure, les IA ne peuvent pas citer Zimmermann dans leurs reponses',
    pointsPositifs: ['Metier a forte demande B2B gestion patrimoine'],
    frictions: ['Invisible pour ChatGPT, Perplexity, Claude', 'Aucune certification RGE visible', 'Aucune reference chantiers multiples', 'Competitor avec site RGE coche gagne automatiquement'],
  },
  {
    id: 5,
    name: 'Mathieu',
    age: 31,
    emoji: '🏗️',
    canal: 'Google Search',
    maturite: 'Decouverte',
    device: 'Mobile',
    situation: 'Jeune proprietaire Woippy, premier achat, toiture en bac acier a verifier',
    contexte: 'Cherche "couvreur bac acier metz" pour un premier devis exploratoire',
    parcours: ['SERP Google', 'Zimmermann absent des resultats', 'Clique sur concurrent'],
    decision: 'quitte',
    scores: { exp: 0, conf: 0, clarte: 0 },
    premierImpression: 'N\'arrive meme pas sur le site — Zimmermann est absent des resultats Google faute de site indexe.',
    questionCle: 'Intervenez-vous sur le bac acier ? C\'est quoi le prix au m2 ?',
    reponse: 'Non',
    commentReponse: 'Entreprise invisible sur les moteurs de recherche',
    impactTechnique: 'Sans site indexe, Zimmermann est absent du top 10 Google pour toutes les requetes couverture',
    pointsPositifs: ['Secteur bac acier en forte demande dans le neuf'],
    frictions: ['Zero visibilite SEO', 'Concurrent avec contenu "bac acier metz" capte ce trafic', 'Pas de page prix indicatifs', 'Absence totale sur SERP Google'],
  },
  {
    id: 6,
    name: 'Martine',
    age: 52,
    emoji: '🏛️',
    canal: 'Google Search',
    maturite: 'Comparaison',
    device: 'Desktop',
    situation: 'Syndic de copropriete Metz-Centre, 3 immeubles, toiture zinc a refaire',
    contexte: 'Demande de devis pour renovation zinc, compare 4 artisans locaux',
    parcours: ['Google "zingueur metz"', 'Zimmermann absent', 'Shortlist sans Zimmermann'],
    decision: 'quitte',
    scores: { exp: 0, conf: 0, clarte: 0 },
    premierImpression: 'Zimmermann n\'apparait pas dans sa recherche. Pourtant c\'est exactement son metier.',
    questionCle: 'Faites-vous les grandes surfaces de zinc (500m2) ? Devis detaille pour AG de copropriete ?',
    reponse: 'Non',
    commentReponse: 'Impossible — entreprise introuvable en ligne',
    impactTechnique: 'Marche B2B syndicats/coproprietes entierement manque par absence de site',
    pointsPositifs: ['Competence zinguerie = forte demande B2B Metz'],
    frictions: ['Absent de la recherche Google', 'Aucun devis PDF telechargeable', 'Pas de mention "syndicats/coproprietes"', 'Concurrent local avec site structure gagne'],
  },
  {
    id: 7,
    name: 'Karim',
    age: 44,
    emoji: '🔨',
    canal: 'Google Maps',
    maturite: 'Decision',
    device: 'Mobile',
    situation: 'Artisan macon Metz, recommande souvent des couvreurs a ses clients',
    contexte: 'Verifie si Zimmermann a encore un site pour lui envoyer des clients',
    parcours: ['Fiche GBP', 'Lien site web mort', 'Decide de ne plus recommander'],
    decision: 'quitte',
    scores: { exp: 1, conf: 2, clarte: 1 },
    premierImpression: 'Il connaissait Zimmermann de reputation. Le site mort lui fait perdre confiance pour recommander a ses propres clients.',
    questionCle: 'Je peux envoyer mes clients directement sur votre site pour qu\'ils voient vos realisations ?',
    reponse: 'Non',
    commentReponse: 'Site mort = perd un prescripteur de valeur',
    impactTechnique: 'Les prescripteurs (macon, plombier, agent immo) ont besoin d\'un site credible pour recommander',
    pointsPositifs: ['Reputation artisan connue localement'],
    frictions: ['Site mort coupe le flux de prescripteurs', 'Pas de galerie realisations partageables', 'Pas de carte de visite digitale', 'Concurrent recommande a la place'],
  },
  {
    id: 8,
    name: 'Isabelle',
    age: 38,
    emoji: '🌳',
    canal: 'Reseaux sociaux (Facebook)',
    maturite: 'Decouverte',
    device: 'Mobile',
    situation: 'Proprietaire Plappeville, vu une mention Zimmermann dans un groupe Facebook local',
    contexte: 'Clique sur le lien partage dans un groupe "Travaux Maison Metz" sur Facebook',
    parcours: ['Facebook groupe', 'Lien business.site', 'Erreur 404', 'Demande direct en commentaire'],
    decision: 'hesite',
    scores: { exp: 2, conf: 3, clarte: 1 },
    premierImpression: 'Le lien partage par quelqu\'un du groupe ne fonctionne pas. Elle poste "le lien est mort" sous la recommandation.',
    questionCle: 'Vous faites aussi l\'isolation des combles pendant la renovation de toiture ?',
    reponse: 'Non',
    commentReponse: 'Le lien mort devient un signal negatif dans le groupe Facebook',
    impactTechnique: 'Lien mort partage sur les reseaux = mauvaise publicite involontaire',
    pointsPositifs: ['Prescription communautaire tres forte dans les groupes locaux'],
    frictions: ['Lien mort cree un bad buzz leger dans le groupe', 'Aucun contenu partageable (avant/apres)', 'Pas de page Facebook entreprise active', 'Isolation combles non mentionnee'],
  },
  {
    id: 9,
    name: 'Pierre',
    age: 72,
    emoji: '🧓',
    canal: 'Bouche-a-oreille',
    maturite: 'Decision',
    device: 'Tablette',
    situation: 'Retraite Borny, fils lui a donne le numero ET l\'adresse du site',
    contexte: 'Essaie le site sur sa tablette avant d\'appeler pour "voir les photos des travaux"',
    parcours: ['Tape URL', 'Erreur 404', 'Ne comprend pas', 'Appelle quand meme'],
    decision: 'hesite',
    scores: { exp: 1, conf: 4, clarte: 0 },
    premierImpression: 'Ne comprend pas le message d\'erreur. Pense avoir mal tape. Essaie 3 fois. Se demande si l\'entreprise a ferme.',
    questionCle: 'Vous avez des photos de toitures que vous avez refaites dans le quartier ?',
    reponse: 'Non',
    commentReponse: 'Aucun visuel disponible, aucun site',
    impactTechnique: 'Seniors fortement penalises par l\'absence de support visuel en ligne',
    pointsPositifs: ['Appel telephonique possible grace au bouche-a-oreille', 'Le bon artisan recommande par le fils'],
    frictions: ['Page d\'erreur incomprehensible pour les non-techniciens', 'Aucune photo de reference', 'Incertitude sur l\'activite actuelle de l\'entreprise', 'Frein a la confiance sans rassurance visuelle'],
  },
  {
    id: 10,
    name: 'Yasmine',
    age: 26,
    emoji: '📱',
    canal: 'IA (Perplexity)',
    maturite: 'Decouverte',
    device: 'Mobile',
    situation: 'Etudiante en architecture Metz, recherche des artisans couvreurs locaux pour un projet',
    contexte: 'Demande a Perplexity "meilleurs couvreurs charpentiers metz moselle avec realisations en ligne"',
    parcours: ['Perplexity', 'Zimmermann non cite', 'Concurrents recommandes', 'Zimmermann absent'],
    decision: 'quitte',
    scores: { exp: 0, conf: 0, clarte: 0 },
    premierImpression: 'Perplexity ne cite pas Zimmermann — sans site indexe, ils n\'existent pas pour les IA. Elle contacte les artisans recommandes.',
    questionCle: 'Avez-vous un portfolio en ligne de vos charpentes et realisations atypiques ?',
    reponse: 'Non',
    commentReponse: 'Invisible pour tous les assistants IA en 2026',
    impactTechnique: 'En 2026, ~30% des recherches locales passent par un assistant IA — toutes perdues',
    pointsPositifs: ['Marche "artisans references" croissant via IA'],
    frictions: ['Invisible ChatGPT, Perplexity, Claude, Gemini', 'Aucun portfolio en ligne', 'Zero presence pour le marche "jeunes architectes/maitres d\'oeuvre"', 'Concurrent avec blog et llms.txt cite a la place'],
  },
];

// ─── STATS ───
const avgExp = (personas.reduce((s, p) => s + p.scores.exp, 0) / personas.length).toFixed(1);
const avgConf = (personas.reduce((s, p) => s + p.scores.conf, 0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.scores.clarte, 0) / personas.length).toFixed(1);
const convertis = personas.filter(p => p.decision === 'convertit').length;
const hesitants = personas.filter(p => p.decision === 'hesite').length;
const quitte = personas.filter(p => p.decision === 'quitte').length;
const tauxConv = Math.round((convertis / personas.length) * 100);

// ─── CANAL STATS ───
const canalStats = [
  { canal: 'Google Search', total: 3, conv: 0, hesitant: 0, quitte: 3, taux: 0 },
  { canal: 'Google Maps / GBP', total: 2, conv: 0, hesitant: 1, quitte: 1, taux: 0 },
  { canal: 'IA (ChatGPT / Perplexity)', total: 2, conv: 0, hesitant: 0, quitte: 2, taux: 0 },
  { canal: 'Bouche-a-oreille', total: 2, conv: 0, hesitant: 2, quitte: 0, taux: 0 },
  { canal: 'Reseaux sociaux', total: 1, conv: 0, hesitant: 1, quitte: 0, taux: 0 },
];

// ─── CONSTAT ───
const constat = "L'Entreprise Zimmermann maitrise son metier mais est invisible en ligne : son site est mort depuis 2022, ses concurrents captent ses clients Google, et les assistants IA ne peuvent pas la citer.";

// ─── TOP FRICTIONS ───
const topFrictions = [
  { titre: 'Site web mort (erreur 404)', count: 10, detail: 'Tous les visiteurs arrivent sur une page d\'erreur. L\'URL communiquee ne fonctionne plus depuis mars 2022.' },
  { titre: 'Invisibilite totale sur Google Search', count: 7, detail: '~2 000 recherches/mois sur "couvreur metz", "toiture metz 57" — Zimmermann n\'apparait pas.' },
  { titre: 'Absent des assistants IA', count: 4, detail: 'ChatGPT, Perplexity, Claude ne peuvent citer que les artisans ayant un site structure. Zimmermann est ignoré.' },
  { titre: 'Aucune galerie de realisations', count: 8, detail: 'Les visiteurs veulent voir des photos avant/apres. Rien n\'est accessible en dehors de la fiche GBP.' },
  { titre: 'Pas de formulaire devis en ligne', count: 7, detail: 'Les demandes hors horaires (tempetes, week-end) sont perdues. Un formulaire capture 24h/24.' },
];

// ─── TECHNIQUE ───
const pagespeed = {
  mobile: { performance: 0, accessibility: 0, bestPractices: 0, seo: 0 },
  desktop: { performance: 0, accessibility: 0, bestPractices: 0, seo: 0 },
};
const observatory = { grade: 'F', score: 0, testsPassed: 0, testsTotal: 11 };
const techChecks = [
  { label: 'Site web accessible (HTTP 200)', present: false, critical: true },
  { label: 'Meta title optimise', present: false, critical: true },
  { label: 'Meta description', present: false, critical: false },
  { label: 'Un seul H1 par page', present: false, critical: false },
  { label: 'Schema.org LocalBusiness / RoofingContractor', present: false, critical: true },
  { label: 'Open Graph (partage reseaux sociaux)', present: false, critical: false },
  { label: 'robots.txt accessible', present: false, critical: false },
  { label: 'sitemap.xml', present: false, critical: false },
  { label: 'HTTPS fonctionnel', present: false, critical: true },
  { label: 'Images avec alt text', present: false, critical: false },
];

// ─── AMELIORATIONS ───
const ameliorationsCritiques = [
  {
    titre: 'Creer un site web professionnel',
    detail: 'L\'absence totale de site web est le probleme numero un. Chaque jour sans site = chaque jour ou des clients choisissent un concurrent.',
    action: 'Site Astro avec page Accueil, Services, Realisations (galerie photos), Devis, Contact — livre en 7 jours.',
  },
  {
    titre: 'Mettre a jour la fiche GBP avec la nouvelle URL',
    detail: 'La fiche Google Maps pointe vers un site mort. Cela nuit a la credibilite et penalise le classement local.',
    action: 'Mettre a jour l\'URL dans Google Business Profile des la mise en ligne du nouveau site.',
  },
  {
    titre: 'Integrer Schema.org RoofingContractor',
    detail: 'Les assistants IA (ChatGPT, Perplexity) privilegient les sites avec donnees structurees pour leurs recommandations d\'artisans locaux.',
    action: 'JSON-LD avec type RoofingContractor, areaServed Metz + agglomeration, telephone, horaires.',
  },
];
const ameliorationsUtiles = [
  {
    titre: 'Galerie "avant / apres" des chantiers',
    detail: 'Les proprietaires veulent voir des realisations locales avant de contacter. 8 personas sur 10 le demandent.',
  },
  {
    titre: 'Page Urgences toiture 24h/24',
    detail: 'Les appels d\'urgence (tempetes, fuites) representent un chiffre d\'affaires immediat. Une page dediee convertit mieux.',
  },
  {
    titre: 'Certification RGE visible sur le site',
    detail: 'La mention RGE (si applicable) debloque les aides MaPrimeRenov et double la confiance des proprietaires.',
  },
];

function getScoreColor(score: number): string {
  if (score >= 90) return '#22c55e';
  if (score >= 50) return '#f59e0b';
  return '#ef4444';
}
function getDecisionStyle(decision: string): string {
  if (decision === 'convertit') return 'border-green-200 bg-green-50/40';
  if (decision === 'hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}
function getDecisionLabel(decision: string): string {
  if (decision === 'convertit') return 'Convertit';
  if (decision === 'hesite') return 'Hesite';
  return 'Quitte';
}
function getDecisionBadge(decision: string): string {
  if (decision === 'convertit') return 'bg-green-100 text-green-700';
  if (decision === 'hesite') return 'bg-amber-100 text-amber-700';
  return 'bg-neutral-100 text-neutral-500';
}
---

<BaseLayout {title} {description} noindex={true} lang="fr" frPath="/audit/zimmermann">
  <!-- ── HERO ── -->
  <section class="bg-neutral-900 text-white py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-4">Rapport personnalise</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2">{prospect.name} — ce que vos visiteurs pensent vraiment</h1>
      <p class="text-neutral-400 mb-2">{prospect.activity} — <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener">{prospect.url}</a></p>
      <p class="text-neutral-500 text-sm mb-8">{prospect.location} · Audit du {prospect.date}</p>

      <div class="grid grid-cols-3 gap-4 max-w-md">
        <div class="text-center bg-neutral-800 rounded-xl p-4">
          <span class="block text-3xl font-black text-red-400">{tauxConv}%</span>
          <span class="text-xs text-neutral-400 mt-1 block">convertissent</span>
        </div>
        <div class="text-center bg-neutral-800 rounded-xl p-4">
          <span class="block text-3xl font-black text-amber-400">{avgExp}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">experience</span>
        </div>
        <div class="text-center bg-neutral-800 rounded-xl p-4">
          <span class="block text-3xl font-black text-amber-400">{avgConf}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">confiance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CONSTAT ── -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-amber-900 font-medium text-base leading-relaxed">{constat}</p>
      </div>

      <!-- Resume visites -->
      <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-5 mb-8">
        <p class="text-neutral-700 text-sm font-medium mb-3">Sur 10 visiteurs simules :</p>
        <div class="flex flex-wrap gap-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
            <span class="text-sm text-neutral-700"><strong>{convertis}</strong> contactent</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>
            <span class="text-sm text-neutral-700"><strong>{hesitants}</strong> hesitent</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-neutral-400 inline-block"></span>
            <span class="text-sm text-neutral-700"><strong>{quitte}</strong> repartent</span>
          </div>
        </div>
      </div>

      <!-- Conversion par canal -->
      <h3 class="font-semibold text-neutral-800 mb-4 text-sm uppercase tracking-wide">Conversion par canal d'arrivee</h3>
      <div class="space-y-3 mb-8">
        {canalStats.map(item => (
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-sm text-neutral-700">{item.canal}</span>
              <span class="text-sm font-bold text-red-500">{item.taux}%</span>
            </div>
            <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
              <div class="h-full rounded-full bg-red-300" style={`width: ${Math.max(item.taux, 2)}%`}></div>
            </div>
            <p class="text-xs text-neutral-400 mt-0.5">{item.total} visiteur(s) · {item.conv} converti · {item.hesitant} hesite · {item.quitte} quitte</p>
          </div>
        ))}
      </div>

      <!-- Top frictions -->
      <h3 class="font-semibold text-neutral-800 mb-4 text-sm uppercase tracking-wide">Top 5 frictions identifiees</h3>
      <ol class="space-y-3">
        {topFrictions.map((f, i) => (
          <li class="flex gap-3 p-4 bg-neutral-50 border border-neutral-100 rounded-xl">
            <span class="shrink-0 w-6 h-6 rounded-full bg-red-100 text-red-600 text-xs font-bold flex items-center justify-center">{i + 1}</span>
            <div>
              <p class="font-semibold text-neutral-900 text-sm">{f.titre} <span class="text-xs text-neutral-400 font-normal ml-1">({f.count}/10 personas)</span></p>
              <p class="text-xs text-neutral-500 mt-0.5">{f.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── AUDIT TECHNIQUE ── -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">L'audit technique</h2>
      <p class="text-neutral-500 text-sm mb-8">Le site communique (business.site) retourne une erreur 404 — il a ete arrete par Google en mars 2022. Tous les scores sont a zero.</p>

      <!-- PageSpeed scores -->
      <div class="bg-white border border-neutral-200 rounded-xl p-6 mb-6">
        <h3 class="font-semibold text-neutral-800 mb-4">PageSpeed Insights — Mobile</h3>
        <div class="grid grid-cols-4 gap-4">
          {[
            { label: 'Performance', score: pagespeed.mobile.performance },
            { label: 'Accessibilite', score: pagespeed.mobile.accessibility },
            { label: 'Bonnes pratiques', score: pagespeed.mobile.bestPractices },
            { label: 'SEO', score: pagespeed.mobile.seo },
          ].map(item => (
            <div class="text-center">
              <div class="relative w-16 h-16 mx-auto mb-2">
                <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                    fill="none" stroke="#e5e7eb" stroke-width="3" />
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                    fill="none" stroke={getScoreColor(item.score)} stroke-width="3"
                    stroke-dasharray={`${item.score}, 100`} stroke-linecap="round" />
                </svg>
                <span class="absolute inset-0 flex items-center justify-center text-sm font-bold text-neutral-700">N/A</span>
              </div>
              <p class="text-xs text-neutral-600">{item.label}</p>
            </div>
          ))}
        </div>
        <p class="text-xs text-neutral-400 mt-4 text-center">Site inaccessible — aucune mesure possible. Un site Astro/Cloudflare Pages obtient typiquement 95+ en performance.</p>
      </div>

      <!-- Observatory -->
      <div class="bg-white border border-neutral-200 rounded-xl p-6 mb-6">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="font-semibold text-neutral-800">Mozilla Observatory — Securite</h3>
            <p class="text-xs text-neutral-500 mt-1">Headers de securite, HTTPS, configuration serveur</p>
          </div>
          <div class="text-center">
            <span class="inline-block w-12 h-12 rounded-full bg-red-100 text-red-600 font-black text-xl flex items-center justify-center">{observatory.grade}</span>
            <p class="text-xs text-neutral-400 mt-1">{observatory.score}/100</p>
          </div>
        </div>
        <p class="text-xs text-red-500 mt-3">Scan echoue : "Site did respond with an unexpected HTTP status code 404." — score F par defaut.</p>
      </div>

      <!-- Checklist SEO/Schema/OG -->
      <div class="bg-white border border-neutral-200 rounded-xl p-6">
        <h3 class="font-semibold text-neutral-800 mb-4">Checklist SEO / Schema.org / Open Graph</h3>
        <div class="grid gap-2">
          {techChecks.map(item => (
            <div class="flex items-center gap-3 py-1.5 border-b border-neutral-50 last:border-0">
              <span class={`shrink-0 w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold ${item.present ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-500'}`}>
                {item.present ? '✓' : '✗'}
              </span>
              <span class={`text-sm flex-1 ${item.present ? 'text-neutral-700' : 'text-neutral-500'}`}>{item.label}</span>
              {item.critical && !item.present && (
                <span class="text-[10px] font-semibold text-red-500 bg-red-50 px-1.5 py-0.5 rounded">CRITIQUE</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── PERSONAS ── -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
      <p class="text-neutral-500 text-sm mb-8">
        Sur 10 visiteurs simules, <strong class="text-green-600">{convertis} contactent</strong>, <strong class="text-amber-600">{hesitants} hesitent</strong>, <strong class="text-neutral-500">{quitte} repartent</strong>.
      </p>

      <!-- Groupes -->
      {(['convertit', 'hesite', 'quitte'] as const).map(decision => {
        const group = personas.filter(p => p.decision === decision);
        if (group.length === 0) return null;
        return (
          <div class="mb-6">
            <h3 class={`text-xs font-semibold uppercase tracking-wider mb-3 ${decision === 'convertit' ? 'text-green-600' : decision === 'hesite' ? 'text-amber-600' : 'text-neutral-400'}`}>
              {getDecisionLabel(decision)} — {group.length} persona(s)
            </h3>
            <div class="space-y-2">
              {group.map(p => (
                <details class={`group border rounded-xl overflow-hidden ${getDecisionStyle(decision)}`}>
                  <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                        <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                        <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                        <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                        <span class={`text-[11px] px-1.5 py-0.5 rounded font-medium ${getDecisionBadge(decision)}`}>{getDecisionLabel(decision)}</span>
                      </div>
                      <p class="text-xs text-neutral-500">{p.situation}</p>
                    </div>
                    <svg class="w-5 h-5 text-neutral-400 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                  </summary>
                  <div class="px-4 pb-4 pt-0 border-t border-neutral-100 bg-white/60">
                    <div class="grid gap-3 text-xs mt-3">
                      <div>
                        <p class="font-semibold text-neutral-700 mb-1">Premiere impression</p>
                        <p class="text-neutral-600">{p.premierImpression}</p>
                      </div>
                      <div>
                        <p class="font-semibold text-neutral-700 mb-1">Parcours</p>
                        <p class="text-neutral-500">{p.parcours.join(' → ')}</p>
                      </div>
                      <div>
                        <p class="font-semibold text-neutral-700 mb-1">Question cle</p>
                        <p class="text-neutral-600 italic">"{p.questionCle}"</p>
                        <p class="text-neutral-600 mt-1">Reponse du site : <strong>{p.reponse}</strong> — {p.commentReponse}</p>
                      </div>
                      <div>
                        <p class="font-semibold text-neutral-700 mb-1">Impact technique</p>
                        <p class="text-neutral-500">{p.impactTechnique}</p>
                      </div>
                      <div class="flex gap-4">
                        <div class="flex-1">
                          <p class="font-semibold text-green-700 mb-1">Points positifs</p>
                          <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                            {p.pointsPositifs.map(pp => <li>{pp}</li>)}
                          </ul>
                        </div>
                        <div class="flex-1">
                          <p class="font-semibold text-amber-700 mb-1">Frictions</p>
                          <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                            {p.frictions.map(fr => <li>{fr}</li>)}
                          </ul>
                        </div>
                      </div>
                      <div class="flex gap-4 pt-1 border-t border-neutral-100">
                        <span class="text-neutral-500">Experience : <strong class="text-neutral-700">{p.scores.exp}/10</strong></span>
                        <span class="text-neutral-500">Confiance : <strong class="text-neutral-700">{p.scores.conf}/10</strong></span>
                        <span class="text-neutral-500">Clarte : <strong class="text-neutral-700">{p.scores.clarte}/10</strong></span>
                      </div>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- ── RECOMMANDATIONS ── -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-8">Nos recommandations</h2>

      <!-- Critiques -->
      <h3 class="text-sm font-semibold uppercase tracking-wider text-red-500 mb-4">Le plus important — a faire maintenant</h3>
      <div class="space-y-4 mb-10">
        {ameliorationsCritiques.map((a, i) => (
          <div class="border-l-4 border-red-400 bg-white rounded-r-xl p-5 shadow-sm">
            <div class="flex items-start gap-3">
              <span class="shrink-0 w-6 h-6 rounded-full bg-red-100 text-red-600 text-xs font-bold flex items-center justify-center mt-0.5">{i + 1}</span>
              <div>
                <h4 class="font-semibold text-neutral-900 mb-1">{a.titre}</h4>
                <p class="text-sm text-neutral-600 mb-2">{a.detail}</p>
                <p class="text-xs text-neutral-500 bg-neutral-50 rounded-lg px-3 py-2"><strong>Action :</strong> {a.action}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Utiles -->
      <h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-400 mb-4">Utile aussi</h3>
      <div class="grid md:grid-cols-3 gap-4">
        {ameliorationsUtiles.map(a => (
          <div class="bg-white border border-neutral-200 rounded-xl p-5">
            <h4 class="font-semibold text-neutral-900 text-sm mb-2">{a.titre}</h4>
            <p class="text-xs text-neutral-500">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA FINAL ── -->
  <section class="bg-neutral-900 text-white py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4">
        {tauxConv}% de vos visiteurs vous contactent actuellement.<br/>
        <span class="text-amber-400">Avec un site professionnel, on peut viser 40%.</span>
      </h2>
      <p class="text-neutral-300 mb-4 max-w-xl mx-auto">
        Votre expertise de couvreur/zingueur/charpentier merite d'etre visible. Des proprietaires messins cherchent exactement votre profil chaque jour — et trouvent vos concurrents.
      </p>
      <p class="text-neutral-400 text-sm mb-8 max-w-lg mx-auto">
        Site professionnel a partir de 990€, livre en 7 jours. Astro + Cloudflare Pages : 95+ en performance, schema.org RoofingContractor, formulaire devis 24h/24.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/commander" class="inline-flex items-center gap-2 px-8 py-3.5 bg-[var(--color-accent)] text-white font-semibold rounded-xl hover:opacity-90 transition-all shadow-md">
          Je veux un site qui convertit
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-3.5 border border-neutral-600 text-neutral-300 font-semibold rounded-xl hover:border-amber-400 hover:text-amber-400 transition-all">
          En discuter d'abord
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
