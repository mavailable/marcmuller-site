  { titre: 'Email hotmail.com — signal amateurisme', count: 6, detail: 'Un email personnel pour un professionnel du batiment cree un doute sur le serieux et la perennite' },
  { titre: 'Aucune certification / assurance visible', count: 5, detail: 'Pas de RGE, pas de mention assurance decennale — pourtant critere decisif pour les proprietaires' },
