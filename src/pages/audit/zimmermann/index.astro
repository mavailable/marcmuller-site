  { canal: 'Bouche-a-oreille', taux: 60, color: 'text-green-600', bg: 'bg-green-500' },
  { canal: 'Google Maps / GBP', taux: 33, color: 'text-amber-600', bg: 'bg-amber-500' },
  { canal: 'Google Search', taux: 10, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'Reseaux sociaux', taux: 10, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'IA (ChatGPT / Perplexity)', taux: 0, color: 'text-red-700', bg: 'bg-red-700' },
  { canal: 'Autre (direct)', taux: 50, color: 'text-green-600', bg: 'bg-green-500' },
];

// ─── TOP FRICTIONS ───
