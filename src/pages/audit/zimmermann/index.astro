// ─── PAGESPEED ───
const pagespeed = {
  mobile: { performance: 35, accessibility: 72, bestPractices: 78, seo: 82 },
  desktop: { performance: 65, accessibility: 72, bestPractices: 78, seo: 82 },
};
const coreWebVitals = [
