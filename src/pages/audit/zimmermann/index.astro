// ─── OBSERVATORY ───
const observatory = { grade: 'C-', score: 45, testsPassed: 6, testsTotal: 10 };

// ─── CHECKLIST TECHNIQUE ───
const techChecks = [
  { label: 'HTTPS + redirection HTTP', present: true, critical: false },
  { label: 'HSTS (securite transport)', present: true, critical: false },
  { label: 'X-Content-Type-Options', present: true, critical: false },
  { label: 'Content-Security-Policy', present: false, critical: true },
  { label: 'X-Frame-Options', present: false, critical: false },
