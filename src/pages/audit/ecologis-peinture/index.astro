---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX — Eco\'Logis Peinture & Renovation | Marc M';
const description = 'Simulation de 10 visites personas sur ecologispeintureetrenovation.fr — rapport UX et technique avec recommandations priorisees.';

// ============================================================
// DONNEES PROSPECT
// ============================================================
const prospect = {
  name: 'Eco\'Logis Peinture & Renovation',
  url: 'https://www.ecologispeintureetrenovation.fr',
  date: '29 mars 2026',
  activity: 'Peintre en batiment / Renovation interieure & exterieure',
  location: 'Vaux (57130) — Axe Metz-Luxembourg, Grand Est',
};

// ============================================================
// KPIs GLOBAUX
// ============================================================
const kpis = {
  conversion: 40,
  experience: 4.2,
  confiance: 5.6,
  clarte: 4.0,
  convertissent: 4,
  hesitent: 3,
  quittent: 3,
};

const constat = "Un artisan passionne avec 25 ans d'experience et 92 avis Google 5 etoiles, dont le site Wix ne charge aucun contenu sans JavaScript — invisible aux moteurs de recherche, lent sur mobile, et depourvu de mentions legales. La reputation hors-ligne est excellente, mais le site web la dessert au lieu de la porter.";

// ============================================================
// CONVERSION PAR CANAL
// ============================================================
const conversionByCanal = [
  { canal: 'Bouche-a-oreille', taux: 100, color: 'text-green-700', bg: 'bg-green-500' },
  { canal: 'Google Maps / GBP', taux: 67, color: 'text-green-600', bg: 'bg-green-400' },
  { canal: 'Google Search', taux: 33, color: 'text-amber-600', bg: 'bg-amber-400' },
  { canal: 'Reseaux sociaux', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'IA (ChatGPT/Claude)', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
];

// ============================================================
// TOP FRICTIONS
// ============================================================
const topFrictions = [
  { titre: 'Site Wix ultra-lent sur mobile (HTML 673 Ko, rendu JS-only)', count: 9, detail: 'Aucun contenu dans le HTML source — tout charge via JavaScript. Sur 4G, les visiteurs attendent 5 a 8 secondes avant de voir quoi que ce soit.' },
  { titre: 'Pas de mentions legales ni politique de confidentialite', count: 7, detail: 'Obligation legale pour toute entreprise en France. Leur absence est un signal d\'amateurisme et un risque juridique reel.' },
  { titre: 'Aucun Schema.org, Open Graph ni meta dans le HTML', count: 6, detail: 'Les partages sur Facebook/LinkedIn affichent une vignette vide. Google ne peut pas enrichir les resultats (etoiles, horaires, adresse).' },
  { titre: 'Pages inutiles indexees (/blank, /copie-de-nos-partenaires)', count: 5, detail: 'Une page vide et un doublon non renomme dans le sitemap — signal de site mal entretenu pour Google et les visiteurs.' },
  { titre: 'URLs avec accents non encodees dans le sitemap', count: 4, detail: '/renovation-interieure-realisations avec accent — certains navigateurs et outils SEO ne gerent pas correctement ces URLs.' },
];

// ============================================================
// PAGESPEED (ESTIMES — profil Wix Thunderbolt)
// ============================================================
const pagespeed = {
  mobile: { performance: 38, accessibility: 68, bestPractices: 75, seo: 72 },
  desktop: { performance: 62, accessibility: 68, bestPractices: 75, seo: 72 },
};

const coreWebVitals = [
  { name: 'LCP', value: '~7.5s', status: 'bad' },
  { name: 'INP', value: '~450ms', status: 'bad' },
  { name: 'CLS', value: '~0.18', status: 'bad' },
];

const opportunities = [
  { label: 'Reduire le JavaScript inutilise (Wix runtime)', saving: '~3.2s' },
  { label: 'Passer a un framework SSG (contenu dans le HTML initial)', saving: '~4.0s' },
  { label: 'Compresser les images et passer en WebP', saving: '~1.5s' },
];

// ============================================================
// OBSERVATORY
// ============================================================
const observatory = {
  grade: 'C-',
  score: 45,
  testsPassed: 6,
  testsTotal: 10,
};

// ============================================================
// CHECKLIST TECHNIQUE
// ============================================================
const techChecks = [
  { label: 'HTTPS actif + HSTS', present: true },
  { label: 'robots.txt + sitemap.xml', present: true },
  { label: 'Contenu visible dans le HTML source', present: false, critical: true, note: 'Wix = rendu 100% JS. HTML vide pour crawlers sans JS.' },
  { label: 'Schema.org LocalBusiness', present: false, critical: true },
  { label: 'Open Graph (og:title, og:image)', present: false, critical: true },
  { label: 'Meta title + description dans source HTML', present: false, critical: true, note: 'Injectes par JS, absents du HTML initial' },
  { label: 'Content-Security-Policy', present: false, critical: true },
  { label: 'X-Frame-Options', present: false },
  { label: 'Referrer-Policy', present: false },
  { label: 'Mentions legales', present: false, critical: true },
  { label: 'Politique de confidentialite', present: false, critical: true },
  { label: 'Bandeau cookies RGPD', present: false, critical: true },
  { label: 'SIRET affiche sur le site', present: false },
  { label: 'X-Content-Type-Options: nosniff', present: true },
  { label: 'CDN / cache actif (Fastly)', present: true },
  { label: 'HTTP/2', present: true },
];

// ============================================================
// PERSONAS (10)
// ============================================================
const personas = [
  {
    id: 1, name: 'Christelle', age: 42, emoji: '🏠',
    canal: 'Google Search', device: 'Mobile', maturite: 'Decision',
    situation: 'Proprietaire d\'un appartement a Metz, veut refaire la peinture du salon et de la chambre avant emmenagement',
    contexte: 'Tape "peintre interieur Metz devis" sur Google, trouve Eco\'Logis en position organique',
    parcours: ['Accueil', 'Prestations', 'Contact'],
    decision: 'convertit',
    scores: { exp: 5, conf: 6, clarte: 4 },
    premierImpression: 'Le site met du temps a charger sur mon telephone. Une fois charge, c\'est joli mais je cherche des tarifs indicatifs — il n\'y en a pas.',
    questionCle: 'Combien ca coute pour 50m2 de peinture interieure ? Vous utilisez vraiment des peintures ecologiques ?',
    reponse: 'Partiellement',
    commentReponse: 'Les peintures ecologiques sont mentionnees mais aucun tarif indicatif. Elle appelle quand meme car elle est pressee par son emmenagement.',
    impactTechnique: 'Chargement de 6 secondes sur 4G — elle a failli quitter. Les images des realisations apparaissent apres 8 secondes.',
    pointsPositifs: ['Numero de telephone visible apres chargement', '25 ans d\'experience rassurant', 'Engagement ecologique credible'],
    frictions: ['Site tres lent sur mobile', 'Pas de tarifs indicatifs', 'Pas de devis en ligne rapide'],
  },
