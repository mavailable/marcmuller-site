// ============================================================
// HELPERS
// ============================================================
function scoreColor(score: number) {
  if (score >= 90) return '#22c55e';
  if (score >= 50) return '#f59e0b';
  return '#ef4444';
}

function scoreTextClass(score: number) {
  if (score >= 90) return 'text-green-600';
  if (score >= 50) return 'text-amber-500';
  return 'text-red-500';
}

function decisionColor(decision: string) {
  if (decision === 'convertit') return 'border-green-200 bg-green-50/40';
  if (decision === 'hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}

function decisionBadge(decision: string) {
  if (decision === 'convertit') return 'bg-green-100 text-green-700';
  if (decision === 'hesite') return 'bg-amber-100 text-amber-700';
  return 'bg-neutral-100 text-neutral-600';
}

function decisionLabel(decision: string) {
  if (decision === 'convertit') return 'Contacte';
  if (decision === 'hesite') return 'Hesite';
  return 'Repart';
}

function maturiteColor(m: string) {
  if (m === 'Decision') return 'text-purple-600 bg-purple-50';
  if (m === 'Comparaison') return 'text-blue-600 bg-blue-50';
  return 'text-neutral-500 bg-neutral-100';
}
---

<BaseLayout title={title} description={description} noindex={true} lang="fr" frPath="/audit/ecologis-peinture">

  <!-- ========================================================
       HERO + KPIs
  ======================================================== -->
  <section class="bg-neutral-900 text-white py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-4">Rapport personnalise</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2 leading-tight">
        {prospect.name}<br/>
        <span class="text-neutral-300 font-normal text-2xl">ce que vos visiteurs pensent vraiment</span>
      </h1>
      <p class="text-neutral-400 mb-2">{prospect.activity} &mdash; {prospect.location}</p>
      <p class="text-neutral-500 text-sm mb-8">
        <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener noreferrer">{prospect.url}</a>
        &mdash; Rapport du {prospect.date}
      </p>

      <!-- KPI Cards -->
      <div class="grid grid-cols-3 gap-4 max-w-lg">
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.conversion}%</span>
          <span class="text-xs text-neutral-400 mt-1 block">convertissent</span>
        </div>
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.experience}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">experience</span>
        </div>
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.confiance}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">confiance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       LE CONSTAT
  ======================================================== -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>

      <!-- Constat principal -->
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-amber-900 font-medium text-base leading-relaxed">{constat}</p>
      </div>

      <!-- Resume visiteurs -->
      <div class="flex flex-wrap gap-3 mb-8">
        <div class="flex items-center gap-2 bg-green-50 border border-green-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
          <span class="text-sm font-semibold text-green-800">{kpis.convertissent} contactent</span>
        </div>
        <div class="flex items-center gap-2 bg-amber-50 border border-amber-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
          <span class="text-sm font-semibold text-amber-800">{kpis.hesitent} hesitent</span>
        </div>
        <div class="flex items-center gap-2 bg-neutral-100 border border-neutral-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-neutral-400 shrink-0"></span>
          <span class="text-sm font-semibold text-neutral-700">{kpis.quittent} repartent</span>
        </div>
      </div>

      <!-- Conversion par canal -->
      <div class="mb-10">
        <h3 class="font-semibold text-neutral-800 mb-4 text-sm uppercase tracking-wide">Taux de contact par canal d'arrivee</h3>
        <div class="space-y-3">
          {conversionByCanal.map(item => (
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-neutral-700">{item.canal}</span>
                <span class={`text-sm font-bold ${item.color}`}>{item.taux}%</span>
              </div>
              <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
                <div class={`h-full rounded-full ${item.bg}`} style={`width: ${item.taux}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Top frictions -->
      <h3 class="font-semibold text-neutral-800 mb-4 text-sm uppercase tracking-wide">Top 5 frictions identifiees</h3>
      <ol class="space-y-3">
        {topFrictions.map((f, i) => (
          <li class="flex gap-4 p-4 bg-neutral-50 border border-neutral-200 rounded-xl">
            <span class="shrink-0 w-7 h-7 rounded-full bg-red-100 text-red-700 flex items-center justify-center text-sm font-bold">{i + 1}</span>
            <div>
              <p class="font-semibold text-neutral-900 text-sm">{f.titre} <span class="ml-2 text-xs text-neutral-500 font-normal">{f.count}/10 personas</span></p>
              <p class="text-neutral-600 text-xs mt-0.5">{f.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========================================================
       AUDIT TECHNIQUE
  ======================================================== -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">L'audit technique</h2>

      <!-- PageSpeed mobile -->
      <div class="bg-white border border-neutral-200 rounded-xl p-6 mb-6">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
          <h3 class="font-semibold text-neutral-800">PageSpeed — Mobile</h3>
          <span class="text-xs text-neutral-400 bg-neutral-100 px-2 py-1 rounded">scores estimes — profil Wix Thunderbolt</span>
        </div>
        <div class="grid grid-cols-4 gap-4">
          {[
            { label: 'Performance', score: pagespeed.mobile.performance },
            { label: 'Accessibilite', score: pagespeed.mobile.accessibility },
            { label: 'Bonnes pratiques', score: pagespeed.mobile.bestPractices },
            { label: 'SEO', score: pagespeed.mobile.seo },
          ].map(item => (
            <div class="text-center">
              <div class="relative w-14 h-14 mx-auto mb-2">
                <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                    fill="none" stroke="#e5e7eb" stroke-width="3.5" />
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                    fill="none" stroke={scoreColor(item.score)} stroke-width="3.5"
                    stroke-dasharray={`${item.score}, 100`} stroke-linecap="round" />
                </svg>
                <span class={`absolute inset-0 flex items-center justify-center text-base font-bold ${scoreTextClass(item.score)}`}>{item.score}</span>
              </div>
              <p class="text-xs text-neutral-600">{item.label}</p>
            </div>
          ))}
        </div>

        <!-- Core Web Vitals -->
        <div class="mt-4 pt-4 border-t border-neutral-100">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide mb-2">Core Web Vitals (mobile estimes)</p>
          <div class="flex flex-wrap gap-3">
            {coreWebVitals.map(cwv => (
              <div class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium ${cwv.status === 'good' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'}`}>
                <span class={`w-1.5 h-1.5 rounded-full ${cwv.status === 'good' ? 'bg-green-500' : 'bg-red-500'}`}></span>
                {cwv.name} : {cwv.value}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- PageSpeed Desktop + Observatory -->
      <div class="grid md:grid-cols-2 gap-6 mb-6">
        <!-- Desktop -->
        <div class="bg-white border border-neutral-200 rounded-xl p-5">
          <h3 class="font-semibold text-neutral-800 mb-4">PageSpeed — Desktop</h3>
          <div class="grid grid-cols-4 gap-2">
            {[
              { label: 'Perf.', score: pagespeed.desktop.performance },
              { label: 'A11y', score: pagespeed.desktop.accessibility },
              { label: 'BP', score: pagespeed.desktop.bestPractices },
              { label: 'SEO', score: pagespeed.desktop.seo },
            ].map(item => (
              <div class="text-center">
                <div class="relative w-12 h-12 mx-auto mb-1">
                  <svg class="w-12 h-12 -rotate-90" viewBox="0 0 36 36">
                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                      fill="none" stroke="#e5e7eb" stroke-width="3.5" />
                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                      fill="none" stroke={scoreColor(item.score)} stroke-width="3.5"
                      stroke-dasharray={`${item.score}, 100`} stroke-linecap="round" />
                  </svg>
                  <span class={`absolute inset-0 flex items-center justify-center text-sm font-bold ${scoreTextClass(item.score)}`}>{item.score}</span>
                </div>
                <p class="text-[11px] text-neutral-500">{item.label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Observatory -->
        <div class="bg-white border border-neutral-200 rounded-xl p-5">
          <h3 class="font-semibold text-neutral-800 mb-3">Securite — Mozilla Observatory</h3>
          <div class="flex items-center gap-4 mb-3">
            <div class="text-4xl font-black text-red-500">
              {observatory.grade}
            </div>
            <div>
              <p class="text-sm font-semibold text-neutral-800">Score {observatory.score}/100</p>
              <p class="text-xs text-neutral-500">{observatory.testsPassed}/{observatory.testsTotal} tests passes</p>
            </div>
          </div>
          <p class="text-xs text-neutral-600">Grade C- mediocre — 4 tests echoues : Content-Security-Policy, X-Frame-Options, Referrer-Policy et Permissions-Policy absents. Risques XSS et clickjacking.</p>
        </div>
      </div>

      <!-- Checklist SEO/Schema/OG -->
      <div class="bg-white border border-neutral-200 rounded-xl p-5 mb-6">
        <h3 class="font-semibold text-neutral-800 mb-4">Checklist technique, SEO & legal</h3>
        <div class="grid sm:grid-cols-2 gap-2">
          {techChecks.map(check => (
            <div class={`flex items-start gap-2.5 p-2.5 rounded-lg ${check.present ? 'bg-green-50' : check.critical ? 'bg-red-50' : 'bg-neutral-50'}`}>
              <span class={`shrink-0 mt-0.5 text-sm ${check.present ? 'text-green-600' : check.critical ? 'text-red-500' : 'text-neutral-400'}`}>
                {check.present ? '\u2713' : '\u2717'}
              </span>
              <div>
                <span class={`text-xs font-medium ${check.present ? 'text-green-800' : check.critical ? 'text-red-700' : 'text-neutral-600'}`}>{check.label}</span>
                {check.note && <p class="text-[11px] text-neutral-500 mt-0.5">{check.note}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Top opportunites -->
      <div class="bg-white border border-neutral-200 rounded-xl p-5">
        <h3 class="font-semibold text-neutral-800 mb-3">Top 3 opportunites de performance</h3>
        <div class="space-y-2">
          {opportunities.map((opp, i) => (
            <div class="flex items-center gap-3 p-3 bg-amber-50 border border-amber-100 rounded-lg">
              <span class="shrink-0 text-amber-600 font-bold text-sm">{i + 1}</span>
              <div class="flex-1">
                <span class="text-sm text-neutral-800">{opp.label}</span>
              </div>
              <span class="shrink-0 text-xs font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded">{opp.saving}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       VOS VISITEURS — 10 PERSONAS
  ======================================================== -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
      <p class="text-neutral-500 mb-6 text-sm">
        Sur <strong class="text-neutral-800">10 visiteurs simules</strong>,
        <strong class="text-green-700">{kpis.convertissent} contactent</strong>,
        <strong class="text-amber-600">{kpis.hesitent} hesitent</strong>,
        <strong class="text-neutral-600">{kpis.quittent} repartent</strong>.
        Cliquez sur un visiteur pour voir son parcours complet.
      </p>

      <!-- Legende -->
      <div class="flex flex-wrap gap-2 mb-5 text-xs">
        <span class="flex items-center gap-1.5 bg-green-50 border border-green-200 px-2.5 py-1 rounded-full text-green-700 font-medium">
          <span class="w-2 h-2 rounded-full bg-green-500"></span> Contacte
        </span>
        <span class="flex items-center gap-1.5 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-full text-amber-700 font-medium">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span> Hesite
        </span>
        <span class="flex items-center gap-1.5 bg-neutral-100 border border-neutral-200 px-2.5 py-1 rounded-full text-neutral-600 font-medium">
          <span class="w-2 h-2 rounded-full bg-neutral-400"></span> Repart
        </span>
      </div>

      <div class="space-y-2">
        {personas.map(p => (
          <details class={`group border ${decisionColor(p.decision)} rounded-xl overflow-hidden`}>
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-white/60 transition-colors">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                  <h3 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h3>
                  <span class={`text-[11px] px-1.5 py-0.5 rounded ${decisionBadge(p.decision)}`}>{decisionLabel(p.decision)}</span>
                  <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class={`text-[11px] px-1.5 py-0.5 rounded ${maturiteColor(p.maturite)}`}>{p.maturite}</span>
                </div>
                <p class="text-xs text-neutral-500 truncate">{p.situation}</p>
              </div>
              <div class="shrink-0 flex items-center gap-3 ml-2">
                <div class="hidden sm:flex gap-1.5 text-[11px]">
                  <span class="bg-neutral-100 text-neutral-600 px-1.5 py-0.5 rounded">Exp {p.scores.exp}/10</span>
                  <span class="bg-neutral-100 text-neutral-600 px-1.5 py-0.5 rounded">Conf {p.scores.conf}/10</span>
                </div>
                <svg class="w-5 h-5 text-neutral-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </summary>

            <div class="px-4 pb-4 pt-0 border-t border-current/10 bg-white/60">
              <div class="grid gap-3 text-xs mt-3">

                <!-- Parcours -->
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Parcours</p>
                  <div class="flex flex-wrap gap-1 items-center">
                    {p.parcours.length > 0 ? p.parcours.map((page, i) => (
                      <>
                        <span class="bg-neutral-100 text-neutral-700 px-2 py-0.5 rounded text-[11px]">{page}</span>
                        {i < p.parcours.length - 1 && <span class="text-neutral-400 text-[10px]">&rsaquo;</span>}
                      </>
                    )) : <span class="text-neutral-400 italic">N'a jamais atteint le site</span>}
                  </div>
                </div>

                <!-- Premiere impression -->
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Premiere impression</p>
                  <p class="text-neutral-600 italic">"{p.premierImpression}"</p>
                </div>

                <!-- Question + reponse -->
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Question cle</p>
                  <p class="text-neutral-600 italic mb-1">"{p.questionCle}"</p>
                  <p class="text-neutral-600">
                    Reponse du site : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' || p.reponse === 'Invisible' ? 'text-red-600' : 'text-amber-700'}>{p.reponse}</strong>
                    {' '}&mdash; {p.commentReponse}
                  </p>
                </div>

                <!-- Impact technique -->
                <div class="bg-neutral-50 rounded-lg px-3 py-2">
                  <p class="font-semibold text-neutral-700 mb-0.5">Impact technique</p>
                  <p class="text-neutral-600">{p.impactTechnique}</p>
                </div>

                <!-- Points positifs + frictions -->
                <div class="grid sm:grid-cols-2 gap-3">
                  <div>
                    <p class="font-semibold text-green-700 mb-1">Points positifs</p>
                    <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                      {p.pointsPositifs.length > 0 ? p.pointsPositifs.map(pt => <li>{pt}</li>) : <li class="text-neutral-400 italic">Aucun identifie</li>}
                    </ul>
                  </div>
                  <div>
                    <p class="font-semibold text-amber-700 mb-1">Frictions</p>
                    <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                      {p.frictions.map(f => <li>{f}</li>)}
                    </ul>
                  </div>
                </div>

                <!-- Scores -->
                <div class="flex gap-3 pt-1">
                  <span class="bg-neutral-100 text-neutral-700 px-2.5 py-1 rounded-lg text-[11px] font-medium">Experience {p.scores.exp}/10</span>
                  <span class="bg-neutral-100 text-neutral-700 px-2.5 py-1 rounded-lg text-[11px] font-medium">Confiance {p.scores.conf}/10</span>
                  <span class="bg-neutral-100 text-neutral-700 px-2.5 py-1 rounded-lg text-[11px] font-medium">Clarte {p.scores.clarte}/10</span>
                </div>

              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       RECOMMANDATIONS
  ======================================================== -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Nos recommandations</h2>

      <!-- Critiques -->
      <h3 class="font-semibold text-red-700 text-sm uppercase tracking-wide mb-3">Le plus important — a traiter en priorite</h3>
      <div class="space-y-3 mb-8">
        {ameliorationsCritiques.map((a, i) => (
          <div class="border border-red-200 bg-white rounded-xl p-5">
            <div class="flex gap-3 mb-2">
              <span class="shrink-0 w-6 h-6 rounded-full bg-red-100 text-red-700 flex items-center justify-center text-xs font-bold">{i + 1}</span>
              <h4 class="font-semibold text-neutral-900 text-sm">{a.titre}</h4>
            </div>
            <p class="text-neutral-600 text-sm mb-2 ml-9">{a.detail}</p>
            <div class="ml-9 bg-red-50 border border-red-100 rounded-lg px-3 py-2">
              <p class="text-xs text-red-800"><strong>Action :</strong> {a.action}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Utiles -->
      <h3 class="font-semibold text-neutral-600 text-sm uppercase tracking-wide mb-3">Utile aussi</h3>
      <div class="grid sm:grid-cols-3 gap-3">
        {ameliorationsUtiles.map(a => (
          <div class="bg-white border border-neutral-200 rounded-xl p-4">
            <h4 class="font-semibold text-neutral-800 text-sm mb-2">{a.titre}</h4>
            <p class="text-neutral-500 text-xs">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       CTA FINAL
  ======================================================== -->
  <section class="bg-neutral-900 text-white py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-3">Ce rapport est offert</p>
      <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4 leading-snug">
        {kpis.conversion}% de vos visiteurs vous contactent.<br/>
        <span class="text-amber-400">Vos 92 avis 5 etoiles meritent mieux que Wix.</span>
      </h2>
      <p class="text-neutral-300 mb-3 max-w-xl mx-auto">
        Un artisan avec 25 ans d'experience et une reputation parfaite merite un site aussi rapide que son travail est soigne — avec ses avis, ses realisations et ses certifications ecologiques en vitrine.
      </p>
      <p class="text-neutral-400 text-sm mb-8 max-w-xl mx-auto">
        Je construis des sites qui convertissent vraiment — a partir de 990&euro;, livre en 7 jours, sans abonnement CMS.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/commander/"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-[var(--color-accent)] text-white font-semibold rounded-xl hover:bg-[var(--color-accent-hover)] transition-all shadow-md"
        >
          Je veux un site qui convertit
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 px-8 py-3.5 border border-neutral-600 text-neutral-300 font-semibold rounded-xl hover:border-amber-400 hover:text-amber-400 transition-all"
        >
          En discuter d'abord
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
