                        <div class="text-center"><span class={`block text-lg font-bold ${p.conf >= 5 ? 'text-amber-600' : 'text-red-600'}`}>{p.conf}</span><span class="text-[10px] text-neutral-500">Confiance</span></div>
                        <div class="text-center"><span class={`block text-lg font-bold ${p.clarte >= 5 ? 'text-amber-600' : 'text-red-600'}`}>{p.clarte}</span><span class="text-[10px] text-neutral-500">Clarte</span></div>
                      </div>
                    </div>
                  </div>
                </details>
              );
            })}
