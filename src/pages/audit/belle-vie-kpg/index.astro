    { title: 'Corriger le Schema.org', detail: 'Changer "Article" en "Hotel" ou "LodgingBusiness" et ajouter address, telephone, openingHours, amenityFeature. Indispensable pour les rich snippets Google et les recommandations IA.' },
    { title: 'Creer une page Transferts / Comment venir', detail: 'Ferrys depuis Koh Samui, bateaux depuis Koh Tao, taxis, motos-taxis depuis le port. Karen, Brigitte et Hiroshi ont chacun cherche cette information — en vain.' },
    { title: 'Creer un package Lune de Miel', detail: 'Champagne, petits-dejeuners au lit, decoration florale, massage couple en option. Liam et tous les couples en lune de miel cherchent cette offre. Un concurrent qui la propose l\'emportera.' },
    { title: 'Ajouter du contenu solo-friendly', detail: '"Tous les voyageurs (en solo ou en couple) sont les bienvenus." Un seul temoignage d\'une voyageuse solo suffirait a retenir Mei-Lin et Camille.' },
    { title: 'Detailler le programme retraite Clara Morgane', detail: 'Programme jour par jour, inclus/non-inclus (repas, transferts, materiel), places restantes, FAQ retraite. Nathalie, Valerie et Sophie attendaient ce detail pour s\'engager.' },
  ],
  discussion: [
    { title: 'Booking engine direct avec prix en temps reel', emoji: '🛒', detail: 'Le principal frein de conversion. Book-directonline.com est en place mais peu visible. L\'integrer directement dans chaque page chambre reduirait drastiquement la friction.' },
    { title: 'WhatsApp pour contact urgent', emoji: '💬', detail: 'Priya avait besoin d\'une chambre ce soir. Un bouton WhatsApp en header resoudrait les urgences et convertirait les hesitants qui n\'osent pas envoyer un email.' },
    { title: 'Corriger les liens morts et mettre a jour le copyright', emoji: '🔧', detail: 'Offres speciales Honeymoon, Winter Sun, End of Year : liens vers "#". Copyright 2024 visible en mars 2026. Deux corrections triviales qui ameliorent immediatement la credibilite.' },
    { title: 'Enrichir la page art / Anis Dargaa', emoji: '🎨', detail: 'Bio de l\'artiste, photos dediees des oeuvres, mention "oeuvres originales", possibilite de contact. Aiko et Markus etaient prets a faire un editorial — le contenu n\'etait pas a la hauteur.' },
  ],
};

// ─── HELPERS ───
function scoreColor(score: number) {
  if (score >= 90) return { ring: '#22c55e', text: 'text-green-600', bg: 'bg-green-50' };
  if (score >= 50) return { ring: '#f59e0b', text: 'text-amber-600', bg: 'bg-amber-50' };
  return { ring: '#ef4444', text: 'text-red-600', bg: 'bg-red-50' };
}

function decisionColor(d: string) {
  if (d === 'Convertit') return { border: 'border-green-200', bg: 'bg-green-50/40', badge: 'bg-green-600', text: 'text-green-800', badgeText: 'text-white' };
  if (d === 'Hesite') return { border: 'border-amber-200', bg: 'bg-amber-50/40', badge: 'bg-amber-500', text: 'text-amber-800', badgeText: 'text-white' };
  return { border: 'border-neutral-200', bg: 'bg-neutral-50/40', badge: 'bg-red-500', text: 'text-red-800', badgeText: 'text-white' };
}

function severityColor(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  return 'bg-blue-100 text-blue-800';
}

function cwvStatus(metric: string, value: string) {
  const n = parseFloat(value);
  let good = false, ok = false;
  if (metric === 'lcp') { good = n < 2.5; ok = n < 4.0; }
  else if (metric === 'tbt') { good = n < 200; ok = n < 600; }
  else { good = n < 0.1; ok = n < 0.25; }
  if (good) return { bg: 'bg-green-50', textClass: 'text-green-600', label: 'Bon', badgeClass: 'bg-green-100 text-green-700' };
  if (ok) return { bg: 'bg-amber-50', textClass: 'text-amber-600', label: 'Moyen', badgeClass: 'bg-amber-100 text-amber-700' };
  return { bg: 'bg-red-50', textClass: 'text-red-600', label: 'Mauvais', badgeClass: 'bg-red-100 text-red-700' };
}
