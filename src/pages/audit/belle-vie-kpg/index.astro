  { id: 7, name: 'Aiko', age: 41, role: 'Editrice magazine voyage', canal: 'Blog voyage', maturite: 'Comparaison', device: 'Tablette', decision: 'Hesite', exp: 4, conf: 3, clarte: 5, emoji: '📖', situation: 'Tokyo, projet de livre photo sur les hotels d\'art en Asie du Sud-Est', contexte: 'A lu "Best hidden gems in Koh Phangan" mentionnant La Belle Vie et les oeuvres d\'Anis Dargaa', pages: ['Accueil', 'A propos', 'Galerie', 'Chambres'], questionCle: 'Les oeuvres d\'Anis Dargaa sont-elles des pieces originales et peut-on les acheter ?', reponse: 'Non', reponseDetail: 'Page A propos mentionne l\'artiste mais zero detail : originales ? reproductions ? bio ? Insuffisant pour une editrice professionnelle.', premierImpression: 'Sur tablette, ~8 secondes de chargement. Correct. Site avec un certain charme visuel. Page A propos mentionne Anis Dargaa — c\'est ce qu\'elle cherchait.', impactTechnique: 'Tablette = meilleur chargement (8s vs 23s mobile). Mais contenu superficiel sur l\'art = vrai frein. Les Lorem Ipsum la choquent professionnellement.', positifs: ['Oeuvres d\'art = angle editorial rare en Asie du Sud-Est', 'Concept hotel-galerie coherent', 'Positionnement 6 chambres valorisant pour un reportage'], frictions: ['Zero profondeur sur l\'artiste Anis Dargaa', 'Pas de bio, portfolio, dates, medium des oeuvres', 'Temoignages Lorem Ipsum = template non fini', 'Galerie melange piscine/chambres/art sans separation'] },
  { id: 8, name: 'Ryan', age: 26, role: 'Serveur / backpackeur', canal: 'Instagram', maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte', exp: 2, conf: 2, clarte: 2, emoji: '🎒', situation: 'Sydney, budget 40-60 EUR/nuit, cherche la Full Moon Party de Koh Phangan', contexte: 'A clique sur un post sponsorise avec la piscine au sunset — mauvais ciblage publicitaire', pages: ['Accueil'], questionCle: 'C\'est combien la nuit ?', reponse: 'Non', reponseDetail: 'Aucun prix. Il voit "Presidential Suite" et comprend immediatement que c\'est hors budget.', premierImpression: '23 secondes de chargement — a failli fermer. Voit "Adults Only Boutique Resort". Comprend en 5 secondes : trop cher, trop calme. Popup Christmas = premiere interaction.', impactTechnique: 'N\'a presque pas vu le site. Lenteur + non-pertinence = rebond total en moins de 30 secondes. Persona negatif — mauvais ciblage pub.', positifs: ['Le positionnement filtre naturellement les mauvaises cibles (c\'est voulu)'], frictions: ['23s chargement + non-cible = rebond instantane', 'Popup Christmas = premiere impression negative', 'Aucun prix = meme les non-cibles ne savent pas qu\'ils sont hors budget'] },
  { id: 9, name: 'Nathalie', age: 48, role: 'Notaire', canal: 'Email promo', maturite: 'Decision', device: 'Desktop', decision: 'Hesite', exp: 5, conf: 3, clarte: 5, emoji: '⚖️', situation: 'Strasbourg, fan de Clara Morgane. A recu un email promo Songkran sur les retraites couples.', contexte: 'Budget valide (3500-4000 EUR). Son mari est partant. Elle veut confirmer les details du programme.', pages: ['Page retraite', 'Galerie', 'Chambres', 'Contact'], questionCle: 'Programme jour par jour de la retraite ? Que comprend exactement le tarif ?', reponse: 'Non', reponseDetail: '"5 jours guides" de quoi exactement ? Inclus/non-inclus pas definis. Vols ? Transferts ? Repas ?', premierImpression: 'Arrive via email directement sur la page retraite. Prix visibles (3500-4000 EUR) — seul endroit du site avec un tarif. Experience correcte grace au contenu cible.', impactTechnique: 'Desktop via email = meilleur scenario possible. Mais navigation vers le reste du site → Lorem Ipsum + section Londres → illusion cassee.', positifs: ['Page retraite avec dates et prix existe', 'Connexion Clara Morgane = motivation forte', 'Photos de l\'hotel confirment le standing'], frictions: ['Programme retraite vague : tantra, yoga, presence consciente — sans details concrets', 'Inclus/non-inclus non definis : repas ? transferts ? vols ?', 'Navigation vers reste du site → Lorem Ipsum + Londres → doute sur le serieux'] },
  { id: 10, name: 'Liam', age: 30, role: 'Consultant McKinsey', canal: 'Google Search', maturite: 'Comparaison', device: 'Mobile', decision: 'Quitte', exp: 2, conf: 1, clarte: 3, emoji: '💎', situation: 'Londres, fiance, planifie sa lune de miel. Short-list de 5 hotels comparee methodiquement.', contexte: 'Recherche "honeymoon koh phangan intimate hotel"', pages: ['Accueil', 'Chambres'], questionCle: 'Proposez-vous un package lune de miel ?', reponse: 'Non', reponseDetail: 'Le mot "honeymoon" n\'apparait pas sur le site. Pas de package, pas de champagne, pas de massage couple.', premierImpression: '23 secondes de chargement — note mentalement que c\'est inacceptable. Habitue a des sites corporate performants. Cherche "honeymoon" dans la navigation. Rien.', impactTechnique: 'Pour un consultant, LCP 23.6s = red flag professionnel. Les Lorem Ipsum sont eliminatoires : signal de manque de rigueur dans le management.', positifs: ['Positionnement intimiste 6 chambres = ideal pour lune de miel en potentiel'], frictions: ['Zero package lune de miel, zero mot "honeymoon" sur le site', 'Temoignages Lorem Ipsum = eliminatoire pour un analyste', 'Pas de prix', 'LCP 23.6s', 'Section "Near Destinations: London"'] },
  { id: 11, name: 'Brigitte', age: 62, role: 'Retraitee', canal: 'Claude (IA)', maturite: 'Comparaison', device: 'Desktop', decision: 'Quitte', exp: 3, conf: 2, clarte: 3, emoji: '👓', situation: 'Nice, veuve, voyage avec sa soeur Monique (65 ans). Claude IA a recommande La Belle Vie.', contexte: 'Claude a recommande pour "le calme, l\'art, le quartier Ban Tai loin de la Full Moon Party"', pages: ['Accueil', 'A propos', 'Galerie', 'Chambres'], questionCle: 'Comment se rendre depuis Bangkok et y a-t-il des chambres de plain-pied ?', reponse: 'Non', reponseDetail: 'Zero info transferts depuis Bangkok/Koh Samui. Zero mention accessibilite chambres. FAQ insuffisante pour des voyageuses seniors.', premierImpression: 'Desktop, chargement acceptable. Photos belles. Mais les temoignages la perturbent sans qu\'elle identifie precisement pourquoi ("ca fait bizarre ces avis").', impactTechnique: 'La section "Near Destinations: London" la perturbe enormement — elle croit avoir atterri sur le mauvais site. Choquant pour une utilisatrice qui fait confiance au web.', positifs: ['Recommandation Claude = ancre de confiance initiale', 'Photos belles et ambiance calme confirmee', 'Page A propos rassurante sur le positionnement'], frictions: ['Section "Near Destinations: London" = cru etre sur le mauvais site', 'Temoignages qui "font bizarre" (Lorem Ipsum non nomme mais senti)', 'Zero info transferts et logistique', 'Zero info accessibilite chambres', 'Google Translate widget peu professionnel'] },
  { id: 12, name: 'Tom', age: 29, role: 'Educateur sportif', canal: 'Facebook', maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte', exp: 2, conf: 5, clarte: 6, emoji: '👶', situation: 'Bruxelles, en couple avec Lucie, bebe de 8 mois. A vu un post dans un groupe "Voyager en famille en Asie".', contexte: 'Post disait "dommage que ce soit adults-only" → il va verifier si les bebes sont acceptes', pages: ['Accueil'], questionCle: 'Est-ce que les bebes sont acceptes ?', reponse: 'Oui', reponseDetail: 'La mention "adults-only" est presente et claire — reponse negative mais reponse quand meme. Tom trouve l\'info en 20 secondes.', premierImpression: '23 secondes de chargement mais il cherche une info precise. Une fois charge, il trouve rapidement la mention adults-only. Mission accomplie — ce n\'est pas pour lui.', impactTechnique: 'Tom n\'est pas reste assez longtemps pour voir les problemes. Experience minimale mais conclusive. Rebond attendu — bonne cible a ne pas cibler.', positifs: ['Adults-only clairement indique = filtre efficace des mauvaises cibles', 'Photos de la piscine impressionnantes', 'Il pensera "bel endroit, pour plus tard sans bebe"'], frictions: ['23s de chargement pour obtenir une reponse negative', 'Persona negatif — mauvaise cible famille avec bebe'] },
  { id: 13, name: 'Priya', age: 35, role: 'Fondatrice startup', canal: 'Google Maps', maturite: 'Decision', device: 'Mobile', decision: 'Hesite', exp: 2, conf: 2, clarte: 2, emoji: '⚡', situation: 'Mumbai, deja a Koh Phangan, hotel actuel decevant. Cherche a changer pour ce soir ou demain.', contexte: 'Decision urgente — cherche sur Google Maps "hotels pres de Ban Tai Beach" avec disponibilite immediate', pages: ['Accueil', 'Chambres', 'Contact'], questionCle: 'Avez-vous une chambre disponible pour ce soir ?', reponse: 'Non', reponseDetail: 'Pas de booking engine, pas de WhatsApp visible, pas de telephone en header. Uniquement un formulaire email — inadapte pour une urgence.', premierImpression: '23 secondes de chargement sur reseau mobile thai. Cherche immediatement un numero WhatsApp ou telephone. Rien en header. Page Contact = formulaire email uniquement.', impactTechnique: 'Site vitrine passif = elimine pour les reservations urgentes. Booking.com est a 2 clics — elle y retourne. Pendant que le site met 23s, un concurrent confirme la reservation.', positifs: ['Position GBP sur Google Maps = point d\'entree valide', 'Photos et standing correspondent a ses criteres', 'Localisation Ban Tai Beach = convient'], frictions: ['Pas de WhatsApp ni telephone direct en header', 'Formulaire email inutilisable pour une urgence', 'LCP 23.6s sur reseau mobile thai = calvaire', 'Pas de booking engine ni disponibilite temps reel'] },
  { id: 14, name: 'Markus', age: 42, role: 'Professeur d\'economie', canal: 'Perplexity', maturite: 'Comparaison', device: 'Desktop', decision: 'Quitte', exp: 3, conf: 1, clarte: 3, emoji: '🎓', situation: 'Zurich, en couple avec Anna (galeriste). Perplexity a cite La Belle Vie parmi "art hotels under $200/night".', contexte: 'Compare analytiquement une liste de 8 hotels — methode universitaire rigoureuse', pages: ['Accueil', 'A propos', 'Galerie', 'Chambres'], questionCle: 'Quel est le tarif moyen par nuit ? Les oeuvres sont-elles visibles depuis les espaces communs ?', reponse: 'Non', reponseDetail: 'Pas de prix = impossible de confirmer "under $200/night". Zero presentation detaillee des oeuvres dans les espaces communs.', premierImpression: 'Desktop, chargement correct. Il coche ses criteres : 6 chambres OK, art Anis Dargaa mentionne, adults-only OK. Puis les temoignages Lorem Ipsum.', impactTechnique: 'Pour un universitaire, les sources non verifiables sont eliminatoires. Ne peut pas confirmer le prix de Perplexity. Open Graph absent = le lien envoye par email a Anna n\'affiche aucune preview.', positifs: ['Concept art hotel = parfaitement aligne avec Anna (galeriste)', 'Mention Anis Dargaa = differenciateur reel', 'Positionnement 6 chambres = adapte a leur profil'], frictions: ['Temoignages Lorem Ipsum = eliminatoire pour un profil analytique', 'Impossible de confirmer "under $200" sans prix', 'Zero profondeur sur les oeuvres d\'art pour une galeriste', 'Open Graph absent = pas de preview email pour Anna'] },
  { id: 15, name: 'Sophie', age: 37, role: 'Responsable communication', canal: 'Google Search', maturite: 'Decision', device: 'Mobile', decision: 'Convertit', exp: 3, conf: 3, clarte: 5, emoji: '💫', situation: 'Reims, fan de Clara Morgane. Mariee a Julien (viticulteur). Budget 4000 EUR valide.', contexte: 'Recherche "retraite couple clara morgane koh phangan" — motivation externe tres forte', pages: ['Page retraite', 'Galerie', 'Chambres', 'Contact'], questionCle: 'Reste-t-il des places ? Quel est le programme jour par jour ?', reponse: 'Partiellement', reponseDetail: 'Page retraite avec prix et dates. Mais programme vague, places restantes non indiquees. Sophie envoie un email de demande d\'informations.', premierImpression: 'Chargement long mais elle est tres motivee et patiente. La page retraite existe — soulagement. Prix visibles (3500-4000 EUR). Ce n\'est pas le site qui convertit, c\'est Clara Morgane.', impactTechnique: 'Sa conversion est une anomalie statistique due a sa motivation externe (fan Clara Morgane). LCP 23.6s aurait elimine tout autre profil. Les Lorem Ipsum ne la perturbent pas vraiment.', positifs: ['Page retraite avec prix et dates = seul endroit du site avec un tarif visible', 'Clara Morgane = motivation suffisante pour surmonter toutes les frictions du site', 'Photos de l\'hotel confirment le standing et l\'ambiance'], frictions: ['Programme retraite vague — 7 jours de quoi exactement ?', 'Places restantes non indiquees = pas d\'urgence creee', 'Confiance vient de Clara Morgane, pas du site — conversion fragile'] },
  { id: 16, name: 'Dylan', age: 24, role: 'Etudiant master', canal: 'Instagram', maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte', exp: 2, conf: 1, clarte: 3, emoji: '🎮', situation: 'Manchester, budget ultra-serre, gap semester avec 2 potes. Cherche la fete.', contexte: 'A clique sur un reel sponsorise par reflexe — hors-cible total', pages: ['Accueil'], questionCle: 'Aucune — quitte en 10 secondes', reponse: 'Non applicable', reponseDetail: 'Dylan quitte avant d\'avoir compris ce qu\'est le site. "Adults Only Boutique Resort" + chargement lent = bye immediat.', premierImpression: 'Le hero dit "Adults Only Boutique Resort". Dylan comprend immediatement : trop cher, trop calme. Il ne scrolle meme pas. 23 secondes = eternite pour un Gen Z.', impactTechnique: 'Gen Z = TikTok et Instagram instantanes. 23 secondes = eternite absolue. Jugement esthetique : "ce site est vieux". Popup Christmas = "meme pas a jour". Persona negatif.', positifs: ['Adults-only filtre la bonne cible — Dylan en est l\'illustration involontaire'], frictions: ['23s de chargement + site "vieux" = rebond Gen Z instantane', 'Popup Christmas = "ce site n\'est meme pas a jour"', 'Non-cible — aucune chance de conversion'] },
