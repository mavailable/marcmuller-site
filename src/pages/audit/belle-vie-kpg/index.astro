const personas = [
  { id: 1, name: 'Chloe', age: 32, role: 'Architecte d\'interieur', canal: 'Google Search', maturite: 'Comparaison', device: 'Mobile', decision: 'Quitte', exp: 3, conf: 2, clarte: 4, emoji: '🏛️', situation: 'En couple a Lyon, planifie 2 semaines en Thailande pour decembre 2026', contexte: 'Recherche "boutique hotel koh phangan adults only" — compare 3 hotels en parallele', pages: ['Accueil', 'Chambres', 'Galerie'], questionCle: 'Quel est le tarif pour 4 nuits en chambre double en decembre ?', reponse: 'Non', reponseDetail: 'Aucun prix affiche sur le site. Impossible de comparer avec ses 2 autres options qui affichent leurs tarifs.', premierImpression: '23 secondes de chargement mobile. Elle attend, impatiente. La section "Near Destinations" affiche Londres — elle reste perplexe.', impactTechnique: 'LCP 23.6s : a failli fermer l\'onglet. Ses 2 autres hotels sur la short-list chargent en 3-4s — handicap concurrentiel immediat.', positifs: ['Positionnement adults-only correspond exactement a sa recherche', 'Photos des chambres correctes', 'Concept boutique hotel intimiste bien identifie'], frictions: ['Aucun prix = impossible de comparer', 'Temoignages Lorem Ipsum = template non personnalise identifie', 'Section "Near Destinations: London" pour un hotel en Thailande', 'Popup Christmas Flash Deal en mars 2026', 'Copyright 2024'] },
