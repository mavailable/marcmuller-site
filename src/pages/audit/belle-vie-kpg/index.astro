// ─── AMELIORATIONS ───
const ameliorations = {
  haute: [
    { title: 'Supprimer les temoignages Lorem Ipsum', impact: '20/20 personas', detail: 'C\'est le probleme le plus destructeur du site. 18 personas sur 20 perdent confiance en voyant le faux texte latin. Le premier signal de non-professionnalisme dans le parcours.', action: 'Integrer les avis Google (4.9 etoiles) directement sur la page d\'accueil avec un widget ou des verbatims + photo/nom. Supprimer entierement les 3 blocs Lorem Ipsum.' },
