  'Creer un llms.txt pour visibilite dans les IA generatives (ChatGPT, Perplexity, Claude)',
  'Ajouter des fiches techniques PDF telechargearbles sur chaque page produit/marque',
  'Creer une page "Ou trouver nos produits" avec reseau de distributeurs physiques',
  'Integrer des temoignages clients et logos grands comptes (SNCF, Airbus) en accueil',
  'Lancer un blog applicatif (tutoriels produits, guides use-cases) pour SEO long-tail et visibilite IA',
  'Creer une galerie de realisations par secteur (restaurant, bailleur, industrie) pour convaincre designers et prescripteurs',
  'Corriger la navigation confuse entre site institutionnel et boutiques (Maison Etanche, Arcane Direct)',
];

// ============================================================
// HELPERS
// ============================================================
function scoreColor(score: number): string {
  if (score >= 90) return '#22c55e';
  if (score >= 50) return '#f59e0b';
  return '#ef4444';
}

function scoreTextClass(score: number): string {
  if (score >= 90) return 'text-green-600';
  if (score >= 50) return 'text-amber-600';
  return 'text-red-600';
}

function decisionBadge(decision: string) {
  if (decision === 'convertit') return { text: 'Contacte', cls: 'bg-green-100 text-green-800' };
  if (decision === 'hesite') return { text: 'Hesite', cls: 'bg-amber-100 text-amber-800' };
  if (decision === 'quitte') return { text: 'Repart', cls: 'bg-neutral-100 text-neutral-600' };
  return { text: 'Invisible', cls: 'bg-red-100 text-red-700' };
}
---

<BaseLayout {title} {description} noindex={true}>
  <!-- ========================================================
       EN-TETE RAPPORT
  ======================================================== -->
  <section class="py-12 px-4 bg-neutral-900">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-xs font-medium uppercase tracking-widest text-neutral-400">Rapport d'audit</span>
        <span class="text-neutral-600">·</span>
        <span class="text-xs text-neutral-400">{prospect.date}</span>
      </div>

      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-2">{prospect.name}</h1>
      <p class="text-neutral-300 text-lg mb-1">{prospect.activity}</p>
      <p class="text-neutral-500 text-sm mb-6">{prospect.location}</p>

      <a href={prospect.url} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-blue-400 hover:text-blue-300 transition-colors">
        <span>{prospect.url}</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <!-- KPIs globaux -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <p class="text-3xl font-bold text-white mb-1">{kpis.convertissent}/10</p>
          <p class="text-xs text-neutral-400">personas contactent</p>
        </div>
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <p class="text-3xl font-bold text-amber-400 mb-1">{kpis.hesitent}/10</p>
          <p class="text-xs text-neutral-400">hesitent</p>
        </div>
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <p class="text-3xl font-bold text-neutral-300 mb-1">{kpis.quittent}/10</p>
          <p class="text-xs text-neutral-400">repartent</p>
        </div>
        <div class="bg-red-900/40 border border-red-800 rounded-xl p-4 text-center">
          <p class="text-3xl font-bold text-red-400 mb-1">{observatory.grade}</p>
          <p class="text-xs text-red-300">Observatory grade</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       LE CONSTAT
  ======================================================== -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-amber-900 font-medium text-base leading-relaxed">{constat}</p>
      </div>

      <!-- Resume visiteurs -->
      <div class="flex flex-wrap gap-3 mb-8">
        <div class="flex items-center gap-2 bg-green-50 border border-green-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
          <span class="text-sm font-semibold text-green-800">{kpis.convertissent} contactent</span>
        </div>
        <div class="flex items-center gap-2 bg-amber-50 border border-amber-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
          <span class="text-sm font-semibold text-amber-800">{kpis.hesitent} hesitent</span>
        </div>
        <div class="flex items-center gap-2 bg-neutral-100 border border-neutral-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-neutral-400 shrink-0"></span>
          <span class="text-sm font-semibold text-neutral-700">{kpis.quittent} repartent</span>
        </div>
      </div>

      <!-- Conversion par canal -->
      <div class="mb-10">
        <h3 class="font-semibold text-neutral-800 mb-4 text-sm uppercase tracking-wide">Taux de contact par canal d'arrivee</h3>
        <div class="space-y-3">
          {conversionByCanal.map(item => (
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-neutral-700">{item.canal}</span>
                <span class={`text-sm font-bold ${item.color}`}>{item.taux}%</span>
              </div>
              <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
                <div class={`h-full rounded-full ${item.bg}`} style={`width: ${item.taux}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Top frictions -->
      <h3 class="font-semibold text-neutral-800 mb-4 text-sm uppercase tracking-wide">Top 5 frictions identifiees</h3>
      <ol class="space-y-3">
        {topFrictions.map((f, i) => (
          <li class="flex gap-4 p-4 bg-neutral-50 border border-neutral-200 rounded-xl">
            <span class="shrink-0 w-7 h-7 rounded-full bg-red-100 text-red-700 flex items-center justify-center text-sm font-bold">{i + 1}</span>
            <div>
              <p class="font-semibold text-neutral-900 text-sm">{f.titre} <span class="ml-2 text-xs text-neutral-500 font-normal">{f.count}/10 personas</span></p>
              <p class="text-neutral-600 text-xs mt-0.5">{f.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========================================================
       AUDIT TECHNIQUE
  ======================================================== -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">L'audit technique</h2>

      <!-- PageSpeed mobile -->
      <div class="bg-white border border-neutral-200 rounded-xl p-6 mb-6">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
          <h3 class="font-semibold text-neutral-800">PageSpeed — Mobile</h3>
          <span class="text-xs text-neutral-400 bg-neutral-100 px-2 py-1 rounded">scores estimes — profil PrestaShop Apache sans cache</span>
        </div>
        <div class="grid grid-cols-4 gap-4">
          {[
            { label: 'Performance', score: pagespeed.mobile.performance },
            { label: 'Accessibilite', score: pagespeed.mobile.accessibility },
            { label: 'Bonnes pratiques', score: pagespeed.mobile.bestPractices },
            { label: 'SEO', score: pagespeed.mobile.seo },
          ].map(item => (
            <div class="text-center">
              <div class="relative w-14 h-14 mx-auto mb-2">
                <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                    fill="none" stroke="#e5e7eb" stroke-width="3.5" />
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                    fill="none" stroke={scoreColor(item.score)} stroke-width="3.5"
                    stroke-dasharray={`${item.score}, 100`} stroke-linecap="round" />
                </svg>
                <span class={`absolute inset-0 flex items-center justify-center text-base font-bold ${scoreTextClass(item.score)}`}>{item.score}</span>
              </div>
              <p class="text-xs text-neutral-600">{item.label}</p>
            </div>
          ))}
        </div>

        <div class="mt-6 pt-5 border-t border-neutral-100">
          <p class="text-sm font-semibold text-neutral-700 mb-3">Core Web Vitals (mobile)</p>
          <div class="flex flex-wrap gap-3">
            {coreWebVitals.map(cwv => (
              <div class={`px-3 py-2 rounded-lg border text-xs font-medium ${cwv.status === 'bad' ? 'bg-red-50 border-red-200 text-red-700' : cwv.status === 'medium' ? 'bg-amber-50 border-amber-200 text-amber-700' : 'bg-green-50 border-green-200 text-green-700'}`}>
                <span class="font-bold">{cwv.name}</span> {cwv.value}
              </div>
            ))}
          </div>
        </div>

        <div class="mt-5 pt-4 border-t border-neutral-100">
          <p class="text-sm font-semibold text-neutral-700 mb-3">Principales opportunites</p>
          <ul class="space-y-2">
            {opportunities.map(op => (
              <li class="flex items-center justify-between text-xs text-neutral-600 bg-neutral-50 rounded-lg px-3 py-2">
                <span>{op.label}</span>
                <span class="shrink-0 ml-3 font-semibold text-green-700">{op.saving}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- PageSpeed desktop -->
      <div class="bg-white border border-neutral-200 rounded-xl p-6 mb-6">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
          <h3 class="font-semibold text-neutral-800">PageSpeed — Desktop</h3>
          <span class="text-xs text-neutral-400 bg-neutral-100 px-2 py-1 rounded">scores estimes</span>
        </div>
        <div class="grid grid-cols-4 gap-4">
          {[
            { label: 'Performance', score: pagespeed.desktop.performance },
            { label: 'Accessibilite', score: pagespeed.desktop.accessibility },
            { label: 'Bonnes pratiques', score: pagespeed.desktop.bestPractices },
            { label: 'SEO', score: pagespeed.desktop.seo },
          ].map(item => (
            <div class="text-center">
              <div class="relative w-14 h-14 mx-auto mb-2">
                <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                    fill="none" stroke="#e5e7eb" stroke-width="3.5" />
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                    fill="none" stroke={scoreColor(item.score)} stroke-width="3.5"
                    stroke-dasharray={`${item.score}, 100`} stroke-linecap="round" />
                </svg>
                <span class={`absolute inset-0 flex items-center justify-center text-base font-bold ${scoreTextClass(item.score)}`}>{item.score}</span>
              </div>
              <p class="text-xs text-neutral-600">{item.label}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Observatory -->
      <div class="bg-white border border-neutral-200 rounded-xl p-6 mb-6">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
          <h3 class="font-semibold text-neutral-800">Mozilla Observatory — Securite HTTP</h3>
          <a href="https://developer.mozilla.org/en-US/observatory/analyze?host=arcane-industries.fr"
            target="_blank" rel="noopener noreferrer"
            class="text-xs text-blue-600 hover:underline">Voir rapport complet</a>
        </div>
        <div class="flex items-center gap-6 mb-4">
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mb-1 mx-auto">
              <span class="text-3xl font-bold text-red-600">{observatory.grade}</span>
            </div>
            <p class="text-xs text-neutral-500">Grade</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-red-600">{observatory.score}/100</p>
            <p class="text-xs text-neutral-500">Score</p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-neutral-700">{observatory.testsPassed}/{observatory.testsTotal}</p>
            <p class="text-xs text-neutral-500">Tests passes</p>
          </div>
        </div>
        <p class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg p-3">
          Aucun header de securite de niveau 1 (CSP, HSTS, X-Frame-Options, X-Content-Type-Options, Referrer-Policy, Permissions-Policy). Surface d'attaque maximale. Un responsable IT peut eliminer Arcane Industries sur ce seul critere.
        </p>
      </div>

      <!-- Checklist technique -->
      <div class="bg-white border border-neutral-200 rounded-xl p-6">
        <h3 class="font-semibold text-neutral-800 mb-4">Checklist technique</h3>
        <ul class="space-y-2">
          {techChecks.map(check => (
            <li class={`flex items-start gap-3 p-2.5 rounded-lg ${check.present ? 'bg-green-50' : check.critical ? 'bg-red-50' : 'bg-neutral-50'}`}>
              <span class={`shrink-0 mt-0.5 text-sm ${check.present ? 'text-green-500' : check.critical ? 'text-red-500' : 'text-neutral-400'}`}>
                {check.present ? '✓' : '✗'}
              </span>
              <div>
                <span class={`text-sm ${check.present ? 'text-green-800' : check.critical ? 'text-red-800 font-medium' : 'text-neutral-600'}`}>
                  {check.label}
                </span>
                {check.note && (
                  <p class="text-xs text-neutral-500 mt-0.5">{check.note}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ========================================================
       PERSONAS
  ======================================================== -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">10 visites simulees</h2>
      <p class="text-neutral-500 text-sm mb-8">Sous-agent 1 : personas B2B/Pro (1-5) — Sous-agent 2 : personas grand public (6-10)</p>

      <div class="space-y-6">
        {personas.map(p => {
          const badge = decisionBadge(p.decision);
          const avgScore = p.scores.exp > 0 ? ((p.scores.exp + p.scores.conf + p.scores.clarte) / 3).toFixed(1) : '0';
          return (
            <div class="border border-neutral-200 rounded-xl overflow-hidden">
              <!-- Header persona -->
              <div class="flex items-center justify-between p-4 bg-neutral-50 border-b border-neutral-200">
                <div class="flex items-center gap-3">
                  <span class="text-2xl">{p.emoji}</span>
                  <div>
                    <p class="font-semibold text-neutral-900">{p.name}, {p.age} ans</p>
                    <div class="flex flex-wrap gap-1.5 mt-0.5">
                      <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full">{p.canal}</span>
                      <span class="text-xs bg-neutral-200 text-neutral-600 px-2 py-0.5 rounded-full">{p.device}</span>
                      <span class="text-xs bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full">{p.maturite}</span>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="text-center hidden sm:block">
                    <p class="text-xl font-bold text-neutral-700">{avgScore}</p>
                    <p class="text-xs text-neutral-400">/ 10</p>
                  </div>
                  <span class={`px-3 py-1.5 rounded-full text-xs font-semibold ${badge.cls}`}>{badge.text}</span>
                </div>
              </div>

              <!-- Corps -->
              <div class="p-4 space-y-3">
                <p class="text-sm text-neutral-600">{p.situation}</p>
                <p class="text-xs text-neutral-500 italic">{p.contexte}</p>

                {p.parcours.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 text-xs">
                    {p.parcours.map((page, idx) => (
                      <span class="flex items-center gap-1">
                        <span class="bg-neutral-100 border border-neutral-200 rounded px-2 py-0.5 text-neutral-700">{page}</span>
                        {idx < p.parcours.length - 1 && <span class="text-neutral-300">→</span>}
                      </span>
                    ))}
                  </div>
                )}

                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide mb-1">Premiere impression</p>
                  <p class="text-sm text-neutral-700 italic">"{p.premierImpression}"</p>
                </div>

                <div class="grid md:grid-cols-2 gap-3">
                  <div>
                    <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide mb-1.5">Question cle</p>
                    <p class="text-xs text-neutral-600 italic">"{p.questionCle}"</p>
                    <p class="text-xs mt-1"><span class="font-medium">Reponse :</span> <span class={`font-semibold ${p.reponse === 'Oui' ? 'text-green-600' : p.reponse === 'Non' || p.reponse === 'Invisible' ? 'text-red-600' : 'text-amber-600'}`}>{p.reponse}</span></p>
                    <p class="text-xs text-neutral-500 mt-0.5">{p.commentReponse}</p>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide mb-1.5">Impact technique</p>
                    <p class="text-xs text-neutral-600">{p.impactTechnique}</p>
                  </div>
                </div>

                <div class="grid md:grid-cols-2 gap-3 pt-2">
                  {p.pointsPositifs.length > 0 && (
                    <div>
                      <p class="text-xs font-semibold text-green-700 mb-1">Points positifs</p>
                      <ul class="space-y-0.5">
                        {p.pointsPositifs.map(pt => (
                          <li class="text-xs text-green-800 flex gap-1.5"><span class="text-green-400 shrink-0">+</span>{pt}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                  <div>
                    <p class="text-xs font-semibold text-red-700 mb-1">Frictions</p>
                    <ul class="space-y-0.5">
                      {p.frictions.map(fr => (
                        <li class="text-xs text-red-800 flex gap-1.5"><span class="text-red-400 shrink-0">−</span>{fr}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ========================================================
       RECOMMANDATIONS
  ======================================================== -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-8">Recommandations</h2>

      <!-- Critiques -->
      <h3 class="font-semibold text-red-700 text-sm uppercase tracking-wide mb-4">Critiques — Impact immediat</h3>
      <div class="space-y-4 mb-10">
        {ameliorationsCritiques.map((a, i) => (
          <div class="bg-white border border-red-200 rounded-xl p-5">
            <div class="flex items-start gap-3">
              <span class="shrink-0 w-6 h-6 rounded-full bg-red-100 text-red-700 flex items-center justify-center text-xs font-bold mt-0.5">{i + 1}</span>
              <div>
                <p class="font-semibold text-neutral-900 text-sm mb-1">{a.titre}</p>
                <p class="text-neutral-600 text-xs leading-relaxed">{a.detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Importantes -->
      <h3 class="font-semibold text-amber-700 text-sm uppercase tracking-wide mb-4">Importantes — Impact a 30 jours</h3>
      <ul class="space-y-2">
        {ameliorationsImportantes.map(a => (
          <li class="flex items-start gap-3 bg-white border border-amber-200 rounded-xl p-4">
            <span class="shrink-0 w-1.5 h-1.5 rounded-full bg-amber-400 mt-1.5"></span>
            <span class="text-sm text-neutral-700">{a}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========================================================
       CTA MARC M
  ======================================================== -->
  <section class="py-16 px-4 bg-neutral-900">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-heading text-2xl font-bold text-white mb-4">
        Arcane Industries merite un site a la hauteur de son savoir-faire
      </h2>
      <p class="text-neutral-300 mb-8 leading-relaxed">
        56 ans d'expertise, 18 marques, des references SNCF et Airbus — et un site qui score F en securite et echoue sur chaque partage LinkedIn. En 7 jours, Marc M. peut transformer ce site institutionnel en outil de generation de leads B2B.
      </p>
      <a href="/contact/"
        class="inline-flex items-center gap-2 bg-white text-neutral-900 font-semibold px-8 py-4 rounded-xl hover:bg-neutral-100 transition-colors">
        Proposer cet audit a Arcane Industries
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
