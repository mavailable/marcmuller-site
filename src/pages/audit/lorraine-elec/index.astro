---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX — Lorraine Elec 57 | Marc M.';
const description = 'Audit complet du site lorraineelec57.fr : 10 personas simules, WordPress/Elementor lent, aucun temoignage, zero header securite, recommandations actionnables pour electricien Metz.';

// ─── PROSPECT ───
const prospect = {
  name: 'Lorraine Elec 57',
  url: 'https://www.lorraineelec57.fr/',
  date: '29 mars 2026',
  activity: 'Electricien — Installation, Depannage, Securite, Bornes de recharge',
  location: 'Argancy / Woippy (57) — Metz & Thionville, Grand Est',
};

// ─── KPIs ───
const kpis = {
  conversion: 30,
  experience: 5.2,
  confiance: 5.0,
  clarte: 5.4,
};

// ─── CONSTAT ───
const constat = "Le site a du contenu et des realisations, mais ne convertit qu'un visiteur sur trois : pas de temoignages, pas de telephone en header, pas de tarif, pas de FAQ — et une section Actualites vide qui donne une impression d'abandon.";

// ─── CONVERSION PAR CANAL ───
const conversionByCanal = [
  { canal: 'Bouche-a-oreille', taux: 100, color: 'text-green-600', bg: 'bg-green-500' },
  { canal: 'Google Maps / GBP', taux: 50, color: 'text-green-600', bg: 'bg-green-500' },
  { canal: 'Google Search', taux: 20, color: 'text-amber-600', bg: 'bg-amber-500' },
  { canal: 'Reseaux sociaux', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'IA (ChatGPT / Perplexity)', taux: 0, color: 'text-red-700', bg: 'bg-red-700' },
  { canal: 'Autre (direct)', taux: 50, color: 'text-green-600', bg: 'bg-green-500' },
];

// ─── TOP FRICTIONS ───
const topFrictions = [
  { titre: 'Aucun temoignage ni avis client visible', count: 9, detail: 'Les visiteurs en phase de comparaison veulent des preuves sociales. Aucun avis Google, aucun verbatim, aucune note — le prospect ne peut pas se rassurer.' },
  { titre: 'Pas de telephone cliquable en header', count: 8, detail: 'Le numero 03 87 66 57 41 est uniquement en footer. Sur mobile, un visiteur en urgence (panne, depannage) ne le trouve pas sans scroller tout le site.' },
  { titre: 'Section Actualites vide — impression d\'abandon', count: 7, detail: '"Aucune autre publication" est le seul contenu de la section Actualites. Ca donne l\'impression que le site n\'est plus maintenu depuis 2024.' },
  { titre: 'Aucune certification visible sur l\'accueil', count: 6, detail: 'Qualifelec, ADVENIR, IRVE ne sont mentionnes que sur la sous-page bornes de recharge. L\'accueil ne montre aucune qualification professionnelle.' },
  { titre: 'Pas de tarif ni fourchette de prix', count: 5, detail: 'Les visiteurs en decouverte veulent savoir si c\'est dans leur budget. Aucune indication de prix, meme approximative — le site les oblige a contacter pour tout.' },
];

// ─── PAGESPEED ───
const pagespeed = {
  mobile: { performance: 45, accessibility: 78, bestPractices: 75, seo: 82 },
  desktop: { performance: 68, accessibility: 78, bestPractices: 75, seo: 82 },
};
const coreWebVitals = [
  { name: 'LCP mobile', value: '~3,5 s', status: 'rouge' },
  { name: 'INP', value: '~180 ms', status: 'orange' },
  { name: 'CLS', value: '~0,12', status: 'orange' },
  { name: 'FCP', value: '~2,2 s', status: 'orange' },
  { name: 'TTFB', value: '~0,8 s', status: 'orange' },
];

// ─── OBSERVATORY ───
const observatory = { grade: 'F', score: 25, testsPassed: 1, testsTotal: 6 };

// ─── CHECKLIST TECHNIQUE ───
const techChecks = [
  { label: 'HTTPS + HTTP/2 actif', present: true, critical: false },
  { label: 'Meta title + description (Yoast)', present: true, critical: false },
  { label: 'H1 unique avec mot-cle metier + ville', present: true, critical: false },
  { label: 'robots.txt + sitemap.xml accessibles', present: true, critical: false },
  { label: 'Schema.org type Electrician / LocalBusiness', present: false, critical: true },
  { label: 'Open Graph image presente', present: false, critical: false },
  { label: 'HSTS (Strict-Transport-Security)', present: false, critical: true },
  { label: 'X-Content-Type-Options', present: false, critical: true },
  { label: 'Content-Security-Policy', present: false, critical: true },
  { label: 'X-Frame-Options', present: false, critical: false },
  { label: 'Telephone cliquable en header', present: false, critical: true },
  { label: 'Temoignages / avis clients visibles', present: false, critical: true },
];

// ─── PERSONAS ───
const personas = [
  {
    id: 1,
    name: 'Jean-Pierre',
    age: 62,
    emoji: '\u{1F3E0}',
    canal: 'Google Search',
    device: 'Mobile',
