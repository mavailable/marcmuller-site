];

const score = 35;
const scoreColor = score >= 60 ? 'text-green-600' : score >= 40 ? 'text-amber-600' : 'text-red-600';

// KPI helpers
const kpiColor = (v: number) => v >= 7 ? 'text-green-600' : v >= 5 ? 'text-amber-600' : 'text-red-600';
const vitalsColor = (s: string) => s === 'vert' ? 'bg-green-100 text-green-700' : s === 'orange' ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700';
const checkColor = (present: boolean, critical: boolean) => present ? 'text-green-600' : critical ? 'text-red-600' : 'text-amber-500';
const checkIcon = (present: boolean) => present ? '✓' : '✗';
---

<BaseLayout title={title} description={description} noindex={true}>
  <div class="max-w-4xl mx-auto px-4 py-12 space-y-16">

    <!-- HEADER -->
    <header class="space-y-4 border-b border-neutral-200 pb-8">
      <p class="text-sm text-neutral-500 font-mono">Audit prospect · {prospect.date}</p>
      <h1 class="text-3xl font-bold text-neutral-900">Audit UX — {prospect.name}</h1>
      <p class="text-neutral-600">{prospect.activity}</p>
      <p class="text-sm text-neutral-500">{prospect.location}</p>
      <a href={prospect.url} target="_blank" rel="noopener" class="text-sm text-primary-600 hover:underline">{prospect.url}</a>
      <div class="mt-4 p-4 bg-amber-50 border border-amber-200 rounded-lg">
        <p class="text-sm text-amber-800 font-medium">Constat principal</p>
        <p class="text-sm text-amber-700 mt-1">{constat}</p>
      </div>
    </header>

    <!-- KPIs -->
    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-neutral-900">Indicateurs globaux</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white border border-neutral-200 rounded-lg p-4 text-center">
          <p class="text-3xl font-bold {scoreColor}">{kpis.conversion}%</p>
          <p class="text-xs text-neutral-500 mt-1">Taux de conversion estimé</p>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4 text-center">
          <p class={`text-3xl font-bold ${kpiColor(kpis.experience)}`}>{kpis.experience}/10</p>
          <p class="text-xs text-neutral-500 mt-1">Expérience visiteur</p>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4 text-center">
          <p class={`text-3xl font-bold ${kpiColor(kpis.confiance)}`}>{kpis.confiance}/10</p>
          <p class="text-xs text-neutral-500 mt-1">Score confiance</p>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4 text-center">
          <p class={`text-3xl font-bold ${kpiColor(kpis.clarte)}`}>{kpis.clarte}/10</p>
          <p class="text-xs text-neutral-500 mt-1">Clarté de l'offre</p>
        </div>
      </div>
    </section>

    <!-- TOP FRICTIONS -->
    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-neutral-900">Top 5 frictions — impact conversion</h2>
      <div class="space-y-3">
        {topFrictions.map((f) => (
          <div class="bg-white border border-neutral-200 rounded-lg p-4">
            <div class="flex items-start gap-3">
              <span class="shrink-0 bg-red-100 text-red-700 text-xs font-bold px-2 py-1 rounded">{f.count}/10</span>
              <div>
                <p class="font-medium text-neutral-900 text-sm">{f.titre}</p>
                <p class="text-neutral-500 text-xs mt-1">{f.detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CONVERSION PAR CANAL -->
    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-neutral-900">Conversion estimée par canal</h2>
      <div class="space-y-2">
        {conversionByCanal.map((c) => (
          <div class="flex items-center gap-3">
            <span class="w-44 text-sm text-neutral-600 shrink-0">{c.canal}</span>
            <div class="flex-1 bg-neutral-100 rounded-full h-3">
              <div class={`h-3 rounded-full ${c.bg}`} style={`width: ${c.taux}%`}></div>
            </div>
            <span class={`text-sm font-semibold w-12 text-right ${c.color}`}>{c.taux}%</span>
          </div>
        ))}
      </div>
    </section>

    <!-- PAGESPEED -->
    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-neutral-900">Performance — PageSpeed Insights</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <p class="font-medium text-neutral-700 mb-3">Mobile</p>
          <div class="space-y-2">
            {Object.entries(pagespeed.mobile).map(([k, v]) => (
              <div class="flex justify-between text-sm">
                <span class="text-neutral-600 capitalize">{k.replace(/([A-Z])/g, ' $1')}</span>
                <span class={v >= 90 ? 'text-green-600 font-semibold' : v >= 50 ? 'text-amber-600 font-semibold' : 'text-red-600 font-semibold'}>{v}/100</span>
              </div>
            ))}
          </div>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <p class="font-medium text-neutral-700 mb-3">Desktop</p>
          <div class="space-y-2">
            {Object.entries(pagespeed.desktop).map(([k, v]) => (
              <div class="flex justify-between text-sm">
                <span class="text-neutral-600 capitalize">{k.replace(/([A-Z])/g, ' $1')}</span>
                <span class={v >= 90 ? 'text-green-600 font-semibold' : v >= 50 ? 'text-amber-600 font-semibold' : 'text-red-600 font-semibold'}>{v}/100</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="space-y-2">
        <p class="text-sm font-medium text-neutral-700">Core Web Vitals</p>
        {coreWebVitals.map((v) => (
          <div class="flex items-center justify-between text-sm">
            <span class="text-neutral-600">{v.name}</span>
            <span class={`px-2 py-0.5 rounded text-xs font-medium ${vitalsColor(v.status)}`}>{v.value}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- OBSERVATORY -->
    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-neutral-900">Sécurité — MDN Observatory</h2>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 flex items-center gap-4">
        <span class="text-5xl font-black text-red-600">{observatory.grade}</span>
        <div>
          <p class="text-2xl font-bold text-red-700">{observatory.score}/100</p>
          <p class="text-sm text-red-600">{observatory.testsPassed} tests réussis sur {observatory.testsTotal}</p>
          <p class="text-xs text-red-500 mt-1">CSP, HSTS, X-Frame-Options, X-Content-Type-Options, Referrer-Policy — tous manquants</p>
        </div>
      </div>
    </section>

    <!-- CHECKLIST TECHNIQUE -->
    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-neutral-900">Checklist technique</h2>
      <div class="grid md:grid-cols-2 gap-2">
        {techChecks.map((c) => (
          <div class="flex items-start gap-2 text-sm">
            <span class={`shrink-0 font-bold ${checkColor(c.present, c.critical)}`}>{checkIcon(c.present)}</span>
            <span class={c.present ? 'text-neutral-600' : c.critical ? 'text-red-700 font-medium' : 'text-amber-700'}>{c.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- PERSONAS -->
    <section class="space-y-6">
      <h2 class="text-xl font-semibold text-neutral-900">10 personas simulés</h2>
      <div class="space-y-4">
        {personas.map((p) => (
          <div class="bg-white border border-neutral-200 rounded-xl p-5">
            <div class="flex items-start justify-between gap-3 mb-3">
              <div class="flex items-center gap-3">
                <span class="text-2xl">{p.emoji}</span>
                <div>
                  <p class="font-semibold text-neutral-900">{p.name}, {p.age} ans</p>
                  <p class="text-xs text-neutral-500">{p.canal} · {p.device} · {p.maturite}</p>
                </div>
              </div>
              <span class={`shrink-0 text-xs font-bold px-3 py-1 rounded-full ${p.decision === 'convertit' ? 'bg-green-100 text-green-700' : p.decision === 'quitte' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>
                {p.decision === 'convertit' ? 'Convertit' : p.decision === 'quitte' ? 'Quitte' : 'Hésite'}
              </span>
            </div>
            <p class="text-sm text-neutral-600 mb-2">{p.situation}</p>
            <p class="text-xs text-neutral-500 mb-3 italic">{p.premierImpression}</p>
            <div class="flex gap-4 mb-3 text-xs">
              <span class={`font-medium ${kpiColor(p.scores.exp)}`}>Exp. {p.scores.exp}/10</span>
              <span class={`font-medium ${kpiColor(p.scores.conf)}`}>Conf. {p.scores.conf}/10</span>
              <span class={`font-medium ${kpiColor(p.scores.clarte)}`}>Clarté {p.scores.clarte}/10</span>
            </div>
            <div class="grid md:grid-cols-2 gap-3 text-xs">
              <div>
                <p class="font-medium text-green-700 mb-1">Points positifs</p>
                <ul class="space-y-0.5">
                  {p.pointsPositifs.map((pt) => <li class="text-green-600">+ {pt}</li>)}
                </ul>
              </div>
              <div>
                <p class="font-medium text-red-700 mb-1">Frictions</p>
                <ul class="space-y-0.5">
                  {p.frictions.map((fr) => <li class="text-red-600">— {fr}</li>)}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- AMELIORATIONS -->
    <section class="space-y-6">
      <h2 class="text-xl font-semibold text-neutral-900">Recommandations actionnables</h2>

      <div>
        <h3 class="text-base font-semibold text-red-700 mb-3">Corrections critiques</h3>
        <div class="space-y-4">
          {ameliorationsCritiques.map((a) => (
            <div class="bg-white border border-red-200 rounded-lg p-4">
              <p class="font-medium text-neutral-900 text-sm">{a.titre}</p>
              <p class="text-neutral-500 text-xs mt-1 mb-2">{a.detail}</p>
              <p class="text-xs text-red-700 bg-red-50 rounded px-2 py-1">Action : {a.action}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-base font-semibold text-amber-700 mb-3">Améliorations importantes</h3>
        <div class="space-y-4">
          {ameliorationsImportantes.map((a) => (
            <div class="bg-white border border-amber-200 rounded-lg p-4">
              <p class="font-medium text-neutral-900 text-sm">{a.titre}</p>
              <p class="text-neutral-500 text-xs mt-1 mb-2">{a.detail}</p>
              <p class="text-xs text-amber-700 bg-amber-50 rounded px-2 py-1">Action : {a.action}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-base font-semibold text-neutral-600 mb-3">Optimisations optionnelles</h3>
        <div class="space-y-3">
          {ameliorationsOptionnelles.map((a) => (
            <div class="bg-neutral-50 border border-neutral-200 rounded-lg p-3">
              <p class="font-medium text-neutral-800 text-sm">{a.titre}</p>
              <p class="text-neutral-500 text-xs mt-1">{a.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FOOTER AUDIT -->
    <footer class="border-t border-neutral-200 pt-8 text-center text-xs text-neutral-400 space-y-1">
      <p>Audit réalisé par <a href="/" class="underline">Marc M. Agence Web</a> · {prospect.date}</p>
      <p>Page confidentielle — usage interne uniquement</p>
    </footer>

  </div>
</BaseLayout>
