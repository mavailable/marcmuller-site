// ============================================================
// HELPERS
// ============================================================

function scoreColor(s: number): string {
  if (s >= 90) return '#22c55e';
  if (s >= 50) return '#f59e0b';
  return '#ef4444';
}

function decisionStyle(d: string): { border: string; bg: string; badge: string; badgeBg: string } {
  if (d === 'convertit') return { border: 'border-green-200', bg: 'bg-green-50/40', badge: 'Convertit', badgeBg: 'bg-green-100 text-green-800' };
  if (d === 'hesite') return { border: 'border-amber-200', bg: 'bg-amber-50/40', badge: 'Hésite', badgeBg: 'bg-amber-100 text-amber-800' };
  return { border: 'border-neutral-200', bg: 'bg-neutral-50/40', badge: 'Quitte', badgeBg: 'bg-red-100 text-red-700' };
}

const mobileScores = [
  { label: "Performance", score: pagespeed.mobile.performance },
  { label: "Accessibilité", score: pagespeed.mobile.accessibility },
  { label: "Bonnes Pratiques", score: pagespeed.mobile.bestPractices },
  { label: "SEO", score: pagespeed.mobile.seo },
];
