---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX — BS Peinture | Marc M';
const description = 'Simulation de 10 visites personas sur bs-peinture.com — rapport UX et technique avec recommandations priorisees.';

// ============================================================
// DONNEES PROSPECT
// ============================================================
const prospect = {
  name: 'BS Peinture',
  url: 'https://bs-peinture.com',
  date: '29 mars 2026',
  activity: 'Peintre en batiment / Decoration interieure / Ravalement de facade',
  location: 'Marly (57155) — Agglomeration de Metz, Moselle',
};

// ============================================================
// KPIs GLOBAUX
// ============================================================
const kpis = {
  conversion: 50,
  experience: 5.4,
  confiance: 6.0,
  clarte: 4.6,
  convertissent: 5,
  hesitent: 2,
  quittent: 3,
};

const constat = "Un artisan passionne avec 10 ans d'experience et 53 avis Google excellents, dont le site WordPress/Elementor souffre d'un SEO generique (meta description 'Entreprise generale de batiment'), d'aucun Schema.org LocalBusiness, d'aucune og:image et d'un grade de securite D-. La reputation client est solide, mais le site ne la met pas assez en valeur et reste invisible pour Google enrichi et les IA generatives.";

// ============================================================
// CONVERSION PAR CANAL
// ============================================================
const conversionByCanal = [
  { canal: 'Bouche-a-oreille', taux: 100, color: 'text-green-700', bg: 'bg-green-500' },
  { canal: 'Google Maps / GBP', taux: 100, color: 'text-green-700', bg: 'bg-green-500' },
  { canal: 'Google Search', taux: 50, color: 'text-amber-600', bg: 'bg-amber-400' },
  { canal: 'Reseaux sociaux', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'IA (ChatGPT/Claude)', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
];

// ============================================================
// TOP FRICTIONS
// ============================================================
const topFrictions = [
  { titre: 'Meta description generique : "Entreprise generale de batiment"', count: 8, detail: 'Le titre et la description ne mentionnent ni la peinture, ni Marly, ni Metz. Google affiche un resultat terne qui ne se demarque pas des concurrents dans les SERP.' },
  { titre: 'Aucun Schema.org LocalBusiness ni AggregateRating', count: 7, detail: '53 avis Google excellents mais aucune donnee structuree pour afficher les etoiles, l\'adresse et les horaires dans les resultats de recherche enrichis.' },
  { titre: 'Pas d\'og:image — partages sociaux sans vignette', count: 6, detail: 'Quand quelqu\'un partage le site sur Facebook, LinkedIn ou WhatsApp, aucune image n\'apparait. Le lien est invisible dans un fil d\'actualites.' },
  { titre: 'Aucun tarif indicatif ni mention "devis gratuit" visible', count: 6, detail: 'Les visiteurs sensibles au budget (primo-accedants, petits budgets) ne trouvent aucune indication de prix et quittent sans demander de devis.' },
  { titre: 'Grade de securite D- (Observatory 25/100)', count: 5, detail: 'Aucun header de securite (CSP, X-Frame-Options, HSTS). Risques de clickjacking et XSS, et signal negatif pour les pros qui verifient.' },
];

// ============================================================
// PAGESPEED (ESTIMES — profil WordPress/Elementor/WP Rocket)
// ============================================================
const pagespeed = {
  mobile: { performance: 55, accessibility: 72, bestPractices: 78, seo: 75 },
  desktop: { performance: 78, accessibility: 72, bestPractices: 78, seo: 75 },
};

const coreWebVitals = [
  { name: 'LCP', value: '~3.8s', status: 'mediocre' },
  { name: 'INP', value: '~280ms', status: 'mediocre' },
  { name: 'CLS', value: '~0.12', status: 'mediocre' },
];

const opportunities = [
  { label: 'Reduire le JavaScript inutilise (Elementor runtime)', saving: '~1.5s' },
  { label: 'Passer a un framework statique (contenu HTML natif, sans bloat Elementor)', saving: '~2.0s' },
  { label: 'Optimiser et convertir les images en WebP', saving: '~1.0s' },
];

// ============================================================
// OBSERVATORY
// ============================================================
const observatory = {
  grade: 'D-',
  score: 25,
  testsPassed: 5,
  testsTotal: 10,
};

// ============================================================
// CHECKLIST TECHNIQUE
// ============================================================
const techChecks = [
  { label: 'HTTPS actif', present: true },
  { label: 'HTTP/2', present: true },
  { label: 'robots.txt + sitemap.xml', present: true, note: 'robots.txt pointe vers sitemaps.xml (possible coquille)' },
  { label: 'Contenu visible dans le HTML source', present: true, note: 'WordPress SSR — bon point vs sites full JS' },
  { label: 'Bandeau cookies RGPD (Complianz)', present: true },
  { label: 'Mentions legales avec SIRET', present: true },
  { label: 'Widget avis Google (Trustindex)', present: true },
  { label: 'Blog actif (11 articles)', present: true },
  { label: 'Schema.org LocalBusiness', present: false, critical: true },
  { label: 'Schema.org AggregateRating', present: false, critical: true, note: '53 avis non structures' },
  { label: 'Open Graph og:image', present: false, critical: true, note: 'Partages sociaux sans vignette' },
  { label: 'Meta title optimise (mots-cles + ville)', present: false, critical: true, note: '"BS PEINTURE" — trop court' },
  { label: 'Meta description optimisee', present: false, critical: true, note: '"Entreprise generale de batiment" — generique' },
  { label: 'Content-Security-Policy', present: false, critical: true },
  { label: 'X-Frame-Options', present: false },
  { label: 'Referrer-Policy', present: false },
  { label: 'Strict-Transport-Security (HSTS)', present: false },
  { label: 'Assurance decennale mentionnee', present: false },
  { label: 'llms.txt (visibilite IA)', present: false },
