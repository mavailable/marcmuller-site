    detail: 'Seul marcm.fr est visible — un site d\'agence web solo. Nathalie, Kevin, Frederic, Luc et Patrick ne peuvent pas projeter leur cas dans cet unique exemple.',
    action: 'Lier vers un 2eme rapport dans un secteur different (restaurant, sante, commerce, gite rural). Ajouter dans la section demo : "Voir un rapport : Restaurant | Kiné" a cote du lien actuel.',
  },
];

const ameliorationsUtiles = [
  {
    titre: 'Mentionner le perimetre sectoriel et geographique',
    detail: 'Patrick, Aurore, Isabelle, Frederic et Laure se demandent si le service s\'applique a leur secteur ou a leur zone. Une simple ligne leve ce doute : "Artisans, commercants, pros de sante, hotels, associations, e-commerce — disponible partout en France."',
  },
  {
    titre: 'Clarifier la valeur des 5 visiteurs gratuits vs 20',
    detail: 'Sophie, Aurore et Thierry se demandent si le gratuit est suffisant. Repondre directement dans la section tarifs : "5 visiteurs : une tendance et 1 recommandation prioritaire. 20 visiteurs : des patterns clairs, 3+ ameliorations priorisees, taux de conversion par canal."',
  },
  {
    titre: 'Ajouter une FAQ "Comment je regle ?"',
    detail: 'La question du paiement est absente des 8 FAQ actuelles mais est la 1ere preoccupation de 6 personas. C\'est la 9eme question FAQ la plus evidente a ajouter.',
  },
  {
    titre: 'OG image specifique Echo (og-echo.png)',
    detail: 'L\'image OG actuelle est generique (og-default.png, identique a toutes les pages du site). Un partage LinkedIn de la page Echo affiche une preview indistinguable de n\'importe quelle autre page de marcm.fr.',
  },
  {
    titre: 'FAQPage Schema.org — 8 questions non exploitees',
    detail: '8 questions FAQ sont presentes en HTML (<details><summary>) mais aucune n\'est declaree en JSON-LD. Google affiche les FAQPage en rich results (accordeons directs dans les SERP) — opportunite de visibilite gratuite immediatement exploitable.',
  },
];

const ameliorationsDiscuter = [
  { emoji: '🤝', titre: 'Offre agence / revendeur', detail: 'Kevin et Julien veulent revendre ou recommander le service a leurs clients. Une mention discrète "Vous etes une agence ?" + email de contact pourrait ouvrir un canal B2B non prevu actuellement.' },
  { emoji: '🎬', titre: 'Video demonstration 30 secondes', detail: 'Dylan et Jerome ont quitte sans lire. Une video screencast montrant un rapport en action convertirait les profils visuels (Instagram, jeunes createurs). Effort de production a evaluer.' },
  { emoji: '📍', titre: 'Repositionner l\'upsell creation de site', detail: 'L\'upsell en bas de page distrait Sophie (hesite audit vs refonte) et genere de la mefiance pour Julien (concurrent potentiel). Option : le deplacer en modal post-conversion ou remplacer par une FAQ question.' },
];
---

<BaseLayout
  title={`Audit UX — Landing page Echo | marcm.fr`}
  description="Rapport confidentiel : simulation de 20 visites personas + audit technique de la landing page marcm.fr/echo/"
  lang="fr"
  frPath={`/audit/${slug}`}
  noindex={true}
>

  <!-- ═══ HERO ═══ -->
  <section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
    <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2); color: #ef4444;">
        Rapport confidentiel
      </div>
      <h1 class="mb-4 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
        Audit UX + Technique<br/>
        <span style="color: var(--color-accent);">Landing page Écho — marcm.fr/echo/</span>
      </h1>
      <p class="mb-8 text-sm md:text-base" style="color: rgba(255,255,255,0.45);">
        Page testee : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} personas simulees · {dateAudit}
      </p>
      <div class="flex flex-wrap gap-2">
        {[`${kpis.nbPersonas} personas`, '7 canaux', 'Observatory B/75', 'FAQPage Schema manquant'].map(tag => (
          <span class="text-[11px] px-2.5 py-1 rounded-full" style="background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.4); border: 1px solid rgba(255,255,255,0.08);">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ TAB BAR ═══ -->
  <nav class="sticky top-16 md:top-20 z-40 bg-white/95 backdrop-blur border-b border-neutral-200" id="tab-bar">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-1 h-12 text-sm overflow-x-auto">
      <button data-tab="0" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-primary-700 bg-primary-50">Synthese</button>
      <button data-tab="1" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">Technique</button>
      <button data-tab="2" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">
        Visiteurs <span class="ml-1 text-xs text-neutral-400">{kpis.nbPersonas}</span>
      </button>
      <button data-tab="3" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">
        Ameliorations <span class="ml-1 text-xs text-neutral-400">{ameliorationsHautes.length + ameliorationsUtiles.length}</span>
      </button>
    </div>
  </nav>

  <!-- ═══ PANELS ═══ -->
  <div id="panels" class="flex overflow-x-auto snap-x snap-mandatory" style="-webkit-overflow-scrolling: touch; scrollbar-width: none;">

    <!-- PANEL 1 : SYNTHESE -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

        <!-- KPI cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
          <div class="bg-white border border-neutral-200 rounded-xl p-5 text-center">
            <div class="text-3xl font-bold mb-1" style="color: var(--color-accent);">{kpis.conversion}%</div>
            <div class="text-xs text-neutral-500">Taux de conversion</div>
          </div>
          <div class="bg-white border border-neutral-200 rounded-xl p-5 text-center">
            <div class="text-3xl font-bold text-neutral-800 mb-1">{kpis.experience}</div>
            <div class="text-xs text-neutral-500">Experience /10</div>
          </div>
          <div class="bg-white border border-neutral-200 rounded-xl p-5 text-center">
            <div class="text-3xl font-bold text-neutral-800 mb-1">{kpis.confiance}</div>
            <div class="text-xs text-neutral-500">Confiance /10</div>
          </div>
          <div class="bg-white border border-neutral-200 rounded-xl p-5 text-center">
            <div class="text-3xl font-bold text-neutral-800 mb-1">{kpis.clarte}</div>
            <div class="text-xs text-neutral-500">Clarte /10</div>
          </div>
        </div>

        <!-- Paradoxe -->
        <div class="rounded-xl p-5 mb-10 border-l-4" style="background: rgba(232,108,71,0.04); border-color: var(--color-accent);">
          <p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color: var(--color-accent);">Paradoxe principal</p>
          <p class="text-sm text-neutral-700">La page convertit le mieux les personnes qui n'en ont pas besoin (clients existants) et perd celles qui pourraient en profiter le plus (prospects froids en decouverte). Le manque de signaux de confiance humaine (photo, temoignages, telephone) est le frein dominant.</p>
        </div>

        <!-- Par canal -->
        <h2 class="text-lg font-bold text-neutral-900 mb-4">Conversion par canal</h2>
        <div class="space-y-3 mb-10">
          {canalData.map(c => (
            <div>
              <div class="flex items-center justify-between text-sm mb-1">
                <span class="text-neutral-700">{c.canal}</span>
                <span class="font-semibold" style={`color: ${c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444'}`}>{c.rate}%</span>
              </div>
              <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
                <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444'}`}></div>
              </div>
            </div>
          ))}
        </div>

        <!-- Par maturite -->
        <h2 class="text-lg font-bold text-neutral-900 mb-4">Conversion par maturite</h2>
        <div class="grid grid-cols-3 gap-4 mb-10">
          {maturiteData.map(m => (
            <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
              <div class="text-xl font-bold mb-1" style={`color: ${m.rate >= 50 ? '#22c55e' : m.rate >= 25 ? '#f59e0b' : '#6b7280'}`}>{m.rate}%</div>
              <div class="text-sm font-semibold text-neutral-800 mb-2">{m.label}</div>
              <div class="text-xs text-neutral-500">{m.total} personas</div>
              <div class="mt-2 flex justify-center gap-1">
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-green-100 text-green-700">{m.convert} ✓</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-700">{m.hesite} ~</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-neutral-100 text-neutral-500">{m.quitte} ✗</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Par device -->
        <h2 class="text-lg font-bold text-neutral-900 mb-4">Conversion par device</h2>
        <div class="grid grid-cols-3 gap-4">
          {deviceData.map(d => (
            <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
              <div class="text-xl font-bold mb-1" style={`color: ${d.rate >= 40 ? '#22c55e' : d.rate >= 20 ? '#f59e0b' : '#6b7280'}`}>{d.rate}%</div>
              <div class="text-sm font-semibold text-neutral-800 mb-1">{d.device}</div>
              <div class="text-xs text-neutral-500">{d.total} personas</div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- PANEL 2 : TECHNIQUE -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

        <!-- PageSpeed -->
        <h2 class="text-lg font-bold text-neutral-900 mb-4">PageSpeed Insights</h2>
        <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-5 mb-8">
          <p class="text-sm text-neutral-600 mb-2">
            <strong>Quota journalier epuise</strong> lors de l'audit (erreur 429 — limite de requetes par jour atteinte).
          </p>
          <p class="text-sm text-neutral-500">
            Verifier manuellement : <a href={`https://pagespeed.web.dev/report?url=${urlSite}`} target="_blank" class="underline hover:text-neutral-700 transition-colors">pagespeed.web.dev/report?url={urlSite}</a>
          </p>
          <p class="text-xs text-neutral-400 mt-2">Note : le site est Astro statique sur Cloudflare Pages (sans images), probablement excellent en desktop. LCP mobile estime a 2-3s sur la base des audits precedents du site principal.</p>
        </div>

        <!-- Observatory -->
        <h2 class="text-lg font-bold text-neutral-900 mb-4">Securite HTTP — Mozilla Observatory</h2>
        <div class="flex items-center gap-4 p-4 rounded-xl border border-amber-200 bg-amber-50 mb-4">
          <div class="text-4xl font-black text-amber-600">B</div>
          <div>
            <p class="text-sm font-semibold text-neutral-900">Securite correcte mais ameliorable</p>
            <p class="text-xs text-neutral-500">{tech.observatory.testsOk}/{tech.observatory.testsTotal} tests passes — Score {tech.observatory.score}/100</p>
          </div>
        </div>
        <div class="bg-white border border-neutral-200 rounded-xl p-4 mb-8">
          <p class="text-xs font-semibold text-neutral-700 mb-3">Headers de securite</p>
          {[
            { ok: true, h: 'Strict-Transport-Security (HSTS + preload)' },
            { ok: true, h: 'X-Content-Type-Options: nosniff' },
            { ok: true, h: 'X-Frame-Options: DENY' },
            { ok: true, h: 'Referrer-Policy' },
            { ok: true, h: 'Permissions-Policy' },
            { ok: false, h: 'Content-Security-Policy — ABSENT (cause du test echoue)' },
          ].map(h => (
            <div class="flex items-center gap-2 py-1">
              {h.ok
                ? <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                : <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              }
              <span class={`text-xs ${h.ok ? 'text-neutral-700' : 'text-red-500'}`}>{h.h}</span>
            </div>
          ))}
        </div>

        <!-- Schema.org -->
        <h2 class="text-lg font-bold text-neutral-900 mb-4">Schema.org</h2>
        <div class="bg-white border border-neutral-200 rounded-xl p-4 mb-8">
          {tech.schema.map(s => (
            <div class="flex items-center gap-2 py-1.5">
              {s.ok
                ? <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                : <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              }
              <span class={`text-sm ${s.ok ? 'text-neutral-700' : 'text-red-500 font-medium'}`}>{s.item}</span>
            </div>
          ))}
          <div class="mt-3 pt-3 border-t border-neutral-100">
            <p class="text-xs text-amber-700 bg-amber-50 rounded px-3 py-2">
              <strong>Opportunite critique :</strong> 8 questions FAQ presentes en HTML (<code>&lt;details&gt;&lt;summary&gt;</code>) mais aucune declaree en JSON-LD FAQPage. Google affiche ces schemas en accordeons directs dans les SERP.
            </p>
          </div>
        </div>

        <!-- OG + Twitter -->
        <h2 class="text-lg font-bold text-neutral-900 mb-4">Open Graph + Twitter Card</h2>
        <div class="bg-white border border-neutral-200 rounded-xl p-4 mb-8">
          {tech.og.map(o => (
            <div class="flex items-start gap-2 py-1.5">
              {o.ok
                ? <svg class="w-4 h-4 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                : <svg class="w-4 h-4 text-amber-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
              }
              <div>
                <span class={`text-sm ${o.ok ? 'text-neutral-700' : 'text-neutral-500'}`}>{o.item}</span>
                <span class="text-xs text-neutral-400 ml-2">{o.val}</span>
              </div>
            </div>
          ))}
          <div class="mt-3 pt-3 border-t border-neutral-100">
            <p class="text-xs text-neutral-500">Image OG generique (og-default.png) : partage LinkedIn/Twitter = preview identique a toutes les autres pages du site. Creer <code>og-echo.png</code> (1200x630px) avec l'identite visuelle Echo.</p>
          </div>
        </div>

        <!-- SEO Technique -->
        <h2 class="text-lg font-bold text-neutral-900 mb-4">SEO Technique</h2>
        <div class="bg-white border border-neutral-200 rounded-xl p-4">
          {tech.seo.map(s => (
            <div class="flex items-center gap-2 py-1.5">
              {s.ok
                ? <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                : <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              }
              <span class={`text-sm ${s.ok ? 'text-neutral-700' : 'text-red-500'}`}>{s.item}</span>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- PANEL 3 : VISITEURS -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

        <!-- Stats row -->
        <div class="grid grid-cols-3 gap-4 mb-10">
          <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-green-700 mb-1">{kpis.nbConvertissent}</div>
            <div class="text-xs text-green-600">Contactent</div>
          </div>
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-amber-700 mb-1">{kpis.nbHesitent}</div>
            <div class="text-xs text-amber-600">Hesitent</div>
          </div>
          <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-neutral-600 mb-1">{kpis.nbRepartent}</div>
            <div class="text-xs text-neutral-500">Repartent</div>
          </div>
        </div>

        <!-- Section verte : convertissent -->
        <h2 class="text-base font-bold text-green-800 mb-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>
          Ceux qui contactent
        </h2>
        <div class="space-y-2 mb-8">
          {personas.filter(p => p.decision === 'Convertit').map(p => (
            <details class="group border border-green-200 bg-green-50/40 rounded-xl overflow-hidden">
              <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                    <h3 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h3>
                    <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                    <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  </div>
                  <p class="text-xs text-neutral-500 mb-1">{p.situation}</p>
                  <div class="flex flex-wrap items-center gap-1 mt-1">
                    <span class="text-[10px] text-neutral-500 bg-white border border-neutral-200 px-1.5 py-0.5 rounded">{p.maturite}</span>
                    <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                  </div>
                </div>
                <svg class="w-5 h-5 text-neutral-400 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="px-4 pb-4 pt-0 border-t border-green-200 bg-white/60">
                <div class="grid gap-3 text-xs mt-3">
                  <div><p class="font-semibold text-neutral-700 mb-1">Premiere impression</p><p class="text-neutral-600">{p.impression}</p></div>
                  <div>
                    <p class="font-semibold text-neutral-700 mb-1">Parcours</p>
                    <ol class="list-decimal list-inside space-y-1 text-neutral-600">
                      {p.parcours.map(([section, reaction]) => <li><strong>{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>)}
                    </ol>
                  </div>
                  <div><p class="font-semibold text-neutral-700 mb-1">Question cle</p><p class="text-neutral-600 italic">"{p.questionCle}"</p><p class="text-neutral-600 mt-1">Reponse du site : <strong>{p.reponse}</strong> — {p.commentReponse}</p></div>
                  <div>
                    <p class="font-semibold text-neutral-700 mb-1">Impact technique</p>
                    <p class="text-neutral-600">Vitesse : {p.impactVitesse}</p>
                    <p class="text-neutral-600 mt-0.5">Confiance : {p.impactConfiance}</p>
                  </div>
                  <div class="flex gap-4">
                    <div class="flex-1"><p class="font-semibold text-green-700 mb-1">Points positifs</p><ul class="list-disc list-inside text-neutral-600 space-y-0.5">{p.positifs.map(pt => <li>{pt}</li>)}</ul></div>
                    <div class="flex-1"><p class="font-semibold text-amber-700 mb-1">Frictions</p><ul class="list-disc list-inside text-neutral-600 space-y-0.5">{p.frictions.map(f => <li>{f}</li>)}</ul></div>
                  </div>
                  <div class="pt-2 border-t border-neutral-200">
                    <p class="font-semibold text-neutral-700 mb-1">Decision</p>
                    <p class="text-neutral-600">{p.raisonDecision}</p>
                    {p.ceQuiFeraitBasculer && <p class="text-neutral-500 mt-1 italic">Pour aller plus vite : {p.ceQuiFeraitBasculer}</p>}
                  </div>
                  <div class="flex gap-6 pt-2 border-t border-neutral-200">
                    <div class="text-center"><span class="block text-lg font-bold text-green-600">{p.exp}</span><span class="text-[10px] text-neutral-500">Experience</span></div>
                    <div class="text-center"><span class="block text-lg font-bold text-green-600">{p.conf}</span><span class="text-[10px] text-neutral-500">Confiance</span></div>
                    <div class="text-center"><span class="block text-lg font-bold text-green-600">{p.clarte}</span><span class="text-[10px] text-neutral-500">Clarte</span></div>
                  </div>
                </div>
              </div>
            </details>
          ))}
        </div>

        <!-- Section ambre : hesitent -->
        <h2 class="text-base font-bold text-amber-800 mb-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span>
          Ceux qui hesitent
        </h2>
        <div class="space-y-2 mb-8">
          {personas.filter(p => p.decision === 'Hesite').map(p => (
            <details class="group border border-amber-200 bg-amber-50/30 rounded-xl overflow-hidden">
              <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5 flex-wrap">
