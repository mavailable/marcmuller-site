          {[
            { label: 'Fondée', value: '1927', sub: 'Près de 100 ans' },
            { label: 'Effectif', value: '60+', sub: 'Spécialistes menuisiers' },
            { label: 'Atelier', value: '4 300 m²', sub: 'Parc machines CN' },
            { label: 'Avis Google', value: '4,7/5', sub: '38 avis vérifiés' },
