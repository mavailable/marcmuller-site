        <div>
          <p class="text-xs text-neutral-500 uppercase tracking-widest mb-1">Rapport confidentiel — Web Factory</p>
          <h1 class="text-xl font-bold text-white">Audit Prospect : Menuiserie KELLER</h1>
          <p class="text-sm text-neutral-400 mt-1">menuiseriekeller.com — Menuisier, Houdemont 54 — 38 avis · 4,7/5</p>
        </div>
        <div class="text-right hidden md:block">
          <p class="text-xs text-neutral-500">Score actuel estimé</p>
          <p class="text-4xl font-black text-amber-400">{scoreGlobal}<span class="text-xl text-neutral-500">/100</span></p>
          <p class="text-xs text-neutral-500 mt-1">Site sous-performant en 2026</p>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 py-8 space-y-10">

      <!-- RÉSUMÉ ENTREPRISE -->
