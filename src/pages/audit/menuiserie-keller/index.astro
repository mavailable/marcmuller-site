            <div class="bg-neutral-800 rounded-xl p-4 text-center">
              <p class="text-xs text-neutral-500 mb-1">{s.label}</p>
              <p class="text-2xl font-black text-white">{s.value}</p>
              <p class="text-xs text-neutral-400 mt-1">{s.sub}</p>
            </div>
          ))}
        </div>
        <div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
          {[
            { label: 'Type client WF', value: 'entreprise-locale' },
            { label: 'Localisation', value: '12 Allée des Peupliers, 54180 Houdemont' },
            { label: 'Téléphone', value: '03 83 44 62 00' },
            { label: 'Réalisation web', value: 'NANCOMCY (Nancy)' },
          ].map(i => (
            <div>
              <p class="text-neutral-500 text-xs">{i.label}</p>
              <p class="text-white font-medium">{i.value}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- AUDIT TECHNIQUE -->
      <section class="bg-neutral-900 rounded-2xl p-6 border border-neutral-800">
        <h2 class="text-lg font-bold text-white mb-5">Audit Technique</h2>

        <!-- Scores -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
          <div class="bg-neutral-800 rounded-xl p-4">
            <p class="text-xs text-neutral-500 mb-2">Mozilla Observatory</p>
            <p class="text-4xl font-black text-amber-400">{auditTech.observatory.grade}</p>
            <p class="text-sm text-neutral-400">{auditTech.observatory.score}/100 — {auditTech.observatory.testsFailed} tests échoués</p>
          </div>
          <div class="bg-neutral-800 rounded-xl p-4">
            <p class="text-xs text-neutral-500 mb-2">PageSpeed Mobile (estimé)</p>
            <p class="text-4xl font-black text-red-400">{auditTech.psi_mobile.perf}</p>
            <p class="text-sm text-neutral-400">WordPress + Divi = handicap structurel</p>
          </div>
          <div class="bg-neutral-800 rounded-xl p-4">
            <p class="text-xs text-neutral-500 mb-2">PageSpeed Desktop (estimé)</p>
            <p class="text-4xl font-black text-amber-400">{auditTech.psi_desktop.perf}</p>
            <p class="text-sm text-neutral-400">Serveur nginx + Varnish rapide (TTFB 80ms)</p>
          </div>
        </div>

        <!-- Problèmes critiques -->
        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <div>
            <h3 class="text-sm font-semibold text-red-400 mb-3">Problèmes critiques</h3>
            <ul class="space-y-2">
              {[
                'HTML 506 KB (WordPress + Divi bloat)',
                '15 fichiers JS potentiellement bloquants',
                'user-scalable=0 dans viewport (accessibilité mobile)',
                'Google Fonts CDN — violation RGPD',
                'Pas de LocalBusiness Schema.org',
                'OG image absente — partage réseaux dégradé',
                'xmlrpc.php exposé (vecteur attaque WP)',
              ].map(item => (
                <li class="flex items-start gap-2 text-sm">
                  <span class="text-red-400 mt-0.5 shrink-0">✗</span>
                  <span class="text-neutral-300">{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-green-400 mb-3">Points positifs</h3>
            <ul class="space-y-2">
              {[
                'TTFB 80ms (nginx + Varnish excellent)',
                'HSTS configuré (max-age=1 an)',
                'X-Frame-Options + X-Content-Type-Options',
                'Canonical + robots meta corrects',
                'Sitemap XML présent (Yoast)',
                'robots.txt correct',
                'HTTPS enforced',
              ].map(item => (
                <li class="flex items-start gap-2 text-sm">
                  <span class="text-green-400 mt-0.5 shrink-0">✓</span>
                  <span class="text-neutral-300">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Schema & OG -->
        <div class="grid md:grid-cols-2 gap-4">
          <div class="bg-neutral-800 rounded-xl p-4">
            <h3 class="text-sm font-semibold text-white mb-3">Schema.org</h3>
            <p class="text-xs text-green-400 mb-1">Présents : {auditTech.schema.types.join(', ')}</p>
            <p class="text-xs text-red-400">Manquants : {auditTech.schema.missing.join(', ')}</p>
            <p class="text-xs text-neutral-500 mt-2">Yoast génère uniquement WebPage/WebSite par défaut. Pas de LocalBusiness = SEO local manqué.</p>
          </div>
          <div class="bg-neutral-800 rounded-xl p-4">
            <h3 class="text-sm font-semibold text-white mb-3">Open Graph</h3>
            {[
              { tag: 'og:title', ok: auditTech.og.title },
              { tag: 'og:description', ok: auditTech.og.description },
              { tag: 'og:image', ok: auditTech.og.image },
              { tag: 'og:url', ok: auditTech.og.url },
            ].map(o => (
              <div class="flex items-center gap-2 text-xs mb-1">
                <span class={o.ok ? 'text-green-400' : 'text-red-400'}>{o.ok ? '✓' : '✗'}</span>
                <span class={o.ok ? 'text-neutral-300' : 'text-red-300 font-semibold'}>{o.tag}</span>
                {!o.ok && <span class="text-red-400">(partage sans visuel !)</span>}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- RÉSUMÉ PERSONAS -->
      <section class="bg-neutral-900 rounded-2xl p-6 border border-neutral-800">
        <h2 class="text-lg font-bold text-white mb-5">10 Personas — Simulation de visites</h2>

        <!-- Stats globales -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
          <div class="bg-green-900/40 border border-green-800 rounded-xl p-4 text-center">
            <p class="text-xs text-green-400 mb-1">Convertis</p>
            <p class="text-3xl font-black text-green-400">{convertis}</p>
          </div>
          <div class="bg-amber-900/40 border border-amber-800 rounded-xl p-4 text-center">
            <p class="text-xs text-amber-400 mb-1">Hésitants</p>
            <p class="text-3xl font-black text-amber-400">{hesitants}</p>
          </div>
          <div class="bg-red-900/40 border border-red-800 rounded-xl p-4 text-center">
            <p class="text-xs text-red-400 mb-1">Quittent</p>
            <p class="text-3xl font-black text-red-400">{quittent}</p>
          </div>
          <div class="bg-neutral-800 rounded-xl p-4 text-center">
            <p class="text-xs text-neutral-500 mb-1">Taux conversion simulé</p>
            <p class="text-3xl font-black text-white">{tauxConversion}%</p>
          </div>
          <div class="bg-neutral-800 rounded-xl p-4 text-center">
            <p class="text-xs text-neutral-500 mb-1">Clarté moy.</p>
            <p class="text-3xl font-black text-white">{avgClarte}<span class="text-base text-neutral-500">/10</span></p>
          </div>
        </div>

        <!-- Insight clé -->
        <div class="bg-blue-900/30 border border-blue-800 rounded-xl p-4 mb-6">
          <p class="text-sm text-blue-300 font-semibold mb-1">Insight principal</p>
          <p class="text-sm text-neutral-300">KELLER convertit quasi-exclusivement les personas déjà recommandés (bouche-à-oreille, email interne) ou ayant une référence directe dans les réalisations (Lidl, CPN). Les visiteurs en phase de découverte ou comparaison quittent faute de prix, de galerie exploitable et de certifications lisibles.</p>
        </div>

        <!-- Cartes personas -->
        <div class="grid md:grid-cols-2 gap-4">
          {personas.map(p => {
            const decisionColor = p.decision === 'Convertit' ? 'border-green-700 bg-green-900/20' : p.decision === 'Hesite' ? 'border-amber-700 bg-amber-900/20' : 'border-red-700 bg-red-900/20';
            const decisionLabel = p.decision === 'Convertit' ? '✓ Convertit' : p.decision === 'Hesite' ? '~ Hésite' : '✗ Quitte';
            const decisionTextColor = p.decision === 'Convertit' ? 'text-green-400' : p.decision === 'Hesite' ? 'text-amber-400' : 'text-red-400';
            return (
              <div class={`rounded-xl p-5 border ${decisionColor}`}>
                <div class="flex items-start justify-between mb-3">
                  <div class="flex items-center gap-3">
                    <span class="text-2xl">{p.emoji}</span>
                    <div>
                      <p class="font-bold text-white">{p.name}, {p.age} ans</p>
                      <p class="text-xs text-neutral-400">{p.situation}</p>
                    </div>
                  </div>
                  <span class={`text-sm font-bold ${decisionTextColor}`}>{decisionLabel}</span>
                </div>

                <div class="grid grid-cols-3 gap-2 mb-3 text-xs">
                  <div class="bg-neutral-800/60 rounded-lg p-2 text-center">
                    <p class="text-neutral-500">Canal</p>
                    <p class="text-white font-medium truncate">{p.canal}</p>
                  </div>
                  <div class="bg-neutral-800/60 rounded-lg p-2 text-center">
                    <p class="text-neutral-500">Maturité</p>
                    <p class="text-white font-medium">{p.maturite}</p>
                  </div>
                  <div class="bg-neutral-800/60 rounded-lg p-2 text-center">
                    <p class="text-neutral-500">Device</p>
                    <p class="text-white font-medium">{p.device}</p>
                  </div>
                </div>

                <div class="mb-3">
                  <p class="text-xs text-neutral-500 mb-1">Contexte</p>
                  <p class="text-xs text-neutral-300">{p.contexte}</p>
                </div>

                <div class="mb-3">
                  <p class="text-xs text-neutral-500 mb-1">Question clé</p>
                  <p class="text-xs text-white italic">"{p.question}"</p>
                  <p class="text-xs mt-1">
                    <span class={`font-semibold ${p.reponse === 'Oui' ? 'text-green-400' : p.reponse === 'Non' ? 'text-red-400' : 'text-amber-400'}`}>Réponse trouvée : {p.reponse}</span>
                    {' — '}<span class="text-neutral-400">{p.commentReponse}</span>
                  </p>
                </div>

                <div class="mb-3">
                  <p class="text-xs text-neutral-500 mb-1">Parcours</p>
                  <ol class="space-y-1">
                    {p.parcours.map((step, i) => (
                      <li class="text-xs flex gap-2">
                        <span class="text-neutral-600 shrink-0">{i + 1}.</span>
                        <span>
                          <span class="text-neutral-300 font-medium">{step[0]}</span>
                          <span class="text-neutral-500"> — {step[1]}</span>
                        </span>
                      </li>
                    ))}
                  </ol>
                </div>

                <div class="grid grid-cols-2 gap-2 mb-3">
                  <div>
                    <p class="text-xs text-green-400 mb-1">Points positifs</p>
                    <ul class="space-y-1">
                      {p.positifs.map(pos => (
                        <li class="text-xs text-neutral-300 flex gap-1"><span class="text-green-500 shrink-0">+</span>{pos}</li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <p class="text-xs text-red-400 mb-1">Frictions</p>
                    <ul class="space-y-1">
                      {p.frictions.map(fric => (
                        <li class="text-xs text-neutral-300 flex gap-1"><span class="text-red-500 shrink-0">−</span>{fric}</li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="bg-neutral-800/60 rounded-lg p-2">
                  <p class="text-xs text-neutral-500">Ce qui changerait tout</p>
                  <p class="text-xs text-white">{p.changement}</p>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- SYNTHÈSE OPPORTUNITÉ -->
      <section class="bg-neutral-900 rounded-2xl p-6 border border-neutral-800">
        <h2 class="text-lg font-bold text-white mb-5">Opportunité Web Factory</h2>

        <div class="grid md:grid-cols-3 gap-4 mb-6">
          <div class="bg-neutral-800 rounded-xl p-4 md:col-span-2">
            <h3 class="text-sm font-semibold text-white mb-3">L'angle de pitch</h3>
            <p class="text-sm text-neutral-300 leading-relaxed">
              KELLER a un positionnement B2B premium exceptionnel — CHU, Sheraton, Lidl, écoles — mais un site WordPress/Divi de 2023 qui ne le valorise pas. Le gap entre la réalité de l'entreprise (100 ans, 60 personnes, CFAO, 4 300 m²) et sa présentation web est béant. C'est une opportunité directe : un site Astro v5 statique, ultra-rapide, qui met enfin en valeur ce centenaire de la menuiserie Grand-Est.
            </p>
