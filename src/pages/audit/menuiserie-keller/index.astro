                'Déploiement Cloudflare Pages (CDN mondial)',
              ].map(item => (
                <li class="flex items-start gap-2 text-sm">
                  <span class="text-green-400 mt-0.5 shrink-0">→</span>
                  <span class="text-neutral-300">{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-amber-400 mb-3">Frictions actuelles à éliminer</h3>
            <ul class="space-y-2">
              {[
                'WordPress + Divi — bloat 506 KB HTML',
                'Google Fonts CDN — RGPD non conforme',
                'xmlrpc.php exposé — vecteur attaque WP',
                'user-scalable=0 — accessibilité mobile dégradée',
                'Schema.org générique Yoast — SEO local manqué',
                'OG image absente — partage sans visuel',
                'Galeries sans légendes — projets inexploitables',
                'Formulaire générique — pas qualifiant',
                'Pas d\'horaires — appels à l\'aveugle',
                'CSP manquante — risque XSS',
              ].map(item => (
                <li class="flex items-start gap-2 text-sm">
                  <span class="text-amber-400 mt-0.5 shrink-0">✗</span>
                  <span class="text-neutral-300">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- FOOTER -->
      <footer class="text-center text-xs text-neutral-600 pb-8">
        <p>Rapport confidentiel — Web Factory by Marc M — {new Date().toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        <p class="mt-1">Page noindex — usage interne uniquement</p>
      </footer>

    </div>
  </div>
