            <p class="text-3xl font-black text-white mb-1">1 490 – 1 990€</p>
            <p class="text-xs text-neutral-400">Entreprise > artisan solo<br/>Références premium<br/>Déploiement 7 jours</p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <h3 class="text-sm font-semibold text-green-400 mb-3">Ce qu'on apporte</h3>
            <ul class="space-y-2">
              {[
                'Performance Astro v5 statique — PageSpeed 90+',
                'LocalBusiness Schema.org complet (adresse, tél, horaires, avis)',
                'OG image pour partage réseaux sociaux',
                'Polices locales woff2 — RGPD confiant',
                'Headers sécurité complets (CSP, Permissions-Policy)',
                'Galerie avec légendes, filtres par secteur',
