---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX — Antonicelli Peinture | Marc M';
const description = 'Simulation de 10 visites personas sur antonicelli-peinture.fr — rapport UX et technique avec recommandations priorisees.';

// ============================================================
// DONNEES PROSPECT
// ============================================================
const prospect = {
  name: 'Antonicelli Peinture',
  url: 'https://www.antonicelli-peinture.fr',
  date: '29 mars 2026',
  activity: 'Peintre en batiment — Peinture, Facade, Sols, Platrerie',
  location: 'Metz (57050) + Dudelange (Luxembourg) — Grand Est',
};

// ============================================================
// KPIs GLOBAUX
// ============================================================
const kpis = {
  conversion: 40,
  experience: 5.3,
  confiance: 5.8,
  clarte: 4.8,
  convertissent: 4,
  hesitent: 3,
  quittent: 3,
};

const constat = "Une entreprise familiale serieuse avec 45 ans d'experience, 25+ salaries et le label RGE — mais un site WordPress/Divi lent, sans temoignages, sans tarifs indicatifs, sans Schema.org LocalBusiness, et avec des mentions legales obsoletes. La credibilite hors-ligne est solide, mais le site ne la transmet pas : les visiteurs doivent deviner ce que l'entreprise vaut.";

// ============================================================
// CONVERSION PAR CANAL
// ============================================================
const conversionByCanal = [
  { canal: 'Bouche-a-oreille', taux: 100, color: 'text-green-700', bg: 'bg-green-500' },
  { canal: 'Google Maps / GBP', taux: 50, color: 'text-amber-600', bg: 'bg-amber-400' },
  { canal: 'Google Search', taux: 33, color: 'text-amber-600', bg: 'bg-amber-400' },
  { canal: 'Reseaux sociaux', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'IA (ChatGPT/Claude)', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
];

// ============================================================
// TOP FRICTIONS
// ============================================================
const topFrictions = [
  { titre: 'Aucun temoignage client visible sur le site', count: 8, detail: 'Les visiteurs ne trouvent aucune preuve sociale directe. Pas d\'avis Google integres, pas de temoignages, pas de note — ils doivent quitter le site pour aller verifier sur Google Maps.' },
  { titre: 'Pas de tarifs indicatifs ni fourchettes de prix', count: 7, detail: 'Les particuliers comme les professionnels veulent estimer un budget avant de contacter. L\'absence totale de prix incite a chercher un concurrent plus transparent.' },
  { titre: 'Site lent sur mobile (Divi lourd + Google Fonts CDN)', count: 6, detail: 'Le theme Divi genere un HTML tres lourd avec du CSS inline massif. Les polices chargees depuis Google Fonts CDN ajoutent du delai et posent un probleme RGPD.' },
  { titre: 'Mentions legales obsoletes (directeur = Mario, pas Thomas)', count: 5, detail: 'Thomas dirige l\'entreprise depuis 2 ans mais les mentions legales indiquent toujours Mario. Signal de negligence et non-conformite legale.' },
  { titre: 'Aucun Schema.org LocalBusiness — invisible pour Google enrichi', count: 5, detail: 'Google ne peut pas afficher adresse, telephone, horaires ou zone d\'intervention dans ses resultats. Perte de visibilite significative pour un artisan local.' },
];

// ============================================================
// PAGESPEED (ESTIMES — profil WordPress Divi + WP Rocket)
// ============================================================
const pagespeed = {
  mobile: { performance: 45, accessibility: 78, bestPractices: 72, seo: 82 },
  desktop: { performance: 72, accessibility: 78, bestPractices: 72, seo: 82 },
};

const coreWebVitals = [
  { name: 'LCP', value: '~4.5s', status: 'bad' },
  { name: 'INP', value: '~320ms', status: 'bad' },
  { name: 'CLS', value: '~0.12', status: 'bad' },
];

const opportunities = [
  { label: 'Reduire le CSS/JS inutilise (Divi charge ~2 Mo de resources)', saving: '~2.0s' },
  { label: 'Heberger les polices localement au lieu de Google Fonts CDN', saving: '~0.8s' },
  { label: 'Mettre a jour PHP 7.4 (obsolete) vers 8.2+', saving: '~0.5s' },
];

// ============================================================
// OBSERVATORY
// ============================================================
const observatory = {
  grade: 'D-',
  score: 25,
  testsPassed: 5,
  testsTotal: 10,
};

// ============================================================
// CHECKLIST TECHNIQUE
// ============================================================
const techChecks = [
  { label: 'HTTPS actif (redirection 301)', present: true },
  { label: 'robots.txt + sitemap.xml (Yoast)', present: true },
  { label: 'Alt text sur toutes les images (14/14)', present: true },
  { label: 'H1 unique par page', present: true },
  { label: 'Bandeau cookies RGPD', present: true },
  { label: 'HTTP/2 actif (OVH)', present: true },
  { label: 'Meta description page d\'accueil', present: false, critical: true, note: 'Totalement absente — Google genere un extrait aleatoire' },
  { label: 'Schema.org LocalBusiness', present: false, critical: true, note: 'Seuls WebPage et BreadcrumbList (generique Yoast)' },
  { label: 'Open Graph description', present: false, critical: true, note: 'Absente sur accueil, contact et devis' },
  { label: 'HSTS (Strict-Transport-Security)', present: false, critical: true },
  { label: 'Content-Security-Policy', present: false, critical: true },
  { label: 'X-Frame-Options', present: false },
  { label: 'Referrer-Policy / Permissions-Policy', present: false },
  { label: 'Google Fonts hebergees localement (RGPD)', present: false, critical: true, note: 'Polices chargees depuis fonts.googleapis.com' },
  { label: 'Mentions legales a jour', present: false, critical: true, note: 'Directeur = Mario au lieu de Thomas, email obsolete' },
  { label: 'llms.txt pour IA generatives', present: false },
];

// ============================================================
// PERSONAS (10)
// ============================================================
const personas = [
  {
    id: 1, name: 'Christelle', age: 41, emoji: '\u{1F3E0}',
    canal: 'Google Search', device: 'Mobile', maturite: 'Decision',
    situation: 'Proprietaire d\'un appartement a Metz-Borny, veut refaire la peinture du sejour et de la cuisine avant Noel',
