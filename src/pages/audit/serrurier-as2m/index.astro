                    <p class={`text-lg font-bold ${m.pct === '100%' ? 'text-emerald-600' : m.pct === '0%' ? 'text-red-600' : 'text-amber-600'}`}>{m.pct}</p>
                    <p class="text-xs text-[var(--color-text-muted)]">conversion</p>
                  </div>
                </div>
              ))}
            </div>
            <p class="mt-4 text-xs text-[var(--color-text-muted)] italic">Les urgences convertissent à 80% — la réputation Google supplée les lacunes techniques. Les profils Découverte (B2B) ne convertissent pas : offre absente.</p>
          </div>
        </div>
      </div>

      <!-- Top frictions -->
      <div class="w-full px-6 pb-16 md:px-8 bg-[var(--color-bg)]">
        <div class="mx-auto max-w-5xl">
          <h2 class="text-xl font-bold text-[var(--color-text)] mb-6">Top frictions identifiées</h2>
          <div class="space-y-3">
            {frictions.map(f => (
              <div class="flex items-start gap-3 rounded-xl border border-[var(--color-border)] bg-white p-4">
                <span class={`shrink-0 mt-0.5 text-xs font-semibold px-2 py-1 rounded-full ${severityColor(f.severity)}`}>{f.severity}</span>
                <p class="text-sm text-[var(--color-text)] flex-1">{f.label}</p>
                <span class="shrink-0 text-xs text-[var(--color-text-muted)] font-medium">{f.count}/10</span>
              </div>
            ))}
          </div>
        </div>
      </div>

    </section>

    <!-- ═══════════════════ PANEL 2 : TECHNIQUE ═══════════════════ -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0 bg-[var(--color-bg)] px-6 py-12 md:px-8 md:py-16">
      <div class="mx-auto max-w-5xl space-y-10">

        <!-- Lighthouse scores -->
        <div>
          <h2 class="text-xl font-bold text-[var(--color-text)] mb-6">PageSpeed Insights (estimations — stack WP/Elementor/PHP 7.4/OVH)</h2>
          <div class="grid md:grid-cols-2 gap-6">
            {lhRows.map(d => (
              <div class="rounded-2xl border border-[var(--color-border)] bg-white p-6">
                <h3 class="text-base font-semibold text-[var(--color-text)] mb-4 capitalize">{d.device}</h3>
                <div class="grid grid-cols-2 gap-4">
                  {d.metrics.map(m => (
                    <div class="text-center">
                      <div class="relative inline-flex items-center justify-center w-16 h-16 mb-2">
                        <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                          <circle cx="18" cy="18" r="15.9" fill="none" stroke="#f3f4f6" stroke-width="3"/>
                          <circle cx="18" cy="18" r="15.9" fill="none" stroke={scoreColor(m.val)} stroke-width="3" stroke-dasharray={`${m.val} 100`} stroke-linecap="round"/>
                        </svg>
                        <span class={`absolute text-xs font-bold ${scoreTextColor(m.val)}`}>{m.val}</span>
                      </div>
                      <p class="text-xs text-[var(--color-text-muted)]">{m.label}</p>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Core Web Vitals -->
        <div>
          <h2 class="text-xl font-bold text-[var(--color-text)] mb-4">Core Web Vitals</h2>
          <div class="overflow-x-auto rounded-xl border border-[var(--color-border)] bg-white">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-neutral-100">
                  <th class="text-left px-4 py-3 font-semibold text-[var(--color-text)]">Métrique</th>
                  <th class="text-center px-4 py-3 font-semibold text-[var(--color-text)]">Desktop</th>
                  <th class="text-center px-4 py-3 font-semibold text-[var(--color-text)]">Mobile</th>
                  <th class="text-right px-4 py-3 font-semibold text-[var(--color-text)] hidden md:table-cell">Seuil vert</th>
                </tr>
              </thead>
              <tbody>
                {cwvRows.map(row => (
                  <tr class="border-b border-neutral-50 last:border-0">
                    <td class="px-4 py-3 font-medium text-[var(--color-text)]">{row.label}</td>
                    <td class={`px-4 py-3 text-center font-semibold ${cwvText(row.desktopStatus)}`}>{row.desktop}</td>
                    <td class={`px-4 py-3 text-center font-semibold ${cwvText(row.mobileStatus)}`}>{row.mobile}</td>
                    <td class="px-4 py-3 text-right text-[var(--color-text-muted)] hidden md:table-cell">{row.threshold}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-xs text-[var(--color-text-muted)] italic">Note : estimations basées sur la stack détectée (WP 6.3.8 / Elementor / PHP 7.4 / OVH shared). API PageSpeed non disponible lors de l'audit.</p>
        </div>

        <!-- Observatory -->
        <div>
          <h2 class="text-xl font-bold text-[var(--color-text)] mb-4">Mozilla Observatory — Sécurité</h2>
          <div class="rounded-2xl border border-[var(--color-border)] bg-white p-6">
            <div class="flex items-center gap-6 mb-6">
              <div class={`w-20 h-20 rounded-2xl border-2 ${gc.border} ${gc.bg} flex items-center justify-center`}>
                <span class={`text-3xl font-black ${gc.text}`}>{observatory.grade}</span>
              </div>
              <div>
                <p class="text-3xl font-bold text-[var(--color-text)]">{observatory.score}<span class="text-lg text-[var(--color-text-muted)]">/100</span></p>
                <p class="text-sm text-[var(--color-text-muted)]">{observatory.passed} tests réussis · {observatory.total - observatory.passed} échoués</p>
                <p class="text-xs mt-1 text-red-600 font-medium">X-Powered-By: PHP/7.4 expose la version serveur</p>
              </div>
            </div>
            <div>
              <p class="text-sm font-semibold text-[var(--color-text)] mb-3">Headers de sécurité manquants :</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {missingHeaders.map(h => (
                  <div class="flex items-center gap-2 text-sm text-red-700 bg-red-50 rounded-lg px-3 py-2">
                    <span class="text-red-500 shrink-0">✕</span>
                    <code class="text-xs">{h}</code>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Schema.org & OG -->
        <div class="grid md:grid-cols-2 gap-6">
          <div class="rounded-2xl border border-[var(--color-border)] bg-white p-6">
            <h3 class="text-base font-bold text-[var(--color-text)] mb-4">Schema.org</h3>
            <p class="text-xs text-amber-700 bg-amber-50 rounded-lg px-3 py-2 mb-4">Avec 1059 avis 4.9/5, l'absence d'AggregateRating est une perte SEO critique (-25-35% CTR estimé)</p>
            <div class="space-y-2">
              {schemaChecks.map(c => (
                <div class="flex items-center gap-2 text-sm">
                  <span class={c.ok ? 'text-emerald-600' : 'text-red-400'}>{c.ok ? '✓' : '✕'}</span>
                  <span class={c.ok ? 'text-[var(--color-text)]' : 'text-[var(--color-text-muted)]'}>{c.label}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="rounded-2xl border border-[var(--color-border)] bg-white p-6">
            <h3 class="text-base font-bold text-[var(--color-text)] mb-4">Open Graph & SEO Meta</h3>
            <div class="space-y-2 mb-6">
              {ogChecks.map(c => (
                <div class="flex items-center gap-2 text-sm">
                  <span class={c.ok ? 'text-emerald-600' : 'text-red-400'}>{c.ok ? '✓' : '✕'}</span>
                  <span class={c.ok ? 'text-[var(--color-text)]' : 'text-[var(--color-text-muted)]'}>{c.label}</span>
                </div>
              ))}
            </div>
            <h3 class="text-base font-bold text-[var(--color-text)] mb-3">SEO Contenu</h3>
            <div class="space-y-2">
