                <div class="h-full rounded-full bg-blue-500" style={`width: ${scoreBar(Number(avgConf))}`}></div>
              </div>
            </div>
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-5 text-center">
              <p class="text-3xl md:text-4xl font-bold text-purple-600">{avgClarte}<span class="text-lg text-[var(--color-text-muted)]">/10</span></p>
              <p class="mt-1 text-sm text-[var(--color-text-muted)]">Clarté</p>
              <div class="mt-2 h-2 rounded-full bg-neutral-100 overflow-hidden">
                <div class="h-full rounded-full bg-purple-500" style={`width: ${scoreBar(Number(avgClarte))}`}></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Score global -->
      <div class="w-full px-6 pb-12 md:px-8 bg-[var(--color-bg)]">
        <div class="mx-auto max-w-5xl">
          <div class="rounded-2xl border border-[var(--color-border)] bg-white p-6 md:p-8 mb-8">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
