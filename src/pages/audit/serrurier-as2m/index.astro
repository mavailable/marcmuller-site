const amelioDiscuter = [
  { emoji: '\u{1F4F1}', title: 'Bouton WhatsApp / Rappel immédiat', detail: 'CTA sticky mobile "Être rappelé en 5 min" ou WhatsApp. Pour les urgences de nuit où l\'appel direct est difficile (coloc, hôpital...). 3 personas l\'auraient utilisé.' },
  { emoji: '\u{1F4F8}', title: 'Galerie de réalisations', detail: 'Photos avant/après : portes blindées posées (Fichet-Bauche, Heracles), cylindres A2P, coffres-forts ouverts. Décisif pour les visites de comparaison avec budget > 500 EUR.' },
  { emoji: '\u{1F4CD}', title: 'Carte Google Maps interactive', detail: 'Carte de la zone de couverture (30 km autour de Metz). Avec les ~30 communes desservies listées. Rassurerait les prospects hors Metz-centre (Woippy, Montigny, Bechy, Thionville...).' },
  { emoji: '\u{1F916}', title: 'Référencement IA (llms.txt + Schema.org riche)', detail: 'ChatGPT a quand même trouvé AS2M malgré l\'absence de llms.txt. Avec un Schema.org LocalBusiness + AggregateRating complet + llms.txt, AS2M serait cité en premier dans les réponses IA pour "serrurier Metz".' },
];

// ─── HELPERS ───
function scoreColor(s: number) {
  if (s >= 90) return '#22c55e';
  if (s >= 50) return '#f59e0b';
  return '#ef4444';
}
function scoreTextColor(s: number) {
  if (s >= 90) return 'text-green-600';
  if (s >= 50) return 'text-amber-600';
  return 'text-red-600';
}
function decisionColor(d: string) {
  if (d === 'Convertit') return 'bg-emerald-100 text-emerald-800';
  if (d === 'Hesite') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}
function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}
function severityColor(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  return 'bg-blue-100 text-blue-800';
}
function cwvBg(status: string) {
  if (status === 'good') return 'bg-green-50';
  if (status === 'mid') return 'bg-amber-50';
  return 'bg-red-50';
}
function cwvText(status: string) {
  if (status === 'good') return 'text-green-700';
  if (status === 'mid') return 'text-amber-700';
  return 'text-red-700';
}
function cwvBadge(status: string) {
  if (status === 'good') return 'bg-green-100 text-green-800';
  if (status === 'mid') return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}
function cwvLabel(status: string) {
  if (status === 'good') return 'Bon';
  if (status === 'mid') return 'Moyen';
  return 'Mauvais';
}
function scoreBar(val: number) {
  return `${val * 10}%`;
}
function gradeColor(g: string) {
  if (g.startsWith('A')) return { border: 'border-green-300', bg: 'bg-green-50', text: 'text-green-700' };
  if (g.startsWith('B')) return { border: 'border-amber-300', bg: 'bg-amber-50', text: 'text-amber-700' };
  return { border: 'border-red-300', bg: 'bg-red-50', text: 'text-red-700' };
}
const gc = gradeColor(observatory.grade);

// ─── CWV LABELS & THRESHOLDS (precomputed to avoid TS generics in template) ───
const cwvLabels: Record<string, string> = { lcp: 'LCP', fcp: 'FCP', cls: 'CLS', tbt: 'TBT', si: 'Speed Index' };
const cwvThresholds: Record<string, string> = { lcp: '< 2.5s', fcp: '< 1.8s', cls: '< 0.1', tbt: '< 200ms', si: '< 3.4s' };
const cwvRows = Object.entries(cwv).map(([key, v]) => ({
  key,
  label: cwvLabels[key],
  threshold: cwvThresholds[key],
  desktop: v.desktop,
  mobile: v.mobile,
  desktopStatus: v.desktopStatus,
  mobileStatus: v.mobileStatus,
}));

// ─── LIGHTHOUSE ROWS (precomputed to avoid Object.entries + as const in template) ───
const lhLabels: Record<string, string> = { perf: 'Performance', access: 'Accessibilité', bp: 'Bonnes Pratiques', seo: 'SEO' };
const lhDevices = [
  { device: 'mobile', scores: lighthouseScores.mobile },
  { device: 'desktop', scores: lighthouseScores.desktop },
];
const lhRows = lhDevices.map(d => ({
  device: d.device,
  metrics: Object.entries(d.scores).map(([key, val]) => ({ key, label: lhLabels[key], val })),
}));
