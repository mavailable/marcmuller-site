<script>
  // Tab navigation + snap scroll sync
  const panels = document.getElementById('panels');
  const tabBtns = document.querySelectorAll('.tab-btn');

  function setActiveTab(index: number) {
    tabBtns.forEach((btn, i) => {
      btn.classList.toggle('text-primary-700', i === index);
      btn.classList.toggle('bg-primary-50', i === index);
      btn.classList.toggle('text-neutral-500', i !== index);
      btn.classList.toggle('hover:text-neutral-700', i !== index);
    });
    if (panels) {
      panels.scrollTo({ left: index * panels.clientWidth, behavior: 'smooth' });
    }
  }

  tabBtns.forEach((btn, i) => {
    btn.addEventListener('click', () => setActiveTab(i));
  });

  if (panels) {
    panels.addEventListener('scroll', () => {
      const idx = Math.round(panels.scrollLeft / panels.clientWidth);
      tabBtns.forEach((btn, i) => {
        btn.classList.toggle('text-primary-700', i === idx);
        btn.classList.toggle('bg-primary-50', i === idx);
        btn.classList.toggle('text-neutral-500', i !== idx);
        btn.classList.toggle('hover:text-neutral-700', i !== idx);
      });
    });
  }
</script>
