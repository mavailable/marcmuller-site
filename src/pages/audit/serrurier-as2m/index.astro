                      {c.conv > 0 && <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">{c.conv} convertis</span>}
                      {c.hesitant > 0 && <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">{c.hesitant} hésit.</span>}
                      {c.quitte > 0 && <span class="text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-800">{c.quitte} partis</span>}
                    </div>
                  </div>
                  <div class="h-2 rounded-full bg-neutral-100 overflow-hidden">
                    <div class="h-full rounded-full bg-blue-500" style={`width: ${(c.total / personas.length) * 100}%`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Maturité -->
          <div class="rounded-2xl border border-[var(--color-border)] bg-white p-6">
            <h3 class="text-base font-bold text-[var(--color-text)] mb-4">Maturité décisionnelle</h3>
            <div class="space-y-3">
              {maturiteStats.map(m => (
                <div class="flex items-center justify-between rounded-lg px-4 py-3 bg-neutral-50 border border-neutral-100">
