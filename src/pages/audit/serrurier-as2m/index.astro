                <span class="text-2xl text-neutral-400">/100</span>
              </div>
            </div>
            <div class="space-y-3">
              {scoreGlobal.map(item => (
                <div class="flex items-center gap-3">
                  <span class="w-32 text-sm font-medium text-[var(--color-text)] shrink-0">{item.cat}</span>
                  <div class="flex-1 h-3 rounded-full bg-neutral-100 overflow-hidden">
                    <div class="h-full rounded-full transition-all" style={`width: ${item.score}%; background-color: ${item.color};`}></div>
                  </div>
                  <span class="text-sm font-semibold w-12 text-right" style={`color: ${item.color}`}>{item.score}/100</span>
                  <span class="text-xs text-neutral-400 w-10 text-right">{item.poids}%</span>
                </div>
              ))}
            </div>
            <p class="mt-6 text-sm text-[var(--color-text-muted)] bg-amber-50 border border-amber-200 rounded-lg p-4">
              <strong class="text-amber-800">Note :</strong> La réputation exceptionnelle (1059 avis, 4.9/5) est le principal atout d'AS2M — elle est mal exploitée techniquement. AggregateRating absent = perte de CTR estimée à 25-35% sur Google. Un site Astro/Cloudflare avec Schema.org complet transformerait ces avis en machine à conversion.
            </p>
          </div>
        </div>
      </div>

      <!-- Canal & Maturité -->
      <div class="w-full px-6 pb-12 md:px-8 bg-[var(--color-bg)]">
        <div class="mx-auto max-w-5xl grid md:grid-cols-2 gap-6">

          <!-- Canal -->
          <div class="rounded-2xl border border-[var(--color-border)] bg-white p-6">
            <h3 class="text-base font-bold text-[var(--color-text)] mb-4">Canaux d'arrivée</h3>
            <div class="space-y-3">
              {canalStats.map(c => (
                <div>
                  <div class="flex justify-between items-center mb-1">
                    <span class="text-sm text-[var(--color-text)]">{c.canal}</span>
