    titre: 'Afficher les 131 avis 5/5 et implementer Schema.org AggregateRating',
    detail: '9 personas sur 10 cherchent une preuve sociale. Lova Photo a le meilleur score de la zone — mais cette information n\'est pas sur le site. Schema.org AggregateRating permettrait d\'afficher la note dans les resultats Google Search (rich snippets) sans que les visiteurs aient a aller sur Google Maps.',
    action: 'Ajouter Schema.org Person + AggregateRating (rating: 5, count: 131). Section temoignages en page d\'accueil avec 5-6 verbatims recents du Livre d\'or. Widget "131 avis Google 5/5" visible en hero ou header.',
  },
  {
    titre: 'Migrer vers site statique Astro — supprimer Joomla PHP 7.3',
    detail: 'PHP 7.3 est en fin de support depuis decembre 2021 (vulnerabilites actives). Joomla + JCH Optimize genere un TTFB de 428ms et un LCP estime > 4s. Le score Observatory est D (30/100). La migration vers Astro + Tailwind v4 + Cloudflare Pages amenerait Performance > 90/100, Security > 90/100, et supprimerait les 4 cookies sans consentement.',
    action: 'Pipeline Web Factory complet : brief.md → design-system.md → contenu.md → seo.md → Astro project. Deploiement Cloudflare Pages. Temps : 7 jours. Score cible : PageSpeed > 90 mobile, Observatory > A (90/100).',
  },
];

const ameliorationsUtiles = [
  {
    titre: 'Ajouter Umami Analytics + llms.txt pour la visibilite IA',
    detail: 'Zero analytics = navigation a l\'aveugle. Umami Cloud (RGPD-native, cookie-free) permettrait de mesurer trafic, pages populaires, conversions. llms.txt permettrait aux IA generatives de citer Lova Photo dans leurs recommandations de photographes a Metz.',
  },
  {
    titre: 'Creer un forfait mariage dedie et afficher les tarifs EVJF journee',
    detail: 'Emilie & Tom ont hesite uniquement a cause de l\'absence de tarif mariage. Un forfait "mariage complet" (demi-journee / journee / reportage complet) avec prix indicatifs convertirait les futurs maries qui se planifient a 12-18 mois.',
  },
  {
    titre: 'Integrer un feed Instagram dans la galerie et ajouter une FAQ par prestation',
    detail: 'Clara et Amelie cherchent plus d\'inspiration visuelle. Un feed Instagram embede + galerie filtrable par type (grossesse, mariage, boudoir...) augmenterait le temps passe et la confiance. Une FAQ par prestation (duree, livraison, guidage, confidentialite) reduirait les questions de contact repetitives.',
  },
];

// ============================================================
// HELPERS
// ============================================================
function scoreColor(score: number) {
  if (score >= 90) return '#22c55e';
  if (score >= 50) return '#f59e0b';
  return '#ef4444';
}

function scoreTextClass(score: number) {
  if (score >= 90) return 'text-green-600';
  if (score >= 50) return 'text-amber-500';
  return 'text-red-500';
}

function decisionColor(decision: string) {
  if (decision === 'convertit') return 'border-green-200 bg-green-50/40';
  if (decision === 'hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}

function decisionBadge(decision: string) {
  if (decision === 'convertit') return 'bg-green-100 text-green-700';
  if (decision === 'hesite') return 'bg-amber-100 text-amber-700';
  return 'bg-neutral-100 text-neutral-600';
}

function decisionLabel(decision: string) {
  if (decision === 'convertit') return 'Contacte';
  if (decision === 'hesite') return 'Hesite';
  return 'Repart';
}

function maturiteColor(m: string) {
  if (m === 'Decision') return 'text-purple-600 bg-purple-50';
  if (m === 'Comparaison') return 'text-blue-600 bg-blue-50';
  return 'text-neutral-500 bg-neutral-100';
}
---

<BaseLayout title={title} description={description} noindex={true} lang="fr" frPath="/audit/lova-photo">

  <!-- ========================================================
       HERO + KPIs
  ======================================================== -->
  <section class="bg-neutral-900 text-white py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-4">Rapport personnalise</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2 leading-tight">
        {prospect.name}<br/>
        <span class="text-neutral-300 font-normal text-2xl">ce que vos visiteurs pensent vraiment</span>
      </h1>
      <p class="text-neutral-400 mb-2">{prospect.activity} &mdash; {prospect.location}</p>
      <p class="text-neutral-500 text-sm mb-8">
        <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener noreferrer">{prospect.url}</a>
        &mdash; Rapport du {prospect.date}
      </p>

      <!-- KPI Cards -->
      <div class="grid grid-cols-3 gap-4 max-w-lg">
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.conversion}%</span>
          <span class="text-xs text-neutral-400 mt-1 block">convertissent</span>
        </div>
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.experience}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">experience</span>
        </div>
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.confiance}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">confiance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       LE CONSTAT
  ======================================================== -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>

      <!-- Constat principal -->
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-amber-900 font-medium text-base leading-relaxed">{constat}</p>
      </div>

      <!-- Resume visiteurs -->
      <div class="flex flex-wrap gap-3 mb-8">
        <div class="flex items-center gap-2 bg-green-50 border border-green-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
          <span class="text-sm font-semibold text-green-800">{kpis.convertissent} contactent</span>
        </div>
        <div class="flex items-center gap-2 bg-amber-50 border border-amber-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
          <span class="text-sm font-semibold text-amber-800">{kpis.hesitent} hesitent</span>
        </div>
        <div class="flex items-center gap-2 bg-neutral-100 border border-neutral-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-neutral-400 shrink-0"></span>
          <span class="text-sm font-semibold text-neutral-700">{kpis.quittent} repartent</span>
        </div>
      </div>

      <!-- Conversion par canal -->
      <div class="mb-10">
        <h3 class="font-semibold text-neutral-800 mb-4 text-sm uppercase tracking-wide">Taux de contact par canal d'arrivee</h3>
        <div class="space-y-3">
          {conversionByCanal.map(item => (
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-neutral-700">{item.canal}</span>
                <span class={`text-sm font-bold ${item.color}`}>{item.taux}%</span>
              </div>
              <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
                <div class={`h-full rounded-full ${item.bg}`} style={`width: ${item.taux}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Top frictions -->
      <h3 class="font-semibold text-neutral-800 mb-4 text-sm uppercase tracking-wide">Top 5 frictions identifiees</h3>
      <ol class="space-y-3">
        {topFrictions.map((f, i) => (
          <li class="flex gap-4 p-4 bg-neutral-50 border border-neutral-200 rounded-xl">
            <span class="shrink-0 w-7 h-7 rounded-full bg-red-100 text-red-700 flex items-center justify-center text-sm font-bold">{i + 1}</span>
            <div>
              <p class="font-semibold text-neutral-900 text-sm">{f.titre} <span class="ml-2 text-xs text-neutral-500 font-normal">{f.count}/10 personas</span></p>
              <p class="text-neutral-600 text-xs mt-0.5">{f.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========================================================
       AUDIT TECHNIQUE
  ======================================================== -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">L'audit technique</h2>

      <!-- PageSpeed mobile -->
      <div class="bg-white border border-neutral-200 rounded-xl p-6 mb-6">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
          <h3 class="font-semibold text-neutral-800">PageSpeed — Mobile</h3>
          <span class="text-xs text-neutral-400 bg-neutral-100 px-2 py-1 rounded">scores estimes — profil Joomla PHP 7.3 OVH</span>
        </div>
        <div class="grid grid-cols-4 gap-4">
          {[
            { label: 'Performance', score: pagespeed.mobile.performance },
            { label: 'Accessibilite', score: pagespeed.mobile.accessibility },
            { label: 'Bonnes pratiques', score: pagespeed.mobile.bestPractices },
            { label: 'SEO', score: pagespeed.mobile.seo },
          ].map(item => (
            <div class="text-center">
              <div class="relative w-14 h-14 mx-auto mb-2">
                <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                    fill="none" stroke="#e5e7eb" stroke-width="3.5" />
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                    fill="none" stroke={scoreColor(item.score)} stroke-width="3.5"
                    stroke-dasharray={`${item.score}, 100`} stroke-linecap="round" />
                </svg>
                <span class={`absolute inset-0 flex items-center justify-center text-base font-bold ${scoreTextClass(item.score)}`}>{item.score}</span>
              </div>
              <p class="text-xs text-neutral-600">{item.label}</p>
            </div>
          ))}
        </div>

        <!-- Core Web Vitals -->
        <div class="mt-4 pt-4 border-t border-neutral-100">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide mb-2">Core Web Vitals (mobile estimes)</p>
          <div class="flex flex-wrap gap-3">
            {coreWebVitals.map(cwv => (
              <div class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium ${cwv.status === 'good' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'}`}>
                <span class={`w-1.5 h-1.5 rounded-full ${cwv.status === 'good' ? 'bg-green-500' : 'bg-red-500'}`}></span>
                {cwv.name} : {cwv.value}
              </div>
            ))}
          </div>
        </div>

        <!-- Opportunites -->
        <div class="mt-4 pt-4 border-t border-neutral-100">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide mb-2">Opportunites d'amelioration</p>
          <div class="space-y-2">
            {opportunities.map(op => (
              <div class="flex items-center justify-between text-xs">
                <span class="text-neutral-600">{op.label}</span>
                <span class="font-semibold text-green-600 shrink-0 ml-2">{op.saving}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- PageSpeed Desktop + Observatory -->
      <div class="grid md:grid-cols-2 gap-6 mb-6">
        <!-- Desktop -->
        <div class="bg-white border border-neutral-200 rounded-xl p-6">
          <h3 class="font-semibold text-neutral-800 mb-4">PageSpeed — Desktop</h3>
          <div class="grid grid-cols-4 gap-2">
            {[
              { label: 'Perf.', score: pagespeed.desktop.performance },
              { label: 'Access.', score: pagespeed.desktop.accessibility },
              { label: 'Pratiques', score: pagespeed.desktop.bestPractices },
              { label: 'SEO', score: pagespeed.desktop.seo },
            ].map(item => (
              <div class="text-center">
                <div class="relative w-12 h-12 mx-auto mb-1">
                  <svg class="w-12 h-12 -rotate-90" viewBox="0 0 36 36">
                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                      fill="none" stroke="#e5e7eb" stroke-width="3.5" />
                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                      fill="none" stroke={scoreColor(item.score)} stroke-width="3.5"
                      stroke-dasharray={`${item.score}, 100`} stroke-linecap="round" />
                  </svg>
                  <span class={`absolute inset-0 flex items-center justify-center text-sm font-bold ${scoreTextClass(item.score)}`}>{item.score}</span>
                </div>
                <p class="text-xs text-neutral-500">{item.label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Observatory -->
        <div class="bg-white border border-neutral-200 rounded-xl p-6">
          <h3 class="font-semibold text-neutral-800 mb-4">Mozilla Observatory</h3>
          <div class="flex items-center gap-4 mb-3">
            <div class="w-16 h-16 rounded-full bg-red-50 border-4 border-red-400 flex items-center justify-center shrink-0">
              <span class="text-2xl font-black text-red-600">{observatory.grade}</span>
            </div>
            <div>
              <p class="text-3xl font-black text-red-600">{observatory.score}<span class="text-base font-normal text-neutral-400">/100</span></p>
              <p class="text-xs text-neutral-500">{observatory.testsPassed}/{observatory.testsTotal} tests reussis</p>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2 text-xs text-green-700"><span class="w-4 h-4 rounded-full bg-green-100 flex items-center justify-center text-green-600 font-bold text-xs">+</span>X-Content-Type-Options, X-Frame-Options, HTTPS, HSTS partiel</div>
            <div class="flex items-center gap-2 text-xs text-red-600"><span class="w-4 h-4 rounded-full bg-red-100 flex items-center justify-center text-red-600 font-bold text-xs">-</span>CSP vide, Referrer-Policy faible, Permissions-Policy absent</div>
            <div class="flex items-center gap-2 text-xs text-red-600"><span class="w-4 h-4 rounded-full bg-red-100 flex items-center justify-center text-red-600 font-bold text-xs">-</span>PHP/7.3 expose, cookies sans SameSite, HSTS conflit</div>
          </div>
        </div>
      </div>

      <!-- Tech Checklist -->
      <div class="bg-white border border-neutral-200 rounded-xl p-6">
        <h3 class="font-semibold text-neutral-800 mb-4">Checklist technique</h3>
        <div class="space-y-2">
          {techChecks.map(check => (
            <div class={`flex items-start gap-3 py-1.5 px-2 rounded-lg ${check.present ? 'bg-green-50/50' : check.critical ? 'bg-red-50/50' : 'bg-neutral-50/50'}`}>
              <span class={`shrink-0 w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold mt-0.5 ${check.present ? 'bg-green-100 text-green-700' : check.critical ? 'bg-red-100 text-red-700' : 'bg-neutral-100 text-neutral-500'}`}>
                {check.present ? '✓' : '✗'}
              </span>
              <div>
                <span class={`text-sm ${check.present ? 'text-green-800' : check.critical ? 'text-red-800 font-medium' : 'text-neutral-600'}`}>{check.label}</span>
                {check.note && <span class="ml-2 text-xs text-neutral-400 italic">{check.note}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       10 PERSONAS
  ======================================================== -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">Les 10 visites simulees</h2>
      <p class="text-neutral-500 text-sm mb-8">Chaque persona represente un profil reel de client potentiel pour une photographe a Metz.</p>

      <div class="space-y-6">
        {personas.map(p => (
          <div class={`border rounded-xl overflow-hidden ${decisionColor(p.decision)}`}>
            <!-- Header persona -->
            <div class="flex items-start gap-4 p-5 pb-3">
              <span class="text-3xl shrink-0">{p.emoji}</span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="font-bold text-neutral-900">{p.name}</span>
                  <span class="text-neutral-400 text-sm">{p.age} ans</span>
                  <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${maturiteColor(p.maturite)}`}>{p.maturite}</span>
                  <span class={`text-xs px-2 py-0.5 rounded-full font-semibold ${decisionBadge(p.decision)}`}>{decisionLabel(p.decision)}</span>
                </div>
                <div class="flex flex-wrap gap-3 text-xs text-neutral-500">
                  <span>via {p.canal}</span>
                  <span>·</span>
                  <span>{p.device}</span>
                  <span>·</span>
                  <span class="text-neutral-700">{p.situation}</span>
                </div>
              </div>
            </div>

            <!-- Scores -->
            <div class="px-5 pb-3">
              <div class="flex gap-4 text-xs">
                {[
                  { label: 'Experience', val: p.scores.exp },
                  { label: 'Confiance', val: p.scores.conf },
                  { label: 'Clarte', val: p.scores.clarte },
                ].map(s => (
                  <div class="flex items-center gap-1.5">
                    <span class="text-neutral-500">{s.label} :</span>
                    <span class={`font-bold ${s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-500' : 'text-red-500'}`}>{s.val}/10</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Parcours -->
            {p.parcours.length > 0 && (
              <div class="px-5 pb-3">
                <div class="flex items-center gap-1 flex-wrap text-xs text-neutral-500">
                  {p.parcours.map((step, i) => (
                    <>
                      <span class="bg-neutral-100 text-neutral-700 px-2 py-0.5 rounded">{step}</span>
                      {i < p.parcours.length - 1 && <span class="text-neutral-300">›</span>}
                    </>
                  ))}
                </div>
              </div>
            )}

            <!-- Contenu principal -->
            <div class="px-5 pb-4 space-y-3">
              <!-- Premiere impression -->
              <div class="bg-white/70 rounded-lg p-3">
                <p class="text-xs font-semibold text-neutral-500 mb-1 uppercase tracking-wide">Premiere impression</p>
                <p class="text-sm text-neutral-700 italic">"{p.premierImpression}"</p>
              </div>

              <!-- Question cle -->
              <div>
                <p class="text-xs font-semibold text-neutral-500 mb-1 uppercase tracking-wide">Question cle</p>
                <p class="text-sm text-neutral-700">"{p.questionCle}"</p>
                <p class="text-xs font-medium mt-1">
                  Reponse du site : <span class={p.reponse === 'Oui' ? 'text-green-600' : p.reponse === 'Partiellement' ? 'text-amber-500' : p.reponse === 'Invisible' ? 'text-red-500 italic' : 'text-red-500'}>{p.reponse}</span>
                  {p.commentReponse && <span class="text-neutral-500 font-normal"> — {p.commentReponse}</span>}
                </p>
              </div>

              <!-- Impact technique -->
              <div class="text-xs text-neutral-500 border-t border-neutral-200 pt-2">
                <span class="font-semibold text-neutral-700">Impact technique : </span>{p.impactTechnique}
              </div>

              <!-- Points positifs / frictions -->
              <div class="grid sm:grid-cols-2 gap-3">
                {p.pointsPositifs.length > 0 && (
                  <div>
                    <p class="text-xs font-semibold text-green-700 mb-1">Points positifs</p>
                    <ul class="space-y-0.5">
                      {p.pointsPositifs.map(pp => (
                        <li class="text-xs text-neutral-600 flex gap-1.5"><span class="text-green-500 shrink-0">+</span>{pp}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {p.frictions.length > 0 && (
                  <div>
                    <p class="text-xs font-semibold text-red-600 mb-1">Frictions</p>
                    <ul class="space-y-0.5">
                      {p.frictions.map(f => (
                        <li class="text-xs text-neutral-600 flex gap-1.5"><span class="text-red-400 shrink-0">-</span>{f}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       RECOMMANDATIONS
  ======================================================== -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Les recommandations</h2>

      <h3 class="font-semibold text-neutral-800 mb-4 text-sm uppercase tracking-wide">Corrections critiques (bloquantes)</h3>
      <div class="space-y-4 mb-8">
        {ameliorationsCritiques.map((a, i) => (
          <div class="bg-white border border-red-100 rounded-xl p-5">
            <div class="flex gap-3 mb-2">
              <span class="shrink-0 w-7 h-7 rounded-full bg-red-100 text-red-700 flex items-center justify-center text-sm font-bold">{i + 1}</span>
              <h4 class="font-semibold text-neutral-900 text-sm">{a.titre}</h4>
            </div>
            <p class="text-sm text-neutral-600 mb-2 pl-10">{a.detail}</p>
            <p class="text-xs text-neutral-500 pl-10 border-l-2 border-red-200 ml-10"><span class="font-semibold text-neutral-700">Action : </span>{a.action}</p>
          </div>
        ))}
      </div>

      <h3 class="font-semibold text-neutral-800 mb-4 text-sm uppercase tracking-wide">Ameliorations utiles</h3>
      <div class="space-y-3">
        {ameliorationsUtiles.map((a, i) => (
          <div class="bg-white border border-neutral-200 rounded-xl p-4">
            <div class="flex gap-3">
              <span class="shrink-0 w-7 h-7 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center text-sm font-bold">{i + 4}</span>
              <div>
                <h4 class="font-semibold text-neutral-900 text-sm mb-1">{a.titre}</h4>
                <p class="text-sm text-neutral-600">{a.detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       CTA CONTACT
  ======================================================== -->
  <section class="py-14 px-4 bg-neutral-900 text-white">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-heading text-2xl font-bold mb-3">Votre site merite d'etre a la hauteur de votre talent</h2>
      <p class="text-neutral-400 mb-6 text-base">131 avis 5/5, un style unique, une gamme complete de prestations — Web Factory peut transformer tout ca en un site qui convertit autant que vous meritez. Site livré en 7 jours, a partir de 990 €.</p>
      <a href="/contact" class="inline-block bg-amber-400 text-neutral-900 font-bold px-8 py-3 rounded-xl hover:bg-amber-300 transition-colors">
