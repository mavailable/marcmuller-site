// ─── AMELIORATIONS ───
const ameliorationsCritiques = [
  {
    titre: 'Corriger la page desamiantage + ajouter Schema.org',
    detail: 'La page en 404 est le probleme n°1 de confiance. Schema.org LocalBusiness + RoofingContractor avec aggregateRating permet d\'afficher les 32 avis directement dans Google.',
    action: 'Recréer la page /desamiantage + ajouter JSON-LD avec @type RoofingContractor, address, telephone, aggregateRating (32 avis, 4.8)',
