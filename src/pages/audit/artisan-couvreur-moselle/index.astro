  { titre: '32 avis 4.8/5 non exploites sur le site', count: 6, detail: 'Le meilleur argument commercial est sur Google et absent du site. Pas un seul temoignage affiche.' },
  { titre: 'Zero contenu B2B ou professionnel', count: 3, detail: 'Sous-traitance, contrats de maintenance, gestionnaires immobiliers — marche potentiel important non adresse.' },
