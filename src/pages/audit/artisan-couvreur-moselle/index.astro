// ─── KPIs ───
const convertis = personas.filter(p => p.decision === 'Convertit').length;
const hesitants = personas.filter(p => p.decision === 'Hesite').length;
const quittes = personas.filter(p => p.decision === 'Quitte').length;
const tauxConv = Math.round((convertis / personas.length) * 100);
const avgExp = (personas.reduce((s, p) => s + p.scores.exp, 0) / personas.length).toFixed(1);
const avgConf = (personas.reduce((s, p) => s + p.scores.conf, 0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.scores.clarte, 0) / personas.length).toFixed(1);

const constat = "Les 32 avis Google 4.8 etoiles font le travail a la place du site : les visiteurs qui convertissent arrivent par Maps en urgence ou par recommandation — le site ne convainc personne qui compare.";

// ─── CANAL STATS ───
const canalStats = [
  { canal: 'Google Maps (urgence/local)', conv: 2, total: 2, taux: 100, color: 'green' },
  { canal: 'Bouche-a-oreille', conv: 1, total: 1, taux: 100, color: 'green' },
  { canal: 'Google Search (informatif)', conv: 0, total: 4, taux: 0, color: 'red' },
  { canal: 'Reseaux sociaux', conv: 0, total: 2, taux: 0, color: 'red' },
