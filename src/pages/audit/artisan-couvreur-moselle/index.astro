// ─── SCORES TECHNIQUE ───
const pagespeedMobile = { perf: 45, access: 58, bp: 65, seo: 62 };
const pagespeedDesktop = { perf: 68, access: 58, bp: 65, seo: 62 };
const observatoryData = { grade: 'B', score: 75, passed: 8, total: 10 };

const techChecks = [
  { label: 'HTTPS + redirect HTTP', ok: true },
  { label: 'Strict-Transport-Security', ok: true },
  { label: 'X-Frame-Options: DENY', ok: true },
  { label: 'X-Content-Type-Options', ok: true },
  { label: 'Referrer-Policy', ok: true },
  { label: 'Content-Security-Policy', ok: true, warning: 'unsafe-eval/unsafe-inline — trop permissif' },
  { label: 'Schema.org JSON-LD', ok: false, critical: true },
  { label: 'Open Graph (og:title, og:image)', ok: false, critical: true },
  { label: 'Balise canonique', ok: false, critical: true },
  { label: 'Alt text images (4/15 vides)', ok: false },
  { label: 'SIRET dans mentions legales', ok: false, critical: true },
  { label: 'Viewport non verrouille (max-scale)', ok: false },
];

function scoreColor(s: number) {
  if (s >= 90) return '#22c55e';
  if (s >= 50) return '#f59e0b';
  return '#ef4444';
}
function scoreBg(s: number) {
  if (s >= 90) return 'bg-green-100 text-green-800';
  if (s >= 50) return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}
function decisionColor(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}
function decisionBadge(d: string) {
  if (d === 'Convertit') return 'bg-green-100 text-green-700';
  if (d === 'Hesite') return 'bg-amber-100 text-amber-700';
  return 'bg-neutral-100 text-neutral-600';
}
---

<BaseLayout title={title} description={description} noindex={true} lang="fr" frPath="/audit/artisan-couvreur-moselle/">

  <!-- ═══════════════════════════════════════════════ HERO -->
  <section class="bg-neutral-900 text-white py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-4">Rapport personnalise</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2">
        {prospect.name} — ce que vos visiteurs pensent vraiment
      </h1>
      <p class="text-neutral-400 mb-2">{prospect.activity} — <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener noreferrer">{prospect.url}</a></p>
      <p class="text-neutral-500 text-sm mb-8">
        Audit realise le {prospect.date} · {prospect.avisGoogle} sur Google
      </p>
      <div class="grid grid-cols-3 gap-4 max-w-lg">
        <div class="text-center">
          <span class="block text-3xl font-black text-amber-400">{tauxConv}%</span>
          <span class="text-xs text-neutral-400">convertissent</span>
        </div>
        <div class="text-center">
          <span class="block text-3xl font-black text-amber-400">{avgExp}/10</span>
          <span class="text-xs text-neutral-400">experience</span>
        </div>
        <div class="text-center">
          <span class="block text-3xl font-black text-amber-400">{avgConf}/10</span>
          <span class="text-xs text-neutral-400">confiance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ CONSTAT -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-amber-900 font-medium text-lg leading-relaxed">{constat}</p>
      </div>

      <!-- Conversion par canal -->
      <h3 class="font-semibold text-neutral-700 mb-4 text-sm uppercase tracking-wide">Conversion par canal d'arrivee</h3>
      <div class="space-y-3 mb-10">
        {canalStats.map(item => (
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-sm text-neutral-700">{item.canal}</span>
              <span class={`text-sm font-bold ${item.taux === 100 ? 'text-green-600' : item.taux > 0 ? 'text-amber-600' : 'text-red-600'}`}>{item.taux}%</span>
            </div>
            <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
              <div
                class={`h-full rounded-full ${item.taux === 100 ? 'bg-green-500' : item.taux > 0 ? 'bg-amber-500' : 'bg-red-400'}`}
                style={`width: ${Math.max(item.taux, 2)}%`}
              ></div>
            </div>
          </div>
        ))}
      </div>

      <!-- Top frictions -->
      <h3 class="font-semibold text-neutral-700 mb-4 text-sm uppercase tracking-wide">Top 5 frictions identifiees</h3>
      <ol class="space-y-3">
        {topFrictions.map((f, i) => (
          <li class="flex gap-4 p-4 bg-neutral-50 rounded-xl border border-neutral-100">
            <span class="text-2xl font-black text-red-300 shrink-0 leading-none">{i + 1}</span>
            <div>
              <p class="font-semibold text-neutral-800 text-sm">{f.titre}
                <span class="ml-2 text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded-full">{f.count}/10 personas</span>
              </p>
              <p class="text-neutral-500 text-xs mt-1">{f.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ AUDIT TECHNIQUE -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">L'audit technique</h2>

      <!-- PageSpeed Mobile -->
      <h3 class="font-semibold text-neutral-700 mb-4 text-sm uppercase tracking-wide">PageSpeed Insights — mobile (estimation)</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
        {[
          { label: 'Performance', score: pagespeedMobile.perf },
          { label: 'Accessibilite', score: pagespeedMobile.access },
          { label: 'Bonnes pratiques', score: pagespeedMobile.bp },
          { label: 'SEO', score: pagespeedMobile.seo },
        ].map(item => (
          <div class="bg-white rounded-xl p-4 text-center shadow-sm border border-neutral-100">
            <div class="relative w-16 h-16 mx-auto mb-2">
              <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                  fill="none" stroke="#e5e7eb" stroke-width="3" />
                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                  fill="none" stroke={scoreColor(item.score)} stroke-width="3"
                  stroke-dasharray={`${item.score}, 100`} stroke-linecap="round" />
              </svg>
              <span class="absolute inset-0 flex items-center justify-center text-lg font-bold text-neutral-800">{item.score}</span>
            </div>
            <p class="text-xs text-neutral-600">{item.label}</p>
          </div>
        ))}
      </div>
      <p class="text-xs text-neutral-400 mb-8 italic">* Scores estimes — API PageSpeed quota epuise au moment de l'audit. Base sur mesures directes (TTFB 184ms, jQuery 87Ko + Bootstrap non purge, hero lazy).</p>

      <!-- PageSpeed Desktop -->
      <h3 class="font-semibold text-neutral-700 mb-4 text-sm uppercase tracking-wide">PageSpeed Insights — desktop (estimation)</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        {[
          { label: 'Performance', score: pagespeedDesktop.perf },
          { label: 'Accessibilite', score: pagespeedDesktop.access },
          { label: 'Bonnes pratiques', score: pagespeedDesktop.bp },
          { label: 'SEO', score: pagespeedDesktop.seo },
        ].map(item => (
          <div class="bg-white rounded-xl p-4 text-center shadow-sm border border-neutral-100">
            <div class="relative w-16 h-16 mx-auto mb-2">
              <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                  fill="none" stroke="#e5e7eb" stroke-width="3" />
                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                  fill="none" stroke={scoreColor(item.score)} stroke-width="3"
                  stroke-dasharray={`${item.score}, 100`} stroke-linecap="round" />
              </svg>
              <span class="absolute inset-0 flex items-center justify-center text-lg font-bold text-neutral-800">{item.score}</span>
            </div>
            <p class="text-xs text-neutral-600">{item.label}</p>
          </div>
        ))}
      </div>

      <!-- Observatory -->
      <div class="flex items-center gap-4 mb-8 p-4 bg-white rounded-xl border border-neutral-100">
        <div class="text-center">
          <span class={`text-4xl font-black ${observatoryData.score >= 90 ? 'text-green-600' : observatoryData.score >= 60 ? 'text-amber-600' : 'text-red-600'}`}>
            {observatoryData.grade}
          </span>
          <p class="text-xs text-neutral-500 mt-1">Mozilla Observatory</p>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-neutral-800">{observatoryData.score}/100 — {observatoryData.passed}/{observatoryData.total} tests passes</p>
          <p class="text-sm text-neutral-500">HSTS, X-Frame, CSP present. CSP trop permissive (unsafe-eval/inline). SRI absent.</p>
        </div>
      </div>

      <!-- Checklist technique -->
      <h3 class="font-semibold text-neutral-700 mb-4 text-sm uppercase tracking-wide">Checklist Schema.org + OG + SEO</h3>
      <div class="grid sm:grid-cols-2 gap-2">
        {techChecks.map(item => (
          <div class={`flex items-start gap-3 p-3 rounded-lg ${item.ok ? 'bg-green-50' : item.critical ? 'bg-red-50' : 'bg-amber-50'}`}>
            <span class={`shrink-0 text-base mt-0.5 ${item.ok ? 'text-green-500' : 'text-red-500'}`}>{item.ok ? '✓' : '✗'}</span>
            <div>
              <span class={`text-sm font-medium ${item.ok ? 'text-green-800' : item.critical ? 'text-red-800' : 'text-amber-800'}`}>{item.label}</span>
              {item.warning && <p class="text-xs text-amber-600 mt-0.5">{item.warning}</p>}
            </div>
          </div>
        ))}
      </div>

      <!-- Points techniques cles -->
      <div class="mt-6 p-4 bg-red-50 border border-red-100 rounded-xl">
        <p class="font-semibold text-red-800 text-sm mb-2">3 anomalies critiques detectees</p>
        <ul class="text-sm text-red-700 space-y-1 list-disc list-inside">
          <li>Page /desamiantage en 404 — lien mort dans le menu principal</li>
          <li>Meta description mentionne "Maison Riva" (une autre entreprise) — erreur de template</li>
          <li>Schema.org absent — les 32 avis Google ne remontent pas dans les SERP</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ VISITEURS -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
      <p class="text-neutral-500 mb-6">
        Sur 10 visiteurs simules : <strong class="text-green-600">{convertis} convertissent</strong>, <strong class="text-amber-600">{hesitants} hesitent</strong>, <strong class="text-neutral-500">{quittes} repartent</strong>
      </p>

      <!-- Legende -->
      <div class="flex gap-4 mb-6 flex-wrap">
        <span class="flex items-center gap-1.5 text-xs text-neutral-600"><span class="w-3 h-3 rounded-full bg-green-400 inline-block"></span>Convertit</span>
        <span class="flex items-center gap-1.5 text-xs text-neutral-600"><span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>Hesite</span>
        <span class="flex items-center gap-1.5 text-xs text-neutral-600"><span class="w-3 h-3 rounded-full bg-neutral-300 inline-block"></span>Quitte</span>
      </div>

      <!-- Personas -->
      <div class="space-y-3">
        {personas.map(p => (
          <details class={`group border rounded-xl overflow-hidden ${decisionColor(p.decision)}`}>
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                  <h3 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h3>
                  <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[11px] text-violet-600 bg-violet-50 px-1.5 py-0.5 rounded">{p.maturite}</span>
                  <span class={`text-[11px] font-semibold px-1.5 py-0.5 rounded ${decisionBadge(p.decision)}`}>{p.decision}</span>
                </div>
                <p class="text-xs text-neutral-500">{p.situation}</p>
              </div>
              <svg class="w-5 h-5 text-neutral-400 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class={`px-4 pb-4 pt-0 border-t ${p.decision === 'Convertit' ? 'border-green-200' : p.decision === 'Hesite' ? 'border-amber-200' : 'border-neutral-200'} bg-white/60`}>
              <div class="grid gap-3 text-xs mt-3">
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Premiere impression</p>
                  <p class="text-neutral-600">{p.premierImpression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Parcours : <span class="font-normal text-neutral-500">{p.parcours.join(' → ')}</span></p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Question cle</p>
                  <p class="text-neutral-600 italic">"{p.questionCle}"</p>
                  <p class="text-neutral-600 mt-1">Reponse du site : <strong>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <div>
                  <p class="font-semibold text-amber-700 mb-1">Impact technique</p>
                  <p class="text-neutral-600">{p.impactTechnique}</p>
                </div>
                <div class="flex gap-4">
                  <div class="flex-1">
                    <p class="font-semibold text-green-700 mb-1">Points positifs</p>
                    <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                      {p.pointsPositifs.map(pt => <li>{pt}</li>)}
                    </ul>
                  </div>
                  <div class="flex-1">
                    <p class="font-semibold text-red-700 mb-1">Frictions</p>
                    <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                      {p.frictions.map(f => <li>{f}</li>)}
                    </ul>
                  </div>
                </div>
                <div class="flex gap-3 pt-1">
                  <span class="text-[11px] bg-neutral-100 text-neutral-600 px-2 py-1 rounded">Exp {p.scores.exp}/10</span>
                  <span class="text-[11px] bg-neutral-100 text-neutral-600 px-2 py-1 rounded">Confiance {p.scores.conf}/10</span>
                  <span class="text-[11px] bg-neutral-100 text-neutral-600 px-2 py-1 rounded">Clarte {p.scores.clarte}/10</span>
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ RECOMMANDATIONS -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Nos recommandations</h2>

      <h3 class="font-semibold text-red-700 mb-4 text-sm uppercase tracking-wide">Le plus important</h3>
      <div class="space-y-4 mb-8">
        {ameliorationsCritiques.map((a, i) => (
          <div class="border-l-4 border-red-400 bg-white p-5 rounded-r-xl shadow-sm">
            <div class="flex items-start gap-3">
              <span class="text-lg font-black text-red-300 shrink-0">{i + 1}</span>
              <div>
                <h4 class="font-bold text-neutral-900 mb-1">{a.titre}</h4>
                <p class="text-sm text-neutral-600 mb-2">{a.detail}</p>
                <p class="text-xs text-red-700 bg-red-50 px-3 py-2 rounded-lg font-medium">Action : {a.action}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <h3 class="font-semibold text-neutral-600 mb-4 text-sm uppercase tracking-wide">Utile aussi</h3>
      <div class="grid sm:grid-cols-3 gap-4">
        {ameliorationsUtiles.map(a => (
          <div class="bg-white p-4 rounded-xl border border-neutral-200">
            <h4 class="font-semibold text-neutral-800 text-sm mb-2">{a.titre}</h4>
            <p class="text-xs text-neutral-500">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ CTA -->
  <section class="bg-neutral-900 text-white py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4">
        {tauxConv}% de vos visiteurs vous contactent.<br/>
        <span class="text-amber-400">On peut faire beaucoup mieux.</span>
      </h2>
      <p class="text-neutral-300 mb-4 max-w-xl mx-auto">
        Vos 32 avis 4.8 etoiles sont votre meilleur argument — mais ils ne sont visibles que sur Google. Un site qui les affiche, qui explique vos services et qui rassure les visiteurs en phase de comparaison : c'est 3x plus de conversions.
      </p>
      <p class="text-neutral-400 text-sm mb-8 max-w-lg mx-auto">
        Sites cles en main a partir de 990 EUR — livres en 7 jours. Specialiste artisans Grand Est.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/commander/" class="inline-flex items-center gap-2 px-8 py-3.5 bg-amber-500 text-white font-semibold rounded-xl hover:bg-amber-400 transition-all shadow-md">
          Je veux un site qui convertit
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/contact/" class="inline-flex items-center gap-2 px-8 py-3.5 border border-neutral-600 text-neutral-300 font-semibold rounded-xl hover:border-amber-400 hover:text-amber-400 transition-all">
          En discuter d'abord
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
