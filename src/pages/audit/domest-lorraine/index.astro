---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX — Domest Lorraine | Marc M';
const description = 'Simulation de 10 visites personas sur domest.fr — rapport UX et technique avec recommandations priorisees pour ce menuisier poseur en Moselle.';

// ============================================================
// DONNEES PROSPECT
// ============================================================
const prospect = {
  name: 'Domest Lorraine',
  url: 'https://www.domest.fr',
  date: '29 mars 2026',
  activity: 'Menuiserie extérieure & automatismes — fenêtres, portes, portails, pergolas, motorisations',
  location: 'Ennery (57) — Entre Metz et Thionville, Moselle',
};

// ============================================================
// KPIs GLOBAUX
// ============================================================
const kpis = {
  conversion: 30,
  experience: 4.8,
  confiance: 5.5,
  clarte: 4.6,
  convertissent: 3,
  hesitent: 3,
  quittent: 4,
};

const constat = "Une entreprise serieuse avec 20 ans d'experience, des equipes internes, la certification RGE QUALIBAT et 32 avis Google a 4,5/5 — mais un site CMS proprietaire lent, sans aucun Schema.org, avec un og:site_name completement casse (affiche \"Lorraine Rnovation\" au lieu de \"Domest Lorraine\"), zero analytics, et une securite HTTP notee F par Mozilla Observatory. Le savoir-faire est reel, le site ne le transmet pas.";

// ============================================================
// CONVERSION PAR CANAL
// ============================================================
const conversionByCanal = [
  { canal: 'Bouche-a-oreille', taux: 100, color: 'text-green-700', bg: 'bg-green-500' },
  { canal: 'Google Maps / GBP', taux: 50, color: 'text-amber-600', bg: 'bg-amber-400' },
  { canal: 'Google Search', taux: 25, color: 'text-amber-600', bg: 'bg-amber-400' },
  { canal: 'Reseaux sociaux (Facebook)', taux: 10, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'IA (ChatGPT/Claude)', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
];

// ============================================================
// TOP FRICTIONS
// ============================================================
const topFrictions = [
  { titre: 'Aucun Schema.org — invisible pour Google enrichi et les IA', count: 9, detail: 'Zero balisage structure sur tout le site. Google ne peut pas afficher adresse, horaires, certifications RGE ni zone d\'intervention dans les resultats. Les IA generatives ignorent completement l\'entreprise. Perte majeure pour un artisan local.' },
  { titre: 'og:site_name casse : "Lorraine Rnovation" au lieu de "Domest Lorraine"', count: 8, detail: 'Chaque partage sur Facebook, LinkedIn ou WhatsApp affiche un nom d\'entreprise incorrect et tronque. Premier signal de negligence avant meme d\'arriver sur le site. Le prospect voit "Lorraine Rnovation" et doute de l\'entreprise.' },
  { titre: 'Architecture technique tres lourde : 22 CSS + 26 JS + RevolutionSlider', count: 7, detail: 'Le slider RevolutionSlider seul charge 11 scripts JS supplementaires. Bootstrap 3 + FontAwesome en 7 variantes. Aucun lazy loading sur les 21 images. Performance mobile estimee a ~35/100 — 60 a 70% des visiteurs mobiles abandonnent avant la fin du chargement.' },
  { titre: 'Aucun analytics — navigation a l\'aveugle totale', count: 6, detail: 'Zero Google Analytics, zero Umami, zero Matomo. L\'entreprise ne sait pas combien de visiteurs elle recoit, d\'ou ils viennent, quelles pages convertissent. Impossible d\'optimiser sans donnees.' },
  { titre: 'Securite HTTP absente — note F (0/100) Mozilla Observatory', count: 5, detail: 'Cookie PHPSESSID sans flag Secure (-40pts), aucun HSTS (-20pts), aucun X-Frame-Options (-20pts), aucune CSP (-25pts). Risques reels de clickjacking et interception de session. Non conforme aux bonnes pratiques ANSSI.' },
];

// ============================================================
// PAGESPEED (ESTIMES — profil CMS proprietaire iKube + jQuery)
// ============================================================
const pagespeed = {
  mobile: { performance: 35, accessibility: 65, bestPractices: 45, seo: 62 },
  desktop: { performance: 58, accessibility: 65, bestPractices: 45, seo: 62 },
};

const coreWebVitals = [
  { name: 'LCP', value: '~5.2s', status: 'bad' },
  { name: 'INP', value: '~450ms', status: 'bad' },
  { name: 'CLS', value: '~0.18', status: 'bad' },
];

const opportunities = [
  { label: 'Supprimer RevolutionSlider et les 11 scripts JS associes', saving: '~3.5s' },
  { label: 'Consolider 22 CSS en 1 fichier optimise (Tailwind tree-shaking)', saving: '~2.0s' },
  { label: 'Activer le lazy loading sur toutes les images hors hero', saving: '~1.5s' },
];

