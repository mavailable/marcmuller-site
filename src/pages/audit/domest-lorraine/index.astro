  { label: 'HTTPS actif (redirection 301)', present: true },
  { label: 'Meta description page d\'accueil', present: true },
  { label: 'Canonical tag defini', present: true },
  { label: 'Viewport correct', present: true },
  { label: 'Sitemap.xml present', present: true },
  { label: 'Alt text sur les images', present: true },
  { label: 'Mentions legales completes (SIRET, RCS, hebergeur)', present: true },
  { label: 'Bandeau cookies RGPD (ihavecookies)', present: true },
  { label: 'Images WebP (partielles)', present: true },
  { label: 'Schema.org LocalBusiness', present: false, critical: true, note: 'Zero balisage structure sur tout le site' },
  { label: 'Open Graph complet (og:title, og:image, og:description)', present: false, critical: true, note: 'og:site_name present mais casse : "Lorraine Rnovation"' },
  { label: 'HSTS (Strict-Transport-Security)', present: false, critical: true },
  { label: 'X-Frame-Options', present: false, critical: true },
  { label: 'Content-Security-Policy', present: false, critical: true },
  { label: 'X-Content-Type-Options', present: false, critical: true },
  { label: 'Cookie session avec flag Secure', present: false, critical: true, note: 'PHPSESSID sans flag Secure ni HttpOnly ni SameSite' },
  { label: 'Analytics (Google Analytics, Umami, Matomo)', present: false, critical: true, note: 'Zero outil de mesure d\'audience' },
  { label: 'Lazy loading sur les images', present: false, critical: true, note: '0/21 images avec loading="lazy"' },
  { label: 'Twitter Card / Social sharing complet', present: false },
  { label: 'llms.txt pour IA generatives', present: false },
