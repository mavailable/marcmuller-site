    </section>

    <!-- ═══════════════════ PANEL 2 : TECHNIQUE ═══════════════════ -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0">
      <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-[var(--color-bg)]">
        <div class="mx-auto max-w-5xl space-y-8">

          <!-- Scores -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {(['mobile', 'desktop'] as const).map(device => (
              <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
                <h3 class="font-semibold text-[var(--color-text)] mb-4 capitalize">{device} — Lighthouse (estimation)</h3>
                <div class="space-y-3">
                  {Object.entries(lighthouseScores[device]).map(([key, val]) => (
                    <div class="flex items-center gap-3">
                      <span class="w-28 text-sm text-[var(--color-text-muted)] capitalize">{key === 'perf' ? 'Performance' : key === 'access' ? 'Accessibilite' : key === 'bp' ? 'Bonnes pratiques' : 'SEO'}</span>
                      <div class="flex-1 h-3 rounded-full bg-neutral-100 overflow-hidden">
                        <div class="h-full rounded-full transition-all" style={`width: ${val}%; background-color: ${scoreColor(val)}`}></div>
                      </div>
                      <span class={`w-10 text-right text-sm font-bold ${scoreTextColor(val)}`}>{val}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- CWV -->
          <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
            <h3 class="font-semibold text-[var(--color-text)] mb-4">Core Web Vitals (estimation Apache/PHP stack)</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-neutral-100">
                    <th class="text-left py-2 pr-4 text-[var(--color-text-muted)] font-medium">Metrique</th>
                    <th class="text-center py-2 px-2 text-[var(--color-text-muted)] font-medium">Mobile</th>
                    <th class="text-center py-2 px-2 text-[var(--color-text-muted)] font-medium">Status</th>
                    <th class="text-center py-2 px-2 text-[var(--color-text-muted)] font-medium">Desktop</th>
                    <th class="text-center py-2 pl-2 text-[var(--color-text-muted)] font-medium">Status</th>
                  </tr>
                </thead>
                <tbody>
                  {Object.entries(cwv).map(([key, val]) => (
                    <tr class="border-b border-neutral-50">
                      <td class="py-2 pr-4 font-medium text-[var(--color-text)] uppercase text-xs">{key}</td>
                      <td class={`py-2 px-2 text-center font-mono ${cwvText(val.mobileStatus)}`}>{val.mobile}</td>
                      <td class="py-2 px-2 text-center">
                        <span class={`px-2 py-0.5 rounded-full text-xs font-medium ${cwvBadge(val.mobileStatus)}`}>{cwvLabel(val.mobileStatus)}</span>
                      </td>
                      <td class={`py-2 px-2 text-center font-mono ${cwvText(val.desktopStatus)}`}>{val.desktop}</td>
                      <td class="py-2 pl-2 text-center">
                        <span class={`px-2 py-0.5 rounded-full text-xs font-medium ${cwvBadge(val.desktopStatus)}`}>{cwvLabel(val.desktopStatus)}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Observatory + Schema + OG + SEO -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <!-- Observatory -->
            <div class={`rounded-xl border p-6 ${gc.border} ${gc.bg}`}>
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-semibold text-[var(--color-text)]">Observatory MDN</h3>
                <span class={`text-4xl font-black ${gc.text}`}>{observatory.grade}</span>
              </div>
              <p class={`text-2xl font-bold ${gc.text} mb-1`}>{observatory.score}<span class="text-base font-normal text-neutral-400">/100</span></p>
              <p class="text-sm text-neutral-500 mb-4">{observatory.passed}/{observatory.total} tests reussis</p>
              <div class="space-y-1 text-xs">
                {missingHeaders.map(h => (
                  <div class="flex items-start gap-2">
                    <span class="text-red-500 mt-0.5">x</span>
                    <span class="text-neutral-600">{h}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Schema.org -->
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
              <h3 class="font-semibold text-[var(--color-text)] mb-4">Schema.org JSON-LD</h3>
              <div class="space-y-1.5 max-h-64 overflow-y-auto">
                {schemaChecks.map(c => (
                  <div class="flex items-center gap-2 text-sm">
                    <span class={c.ok ? 'text-emerald-500' : 'text-red-500'}>{c.ok ? '✓' : '✗'}</span>
                    <span class={c.ok ? 'text-neutral-700' : 'text-neutral-500'}>{c.label}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- OG -->
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
              <h3 class="font-semibold text-[var(--color-text)] mb-4">Open Graph</h3>
              <div class="space-y-1.5">
                {ogChecks.map(c => (
                  <div class="flex items-center gap-2 text-sm">
                    <span class={c.ok ? 'text-emerald-500' : 'text-red-500'}>{c.ok ? '✓' : '✗'}</span>
                    <span class={c.ok ? 'text-neutral-700' : 'text-neutral-500'}>{c.label}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- SEO -->
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
              <h3 class="font-semibold text-[var(--color-text)] mb-4">SEO Technique</h3>
              <div class="space-y-1.5 max-h-64 overflow-y-auto">
                {seoChecks.map(c => (
                  <div class="flex items-center gap-2 text-sm">
                    <span class={c.ok ? 'text-emerald-500' : 'text-red-500'}>{c.ok ? '✓' : '✗'}</span>
                    <span class={c.ok ? 'text-neutral-700' : 'text-neutral-500'}>{c.label}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Bug critique -->
          <div class="rounded-xl border border-red-200 bg-red-50 p-6">
            <h3 class="font-semibold text-red-900 mb-2">Bug critique detecte : placeholder {`{site_name}`} non remplace</h3>
            <p class="text-sm text-red-700 mb-3">Le placeholder <code class="bg-red-100 px-1 rounded">{`{site_name}`}</code> apparait dans 3 champs JSON-LD : <strong>LocalBusiness.description</strong>, <strong>WebPage.description</strong> et <strong>WebPage.name</strong>. Ce bug invalide partiellement les donnees structurees et peut etre signale comme erreur dans Google Search Console.</p>
            <code class="block text-xs bg-red-100 p-3 rounded text-red-800 overflow-x-auto">"description": "Depuis plus de 40 ans, notre societe {`{site_name}`} se charge de..."</code>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════ PANEL 3 : VISITEURS ═══════════════════ -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0">
      <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-[var(--color-bg)]">
        <div class="mx-auto max-w-5xl space-y-6">
          {personas.map(p => (
            <div class={`rounded-xl border p-6 ${decisionBorder(p.decision)}`}>
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div class="flex items-center gap-3">
                  <span class="text-3xl">{p.emoji}</span>
                  <div>
                    <h3 class="font-bold text-[var(--color-text)]">#{p.id} {p.name}, {p.age} ans — {p.role}</h3>
                    <p class="text-sm text-[var(--color-text-muted)]">{p.canal} · {p.device} · <span class="font-medium">{p.maturite}</span></p>
                  </div>
                </div>
                <span class={`px-3 py-1 rounded-full text-sm font-semibold ${decisionColor(p.decision)}`}>{p.decision}</span>
              </div>

              <p class="text-sm text-[var(--color-text-muted)] mb-3 italic">"{p.situation}"</p>

              <div class="grid grid-cols-3 gap-3 mb-4">
                <div class="rounded-lg bg-white/60 p-3 text-center">
                  <p class={`text-xl font-bold ${scoreTextColor(p.exp)}`}>{p.exp}<span class="text-sm text-neutral-400">/10</span></p>
                  <p class="text-xs text-neutral-500">Experience</p>
                </div>
                <div class="rounded-lg bg-white/60 p-3 text-center">
                  <p class={`text-xl font-bold ${scoreTextColor(p.conf)}`}>{p.conf}<span class="text-sm text-neutral-400">/10</span></p>
                  <p class="text-xs text-neutral-500">Confiance</p>
                </div>
                <div class="rounded-lg bg-white/60 p-3 text-center">
                  <p class={`text-xl font-bold ${scoreTextColor(p.clarte)}`}>{p.clarte}<span class="text-sm text-neutral-400">/10</span></p>
                  <p class="text-xs text-neutral-500">Clarte</p>
                </div>
              </div>

              <div class="mb-3">
                <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide mb-1">Parcours</p>
                <div class="flex flex-wrap gap-1">
                  {p.parcours.map((page, i) => (
                    <span class="flex items-center gap-1">
                      <span class="px-2 py-0.5 rounded bg-white/70 text-xs text-neutral-600 border border-neutral-200">{page}</span>
                      {i < p.parcours.length - 1 && <span class="text-neutral-300 text-xs">→</span>}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mb-3">
