            </div>
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-5 text-center">
              <p class="text-3xl md:text-4xl font-bold text-amber-600">{avgExp}<span class="text-lg text-[var(--color-text-muted)]">/10</span></p>
              <p class="mt-1 text-sm text-[var(--color-text-muted)]">Experience</p>
              <div class="mt-2 h-2 rounded-full bg-neutral-100 overflow-hidden">
                <div class="h-full rounded-full bg-amber-500" style={`width: ${scoreBar(Number(avgExp))}`}></div>
              </div>
            </div>
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-5 text-center">
              <p class="text-3xl md:text-4xl font-bold text-blue-600">{avgConf}<span class="text-lg text-[var(--color-text-muted)]">/10</span></p>
              <p class="mt-1 text-sm text-[var(--color-text-muted)]">Confiance</p>
              <div class="mt-2 h-2 rounded-full bg-neutral-100 overflow-hidden">
                <div class="h-full rounded-full bg-blue-500" style={`width: ${scoreBar(Number(avgConf))}`}></div>
              </div>
            </div>
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-5 text-center">
              <p class="text-3xl md:text-4xl font-bold text-orange-600">{avgClarte}<span class="text-lg text-[var(--color-text-muted)]">/10</span></p>
              <p class="mt-1 text-sm text-[var(--color-text-muted)]">Clarte</p>
              <div class="mt-2 h-2 rounded-full bg-neutral-100 overflow-hidden">
                <div class="h-full rounded-full bg-orange-500" style={`width: ${scoreBar(Number(avgClarte))}`}></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Info prospect -->
      <div class="w-full px-6 pb-8 md:px-8">
        <div class="mx-auto max-w-5xl">
          <div class="rounded-xl border border-green-200 bg-green-50 p-6 mb-8">
            <h2 class="text-lg font-bold text-green-900 mb-3">Klein Paysages — Moulins-les-Metz</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-green-800">
              <div>
                <p><strong>Activite :</strong> Paysagiste, entretien espaces verts</p>
                <p><strong>Experience :</strong> 40+ ans, 3 generations familiales</p>
                <p><strong>Zone :</strong> Rayon 50 km autour de Moulins-les-Metz (Moselle)</p>
                <p><strong>Tel :</strong> 03 87 63 83 46</p>
              </div>
              <div>
                <p><strong>Avis Google :</strong> <span class="font-bold text-green-700">4.9/5 sur 49 avis</span> (excellent)</p>
                <p><strong>Email :</strong> f.kleinpaysage@outlook.fr (non pro)</p>
                <p><strong>Certification :</strong> Certibiocide (desinsectisation/deratisation)</p>
                <p><strong>Site :</strong> CMS Futur Digital — Apache PHP — 66 pages SEO</p>
              </div>
            </div>
          </div>

          <!-- Maturite x Conversion -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-6">
              <h3 class="font-semibold text-[var(--color-text)] mb-4">Conversion par maturite</h3>
              <div class="space-y-3">
                {maturiteStats.map(m => (
                  <div class="flex items-center gap-3">
                    <span class="w-28 text-sm text-[var(--color-text-muted)] shrink-0">{m.level}</span>
                    <div class="flex-1 h-2 rounded-full bg-neutral-100 overflow-hidden">
                      <div class="h-full rounded-full bg-emerald-500" style={`width: ${m.pct}`}></div>
                    </div>
                    <span class="w-8 text-right text-sm font-medium text-[var(--color-text)]">{m.pct}</span>
                    <span class="text-xs text-neutral-400">({m.total})</span>
