---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX + Technique — Marc M | Auto-audit 120 personas (V4)';
const description = 'Rapport confidentiel : simulation de 120 visites personas + audit technique complet de marcm.fr — agence web solo.';

// ─── VERSION TIMELINE ───
const showTimeline = true;
const versionActuelle = 'v4';
const versionsData = [
  { version: 'v3', date: '2026-03-31 matin', formule: 'Pro 100 + Complet 20', nbPersonas: 120, tauxConversion: 32 },
  { version: 'v4', date: '2026-03-31 après-midi', formule: 'Suivi complet 120', nbPersonas: 120, tauxConversion: 57 },
];

// ─── DETAILED PERSONAS (20 — full visit feedback) ───
const detailedPersonas = [
  { id: 1, name: 'Stephane', age: 47, situation: 'Plombier-chauffagiste, Woippy', canal: 'Google Search', maturite: 'Comparaison', device: 'Mobile', decision: 'Hesite', exp: 6, conf: 5, clarte: 8, emoji: '🔧', contexte: 'Son concurrent vient de lancer un site moderne, il perd des appels depuis 6 mois', question: '490 euros c\'est tout compris ?', reponse: 'Partiellement', commentReponse: 'Prix HT clair mais le total avec options (GBP +90, galerie +90) n\'est pas presente en pack. Pas de "budget type artisan".', impression: 'Ecran blanc 4.5s sur Samsung. Le hero apparait enfin : prix 490 euros visible, CTA clair. Se demande si c\'est trop beau pour etre vrai.', parcours: [['Hero', 'Prix et delai visibles. "Base a Metz" — c\'est local, bon point'], ['Le constat', 'Se reconnait : concurrent sur Google, lui non'], ['Chiffres', 'Compteur "0+" projets — chiffre modeste, credibilite en baisse'], ['Temoignages', 'Cherche un artisan BTP parmi les avis'], ['Offre', 'Paiement 3x165 euros rassure. Options a la carte transparentes'], ['FAQ', '"490 c\'est un template ? Non." — reponse directe et honnete']], impactTech: 'LCP 4.5s mobile = attente douloureuse entre deux chantiers. Desktop aurait ete parfait. Grade B securite invisible pour lui.', positifs: ['Prix affiche immediatement, pas de devis a demander', '"Base a Metz" — credibilite locale', 'Section "Le constat" decrit exactement sa situation', 'Paiement en 3x clairement affiche', 'FAQ directe et honnete'], frictions: ['LCP 4.5s mobile : risque d\'abandon', 'Compteur projets modeste', 'Pas d\'exemple artisan BTP en homepage', '"HT" peut creer une surprise (588 TTC)', 'Pas de garantie explicite', 'Pas d\'etude de cas chiffree avant/apres'], raison: 'Prix attractif et paiement 3x rassurant, mais 490 euros semble trop beau. Va probablement envoyer un WhatsApp plutot que commander.', changement: 'Temoignage artisan BTP local avec resultats chiffres + garantie de resultat' },
  { id: 2, name: 'Emilie', age: 34, situation: 'Estheticienne a domicile, Montigny-les-Metz', canal: 'Google Maps', maturite: 'Decision', device: 'Mobile', decision: 'Hesite', exp: 7, conf: 7, clarte: 7, emoji: '💅', contexte: 'Ses clientes demandent un lien pour reserver, elle n\'a qu\'Instagram. A essaye Wix sans succes', question: 'Je peux payer en plusieurs fois ?', reponse: 'Oui', commentReponse: 'Page offre affiche "2x245 ou 3x165". Mais le fractionnement pour le total avec options (490+180=670) n\'est pas precise.', impression: 'Arrive depuis la fiche GBP (5 etoiles). LCP 4.5s iPhone. Hero : 490 euros, 7 jours. Different de Wix mais pas forcement plus cher sur 3 ans.', parcours: [['Hero', 'Prix 490 euros et delai 7 jours — different de Wix mais one-shot'], ['FAQ', '"C\'est pour qui ?" — voit therapeutes dans la liste, s\'identifie'], ['Offre', '3x165 euros rassurant. Option RDV +180 euros = 670 HT total, depasse le budget'], ['FAQ offre', '"Mon site m\'appartient ? Oui. Zero abonnement." — argument anti-Wix decisif'], ['Realisations', 'Cherche un site beaute/bien-etre dans les filtres']], impactTech: 'LCP 4.5s iPhone perceptible mais tolerable. Fiche GBP positive pre-dispose bien.', positifs: ['Paiement fractionne clairement affiche', '"Zero abonnement, zero lock-in" — argument anti-Wix parfait', 'Option RDV en ligne disponible', 'FAQ rassurante sur la redaction des textes'], frictions: ['Total 670 HT avec RDV depasse le budget initial', 'Pas de pack "metier beaute" a prix forfaitaire', 'Pas de demo du systeme de reservation', 'LCP mobile degrade la premiere impression'], raison: 'Le produit correspond mais le cout total (670 HT) depasse ses attentes. Va envoyer un WhatsApp pour demander si le 3x s\'applique au total.', changement: 'Pack "beaute" (site + RDV + galerie) a prix forfaitaire + exemple concret' },
  { id: 3, name: 'Karim', age: 52, situation: 'Gerant entreprise de peinture (6 employes), Nancy', canal: 'Bouche-a-oreille', maturite: 'Decision', device: 'Desktop', decision: 'Convertit', exp: 9, conf: 8, clarte: 9, emoji: '🎨', contexte: 'WordPress lent a 25 euros/mois. Recommande par David Merly (DMulti Services)', question: 'Si je migre, je perds mon referencement ?', reponse: 'Oui', commentReponse: 'FAQ explicite : "Je reprends votre domaine, redirige l\'ancien site, preserve votre referencement." Double confirmation accueil + offre.', impression: 'Desktop 98/100 — charge instantanement. Hero professionnel, coverflow 3D impactant. "C\'est propre." Confiance pre-etablie par la recommandation.', parcours: [['Hero', 'Impression excellente sur desktop. Coverflow 3D moderne vs son WordPress vieilli'], ['Le constat', '"WordPress rame et coute cher" — decrit exactement sa situation'], ['FAQ', 'Migration traitee explicitement : domaine, redirections, SEO preserve'], ['Realisations', 'Filtre Batiment — trouve des exemples de son secteur'], ['Qui suis-je', '40 ans, Messin, entrepreneur — profil credible, pas corporate'], ['Offre', 'Section Sur Mesure pour sites complexes, devis gratuit 48h']], impactTech: 'Desktop 98/100 = le site est sa propre vitrine. La vitesse demontre la qualite du produit. Grade B securite invisible.', positifs: ['Vitesse desktop impeccable — meilleure demo possible', 'FAQ migration/referencement repond directement', 'Recommandation confirmee par la qualite du site', 'Exemples batiment dans les realisations', 'Ton direct et personnel'], frictions: ['Compteur 11+ projets modeste pour un dirigeant', 'Pas de comparatif chiffre avant/apres WordPress', 'Pas de SLA (engagement delai reponse)', 'Pas de CGV consultables'], raison: 'Recommandation + site ultra-rapide + FAQ migration = confiance maximale. Contacte via WhatsApp pour un devis sur mesure.' },
  { id: 4, name: 'Chloe', age: 29, situation: 'Photographe independante debutante, Strasbourg', canal: 'Instagram', maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte', exp: 5, conf: 4, clarte: 6, emoji: '📸', contexte: 'A vu marcm.fr dans le footer d\'un site client sur Instagram. Veut un portfolio en ligne', question: 'Portfolio photo possible ?', reponse: 'Partiellement', commentReponse: 'Le mot "portfolio" n\'apparait pas en FR. Option galerie photos +90 euros correspond mais pas formulee pour photographes.', impression: 'LCP 4.5s mobile, hesite a revenir sur Instagram. Design elegant mais cherche des exemples de portfolios photo.', parcours: [['Hero', 'Design moderne, rassure une creatrice sensible a l\'esthetique'], ['Le constat', '"Site generique qui ne vous ressemble pas" resonne'], ['Realisations', 'Cherche un photographe — ne trouve pas d\'exemple'], ['Offre', 'Galerie +90, animations +90 = 670 HT total — gros investissement pour debutante'], ['FAQ', '"Photographes" cite dans la cible mais sans exemple concret']], impactTech: 'LCP 4.5s iPhone — habituee a Instagram instantane, trouve ca lent.', positifs: ['Design du site coherent avec ses attentes esthetiques', '"Photographes" cite dans la cible', 'Option galerie a prix raisonnable', '"Construit de zero, pas un template"'], frictions: ['Aucun exemple de portfolio photographe', 'Mot "portfolio" absent du site FR', '670 HT = gros investissement sans revenus stables', 'Pas de demo galerie lightbox', 'Pas de features photographe (masonry, protection images)'], raison: 'Sans exemple de portfolio photographe, ne peut pas se projeter. Quitte et pourrait revenir si recommandation directe.', changement: 'Un exemple de site photographe dans les realisations + page dediee "createurs"' },
  { id: 5, name: 'Jean-Marc', age: 58, situation: 'Expert-comptable associe (3 personnes), Thionville', canal: 'Google Search', maturite: 'Comparaison', device: 'Desktop', decision: 'Hesite', exp: 7, conf: 5, clarte: 7, emoji: '📊', contexte: 'Devis recu a 3500 d\'une agence. Un client lui a dit "je vous ai trouve sur Google" — il n\'a pas de site', question: 'C\'est serieux a ce prix ?', reponse: 'Partiellement', commentReponse: 'La FAQ est transparente mais le prix tres bas par rapport aux devis recus cree un doute. Pas de reference dans le secteur liberal.', impression: 'Desktop rapide, design professionnel. Le prix 490 euros le surprend — 7x moins que le devis recu. Cherche des signes de serieux.', parcours: [['Hero', '490 euros vs 3500 du devis = trop beau ? Mais le site est pro'], ['Qui suis-je', '20 ans d\'entrepreneuriat, 4 secteurs — profil atypique mais credible'], ['Realisations', 'Cherche un cabinet liberal — ne trouve pas d\'equivalent'], ['Offre', 'Tarifs transparents, options detaillees. Le "HT" le rassure (il est comptable)'], ['FAQ', 'Lit tout attentivement. "490 c\'est un template ? Non" — doit etre vrai vu la qualite du site']], impactTech: 'Desktop 98/100 — excellent. Le site demontre la competence.', positifs: ['Prix transparent et fractionnable', 'Site lui-meme est la preuve de qualite', 'FAQ complete et honnete', 'Le "HT" est un signal pro (il est comptable)'], frictions: ['490 euros = 7x moins que le devis, cree un doute', 'Pas de reference secteur liberal', 'Compteur projets modeste', 'Pas de garantie ou SLA', 'Pas de case study avec ROI chiffre'], raison: 'Interesse mais mefiant — le prix trop bas cree paradoxalement de la defiance. Va probablement appeler pour "prendre la temperature" avant de s\'engager.', changement: 'Un temoignage ou exemple dans le secteur liberal + explication du "comment c\'est possible a ce prix"' },
  { id: 6, name: 'Lea', age: 31, situation: 'Fleuriste, boutique 3 ans, Metz centre', canal: 'ChatGPT', maturite: 'Comparaison', device: 'Mobile', decision: 'Hesite', exp: 7, conf: 6, clarte: 6, emoji: '🌸', contexte: 'ChatGPT lui a recommande marcm.fr parmi 3 options locales. Veut commande en ligne de bouquets', question: 'L\'option e-commerce gere les commandes ?', reponse: 'Partiellement', commentReponse: 'L\'option e-commerce +250 euros existe mais le perimetre exact (panier, paiement, stock) n\'est pas detaille sur le site.', impression: 'LCP 4.5s mobile. Hero pro. ChatGPT avait raison — le site est serieux. Mais cherche des details sur le e-commerce.', parcours: [['Hero', 'Confirme la recommandation IA — site pro, prix clair'], ['Offre', 'E-commerce +250 euros visible mais description courte'], ['Realisations', 'Cherche un commerce avec panier — pas evident a trouver'], ['FAQ', 'Pas de question specifique sur le e-commerce'], ['Contact', 'Hesite entre commander et demander des precisions']], impactTech: 'LCP 4.5s genant apres l\'instantaneite de ChatGPT. Grade B invisible.', positifs: ['Recommandation ChatGPT confirmee par la qualite', 'Prix base accessible', 'Metz centre = proximite rassurante', 'Options a la carte = transparence'], frictions: ['E-commerce +250 sans details (panier, stock, paiement ?)', 'Pas d\'exemple de boutique en ligne', 'LCP mobile apres ChatGPT instantane', 'Total 740 HT (site+e-commerce) = investissement'], raison: 'Interessee mais ne comprend pas exactement ce que couvre le e-commerce a 250 euros. Va contacter pour clarifier.', changement: 'Description detaillee du module e-commerce + exemple de boutique en ligne' },
  { id: 7, name: 'Patrick', age: 61, situation: 'Menuisier ebeniste, 30 ans de metier, Sarreguemines', canal: 'Google Maps', maturite: 'Decision', device: 'Desktop', decision: 'Convertit', exp: 8, conf: 8, clarte: 8, emoji: '🪵', contexte: 'Sa fille lui a dit "papa, tu DOIS avoir un site". Prépare la transmission de son atelier', question: 'Je suis pas technique, c\'est grave ?', reponse: 'Oui', commentReponse: 'La FAQ et la methode en 4 etapes sont claires : "Je m\'occupe de tout" et "Vous n\'avez rien a ecrire". Le CMS Keystatic est simple.', impression: 'Desktop rapide. Hero elegant. "Votre site pro, livre en 7 jours" — c\'est simple et direct, pas de jargon. Le carousel montre des sites concrets.', parcours: [['Hero', 'Simple et direct — pas de jargon technique'], ['La methode', '4 etapes claires : "Vous n\'avez rien a ecrire, je m\'occupe de tout"'], ['Realisations', 'Filtre Batiment — voit des sites d\'artisans comme lui'], ['Temoignages', '"Simple, rapide et efficace" — ca lui parle'], ['FAQ', '"C\'est quoi Astro ?" — lit que c\'est plus rapide que WordPress'], ['Commander', 'Le wizard en 4 etapes est simple, pas intimidant']], impactTech: 'Desktop parfait. La vitesse du site l\'impressionne sans qu\'il sache pourquoi.', positifs: ['"Je m\'occupe de tout" repond a sa peur technique', 'Methode en 4 etapes claire et rassurante', 'Exemples artisanat dans les realisations', 'Temoignages authentiques et recents', 'Wizard de commande simple'], frictions: ['Le terme "Astro" peut intimider meme si la FAQ explique', '"CMS Keystatic" = jargon pour lui', 'Pas de video du processus', 'Sarreguemines a 45min — aimerait savoir si c\'est 100% a distance'], raison: 'La promesse "je m\'occupe de tout" + sa fille qui insiste + les exemples artisans = il se lance. Click sur Commander.', changement: 'Une video de 2min montrant le processus du debut a la fin' },
  { id: 8, name: 'Amandine', age: 38, situation: 'Directrice marketing PME industrielle, Luxembourg', canal: 'LinkedIn', maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte', exp: 6, conf: 5, clarte: 8, emoji: '💼', contexte: 'Veille pro dans le train Metz-Luxembourg, a vu un post LinkedIn sur "100 sites pour artisans"', question: 'Il fait du sur-mesure aussi ?', reponse: 'Oui', commentReponse: 'La section "Projet Sur Mesure" existe mais le positionnement global est tres TPE/artisan, pas PME.', impression: 'LCP 4.5s en 4G dans le train. Hero efficace mais "490 euros site vitrine" = pas pour sa PME. Survole rapidement.', parcours: [['Hero', '490 euros = clairement pas pour une PME industrielle'], ['Realisations', 'Parcourt 3-4 projets — que des TPE/artisans'], ['Offre', 'Voit "Projet Sur Mesure" mais sans fourchette de prix'], ['Quitte', 'En 2 minutes, comprend que ce n\'est pas son segment']], impactTech: 'LCP mobile degrade + train 4G = experience mediocre. Mais elle n\'est pas la cible.', positifs: ['Positionnement clair — elle comprend vite que c\'est pour les TPE', 'Design professionnel', 'Pourrait recommander a un artisan de son reseau'], frictions: ['Offre trop "petite" pour une PME', 'Pas de services B2B/corporate', 'Pas de fourchette pour le sur mesure'], raison: 'Hors cible. Quitte en 2 minutes mais retient le lien pour recommander a des artisans.', changement: 'Pas necessaire — persona hors cible. Le site fait bien son travail en communiquant clairement sa cible.' },
  { id: 9, name: 'Youssef', age: 43, situation: 'Restaurateur pizzeria, Hayange', canal: 'Google Search', maturite: 'Comparaison', device: 'Mobile', decision: 'Hesite', exp: 5, conf: 5, clarte: 5, emoji: '🍕', contexte: 'Ses concurrents apparaissent sur Google avec menu et photos. A essaye Wix et abandonne', question: 'Deja fait un site de restaurant avec commande en ligne ?', reponse: 'Non', commentReponse: 'Aucun exemple de restaurant dans les realisations. E-commerce +250 pourrait fonctionner mais pas presente pour la restauration.', impression: 'LCP 4.5s Samsung A54. Hero pro mais Youssef cherche immediatement des exemples de restaurants. Le prix 490 euros l\'attire.', parcours: [['Hero', 'Prix attractif. "7 jours" — parfait, il veut aller vite'], ['Realisations', 'Filtre tous les secteurs — pas de restaurant. Deception'], ['Offre', 'E-commerce +250 mais decrit pour produits, pas commandes repas'], ['FAQ', 'Pas de question sur la restauration'], ['Contact', 'Hesite a contacter sans etre sur que Marc sache faire un site resto']], impactTech: 'LCP 4.5s mobile dans sa pizzeria entre deux services — patience limitee.', positifs: ['Prix imbattable pour la restauration', '7 jours = rapidite appreciee', 'Paiement en 3x accessible', 'Option GBP a 90 euros pertinente pour resto'], frictions: ['Aucun exemple de restaurant', 'E-commerce pas decrit pour la commande de repas', 'Pas de mention menu en ligne, horaires, reservation de table', 'LCP mobile lent', 'Pas clair si le site gere les commandes en ligne type Uber Eats'], raison: 'Le prix l\'attire mais sans exemple restaurant, il doute que Marc comprenne ses besoins specifiques (menu, commande, horaires). Pourrait contacter pour demander.', changement: 'Un exemple de site restaurant + description du module commande pour la restauration' },
  { id: 10, name: 'Marie-Claire', age: 55, situation: 'Presidente asso culturelle (150 adherents), Metz', canal: 'Bouche-a-oreille', maturite: 'Decision', device: 'Tablette', decision: 'Convertit', exp: 8, conf: 9, clarte: 7, emoji: '🎭', contexte: 'L\'ancien site Jimdo est obsolete, l\'adherent qui le gerait a quitte. Budget vote par le bureau. Recommandee par Jennifer De Groeve', question: 'Des benevoles pourront mettre a jour le site ?', reponse: 'Oui', commentReponse: 'La FAQ mentionne le CMS Keystatic "aussi simple qu\'un Google Doc" et la page aide propose des tutoriels. L\'offre Autonomie (0 euros) confirme l\'independence.', impression: 'iPad — chargement correct. Hero rassurant. "490 euros" entre dans le budget associatif. La recommandation de Jennifer la predispose positivement.', parcours: [['Hero', '490 euros = budget OK pour l\'asso'], ['Qui suis-je', 'Marc est local, entrepreneur — pas une agence anonyme'], ['Realisations', 'Pas d\'association mais la diversite des projets rassure'], ['Offre', 'Autonomie 0 euros = parfait pour une asso. CMS pour benevoles.'], ['FAQ', '"Modifications ? CMS simple, aussi simple qu\'un Google Doc"'], ['Aide', 'Tutoriels disponibles — les benevoles pourront suivre'], ['Contact', 'Contacte via formulaire pour un devis sur mesure']], impactTech: 'Tablette iPad OK. Le site est fluide et lisible.', positifs: ['Prix dans le budget associatif', 'Autonomie 0 euros = pas d\'abonnement', 'CMS simple pour benevoles', 'Tutoriels disponibles sur /aide', 'Local et personnel — pas corporate', 'Recommandation pre-etablie'], frictions: ['Pas d\'exemple d\'association dans les realisations', 'Le mot "association" pas assez visible dans la communication', 'CMS Keystatic inconnu des benevoles', 'Pas de mention de fonctionnalites asso (adherents, agenda, newsletter)'], raison: 'Budget OK, recommandation solide, CMS simple pour benevoles. Contacte pour un devis sur mesure adapte a l\'association.', changement: 'Un exemple de site associatif + mention "associations" dans la cible homepage' },
  { id: 11, name: 'Thomas', age: 26, situation: 'Dev web junior, Lyon (freelance le week-end)', canal: 'Perplexity', maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte', exp: 7, conf: 6, clarte: 7, emoji: '💻', contexte: 'Veille technique sur les sites Astro en production en France. Curieux du stack et du modele economique', question: 'Comment il tient 490 en full custom Astro ?', reponse: 'Non', commentReponse: 'Le site ne revele pas son process de production (skills, pipeline, automatisation). Le journal a des articles SEO/business, pas technique.', impression: 'LCP 4.5s mobile — ironic pour un site qui promet la performance. Inspecte le code source : Astro, Tailwind v4, pas de JS inutile. Propre.', parcours: [['Hero', 'Note le stack dans le code source. Design soigne.'], ['Journal', 'Cherche du contenu technique — ne trouve que du SEO/business pour artisans'], ['Realisations', 'Inspecte 2-3 sites clients. Lighthouse 100/100 confirme'], ['Offre', 'Etudie le pricing — se demande comment c\'est rentable'], ['Quitte', 'Garde en memoire pour recommander']], impactTech: 'LCP 4.5s mobile note comme incoherent avec la promesse "charge en moins d\'une seconde".', positifs: ['Code source propre (Astro, Tailwind, zero bloat)', 'Sites clients Lighthouse 100/100', 'Modele economique interessant pour la veille', 'Design soigne et coherent'], frictions: ['LCP 4.5s vs promesse performance', 'Pas de contenu technique dans le journal', 'Pas d\'explication du process de production', 'Pas de page "stack technique" pour les curieux'], raison: 'Pas un prospect mais un pair. Garde marcm.fr en bookmark. Pourrait recommander a des artisans de son entourage.', changement: 'Un article technique dans le journal expliquant le stack' },
  { id: 12, name: 'Nathalie', age: 44, situation: 'Naturopathe en cabinet, Epinal (5 ans)', canal: 'Google Search', maturite: 'Comparaison', device: 'Mobile', decision: 'Hesite', exp: 8, conf: 7, clarte: 8, emoji: '🌿', contexte: 'Divorce = budget serre. 2 devis recus (1200 et 2800 euros). Besoin de plus de clients', question: 'Vous travaillez a distance ?', reponse: 'Oui', commentReponse: 'FAQ : "Base Metz, clients toute France". La page contact confirme Lun-Ven 9h-18h. Mais pas de mention explicite du process a distance.', impression: 'LCP 4.5s iPhone 12. Le prix 490 euros est nettement inferieur a ses devis. Le design est plus pro que ce qu\'elle attendait a ce prix.', parcours: [['Hero', '490 euros vs ses devis 1200/2800 — incroyable. 7 jours aussi.'], ['Realisations', 'Trouve JD Zootherapie — c\'est le bien-etre, ca correspond !'], ['Offre', 'RDV en ligne +180 = 670 HT total. Reste 2x moins cher que son devis le moins cher'], ['FAQ', '"Clients toute France" et "couverture geo" rassurent'], ['Commander', 'Calcule 670 HT en 3x = ~225 par mois. Faisable malgre le divorce']], impactTech: 'LCP 4.5s mobile mais comparee aux sites de ses devis concurrents, c\'est correct.', positifs: ['Prix 3-4x inferieur aux devis concurrents', 'JD Zootherapie = exemple dans son secteur', 'FAQ confirme le travail a distance', 'Paiement fractionne accessible', 'Marc redige les textes — un souci en moins'], frictions: ['Epinal-Metz = distance, pas de mention du process a distance en detail', 'Total 670 HT = quand meme un investissement pendant un divorce', 'Pas de garantie de resultat', 'Le "HT" ajoute ~130 euros surprises'], raison: 'Le prix est imbattable et JD Zootherapie la rassure. Elle va contacter par WhatsApp depuis son cabinet entre deux consultations.', changement: 'Une page "Comment ca marche a distance" + temoignage d\'un client hors Metz' },
