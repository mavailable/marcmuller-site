            <div class="text-xs text-neutral-400">{convertis} / 120 personas</div>
            <div class="text-xs text-emerald-600 font-medium mt-1">V4 : 57% (+25pp)</div>
          </div>
          <div class="bg-white rounded-xl border border-neutral-200 p-5 text-center shadow-sm">
            <div class="text-3xl font-bold text-neutral-800">{avgExp}</div>
            <div class="text-sm text-neutral-500 mt-1">Experience / 10</div>
          </div>
          <div class="bg-white rounded-xl border border-neutral-200 p-5 text-center shadow-sm">
            <div class="text-3xl font-bold text-neutral-800">{avgConf}</div>
            <div class="text-sm text-neutral-500 mt-1">Confiance / 10</div>
          </div>
          <div class="bg-white rounded-xl border border-neutral-200 p-5 text-center shadow-sm">
            <div class="text-3xl font-bold text-neutral-800">{avgClarte}</div>
            <div class="text-sm text-neutral-500 mt-1">Clarte / 10</div>
          </div>
        </div>

        <!-- Paradoxe principal -->
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-6">
          <div class="flex items-start gap-3">
            <span class="text-2xl">⚡</span>
            <div>
              <h3 class="font-semibold text-amber-900 mb-1">Le paradoxe principal</h3>
              <p class="text-amber-800 text-sm leading-relaxed">
                <strong>V3 : LCP mobile 4.5s, perf 79/100 — V4 : LCP 2.4s, perf 97/100.</strong> Le LCP a été résolu sans optimisation image explicite (probable effet CSP middleware). Le portfolio sectoriel reste la friction #1 : sur 120 personas, ~30 ne trouvent toujours pas d'exemple dans leur secteur. Le taux de conversion V3 était de {tauxConversion}% — <strong>V4 : 57%</strong> (+25pp).
              </p>
            </div>
          </div>
        </div>

        <!-- Conversion par canal -->
        <div>
          <h3 class="font-semibold text-neutral-800 mb-4">Conversion par canal</h3>
          <div class="space-y-3">
            {canalStats.map(c => {
              const pctConv = Math.round((c.conv / c.total) * 100);
              const pctHes = Math.round((c.hesitant / c.total) * 100);
              const pctQuit = Math.round(((c.total - c.conv - c.hesitant) / c.total) * 100);
              return (
                <div class="bg-white rounded-lg border border-neutral-200 p-4">
                  <div class="flex justify-between items-center mb-2">
                    <span class="text-sm font-medium text-neutral-800">{c.canal}</span>
                    <span class="text-xs text-neutral-400">{c.total} personas</span>
