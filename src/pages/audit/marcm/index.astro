  { title: 'Module e-commerce/reservation flou', severity: 'haute', count: 5, detail: 'Les options e-commerce (+250) et RDV (+180) manquent de details : commande repas, reservation gite, vente de cours, stock...', statusV4: '⚠️', detailV4: 'V4 : add-ons structurés sur /en/services (commit ec7ad45). Personas EN débloqués. /offre FR toujours peu détaillé. Léa (fleuriste) encore en hésitation.' },
  { title: 'Prix trop bas = mefiance', severity: 'haute', count: 4, detail: '490 euros vs devis concurrents 1200-3500 euros cree un doute. Pas d\'explication du "comment c\'est possible".', statusV4: '⚠️', detailV4: 'V4 : compteur 33+ crédibilise le volume. Jean-Marc (expert-comptable), Romain (coach) encore sceptiques. Pas d\'explication "pourquoi 490€".' },
  { title: 'Pas de garantie / SLA', severity: 'moyenne', count: 4, detail: 'Aucune garantie de resultat, de satisfaction, ou d\'engagement sur les delais de reponse.', statusV4: '❌', detailV4: 'V4 : aucun engagement ajouté.' },
  { title: 'Pas de lead magnet / nurturing', severity: 'moyenne', count: 3, detail: 'Les visiteurs en decouverte (37 personas) convertissent a 3%. Aucun mecanisme pour capter leur email et les recontacter.', statusV4: '❌', detailV4: 'V4 : /formation (poisson d\'avril) ne remplace pas un vrai lead magnet. Sandrine, Lucas toujours sans capture.' },
  { title: 'Compteur projets "0+"', severity: 'moyenne', count: 3, detail: 'L\'animation JS peut bugger et afficher 0. Meme a "11+", c\'est modeste pour rassurer.', statusV4: '✅', detailV4: 'V4 : SSR corrigé (commit 335ce68). Affiche 33+ de manière stable. Crédibilité restaurée.' },
];

const ameliorations = {
  haute: [
    { title: 'Ajouter des exemples par secteur', detail: 'Creer 5-10 sites exemples supplementaires couvrant les secteurs manquants : restaurant, photographe, gite/hebergement, association, profession liberale, commerce de bouche. Utiliser les "sites exemples" deja dans le pipeline.', impact: '43 personas impactes' },
    { title: 'Optimiser le LCP mobile', detail: 'L\'image hero est trop lourde (1456 KiB d\'economies detectees par Lighthouse). Convertir en WebP/AVIF, dimensionner pour mobile, utiliser un srcset responsive. Objectif : LCP < 2.5s.', impact: '12 personas impactes' },
    { title: 'Ajouter "toute la France / 100% a distance" visible dans le hero', detail: 'Mentionner explicitement que le service est disponible partout en France et 100% a distance. Actuellement, seul "Base a Metz" est visible — ce qui fait fuir les personas hors Grand Est.', impact: '10 personas impactes' },
    { title: 'Ajouter le schema Article aux articles de blog', detail: 'La fonction getArticleSchema() existe dans schemas.ts mais n\'est jamais appelee. Ajouter <SchemaOrg type="article" /> aux 10 articles du journal. Impact SEO immediat : rich snippets Google.', impact: 'SEO critique — 10 articles' },
    { title: 'Detailler les modules e-commerce et reservation', detail: 'Sur la page Offre, decrire precisement : e-commerce = catalogue + panier + paiement Stripe en ligne. Reservation = calendrier de dispos + choix de dates + confirmation email. Avec screenshots.', impact: '5 personas impactes' },
