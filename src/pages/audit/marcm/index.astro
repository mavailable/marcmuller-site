    { title: 'Ajouter un Content-Security-Policy', detail: 'Le seul test echoue sur Observatory. Un CSP basique dans _headers ferait passer le grade de B a A.', impact: 'Securite — grade B vers A' },
    { title: 'Creer un lead magnet', detail: 'Un guide PDF "5 choses a preparer avant de lancer son site" + capture email. Les 37 personas en decouverte convertissent a 3% — un lead magnet en capterait 5-10.', impact: '6+ personas en decouverte' },
    { title: 'Fixer le compteur de projets', detail: 'Afficher le vrai nombre (31 realisations) au lieu de "0+" avec une animation fragile. Ou mieux : "31 projets livres".', impact: '3 personas impactes' },
    { title: 'Mentionner la conformite professions de sante', detail: 'Ajouter une mention "conforme aux regles deontologiques des professions reglementees" dans la FAQ ou l\'offre. 6 personas de sante cherchent cette information.', impact: '6 personas impactes' },
    { title: 'Ajouter "echange 15 min (tel, visio ou ecrit)" partout', detail: 'Rendre le premier contact accessible a tous : telephone pour les seniors, visio pour les technophiles, ecrit pour les personnes sourdes ou reservees.', impact: 'Accessibilite — 120 personas' },
  ],
  discussion: [
    { emoji: '📦', title: 'Packs metier pre-configures', detail: 'Ex : "Pack Artisan BTP" (site + GBP + galerie = 670 HT), "Pack Sante" (site + RDV = 670 HT). Simplifie le choix et augmente le panier moyen.' },
    { emoji: '🎥', title: 'Video du processus', detail: 'Une video de 2 minutes montrant un projet de A a Z. Les seniors et les mefians seraient convaincus plus vite.' },
    { emoji: '📧', title: 'Nurturing post-visite (newsletter)', detail: 'Sequence email pour les 31 personas en decouverte qui ne sont pas prets. "Pas encore pret ? Voici quoi faire en attendant."' },
    { emoji: '🔗', title: 'Redirection personas negatifs vers partenaires', detail: 'Pour les besoins hors scope (e-commerce complexe, immo, SaaS), proposer un partenaire plutot que laisser partir sans rien.' },
    { emoji: '🤝', title: 'Programme prescripteur/parrainage', detail: 'Les 15 personas bouche-a-oreille convertissent a 73%. Un programme de parrainage structurerait ce canal naturel.' },
    { emoji: '🌍', title: 'Sites bilingues FR/DE mentionnes', detail: 'Plusieurs personas frontaliers (Forbach, Sarreguemines, Wissembourg) cherchent un site bilingue francais-allemand. Mentionner cette capacite.' },
  ],
};

// V3: perf desktop 98 / mobile 79 | V4 mesuré: perf mobile 97 / LCP 2.4s
const pagespeed = {
  desktop: { perf: 98, access: 96, bp: 100, seo: 100 },
  mobile: { perf: 97, access: 95, bp: 92, seo: 100 },
  cwv_desktop: { lcp: '1.0s', cls: '0', tbt: '0ms', fcp: '0.3s', si: '1.2s' },
  cwv_mobile: { lcp: '2.4s', cls: '0', tbt: '0ms', fcp: '1.2s', si: '2.6s' },
};

const observatory = { grade: 'B', score: 75, passed: 9, total: 10 };

const schemaChecks = [
  { label: 'JSON-LD present (WebSite, Person, LocalBusiness, FAQ)', ok: true },
  { label: '@type coherent (ProfessionalService)', ok: true },
  { label: 'name, url, description', ok: true },
  { label: 'address + geo (entreprise locale)', ok: true },
  { label: 'telephone', ok: true },
  { label: 'openingHours', ok: false },
  { label: 'image / logo', ok: true },
  { label: 'sameAs (LinkedIn — manque WhatsApp)', ok: true },
  { label: 'aggregateRating', ok: false },
  { label: 'Article schema sur le journal (11 articles)', ok: true },
  { label: 'potentialAction (SearchAction)', ok: false },
  { label: 'Person : image, email, knowsAbout', ok: false },
];

const ogChecks = [
  { label: 'og:title (dynamique par page)', ok: true },
  { label: 'og:description', ok: true },
  { label: 'og:image (/og-default.png)', ok: true },
  { label: 'og:url (canonique)', ok: true },
  { label: 'og:type (website / article)', ok: true },
  { label: 'og:locale (fr_FR / en_US)', ok: true },
  { label: 'og:site_name', ok: true },
  { label: 'twitter:card (summary_large_image)', ok: true },
  { label: 'twitter:site', ok: true },
  { label: 'meta description', ok: true },
  { label: 'canonical URL', ok: true },
  { label: 'hreflang (FR <-> EN)', ok: true },
];

const securityHeaders = [
  { header: 'Strict-Transport-Security (HSTS)', ok: true },
  { header: 'X-Content-Type-Options', ok: true },
  { header: 'X-Frame-Options', ok: true },
  { header: 'Referrer-Policy', ok: true },
  { header: 'Permissions-Policy', ok: true },
  { header: 'Content-Security-Policy (CSP)', ok: true },
];

function decisionColor(d: string) {
  if (d === 'Convertit') return 'bg-emerald-100 text-emerald-800 border-emerald-200';
  if (d === 'Hesite') return 'bg-amber-100 text-amber-800 border-amber-200';
  return 'bg-red-100 text-red-800 border-red-200';
}

function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}

function compactDecisionColor(d: string) {
  if (d === 'Convertit') return 'bg-emerald-100 text-emerald-700';
  if (d === 'Hesite') return 'bg-amber-100 text-amber-700';
  return 'bg-red-100 text-red-700';
}

function compactBorderColor(d: string) {
  if (d === 'Convertit') return 'border-emerald-200';
  if (d === 'Hesite') return 'border-amber-200';
  return 'border-neutral-200';
}

function scoreColor(v: number) {
  if (v >= 90) return '#22c55e';
  if (v >= 50) return '#f59e0b';
  return '#ef4444';
}

function cwvColor(metric: string, val: string) {
  const n = parseFloat(val);
  if (metric === 'lcp') return n <= 2.5 ? '#22c55e' : n <= 4 ? '#f59e0b' : '#ef4444';
  if (metric === 'cls') return n <= 0.1 ? '#22c55e' : n <= 0.25 ? '#f59e0b' : '#ef4444';
  if (metric === 'tbt') { const ms = parseInt(val); return ms <= 200 ? '#22c55e' : ms <= 600 ? '#f59e0b' : '#ef4444'; }
  if (metric === 'fcp') return n <= 1.8 ? '#22c55e' : n <= 3 ? '#f59e0b' : '#ef4444';
  return '#f59e0b';
}
