<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath="/audit/marcm"
>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>
    <div class="absolute bottom-0 right-0 w-72 h-72 rounded-full opacity-5 blur-3xl" style="background: #818CF8;"></div>

    <div class="mx-auto max-w-4xl relative z-10">
      <div class="mb-4 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]/40">
        <span class="w-2 h-2 rounded-full" style="background-color: #E86C47;"></span>
        <span class="text-sm font-semibold text-white/90">Auto-audit confidentiel</span>
      </div>

      <h1 class="mb-4 text-3xl font-bold leading-tight text-white md:text-4xl lg:text-5xl">
        Audit UX + Technique — <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">Marc M</span>
      </h1>

      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl mb-8">
        Simulation de 120 visites personas + audit technique complet de <strong class="text-white">marcm.fr</strong> — agence web solo, sites vitrines sur mesure.
      </p>

      <div class="flex flex-wrap gap-3">
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">120 personas testes</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">6 canaux d'arrivee</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">56 pages indexees</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm font-medium">31 mars 2026</span>
        <span class="px-4 py-2 rounded-lg text-white text-sm font-semibold" style="background-color: #E86C47;">V4 — Suivi</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ TAB BAR ═══════════════════ -->
  <nav class="sticky top-16 md:top-20 z-40 bg-white/95 backdrop-blur border-b border-neutral-200" id="tab-bar">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 h-12 text-sm overflow-x-auto">
      <button data-tab="0" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-[var(--color-accent)] bg-[var(--color-accent)]/10">Synthese</button>
      <button data-tab="1" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">Technique</button>
      <button data-tab="2" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">
        Visiteurs <span class="ml-1 text-xs text-neutral-400">120</span>
      </button>
      <button data-tab="3" class="tab-btn px-4 py-1.5 rounded-lg font-medium whitespace-nowrap transition-colors text-neutral-500 hover:text-neutral-700">
        Ameliorations <span class="ml-1 text-xs text-neutral-400">{ameliorations.haute.length + ameliorations.moyenne.length}</span>
      </button>
    </div>
  </nav>

  <!-- ═══════════════════ PANELS ═══════════════════ -->
  <div id="panels" class="flex overflow-x-auto snap-x snap-mandatory" style="-webkit-overflow-scrolling: touch; scrollbar-width: none;">

    <!-- ══ PANEL 0 : SYNTHESE ══ -->
    <section class="tab-panel min-w-full w-full snap-start snap-always shrink-0">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">

        <!-- ── TIMELINE V3 → V4 ── -->
        {showTimeline && (
          <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-6">
            <h3 class="font-semibold text-emerald-900 mb-4 flex items-center gap-2">
              <span>📈</span> Évolution V3 → V4 — 31 mars 2026
            </h3>
            <div class="flex items-center gap-4 mb-5">
              {versionsData.map((v, i) => (
                <div class="flex items-center gap-3">
                  <div class={`rounded-xl border p-4 text-center min-w-[120px] ${v.version === versionActuelle ? 'bg-emerald-600 border-emerald-600 text-white' : 'bg-white border-neutral-200 text-neutral-800'}`}>
                    <div class="text-2xl font-bold">{v.tauxConversion}%</div>
                    <div class="text-xs mt-0.5 opacity-80">{v.version.toUpperCase()} · {v.nbPersonas} personas</div>
                    <div class="text-xs opacity-60 mt-0.5">{v.date}</div>
                  </div>
                  {i < versionsData.length - 1 && (
                    <div class="text-2xl text-emerald-600 font-bold">→</div>
                  )}
                </div>
              ))}
              <div class="ml-4 bg-emerald-100 border border-emerald-300 rounded-xl p-4 text-center min-w-[100px]">
                <div class="text-2xl font-bold text-emerald-800">+25pp</div>
                <div class="text-xs text-emerald-700 mt-0.5">Progression</div>
              </div>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
              <div class="bg-white rounded-lg border border-emerald-200 p-3">
                <div class="text-xs text-neutral-500 mb-1">Frictions résolues</div>
                <div class="font-semibold text-emerald-700">2 complètes + 3 partielles</div>
              </div>
              <div class="bg-white rounded-lg border border-emerald-200 p-3">
                <div class="text-xs text-neutral-500 mb-1">Nouvelles frictions</div>
                <div class="font-semibold text-amber-700">1 (i18n auto-EN)</div>
              </div>
              <div class="bg-white rounded-lg border border-emerald-200 p-3">
                <div class="text-xs text-neutral-500 mb-1">Commits V3→V4</div>
                <div class="font-semibold text-neutral-800">6 commits</div>
              </div>
              <div class="bg-white rounded-lg border border-emerald-200 p-3">
                <div class="text-xs text-neutral-500 mb-1">Impact #1</div>
                <div class="font-semibold text-neutral-800">Badge 100% remote</div>
              </div>
            </div>
            <!-- Tableau delta frictions -->
            <div class="mt-5">
              <h4 class="text-sm font-semibold text-emerald-900 mb-3">Tableau delta — 10 frictions V3</h4>
              <div class="overflow-x-auto">
                <table class="w-full text-xs border-collapse">
                  <thead>
                    <tr class="bg-emerald-100">
                      <th class="text-left p-2 border border-emerald-200 text-emerald-800">Friction V3</th>
                      <th class="text-center p-2 border border-emerald-200 text-emerald-800">Sév.</th>
                      <th class="text-center p-2 border border-emerald-200 text-emerald-800">Statut V4</th>
                      <th class="text-left p-2 border border-emerald-200 text-emerald-800">Note V4</th>
                    </tr>
                  </thead>
                  <tbody>
                    {frictions.map(f => (
                      <tr class="border-b border-neutral-100">
                        <td class="p-2 border border-neutral-200 text-neutral-700">{f.title}</td>
                        <td class="p-2 border border-neutral-200 text-center">
                          <span class={`px-1.5 py-0.5 rounded text-xs font-medium ${f.severity === 'critique' ? 'bg-red-100 text-red-700' : f.severity === 'haute' ? 'bg-orange-100 text-orange-700' : 'bg-yellow-100 text-yellow-700'}`}>{f.severity}</span>
                        </td>
                        <td class="p-2 border border-neutral-200 text-center text-base">{f.statusV4 ?? '—'}</td>
                        <td class="p-2 border border-neutral-200 text-neutral-600">{f.detailV4 ?? '—'}</td>
                      </tr>
                    ))}
                    <tr class="bg-blue-50">
                      <td class="p-2 border border-neutral-200 text-blue-800 font-medium">🆕 i18n auto-EN</td>
                      <td class="p-2 border border-neutral-200 text-center"><span class="px-1.5 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">nouvelle</span></td>
                      <td class="p-2 border border-neutral-200 text-center text-base">🆕</td>
                      <td class="p-2 border border-neutral-200 text-blue-700">Visiteurs FR avec navigateur EN reçoivent le site anglais. ~5–8 personas. Ajouter bandeau "Voir en français ?".</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )}

        <!-- KPI Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-white rounded-xl border border-neutral-200 p-5 text-center shadow-sm">
            <div class="text-3xl font-bold text-[var(--color-accent)]">{tauxConversion}%</div>
