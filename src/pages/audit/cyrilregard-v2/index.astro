// ==================== PERSONAS V2 ====================
const personas = [
  { id: 1, name: 'Nathalie', age: 43, emoji: '⚖️', canal: 'Google Search', device: 'Desktop', maturite: 'Comparaison', situation: 'Resp. communication cabinet avocats (200 pers.), Paris 8e', contexte: 'Soiree clients 120 pers. au Ritz, budget 3-5k€, compare 5 prestataires avec tableau Excel.', parcours: ['Accueil', 'Logos', 'Temoignage Baschiera', 'Cherche PDF', 'Contact'], decision: 'hesite', scores: { exp: 6, conf: 7, clarte: 5 }, premierImpression: 'LCP 3.2s — dernier onglet a charger parmi ses 5 comparaisons. Visuellement elegant une fois charge. Les logos captent immediatement l\'attention.', questionCle: 'Avez-vous un dossier de presentation a envoyer a mes associes ?', reponse: 'Non', commentReponse: 'Aucun PDF, aucun kit media. Elle devra faire un copier-coller artisanal du site — impensable pour un cabinet d\'avocats.', impactTechnique: 'LCP 3.2s — dernier des 5 onglets a charger. Securite D- risque si proxy corporate strict.', pointsPositifs: ['Logos grands comptes immediatement visibles', 'Temoignage Baschiera (PDG Moet) = vrai decideur', 'Version anglaise disponible', 'Tel et email accessibles'], frictions: ['Pas de dossier de presse PDF', 'Zero tarif — ne peut pas pre-valider le budget', 'Pas d\'etude de cas detaillee', 'Pas de delai de reponse annonce'] },
  { id: 2, name: 'Romain', age: 37, emoji: '🏦', canal: 'Bouche-a-oreille', device: 'Mobile', maturite: 'Decision', situation: 'Directeur agence bancaire Reims, 30 collaborateurs', contexte: 'Soiree Noel equipe dans 6 semaines. A vu Cyril il y a 3 mois. Decision quasi prise.', parcours: ['Accueil', 'Confirme identite', 'Telephone (06 76 49 72 19)', 'Appelle'], decision: 'convertit', scores: { exp: 8, conf: 9, clarte: 8 }, premierImpression: 'Reconnait "son" magicien. Mobile 93/100, fluide. Pas de CLS. Il cherche juste le numero.', questionCle: 'Comment le joindre maintenant ?', reponse: 'Oui', commentReponse: 'Telephone visible et cliquable. Appel direct en 15 secondes.', impactTechnique: 'Mobile 93/100. LCP 3.2s tolere car deja convaincu. Pas de CLS mobile.', pointsPositifs: ['Telephone directement visible et cliquable', 'Identite confirmee en secondes', 'Mobile fluide apres chargement', 'Logos renforcent sa decision'], frictions: ['LCP 3.2s — 2 secondes de flottement pour juste un numero', 'Pas de WhatsApp (reflexe plus naturel pour un 37 ans)', 'Pas de delai de reponse si repondeur'] },
  { id: 3, name: 'Claire', age: 56, emoji: '💄', canal: 'LinkedIn', device: 'Desktop', maturite: 'Decision', situation: 'DG cosmetiques haut de gamme (600 salaries), Neuilly', contexte: 'Gala 50 ans de la marque, 200 VIP + presse, budget 8-15k€. Contact LinkedIn l\'a oriente.', parcours: ['Accueil', 'Logos (LVMH, Le Bristol)', 'Temoignage Baschiera', 'Version EN', 'Contact'], decision: 'hesite', scores: { exp: 6, conf: 7, clarte: 5 }, premierImpression: 'LCP 3.2s perceptible pour une DG habituee au premium digital. Visuel elegant une fois charge. Les logos font le travail.', questionCle: 'Ce prestataire est-il a la hauteur d\'un gala de 200 VIP ?', reponse: 'Partiellement', commentReponse: 'Logos et temoignage Baschiera disent oui. Mais pas de portfolio detaille ni de dossier pour convaincre son board.', impactTechnique: 'Desktop 77/100. LCP 3.2s legerement decevant. CLS intermittent possible.', pointsPositifs: ['Logos luxe = validation culturelle immediate', 'Temoignage Baschiera = credibilite C-level', 'Version EN bilingue', 'Email professionnel (cyril@cyrilregard.com)'], frictions: ['Pas de portfolio gala detaille', 'Pas de dossier de presse pour son board', 'Pas de Calendly pour un call', 'Aucun signal de gamme tarifaire'] },
  { id: 4, name: 'Kenji', age: 34, emoji: '🎯', canal: 'IA (ChatGPT)', device: 'Desktop', maturite: 'Comparaison', situation: 'Event planner freelance tech/startup, Paris', contexte: 'Client US lance bureau parisien, 80 pers., 4-7k€, anglais obligatoire. Compare 3 prestataires.', parcours: ['Switch EN', 'Logos', 'Cherche video', 'Cherche pricing', 'Contact'], decision: 'hesite', scores: { exp: 5, conf: 6, clarte: 4 }, premierImpression: 'LCP 3.2s — le plus lent de ses 3 onglets. Signal negatif pour un profil tech. Version EN existante = bon point.', questionCle: 'What\'s the investment for an 80-person cocktail in Paris?', reponse: 'Non', commentReponse: 'Zero information tarifaire en FR ou EN. Ne peut pas pre-qualifier le budget pour son client.', impactTechnique: 'Desktop 77/100, LCP 3.2s = le plus lent de sa comparaison. Securite D- potentiellement visible.', pointsPositifs: ['Version anglaise professionnelle', 'Logos internationaux (BMW, Rolls, LVMH)', 'Temoignages C-level convaincants'], frictions: ['Zero pricing = impossible de budgeter', 'Pas de Calendly / Zoom pour un call', 'Pas de showreel video accessible', 'LCP 3.2s = signal negatif tech'] },
