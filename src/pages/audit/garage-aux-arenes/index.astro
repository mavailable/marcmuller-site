---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Audit UX — Garage Aux Arenes Eurorepar | Marc M';
const description = 'Simulation de 10 visites personas sur garageauxarenes.com — rapport complet avec recommandations priorisees.';

// ── PROSPECT ──────────────────────────────────────────────────────────────────
const prospect = {
  name: 'Garage Aux Arenes — Eurorepar Car Service',
  url: 'http://www.garageauxarenes.com/',
  date: '29 mars 2026',
  activity: 'Garage automobile multi-marques — entretien, reparation, carrosserie, vente VO',
