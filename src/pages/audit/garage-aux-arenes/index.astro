  note: '4.6/5 — 128 avis Google',
};

// ── KPIs ──────────────────────────────────────────────────────────────────────
const kpis = {
  conversion: 20,
  experience: 4.2,
  confiance: 4.8,
  clarte: 3.6,
};

// ── CONSTAT ───────────────────────────────────────────────────────────────────
const constat = "Un garage avec 128 avis positifs et une note de 4.6/5 mais un site web hors ligne depuis 2023 : la meilleure reputation de Metz est completement invisible sur internet.";

// ── PAGESPEED ─────────────────────────────────────────────────────────────────
const pagespeed = {
  mobile: { performance: 25, accessibility: 52, bestPractices: 38, seo: 33 },
  desktop: { performance: 45, accessibility: 52, bestPractices: 38, seo: 40 },
  note: 'Estimation — site hors ligne (NXDOMAIN), scores bases sur architecture PHP circa 2005-2015'
};

const coreWebVitals = [
  { name: 'LCP', value: '>4.0s', status: 'mauvais' },
  { name: 'CLS', value: '>0.25', status: 'mauvais' },
  { name: 'INP', value: '>500ms', status: 'mauvais' },
];

const observatory = { grade: 'F', score: 10, testsPassed: 1, testsTotal: 9 };

const techOpportunities = [
  { label: 'Nouveau site HTTPS avec structure moderne', gain: 'Site visible + +15 pts SEO' },
  { label: 'Schema.org LocalBusiness + aggregateRating', gain: 'Rich snippets Google actives' },
  { label: 'Prise de RDV en ligne', gain: '+40% conversions estimees' },
];

// ── CHECKLIST TECHNIQUE ───────────────────────────────────────────────────────
const techChecks = [
  { label: 'Site web accessible (pas NXDOMAIN)', present: false, critical: true },
  { label: 'HTTPS actif', present: false, critical: true },
  { label: 'Meta title optimise', present: true, critical: false },
  { label: 'Meta description', present: false, critical: true },
  { label: 'Schema.org LocalBusiness JSON-LD', present: false, critical: true },
  { label: 'Open Graph (og:image, og:title)', present: false, critical: false },
  { label: 'Mobile-friendly / responsive', present: false, critical: true },
  { label: 'Sitemap XML', present: false, critical: false },
  { label: 'Security headers (CSP, HSTS...)', present: false, critical: false },
  { label: 'Prise de RDV / formulaire contact', present: false, critical: true },
];

// ── CONVERSION PAR CANAL ──────────────────────────────────────────────────────
const conversionByCanal = [
  { canal: 'Google Maps / GBP', taux: 40, color: 'text-amber-600', bgColor: 'bg-amber-500' },
  { canal: 'Bouche-a-oreille', taux: 60, color: 'text-green-600', bgColor: 'bg-green-500' },
  { canal: 'Google Search', taux: 10, color: 'text-red-600', bgColor: 'bg-red-500' },
  { canal: 'IA (ChatGPT / Claude)', taux: 25, color: 'text-amber-600', bgColor: 'bg-amber-500' },
  { canal: 'Reseaux sociaux', taux: 0, color: 'text-red-600', bgColor: 'bg-red-500' },
