// ── SCORE ─────────────────────────────────────────────────────────────────────
function scoreColor(score: number): string {
  if (score >= 90) return '#22c55e';
  if (score >= 50) return '#f59e0b';
  return '#ef4444';
}
function scoreDash(score: number): string {
  return `${score}, 100`;
}
---

<BaseLayout title={title} description={description} noindex={true} lang="fr" frPath="/audit/garage-aux-arenes">
  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <section class="bg-neutral-900 text-white py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-4">Rapport personnalise</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2 leading-tight">
        {prospect.name}<br/>
        <span class="text-amber-400">ce que vos visiteurs pensent vraiment</span>
      </h1>
      <p class="text-neutral-400 mb-2">{prospect.activity}</p>
      <p class="text-neutral-500 text-sm mb-2">{prospect.location} — {prospect.phone}</p>
      <p class="text-neutral-500 text-sm mb-6">
        Site audite : <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener">{prospect.url}</a>
        <span class="ml-2 text-xs bg-red-900/60 text-red-300 px-2 py-0.5 rounded-full">hors ligne</span>
      </p>
      <p class="text-neutral-500 text-xs mb-8">Rapport genere le {prospect.date} — {prospect.note}</p>
      <!-- KPI Cards -->
      <div class="grid grid-cols-3 gap-4 max-w-lg">
        <div class="text-center bg-neutral-800 rounded-xl py-4">
          <span class="block text-3xl font-black text-amber-400">{kpis.conversion}%</span>
          <span class="text-xs text-neutral-400 mt-1 block">convertissent</span>
        </div>
        <div class="text-center bg-neutral-800 rounded-xl py-4">
          <span class="block text-3xl font-black text-amber-400">{kpis.experience}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">experience</span>
        </div>
        <div class="text-center bg-neutral-800 rounded-xl py-4">
          <span class="block text-3xl font-black text-amber-400">{kpis.confiance}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">confiance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CONSTAT ───────────────────────────────────────────────────────────── -->
  <section class="bg-white py-12 px-4 border-b border-neutral-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-amber-900 font-medium text-base leading-relaxed">{constat}</p>
      </div>

      <!-- Conversion par canal -->
      <h3 class="font-semibold text-neutral-800 mb-4">Taux de conversion par canal d'arrivee</h3>
      <div class="space-y-3 mb-10">
        {conversionByCanal.map(item => (
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-sm text-neutral-700">{item.canal}</span>
              <span class={`text-sm font-bold ${item.color}`}>{item.taux}%</span>
            </div>
            <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
              <div class={`h-full rounded-full ${item.bgColor}`} style={`width: ${item.taux}%`}></div>
            </div>
          </div>
        ))}
      </div>

      <!-- Top frictions -->
      <h3 class="font-semibold text-neutral-800 mb-4">Top 5 problemes les plus cites</h3>
      <ol class="space-y-3">
        {topFrictions.map((f, i) => (
          <li class="flex gap-4 items-start bg-neutral-50 rounded-xl p-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-red-100 text-red-700 font-black text-sm flex items-center justify-center">{i + 1}</span>
            <div>
              <p class="font-semibold text-neutral-900 text-sm">{f.titre}</p>
              <p class="text-neutral-500 text-xs mt-0.5">{f.detail}</p>
              <span class="text-xs text-red-600 font-medium mt-1 inline-block">{f.count}/10 personas impactes</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── AUDIT TECHNIQUE ──────────────────────────────────────────────────── -->
  <section class="bg-neutral-50 py-12 px-4 border-b border-neutral-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">L'audit technique</h2>
      <p class="text-neutral-500 text-sm mb-8">Scores estimes — site hors ligne (domaine expire depuis 2023). Base sur l'architecture connue du site PHP.</p>

      <!-- PageSpeed Mobile -->
      <h3 class="font-semibold text-neutral-800 mb-4">Performance mobile <span class="text-xs font-normal text-neutral-400">(estimation)</span></h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
        {[
          { label: 'Performance', score: pagespeed.mobile.performance },
          { label: 'Accessibilite', score: pagespeed.mobile.accessibility },
          { label: 'Bonnes pratiques', score: pagespeed.mobile.bestPractices },
          { label: 'SEO', score: pagespeed.mobile.seo },
        ].map(item => (
          <div class="bg-white rounded-xl p-4 text-center shadow-sm">
            <div class="relative w-16 h-16 mx-auto mb-2">
              <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                  fill="none" stroke="#e5e7eb" stroke-width="3" />
                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                  fill="none" stroke={scoreColor(item.score)} stroke-width="3"
                  stroke-dasharray={scoreDash(item.score)} stroke-linecap="round" />
              </svg>
              <span class="absolute inset-0 flex items-center justify-center text-lg font-bold text-neutral-800">{item.score}</span>
            </div>
            <p class="text-xs text-neutral-600">{item.label}</p>
          </div>
        ))}
      </div>

      <!-- Observatory + CWV -->
      <div class="grid sm:grid-cols-2 gap-6 mb-8">
        <div class="bg-white rounded-xl p-5 shadow-sm">
          <h3 class="font-semibold text-neutral-800 mb-3">Securite (Observatory)</h3>
          <div class="flex items-center gap-4 mb-3">
            <span class="text-5xl font-black text-red-500">{observatory.grade}</span>
            <div>
              <p class="text-sm text-neutral-700">Score : <strong>{observatory.score}/100</strong></p>
              <p class="text-xs text-neutral-500">{observatory.testsPassed}/{observatory.testsTotal} tests reussis</p>
            </div>
          </div>
          <p class="text-xs text-neutral-500">Aucun header de securite (CSP, HSTS, X-Frame-Options...) — site HTTP non-securise.</p>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm">
          <h3 class="font-semibold text-neutral-800 mb-3">Core Web Vitals</h3>
          <div class="space-y-2">
            {coreWebVitals.map(cwv => (
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-neutral-700">{cwv.name}</span>
                <span class="text-sm font-bold text-red-600 bg-red-50 px-2 py-0.5 rounded">{cwv.value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Checklist Schema/OG/SEO -->
      <h3 class="font-semibold text-neutral-800 mb-4">Checklist Schema.org + SEO + Open Graph</h3>
      <div class="grid sm:grid-cols-2 gap-2 mb-8">
        {techChecks.map(check => (
          <div class={`flex items-center gap-3 p-3 rounded-lg ${check.present ? 'bg-green-50' : check.critical ? 'bg-red-50' : 'bg-neutral-100'}`}>
            <span class={`text-base shrink-0 ${check.present ? 'text-green-600' : 'text-red-500'}`}>
              {check.present ? '✓' : '✗'}
            </span>
            <span class={`text-xs ${check.present ? 'text-green-800' : check.critical ? 'text-red-800 font-medium' : 'text-neutral-600'}`}>
              {check.label}
              {check.critical && !check.present && <span class="ml-1 text-[10px] bg-red-200 text-red-700 px-1 rounded">critique</span>}
            </span>
          </div>
        ))}
      </div>

      <!-- Opportunites -->
      <h3 class="font-semibold text-neutral-800 mb-4">3 opportunites prioritaires</h3>
      <div class="space-y-3">
        {techOpportunities.map((opp, i) => (
          <div class="flex gap-4 items-start bg-white rounded-xl p-4 shadow-sm">
            <span class="shrink-0 w-7 h-7 rounded-full bg-blue-100 text-blue-700 font-black text-sm flex items-center justify-center">{i + 1}</span>
            <div class="flex-1">
              <p class="font-medium text-neutral-900 text-sm">{opp.label}</p>
              <p class="text-xs text-green-700 font-medium mt-0.5">{opp.gain}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── VISITEURS ─────────────────────────────────────────────────────────── -->
  <section class="bg-white py-12 px-4 border-b border-neutral-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
      <p class="text-neutral-500 text-sm mb-6">
        Sur 10 visiteurs simules :
        <span class="font-bold text-green-600 ml-1">{convertis} contactent</span>,
        <span class="font-bold text-amber-600 ml-1">{hesitants} hesitent</span>,
        <span class="font-bold text-neutral-500 ml-1">{quittent} repartent</span>.
      </p>

      <!-- Personas convertissent -->
      {convertis > 0 && (
        <h3 class="text-sm font-semibold text-green-700 uppercase tracking-wide mb-3">Convertissent ({convertis})</h3>
      )}
      <div class="space-y-2 mb-6">
        {personas.filter(p => p.decision === 'convertit').map(p => (
          <details class="group border border-green-200 bg-green-50/40 rounded-xl overflow-hidden">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[11px] text-green-700 bg-green-100 px-1.5 py-0.5 rounded font-medium">Convertit</span>
                </div>
                <p class="text-xs text-neutral-500">{p.situation}</p>
              </div>
              <svg class="w-5 h-5 text-neutral-400 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-4 pt-0 border-t border-green-200 bg-white/50">
              <div class="grid gap-3 text-xs mt-3">
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Premiere impression</p>
                  <p class="text-neutral-600">{p.premierImpression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Question cle</p>
                  <p class="text-neutral-600 italic">"{p.questionCle}"</p>
                  <p class="text-neutral-600 mt-1">Reponse : <strong>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <p class="text-neutral-500 text-[11px]"><span class="font-medium">Impact technique :</span> {p.impactTechnique}</p>
                <div class="flex gap-4">
                  <div class="flex-1">
                    <p class="font-semibold text-green-700 mb-1">Points positifs</p>
                    <ul class="list-disc list-inside text-neutral-600 space-y-0.5">{p.pointsPositifs.map(pt => <li>{pt}</li>)}</ul>
                  </div>
                  <div class="flex-1">
                    <p class="font-semibold text-amber-700 mb-1">Frictions</p>
                    <ul class="list-disc list-inside text-neutral-600 space-y-0.5">{p.frictions.map(f => <li>{f}</li>)}</ul>
                  </div>
                </div>
                <div class="flex gap-4 text-[11px] text-neutral-500 border-t border-green-100 pt-2 mt-1">
                  <span>Experience : <strong>{p.scores.exp}/10</strong></span>
                  <span>Confiance : <strong>{p.scores.conf}/10</strong></span>
                  <span>Clarte : <strong>{p.scores.clarte}/10</strong></span>
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>

      <!-- Personas hesitent -->
      {hesitants > 0 && (
        <h3 class="text-sm font-semibold text-amber-700 uppercase tracking-wide mb-3">Hesitent ({hesitants})</h3>
      )}
      <div class="space-y-2 mb-6">
        {personas.filter(p => p.decision === 'hesite').map(p => (
          <details class="group border border-amber-200 bg-amber-50/40 rounded-xl overflow-hidden">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[11px] text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded font-medium">Hesite</span>
                </div>
                <p class="text-xs text-neutral-500">{p.situation}</p>
              </div>
              <svg class="w-5 h-5 text-neutral-400 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-4 pt-0 border-t border-amber-200 bg-white/50">
              <div class="grid gap-3 text-xs mt-3">
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Premiere impression</p>
                  <p class="text-neutral-600">{p.premierImpression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Question cle</p>
                  <p class="text-neutral-600 italic">"{p.questionCle}"</p>
                  <p class="text-neutral-600 mt-1">Reponse : <strong>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <p class="text-neutral-500 text-[11px]"><span class="font-medium">Impact technique :</span> {p.impactTechnique}</p>
                <div class="flex gap-4">
                  <div class="flex-1">
                    <p class="font-semibold text-green-700 mb-1">Points positifs</p>
                    <ul class="list-disc list-inside text-neutral-600 space-y-0.5">{p.pointsPositifs.map(pt => <li>{pt}</li>)}</ul>
                  </div>
                  <div class="flex-1">
                    <p class="font-semibold text-amber-700 mb-1">Frictions</p>
                    <ul class="list-disc list-inside text-neutral-600 space-y-0.5">{p.frictions.map(f => <li>{f}</li>)}</ul>
                  </div>
                </div>
                <div class="flex gap-4 text-[11px] text-neutral-500 border-t border-amber-100 pt-2 mt-1">
                  <span>Experience : <strong>{p.scores.exp}/10</strong></span>
                  <span>Confiance : <strong>{p.scores.conf}/10</strong></span>
                  <span>Clarte : <strong>{p.scores.clarte}/10</strong></span>
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>

      <!-- Personas quittent -->
      {quittent > 0 && (
        <h3 class="text-sm font-semibold text-neutral-500 uppercase tracking-wide mb-3">Repartent ({quittent})</h3>
      )}
      <div class="space-y-2">
        {personas.filter(p => p.decision === 'quitte').map(p => (
          <details class="group border border-neutral-200 bg-neutral-50/40 rounded-xl overflow-hidden">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[11px] text-neutral-600 bg-neutral-200 px-1.5 py-0.5 rounded font-medium">Repart</span>
                </div>
                <p class="text-xs text-neutral-500">{p.situation}</p>
              </div>
              <svg class="w-5 h-5 text-neutral-400 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-4 pt-0 border-t border-neutral-200 bg-white/50">
              <div class="grid gap-3 text-xs mt-3">
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Premiere impression</p>
                  <p class="text-neutral-600">{p.premierImpression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Question cle</p>
                  <p class="text-neutral-600 italic">"{p.questionCle}"</p>
                  <p class="text-neutral-600 mt-1">Reponse : <strong>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <p class="text-neutral-500 text-[11px]"><span class="font-medium">Impact technique :</span> {p.impactTechnique}</p>
                <div class="flex gap-4">
                  <div class="flex-1">
                    <p class="font-semibold text-green-700 mb-1">Points positifs</p>
                    <ul class="list-disc list-inside text-neutral-600 space-y-0.5">{p.pointsPositifs.map(pt => <li>{pt}</li>)}</ul>
                  </div>
                  <div class="flex-1">
                    <p class="font-semibold text-amber-700 mb-1">Frictions</p>
                    <ul class="list-disc list-inside text-neutral-600 space-y-0.5">{p.frictions.map(f => <li>{f}</li>)}</ul>
                  </div>
                </div>
                <div class="flex gap-4 text-[11px] text-neutral-500 border-t border-neutral-100 pt-2 mt-1">
                  <span>Experience : <strong>{p.scores.exp}/10</strong></span>
                  <span>Confiance : <strong>{p.scores.conf}/10</strong></span>
                  <span>Clarte : <strong>{p.scores.clarte}/10</strong></span>
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── RECOMMANDATIONS ───────────────────────────────────────────────────── -->
  <section class="bg-neutral-50 py-12 px-4 border-b border-neutral-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Nos recommandations</h2>

      <!-- Critiques -->
      <h3 class="font-semibold text-red-700 text-sm uppercase tracking-wide mb-3">Le plus important</h3>
      <div class="space-y-4 mb-8">
        {ameliorationsCritiques.map((a, i) => (
          <div class="border-2 border-red-200 bg-white rounded-xl p-5">
            <div class="flex items-start gap-3">
              <span class="shrink-0 w-7 h-7 rounded-full bg-red-100 text-red-700 font-black text-sm flex items-center justify-center mt-0.5">{i + 1}</span>
              <div>
                <h4 class="font-bold text-neutral-900 mb-1">{a.titre}</h4>
                <p class="text-neutral-600 text-sm mb-2">{a.detail}</p>
                <p class="text-xs text-blue-700 bg-blue-50 inline-block px-2 py-1 rounded font-medium">Action : {a.action}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Utiles -->
      <h3 class="font-semibold text-neutral-600 text-sm uppercase tracking-wide mb-3">Utile aussi</h3>
      <div class="grid sm:grid-cols-3 gap-4">
        {ameliorationsUtiles.map(a => (
          <div class="bg-white border border-neutral-200 rounded-xl p-4">
            <h4 class="font-semibold text-neutral-900 text-sm mb-2">{a.titre}</h4>
            <p class="text-neutral-500 text-xs leading-relaxed">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA FINAL ─────────────────────────────────────────────────────────── -->
  <section class="bg-neutral-900 text-white py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4">
        {kpis.conversion}% de vos visiteurs vous contactent.<br/>
        <span class="text-amber-400">Avec un site actif, on peut depasser 60%.</span>
      </h2>
      <p class="text-neutral-300 mb-3 max-w-xl mx-auto">
        Votre garage a une excellente reputation — 128 avis a 4.6/5. Mais sans site web actif, cette reputation est invisible sur Google. Vous perdez des clients a chaque recherche.
      </p>
      <p class="text-neutral-400 text-sm mb-8 max-w-xl mx-auto">
        Je construis des sites qui convertissent vraiment — structure moderne, HTTPS, Schema.org, prise de RDV en ligne, valorisation de vos avis Google. A partir de 990€, livre en 7 jours.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/commander" class="inline-flex items-center gap-2 px-8 py-3.5 bg-[var(--color-accent)] text-white font-semibold rounded-xl hover:bg-[var(--color-accent-hover)] transition-all shadow-md">
          Je veux un site qui convertit
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-3.5 border border-neutral-600 text-neutral-300 font-semibold rounded-xl hover:border-amber-400 hover:text-amber-400 transition-all">
          En discuter d'abord
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
