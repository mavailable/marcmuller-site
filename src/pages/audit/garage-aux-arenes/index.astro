// ── TOP FRICTIONS ─────────────────────────────────────────────────────────────
const topFrictions = [
  { titre: 'Site web hors ligne — introuvable sur Google', count: 10, detail: 'Le domaine ne repond plus. 100% des personas ne trouvent pas de site.' },
  { titre: 'Aucun tarif ni fourchette de prix', count: 9, detail: 'Impossible de savoir si le garage est dans le budget. Frein a la prise de contact.' },
  { titre: 'Aucune prise de RDV en ligne', count: 8, detail: 'Obligation d\'appeler aux horaires de bureau — bloquant pour les actifs.' },
  { titre: 'Les 128 avis Google non valorises', count: 7, detail: 'Preuve sociale inexploitee. Personne ne sait que le garage a une excellente reputation.' },
