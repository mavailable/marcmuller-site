  {
    titre: 'Obtenir un email professionnel et corriger les éléments de méfiance',
    detail: 'L\'email gmaiil1080@gmail.com cumule deux problèmes : faute de frappe + adresse Gmail. 3 personas B2B (Immo57, Thomas, Nathalie) ont identifié cet email comme motif d\'abandon immédiat. Un email @jam-peinture.fr coûte 2€/mois et multiplie la crédibilité professionnelle.',
    action: 'Email professionnel contact@jam-peinture.fr ou jamal@jam-peinture.fr. Supprimer la mention INCOMM du footer. Ajouter assurance décennale mentionnée.',
  },
];

const ameliorationsUtiles = [
  {
    titre: 'Galerie contextualitée avec légendes et photos HD',
    detail: '6 personas ont visité "Nos réalisations" et sont repartis déçus — 7 photos sans titre, sans ville, sans matériau, en 400px. Chaque photo devrait avoir : type de chantier, ville, matériaux utilisés, couleur si applicable.',
  },
  {
    titre: 'Supprimer Google Fonts — polices locales pour conformité RGPD',
    detail: 'Le chargement de Open Sans, Saira et Passion One depuis fonts.googleapis.com constitue une violation RGPD active (transfert d\'IP vers Google sans consentement préalable). Les polices doivent être hébergées localement (woff2).',
  },
  {
    titre: 'Schema.org LocalBusiness + GEO (llms.txt)',
    detail: 'Aucun artisan peintre de Moselle n\'est cité par ChatGPT ou Claude sur les requêtes "peintre Metz". Être le premier avec un llms.txt + Schema.org complet donne un avantage durable sur les IA génératives.',
  },
];

// ============================================================
// HELPERS
// ============================================================
function scoreColor(score: number) {
  if (score >= 90) return '#22c55e';
  if (score >= 50) return '#f59e0b';
  return '#ef4444';
}

function scoreTextClass(score: number) {
  if (score >= 90) return 'text-green-600';
  if (score >= 50) return 'text-amber-500';
  return 'text-red-500';
}

function decisionColor(decision: string) {
  if (decision === 'convertit') return 'border-green-200 bg-green-50/40';
  if (decision === 'hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}

function decisionBadge(decision: string) {
  if (decision === 'convertit') return 'bg-green-100 text-green-700';
  if (decision === 'hesite') return 'bg-amber-100 text-amber-700';
  return 'bg-neutral-100 text-neutral-600';
}

function decisionLabel(decision: string) {
  if (decision === 'convertit') return 'Contacte';
  if (decision === 'hesite') return 'Hesite';
  return 'Repart';
}

function maturiteColor(m: string) {
  if (m === 'Decision') return 'text-purple-600 bg-purple-50';
  if (m === 'Comparaison') return 'text-blue-600 bg-blue-50';
  return 'text-neutral-500 bg-neutral-100';
}
---

<BaseLayout title={title} description={description} noindex={true} lang="fr" frPath="/audit/jams-peinture">

  <!-- ========================================================
       HERO + KPIs
  ======================================================== -->
  <section class="bg-neutral-900 text-white py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-4">Rapport personnalise</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2 leading-tight">
        {prospect.name}<br/>
        <span class="text-neutral-300 font-normal text-2xl">ce que vos visiteurs pensent vraiment</span>
      </h1>
      <p class="text-neutral-400 mb-2">{prospect.activity} &mdash; {prospect.location}</p>
      <p class="text-neutral-500 text-sm mb-2">
        <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener noreferrer">{prospect.url}</a>
        &mdash; Rapport du {prospect.date}
      </p>
      <p class="text-neutral-500 text-sm mb-8">{prospect.avis} &mdash; Tel. {prospect.tel}</p>

      <!-- KPI Cards -->
      <div class="grid grid-cols-3 gap-4 max-w-lg">
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.conversion}%</span>
          <span class="text-xs text-neutral-400 mt-1 block">convertissent</span>
        </div>
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.experience}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">experience</span>
        </div>
        <div class="bg-neutral-800 rounded-xl p-4 text-center">
          <span class="block text-3xl font-black text-amber-400">{kpis.confiance}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">confiance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       ALERTE GEOGRAPHIQUE
  ======================================================== -->
  <section class="py-6 px-4 bg-red-50 border-b border-red-200">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-start gap-3">
        <span class="text-red-500 text-xl shrink-0 mt-0.5">!</span>
        <div>
          <p class="font-semibold text-red-800 text-sm mb-1">Alerte : discordance géographique critique</p>
          <p class="text-red-700 text-sm leading-relaxed">{alerteGeo}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       LE CONSTAT
  ======================================================== -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>

      <!-- Constat principal -->
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-amber-900 font-medium text-base leading-relaxed">{constat}</p>
      </div>

      <!-- Resume visiteurs -->
      <div class="flex flex-wrap gap-3 mb-8">
        <div class="flex items-center gap-2 bg-green-50 border border-green-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
          <span class="text-sm font-semibold text-green-800">{kpis.convertissent} contactent</span>
        </div>
        <div class="flex items-center gap-2 bg-amber-50 border border-amber-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
          <span class="text-sm font-semibold text-amber-800">{kpis.hesitent} hesitent</span>
        </div>
        <div class="flex items-center gap-2 bg-neutral-100 border border-neutral-200 rounded-lg px-4 py-2">
          <span class="w-2 h-2 rounded-full bg-neutral-400 shrink-0"></span>
          <span class="text-sm font-semibold text-neutral-700">{kpis.quittent} repartent</span>
        </div>
      </div>

      <!-- Conversion par canal -->
      <h3 class="font-heading text-lg font-bold text-neutral-900 mb-4">Taux de conversion estime par canal</h3>
      <div class="space-y-3 mb-8">
        {conversionByCanal.map(c => (
          <div class="flex items-center gap-3">
            <span class="w-40 text-sm text-neutral-600 shrink-0">{c.canal}</span>
            <div class="flex-1 bg-neutral-100 rounded-full h-3 overflow-hidden">
              <div class={`h-3 rounded-full ${c.bg}`} style={`width: ${c.taux}%`}></div>
            </div>
            <span class={`w-10 text-sm font-bold text-right ${c.color}`}>{c.taux}%</span>
          </div>
        ))}
      </div>

      <!-- Top frictions -->
      <h3 class="font-heading text-lg font-bold text-neutral-900 mb-4">Top frictions identifiees</h3>
      <div class="space-y-3">
        {topFrictions.map(f => (
          <div class="border border-neutral-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-red-100 text-red-700 text-xs font-bold shrink-0 mt-0.5">{f.count}/10</span>
              <div>
                <p class="font-semibold text-neutral-900 text-sm">{f.titre}</p>
                <p class="text-neutral-500 text-xs mt-1 leading-relaxed">{f.detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       AUDIT TECHNIQUE
  ======================================================== -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-8">Audit technique</h2>

      <!-- PageSpeed -->
      <h3 class="font-heading text-lg font-bold text-neutral-800 mb-2">PageSpeed Insights</h3>
      <p class="text-xs text-neutral-400 italic mb-5">{pagespeed.note}</p>
      <div class="grid grid-cols-2 gap-6 mb-8">
        <!-- Mobile -->
        <div class="bg-white rounded-xl border border-neutral-200 p-5">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-4">Mobile</p>
          {Object.entries(pagespeed.mobile).map(([k, v]) => (
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm text-neutral-600 capitalize">{k.replace(/([A-Z])/g, ' $1')}</span>
              <span class={`text-sm font-bold ${scoreTextClass(v)}`}>{v}/100</span>
            </div>
          ))}
          <div class="mt-4 pt-4 border-t border-neutral-100">
            {coreWebVitals.map(cv => (
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs text-neutral-500">{cv.name}</span>
                <span class={`text-xs font-bold ${cv.status === 'bad' ? 'text-red-500' : 'text-amber-500'}`}>{cv.value}</span>
              </div>
            ))}
          </div>
        </div>
        <!-- Desktop -->
        <div class="bg-white rounded-xl border border-neutral-200 p-5">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-4">Desktop</p>
          {Object.entries(pagespeed.desktop).map(([k, v]) => (
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm text-neutral-600 capitalize">{k.replace(/([A-Z])/g, ' $1')}</span>
              <span class={`text-sm font-bold ${scoreTextClass(v)}`}>{v}/100</span>
            </div>
          ))}
          <div class="mt-4 pt-4 border-t border-neutral-100">
            <p class="text-xs text-neutral-400 italic mb-1">Gains potentiels :</p>
            {opportunities.slice(0, 3).map(o => (
              <div class="flex items-center justify-between mt-1">
                <span class="text-xs text-neutral-500 leading-tight pr-2">{o.label.slice(0, 45)}...</span>
                <span class="text-xs font-bold text-green-600 shrink-0">{o.saving}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Observatory -->
      <h3 class="font-heading text-lg font-bold text-neutral-800 mb-4">MDN Observatory — Securite HTTP</h3>
      <div class="bg-white rounded-xl border border-neutral-200 p-5 mb-8">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-16 h-16 rounded-xl flex items-center justify-center text-2xl font-black text-white"
               style={`background: ${scoreColor(observatory.score)}`}>
            {observatory.grade}
          </div>
          <div>
            <p class="text-2xl font-black text-neutral-900">{observatory.score}/100</p>
            <p class="text-sm text-neutral-500">{observatory.testsPassed}/{observatory.testsTotal} tests reussis — scan officiel POST 30/03/2026</p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 mt-4">
          <div class="flex items-center gap-2 text-sm"><span class="text-green-500">&#10003;</span><span class="text-neutral-600">HTTPS + HTTP/2 (nginx)</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="text-green-500">&#10003;</span><span class="text-neutral-600">HSTS (max-age=31536000; includeSubdomains)</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="text-green-500">&#10003;</span><span class="text-neutral-600">X-Content-Type-Options: nosniff</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="text-green-500">&#10003;</span><span class="text-neutral-600">Referrer-Policy: strict-origin-when-cross-origin</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="text-red-500">&#10007;</span><span class="text-neutral-600">CSP complete — seul frame-ancestors present</span></div>
          <div class="flex items-center gap-2 text-sm"><span class="text-red-500">&#10007;</span><span class="text-neutral-600">Permissions-Policy — absent</span></div>
        </div>
      </div>

      <!-- Checklist -->
      <h3 class="font-heading text-lg font-bold text-neutral-800 mb-4">Checklist complete</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        {techChecks.map(c => (
          <div class={`flex items-start gap-2 p-2 rounded-lg ${c.critical && !c.present ? 'bg-red-50' : 'bg-white border border-neutral-100'}`}>
            <span class={`shrink-0 mt-0.5 ${c.present ? 'text-green-500' : 'text-red-400'}`}>{c.present ? '✓' : '✗'}</span>
            <div>
              <span class={`text-sm ${c.present ? 'text-neutral-700' : c.critical ? 'text-red-700 font-medium' : 'text-neutral-500'}`}>{c.label}</span>
              {c.note && <p class="text-xs text-neutral-400 mt-0.5">{c.note}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       PERSONAS — VISITES SIMULEES
  ======================================================== -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">10 visites simulees</h2>
      <p class="text-neutral-500 text-sm mb-8">10 profils typiques de prospects pour un peintre en batiment Moselle 57. Chaque persona parcourt le site independamment.</p>

      <div class="space-y-5">
        {personas.map(p => (
          <div class={`rounded-xl border p-5 ${decisionColor(p.decision)}`}>
            <!-- Header persona -->
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <span class="text-2xl">{p.emoji}</span>
                <div>
                  <p class="font-heading font-bold text-neutral-900">{p.name}, {p.age > 0 ? `${p.age} ans` : 'Pro'}</p>
                  <div class="flex flex-wrap gap-2 mt-1">
                    <span class="text-xs bg-neutral-100 text-neutral-500 px-2 py-0.5 rounded-full">{p.device}</span>
                    <span class="text-xs bg-blue-50 text-blue-600 px-2 py-0.5 rounded-full">{p.canal}</span>
                    <span class={`text-xs px-2 py-0.5 rounded-full ${maturiteColor(p.maturite)}`}>{p.maturite}</span>
                  </div>
                </div>
              </div>
              <span class={`text-xs font-semibold px-3 py-1 rounded-full shrink-0 ${decisionBadge(p.decision)}`}>
                {decisionLabel(p.decision)}
              </span>
            </div>

            <p class="text-sm text-neutral-600 mb-3 italic">"{p.situation}"</p>

            <!-- Scores -->
            <div class="flex gap-4 mb-4">
              <div class="text-center"><p class="text-xs text-neutral-400">Experience</p><p class={`font-bold ${scoreTextClass(p.scores.exp * 10)}`}>{p.scores.exp}/10</p></div>
              <div class="text-center"><p class="text-xs text-neutral-400">Confiance</p><p class={`font-bold ${scoreTextClass(p.scores.conf * 10)}`}>{p.scores.conf}/10</p></div>
              <div class="text-center"><p class="text-xs text-neutral-400">Clarte</p><p class={`font-bold ${scoreTextClass(p.scores.clarte * 10)}`}>{p.scores.clarte}/10</p></div>
            </div>

            <!-- Impression + Parcours -->
            <div class="bg-white/60 rounded-lg p-3 mb-3">
              <p class="text-xs font-semibold text-neutral-500 mb-1">Premiere impression</p>
              <p class="text-sm text-neutral-700 leading-relaxed">{p.premierImpression}</p>
            </div>

            <div class="bg-white/60 rounded-lg p-3 mb-3">
              <p class="text-xs font-semibold text-neutral-500 mb-1">Question cle posee</p>
              <p class="text-sm text-neutral-700 italic">"{p.questionCle}"</p>
              <p class="text-xs text-neutral-500 mt-1">Reponse du site : <span class="font-medium">{p.reponse}</span></p>
            </div>

            {p.parcours.length > 0 && (
              <div class="flex flex-wrap gap-1 mb-3">
                {p.parcours.map((page, i) => (
                  <>
                    <span class="text-xs bg-neutral-100 text-neutral-600 px-2 py-0.5 rounded">{page}</span>
                    {i < p.parcours.length - 1 && <span class="text-neutral-300 text-xs self-center">›</span>}
                  </>
                ))}
              </div>
            )}

            <!-- Points + Frictions -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div>
                <p class="text-xs font-semibold text-green-700 mb-1">Points positifs</p>
                {p.pointsPositifs.map(pp => (
                  <p class="text-xs text-neutral-600 flex items-start gap-1 mb-0.5"><span class="text-green-500 shrink-0">+</span>{pp}</p>
                ))}
              </div>
              <div>
                <p class="text-xs font-semibold text-red-700 mb-1">Frictions</p>
                {p.frictions.map(fr => (
                  <p class="text-xs text-neutral-600 flex items-start gap-1 mb-0.5"><span class="text-red-400 shrink-0">-</span>{fr}</p>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       RECOMMANDATIONS
  ======================================================== -->
  <section class="py-12 px-4 bg-neutral-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-8">Recommandations</h2>

      <h3 class="font-heading text-lg font-bold text-neutral-800 mb-4">Actions critiques — impact immediat</h3>
      <div class="space-y-4 mb-10">
        {ameliorationsCritiques.map((a, i) => (
          <div class="bg-white rounded-xl border border-red-100 p-5">
            <div class="flex items-start gap-3">
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-red-100 text-red-700 text-sm font-black shrink-0">{i + 1}</span>
              <div>
                <p class="font-semibold text-neutral-900 mb-2">{a.titre}</p>
                <p class="text-sm text-neutral-600 mb-3 leading-relaxed">{a.detail}</p>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="text-xs font-semibold text-neutral-500 mb-1">Action recommandee</p>
                  <p class="text-sm text-neutral-700">{a.action}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <h3 class="font-heading text-lg font-bold text-neutral-800 mb-4">Ameliorations utiles — impact fort</h3>
      <div class="space-y-3">
        {ameliorationsUtiles.map(a => (
          <div class="bg-white rounded-xl border border-neutral-200 p-4">
            <p class="font-semibold text-neutral-900 text-sm mb-1">{a.titre}</p>
            <p class="text-xs text-neutral-500 leading-relaxed">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================
       CTA WEB FACTORY
  ======================================================== -->
  <section class="py-14 px-4 bg-neutral-900 text-white">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-sm font-semibold text-amber-400 uppercase tracking-widest mb-4">Proposition</p>
      <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4 leading-tight">
        Vos 35 avis 5 etoiles meritent un site a la hauteur
      </h2>
      <p class="text-neutral-400 mb-2 leading-relaxed">
        Nouveau site Astro en 7 jours — contenu 100% Moselle 57, avis Google integres, performance mobile x3, RGPD conforme.
      </p>
      <p class="text-neutral-500 text-sm mb-8">
        A partir de 990€ — tout compris, domaine, hebergement, CMS, 1 an de support.
      </p>
      <a href="/contact" class="inline-block bg-amber-400 text-neutral-900 font-bold px-8 py-3 rounded-xl hover:bg-amber-300 transition-colors">
        Discuter du projet
      </a>
      <p class="text-neutral-600 text-xs mt-4">Audit realise par Marc M. — Web Factory Grand Est</p>
    </div>
  </section>

</BaseLayout>
