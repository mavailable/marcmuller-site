// OBSERVATORY
// ============================================================

const observatory = {
  grade: "D-",
  score: 25,
  testsPassed: 5,
  testsTotal: 10,
};

// ============================================================
// CHECKLIST SEO / SCHEMA / OG
// ============================================================

const techChecks = [
  { label: "Meta title présent", present: true, critical: false },
  { label: "Meta description présente", present: true, critical: false },
  { label: "H1 pertinent (activité)", present: false, critical: true },
  { label: "Canonical tag", present: false, critical: true },
  { label: "Schema.org JSON-LD", present: false, critical: true },
  { label: "Open Graph (og:title, og:image…)", present: false, critical: true },
  { label: "Sitemap XML", present: false, critical: true },
