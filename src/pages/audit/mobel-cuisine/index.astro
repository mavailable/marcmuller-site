];
---

<BaseLayout title={title} description={description} noindex={true} lang="fr" frPath="/audit/mobel-cuisine">
  <main class="bg-white min-h-screen">

    <!-- ======================================================
         HERO + KPIs
    ====================================================== -->
    <section class="bg-neutral-900 text-white py-14 px-4">
      <div class="max-w-4xl mx-auto">
        <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-4">Rapport personnalisé — Audit Batch</span>
        <h1 class="font-heading text-3xl md:text-4xl font-bold mb-2 leading-tight">
          {prospect.name} — ce que vos visiteurs pensent vraiment
        </h1>
        <p class="text-neutral-400 mb-2">{prospect.activity}</p>
        <p class="text-neutral-500 text-sm mb-8">
          <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener noreferrer">{prospect.url}</a>
          &nbsp;·&nbsp; {prospect.location} &nbsp;·&nbsp; Audit du {prospect.date}
        </p>

        <div class="grid grid-cols-3 gap-4 max-w-sm">
          <div class="text-center bg-white/5 rounded-xl py-4">
            <span class="block text-3xl font-black text-amber-400">{kpis.conversion}%</span>
            <span class="text-xs text-neutral-400 mt-1 block">convertissent</span>
          </div>
          <div class="text-center bg-white/5 rounded-xl py-4">
            <span class="block text-3xl font-black text-amber-400">{kpis.experience}/10</span>
            <span class="text-xs text-neutral-400 mt-1 block">expérience</span>
          </div>
          <div class="text-center bg-white/5 rounded-xl py-4">
            <span class="block text-3xl font-black text-amber-400">{kpis.confiance}/10</span>
            <span class="text-xs text-neutral-400 mt-1 block">confiance</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================
         CONSTAT
    ====================================================== -->
    <section class="py-12 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>

        <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
          <p class="text-amber-900 font-medium text-lg leading-relaxed">{constat}</p>
        </div>

        <!-- Résumé chiffré -->
        <div class="grid grid-cols-3 gap-4 mb-10">
          <div class="text-center bg-green-50 border border-green-200 rounded-xl py-5">
            <span class="block text-4xl font-black text-green-600">2</span>
            <span class="text-sm text-green-700 font-medium mt-1 block">Convertissent</span>
          </div>
          <div class="text-center bg-amber-50 border border-amber-200 rounded-xl py-5">
            <span class="block text-4xl font-black text-amber-600">3</span>
            <span class="text-sm text-amber-700 font-medium mt-1 block">Hésitent</span>
          </div>
          <div class="text-center bg-red-50 border border-red-200 rounded-xl py-5">
            <span class="block text-4xl font-black text-red-600">5</span>
            <span class="text-sm text-red-700 font-medium mt-1 block">Repartent</span>
          </div>
        </div>

        <!-- Conversion par canal -->
        <h3 class="font-semibold text-neutral-800 mb-4 text-lg">Conversion par canal d'arrivée</h3>
        <div class="space-y-3 mb-10">
          {conversionByCanal.map(item => (
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-neutral-700">{item.canal}</span>
                <span class={`text-sm font-bold ${item.color}`}>{item.taux}%</span>
              </div>
              <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
                <div class={`h-full rounded-full ${item.bg}`} style={`width: ${Math.max(item.taux, 2)}%`}></div>
              </div>
            </div>
          ))}
        </div>

        <!-- Top 5 frictions -->
        <h3 class="font-semibold text-neutral-800 mb-4 text-lg">Top 5 frictions identifiées</h3>
        <ol class="space-y-3">
          {topFrictions.map((f, i) => (
            <li class="flex gap-3 items-start bg-neutral-50 border border-neutral-200 rounded-xl p-4">
              <span class="shrink-0 w-7 h-7 rounded-full bg-red-100 text-red-700 text-sm font-black flex items-center justify-center">{i + 1}</span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-semibold text-neutral-900 text-sm">{f.titre}</span>
                  <span class="text-xs bg-neutral-200 text-neutral-600 px-2 py-0.5 rounded-full">{f.count}/10 personas</span>
                </div>
                <p class="text-xs text-neutral-500 mt-1">{f.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ======================================================
         AUDIT TECHNIQUE
    ====================================================== -->
    <section class="py-12 px-4 bg-neutral-50 border-t border-neutral-200">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">L'audit technique</h2>

        <!-- PageSpeed Mobile -->
        <div class="bg-white rounded-xl border border-neutral-200 p-6 mb-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-sm font-semibold text-neutral-700">PageSpeed Mobile</span>
            <span class="text-xs text-neutral-400 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded">{pagespeed.note}</span>
          </div>
          <div class="grid grid-cols-4 gap-4">
            {mobileScores.map(m => (
              <div class="text-center">
                <div class="relative w-16 h-16 mx-auto mb-2">
                  <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                      fill="none" stroke="#e5e7eb" stroke-width="3" />
                    <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                      fill="none" stroke={scoreColor(m.score)} stroke-width="3"
                      stroke-dasharray={`${m.score}, 100`} stroke-linecap="round" />
                  </svg>
                  <span class="absolute inset-0 flex items-center justify-center text-base font-bold text-neutral-900">{m.score}</span>
                </div>
                <p class="text-xs text-neutral-600">{m.label}</p>
              </div>
            ))}
          </div>
          <!-- Core Web Vitals -->
          <div class="mt-4 flex flex-wrap gap-3">
            {coreWebVitals.map(v => (
              <div class={`px-3 py-2 rounded-lg text-xs font-medium ${v.status === 'bon' ? 'bg-green-50 text-green-700 border border-green-200' : v.status === 'moyen' ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'bg-red-50 text-red-700 border border-red-200'}`}>
                {v.name} : <strong>{v.value}</strong>
              </div>
            ))}
          </div>
        </div>

        <!-- Observatory -->
        <div class="bg-white rounded-xl border border-neutral-200 p-6 mb-6">
          <div class="flex items-center justify-between flex-wrap gap-3">
            <div>
              <span class="text-sm font-semibold text-neutral-700 block mb-1">Sécurité — Mozilla Observatory</span>
              <p class="text-xs text-neutral-500">{observatory.testsPassed}/{observatory.testsTotal} tests passés · 5 headers de sécurité manquants</p>
            </div>
            <div class="text-center">
              <span class="inline-block text-3xl font-black text-red-600 bg-red-50 border border-red-200 rounded-xl px-5 py-2">{observatory.grade}</span>
              <span class="block text-xs text-neutral-500 mt-1">{observatory.score}/100</span>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
            {[
              { h: "Content-Security-Policy", pen: "-25pts" },
              { h: "Strict-Transport-Security", pen: "-20pts" },
              { h: "X-Frame-Options", pen: "-20pts" },
              { h: "X-Content-Type-Options", pen: "-5pts" },
              { h: "Redirection HTTP→HTTPS hors domaine", pen: "-5pts" },
            ].map(item => (
              <div class="flex items-center gap-2 text-red-700">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                <span>{item.h} <span class="text-red-400">({item.pen})</span></span>
              </div>
            ))}
          </div>
        </div>

        <!-- Checklist Schema / OG / SEO -->
        <div class="bg-white rounded-xl border border-neutral-200 p-6 mb-6">
          <span class="text-sm font-semibold text-neutral-700 block mb-4">Schema.org · Open Graph · SEO technique</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {techChecks.map(tc => (
              <div class={`flex items-center gap-2 text-xs py-1 ${tc.present ? 'text-green-700' : tc.critical ? 'text-red-700' : 'text-neutral-500'}`}>
                {tc.present ? (
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                ) : (
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                )}
                <span>{tc.label}{tc.critical && !tc.present ? <span class="ml-1 text-red-400 font-semibold">·&nbsp;critique</span> : ''}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Opportunites -->
        <div class="bg-white rounded-xl border border-neutral-200 p-6">
          <span class="text-sm font-semibold text-neutral-700 block mb-4">Top 3 opportunités de performance</span>
          <div class="space-y-3">
            {opportunities.map(o => (
              <div class={`flex items-start gap-3 p-3 rounded-lg ${o.priorite === 'critique' ? 'bg-red-50 border border-red-200' : 'bg-amber-50 border border-amber-200'}`}>
                <span class={`text-xs font-semibold px-2 py-0.5 rounded shrink-0 ${o.priorite === 'critique' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>{o.priorite}</span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm text-neutral-800 font-medium">{o.titre}</p>
                  <p class="text-xs text-neutral-500 mt-0.5">Gain estimé : {o.gain}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================
         VOS VISITEURS — PERSONAS
    ====================================================== -->
    <section class="py-12 px-4 bg-white border-t border-neutral-200">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs simulés</h2>
        <p class="text-neutral-500 text-sm mb-8">
          Sur <strong>10 visiteurs simulés</strong>, {kpis.conversion / 10 * 1 < 1 ? Math.round(kpis.conversion / 10) : kpis.conversion / 10} visiteurs contactent réellement, {kpis.hesite / 10} hésitent et {kpis.quitte / 10} repartent sans action.
          <br/>Scores moyens : Expérience <strong>{kpis.experience}/10</strong> · Confiance <strong>{kpis.confiance}/10</strong> · Clarté <strong>{kpis.clarte}/10</strong>
        </p>

        <div class="space-y-3">
          {personas.map(p => {
            const style = decisionStyle(p.decision);
            return (
              <details class={`group border ${style.border} ${style.bg} rounded-xl overflow-hidden`}>
                <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                      <h3 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h3>
                      <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                      <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                      <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                      <span class={`text-[11px] px-1.5 py-0.5 rounded font-semibold ${style.badgeBg}`}>{style.badge}</span>
                    </div>
                    <p class="text-xs text-neutral-500">{p.situation}</p>
                  </div>
                  <div class="shrink-0 flex items-center gap-3 ml-2">
                    <div class="hidden sm:flex gap-2 text-xs text-neutral-500">
                      <span>Exp. <strong class={p.scores.exp >= 7 ? 'text-green-600' : p.scores.exp >= 5 ? 'text-amber-600' : 'text-red-600'}>{p.scores.exp}</strong></span>
                      <span>Conf. <strong class={p.scores.conf >= 7 ? 'text-green-600' : p.scores.conf >= 5 ? 'text-amber-600' : 'text-red-600'}>{p.scores.conf}</strong></span>
                    </div>
                    <svg class="w-5 h-5 text-neutral-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                  </div>
                </summary>
                <div class="px-4 pb-4 pt-0 border-t border-neutral-200 bg-white/70">
                  <div class="grid gap-3 text-xs mt-3">
                    <div>
                      <p class="font-semibold text-neutral-700 mb-1">Premiere impression</p>
                      <p class="text-neutral-600">{p.premierImpression}</p>
                    </div>
                    <div>
                      <p class="font-semibold text-neutral-700 mb-1">Parcours</p>
                      <p class="text-neutral-500">{p.parcours.join(' → ')}</p>
                    </div>
                    <div>
                      <p class="font-semibold text-neutral-700 mb-1">Question cle</p>
                      <p class="text-neutral-600 italic">"{p.questionCle}"</p>
                      <p class="text-neutral-600 mt-1">Reponse du site : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Partiellement' ? 'text-amber-700' : 'text-red-700'}>{p.reponse}</strong> — {p.commentReponse}</p>
                    </div>
                    <div>
                      <p class="font-semibold text-neutral-700 mb-1">Impact technique</p>
                      <p class="text-neutral-500 italic">{p.impactTechnique}</p>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                      <div>
                        <p class="font-semibold text-green-700 mb-1">Points positifs</p>
                        <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                          {p.pointsPositifs.map(pp => <li>{pp}</li>)}
                        </ul>
                      </div>
                      <div>
                        <p class="font-semibold text-amber-700 mb-1">Frictions</p>
                        <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                          {p.frictions.map(fr => <li>{fr}</li>)}
                        </ul>
                      </div>
                    </div>
                    <div class="flex gap-4 pt-1 border-t border-neutral-100">
                      <span class="text-neutral-500">Experience : <strong class={p.scores.exp >= 7 ? 'text-green-600' : p.scores.exp >= 5 ? 'text-amber-600' : 'text-red-600'}>{p.scores.exp}/10</strong></span>
                      <span class="text-neutral-500">Confiance : <strong class={p.scores.conf >= 7 ? 'text-green-600' : p.scores.conf >= 5 ? 'text-amber-600' : 'text-red-600'}>{p.scores.conf}/10</strong></span>
                      <span class="text-neutral-500">Clarte : <strong class={p.scores.clarte >= 7 ? 'text-green-600' : p.scores.clarte >= 5 ? 'text-amber-600' : 'text-red-600'}>{p.scores.clarte}/10</strong></span>
                    </div>
                  </div>
                </div>
              </details>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ======================================================
         RECOMMANDATIONS
    ====================================================== -->
    <section class="py-12 px-4 bg-neutral-50 border-t border-neutral-200">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Nos recommandations</h2>

        <h3 class="text-sm font-semibold text-red-700 uppercase tracking-widest mb-3">Le plus important (3 actions critiques)</h3>
        <div class="space-y-4 mb-10">
          {ameliorationsCritiques.map((a, i) => (
            <div class="bg-white border border-red-200 rounded-xl p-5">
              <div class="flex items-start gap-3">
                <span class="shrink-0 w-7 h-7 bg-red-100 text-red-700 rounded-full text-sm font-black flex items-center justify-center">{i + 1}</span>
                <div class="flex-1">
                  <h4 class="font-semibold text-neutral-900 mb-2">{a.titre}</h4>
                  <p class="text-sm text-neutral-600 mb-3">{a.detail}</p>
                  <div class="bg-red-50 border border-red-100 rounded-lg px-3 py-2">
                    <p class="text-xs text-red-800 font-medium">Action concrète : {a.action}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <h3 class="text-sm font-semibold text-amber-700 uppercase tracking-widest mb-3">Utile aussi</h3>
        <div class="grid sm:grid-cols-2 gap-4">
          {ameliorationsUtiles.map(a => (
            <div class="bg-white border border-amber-200 rounded-xl p-5">
              <h4 class="font-semibold text-neutral-900 text-sm mb-2">{a.titre}</h4>
              <p class="text-xs text-neutral-600">{a.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ======================================================
         CTA FINAL
    ====================================================== -->
    <section class="bg-neutral-900 text-white py-16 px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4">
          {kpis.conversion}% de vos visiteurs vous contactent.<br/>
          <span class="text-amber-400">On peut faire beaucoup mieux.</span>
        </h2>
        <p class="text-neutral-300 mb-3 max-w-xl mx-auto">
          Ce rapport identifie des opportunités concrètes. Je construis des sites qui convertissent vraiment
          — conçus pour des acheteurs exigeants, à partir de <strong class="text-white">990€</strong>, livrés en <strong class="text-white">7 jours</strong>.
        </p>
        <p class="text-neutral-400 text-sm mb-8">
          Cuisinistes, artisans, commerces locaux — je comprends votre clientèle parce que j'analyse des centaines de visites simulées avant d'écrire une seule ligne de code.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/commander" class="inline-flex items-center gap-2 px-8 py-3.5 bg-[var(--color-accent)] text-white font-semibold rounded-xl hover:opacity-90 transition-all shadow-md">
            Je veux un site qui convertit
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
          <a href="/contact" class="inline-flex items-center gap-2 px-8 py-3.5 border border-neutral-600 text-neutral-300 font-semibold rounded-xl hover:border-amber-400 hover:text-amber-400 transition-all">
            En discuter d'abord
          </a>
        </div>
        <p class="text-neutral-600 text-xs mt-6">Audit réalisé le {prospect.date} · Données issues d'une analyse automatisée + simulation de 10 personas</p>
      </div>
    </section>

  </main>
</BaseLayout>
