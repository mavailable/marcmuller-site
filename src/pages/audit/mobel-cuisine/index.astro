// ============================================================

const conversionByCanal = [
  { canal: "Bouche-à-oreille", taux: 67, color: "text-green-600", bg: "bg-green-500" },
  { canal: "Google Maps / GBP", taux: 33, color: "text-amber-600", bg: "bg-amber-500" },
