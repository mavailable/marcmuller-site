  { titre: 'Aucun prix ni fourchette budgétaire', count: 8, detail: 'Bloque toute comparaison — les acheteurs en phase décision partent chercher ailleurs' },
  { titre: 'Horaires du showroom introuvables', count: 6, detail: 'Crucial pour les prospects Maps qui veulent visiter ce week-end' },
  { titre: 'Pas de CTA "Devis gratuit" visible en haut de page', count: 7, detail: 'L\'action principale n\'est pas claire — il faut chercher le formulaire' },
  { titre: 'Galerie sans descriptions ni contexte', count: 6, detail: 'Les photos inspirent mais sans style, matériaux ou budget indicatif, elles ne convertissent pas' },
  { titre: 'Invisible pour les assistants IA (pas de Schema.org)', count: 4, detail: 'En 2026 un prospect sur 5 passe par ChatGPT/Claude — Confortel n\'existe pas pour eux' },
];

// =====================================================
// AUDIT TECHNIQUE
// =====================================================

const pagespeed = {
  mobile: { performance: 45, accessibility: 55, bestPractices: 52, seo: 58 },
  desktop: { performance: 68, accessibility: 60, bestPractices: 58, seo: 62 },
};

const coreWebVitals = [
