];

const observatory = {
  grade: 'F',
  score: 10,
  testsPassed: 5,
  testsTotal: 10,
};

const techChecks = [
  { label: 'Schema.org JSON-LD', present: false, critical: true },
  { label: 'Open Graph complet (title, description, image)', present: false, critical: true },
  { label: 'og:site_name correct (valeur actuelle : "Site 2")', present: false, critical: true },
  { label: 'Redirection HTTP → HTTPS', present: false, critical: true },
  { label: 'HSTS (Strict-Transport-Security)', present: false, critical: true },
  { label: 'CSP (Content-Security-Policy)', present: false, critical: false },
  { label: 'X-Frame-Options', present: false, critical: false },
  { label: 'X-Content-Type-Options', present: false, critical: false },
  { label: 'robots.txt présent', present: true, critical: false },
  { label: 'sitemap.xml présent (mais daté 2020)', present: true, critical: false },
  { label: 'Polices locales (pas de Google Fonts CDN)', present: false, critical: false },
  { label: 'Analytics fonctionnel (UA arrêté 2023)', present: false, critical: false },
];

// =====================================================
// AMELIORATIONS
// =====================================================

const ameliorationsCritiques = [
  {
    titre: 'Ajouter les horaires et un CTA "Devis gratuit" en homepage',
    detail: '6 personas sur 10 ont cherché les horaires. L\'absence d\'un bouton d\'action clair coûte des prises de contact quotidiennes.',
    action: 'Header : numéro cliquable + "Lun-Sam 9h-18h". Homepage : bouton "Demander mon devis gratuit" au-dessus de la ligne de flottaison.',
