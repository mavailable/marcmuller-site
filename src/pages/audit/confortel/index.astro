// =====================================================
// KPIs AGREGEES
// =====================================================

const nbConvertit = personas.filter(p => p.decision === 'convertit').length;
const nbHesite = personas.filter(p => p.decision === 'hesite').length;
const nbQuitte = personas.filter(p => p.decision === 'quitte').length;

const avgExp = (personas.reduce((s, p) => s + p.scores.exp, 0) / personas.length).toFixed(1);
const avgConf = (personas.reduce((s, p) => s + p.scores.conf, 0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.scores.clarte, 0) / personas.length).toFixed(1);

const tauxConversion = Math.round((nbConvertit / personas.length) * 100);

const kpis = {
  conversion: tauxConversion,
  experience: avgExp,
  confiance: avgConf,
  clarte: avgClarte,
};

// =====================================================
// CONSTAT PRINCIPAL
// =====================================================

const constat = "Confortel est une excellente entreprise de 30 ans avec 4 115 réalisations et des avis unanimement positifs — mais son site web daté, sans prix, sans horaires et sans Schema.org fait fuir 50 % des visiteurs avant qu'ils ne découvrent cette richesse.";

// =====================================================
// CONVERSION PAR CANAL
// =====================================================

const conversionByCanal = [
  { canal: 'Bouche-à-oreille', taux: 100, color: 'text-green-600', bg: 'bg-green-500' },
  { canal: 'Google Maps', taux: 50, color: 'text-amber-600', bg: 'bg-amber-500' },
  { canal: 'Google Search', taux: 33, color: 'text-amber-600', bg: 'bg-amber-500' },
  { canal: 'Réseaux sociaux', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'IA (Claude / ChatGPT)', taux: 0, color: 'text-red-600', bg: 'bg-red-500' },
  { canal: 'Autre (salon/carte)', taux: 100, color: 'text-green-600', bg: 'bg-green-500' },
];

