// =====================================================
// HELPERS
// =====================================================

function scoreColor(n: number): string {
  if (n >= 90) return '#22c55e';
  if (n >= 50) return '#f59e0b';
  return '#ef4444';
}

function scoreTextColor(n: number): string {
  if (n >= 90) return 'text-green-600';
  if (n >= 50) return 'text-amber-600';
  return 'text-red-600';
}

function decisionColor(d: string): string {
  if (d === 'convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}

function decisionBadge(d: string): string {
  if (d === 'convertit') return 'bg-green-100 text-green-800';
  if (d === 'hesite') return 'bg-amber-100 text-amber-800';
  return 'bg-neutral-100 text-neutral-600';
}

function decisionLabel(d: string): string {
  if (d === 'convertit') return 'Contacte';
  if (d === 'hesite') return 'Hesite';
  return 'Repart';
}

const title = 'Audit UX — Confortel Cuisiniste | Marc M.';
const description = 'Simulation de 10 visites personas sur confortel.eu — rapport complet avec recommandations priorisées.';
---

<BaseLayout {title} {description} noindex={true} lang="fr" frPath="/audit/confortel">

  <!-- ================================================ -->
  <!-- HERO + KPIs                                      -->
  <!-- ================================================ -->
  <section class="bg-neutral-900 text-white py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full mb-5">Rapport personnalisé — Web Factory</span>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-3 leading-tight">
        {prospect.name} — ce que vos visiteurs pensent vraiment
      </h1>
      <p class="text-neutral-400 mb-2">{prospect.activity} · {prospect.location}</p>
      <p class="text-neutral-500 text-sm mb-8">
        {prospect.slogan} ·
        <a href={prospect.url} class="text-amber-400 hover:underline" target="_blank" rel="noopener noreferrer">{prospect.url}</a>
      </p>

      <div class="grid grid-cols-3 gap-4 max-w-md">
        <div class="text-center bg-white/5 rounded-xl p-4">
          <span class="block text-3xl font-black text-amber-400">{kpis.conversion}%</span>
          <span class="text-xs text-neutral-400 mt-1 block">convertissent</span>
        </div>
        <div class="text-center bg-white/5 rounded-xl p-4">
          <span class="block text-3xl font-black text-amber-400">{kpis.experience}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">expérience</span>
        </div>
        <div class="text-center bg-white/5 rounded-xl p-4">
          <span class="block text-3xl font-black text-amber-400">{kpis.confiance}/10</span>
          <span class="text-xs text-neutral-400 mt-1 block">confiance</span>
        </div>
      </div>

      <p class="text-neutral-500 text-xs mt-6">
        Rapport généré le {prospect.date} — 10 visiteurs simulés, 6 pages analysées
      </p>
    </div>
  </section>

  <!-- ================================================ -->
  <!-- CONSTAT                                          -->
  <!-- ================================================ -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8">
        <p class="text-amber-900 font-medium leading-relaxed">{constat}</p>
      </div>

      <!-- Résumé décisions -->
      <div class="flex flex-wrap gap-4 mb-8">
        <div class="flex items-center gap-2 bg-green-50 border border-green-200 rounded-lg px-4 py-2">
          <span class="text-2xl font-black text-green-600">{nbConvertit}</span>
          <span class="text-sm text-green-700">contactent</span>
        </div>
        <div class="flex items-center gap-2 bg-amber-50 border border-amber-200 rounded-lg px-4 py-2">
          <span class="text-2xl font-black text-amber-600">{nbHesite}</span>
          <span class="text-sm text-amber-700">hésitent</span>
        </div>
        <div class="flex items-center gap-2 bg-neutral-100 border border-neutral-200 rounded-lg px-4 py-2">
          <span class="text-2xl font-black text-neutral-600">{nbQuitte}</span>
          <span class="text-sm text-neutral-700">repartent</span>
        </div>
      </div>

      <!-- Conversion par canal -->
      <h3 class="font-semibold text-neutral-800 mb-4 text-sm uppercase tracking-wide">Taux de contact par canal</h3>
      <div class="space-y-3 mb-10">
        {conversionByCanal.map(item => (
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-sm text-neutral-700">{item.canal}</span>
              <span class={`text-sm font-bold ${item.color}`}>{item.taux}%</span>
            </div>
            <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
              <div class={`h-full rounded-full ${item.bg}`} style={`width: ${item.taux}%`}></div>
            </div>
          </div>
        ))}
      </div>

      <!-- Top 5 frictions -->
      <h3 class="font-semibold text-neutral-800 mb-4 text-sm uppercase tracking-wide">Top 5 frictions</h3>
      <ol class="space-y-3">
        {topFrictions.map((f, i) => (
          <li class="flex gap-3 bg-neutral-50 border border-neutral-200 rounded-xl p-4">
            <span class="text-2xl font-black text-neutral-300 shrink-0 leading-none mt-0.5">{i + 1}</span>
            <div>
              <p class="font-semibold text-neutral-800 text-sm mb-0.5">{f.titre}</p>
              <p class="text-xs text-neutral-500">{f.detail}</p>
              <span class="inline-block mt-1 text-[11px] text-neutral-400 bg-neutral-100 px-2 py-0.5 rounded">{f.count} visiteurs impactés</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================================================ -->
  <!-- AUDIT TECHNIQUE                                  -->
  <!-- ================================================ -->
  <section class="py-12 px-4 bg-neutral-50 border-y border-neutral-200">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">L'audit technique</h2>
      <p class="text-neutral-500 text-sm mb-8">
        Scores estimés par analyse HTML, headers HTTP et résultats Observatory · PageSpeed API quota indisponible ce jour
      </p>

      <!-- PageSpeed mobile -->
      <div class="bg-white rounded-xl border border-neutral-200 p-6 mb-6">
        <h3 class="font-semibold text-neutral-800 mb-5 flex items-center gap-2">
          <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
          PageSpeed — Mobile
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {[
            { label: 'Performance', score: pagespeed.mobile.performance },
            { label: 'Accessibilité', score: pagespeed.mobile.accessibility },
            { label: 'Bonnes pratiques', score: pagespeed.mobile.bestPractices },
            { label: 'SEO', score: pagespeed.mobile.seo },
          ].map(item => (
            <div class="text-center">
              <div class="relative w-16 h-16 mx-auto mb-2">
                <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e5e7eb" stroke-width="3"/>
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke={scoreColor(item.score)} stroke-width="3" stroke-dasharray={`${item.score}, 100`} stroke-linecap="round"/>
                </svg>
                <span class={`absolute inset-0 flex items-center justify-center text-base font-bold ${scoreTextColor(item.score)}`}>{item.score}</span>
              </div>
              <p class="text-xs text-neutral-600">{item.label}</p>
            </div>
          ))}
        </div>

        <!-- Core Web Vitals -->
        <div class="mt-5 pt-5 border-t border-neutral-100 flex flex-wrap gap-3">
          {coreWebVitals.map(v => (
            <span class={`text-xs px-3 py-1.5 rounded-lg font-medium ${v.status === 'bad' ? 'bg-red-50 text-red-700' : 'bg-amber-50 text-amber-700'}`}>
              {v.name} : {v.value}
            </span>
          ))}
        </div>
      </div>

      <!-- PageSpeed desktop -->
      <div class="bg-white rounded-xl border border-neutral-200 p-6 mb-6">
        <h3 class="font-semibold text-neutral-800 mb-5 flex items-center gap-2">
          <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          PageSpeed — Desktop
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {[
            { label: 'Performance', score: pagespeed.desktop.performance },
            { label: 'Accessibilité', score: pagespeed.desktop.accessibility },
            { label: 'Bonnes pratiques', score: pagespeed.desktop.bestPractices },
            { label: 'SEO', score: pagespeed.desktop.seo },
          ].map(item => (
            <div class="text-center">
              <div class="relative w-16 h-16 mx-auto mb-2">
                <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e5e7eb" stroke-width="3"/>
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke={scoreColor(item.score)} stroke-width="3" stroke-dasharray={`${item.score}, 100`} stroke-linecap="round"/>
                </svg>
                <span class={`absolute inset-0 flex items-center justify-center text-base font-bold ${scoreTextColor(item.score)}`}>{item.score}</span>
              </div>
              <p class="text-xs text-neutral-600">{item.label}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Observatory -->
      <div class="bg-white rounded-xl border border-red-200 p-6 mb-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-semibold text-neutral-800">Sécurité — Mozilla Observatory</h3>
          <div class="flex items-center gap-2">
            <span class="text-3xl font-black text-red-600">{observatory.grade}</span>
            <span class="text-sm text-neutral-500">{observatory.score}/100</span>
          </div>
        </div>
        <p class="text-sm text-red-700 bg-red-50 rounded-lg px-4 py-2 mb-3">
          {observatory.testsPassed} tests passés sur {observatory.testsTotal} — 5 tests de sécurité critiques échoués
        </p>
        <ul class="text-xs text-neutral-600 space-y-1">
          <li class="flex items-center gap-2"><span class="text-red-500">✕</span> Content Security Policy absente (-25 pts)</li>
          <li class="flex items-center gap-2"><span class="text-red-500">✕</span> Pas de redirection HTTP → HTTPS (-20 pts)</li>
          <li class="flex items-center gap-2"><span class="text-red-500">✕</span> HSTS absent (-20 pts)</li>
          <li class="flex items-center gap-2"><span class="text-red-500">✕</span> X-Frame-Options absent (-5 pts)</li>
          <li class="flex items-center gap-2"><span class="text-red-500">✕</span> X-Content-Type-Options absent (-5 pts)</li>
        </ul>
      </div>

      <!-- Checklist Schema/OG/SEO -->
      <div class="bg-white rounded-xl border border-neutral-200 p-6">
        <h3 class="font-semibold text-neutral-800 mb-4">Checklist SEO & Schema.org</h3>
        <div class="grid sm:grid-cols-2 gap-2">
          {techChecks.map(check => (
            <div class={`flex items-start gap-2 text-xs p-2 rounded-lg ${check.present ? 'bg-green-50' : check.critical ? 'bg-red-50' : 'bg-neutral-50'}`}>
              <span class={`shrink-0 font-bold mt-0.5 ${check.present ? 'text-green-600' : 'text-red-500'}`}>
                {check.present ? '✓' : '✕'}
              </span>
              <span class={check.present ? 'text-green-800' : check.critical ? 'text-red-800' : 'text-neutral-600'}>
                {check.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================ -->
  <!-- PERSONAS / VISITEURS                             -->
  <!-- ================================================ -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
      <p class="text-neutral-500 text-sm mb-6">
        Sur 10 visiteurs simulés —
        <span class="text-green-700 font-semibold">{nbConvertit} vous contactent</span>,
        <span class="text-amber-700 font-semibold">{nbHesite} hésitent</span>,
        <span class="text-neutral-600 font-semibold">{nbQuitte} repartent sans laisser de trace</span>.
      </p>

      <div class="space-y-3">
        {personas.map(p => (
          <details class={`group border ${decisionColor(p.decision)} rounded-xl overflow-hidden`}>
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                  <h3 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h3>
                  <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class={`text-[11px] px-1.5 py-0.5 rounded font-medium ${decisionBadge(p.decision)}`}>{decisionLabel(p.decision)}</span>
                </div>
                <p class="text-xs text-neutral-500">{p.situation}</p>
              </div>
              <div class="shrink-0 flex items-center gap-3 mt-1">
                <div class="hidden sm:flex gap-2 text-xs">
                  <span class="text-neutral-400">Exp <strong class="text-neutral-700">{p.scores.exp}</strong></span>
                  <span class="text-neutral-400">Conf <strong class="text-neutral-700">{p.scores.conf}</strong></span>
                </div>
                <svg class="w-5 h-5 text-neutral-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </summary>

            <div class="px-4 pb-4 pt-0 border-t border-neutral-200/60 bg-white/60">
              <div class="grid gap-3 text-xs mt-3">
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Première impression</p>
                  <p class="text-neutral-600">{p.premierImpression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Parcours</p>
                  <p class="text-neutral-500">{p.parcours.join(' → ')}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Question clé</p>
                  <p class="text-neutral-600 italic">"{p.questionCle}"</p>
                  <p class="text-neutral-600 mt-1">Réponse du site : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-700' : 'text-amber-700'}>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-700 mb-1">Impact technique</p>
                  <p class="text-neutral-500 italic">{p.impactTechnique}</p>
                </div>
                <div class="grid sm:grid-cols-2 gap-3">
                  <div>
                    <p class="font-semibold text-green-700 mb-1">Points positifs</p>
                    <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                      {p.pointsPositifs.map(pt => <li>{pt}</li>)}
                    </ul>
                  </div>
                  <div>
                    <p class="font-semibold text-amber-700 mb-1">Frictions</p>
                    <ul class="list-disc list-inside text-neutral-600 space-y-0.5">
                      {p.frictions.map(fr => <li>{fr}</li>)}
                    </ul>
                  </div>
                </div>
                <div class="flex gap-4 pt-1">
                  <span class="text-neutral-400">Expérience <strong class="text-neutral-700">{p.scores.exp}/10</strong></span>
                  <span class="text-neutral-400">Confiance <strong class="text-neutral-700">{p.scores.conf}/10</strong></span>
                  <span class="text-neutral-400">Clarté <strong class="text-neutral-700">{p.scores.clarte}/10</strong></span>
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================ -->
  <!-- RECOMMANDATIONS                                  -->
  <!-- ================================================ -->
  <section class="py-12 px-4 bg-neutral-50 border-y border-neutral-200">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl font-bold text-neutral-900 mb-8">Nos recommandations</h2>

      <!-- 3 critiques -->
      <h3 class="text-xs font-semibold uppercase tracking-widest text-red-500 mb-4">Le plus important — à faire en priorité</h3>
      <div class="space-y-4 mb-10">
        {ameliorationsCritiques.map((a, i) => (
          <div class="bg-white border border-red-200 rounded-xl p-5">
            <div class="flex items-start gap-3">
              <span class="text-2xl font-black text-red-200 shrink-0 leading-none">{i + 1}</span>
              <div>
                <h4 class="font-semibold text-neutral-900 mb-1">{a.titre}</h4>
                <p class="text-sm text-neutral-600 mb-2">{a.detail}</p>
                <p class="text-xs text-red-700 bg-red-50 rounded px-3 py-1.5 inline-block">Action : {a.action}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- 3 utiles -->
      <h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-500 mb-4">Utile aussi — gain à moyen terme</h3>
      <div class="grid sm:grid-cols-3 gap-4">
        {ameliorationsUtiles.map(a => (
          <div class="bg-white border border-neutral-200 rounded-xl p-4">
            <h4 class="font-semibold text-neutral-800 text-sm mb-2">{a.titre}</h4>
            <p class="text-xs text-neutral-500">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================ -->
  <!-- CTA FINAL                                        -->
  <!-- ================================================ -->
  <section class="bg-neutral-900 text-white py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4 leading-snug">
        {kpis.conversion}% de vos visiteurs vous contactent.<br/>
        <span class="text-amber-400">Avec un site moderne, on peut doubler ce chiffre.</span>
      </h2>
      <p class="text-neutral-300 mb-3 max-w-xl mx-auto text-sm leading-relaxed">
        Confortel a tout pour convaincre — 30 ans d'expertise, 4 115 réalisations, des marques premium, une équipe reconnue.
        Il manque juste un site à la hauteur.
      </p>
      <p class="text-neutral-400 mb-8 text-sm">
        Site complet Astro v5 · Schema.org · HTTPS sécurisé · Analytics · délivré en 7 jours · à partir de 990 €
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/commander"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-[var(--color-accent-500)] text-white font-semibold rounded-xl hover:bg-[var(--color-accent-600)] transition-all shadow-md"
        >
          Je veux un site qui convertit
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-8 py-3.5 border border-neutral-600 text-neutral-300 font-semibold rounded-xl hover:border-amber-400 hover:text-amber-400 transition-all"
        >
          En discuter d'abord
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
