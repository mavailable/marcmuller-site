---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { business } from '../data/business';

const whatsappMessage = encodeURIComponent(business.whatsappMessage);

const etapes = [
  {
    num: '01',
    title: 'Vous commandez en ligne',
    detail: 'Paiement sécurisé, questionnaire guidé immédiat. Vous décrivez votre activité, vos clients, ce que vous voulez que le site fasse pour vous. 15 minutes, pas plus.',
    duree: 'Jour 0',
  },
  {
    num: '02',
    title: 'On fait le point ensemble',
    detail: 'Un échange de 15 minutes — téléphone, visio ou écrit, comme vous préférez. Je clarifie les quelques points flous. Pas de réunion de cadrage, pas de présentation de 40 slides.',
    duree: 'Jour 1',
  },
  {
    num: '03',
    title: 'Je construis',
    detail: 'Design unique, textes rédigés, images optimisées, SEO, Schema.org, Open Graph. Tout. Vous ne touchez rien. Je ne viens pas vous demander "vous préférez le bleu ou le vert ?" toutes les deux heures.',
    duree: 'Jours 2–6',
  },
  {
    num: '04',
    title: 'Vous voyez, vous validez',
    detail: 'Lien de prévisualisation privé. Vous me donnez votre liste complète de retours — je corrige tout en une fois, pas en dix allers-retours. Puis mise en ligne sur votre domaine.',
    duree: 'Jour 7',
  },
];
---

<BaseLayout
  title="Comment ça marche — Marc M | Process & Méthode"
  description="Process complet : comment je livre un site sur mesure en 7 jours à 490€. Pas de template, pas de WordPress, pas d'intermédiaire."
  lang="fr"
  frPath="/methode"
  enPath="/en/method"
>

  <!-- HERO -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>

    <div class="mx-auto max-w-3xl relative z-10">
      <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color: #E86C47; letter-spacing: 0.2em;">Comment ça marche</p>
      <h1 class="text-3xl font-bold text-white md:text-4xl lg:text-5xl mb-6 leading-tight">
        Un site à 490€.<br/>
        <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">Pas un compromis.</span>
      </h1>
      <p class="text-lg text-neutral-400 max-w-xl leading-relaxed">
        La question que tout le monde se pose : est-ce que c'est vraiment sérieux à ce prix-là ? Je vais vous expliquer d'où vient le chiffre, et comment ça se passe concrètement.
      </p>
    </div>
  </section>

  <!-- EDITORIAL — Pourquoi c'est possible -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-2xl">

      <p class="text-xl md:text-2xl leading-relaxed text-[var(--color-text)] font-medium mb-10">
        490€, ce n'est pas le prix d'un site au rabais. C'est le prix d'un site construit par quelqu'un qui a éliminé tout ce qui fait gonfler les devis sans faire de meilleurs sites.
      </p>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-6">
        Pas de locaux à Metz avec loyer et charges. Pas de commercial qui prend 20% du projet pour vous serrer la main. Pas de chef de projet qui fait le lien entre vous et le développeur (en perdant la moitié du brief au passage). Pas de réunions hebdomadaires pour "faire le point sur l'avancement".
      </p>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-12">
        Juste moi, les outils, et le travail. Remote, avec des clients à Metz, Paris, Lyon, Strasbourg et jusque dans les DOM-TOM. Ce qui prend des semaines dans une agence prend ici des jours — parce que chaque étape est outillée et répétable. Le gain de temps profite au prix, pas à ma marge.
      </p>

      <!-- Citation éditoriale -->
      <div class="border-l-4 pl-6 md:pl-8 mb-12" style="border-color: var(--color-accent);">
        <p class="text-lg md:text-xl leading-relaxed text-[var(--color-text)] italic">
          Une agence à 2 500€ fait peut-être un excellent travail. Mais elle facture aussi ses locaux, son commercial, son chef de projet et ses réunions. Le code produit n'est pas 5× meilleur — les frais fixes sont 5× plus élevés. Ici, vous payez le travail réel.
        </p>
      </div>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-6">
        J'utilise des outils modernes — Astro, Tailwind CSS, Cloudflare — pas WordPress avec 40 plugins à maintenir, à mettre à jour, à patcher quand l'un d'eux crée une faille de sécurité. Des sites qui chargent en moins d'une seconde. Des scores Lighthouse qu'aucune agence ne garantit par écrit parce qu'ils savent que ce n'est pas ce qu'ils vont livrer.
      </p>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)]">
        Et puis 33 projets livrés, ça compte. Chaque client m'a appris quelque chose. Les erreurs du passé ne refont pas surface dans vos pages — elles sont corrigées dans le process avant que vous ne les voyiez.
      </p>

    </div>
  </section>

  <!-- LES 4 ÉTAPES -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-20 border-y" style="border-color: var(--color-border);">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] mb-3" style="letter-spacing: 0.2em;">Le process</p>
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-2">4 étapes, 7 jours</h2>
      <p class="text-[var(--color-text-muted)] mb-10 max-w-xl">Voici ce qui se passe réellement, sans version polie pour brochure.</p>

      <div class="space-y-0">
        {etapes.map((e, i) => (
          <div class="flex gap-6 pb-10 relative">
            {i < etapes.length - 1 && (
              <div class="absolute left-6 top-14 bottom-0 w-px bg-neutral-200"></div>
            )}
            <div class="flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center font-bold text-white text-sm z-10" style="background-color: #E86C47;">
              {e.num}
            </div>
            <div class="pt-2.5">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="font-bold text-[var(--color-text)]">{e.title}</h3>
                <span class="text-xs text-neutral-400 bg-neutral-100 px-2 py-0.5 rounded-full">{e.duree}</span>
              </div>
              <p class="text-[var(--color-text-muted)] text-sm leading-relaxed">{e.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CE QUE VOUS OBTENEZ — liste technique -->
  <section class="w-full px-6 py-16 md:px-8 md:py-20" style="background: #FAFAFA;">
    <div class="mx-auto max-w-2xl">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-3">Ce que chaque site inclut</h2>
      <p class="text-[var(--color-text-muted)] mb-8">Pas de liste à cocher pour vendre des options. Tout ça est inclus, par défaut, dans chaque projet.</p>
      <div class="grid gap-0 sm:grid-cols-2">
        {[
          'Design unique — construit à votre image, pas un template',
          'Textes rédigés — à partir de 15 min d\'échange avec vous',
          'Ultra-rapide — Lighthouse 100/100 garanti',
          'SEO + GEO — Google et IA (ChatGPT, Perplexity, Claude)',
          'Responsive mobile — testé sur tous les écrans',
          'Hébergement à vie — Cloudflare, zéro abonnement',
          'Votre domaine, vos règles — je ne vous retiens pas',
          'CMS simple — modifiez vos textes comme un email',
          'Mentions légales — conformes RGPD',
          'Schema.org — données structurées pour les moteurs',
          'Open Graph — aperçu soigné sur les réseaux sociaux',
          'HTTPS / SSL — inclus, automatique',
        ].map(item => (
          <div class="flex items-start gap-3 py-3 border-b border-neutral-100">
            <svg class="w-4 h-4 flex-shrink-0 mt-0.5" style="color: #E86C47;" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm text-[var(--color-text-muted)]">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NOTE PERSO -->
  <section class="w-full bg-white px-6 py-10 md:px-8 md:py-12 border-t border-neutral-100">
    <div class="mx-auto max-w-2xl flex items-start gap-4">
      <span class="text-2xl flex-shrink-0 mt-0.5">🤿</span>
      <p class="text-[var(--color-text-muted)] leading-relaxed text-sm">
        Je travaille 100% remote — depuis Metz, depuis la Thaïlande entre deux plongées, depuis où je suis. Ce n'est pas une contrainte, c'est une liberté qui profite à tout le monde : je choisis mes clients, je travaille au calme, et ça se voit dans ce que je produis.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-20 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="mx-auto max-w-2xl text-center relative z-10">
      <h2 class="text-2xl font-bold text-white mb-4">Prêt à démarrer ?</h2>
      <p class="text-neutral-400 mb-8">Commander prend 10 minutes. Le site arrive dans 7 jours.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <Button href="/offre" variant="primary">Voir l'offre — 490€</Button>
        <Button href={`https://wa.me/${business.whatsapp}?text=${whatsappMessage}`} variant="secondary" external>Une question d'abord →</Button>
      </div>
    </div>
  </section>

</BaseLayout>
