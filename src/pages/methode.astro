---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { business } from '../data/business';

const whatsappMessage = encodeURIComponent(business.whatsappMessage);

const etapes = [
  {
    num: '01',
    title: 'Vous commandez en ligne',
    detail: 'Paiement sécurisé, questionnaire guidé immédiat. Vous décrivez votre activité, vos clients, ce que vous voulez que le site fasse pour vous. 15 minutes, pas plus.',
    duree: 'Jour 0',
  },
  {
    num: '02',
    title: 'On fait le point ensemble',
    detail: 'Un échange de 15 minutes — téléphone, visio ou écrit, comme vous préférez. Je clarifie les quelques points flous et je valide la direction. Aucune réunion interminable.',
    duree: 'Jour 1',
  },
  {
    num: '03',
    title: 'Je construis',
    detail: 'Design unique, textes rédigés, images optimisées, SEO posé, Schema.org, Open Graph. Tout. Vous ne touchez rien.',
    duree: 'Jours 2–6',
  },
  {
    num: '04',
    title: 'Vous recevez le lien de prévisualisation',
    detail: 'Vous voyez le site avant la mise en ligne. Vous me donnez votre liste de retours — je corrige tout en une fois. Puis mise en ligne sur votre domaine.',
    duree: 'Jour 7',
  },
];

const pourquoi = [
  {
    titre: 'Pas de commercial',
    texte: 'Vous discutez directement avec la personne qui construit votre site. Pas d\'intermédiaire, pas de chef de projet entre vous et le code.',
  },
  {
    titre: 'Pas de locaux',
    texte: '100% remote. J\'ai des clients à Metz, Paris, Strasbourg, Lyon, et jusque dans les DOM-TOM. Les frais fixes d\'une agence ne font pas partie de votre devis.',
  },
  {
    titre: 'Des outils modernes',
    texte: 'Astro, Tailwind CSS, Cloudflare. Pas de WordPress avec 40 plugins à maintenir. Des sites qui chargent en moins d\'une seconde et ne se cassent pas.',
  },
  {
    titre: 'Un process documenté',
    texte: 'Chaque étape est outillée et répétable. Ce que j\'ai mis des semaines à construire la première fois prend maintenant des jours. Le gain de temps profite au prix.',
  },
  {
    titre: 'Volume = crédibilité',
    texte: '33 projets livrés. Chaque projet m\'a appris quelque chose. Les erreurs du passé ne refont pas surface dans vos pages.',
  },
  {
    titre: 'Un seul artisan, du début à la fin',
    texte: 'Design, code, textes, SEO, mise en ligne : une seule personne responsable. Pas de handoff, pas de brief perdu entre des équipes différentes.',
  },
];
---

<BaseLayout
  title="Comment ça marche — Marc M | Process & Méthode"
  description="Process complet : comment je livre un site sur mesure en 7 jours à 490€. Pas de template, pas de WordPress, pas d'intermédiaire."
  lang="fr"
  frPath="/methode"
  enPath="/en/method"
>

  <!-- HERO -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>

    <div class="mx-auto max-w-3xl relative z-10">
      <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color: #E86C47; letter-spacing: 0.2em;">Comment ça marche</p>
      <h1 class="text-3xl font-bold text-white md:text-4xl lg:text-5xl mb-6 leading-tight">
        Un site à 490€.<br/>
        <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">Pas un compromis.</span>
      </h1>
      <p class="text-lg text-neutral-300 max-w-xl leading-relaxed">
        Ce n'est pas un template. Ce n'est pas bâclé. Voici pourquoi c'est possible — et comment ça se passe concrètement.
      </p>
    </div>
  </section>

  <!-- LES 4 ÉTAPES -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-20">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] mb-3" style="letter-spacing: 0.2em;">Le process</p>
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-10">4 étapes, 7 jours</h2>

      <div class="space-y-0">
        {etapes.map((e, i) => (
          <div class="flex gap-6 pb-10 relative">
            {i < etapes.length - 1 && (
              <div class="absolute left-6 top-14 bottom-0 w-px bg-neutral-200"></div>
            )}
            <div class="flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center font-bold text-white text-sm z-10" style="background-color: #E86C47;">
              {e.num}
            </div>
            <div class="pt-2.5">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="font-bold text-[var(--color-text)]">{e.title}</h3>
                <span class="text-xs text-neutral-400 bg-neutral-100 px-2 py-0.5 rounded-full">{e.duree}</span>
              </div>
              <p class="text-[var(--color-text-muted)] text-sm leading-relaxed">{e.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- POURQUOI 490€ EST POSSIBLE -->
  <section class="w-full px-6 py-16 md:px-8 md:py-20" style="background: #FAFAFA;">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] mb-3" style="letter-spacing: 0.2em;">La vraie question</p>
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-3">Pourquoi 490€ et pas 2 500€ ?</h2>
      <p class="text-[var(--color-text-muted)] mb-10 max-w-2xl">
        La question est légitime. Voici les vraies raisons — pas un argument marketing.
      </p>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {pourquoi.map(p => (
          <div class="bg-white rounded-xl border border-[var(--color-border)] p-6">
            <h3 class="font-bold text-[var(--color-text)] mb-2 text-sm">{p.titre}</h3>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{p.texte}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 bg-amber-50 border border-amber-200 rounded-xl p-6">
        <p class="text-sm text-amber-900 leading-relaxed">
          <strong>La comparaison honnête :</strong> Une agence à 2 500€ facture aussi ses locaux, son commercial, son chef de projet et ses réunions. Le code produit n'est pas 5× meilleur — les frais fixes sont 5× plus élevés. Ici, vous payez le travail réel.
        </p>
      </div>
    </div>
  </section>

  <!-- CE QUE VOUS OBTENEZ -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-20">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-8">Ce que chaque site inclut</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {[
          'Design unique — construit à votre image, pas un template',
          'Textes rédigés — à partir de 15 min d\'échange',
          'Ultra-rapide — Lighthouse 100/100 garanti',
          'SEO + GEO — Google et IA (ChatGPT, Perplexity, Claude)',
          'Responsive mobile — testé sur tous les écrans',
          'Hébergement à vie — Cloudflare, zéro abonnement',
          'Domaine conservé — votre URL, vos règles',
          'CMS simple — modifiez vos textes comme un email',
          'Mentions légales — conformes RGPD',
          'Schema.org — données structurées pour les moteurs',
          'Open Graph — partage sur réseaux avec aperçu',
          'SSL — HTTPS inclus, certificat automatique',
        ].map(item => (
          <div class="flex items-start gap-3 py-2.5 border-b border-neutral-100">
            <svg class="w-4 h-4 flex-shrink-0 mt-0.5" style="color: #E86C47;" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm text-[var(--color-text-muted)]">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-20 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="mx-auto max-w-2xl text-center relative z-10">
      <h2 class="text-2xl font-bold text-white mb-4">Prêt à démarrer ?</h2>
      <p class="text-neutral-300 mb-8">Commander prend 10 minutes. Le site arrive dans 7 jours.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <Button href="/offre" variant="primary">Voir l'offre — 490€</Button>
        <Button href={`https://wa.me/${business.whatsapp}?text=${whatsappMessage}`} variant="secondary" external>Une question d'abord →</Button>
      </div>
    </div>
  </section>

</BaseLayout>
