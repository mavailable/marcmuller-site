---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';

const whatsappMessage = encodeURIComponent("Bonjour Marc, je voudrais un audit gratuit de ma visibilité en ligne.");

const demoPersonas = [
  { emoji: '🔧', name: 'Thierry', age: 52, job: 'Artisan plombier', canal: 'Google', device: 'Mobile', decision: 'hésite', color: 'amber', reason: 'Cherche "plombier urgence [ville]". Arrive sur votre site. Pas de numéro de téléphone en haut. Repart en 8 secondes.' },
  { emoji: '✂️', name: 'Émilie', age: 34, job: 'Coiffeuse', canal: 'Google Maps', device: 'Mobile', decision: 'convertit', color: 'emerald', reason: 'Clique sur votre fiche Maps. Arrive sur le site. Voit des avis 5★, un prix, un bouton "Réserver". Appelle dans l\'heure.' },
  { emoji: '🏡', name: 'Nathalie', age: 58, job: 'Cherche un artisan', canal: 'Bouche-à-oreille', device: 'Mobile', decision: 'repart', color: 'red', reason: 'On lui a recommandé votre nom. Elle cherche votre site. Site non mobile. Pas de SIRET visible. Doute. Va sur Pages Jaunes.' },
];
---

<BaseLayout
  title="Audit gratuit — Votre site est-il visible sur Google ? — Marc M"
  description="Je simule comment vos vrais visiteurs voient votre site et j'identifie ce qui les fait repartir. Gratuit, sous 48h, sans engagement."
  ogImage="/og-audit-gratuit.jpg"
  lang="fr"
  frPath="/audit-gratuit"
  enPath="/en/free-audit"
>

  <!-- HERO -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 right-0 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>

    <div class="mx-auto max-w-2xl relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]/40 mb-6">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
        <span class="text-sm font-medium text-white/90">Gratuit — réponse sous 48h</span>
      </div>
      <h1 class="text-3xl font-bold text-white md:text-4xl lg:text-5xl mb-6 leading-tight">
        Ce que vos visiteurs voient<br/>
        <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">que vous ne voyez pas.</span>
      </h1>
      <p class="text-lg text-neutral-300 leading-relaxed mb-4">
        Je visite votre site comme le ferait un vrai client potentiel, et je vous dis ce qui le fait repartir. Pas un rapport PDF générique — un regard humain sur votre situation.
      </p>
      <p class="text-sm text-neutral-500">Pas de relance automatique. Pas de séquence email. Une réponse réelle, de moi.</p>
    </div>
  </section>

  <!-- CE QUE JE FAIS CONCRÈTEMENT -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-20">
    <div class="mx-auto max-w-2xl">

      <h2 class="text-xl font-bold text-[var(--color-text)] mb-6">Ce que je fais concrètement</h2>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-6">
        Quand vous soumettez votre site, je le visite en me mettant dans la peau de quelques-uns de vos clients typiques. Pas avec des outils automatiques — avec ma tête, en simulant ce qu'un artisan de 50 ans arrivant de Google Maps verrait sur son téléphone, ou ce qu'une jeune entrepreneuse cherchant une référence précise trouverait (ou ne trouverait pas).
      </p>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-10">
        C'est une version allégée de mon service <a href="/echo" class="underline underline-offset-2" style="color: var(--color-accent);">Écho</a> — où je simule jusqu'à 100 visiteurs différents avec des profils, des canaux d'arrivée et des intentions variées. Ici, je cible les deux ou trois frictions les plus visibles, celles qui coûtent des clients aujourd'hui.
      </p>

      <!-- Demo personas -->
      <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--color-accent); letter-spacing: 0.15em;">Exemples de ce que j'observe</p>
      <div class="space-y-3 mb-10">
        {demoPersonas.map(p => (
          <div class={`rounded-xl border p-4 ${p.color === 'emerald' ? 'border-emerald-200 bg-emerald-50' : p.color === 'red' ? 'border-red-200 bg-red-50' : 'border-amber-200 bg-amber-50'}`}>
            <div class="flex items-start gap-3">
              <span class="text-xl flex-shrink-0">{p.emoji}</span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="font-semibold text-sm text-[var(--color-text)]">{p.name}, {p.age} ans</span>
                  <span class="text-xs text-neutral-500">{p.job}</span>
                  <span class="text-xs text-neutral-400">· {p.canal} · {p.device}</span>
                </div>
                <p class={`text-xs leading-relaxed ${p.color === 'emerald' ? 'text-emerald-800' : p.color === 'red' ? 'text-red-800' : 'text-amber-800'}`}>
                  {p.reason}
                </p>
              </div>
              <span class={`flex-shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full ${p.color === 'emerald' ? 'bg-emerald-100 text-emerald-700' : p.color === 'red' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>
                {p.decision}
              </span>
            </div>
          </div>
        ))}
      </div>

      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
        Pour votre audit gratuit, je vous donne 3 observations de ce type — ciblées sur votre situation réelle, pas sur une grille de critères génériques.
      </p>

    </div>
  </section>

  <!-- FORMULAIRE -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-20 border-t border-neutral-100">
    <div class="mx-auto max-w-xl">

      <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">Demandez votre audit</h2>
      <p class="text-[var(--color-text-muted)] text-sm mb-8">2 minutes. Je vous réponds dans les 48h.</p>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="space-y-6"
      >
        <input type="hidden" name="access_key" value="dccda1f5-4e63-4b9f-9c66-f5ce76f0dfdd" />
        <input type="hidden" name="form_source" value="audit-gratuit" />
        <input type="text" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="redirect" value="https://marcm.fr/merci" />
        <input type="hidden" name="subject" value="Audit gratuit demandé — marcm.fr" />
        <input type="hidden" name="from_page" value="/audit-gratuit" />

        <div>
          <label for="nom" class="block text-sm font-medium text-[var(--color-text)] mb-2">Votre prénom *</label>
          <input
            type="text"
            id="nom"
            name="nom"
            required
            placeholder="Marie"
            class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition"
          />
        </div>

        <div>
          <label for="activite" class="block text-sm font-medium text-[var(--color-text)] mb-2">Votre activité *</label>
          <input
            type="text"
            id="activite"
            name="activite"
            required
            placeholder="Coiffeuse à Metz, plombier à Nancy, kiné à Strasbourg..."
            class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition"
          />
        </div>

        <div>
          <label for="situation" class="block text-sm font-medium text-[var(--color-text)] mb-2">Votre situation actuelle *</label>
          <select
            id="situation"
            name="situation"
            required
            class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition bg-white"
          >
            <option value="">Choisissez...</option>
            <option value="Pas de site du tout">Je n'ai pas de site du tout</option>
            <option value="Site existant que je veux améliorer">J'ai un site mais il ne me ramène pas de clients</option>
            <option value="Site WordPress / Wix à refaire">J'ai un WordPress ou Wix à refaire</option>
            <option value="Site récent mais pas visible">J'ai un site récent mais je ne suis pas visible sur Google</option>
            <option value="Je démarre mon activité">Je démarre mon activité et je prépare le lancement</option>
          </select>
        </div>

        <div>
          <label for="url" class="block text-sm font-medium text-[var(--color-text)] mb-2">URL de votre site actuel <span class="text-neutral-400 font-normal">(si vous en avez un)</span></label>
          <input
            type="url"
            id="url"
            name="url_site"
            placeholder="https://votre-site.fr"
            class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition"
          />
        </div>

        <div>
          <label for="probleme" class="block text-sm font-medium text-[var(--color-text)] mb-2">Ce qui vous pose problème en ce moment *</label>
          <textarea
            id="probleme"
            name="probleme"
            required
            rows="3"
            placeholder="Ex : mes concurrents apparaissent sur Google Maps et pas moi, mon site est lent, je n'ai pas de demandes via internet..."
            class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition resize-none"
          ></textarea>
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-[var(--color-text)] mb-2">Votre email pour recevoir l'audit *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="vous@votreentreprise.fr"
            class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition"
          />
        </div>

        <!-- RGPD -->
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" name="rgpd" required aria-required="true" class="mt-1 rounded border-neutral-300 focus:ring-2 focus:ring-[var(--color-accent)]/30" style="accent-color: #E86C47;" />
          <span class="text-xs text-neutral-500 leading-relaxed">
            J'accepte que mes données soient utilisées pour réaliser mon audit. Elles ne sont ni revendues ni utilisées pour du marketing automatisé. <a href="/politique-confidentialite" class="underline underline-offset-2 hover:text-[var(--color-accent-text)] transition-colors">Politique de confidentialité</a>
          </span>
        </label>

        <button
          type="submit"
          class="w-full py-4 px-6 rounded-xl font-bold text-white transition-opacity hover:opacity-90"
          style="background-color: #E86C47;"
          data-umami-event="audit-gratuit-submit"
        >
          Envoyer ma demande d'audit →
        </button>
      </form>
    </div>
  </section>

  <!-- CE QUE VOUS RECEVREZ -->
  <section class="w-full px-6 py-16 md:px-8 md:py-20" style="background: #FAFAFA;">
    <div class="mx-auto max-w-2xl">
      <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">Ce que vous recevrez</h2>
      <p class="text-[var(--color-text-muted)] text-sm mb-8">Pas un PDF de 12 pages avec des captures d'écran et des scores. Trois points précis, écrits à la main.</p>
      <div class="space-y-4">
        {[
          { num: '01', titre: 'La friction principale', desc: 'Ce qui fait repartir vos visiteurs — la vraie raison, pas "votre LCP est de 3.8 secondes". Quelque chose comme : Thierry, plombier de 52 ans, n\'a pas trouvé votre numéro de téléphone en 8 secondes.' },
          { num: '02', titre: 'Ce que font vos concurrents', desc: 'Pas une liste de 40 choses à améliorer. Un seul point concret où un concurrent local devance votre site aux yeux d\'un client type.' },
          { num: '03', titre: 'La première action à faire', desc: 'Réalisable seul si vous avez la main sur votre site, ou avec mon aide si vous voulez. Zéro obligation — le rapport vous appartient.' },
        ].map(o => (
          <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 flex gap-4">
            <div class="text-2xl font-bold flex-shrink-0" style="color: #E86C47; opacity: 0.35;">{o.num}</div>
            <div>
              <h3 class="font-bold text-[var(--color-text)] mb-1 text-sm">{o.titre}</h3>
              <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{o.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LIEN VERS ECHO -->
  <section class="w-full bg-white px-6 py-12 md:px-8 border-t border-neutral-100">
    <div class="mx-auto max-w-2xl">
      <div class="rounded-xl border border-neutral-200 p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="flex-1">
          <p class="font-semibold text-[var(--color-text)] text-sm mb-1">Vous voulez aller plus loin ?</p>
          <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
            Mon service Écho simule jusqu'à 100 visiteurs différents sur votre site — avec des profils, des canaux d'arrivée et des intentions variées. Résultats en 48h, rapport interactif privé.
          </p>
        </div>
        <a href="/echo" class="flex-shrink-0 inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl font-semibold text-sm text-white transition-opacity hover:opacity-90 whitespace-nowrap" style="background-color: #E86C47;">
          Découvrir Écho →
        </a>
      </div>
    </div>
  </section>

  <!-- SORTIE : PRENDRE RDV OU WHATSAPP -->
  <section class="w-full bg-white px-6 py-10 md:px-8 border-t border-neutral-100">
    <div class="mx-auto max-w-xl text-center">
      <p class="text-neutral-500 text-sm mb-4">Pas envie d'attendre l'audit ? On peut en parler direct.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="https://cal.com/marc-muller/15min"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-white transition-all hover:shadow-lg hover:-translate-y-0.5"
          style="background: linear-gradient(135deg, #E86C47, #D4572F); box-shadow: 0 4px 20px rgba(232, 108, 71, 0.3);"
          data-umami-event="cal-cta-audit"
        >
          On en parle ? 15 min, sans engagement
        </a>
        <a
          href={`https://wa.me/${business.whatsapp}?text=${whatsappMessage}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl border border-neutral-200 text-sm font-medium text-[var(--color-text)] hover:bg-neutral-50 transition"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Écrire sur WhatsApp
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
