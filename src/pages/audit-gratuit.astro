---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { business } from '../data/business';

const whatsappMessage = encodeURIComponent("Bonjour Marc, je voudrais un audit gratuit de ma visibilité en ligne.");
---

<BaseLayout
  title="Audit gratuit — Votre site est-il visible sur Google ? — Marc M"
  description="Soumettez votre site (ou l'absence de site) en 2 minutes. Je vous envoie 3 observations personnalisées sur votre visibilité en ligne sous 48h. Gratuit, sans engagement."
  lang="fr"
  frPath="/audit-gratuit"
  enPath="/en/free-audit"
>

  <!-- HERO -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 right-0 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>

    <div class="mx-auto max-w-2xl relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-accent)]/40 mb-6">
        <span class="w-2 h-2 rounded-full bg-green-400"></span>
        <span class="text-sm font-medium text-white/90">Gratuit — réponse sous 48h</span>
      </div>
      <h1 class="text-3xl font-bold text-white md:text-4xl lg:text-5xl mb-6 leading-tight">
        Votre site est-il<br/>
        <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">visible sur Google ?</span>
      </h1>
      <p class="text-lg text-neutral-300 leading-relaxed mb-4">
        Remplissez le formulaire en 2 minutes. Je regarde votre situation et je vous envoie <strong class="text-white">3 observations concrètes</strong> sur ce qui bloque votre visibilité — ou sur ce que vous pourriez faire avant même d'avoir un site.
      </p>
      <p class="text-sm text-neutral-500">Pas de relance automatique. Pas de séquence email. Une réponse réelle, de moi.</p>
    </div>
  </section>

  <!-- FORMULAIRE -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-20">
    <div class="mx-auto max-w-xl">

      <div aria-live="polite" aria-atomic="true" class="sr-only" id="form-status"></div>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="space-y-6"
      >
        <input type="hidden" name="access_key" value="dccda1f5-4e63-4b9f-9c66-f5ce76f0dfdd" />
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="subject" value="Audit gratuit demandé — marcm.fr" />
        <input type="hidden" name="from_page" value="/audit-gratuit" />

        <div>
          <label for="nom" class="block text-sm font-medium text-[var(--color-text)] mb-2">Votre prénom *</label>
          <input
            type="text"
            id="nom"
            name="nom"
            required
            placeholder="Marie"
            class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition"
          />
        </div>

        <div>
          <label for="activite" class="block text-sm font-medium text-[var(--color-text)] mb-2">Votre activité *</label>
          <input
            type="text"
            id="activite"
            name="activite"
            required
            placeholder="Coiffeuse à Metz, plombier à Nancy, kiné à Strasbourg..."
            class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition"
          />
        </div>

        <div>
          <label for="situation" class="block text-sm font-medium text-[var(--color-text)] mb-2">Votre situation actuelle *</label>
          <select
            id="situation"
            name="situation"
            required
            class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition bg-white"
          >
            <option value="">Choisissez...</option>
            <option value="Pas de site du tout">Je n'ai pas de site du tout</option>
            <option value="Site existant que je veux améliorer">J'ai un site mais il ne me ramène pas de clients</option>
            <option value="Site WordPress / Wix à refaire">J'ai un WordPress ou Wix à refaire</option>
            <option value="Site récent mais pas visible">J'ai un site récent mais je ne suis pas visible sur Google</option>
            <option value="Je démarre mon activité">Je démarre mon activité et je prépare le lancement</option>
          </select>
        </div>

        <div>
          <label for="url" class="block text-sm font-medium text-[var(--color-text)] mb-2">URL de votre site actuel <span class="text-neutral-400 font-normal">(si vous en avez un)</span></label>
          <input
            type="url"
            id="url"
            name="url_site"
            placeholder="https://votre-site.fr"
            class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition"
          />
        </div>

        <div>
          <label for="probleme" class="block text-sm font-medium text-[var(--color-text)] mb-2">Ce qui vous pose problème en ce moment *</label>
          <textarea
            id="probleme"
            name="probleme"
            required
            rows="3"
            placeholder="Ex : mes concurrents apparaissent sur Google Maps et pas moi, mon site est lent, je n'ai pas de demandes via internet..."
            class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition resize-none"
          ></textarea>
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-[var(--color-text)] mb-2">Votre email pour recevoir l'audit *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="vous@votreentreprise.fr"
            class="w-full rounded-xl border border-[var(--color-border)] px-4 py-3 text-[var(--color-text)] placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/30 focus:border-[var(--color-accent)] transition"
          />
        </div>

        <button
          type="submit"
          class="w-full py-4 px-6 rounded-xl font-bold text-white transition-opacity hover:opacity-90"
          style="background-color: #E86C47;"
          data-umami-event="audit-gratuit-submit"
        >
          Envoyer ma demande d'audit →
        </button>

        <p class="text-xs text-neutral-400 text-center">
          Vos données ne sont pas revendues ni utilisées pour du marketing automatisé.
        </p>
      </form>
    </div>
  </section>

  <!-- CE QUE VOUS RECEVREZ -->
  <section class="w-full px-6 py-16 md:px-8 md:py-20" style="background: #FAFAFA;">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-8 text-center">Ce que vous recevrez</h2>
      <div class="grid gap-5 sm:grid-cols-3">
        {[
          { num: '01', titre: 'Observation #1', desc: 'Ce qui bloque votre visibilité en ce moment — cause principale identifiée.' },
          { num: '02', titre: 'Observation #2', desc: 'Ce que font vos concurrents que vous ne faites pas — comparaison concrète.' },
          { num: '03', titre: 'Observation #3', desc: 'La première action à faire — réalisable seul ou avec mon aide, selon votre situation.' },
        ].map(o => (
          <div class="bg-white rounded-xl border border-[var(--color-border)] p-6">
            <div class="text-3xl font-bold mb-3" style="color: #E86C47; opacity: 0.4;">{o.num}</div>
            <h3 class="font-bold text-[var(--color-text)] mb-2 text-sm">{o.titre}</h3>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{o.desc}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-sm text-neutral-500 text-center">
        Pas de présentation de 12 slides. Pas de document PDF générique. Trois points précis sur votre situation.
      </p>
    </div>
  </section>

  <!-- ALTERNATIVE WHATSAPP -->
  <section class="w-full bg-white px-6 py-12 md:px-8 border-t border-neutral-100">
    <div class="mx-auto max-w-xl text-center">
      <p class="text-neutral-500 text-sm mb-4">Vous préférez en discuter directement ?</p>
      <a
        href={`https://wa.me/${business.whatsapp}?text=${whatsappMessage}`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl border border-neutral-200 text-sm font-medium text-[var(--color-text)] hover:bg-neutral-50 transition"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Écrire sur WhatsApp
      </a>
    </div>
  </section>

</BaseLayout>
