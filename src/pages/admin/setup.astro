---
// SHIM CLIENT — page de setup du mot de passe (lien généré depuis /admin,
// nécessite le KV CMS_AUTH). Rend la page du package en lui passant le locale.
import SetupPage from '@marc/cms-engine/astro/setup';
import cmsConfig from '../../../cms.config';

const locale = (cmsConfig as { locale?: 'fr' | 'en' }).locale === 'en' ? 'en' : 'fr';
---
<SetupPage locale={locale} />
