---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kit réseaux — JD Zoothérapie"
  description="Posts prêts à copier et visuels téléchargeables pour la publication de l'étude de cas JD Zoothérapie."
  lang="fr"
  frPath="/kit-jd"
  noindex={true}
>
  <section class="w-full bg-[#0D0D0D] px-6 py-10 md:px-8 md:py-14">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] mb-3">Page privée</p>
      <h1 class="text-2xl font-bold text-white mb-2">Kit publication — JD Zoothérapie</h1>
      <div class="flex items-center gap-4 flex-wrap">
        <p class="text-neutral-400 text-sm">Posts à copier + visuels à télécharger.</p>
        <a href="/journal/refonte-jd-zootherapeute" class="text-sm text-[var(--color-accent)] hover:underline">Lire l'article →</a>
      </div>
    </div>
  </section>

  <section class="w-full bg-[var(--color-bg)] px-6 py-12 md:px-8 md:py-16">
    <div class="mx-auto max-w-3xl space-y-16">

      <!-- ===================== OG IMAGE ===================== -->
      <div>
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-8 rounded-full bg-neutral-700 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
          </div>
          <h2 class="text-lg font-bold text-[var(--color-text)]">OG Image — aperçu lien</h2>
          <span class="text-xs text-[var(--color-text-muted)] bg-[var(--color-bg-alt)] border border-[var(--color-border)] px-2 py-0.5 rounded-full">1200×630</span>
        </div>
        <div class="rounded-xl bg-white border border-[var(--color-border)] p-5">
          <img
            src="/og-jd-zootherapeute.jpg"
            alt="OG Image JD Zoothérapie"
            class="w-full rounded-lg border border-[var(--color-border)] mb-4"
            width="1200"
            height="630"
          />
          <a
            href="/og-jd-zootherapeute.jpg"
            download="og-jd-zootherapeute.jpg"
            class="inline-flex items-center gap-2 rounded-lg bg-neutral-800 px-4 py-2.5 text-sm font-semibold text-white hover:opacity-90 transition-opacity w-full justify-center sm:w-auto"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Télécharger JPG
          </a>
        </div>
      </div>

      <!-- ===================== FACEBOOK ===================== -->
      <div>
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </div>
          <h2 class="text-lg font-bold text-[var(--color-text)]">Facebook</h2>
        </div>

        <!-- Post text -->
        <div class="rounded-xl bg-white border border-[var(--color-border)] p-6 mb-3">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-text-muted)] mb-4">Texte du post</p>
          <div id="fb-text" class="text-[var(--color-text)] text-sm leading-relaxed whitespace-pre-line">J'ai un aveu à faire.

Ce projet, je ne l'ai pas vendu. C'est Jennifer qui me l'a proposé — comme cobaye pour tester mon concept.

Elle avait un site. Du trafic. Zéro appel.

2 semaines plus tard : nouveau site, nouveau domaine, agenda en ligne, blog, simulateur de tarif.

5 jours après le lancement : "1er vrai message reçu via le site 🍾"

👉 jdzootherapeute.fr
Étude de cas complète en commentaire.</div>
          <button
            onclick="copyText('fb-text', this)"
            class="mt-5 inline-flex items-center gap-2 rounded-lg bg-[var(--color-accent)] px-4 py-2.5 text-sm font-semibold text-white hover:opacity-90 transition-opacity cursor-pointer w-full justify-center sm:w-auto"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            Copier le texte
          </button>
        </div>

        <!-- Commentaire -->
        <div class="rounded-xl bg-[var(--color-bg-alt)] border border-[var(--color-border)] p-4 mb-6 flex items-center justify-between gap-4 flex-wrap">
          <p id="fb-comment" class="text-sm text-[var(--color-text-muted)] font-mono break-all">https://marcm.fr/journal/refonte-jd-zootherapeute</p>
          <button
            onclick="copyText('fb-comment', this)"
            class="shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-[var(--color-border)] bg-white px-3 py-1.5 text-xs font-semibold text-[var(--color-text)] hover:border-[var(--color-accent)] transition-colors cursor-pointer"
          >
            Copier le lien
          </button>
        </div>

        <!-- Visual -->
        <div class="rounded-xl bg-white border border-[var(--color-border)] p-5">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-text-muted)] mb-4">Visuel 1080×1080</p>
          <div class="overflow-hidden rounded-lg border border-[var(--color-border)] mb-4 w-full">
            <canvas id="canvas-square" width="1080" height="1080" style="width: 100%; height: auto; display: block;"></canvas>
          </div>
          <button
            onclick="downloadCanvas('canvas-square', 'jd-zootherapeute-facebook.png')"
            class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-accent)] px-4 py-2.5 text-sm font-semibold text-white hover:opacity-90 transition-opacity cursor-pointer w-full justify-center sm:w-auto"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Télécharger PNG
          </button>
        </div>
      </div>

      <!-- ===================== LINKEDIN ===================== -->
      <div>
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-8 rounded-full bg-blue-700 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
          </div>
          <h2 class="text-lg font-bold text-[var(--color-text)]">LinkedIn</h2>
        </div>

        <!-- Post text -->
        <div class="rounded-xl bg-white border border-[var(--color-border)] p-6 mb-3">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-text-muted)] mb-4">Texte du post</p>
          <div id="li-text" class="text-[var(--color-text)] text-sm leading-relaxed whitespace-pre-line">Son site avait du trafic. Pas de clients.

Les Google Ads tournaient. Les gens cherchaient. Personne n'appelait.

J'ai refait le site de Jennifer en 2 semaines. J+5 : premier contact entrant.

Ce que ça m'a confirmé : le site ne génère pas les clients. Il les filtre. Si le filtre est cassé — pas de CTA clair, pas de tarif visible, pas de moyen simple de réserver — le trafic repart en fumée.

Jennifer, zoothérapeute en Moselle, me l'avait dit : "Y a un truc qui bloque."

C'était ça.

Étude de cas complète en commentaire.</div>
          <button
            onclick="copyText('li-text', this)"
            class="mt-5 inline-flex items-center gap-2 rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-semibold text-white hover:opacity-90 transition-opacity cursor-pointer w-full justify-center sm:w-auto"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            Copier le texte
          </button>
        </div>

        <!-- Commentaire -->
        <div class="rounded-xl bg-[var(--color-bg-alt)] border border-[var(--color-border)] p-4 mb-6 flex items-center justify-between gap-4 flex-wrap">
          <p id="li-comment" class="text-sm text-[var(--color-text-muted)] font-mono break-all">https://marcm.fr/journal/refonte-jd-zootherapeute</p>
          <button
            onclick="copyText('li-comment', this)"
            class="shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-[var(--color-border)] bg-white px-3 py-1.5 text-xs font-semibold text-[var(--color-text)] hover:border-[var(--color-accent)] transition-colors cursor-pointer"
          >
            Copier le lien
          </button>
        </div>

        <!-- Visual -->
        <div class="rounded-xl bg-white border border-[var(--color-border)] p-5">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-text-muted)] mb-4">Visuel 1200×1200 (carré — pas de bandes blanches)</p>
          <div class="overflow-hidden rounded-lg border border-[var(--color-border)] mb-4 w-full">
            <canvas id="canvas-wide" width="1200" height="1200" style="width: 100%; height: auto; display: block;"></canvas>
          </div>
          <button
            onclick="downloadCanvas('canvas-wide', 'jd-zootherapeute-linkedin.png')"
            class="inline-flex items-center gap-2 rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-semibold text-white hover:opacity-90 transition-opacity cursor-pointer w-full justify-center sm:w-auto"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Télécharger PNG
          </button>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<script>
function copyText(id: string, btn: HTMLButtonElement) {
  const el = document.getElementById(id);
  if (!el) return;
  navigator.clipboard.writeText(el.innerText).then(() => {
    const orig = btn.innerHTML;
    btn.innerHTML = '✓ Copié !';
    setTimeout(() => { btn.innerHTML = orig; }, 2000);
  });
}

function downloadCanvas(id: string, filename: string) {
  const canvas = document.getElementById(id) as HTMLCanvasElement;
  if (!canvas) return;
  const link = document.createElement('a');
  link.download = filename;
  link.href = canvas.toDataURL('image/png');
  link.click();
}

function roundRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

// ─── SQUARE 1080×1080 ────────────────────────────────────
// Lisible mobile : 3 éléments max, texte gros, fort contraste
function drawSquare() {
  const canvas = document.getElementById('canvas-square') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d')!;
  const W = 1080, H = 1080;

  // BG dégradé sombre
  const grad = ctx.createLinearGradient(0, 0, W, H);
  grad.addColorStop(0, '#111111');
  grad.addColorStop(1, '#0A0A0A');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, H);

  // Barre orange gauche
  ctx.fillStyle = '#E86C47';
  ctx.fillRect(0, 0, 12, H);

  // Accroche — grosse, plein haut
  ctx.fillStyle = '#FFFFFF';
  ctx.font = 'bold 88px system-ui, Arial, sans-serif';
  ctx.textAlign = 'left';
  ctx.fillText('Trafic :', 80, 200);

  ctx.fillStyle = 'rgba(255,255,255,0.45)';
  ctx.font = '72px system-ui, Arial, sans-serif';
  ctx.fillText('Oui.', 80, 305);

  ctx.fillStyle = '#FFFFFF';
  ctx.font = 'bold 88px system-ui, Arial, sans-serif';
  ctx.fillText('Clients :', 80, 450);

  ctx.fillStyle = '#ef4444';
  ctx.font = '72px system-ui, Arial, sans-serif';
  ctx.fillText('Non.', 80, 555);

  // Séparateur
  ctx.fillStyle = 'rgba(255,255,255,0.1)';
  ctx.fillRect(80, 610, W - 160, 2);

  // Stat centrale
  ctx.fillStyle = '#E86C47';
  ctx.font = 'bold 200px system-ui, Arial, sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText('J+5', W / 2, 840);

  ctx.fillStyle = 'rgba(255,255,255,0.6)';
  ctx.font = '52px system-ui, Arial, sans-serif';
  ctx.fillText('1er client via le site', W / 2, 920);

  // Footer
  ctx.fillStyle = 'rgba(255,255,255,0.2)';
  ctx.fillRect(0, H - 80, W, 1);
  ctx.font = 'bold 36px system-ui, Arial, sans-serif';
  ctx.textAlign = 'left';
  ctx.fillStyle = 'rgba(255,255,255,0.35)';
  ctx.fillText('jdzootherapeute.fr', 80, H - 30);
  ctx.textAlign = 'right';
  ctx.fillStyle = '#E86C47';
  ctx.fillText('marcm.fr', W - 80, H - 30);
  ctx.textAlign = 'left';
}

// ─── SQUARE LINKEDIN 1200×1200 ───────────────────────────
function drawWide() {
  const canvas = document.getElementById('canvas-wide') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d')!;
  const W = 1200, H = 1200;

  // BG
  const grad = ctx.createLinearGradient(0, 0, 0, H);
  grad.addColorStop(0, '#111111');
  grad.addColorStop(1, '#0A0A0A');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, H);

  // Barre orange top
  ctx.fillStyle = '#E86C47';
  ctx.fillRect(0, 0, W, 12);

  const mx = 90;

  // Accroche
  ctx.fillStyle = 'rgba(255,255,255,0.4)';
  ctx.font = '46px system-ui, Arial, sans-serif';
  ctx.textAlign = 'left';
  ctx.fillText('Son site avait du trafic.', mx, 130);

  ctx.fillStyle = '#FFFFFF';
  ctx.font = 'bold 110px system-ui, Arial, sans-serif';
  ctx.fillText('Pas de clients.', mx, 270);

  ctx.fillStyle = 'rgba(255,255,255,0.5)';
  ctx.font = '44px system-ui, Arial, sans-serif';
  ctx.fillText('Refonte en 2 semaines.', mx, 360);

  // Citation
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.font = 'italic 38px Georgia, serif';
  ctx.fillText('"Y a un truc qui bloque."', mx, 440);

  // Séparateur
  ctx.fillStyle = 'rgba(255,255,255,0.1)';
  ctx.fillRect(mx, 490, W - mx * 2, 1);

  // Pilule J+5
  ctx.fillStyle = '#E86C47';
  roundRect(ctx, mx, 520, W - mx * 2, 130, 20);
  ctx.fill();

  ctx.fillStyle = '#FFFFFF';
  ctx.font = 'bold 96px system-ui, Arial, sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText('J+5', W / 2 - 160, 606);

  ctx.font = '42px system-ui, Arial, sans-serif';
  ctx.fillStyle = 'rgba(255,255,255,0.92)';
  ctx.fillText('1er contact entrant via le site', W / 2 + 80, 596);

  // Séparateur
  ctx.fillStyle = 'rgba(255,255,255,0.1)';
  ctx.fillRect(mx, 690, W - mx * 2, 1);

  // Liste — pleine largeur, 2 colonnes
  const items = [
    'One-page clair + rapide',
    'Nouveau domaine cohérent',
    'Agenda en ligne (Cal.com)',
    'Simulateur de tarif',
    'Blog + CMS autonome',
    'Analytics RGPD',
  ];

  ctx.textAlign = 'left';
  items.forEach((item, i) => {
    const col = i % 2;
    const row = Math.floor(i / 2);
    const x = col === 0 ? mx : W / 2 + 20;
    const y = 770 + row * 110;
    // Barre orange
    ctx.fillStyle = '#E86C47';
    ctx.fillRect(x, y - 34, 4, 44);
    // Texte
    ctx.fillStyle = 'rgba(255,255,255,0.82)';
    ctx.font = '38px system-ui, Arial, sans-serif';
    ctx.fillText(item, x + 20, y);
  });

  // Footer
  ctx.fillStyle = 'rgba(255,255,255,0.12)';
  ctx.fillRect(0, H - 70, W, 1);
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.font = '30px system-ui, Arial, sans-serif';
  ctx.textAlign = 'left';
  ctx.fillText('jdzootherapeute.fr', mx, H - 25);
  ctx.textAlign = 'right';
  ctx.fillStyle = '#E86C47';
  ctx.fillText('marcm.fr', W - mx, H - 25);
  ctx.textAlign = 'left';
}

document.addEventListener('DOMContentLoaded', () => {
  drawSquare();
  drawWide();
});

(window as any).copyText = copyText;
(window as any).downloadCanvas = downloadCanvas;
</script>
</BaseLayout>
