---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kit réseaux — JD Zoothérapie"
  description="Posts prêts à copier et visuels téléchargeables pour la publication de l'étude de cas JD Zoothérapie."
  lang="fr"
  frPath="/kit-jd"
  noindex={true}
>
  <section class="w-full bg-[#0D0D0D] px-6 py-12 md:px-8 md:py-16">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] mb-3">Page privée</p>
      <h1 class="text-3xl font-bold text-white mb-3">Kit publication — JD Zoothérapie</h1>
      <p class="text-neutral-400">Posts prêts à copier + visuels à télécharger pour Facebook et LinkedIn.</p>
      <a href="/journal/refonte-jd-zootherapeute" class="inline-flex items-center gap-2 mt-4 text-sm text-[var(--color-accent)] hover:underline">
        Lire l'article de blog complet →
      </a>
    </div>
  </section>

  <section class="w-full bg-[var(--color-bg)] px-6 py-12 md:px-8 md:py-16">
    <div class="mx-auto max-w-4xl space-y-16">

      <!-- ===================== FACEBOOK ===================== -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </div>
          <h2 class="text-xl font-bold text-[var(--color-text)]">Facebook</h2>
          <span class="text-xs text-[var(--color-text-muted)] bg-[var(--color-bg-alt)] border border-[var(--color-border)] px-2 py-0.5 rounded-full">1080×1080 recommandé</span>
        </div>

        <!-- Post text -->
        <div class="rounded-xl bg-white border border-[var(--color-border)] p-6 mb-4 relative group">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-text-muted)] mb-4">Texte du post</p>
          <div id="fb-text" class="text-[var(--color-text)] text-sm leading-relaxed whitespace-pre-line">J'ai un aveu à faire.

Ce projet, je ne l'ai pas "vendu". Jennifer me l'a proposé elle-même — comme cobaye pour tester mon concept de one-page.

Elle avait déjà un site. Un Google Sites qui s'appelait "Pattes Tendres" alors que son activité s'appelle JD Zoothérapie. Plusieurs pages, quelques liens cassés, aucun vrai appel à l'action. Elle avait lancé des Google Ads — les gens cherchaient, mais ça ne convertissait pas. "Y a un truc qui bloque", elle m'avait dit.

Deux semaines plus tard : nouveau site en ligne, nouveau domaine, simulateur de tarif, agenda de prise de rendez-vous, blog, CMS pour modifier elle-même ses textes.

Quelques jours après le lancement, elle m'écrit : "1er vrai message reçu via le site 🍾"

Le site : 👉 jdzootherapeute.fr
L'étude de cas complète (process, fonctionnalités, premiers résultats) en commentaire.</div>
          <button
            onclick="copyText('fb-text', this)"
            class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[var(--color-accent)] px-4 py-2 text-sm font-semibold text-white hover:opacity-90 transition-opacity cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            Copier le texte
          </button>
        </div>

        <!-- Commentaire -->
        <div class="rounded-xl bg-[var(--color-bg-alt)] border border-[var(--color-border)] p-5 mb-6">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-text-muted)] mb-2">1er commentaire (lien article)</p>
          <p id="fb-comment" class="text-sm text-[var(--color-text)] font-mono">https://marcm.fr/journal/refonte-jd-zootherapeute</p>
          <button
            onclick="copyText('fb-comment', this)"
            class="mt-3 inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] bg-white px-3 py-1.5 text-xs font-semibold text-[var(--color-text)] hover:border-[var(--color-accent)] transition-colors cursor-pointer"
          >
            Copier le lien
          </button>
        </div>

        <!-- Visual -->
        <div class="rounded-xl bg-white border border-[var(--color-border)] p-6">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-text-muted)] mb-4">Visuel — 1080×1080 (Facebook / Instagram)</p>
          <div class="overflow-hidden rounded-lg border border-[var(--color-border)] mb-4" style="max-width: 480px;">
            <canvas id="canvas-square" width="1080" height="1080" style="width: 100%; height: auto; display: block;"></canvas>
          </div>
          <button
            onclick="downloadCanvas('canvas-square', 'jd-zootherapeute-facebook.png')"
            class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-accent)] px-4 py-2 text-sm font-semibold text-white hover:opacity-90 transition-opacity cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Télécharger PNG (1080×1080)
          </button>
        </div>
      </div>

      <!-- ===================== LINKEDIN ===================== -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-full bg-blue-700 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
          </div>
          <h2 class="text-xl font-bold text-[var(--color-text)]">LinkedIn</h2>
          <span class="text-xs text-[var(--color-text-muted)] bg-[var(--color-bg-alt)] border border-[var(--color-border)] px-2 py-0.5 rounded-full">1200×627 recommandé</span>
        </div>

        <!-- Post text -->
        <div class="rounded-xl bg-white border border-[var(--color-border)] p-6 mb-4">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-text-muted)] mb-4">Texte du post</p>
          <div id="li-text" class="text-[var(--color-text)] text-sm leading-relaxed whitespace-pre-line">Avant : un Google Sites "Pattes Tendres", des liens cassés, des Google Ads qui dépensaient sans convertir.
Après : jdzootherapeute.fr — livré en 2 semaines, premier contact reçu à J+5.

Ce projet m'a confirmé quelque chose.

Le problème des indépendants et petites entreprises, ce n'est pas le manque de trafic. C'est que leur site ne fait rien de ce trafic. Pas d'appel à l'action clair, pas de prix lisibles, pas de moyen simple de prendre contact ou de réserver.

Jennifer est zoothérapeute en Moselle. Elle savait que son site était le problème — "les gens ont la flemme, un site trop long ça restreint les clics". Ce qu'elle n'avait pas, c'est le temps, les outils et le regard extérieur pour en sortir.

On a travaillé deux semaines. Elle m'envoyait ses retours sur Messenger, je mettais à jour. Pas de réunion, pas de cahier des charges. Juste une conversation.

Ce qu'elle a dit à la fin : "De voir son travail à travers les yeux de quelqu'un, c'est cool. Tu as du mal à synthétiser quand c'est le tien."

C'est ça la valeur réelle. Pas juste un site. Un regard extérieur.

L'étude de cas complète (avant/après, process, features, résultats) en commentaire.</div>
          <button
            onclick="copyText('li-text', this)"
            class="mt-4 inline-flex items-center gap-2 rounded-lg bg-blue-700 px-4 py-2 text-sm font-semibold text-white hover:opacity-90 transition-opacity cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            Copier le texte
          </button>
        </div>

        <!-- Commentaire -->
        <div class="rounded-xl bg-[var(--color-bg-alt)] border border-[var(--color-border)] p-5 mb-6">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-text-muted)] mb-2">1er commentaire (lien article)</p>
          <p id="li-comment" class="text-sm text-[var(--color-text)] font-mono">https://marcm.fr/journal/refonte-jd-zootherapeute</p>
          <button
            onclick="copyText('li-comment', this)"
            class="mt-3 inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] bg-white px-3 py-1.5 text-xs font-semibold text-[var(--color-text)] hover:border-[var(--color-accent)] transition-colors cursor-pointer"
          >
            Copier le lien
          </button>
        </div>

        <!-- Visual -->
        <div class="rounded-xl bg-white border border-[var(--color-border)] p-6">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-text-muted)] mb-4">Visuel — 1200×627 (LinkedIn)</p>
          <div class="overflow-hidden rounded-lg border border-[var(--color-border)] mb-4" style="max-width: 600px;">
            <canvas id="canvas-wide" width="1200" height="627" style="width: 100%; height: auto; display: block;"></canvas>
          </div>
          <button
            onclick="downloadCanvas('canvas-wide', 'jd-zootherapeute-linkedin.png')"
            class="inline-flex items-center gap-2 rounded-lg bg-blue-700 px-4 py-2 text-sm font-semibold text-white hover:opacity-90 transition-opacity cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Télécharger PNG (1200×627)
          </button>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<script>
// ─── COPY ───────────────────────────────────────────────
function copyText(id: string, btn: HTMLButtonElement) {
  const el = document.getElementById(id);
  if (!el) return;
  navigator.clipboard.writeText(el.innerText).then(() => {
    const orig = btn.innerHTML;
    btn.innerHTML = '✓ Copié !';
    setTimeout(() => { btn.innerHTML = orig; }, 2000);
  });
}

// ─── DOWNLOAD CANVAS ────────────────────────────────────
function downloadCanvas(id: string, filename: string) {
  const canvas = document.getElementById(id) as HTMLCanvasElement;
  if (!canvas) return;
  const link = document.createElement('a');
  link.download = filename;
  link.href = canvas.toDataURL('image/png');
  link.click();
}

// ─── DRAW HELPERS ───────────────────────────────────────
function wrapText(ctx: CanvasRenderingContext2D, text: string, x: number, y: number, maxWidth: number, lineHeight: number): number {
  const words = text.split(' ');
  let line = '';
  let currentY = y;
  for (const word of words) {
    const testLine = line + word + ' ';
    if (ctx.measureText(testLine).width > maxWidth && line !== '') {
      ctx.fillText(line.trim(), x, currentY);
      line = word + ' ';
      currentY += lineHeight;
    } else {
      line = testLine;
    }
  }
  ctx.fillText(line.trim(), x, currentY);
  return currentY + lineHeight;
}

// ─── SQUARE VISUAL (1080×1080) ──────────────────────────
function drawSquare() {
  const canvas = document.getElementById('canvas-square') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d')!;
  const W = 1080, H = 1080;

  // BG
  ctx.fillStyle = '#0D0D0D';
  ctx.fillRect(0, 0, W, H);

  // Dot grid
  ctx.fillStyle = 'rgba(255,255,255,0.04)';
  for (let x = 40; x < W; x += 60) {
    for (let y = 40; y < H; y += 60) {
      ctx.beginPath();
      ctx.arc(x, y, 2, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // Accent bar top
  ctx.fillStyle = '#E86C47';
  ctx.fillRect(0, 0, W, 8);

  // Label
  ctx.fillStyle = '#E86C47';
  ctx.font = 'bold 28px system-ui, Arial, sans-serif';
  ctx.letterSpacing = '4px';
  ctx.fillText('ÉTUDE DE CAS', 80, 80);
  ctx.letterSpacing = '0px';

  // Divider
  ctx.fillStyle = 'rgba(255,255,255,0.1)';
  ctx.fillRect(80, 100, 200, 2);

  // AVANT / APRÈS block
  const blockY = 140;
  const blockH = 340;

  // AVANT block
  ctx.fillStyle = 'rgba(239,68,68,0.12)';
  roundRect(ctx, 80, blockY, 440, blockH, 16);
  ctx.fill();
  ctx.strokeStyle = 'rgba(239,68,68,0.3)';
  ctx.lineWidth = 1.5;
  roundRect(ctx, 80, blockY, 440, blockH, 16);
  ctx.stroke();

  ctx.fillStyle = '#ef4444';
  ctx.font = 'bold 22px system-ui, Arial, sans-serif';
  ctx.fillText('AVANT', 110, blockY + 46);

  ctx.fillStyle = 'rgba(255,255,255,0.5)';
  ctx.font = '20px system-ui, Arial, sans-serif';
  const avantLines = ['Google Sites "Pattes Tendres"', 'Liens cassés', 'Pas de rendez-vous en ligne', 'Google Ads sans résultat', 'Adresse domicile visible'];
  avantLines.forEach((line, i) => {
    ctx.fillText('• ' + line, 110, blockY + 90 + i * 44);
  });

  // APRÈS block
  ctx.fillStyle = 'rgba(34,197,94,0.12)';
  roundRect(ctx, 560, blockY, 440, blockH, 16);
  ctx.fill();
  ctx.strokeStyle = 'rgba(34,197,94,0.3)';
  ctx.lineWidth = 1.5;
  roundRect(ctx, 560, blockY, 440, blockH, 16);
  ctx.stroke();

  ctx.fillStyle = '#22c55e';
  ctx.font = 'bold 22px system-ui, Arial, sans-serif';
  ctx.fillText('APRÈS', 590, blockY + 46);

  ctx.fillStyle = 'rgba(255,255,255,0.5)';
  ctx.font = '20px system-ui, Arial, sans-serif';
  const apresLines = ['jdzootherapeute.fr', 'One-page clair & rapide', 'Agenda en ligne Cal.com', 'Simulateur de tarif', 'Blog + CMS autonome'];
  apresLines.forEach((line, i) => {
    ctx.fillText('✓ ' + line, 590, blockY + 90 + i * 44);
  });

  // Big stat
  ctx.fillStyle = '#E86C47';
  ctx.font = 'bold 110px system-ui, Arial, sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText('J+5', W / 2, 640);

  ctx.fillStyle = 'rgba(255,255,255,0.7)';
  ctx.font = '36px system-ui, Arial, sans-serif';
  ctx.fillText('Premier contact reçu via le site', W / 2, 700);

  // Divider
  ctx.fillStyle = 'rgba(255,255,255,0.08)';
  ctx.fillRect(80, 750, W - 160, 1);

  // Quote
  ctx.fillStyle = 'rgba(255,255,255,0.5)';
  ctx.font = 'italic 26px Georgia, serif';
  ctx.textAlign = 'center';
  wrapText(ctx, '"Y a un truc qui bloque." → Premier message entrant 5 jours après le lancement.', W / 2, 800, W - 200, 40);

  // Footer
  ctx.fillStyle = 'rgba(255,255,255,0.25)';
  ctx.font = '24px system-ui, Arial, sans-serif';
  ctx.textAlign = 'left';
  ctx.fillText('Marc M. — Agence web Grand Est', 80, H - 60);
  ctx.textAlign = 'right';
  ctx.fillStyle = '#E86C47';
  ctx.fillText('marcm.fr', W - 80, H - 60);

  ctx.textAlign = 'left';
}

// ─── WIDE VISUAL (1200×627) ─────────────────────────────
function drawWide() {
  const canvas = document.getElementById('canvas-wide') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d')!;
  const W = 1200, H = 627;

  // BG
  ctx.fillStyle = '#0D0D0D';
  ctx.fillRect(0, 0, W, H);

  // Dot grid
  ctx.fillStyle = 'rgba(255,255,255,0.04)';
  for (let x = 40; x < W; x += 60) {
    for (let y = 40; y < H; y += 60) {
      ctx.beginPath();
      ctx.arc(x, y, 2, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // Accent bar left
  ctx.fillStyle = '#E86C47';
  ctx.fillRect(0, 0, 8, H);

  // Left column — content
  const lx = 80;

  ctx.fillStyle = '#E86C47';
  ctx.font = 'bold 20px system-ui, Arial, sans-serif';
  ctx.letterSpacing = '4px';
  ctx.fillText('ÉTUDE DE CAS', lx, 70);
  ctx.letterSpacing = '0px';

  ctx.fillStyle = '#FFFFFF';
  ctx.font = 'bold 52px system-ui, Arial, sans-serif';
  ctx.fillText('Google Site', lx, 150);
  ctx.fillStyle = '#E86C47';
  ctx.fillText('→ site pro', lx, 215);

  ctx.fillStyle = 'rgba(255,255,255,0.6)';
  ctx.font = '26px system-ui, Arial, sans-serif';
  wrapText(ctx, 'Jennifer avait du trafic mais zéro conversion. Refonte en 2 semaines.', lx, 270, 520, 42);

  // Stat pill
  ctx.fillStyle = '#E86C47';
  roundRect(ctx, lx, 370, 280, 72, 12);
  ctx.fill();
  ctx.fillStyle = '#FFFFFF';
  ctx.font = 'bold 40px system-ui, Arial, sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText('J+5', lx + 80, 416);
  ctx.font = '20px system-ui, Arial, sans-serif';
  ctx.textAlign = 'left';
  ctx.fillStyle = 'rgba(255,255,255,0.9)';
  ctx.fillText('1er contact entrant', lx + 170, 400);
  ctx.fillText('via le formulaire', lx + 170, 426);

  // Divider vertical
  ctx.fillStyle = 'rgba(255,255,255,0.08)';
  ctx.fillRect(640, 40, 1, H - 80);

  // Right column — features
  const rx = 680;

  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.font = 'bold 18px system-ui, Arial, sans-serif';
  ctx.letterSpacing = '2px';
  ctx.fillText('CE QUI A CHANGÉ', rx, 70);
  ctx.letterSpacing = '0px';

  const features = [
    { icon: '✓', color: '#22c55e', text: 'One-page clair, mobile-first' },
    { icon: '✓', color: '#22c55e', text: 'Domaine jdzootherapeute.fr' },
    { icon: '✓', color: '#22c55e', text: 'Simulateur de tarif (code postal)' },
    { icon: '✓', color: '#22c55e', text: 'Agenda Cal.com intégré' },
    { icon: '✓', color: '#22c55e', text: 'Blog + CMS autonome' },
    { icon: '✓', color: '#22c55e', text: 'Analytics RGPD (Umami)' },
  ];

  features.forEach(({ icon, color, text }, i) => {
    const fy = 120 + i * 72;
    ctx.fillStyle = color;
    ctx.font = 'bold 26px system-ui, Arial, sans-serif';
    ctx.fillText(icon, rx, fy);
    ctx.fillStyle = 'rgba(255,255,255,0.85)';
    ctx.font = '24px system-ui, Arial, sans-serif';
    ctx.fillText(text, rx + 40, fy);
  });

  // Footer
  ctx.fillStyle = 'rgba(255,255,255,0.2)';
  ctx.fillRect(0, H - 56, W, 1);
  ctx.fillStyle = 'rgba(255,255,255,0.4)';
  ctx.font = '20px system-ui, Arial, sans-serif';
  ctx.textAlign = 'left';
  ctx.fillText('Marc M. — Agence web Grand Est', 80, H - 20);
  ctx.textAlign = 'right';
  ctx.fillStyle = '#E86C47';
  ctx.fillText('marcm.fr', W - 80, H - 20);
  ctx.textAlign = 'left';
}

// ─── ROUNDED RECT HELPER ────────────────────────────────
function roundRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

// ─── INIT ────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  drawSquare();
  drawWide();
});

// Expose to onclick handlers
(window as any).copyText = copyText;
(window as any).downloadCanvas = downloadCanvas;
</script>
</BaseLayout>
