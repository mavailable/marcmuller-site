---
import '../styles/global.css';
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Comment j'ai fait 50 000€/mois en 30 jours grâce au Vibe Coding — Marc M</title>
  <meta name="description" content="J'ai lancé mon agence web en 1 mois. Je fais 50k/mois avec Claude Code. Je te vends une formation." />
  <meta name="robots" content="noindex, no-hustle" />
  <meta name="author" content="Un mec en pyjama à Metz" />
  <meta name="formation-certifiee" content="par personne" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Open Graph -->
  <meta property="og:title" content="Comment j'ai fait 50 000€/mois en 30 jours grâce au Vibe Coding" />
  <meta property="og:description" content="Claude Code. Quelques prompts. Une connexion Wi-Fi. Je t'explique tout dans ma formation exclusive à 997€." />
  <meta property="og:image" content="https://marcm.fr/og-poisson-davril.svg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content="https://marcm.fr/devenir-libre" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Comment j'ai fait 50 000€/mois en 30 jours grâce au Vibe Coding" />
  <meta name="twitter:description" content="Claude Code. Quelques prompts. Une connexion Wi-Fi. Je t'explique tout dans ma formation exclusive à 997€." />
  <meta name="twitter:image" content="https://marcm.fr/og-poisson-davril.svg" />

  <style>
    /* ========================================
       GURU PAGE STYLES
       ======================================== */

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Satoshi', system-ui, sans-serif;
      background: #FAFAF8;
      overflow-x: hidden;
    }

    /* --- Scroll animations --- */
    .reveal {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* --- Hero --- */
    .hero {
      background: #1A1A1A;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 4rem 1.5rem;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(232,108,71,0.25) 0%, transparent 70%);
      pointer-events: none;
    }

    .badge {
      display: inline-block;
      background: #E86C47;
      color: white;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 0.4rem 1rem;
      border-radius: 100px;
      margin-bottom: 1.5rem;
    }

    .hero h1 {
      font-size: clamp(2rem, 6vw, 4.5rem);
      font-weight: 900;
      color: #FAFAF8;
      line-height: 1.1;
      max-width: 900px;
      margin-bottom: 1.5rem;
    }

    .hero h1 em {
      font-style: normal;
      color: #E86C47;
    }

    .hero-sub {
      font-size: 1.2rem;
      color: #B0B0B0;
      max-width: 560px;
      margin-bottom: 2.5rem;
      line-height: 1.6;
    }

    .btn-guru {
      display: inline-block;
      background: #E86C47;
      color: white;
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 1.1rem 2.5rem;
      border-radius: 8px;
      text-decoration: none;
      box-shadow: 0 8px 40px rgba(232,108,71,0.4);
      transition: transform 0.2s, box-shadow 0.2s;
      cursor: pointer;
      border: none;
    }
    .btn-guru:hover {
      transform: translateY(-2px) scale(1.03);
      box-shadow: 0 12px 50px rgba(232,108,71,0.55);
    }

    .cta-break {
      text-align: center;
      padding: 2.5rem 1.5rem;
      background: #F8F6F3;
      border-top: 1px solid #E8E5E0;
      border-bottom: 1px solid #E8E5E0;
    }
    .cta-break .btn-guru {
      font-size: 1rem;
      padding: 0.9rem 2rem;
    }
    .cta-break-dark {
      text-align: center;
      padding: 2.5rem 1.5rem;
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    .cta-break-dark .btn-guru {
      font-size: 1rem;
      padding: 0.9rem 2rem;
    }

    .hero-proof {
      margin-top: 2.5rem;
      display: flex;
      gap: 2rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .hero-proof span {
      color: #6B6B6B;
      font-size: 0.85rem;
    }
    .hero-proof span strong {
      color: #FAFAF8;
    }

    /* --- Stats --- */
    .stats {
      background: #F0EEEB;
      padding: 5rem 1.5rem;
      text-align: center;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem;
      max-width: 900px;
      margin: 3rem auto 0;
    }
    .stat-card {
      background: white;
      border-radius: 16px;
      padding: 2rem 1.5rem;
      box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    }
    .stat-number {
      font-size: 2.8rem;
      font-weight: 900;
      color: #E86C47;
      line-height: 1;
      margin-bottom: 0.5rem;
    }
    .stat-label {
      font-size: 0.9rem;
      color: #6B6B6B;
      line-height: 1.4;
    }

    /* --- Section générique --- */
    .section {
      padding: 5rem 1.5rem;
      max-width: 800px;
      margin: 0 auto;
    }
    .section-dark {
      background: #1A1A1A;
      max-width: 100%;
      padding: 5rem 1.5rem;
    }
    .section-dark .inner {
      max-width: 800px;
      margin: 0 auto;
    }

    .overline {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #E86C47;
      margin-bottom: 0.75rem;
    }

    h2.heading {
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      font-weight: 900;
      color: #1A1A1A;
      line-height: 1.15;
      margin-bottom: 1.5rem;
    }
    .section-dark h2.heading { color: #FAFAF8; }

    p.body-text {
      font-size: 1.05rem;
      color: #525252;
      line-height: 1.75;
      margin-bottom: 1rem;
    }
    .section-dark p.body-text { color: #B0B0B0; }

    /* --- Modules liste --- */
    .modules-list {
      list-style: none;
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .modules-list li {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }
    .module-num {
      background: #E86C47;
      color: white;
      font-size: 0.75rem;
      font-weight: 800;
      min-width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .module-title {
      font-weight: 700;
      color: #FAFAF8;
      margin-bottom: 0.2rem;
    }
    .module-desc {
      font-size: 0.875rem;
      color: #6B6B6B;
    }

    /* --- Témoignages --- */
    .testimonials {
      background: #F0EEEB;
      padding: 5rem 1.5rem;
    }
    .testimonials-inner {
      max-width: 800px;
      margin: 0 auto;
    }
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
      margin-top: 2.5rem;
    }
    .testi-card {
      background: white;
      border-radius: 16px;
      padding: 1.75rem;
      box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    }
    .testi-stars {
      color: #E86C47;
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
    }
    .testi-text {
      font-size: 0.95rem;
      color: #3D3D3D;
      line-height: 1.6;
      margin-bottom: 1rem;
      font-style: italic;
    }
    .testi-author {
      font-size: 0.8rem;
      font-weight: 700;
      color: #6B6B6B;
    }
    .testi-author::after {
      content: '(résultats non vérifiés et probablement inventés)';
      display: block;
      font-size: 0.6rem;
      color: #C8C5C0;
      font-weight: 400;
      font-style: italic;
      margin-top: 0.2rem;
    }

    /* --- Oussama expandable card --- */
    .testi-card-featured {
      background: white;
      border-radius: 16px;
      padding: 1.75rem;
      box-shadow: 0 2px 16px rgba(0,0,0,0.06);
      grid-column: 1 / -1;
      border: 2px solid #E86C47;
      position: relative;
    }
    .testi-card-featured .featured-badge {
      position: absolute;
      top: -10px;
      right: 16px;
      background: #E86C47;
      color: white;
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.25rem 0.75rem;
      border-radius: 100px;
    }
    .testi-truncated {
      max-height: 120px;
      overflow: hidden;
      position: relative;
      transition: max-height 0.5s ease;
    }
    .testi-truncated.expanded {
      max-height: 2000px;
    }
    .testi-truncated:not(.expanded)::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 50px;
      background: linear-gradient(transparent, white);
      pointer-events: none;
    }
    .btn-lire-plus {
      display: inline-block;
      margin-top: 0.75rem;
      background: none;
      border: 1px solid #E86C47;
      color: #E86C47;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.35rem 1rem;
      border-radius: 6px;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
    }
    .btn-lire-plus:hover {
      background: #E86C47;
      color: white;
    }

    /* --- Pricing / CTA --- */
    .pricing {
      background: #1A1A1A;
      padding: 5rem 1.5rem;
      text-align: center;
    }
    .pricing-box {
      background: white;
      max-width: 520px;
      margin: 2.5rem auto 0;
      border-radius: 24px;
      padding: 3rem 2rem;
      position: relative;
    }
    .pricing-badge {
      position: absolute;
      top: -14px;
      left: 50%;
      transform: translateX(-50%);
      background: #E86C47;
      color: white;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 0.35rem 1.2rem;
      border-radius: 100px;
      white-space: nowrap;
    }
    .old-prices {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 0.5rem;
    }
    .old-price {
      font-size: 1rem;
      color: #B0B0B0;
      text-decoration: line-through;
    }
    .current-price {
      font-size: 4rem;
      font-weight: 900;
      color: #E86C47;
      line-height: 1;
      margin-bottom: 0.25rem;
    }
    .price-sub {
      font-size: 0.85rem;
      color: #6B6B6B;
      margin-bottom: 2rem;
    }
    .scarcity {
      background: #FEF3EF;
      border: 1px solid #FACBB8;
      border-radius: 8px;
      padding: 0.6rem 1rem;
      font-size: 0.85rem;
      color: #933A25;
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    /* Timer */
    .timer {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }
    .timer-block {
      background: #1A1A1A;
      color: white;
      border-radius: 8px;
      padding: 0.5rem 0.75rem;
      min-width: 52px;
      text-align: center;
    }
    .timer-num {
      font-size: 1.5rem;
      font-weight: 900;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .timer-label {
      font-size: 0.6rem;
      color: #6B6B6B;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    /* --- Reveal overlay --- */
    #reveal-overlay {
      position: fixed;
      inset: 0;
      background: #1A1A1A;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.6s ease;
    }
    #reveal-overlay.active {
      opacity: 1;
      pointer-events: all;
    }

    .fish-container {
      font-size: 6rem;
      margin-bottom: 1.5rem;
      animation: fishSwim 3s ease-in-out infinite;
    }

    @keyframes fishSwim {
      0%, 100% { transform: translateX(-12px) rotate(-3deg); }
      50% { transform: translateX(12px) rotate(3deg); }
    }

    .reveal-title {
      font-size: clamp(2rem, 6vw, 3.5rem);
      font-weight: 900;
      color: #E86C47;
      margin-bottom: 1rem;
      line-height: 1.1;
    }

    .reveal-sub {
      font-size: 1.15rem;
      color: #B0B0B0;
      max-width: 540px;
      line-height: 1.7;
      margin-bottom: 2.5rem;
    }
    .reveal-sub strong {
      color: #FAFAF8;
    }

    .btn-real {
      display: inline-block;
      background: #E86C47;
      color: white;
      font-size: 1rem;
      font-weight: 700;
      padding: 0.9rem 2rem;
      border-radius: 8px;
      text-decoration: none;
      transition: transform 0.2s;
    }
    .btn-real:hover { transform: translateY(-2px); }

    .reveal-fine {
      margin-top: 1.5rem;
      font-size: 0.8rem;
      color: #3D3D3D;
    }

    /* Confetti burst */
    .confetti-wrap {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 9998;
      overflow: hidden;
    }
    .confetti-piece {
      position: absolute;
      top: -20px;
      width: 10px;
      height: 10px;
      border-radius: 2px;
      animation: confettiFall linear forwards;
      opacity: 0;
    }

    @keyframes confettiFall {
      0%   { opacity: 1; transform: translateY(0) rotate(0deg); }
      100% { opacity: 0; transform: translateY(110vh) rotate(720deg); }
    }

    /* --- Hero testimonial teaser --- */
    .hero-testi-teaser {
      margin-top: 3rem;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(232,108,71,0.35);
      border-radius: 14px;
      padding: 1.25rem 1.5rem;
      max-width: 640px;
      text-align: left;
      position: relative;
    }
    .hero-testi-badge {
      display: inline-block;
      background: #E86C47;
      color: white;
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.2rem 0.7rem;
      border-radius: 100px;
      margin-bottom: 0.75rem;
    }
    .hero-testi-quote {
      font-size: 0.9rem;
      color: #D0D0D0;
      font-style: italic;
      line-height: 1.6;
      margin-bottom: 0.75rem;
    }
    .hero-testi-meta {
      font-size: 0.75rem;
      color: #6B6B6B;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }
    .btn-testi-suite {
      display: inline-block;
      background: none;
      border: 1px solid #E86C47;
      color: #E86C47;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.3rem 0.9rem;
      border-radius: 6px;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, color 0.2s;
    }
    .btn-testi-suite:hover {
      background: #E86C47;
      color: white;
    }

    /* --- Faux social proof popup --- */
    #social-proof-popup {
      position: fixed;
      bottom: 1.5rem;
      left: 1.5rem;
      background: white;
      border-radius: 12px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.15);
      padding: 0.9rem 1.1rem;
      max-width: 300px;
      z-index: 8000;
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      transform: translateY(120%);
      opacity: 0;
      transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.4s ease;
    }
    #social-proof-popup.show {
      transform: translateY(0);
      opacity: 1;
    }
    .sp-icon { font-size: 1.6rem; flex-shrink: 0; line-height: 1; }
    .sp-text { font-size: 0.78rem; color: #3D3D3D; line-height: 1.4; }
    .sp-text strong { color: #1A1A1A; }
    .sp-time { font-size: 0.68rem; color: #B0B0B0; margin-top: 0.2rem; }

    /* --- Compteur live --- */
    #live-counter {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 100px;
      padding: 0.3rem 0.9rem;
      font-size: 0.78rem;
      color: #B0B0B0;
      margin-top: 1.25rem;
    }
    #live-counter .dot {
      width: 7px; height: 7px;
      background: #4ADE80;
      border-radius: 50%;
      animation: pulse-dot 1.4s ease-in-out infinite;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.7); }
    }

    /* --- Fake Stripe screenshot --- */
    .stripe-notif {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      background: white;
      border-radius: 14px;
      padding: 0.8rem 1.2rem;
      margin-top: 2rem;
      filter: blur(3px);
      opacity: 0.7;
      user-select: none;
      pointer-events: none;
      box-shadow: 0 4px 24px rgba(0,0,0,0.25);
      position: relative;
    }
    .stripe-notif::after {
      content: '(flouté pour protéger ma vie privée et aussi parce que c\'est fictif)';
      position: absolute;
      bottom: -1.4rem;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.55rem;
      color: #6B6B6B;
      white-space: nowrap;
      font-style: italic;
      filter: none;
    }
    .stripe-logo { font-size: 1.2rem; }
    .stripe-text { text-align: left; }
    .stripe-text .stripe-amount { font-size: 1.1rem; font-weight: 800; color: #1A1A1A; }
    .stripe-text .stripe-label { font-size: 0.7rem; color: #6B6B6B; }

    /* --- Avant/Après --- */
    .avantapres {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-top: 2.5rem;
    }
    .aa-col {
      border-radius: 16px;
      padding: 1.75rem;
    }
    .aa-avant { background: #F5F5F5; border: 1px solid #E0E0E0; }
    .aa-apres { background: #1A1A1A; border: 2px solid #E86C47; }
    .aa-label {
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .aa-avant .aa-label { color: #B0B0B0; }
    .aa-apres .aa-label { color: #E86C47; }
    .aa-stat { margin-bottom: 0.75rem; }
    .aa-stat .aa-num { font-size: 1.6rem; font-weight: 900; line-height: 1; }
    .aa-avant .aa-num { color: #C0C0C0; }
    .aa-apres .aa-num { color: #E86C47; }
    .aa-stat .aa-desc { font-size: 0.75rem; color: #888; margin-top: 0.15rem; }
    .aa-apres .aa-desc { color: #6B6B6B; }
    .aa-fine {
      font-size: 0.55rem;
      color: #C0C0C0;
      font-style: italic;
      grid-column: 1 / -1;
      text-align: center;
    }

    /* --- Glossaire --- */
    .glossaire-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      margin-top: 2rem;
    }
    .gloss-card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 1rem 1.1rem;
    }
    .gloss-term {
      font-size: 0.75rem;
      font-weight: 800;
      color: #E86C47;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.4rem;
    }
    .gloss-def {
      font-size: 0.78rem;
      color: #6B6B6B;
      line-height: 1.5;
    }

    /* --- Pullquote --- */
    .pullquote {
      border-left: 3px solid #E86C47;
      margin: 2rem 0;
      padding: 0.75rem 1.25rem;
      background: #F8F6F3;
      border-radius: 0 8px 8px 0;
    }
    .pullquote p {
      font-size: 1rem;
      font-style: italic;
      color: #3D3D3D;
      line-height: 1.6;
      margin: 0;
    }
    .pullquote cite {
      font-size: 0.72rem;
      color: #B0B0B0;
      display: block;
      margin-top: 0.4rem;
      font-style: normal;
    }

    /* Responsive */
    @media (max-width: 640px) {
