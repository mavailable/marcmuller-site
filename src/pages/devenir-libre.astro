  <!-- ============================
       REVEAL OVERLAY
       ============================ -->
  <!-- Faux social proof popup -->
  <div id="social-proof-popup">
    <div class="sp-icon">🎉</div>
    <div class="sp-text">
      <strong></strong><span class="sp-sub"></span>
      <div class="sp-time"></div>
    </div>
  </div>

  <div id="reveal-overlay">
    <div class="confetti-wrap" id="confetti-wrap"></div>
    <button id="btn-close-overlay" onclick="document.getElementById('reveal-overlay').classList.remove('active'); document.body.style.overflow = '';" style="position:absolute; top:1.25rem; right:1.5rem; background:none; border:none; color:#6B6B6B; font-size:1.75rem; line-height:1; cursor:pointer; padding:0.25rem 0.5rem; transition:color 0.2s;" onmouseover="this.style.color='#FAFAF8'" onmouseout="this.style.color='#6B6B6B'" title="Fermer et continuer la visite">✕</button>
    <div class="fish-container">🐟</div>
    <div class="reveal-title">Poisson d'avril !</div>
    <p class="reveal-sub">
      Non, désolé. <strong>Il n'y a pas de formation.</strong><br />
      Pas de rooftop à Dubaï. Pas de 50k/mois en pyjama depuis Bali.<br /><br />
      Juste un dev web indépendant basé à Metz,<br />
      un terminal, et du café filtre.<br />
      <strong>490€, livré en 7 jours.</strong>
    </p>
    <a href="/" class="btn-real">Voir le vrai site →</a>
    <p class="reveal-fine">
      (La Ferrari mentale, par contre, elle est offerte.)
    </p>
  </div>


  <script>
    console.log("Tu cherches le code source d'un poisson d'avril. Respecte le hustle.");

    let hasFomoed = false;
    window.addEventListener('scroll', () => {
      if (!hasFomoed && window.scrollY > 300) {
        hasFomoed = true;
        console.log("Tu scrolles encore ? Le FOMO fonctionne.");
      }
    }, { passive: true });

    // ---- Scroll reveal ----
    const observer = new IntersectionObserver(
      (entries) => entries.forEach(e => {
        if (e.isIntersecting) e.target.classList.add('visible');
      }),
      { threshold: 0.15 }
    );
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // ---- Countdown timer (fake — resets from random high value) ----
    let secs = 2 * 3600 + 47 * 60 + 33;
    function pad(n: number) { return String(n).padStart(2, '0'); }
    function updateTimer() {
      if (secs <= 0) secs = 9999; // repart — bien sûr
      secs--;
      const h = Math.floor(secs / 3600);
      const m = Math.floor((secs % 3600) / 60);
      const s = secs % 60;
      document.getElementById('t-h')!.textContent = pad(h);
      document.getElementById('t-m')!.textContent = pad(m);
      document.getElementById('t-s')!.textContent = pad(s);
    }
    setInterval(updateTimer, 1000);

    // ---- Confetti ----
    function spawnConfetti() {
      const wrap = document.getElementById('confetti-wrap')!;
      const colors = ['#E86C47','#FAFAF8','#F5A88A','#1A1A1A','#F0EEEB','#D55A36'];
      for (let i = 0; i < 80; i++) {
        const el = document.createElement('div');
        el.className = 'confetti-piece';
        el.style.left = Math.random() * 100 + 'vw';
        el.style.background = colors[Math.floor(Math.random() * colors.length)];
        el.style.width = (8 + Math.random() * 10) + 'px';
        el.style.height = (8 + Math.random() * 10) + 'px';
        el.style.animationDuration = (1.5 + Math.random() * 2) + 's';
        el.style.animationDelay = (Math.random() * 0.8) + 's';
        wrap.appendChild(el);
        el.addEventListener('animationend', () => el.remove());
      }
    }

    // ---- Reveal ----
    function showReveal() {
      spawnConfetti();
      const overlay = document.getElementById('reveal-overlay')!;
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    document.getElementById('cta-hero')?.addEventListener('click', showReveal);
    document.getElementById('cta-pricing')?.addEventListener('click', showReveal);
    document.querySelectorAll('.cta-escape').forEach(btn => btn.addEventListener('click', showReveal));

    // Auto-reveal au scroll vers le bas de la page pricing
    const pricingSection = document.getElementById('pricing');
    const bottomObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach(e => {
          if (e.isIntersecting && e.intersectionRatio >= 0.85) {
            setTimeout(showReveal, 800);
            bottomObserver.disconnect();
          }
        });
      },
      { threshold: 0.85 }
    );
    if (pricingSection) bottomObserver.observe(pricingSection);

    // Fermer en cliquant sur l'overlay (sauf sur les liens/boutons)
    document.getElementById('reveal-overlay')?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') return;
      document.getElementById('reveal-overlay')!.classList.remove('active');
      document.body.style.overflow = '';
    });

    // --- Faux social proof ---
    const spPopup = document.getElementById('social-proof-popup')!;
    const spIcon = spPopup.querySelector('.sp-icon')!;
    const spText = spPopup.querySelector('.sp-text strong')!;
    const spSub = spPopup.querySelector('.sp-text .sp-sub')!;
    const spTime = spPopup.querySelector('.sp-time')!;

    function showPopup(icon: string, name: string, action: string, time: string) {
      spIcon.textContent = icon;
      spText.textContent = name;
      spSub.textContent = ' ' + action;
      spTime.textContent = time;
      spPopup.classList.add('show');
      setTimeout(() => spPopup.classList.remove('show'), 5000);
    }

    setTimeout(() => showPopup('🎉', 'Thomas de Perpignan', 'vient de rejoindre la formation', 'il y a 2 min'), 4000);
    setTimeout(() => showPopup('💸', 'Thomas de Perpignan', 'vient de demander un remboursement', 'il y a 1 min'), 34000);

    const extraNotifs = [
      ['🔥', 'Kévin de Limoges', 'vient de rejoindre la formation', 'il y a 30 sec'],
      ['🤩', 'Sandrine de Mulhouse', 'regarde le module 2 pour la 4ème fois', 'il y a 1 min'],
      ['💸', 'Anonyme', 'vient de rejoindre', 'il y a 47 sec'],
      ['🧘', 'Dylan de Bali', 'manifeste l\'abondance depuis cette page', 'il y a 3 min'],
      ['🚀', 'Axel B.', 'vient de mettre CEO sur LinkedIn', 'il y a 12 sec'],
    ];
    extraNotifs.forEach(([icon, name, action, time], i) => {
      setTimeout(() => showPopup(icon, name, action, time), 65000 + i * 20000);
    });

    // --- Compteur live qui monte tout seul ---
    let count = 327;
    const counterEl = document.getElementById('viewer-count')!;
    setInterval(() => {
      count += Math.random() < 0.6 ? 1 : -1;
      count = Math.max(300, Math.min(400, count));
      counterEl.textContent = String(count);
    }, 3000);

    // Oussama expand
    const btnOussama = document.getElementById('btn-oussama');
    const oussamaText = document.getElementById('oussama-text');
    if (btnOussama && oussamaText) {
      btnOussama.addEventListener('click', () => {
        if (oussamaText.classList.contains('expanded')) {
          oussamaText.classList.remove('expanded');
          btnOussama.textContent = '📖 Lire la suite (il en a encore beaucoup)';
        } else {
          oussamaText.classList.add('expanded');
          btnOussama.textContent = '😮\u200D💨 Ok j\'ai compris, replier';
        }
      });
    }
  </script>

