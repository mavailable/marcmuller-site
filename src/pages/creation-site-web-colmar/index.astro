---
import VilleTemplate from '@components/VilleTemplate.astro';

const title = "Création site internet à Colmar | Livré en 7 jours";
const description = "Votre site pro à Colmar : design unique, rapide, visible sur Google. Pas de WordPress, pas de template. 30+ sites livrés en Alsace. Devis gratuit en 24h.";

const ville = "Colmar";
const intro = "Vous êtes artisan, commerçant ou indépendant à Colmar et vous cherchez un site web qui travaille pour vous ? Je suis Marc M., je crée des sites sur mesure pour les pros d'Alsace. Design unique, SEO local, livré en 7 jours. Pas de WordPress, pas de template.";

const sections = [
  {
    title: "Colmar : 3 millions de visiteurs par an, et vos concurrents ont déjà un site",
    content: "Colmar attire plus de 3 millions de visiteurs par an — sans compter les locaux. Pourtant, beaucoup de commerçants et artisans colmariens n'ont pas de site web, ou un site WordPress qui date de 2015.\n\nLe problème :\n- Les touristes cherchent sur Google avant de venir (« restaurant Colmar », « artisan Colmar », « coiffeur Colmar »)\n- Les locaux aussi cherchent en ligne avant de pousser la porte\n- Sans site, vous n'existez pas pour ces recherches — ni pour les IA (ChatGPT, Perplexity)\n- Vos concurrents avec un site moderne captent ces clients à votre place\n\nEn Alsace, la clientèle transfrontalière est un atout : un site bilingue FR/DE capte les visiteurs allemands et suisses que vos concurrents ignorent.\n\nUn site moderne bien référencé, c'est votre vitrine 24h/24 — pour les Colmariens, les touristes et les frontaliers."
  },
  {
    title: "Mon approche pour les pros de Colmar",
    content: "Je travaille à distance depuis Metz, avec des clients dans tout le Grand Est et toute la France.\n\nCe que je fais pour chaque site :\n- Design sur mesure qui reflète votre identité et l'esprit alsacien si vous le souhaitez\n- SEO local Colmar + Haut-Rhin (Google Maps, mots-clés géolocalisés)\n- Référencement IA (ChatGPT, Perplexity, Claude vous citent)\n- Mobile-first (la majorité des touristes cherchent sur leur téléphone)\n- Performance Lighthouse 100/100 (chargement < 1 seconde)\n- Rédaction de tous vos textes incluse\n- Site bilingue FR/DE ou FR/EN disponible (zone frontalière + tourisme)\n\nÉchange de 15 minutes pour démarrer — par téléphone, visio ou écrit. Livraison en 7 jours."
  },
  {
    title: "Ce que je fais pour les pros de Colmar et l'Alsace",
    content: "**Un commerce de proximité**\nSituation typique : une page Facebook, pas de site. Je crée un site vitrine avec catalogue, horaires, localisation et commande en ligne. Les clients vous trouvent via Google au lieu de passer devant par hasard.\n\n**Un hébergeur touristique**\nSituation typique : un vieux site avec photos floues, pas de réservation directe. Je crée un site avec carousel de chambres, galerie, avis clients. Les réservations passent par votre site, plus par Booking.\n\n**Un praticien bien-être**\nSituation typique : uniquement Instagram et le bouche-à-oreille. Je crée un site avec planning des cours, tarifs et réservation. De nouvelles personnes vous trouvent via Google."
  }
];

const faq = [
  {
    question: "Vous n'êtes pas à Colmar, c'est un problème ?",
    answer: "Pas du tout. Tout se fait à distance — échange de cadrage par téléphone ou visio, allers-retours par email et WhatsApp. Le résultat est le même qu'avec un prestataire local, souvent plus rapide et moins cher."
  },
  {
    question: "Vous pouvez faire un site en alsacien ou en allemand ?",
    answer: "Oui. Je propose des sites bilingues FR/DE ou FR/EN, parfait pour les activités touristiques ou transfrontalières. Le contenu est traduit et adapté, pas juste passé dans Google Translate. Idéal si vous avez une clientèle allemande ou suisse."
  },
  {
    question: "Mon activité est saisonnière (marché de Noël, tourisme été), c'est adapté ?",
    answer: "Oui. Votre site reste en ligne toute l'année (hébergement gratuit à vie). Vous pouvez mettre à jour vos horaires et actualités vous-même via l'espace d'édition. Pas besoin de couper le site hors saison."
  },
  {
    question: "Vous refaites des sites WordPress ou Wix ?",
    answer: "Oui, c'est fréquent. Je reprends votre contenu, votre domaine, et je redirige l'ancien site vers le nouveau pour préserver votre référencement. Résultat : un site plus rapide, plus sécurisé, sans abonnement mensuel."
  },
  {
    question: "Combien ça coûte par rapport à une agence colmarienne ?",
    answer: "Mon Site Vitrine est livré en 7 jours. Une agence locale met généralement 4 à 8 semaines pour un résultat similaire, souvent bien plus cher. Même qualité technique, interlocuteur unique, et votre site vous appartient (pas d'abonnement)."
  },
  {
    question: "Je suis professionnel de santé ou du bien-être, c'est adapté ?",
    answer: "Oui. Ostéopathes, kinés, psychologues, yoga, sophrologie — je crée des sites sobres et professionnels, conformes aux obligations déontologiques si applicable. Prise de RDV en ligne disponible en add-on."
  }
];

const pricingExpress = {
  title: "Site Vitrine",
  price: "On en parle",
  features: [
    "✓ Design sur mesure, pas un template",
    "✓ Référencé Google & IA",
    "✓ Formulaire, WhatsApp, appel",
    "✓ Lighthouse 100/100",
    "✓ Livré en 7 jours"
  ]
};

const pricingCustom = {
  title: "Projet Sur Mesure",
  price: "Sur devis",
  features: [
    "✓ Multi-pages, blog, CMS",
    "✓ Fonctionnalités métier",
    "✓ Stratégie SEO avancée",
    "✓ Optimisé IA (ChatGPT, Claude)",
    "✓ Devis gratuit sous 48h"
  ]
};

const geo = {
  lat: 48.0794,
  lon: 7.3558
};

const areaServed = ["Colmar", "Haut-Rhin", "Mulhouse", "Sélestat", "Ribeauvillé", "Kaysersberg", "Munster"];

const ctaTitle = "Prêt à lancer votre site web à Colmar ?";
const ctaText = "Écrivez-moi ou appelez. Échange gratuit de 15 minutes, sans engagement. On regarde ensemble ce qu'il vous faut.";
const ctaButton = "Commander mon site";
---

<VilleTemplate
  title={title}
  description={description}
  ville={ville}
  intro={intro}
  sections={sections}
  faq={faq}
  pricingExpress={pricingExpress}
  pricingCustom={pricingCustom}
  geo={geo}
  areaServed={areaServed}
  ctaTitle={ctaTitle}
  ctaText={ctaText}
  ctaButton={ctaButton}
  frPath="/creation-site-web-colmar"
  enPath="/en/web-design-colmar"
/>
