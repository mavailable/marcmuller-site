---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const isProspection = true;
const formule = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const showUpsell = true;

const title = 'Echo Decouverte — My Spa Nancy | Marc M';
const description = 'Analyse gratuite de myspa-nancy.fr : simulation de 10 visites clients, frictions identifiees, recommandations prioritaires. Rapport confidentiel.';
const dateGeneration = '1er avril 2026';

// ─── PERSONAS ───
const personas = [
  {
    id: 1, name: 'Isabelle', age: 45, role: 'Cadre pharmaceutique, budget bien-etre 300 euros/mois', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Mobile', decision: 'Hesite',
    exp: 4, conf: 7, clarte: 3, emoji: '\u{1F48E}',
    situation: 'Cherche un soin corps PHYTOMER a Nancy, compare 2 spas',
    parcours: ['Accueil', 'Services', 'PDF tarifs'],
    questionCle: 'Combien coute un soin corps PHYTOMER ? Quelle duree ?',
    reponse: 'PDF uniquement',
    premierImpression: '4,6 etoile sur 347 avis, PHYTOMER visible, Planity integre. Mais les prix sont dans un PDF a telecharger — pas pratique sur mobile.',
    positifs: ['4,6 etoile / 347 avis', 'PHYTOMER visible = cree du serieux', 'Planity integre', 'Cadre raffine decrit'],
    frictions: ['Tarifs en PDF uniquement — non consultables directement', 'Comparaison avec l\'autre spa difficile', 'PDF lourd sur mobile'],
    raisonDecision: 'Elle telecharge le PDF mais ca prend du temps. Elle hesite et compare avec l\'autre spa qui affiche ses prix directement en ligne.',
    impactTech: 'Mobile : telecharger un PDF est une friction forte. Sur desktop c\'est acceptable, sur mobile ca cree un abandon.',
  },
  {
    id: 2, name: 'Christelle', age: 38, role: 'Sage-femme, massage prenatal pour une amie enceinte', canal: 'Google Maps',
    maturite: 'Decision', device: 'Mobile', decision: 'Convertit',
    exp: 7, conf: 8, clarte: 6, emoji: '\u{1F930}',
    situation: 'Cherche "spa Nancy" sur Maps, voit 4,6 etoile / 347 avis My Spa Nancy',
    parcours: ['Google Maps', 'Accueil', 'Planity'],
    questionCle: 'Vous faites des massages pour femmes enceintes ?',
    reponse: 'Oui',
    premierImpression: '4,6 etoile sur 347 avis. Planity integre. Je reserve. Le prix, je regarderai le PDF apres.',
    positifs: ['4,6 etoile / 347 avis decisif', 'Planity integre', 'Nancy centre confirme', 'Services corps bien listes'],
    frictions: ['Prix PDF uniquement', 'Pas de page dediee massage prenatal'],
    raisonDecision: 'La note Maps + Planity = elle reserve directement. Le prix vient apres.',
    impactTech: 'Mobile : Planity charge correctement. Parcours Maps → Planity fluide.',
  },
  {
    id: 3, name: 'Sandrine', age: 52, role: 'Directrice d\'ecole, soins PHYTOMER recommandes par une collegue', canal: 'Bouche-a-oreille',
    maturite: 'Decision', device: 'Tablette', decision: 'Convertit',
    exp: 6, conf: 9, clarte: 5, emoji: '\u{1F33F}',
    situation: 'Sa collegue y va regulierement pour des soins PHYTOMER — tres satisfaite',
    parcours: ['Accueil', 'Services', 'Planity'],
    questionCle: 'Ma collegue est ravie de vos soins PHYTOMER. Vous avez de la disponibilite ?',
    reponse: 'Oui',
    premierImpression: 'PHYTOMER bien mis en avant. Planity accessible. Cadre raffine. La recommandation fait le reste.',
    positifs: ['Recommandation forte', 'PHYTOMER bien mis en avant', 'Planity accessible', 'Cadre raffine'],
    frictions: ['Prix en PDF (veut comparer les formules PHYTOMER)', 'Pas de description detaillee des soins'],
    raisonDecision: 'La recommandation fait tout. Elle reserve via Planity sans meme regarder les prix.',
    impactTech: 'Tablette : Planity charge bien. PDF accessible mais friction moindre que sur mobile.',
  },
  {
    id: 4, name: 'Muriel', age: 35, role: 'Future mariee, cherche forfait EVJF pour 8 personnes', canal: 'Google Search',
    maturite: 'Decouverte', device: 'Desktop', decision: 'Quitte',
    exp: 2, conf: 5, clarte: 1, emoji: '\u{1F492}',
    situation: 'Cherche "forfait EVJF Nancy spa" — veut un forfait all-inclusive avec prix',
    parcours: ['Accueil', 'Services'],
    questionCle: 'Vous faites des forfaits EVJF ? Pour 8 personnes ? Quel budget ?',
    reponse: 'EVJF mentionne mais sans detail ni prix',
    premierImpression: 'EVJF mentionne dans les services. Cadre elegant. Mais aucune page dediee, aucune formule, aucun prix.',
    positifs: ['EVJF mentionne dans les services', 'Cadre elegant visible'],
    frictions: ['Pas de page EVJF dediee avec formules', 'Prix en PDF = friction pour un devis groupe', 'Pas de formulaire devis EVJF', 'Impossible de comparer sans appeler'],
    raisonDecision: 'Elle ne trouve pas les informations EVJF. Elle appelle plusieurs spas. Celui qui repond le mieux au telephone gagne.',
    impactTech: 'Desktop : PDF accessible mais sans page EVJF dediee, le contenu n\'est pas indexe par Google.',
  },
  {
    id: 5, name: 'Kevin', age: 41, role: 'Chef de projet, cadeau anniversaire massage pour sa femme', canal: 'IA (ChatGPT)',
    maturite: 'Decouverte', device: 'Desktop', decision: 'Quitte',
    exp: 2, conf: 5, clarte: 2, emoji: '\u{1F381}',
    situation: 'ChatGPT lui recommande My Spa Nancy pour offrir un massage a sa femme',
    parcours: ['Accueil', 'Services'],
    questionCle: 'Vous avez des cartes cadeaux ? Je veux offrir un massage a ma femme.',
    reponse: 'Non visible clairement',
    premierImpression: '4,6 etoile rassurant. Soins varies. Cadre raffine. Mais ou sont les cartes cadeaux ?',
    positifs: ['4,6 etoile rassurant', 'Soins varies', 'Cadre raffine'],
    frictions: ['Cartes cadeaux non visibles sur la page d\'accueil', 'Prix PDF = il ne sait pas quel montant prevoir', 'Site non optimise pour les IA'],
    raisonDecision: 'Il ne trouve pas rapidement l\'option cadeau. Il va sur un comparateur de spas qui liste clairement les coffrets.',
    impactTech: 'Les prix en PDF sont invisibles pour ChatGPT. Le site ne peut pas etre cite dans une reponse sur les tarifs.',
  },
  {
    id: 6, name: 'Laurence', age: 29, role: 'Infirmiere, curieuse epilation apres pub Instagram', canal: 'Reseaux sociaux',
    maturite: 'Decouverte', device: 'Mobile', decision: 'Hesite',
    exp: 3, conf: 6, clarte: 2, emoji: '\u{2728}',
    situation: 'A vu des photos de My Spa sur Instagram, curieuse des tarifs epilation',
    parcours: ['Instagram', 'Accueil', 'Services'],
    questionCle: 'C\'est combien une epilation jambes completes ? Et sourcils ?',
    reponse: 'PDF uniquement',
    premierImpression: 'Instagram attractif. 4,6 etoile. Epilation dans les services. Mais pour voir les prix, il faut telecharger un PDF.',
    positifs: ['Instagram attractif', '4,6 etoile', 'Epilation dans les services'],
    frictions: ['Prix PDF uniquement (friction forte sur mobile)', 'Telecharger un PDF sur mobile = abandon probable', 'GTM sans banniere consent probable'],
    raisonDecision: 'Elle hesite. Le PDF a telecharger sur mobile c\'est trop complique. Elle save le compte Instagram.',
    impactTech: 'Mobile : PDF = friction maximum. La majorite des visiteurs mobile abandonnent avant le telechargement.',
  },
  {
    id: 7, name: 'Thomas', age: 48, role: 'DRH, seminaire bien-etre pour son equipe (15 personnes)', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Desktop', decision: 'Quitte',
    exp: 1, conf: 5, clarte: 1, emoji: '\u{1F454}',
    situation: 'Cherche "spa seminaire entreprise Nancy" — budget entreprise disponible',
    parcours: ['Accueil'],
    questionCle: 'Vous proposez des offres pour les entreprises ? Seminaires bien-etre, soins de groupe ?',
    reponse: 'Non',
    premierImpression: 'Cadre raffine adapte a un seminaire premium. Mais aucune section entreprises ou seminaires.',
    positifs: ['Cadre raffine adapte a un seminaire premium', '4,6 etoile'],
    frictions: ['Pas d\'offre entreprise visible', 'Pas de formulaire devis groupe', 'Prix PDF = encore une friction', 'Aucun contact B2B'],
    raisonDecision: 'Pas d\'offre entreprise. Il cherche un spa avec une section "Corporate" ou "Seminaires".',
    impactTech: 'Desktop : site charge correctement. Probleme = absence totale d\'offre B2B.',
  },
  {
    id: 8, name: 'Nadia', age: 33, role: 'Estheticienne en formation, soins avances pour sa peau', canal: 'Google Maps',
    maturite: 'Decision', device: 'Mobile', decision: 'Convertit',
    exp: 6, conf: 8, clarte: 5, emoji: '\u{1F9D6}',
    situation: 'Cherche "spa haut de gamme Nancy" sur Maps, voit My Spa avec 347 avis',
    parcours: ['Google Maps', 'Accueil', 'Planity'],
    questionCle: 'Vous faites des soins visage avances type soin professionnel ?',
    reponse: 'Oui',
    premierImpression: 'PHYTOMER = credibilite professionnelle. 4,6 etoile / 347 avis. Planity integre. Je reserve.',
    positifs: ['4,6 etoile / 347 avis', 'PHYTOMER = credibilite pro', 'Planity integre', '5 rue Drouin = centre Nancy'],
    frictions: ['Prix PDF uniquement', 'Pas de description avancee des protocoles PHYTOMER'],
    raisonDecision: 'La note Maps + PHYTOMER = elle reserve via Planity meme sans voir les prix.',
    impactTech: 'Mobile : Planity charge. Parcours Maps → Planity fonctionne bien.',
  },
  {
    id: 9, name: 'Jean-Pierre', age: 55, role: 'Directeur commercial, carte cadeau spa pour anniversaire femme', canal: 'Bouche-a-oreille',
    maturite: 'Decision', device: 'Mobile', decision: 'Convertit',
    exp: 4, conf: 8, clarte: 3, emoji: '\u{1F496}',
    situation: 'Un collegue recommande My Spa Nancy pour offrir un soin — excellent cadeau selon lui',
    parcours: ['Accueil', 'Contact'],
    questionCle: 'Je veux offrir un soin a ma femme. Vous avez des cartes cadeaux ?',
    reponse: 'Non visible clairement',
    premierImpression: 'Recommandation forte. Cadre premium. 4,6 etoile. Numero cliquable. Je cherche les cartes cadeaux.',
    positifs: ['Recommandation forte', '4,6 etoile', 'Cadre premium visible', 'Numero cliquable (href:tel)'],
    frictions: ['Cartes cadeaux non visibles', 'Prix PDF (il ne sait pas quel montant prevoir)', 'Doit appeler pour acheter'],
    raisonDecision: 'La recommandation est forte. Il appelle pour les cartes cadeaux — conversion malgre la friction.',
    impactTech: 'Mobile : telephone href:tel cliquable — point positif majeur par rapport aux sites Divi.',
  },
  {
    id: 10, name: 'Dominique', age: 27, role: 'Doctorante, budget limite, cherche rapport qualite/prix spa Nancy', canal: 'IA (Perplexity)',
    maturite: 'Comparaison', device: 'Desktop', decision: 'Quitte',
    exp: 2, conf: 5, clarte: 1, emoji: '\u{1F4B8}',
    situation: 'Utilise Perplexity pour comparer les spas Nancy avec tarifs visibles',
    parcours: ['Accueil', 'Services'],
    questionCle: 'Quel est le tarif d\'un massage relaxant 1h chez My Spa Nancy ?',
    reponse: 'Non (PDF uniquement)',
    premierImpression: '4,6 etoile. Bonne reputation. Cadre elegant. Mais les prix sont en PDF — Perplexity ne peut pas les lire.',
    positifs: ['4,6 etoile', 'Bonne reputation', 'Cadre elegant'],
    frictions: ['PDF uniquement = impossible de comparer sans telecharger', 'Concurrent qui affiche ses prix en ligne gagne la comparaison', 'Site non optimise pour les IA'],
    raisonDecision: 'Elle va chez un concurrent qui affiche ses prix en ligne. My Spa ne peut pas etre compare facilement.',
    impactTech: 'Perplexity ne peut pas extraire les tarifs d\'un PDF. Le site est aveugle pour les IA.',
  },
];

// ─── STATS ───
const avgExp = (personas.reduce((s, p) => s + p.exp, 0) / personas.length).toFixed(1);
const avgConf = (personas.reduce((s, p) => s + p.conf, 0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.clarte, 0) / personas.length).toFixed(1);
const convertis = personas.filter(p => p.decision === 'Convertit').length;
const hesitants = personas.filter(p => p.decision === 'Hesite').length;
const quitte = personas.filter(p => p.decision === 'Quitte').length;
const tauxConv = Math.round((convertis / personas.length) * 100);

// ─── CANAL STATS ───
const canalStats = [
  { canal: 'Google Search', total: 3, conv: 0, hesitant: 1, quitte: 2 },
  { canal: 'Google Maps', total: 2, conv: 2, hesitant: 0, quitte: 0 },
  { canal: 'IA (ChatGPT / Perplexity)', total: 2, conv: 0, hesitant: 0, quitte: 2 },
  { canal: 'Reseaux sociaux', total: 1, conv: 0, hesitant: 1, quitte: 0 },
  { canal: 'Bouche-a-oreille', total: 2, conv: 2, hesitant: 0, quitte: 0 },
];

// ─── FRICTIONS ───
const frictions = [
  { label: 'Tarifs en PDF uniquement — non consultables en ligne, non indexables par Google ni les IA', count: 8, severity: 'critique' },
  { label: 'Cartes cadeaux non visibles sur le site (occasion manquee anniversaires, Noel, fete des meres)', count: 4, severity: 'haute' },
  { label: 'aggregateRating absent Schema.org (347 avis 4,6 etoile non exploites en rich snippets)', count: 10, severity: 'haute' },
  { label: 'Pas de page EVJF dediee avec formules et formulaire devis groupe', count: 3, severity: 'haute' },
  { label: 'Pas d\'offre groupe / entreprise / seminaire bien-etre', count: 2, severity: 'moyenne' },
  { label: 'Performances mobiles degradees (Elementor + WooCommerce + GTM)', count: 6, severity: 'haute' },
  { label: 'RGPD : GTM charge scripts tiers sans CMP conforme probable', count: 10, severity: 'haute' },
];

// ─── RECOMMANDATIONS ───
const recoHaute = {
  title: 'Afficher les tarifs principaux en ligne — supprimer la dependance au PDF',
  impact: '8/10 personas',
  detail: 'Le PDF est la friction numero 1. La solution n\'est pas de supprimer le PDF (utile comme document de reference complet) mais d\'afficher les tarifs principaux directement sur chaque page de service. "Soin visage PHYTOMER a partir de 75€ — 60 min", "Massage relaxant a partir de 65€ — 45 ou 60 min", "Epilation jambes completes : X€". Ces informations affichees en HTML sont indexees par Google et citables par les IA — avantage concurrentiel direct sur les concurrents qui font pareil avec un PDF.'
};
const recosMoyennes = [
  {
    title: 'Creer une page EVJF dediee avec formules chiffrees + formulaire de devis',
    impact: '3 personas directs + trafic SEO "EVJF Nancy spa"',
    detail: 'L\'EVJF est un segment a tres forte valeur (ticket moyen 500-1500€ par groupe). Une page dediee "EVJF & Mariages" avec 3 formules chiffrees ("Formule Essentiel : 3 soins 30 min par personne — X€/pers."), photos, et un formulaire de devis groupe capturerait directement un trafic Google a forte intention d\'achat. My Spa a tout ce qu\'il faut — il manque juste la page.'
  },
  {
    title: 'Rendre les cartes cadeaux visibles et achetables en ligne',
    impact: '4 personas',
    detail: 'Un bouton "Offrir un soin" dans le header avec 3 montants predefinis (50€, 100€, 150€) ou une page /cadeaux dediee transformerait une occasion manquee en flux de revenus supplementaire. Le spa est un cadeau ideal pour anniversaires, fetes des meres, Noel — mais les acheteurs ne trouvent pas l\'option sur le site.'
  },
  {
    title: 'Exploiter les 347 avis en Schema.org DaySpa + aggregateRating',
    impact: '10/10 personas (SEO)',
    detail: 'Les 4,6 etoile sur 347 avis ne sont pas declares en JSON-LD. Ajouter @type DaySpa + aggregateRating + openingHoursSpecification generera des rich snippets Google avec etoiles — amelioration du CTR estimee a 20-35%. Un atout particulierement fort pour se demarquer dans les resultats "spa Nancy".'
  },
];

// ─── TECHNIQUE ───
const techVerdicts = [
  { label: 'HTTPS actif', ok: true },
  { label: 'Telephone cliquable natif (href:tel)', ok: true },
  { label: 'Planity reserve integre', ok: true },
  { label: 'Note Google 4,6 etoile / 347 avis', ok: true },
  { label: 'PHYTOMER positionne comme argument premium', ok: true },
  { label: 'Prix affiches en ligne (pas en PDF uniquement)', ok: false },
  { label: 'aggregateRating Schema.org (347 avis)', ok: false },
  { label: 'Performances mobiles (Elementor + GTM)', ok: false },
  { label: 'Cartes cadeaux visibles sur le site', ok: false },
  { label: 'RGPD (GTM + CMP conforme)', ok: false },
];

// ─── HELPERS ───
function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}
function severityColor(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  if (s === 'moyenne') return 'bg-blue-100 text-blue-800';
  return 'bg-neutral-100 text-neutral-600';
}
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath="/echo/my-spa-nancy"
>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #1a0f1f;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-15 blur-3xl" style="background: #e91e8c;"></div>

    <div class="mx-auto max-w-4xl relative z-10">
      <div class="mb-4 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-pink-500/40">
        <span class="w-2 h-2 rounded-full bg-pink-400"></span>
        <span class="text-sm font-semibold text-white/90">Echo Decouverte &middot; Confidentiel</span>
      </div>

      <h1 class="mb-4 text-3xl font-bold leading-tight text-white md:text-4xl lg:text-5xl">
        My Spa Nancy : <span class="text-pink-400">6 visiteurs sur 10 repartent</span> sans connaitre les prix — a cause d'un PDF
      </h1>

      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl mb-8">
        Analyse de <strong class="text-white">myspa-nancy.fr</strong> — simulation de 10 visites clients reelles, frictions identifiees, recommandations prioritaires. Genere le {dateGeneration}.
      </p>

      <div class="flex flex-wrap gap-4 mb-10">
        <div class="px-6 py-4 rounded-xl bg-green-900/40 border border-green-700/40 text-center">
          <p class="text-2xl font-bold text-green-400">{convertis}</p>
          <p class="text-xs text-green-300 mt-1">contactent</p>
        </div>
        <div class="px-6 py-4 rounded-xl bg-amber-900/40 border border-amber-700/40 text-center">
          <p class="text-2xl font-bold text-amber-400">{hesitants}</p>
          <p class="text-xs text-amber-300 mt-1">hesitent</p>
        </div>
        <div class="px-6 py-4 rounded-xl bg-red-900/40 border border-red-700/40 text-center">
          <p class="text-2xl font-bold text-red-400">{quitte}</p>
          <p class="text-xs text-red-300 mt-1">repartent</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">10 personas simules</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">5 canaux d'arrivee</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">Audit technique inclus</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">{dateGeneration}</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ CONSTAT ═══════════════════ -->
  <div class="w-full px-6 py-10 md:px-8 bg-white">
    <div class="mx-auto max-w-4xl">
      <div class="rounded-xl border-l-4 border-l-pink-500 bg-pink-50 p-6 md:p-8">
        <h2 class="text-lg font-bold text-neutral-900 mb-2">Le paradoxe My Spa Nancy</h2>
        <p class="text-neutral-800 leading-relaxed">
          My Spa Nancy est bien positionne — <strong>347 avis 4,6 etoile, PHYTOMER, Planity integre, telephone cliquable</strong>. Mais une seule friction fait partir 6 visiteurs sur 10 : <strong>les tarifs ne sont disponibles qu'en PDF telechargeable.</strong> Sur mobile (60% du trafic), telecharger un PDF est une friction souvent eliminatoire. Pour Google et les IA (ChatGPT, Perplexity), ces prix sont totalement invisibles — My Spa ne peut pas etre cite dans une reponse sur les tarifs des spas nancéiens. Le concurrent qui affiche ses prix en HTML gagne systematiquement la comparaison.
        </p>
      </div>
    </div>
  </div>

  <!-- ═══════════════════ CANAUX ═══════════════════ -->
  <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-neutral-50">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Conversion par canal</h2>
      <p class="text-neutral-500 mb-8">Google Maps et le bouche-a-oreille convertissent bien (note + recommandation suffisent). Google Search, IA et reseaux sociaux : conversion tres faible — ces visiteurs cherchent des prix que le site ne fournit pas en ligne.</p>
      <div class="grid md:grid-cols-2 gap-4">
        {canalStats.map((c) => {
          const pct = c.total > 0 ? Math.round((c.conv / c.total) * 100) : 0;
          return (
            <div class="rounded-xl border border-neutral-200 bg-white p-5">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-semibold text-neutral-900 text-sm">{c.canal}</h3>
                <span class={`text-lg font-bold ${pct > 50 ? 'text-emerald-600' : pct > 0 ? 'text-amber-600' : 'text-red-600'}`}>{pct}%</span>
              </div>
              <div class="h-3 rounded-full bg-neutral-100 overflow-hidden mb-3">
                <div class="h-full rounded-full flex">
                  <div class="bg-emerald-500" style={`width: ${c.total > 0 ? (c.conv / c.total) * 100 : 0}%`}></div>
                  <div class="bg-amber-400" style={`width: ${c.total > 0 ? (c.hesitant / c.total) * 100 : 0}%`}></div>
                  <div class="bg-red-400" style={`width: ${c.total > 0 ? (c.quitte / c.total) * 100 : 0}%`}></div>
                </div>
              </div>
              <div class="flex gap-4 text-xs text-neutral-400">
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> {c.conv} conv.</span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-400"></span> {c.hesitant} hes.</span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-400"></span> {c.quitte} partis</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- ═══════════════════ PERSONAS ═══════════════════ -->
  <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-white">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">10 visites simulees</h2>
      <p class="text-neutral-500 mb-8">Clients types qui visitent myspa-nancy.fr — profils, parcours, et raison de leur decision.</p>

      <div class="space-y-8">

        {/* Convertit */}
        <div>
          <h3 class="text-base font-bold text-emerald-700 mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Ceux qui contactent ({convertis})
          </h3>
          <div class="space-y-3">
            {personas.filter(p => p.decision === 'Convertit').map((p) => (
