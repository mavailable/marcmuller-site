---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'my-spa-nancy';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const isProspection = true;
const nomProspect = 'My Spa Nancy';
const urlSite = 'https://myspa-nancy.fr';
const dateAudit = '31 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 3,
  nbHesitent: 1,
  nbRepartent: 1,
  conversion: 60,
  experience: 6.0,
  confiance: 8.8,
  clarte: 4.2,
};

const verdictHero = 'Sur 5 visiteurs, 3 reservent — l\'offre complete (hammam + sauna + massages + esthetique) est unique a Nancy et convertit les decideurs malgre un site lent sur un WordPress de 2017. Manon cherchait sauna + hammam sur mobile : le site trop dense et trop lent l\'a perdue dans la navigation. Fatima cherchait les tarifs epilation pour comparer : introuvables dans la navigation complexe.';

const constat = 'My Spa Nancy est probablement le spa le plus complet de Nancy (hammam + sauna + massages + soins visage + esthetique + famille) avec 347 avis a 4.6 etoiles. C\'est un atout rare. Mais le site WordPress 4.9.8 de 2017 est un boulet : lent, dense, navigation confuse sur mobile, potentiellement vulnerable. Le site fait fuir les visiteurs mobiles et ne permet pas de trouver les tarifs facilement. Le segment entreprise (CE) est une opportunite non exploitee.';

const canalData = [
  { canal: 'Google Search (spa couple hammam)', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille (carte cadeau)', nb: 1, convert: 1, rate: 100 },
  { canal: 'IA (sauna nancy)', nb: 1, convert: 0, rate: 0 },
  { canal: 'Google Search (spa CE)', nb: 1, convert: 1, rate: 100 },
