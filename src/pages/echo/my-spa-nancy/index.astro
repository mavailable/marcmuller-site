  observatory: { grade: 'C', score: 40, testsOk: 3, testsTotal: 10 },
  pagespdMobile: { performance: 38, accessibility: 70, bestPractices: 65, seo: 63 },
  pagespdDesktop: { performance: 58, accessibility: 74, bestPractices: 70, seo: 68 },
