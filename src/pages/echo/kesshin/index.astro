    pourquoi: "7 visiteurs sur 20 cherchent la même chose : qui a créé cette méthode et où Thomas l'a apprise. Le récit fondateur s'arrête une phrase trop tôt, et c'est la question qui retient les 2 hésitants.",
    action: "Ajouter 2 ou 3 phrases dans la section The Story : le nom de la formation ou du formateur, l'année, la durée de pratique. Si la lignée ne peut pas être nommée, dire honnêtement pourquoi.",
    impact: '7 visiteurs sur 20',
  },
  {
    titre: "Afficher le cadre et les limites du travail",
    pourquoi: "Le site propose de travailler sur les traumatismes sans dire à qui ça ne convient pas, ni ce qui se passe si quelque chose de lourd émerge, ni que la séance est confidentielle. Les profils prudents et les prescripteurs en ont besoin pour s'engager.",
    action: "Un bloc court dans la section séance : confidentialité explicite, à qui ce travail ne convient pas (troubles diagnostiqués sous traitement : voir un professionnel de santé), et ce qui est prévu si la séance remue trop fort.",
    impact: '5 visiteurs sur 20',
  },
  {
    titre: "Annoncer un délai de réponse, rendre le créneau saisissable",
    pourquoi: "4 des 11 prises de contact restent suspendues à la réponse de Thomas : voyageurs à dates serrées, planificatrice à 5 semaines. Une réponse lente peut encore les perdre.",
    action: "Au minimum : afficher « réponse sous 24 h » près du formulaire et du bouton WhatsApp. Idéalement : un lien de réservation de créneau avec une politique d'annulation en une ligne.",
    impact: '4 visiteurs sur 20',
  },
];

const ameliorationsUtiles = [
  { titre: 'Chiffrer les forfaits', detail: "« Forfaits à tarif réduit » sans montant est le seul prix caché du site. Afficher « 3 séances : X € » évite une question à chaque prise de contact." },
  { titre: 'Un pont concret pour les non-initiés', detail: "Le passé d'instructeur de freediving est l'atout n°1 auprès du public local (la peur en profondeur), mais il est en bas de page. Une ligne dans le premier écran suffirait." },
  { titre: 'Nommer la confidentialité', detail: "« Ce qui se dit en séance reste en séance » : une phrase, très attendue sur une petite île où tout le monde se connaît." },
  { titre: 'Rendre 2-3 témoignages vérifiables', detail: "Prénoms seuls aujourd'hui. Un nom complet consenti ou un témoignage vidéo donnerait la preuve externe que cherchent les profils analytiques." },
];

const ameliorationsDiscuter = [
  { emoji: '📍', titre: 'Fiche Google Business', detail: "2 visiteurs sur 20 ne trouvent jamais le site faute de fiche sur Google Maps. Le choix de ne pas en créer est assumé ; à réévaluer seulement si le contexte change." },
  { emoji: '🇹🇭', titre: 'Séances en thaï', detail: "Une visiteuse thaïlandaise convertit en anglais pour parler d'un deuil. Le coût émotionnel d'une langue seconde est réel : proposer le thaï est une décision de praticien, pas de site." },
  { emoji: '📅', titre: 'Réservation en ligne avec acompte', detail: "Transformerait les contacts fragiles en réservations fermes, au prix d'une mécanique plus lourde qu'un positionnement volontairement épuré." },
];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Rapide', ok: true, detail: 'Affichage quasi immédiat, téléphone comme ordinateur' },
  { label: 'Sécurité', verdict: 'B', ok: true, detail: '8 protections sur 10, deux avancées absentes' },
  { label: 'Référencement', verdict: '100/100', ok: true, detail: 'Indexé, propre, aucune erreur détectée' },
  { label: 'Données structurées', verdict: 'Complètes', ok: true, detail: '5 fiches lisibles par Google et les IA, 0 erreur' },
  { label: 'Partage réseaux', verdict: 'OK', ok: true, detail: 'Aperçu complet avec image sur tous les réseaux' },
];

const tech = {
  observatory: { grade: 'B', score: 70, testsOk: 8, testsTotal: 10 },
  pagespdMobile: { performance: 97, accessibility: 100, bestPractices: 96, seo: 100 },
  pagespdDesktop: { performance: 100, accessibility: 100, bestPractices: 100, seo: 100 },
  cwv: { lcp: '2,6 s (mobile) / 0,6 s (ordinateur)', cls: '0 (aucun saut visuel)', tbt: '0 ms (aucun blocage)' },
  headers: [
    { ok: true, h: 'Connexion chiffrée forcée (HSTS)' },
    { ok: true, h: 'Protection contre le détournement de contenu' },
    { ok: true, h: 'Protection contre l’affichage en cadre pirate' },
    { ok: true, h: 'Politique de référence propre' },
    { ok: true, h: 'Permissions du navigateur verrouillées' },
    { ok: true, h: 'Redirection sécurisée systématique' },
    { ok: false, h: 'Politique de sécurité du contenu des pages publiques (absente)' },
    { ok: false, h: 'Intégrité des scripts externes (absente)' },
  ],
  schema: [
    { item: 'Fiche métier du praticien (avec prix, lieu, contact)', ok: true },
    { item: 'Fiche personne : Thomas Denamur, fondateur', ok: true },
    { item: 'Questions-réponses balisées pour Google et les IA', ok: true },
    { item: 'Fiches site et page, 0 erreur de validation', ok: true },
    { item: 'Champs recommandés mineurs absents (horaires)', ok: false },
  ],
  og: [
    { item: 'Titre de partage', ok: true, val: '' },
    { item: 'Description de partage', ok: true, val: '' },
    { item: 'Image de partage', ok: true, val: '' },
    { item: 'Adresse canonique', ok: true, val: '' },
    { item: 'Carte de partage X/Twitter complète', ok: true, val: '' },
  ],
  seo: [
    { item: 'Un seul titre principal par page', ok: true },
    { item: 'Plan du site propre (7 adresses)', ok: true },
    { item: 'Fichier robots avec directives pour les IA', ok: true },
    { item: 'Vraie page 404 (le faux 404 d’avant est corrigé)', ok: true },
    { item: 'Versions anglaise et française correctement déclarées', ok: true },
    { item: 'Anciennes adresses redirigées proprement', ok: true },
  ],
};

const borderColor = (d: Decision) => d === 'Convertit' ? 'border-green-200' : d === 'Hesite' ? 'border-amber-200' : 'border-neutral-200';
const badgeBg = (d: Decision) => d === 'Convertit' ? 'bg-green-600' : d === 'Hesite' ? 'bg-amber-500' : 'bg-neutral-400';
---

<BaseLayout title={title} description={description} noindex={true}>

  <!-- 1. HERO -->
  <section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
    <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
        {formuleLabel} · Rapport confidentiel
      </div>
      <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
        {verdictHero}
      </h1>
      <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
        Site analysé : <a href={urlSite} target="_blank" rel="noopener" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simulés · {dateAudit} · comparé à l'audit du 10 juillet (avant corrections)
      </p>
      <div class="grid grid-cols-3 gap-4">
        <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
          <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
          <div class="text-sm text-green-400/70">vous contactent</div>
        </div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
          <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
          <div class="text-sm text-amber-400/70">hésitent</div>
        </div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
          <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
          <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 1b. EVOLUTION v1 -> v2 -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Comment votre site a évolué en 5 jours</h2>
    <p class="text-neutral-600 mb-8">Les 20 mêmes visiteurs ont été rejoués sur le site d'avant corrections, puis sur le site en ligne.</p>

    <div class="grid md:grid-cols-2 gap-4 mb-10">
      {versionsData.map(v => (
        <div class={`rounded-xl p-6 border ${v.version === 'v2' ? 'border-2 border-green-300 bg-green-50/40' : 'border-neutral-200 bg-white'}`}>
          <div class="flex items-center gap-2 mb-2">
            <span class={`text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider ${v.version === 'v2' ? 'bg-green-600 text-white' : 'bg-neutral-200 text-neutral-600'}`}>{v.version}</span>
            <span class="text-xs text-neutral-500">{v.date}</span>
          </div>
          <p class="text-sm font-semibold text-neutral-900 mb-1">{v.label}</p>
          <div class={`text-3xl font-black mb-1 ${v.version === 'v2' ? 'text-green-600' : 'text-neutral-400'}`}>{v.taux}%</div>
          <p class="text-xs text-neutral-500">{v.note}</p>
        </div>
      ))}
    </div>

    <h3 class="text-base font-bold text-neutral-900 mb-4">Friction par friction</h3>
    <div class="overflow-x-auto rounded-xl border border-neutral-200 mb-4">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-neutral-50">
            <th class="text-left p-3 text-neutral-500 font-medium">Friction identifiée le 10 juillet</th>
            <th class="p-3 text-neutral-500 font-medium w-14">État</th>
            <th class="text-left p-3 text-neutral-500 font-medium">Aujourd'hui</th>
          </tr>
        </thead>
        <tbody>
          {deltaData.map(d => (
            <tr class="border-t border-neutral-100">
              <td class="p-3 text-neutral-700">{d.friction}</td>
              <td class="p-3 text-center text-base">{d.statut}</td>
              <td class="p-3 text-neutral-600 text-xs">{d.detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-xs text-neutral-400">✅ résolu · ⚠️ partiellement · ❌ inchangé</p>
  </section>

  <!-- 2. LE CONSTAT -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
      <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
    </div>

    <h2 class="text-xl font-bold text-neutral-900 mb-2">D'où viennent vos visiteurs</h2>
    <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivée.</p>
    <div class="space-y-4 mb-12">
      {canalData.map(c => {
        const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
        return (
          <div class="flex items-center gap-4">
            <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
            <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
              <div class="h-full rounded-full" style={`width: ${c.rate}%; background: ${color}`}></div>
            </div>
            <div class="w-20 text-right">
              <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
              <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
            </div>
          </div>
        );
      })}
    </div>

    <details class="group mb-4">
      <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
        <svg class="w-4 h-4 transition-transform group-open:rotate-90" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        Voir les scores détaillés (expérience, confiance, clarté)
      </summary>
      <div class="grid grid-cols-3 gap-4 mt-3">
        <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
          <div class="text-xs text-neutral-500">Expérience</div>
          <p class="text-[10px] text-neutral-400 mt-1">4,9 en v1 · navigation, lisibilité, fluidité</p>
        </div>
        <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
          <div class="text-xs text-neutral-500">Confiance</div>
          <p class="text-[10px] text-neutral-400 mt-1">4,9 en v1 · crédibilité, preuves, rassurance</p>
        </div>
        <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
          <div class="text-xs text-neutral-500">Clarté</div>
          <p class="text-[10px] text-neutral-400 mt-1">4,9 en v1 · compréhension de l'offre et des prix</p>
        </div>
      </div>
    </details>
  </section>

  <!-- 2b. ALERTES -->
  <section class="py-14" style="background: #fefce8;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-2">
        <svg class="w-6 h-6 text-amber-500" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <h2 class="text-xl font-bold text-neutral-900">Ce qui retient encore vos visiteurs</h2>
      </div>
      <p class="text-sm text-neutral-600 mb-8">Plus rien n'est cassé. Ces trois points sont les manques qui coûtent le plus.</p>
      <div class="grid md:grid-cols-3 gap-4">
        {alertes.map(a => (
          <div class="bg-white rounded-xl p-5 border border-amber-200">
            <div class="inline-flex items-baseline gap-2 mb-3 px-2.5 py-1 rounded-lg bg-amber-100">
              <span class="text-2xl font-black text-amber-700">{a.chiffre}</span>
              <span class="text-[10px] text-amber-700 font-medium">{a.chiffreLabel}</span>
            </div>
            <h3 class="font-bold text-neutral-900 text-sm mb-2">{a.titre}</h3>
            <p class="text-xs text-neutral-600">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. VOS VISITEURS -->
  <section class="py-16" style="background: #fafafa;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
      <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche ce que vous proposez et tombe sur votre site. Cliquez sur un visiteur pour le détail complet.</p>

      <!-- Convertissent -->
      <div class="mb-10">
        <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
          Ceux qui vous contactent
          <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
        </h3>
        <div class="space-y-3">
          {personas.filter(p => p.decision === 'Convertit').map(p => (
            <details class={`group persona-card bg-white rounded-xl overflow-hidden shadow-sm border ${borderColor(p.decision)}`}>
              <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                    <span class={`text-[10px] ${badgeBg(p.decision)} text-white px-1.5 py-0.5 rounded font-medium`}>{p.decisionLabel}</span>
                  </div>
                  <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                    <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                    <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                  </div>
                </div>
                <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class={`px-4 pb-5 border-t ${borderColor(p.decision)}`}>
                <div class="grid gap-4 text-xs mt-4">
                  <div>
                    <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p>
                    <p class="text-neutral-600">{p.situation}. {p.localisation}. {p.contexte}</p>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Première impression (5 sec)</p>
                    <p class="text-neutral-600">{p.impression}</p>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                    <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                      {p.parcours.map(([section, reaction]) => (
                        <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` : ${reaction}` : ''}</li>
                      ))}
                    </ol>
                  </div>
                  <div class="bg-neutral-50 rounded-lg p-3">
                    <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                    <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                    <p class="text-neutral-600">Le site répond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> : {p.commentReponse}</p>
                  </div>
                  <div class="grid grid-cols-2 gap-4">
                    <div>
                      <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Vitesse</p>
                      <p class="text-neutral-600">{p.impactVitesse}</p>
                    </div>
                    <div>
                      <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Confiance</p>
                      <p class="text-neutral-600">{p.impactConfiance}</p>
                    </div>
                  </div>
                  <div class="grid grid-cols-2 gap-4">
                    <div>
                      <p class="font-semibold text-green-700 mb-1.5">✓ Points positifs</p>
                      <ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul>
                    </div>
                    <div>
                      <p class="font-semibold text-amber-700 mb-1.5">✗ Frictions</p>
                      <ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul>
                    </div>
                  </div>
                  <div class="flex gap-6 pt-3 border-t border-neutral-100">
                    {[
                      { label: 'Expérience', val: p.exp },
                      { label: 'Confiance', val: p.conf },
                      { label: 'Clarté', val: p.clarte },
                    ].map(s => {
                      const sColor = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
                      return (
                        <div class="text-center">
                          <span class={`block text-lg font-bold ${sColor}`}>{s.val}</span>
                          <span class="text-[10px] text-neutral-400">{s.label}</span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- Hesitent -->
      <div class="mb-4">
        <h3 class="text-base font-bold text-amber-800 mb-4 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block"></span>
          Ceux qui hésitent
          <span class="text-sm font-normal text-amber-600">({kpis.nbHesitent})</span>
        </h3>
        <div class="space-y-3">
          {personas.filter(p => p.decision === 'Hesite').map(p => (
            <details class={`group persona-card bg-white rounded-xl overflow-hidden shadow-sm border ${borderColor(p.decision)}`}>
              <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                    <span class={`text-[10px] ${badgeBg(p.decision)} text-white px-1.5 py-0.5 rounded font-medium`}>{p.decisionLabel}</span>
                  </div>
                  <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                    <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                    <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                  </div>
                </div>
