---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'brendoliv';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const isProspection = true;
const nomProspect = "Brend'oliv Nancy";
const urlSite = 'https://www.brendoliv.com';
const dateAudit = '31 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 3,
  nbHesitent: 1,
  nbRepartent: 1,
  conversion: 60,
  experience: 6.8,
  confiance: 8.5,
  clarte: 4.0,
};

const verdictHero = 'Sur 5 visiteurs, 3 reservent — la note 4.5 sur 431 avis et la terrasse vieille ville font le travail. Sophie organisait un repas de 15 personnes : aucune page privatisation, aucun formulaire groupe — elle est allee directement chez le concurrent. Camille cherchait la carte et les prix : le template Zenchef ne lui a rien donne.';

const constat = 'Brend\'oliv convertit les decideurs motives grace a sa note solide et son emplacement Grande Rue vieille ville. Mais le site Zenchef est un template sans ame : pas de menu textuel, pas de prix, pas de page terrasse dediee, pas de page privatisation. L\'etablissement perd le segment evenementiel (groupes, anniversaires) et est invisible sur toute la longue traine locale ("restaurant dimanche midi nancy", "terrasse vieille ville nancy", "privatisation restaurant nancy").';

const canalData = [
  { canal: 'Google Search (terrasse)', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille (dimanche)', nb: 1, convert: 1, rate: 100 },
  { canal: 'IA (dimanche midi)', nb: 1, convert: 0, rate: 0 },
  { canal: 'Google Maps (privatisation)', nb: 1, convert: 0, rate: 0 },
  { canal: 'Google Search (grande rue)', nb: 1, convert: 1, rate: 100 },
];

const personas = [
  {
    id: 1,
    name: 'Julie',
    age: 31,
    emoji: '🌿',
    situation: 'Cherche un restaurant avec terrasse en vieille ville pour un diner printemps',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Reserve',
    histoire: '"terrasse restaurant nancy" → Maps → Brend\'oliv 4.5 sur 431 avis → site Zenchef → terrasse visible en photos → reserve directement.',
    localisation: 'Nancy (54)',
    maturite: 'Decision',
    contexte: 'Printemps arrive, veut un diner en terrasse en vieille ville. L\'emplacement Grande Rue et la note decidient.',
    impression: 'Les photos de la terrasse + la note 4.5 rassurent. Le site Zenchef est basique mais l\'essentiel est la.',
    parcours: [
      ['Google Search', '"terrasse restaurant nancy"'],
      ['Google Maps', 'Brend\'oliv — 4.5 sur 431 avis, vieille ville'],
      ['Site Zenchef', 'Photos terrasse — exactement ce qu\'elle cherche'],
      ['Reservation', 'Reserve directement via le bouton Zenchef'],
    ] as [string, string][],
    questionCle: 'Y a-t-il une terrasse et peut-on reserver facilement ?',
    reponse: 'Oui' as const,
    commentReponse: 'Photos terrasse visibles + bouton reservation Zenchef disponible.',
    impactVitesse: 'Zenchef correct — non bloquant',
    impactConfiance: '4.5 sur 431 avis — tres solide pour un restaurant de vieille ville',
    positifs: ['Photos terrasse visibles', 'Note 4.5 rassurante', 'Reservation en ligne disponible'],
    frictions: ['Pas de description de la cuisine', 'Pas de prix'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 9, clarte: 5,
  },
  {
    id: 2,
    name: 'Marc',
    age: 45,
    emoji: '💼',
    situation: 'Collegue a dine la — cherche l\'adresse et l\'horaire du dimanche',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Reserve',
    histoire: 'Tape "brendoliv nancy". Site → adresse trouvee → ouvert dimanche midi confirme → reserve.',
    localisation: 'Nancy (54)',
    maturite: 'Decision',
    contexte: 'Veut emmener sa femme dimanche midi — recommandation forte, juste besoin de confirmer les horaires.',
    impression: 'Site basique mais l\'info horaire dimanche est trouvee. La recommandation fait le reste.',
    parcours: [
      ['Recherche directe', '"brendoliv nancy"'],
      ['Site', 'Adresse + ouvert dimanche midi confirme'],
      ['Reservation', 'Reserve pour dimanche'],
    ] as [string, string][],
    questionCle: 'Sont-ils ouverts dimanche midi ?',
    reponse: 'Oui' as const,
    commentReponse: 'Information disponible sur le site Zenchef.',
    impactVitesse: 'Desktop — non bloquant',
    impactConfiance: 'Recommandation directe + horaires confirmes',
    positifs: ['Horaires dimanche visibles', 'Recommandation forte'],
    frictions: ['Site tres basique — peu de contenu'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 9, clarte: 6,
  },
  {
    id: 3,
    name: 'Camille',
    age: 28,
    emoji: '📱',
    situation: 'Cherche un restaurant traditionnel ouvert dimanche midi a Nancy — ne connait pas Brend\'oliv',
    canal: 'IA (ChatGPT)',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: '"restaurant traditionnel dimanche midi nancy" via ChatGPT → Brend\'oliv cite. Site Zenchef → pas de menu textuel → pas de prix → pas de description cuisine → concurrent avec menu HTML + prix + "ouvert dimanche" bien mis en avant → hesite.',
    localisation: 'Nancy (54)',
    maturite: 'Decouverte',
    contexte: 'Cherche pour ses parents en visite le dimanche. Veut valider le type de cuisine et le budget avant de proposer.',
    impression: 'La note rassure mais le site ne donne aucune information sur ce qu\'on mange ni sur les prix. Impossible de se projeter sur l\'experience culinaire.',
    parcours: [
      ['ChatGPT', '"restaurant traditionnel dimanche midi nancy" — Brend\'oliv cite'],
      ['Site', 'Template Zenchef — photos generiques, pas de menu texte'],
      ['Concurrent', '"Cuisine du terroir lorrain, carte a partir de 14€ en entree, ouvert dimanche midi" — clair et actionnable'],
    ] as [string, string][],
    questionCle: 'Quelle cuisine, quels plats typiques et quel est le budget ?',
    reponse: 'Non' as const,
    commentReponse: 'Le site Zenchef ne donne aucune information sur la cuisine ni les prix.',
    impactVitesse: 'Zenchef mobile — correct',
    impactConfiance: '4.5 sur 431 avis rassurant mais insuffisant sans description cuisine',
    positifs: ['Note 4.5 solide', 'Ouvert dimanche midi — rare'],
    frictions: ['Aucune description de la cuisine', 'Pas de prix', 'Template generique sans identite'],
    ceQuiFeraitBasculer: 'Une description de la cuisine ("cuisine traditionnelle francaise, produits locaux") + les prix moyens + "Terrasse ouverte + Ouvert dimanche midi". Camille voulait choisir Brend\'oliv — elle avait juste besoin d\'un minimum d\'information.',
    exp: 5, conf: 7, clarte: 3,
  },
  {
    id: 4,
    name: 'Sophie',
    age: 52,
    emoji: '🎉',
    situation: 'Organise un repas de groupe (15 personnes) pour un anniversaire familial',
    canal: 'Google Maps',
    device: 'Tablette',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Maps → Brend\'oliv 4.5★ vieille ville → site Zenchef → cherche "privatisation" ou "groupes" → rien → repart sur un concurrent avec page privatisation, formulaire dedie et capacite annoncee.',
    localisation: 'Nancy (54)',
    maturite: 'Comparaison',
    contexte: 'Anniversaire de sa mere, 15 personnes. A besoin de confirmer que le restaurant peut accueillir le groupe et de connaitre les conditions.',
    impression: 'La note et l\'emplacement sont parfaits. Mais sans information sur les groupes, elle ne peut pas proposer Brend\'oliv a sa famille sans avoir appelee — trop de friction pour une organisation deja complexe.',
    parcours: [
      ['Google Maps', '"restaurant vieille ville nancy groupe" — Brend\'oliv visible'],
      ['Site Zenchef', 'Cherche section privatisation ou groupes → rien'],
      ['Concurrent', '"Salle privatisable jusqu\'a 30 personnes, menu groupe a partir de 35€ par personne, formulaire dedie" → retient l\'adresse'],
    ] as [string, string][],
    questionCle: 'Pouvez-vous accueillir 15 personnes et privatiser une salle ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune information sur la capacite groupe, la privatisation ou les conditions.',
    impactVitesse: 'Tablette — non bloquant',
    impactConfiance: '4.5 sur 431 avis parfait pour un anniversaire — mais sans info groupe',
    positifs: ['Note 4.5 ideale pour un evenement', 'Emplacement vieille ville prestige'],
    frictions: ['Aucune page groupes/privatisation', 'Pas de capacite annoncee', 'Pas de formule groupe'],
    ceQuiFeraitBasculer: 'Une page ou section "Evenements & Groupes" : capacite (jusqu\'a X personnes), possibilite de privatisation, menu special groupe ou contact dedie. Sophie voulait venir — elle avait juste besoin de la confirmation que c\'etait possible.',
    exp: 5, conf: 8, clarte: 2,
  },
  {
    id: 5,
    name: 'Etienne',
    age: 38,
    emoji: '🖥️',
    situation: 'Compare 3 restaurants Grande Rue Nancy pour une sortie entre amis',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Reserve',
    histoire: '"restaurant grande rue nancy" → Brend\'oliv visible → 431 avis 4.5 → site → photos appétissantes → pas de carte texte mais l\'emplacement + la note decidient → reserve.',
    localisation: 'Nancy (54)',
    maturite: 'Comparaison',
    contexte: 'Sortie entre amis, emplacement central important. La note + la vieille ville font la difference dans la comparaison.',
    impression: 'Le site est basique mais la note et les photos donnent confiance. Pour une sortie entre amis, c\'est suffisant.',
    parcours: [
      ['Google Search', '"restaurant grande rue nancy"'],
      ['Site', '431 avis 4.5 + emplacement vieille ville — decidient'],
      ['Reservation', 'Reserve via Zenchef'],
    ] as [string, string][],
    questionCle: 'C\'est bien situe et bien note ?',
    reponse: 'Oui' as const,
    commentReponse: 'Note 4.5 + Grande Rue vieille ville = reponse positive.',
    impactVitesse: 'Desktop — non bloquant',
    impactConfiance: '431 avis 4.5 = confiance forte',
    positifs: ['Note 4.5 et volume solide', 'Emplacement Grande Rue premium', 'Reservation en ligne'],
    frictions: ['Pas de menu ni de prix — on ne sait pas ce qu\'on va manger ni combien ca coute'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 8, clarte: 4,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Site propre avec menu textuel + page privatisation',
    pourquoi: 'Sophie cherche "privatisation restaurant nancy" → rien chez Brend\'oliv. Un site propre (independant de Zenchef) avec : menu HTML textuel + prix, page "Terrasse & Evenements" avec capacite + formulaire dedie. La terrasse Grande Rue vieille ville = argument SEO fort pour "terrasse restaurant nancy vieille ville".',
    action: 'Site propre avec 4 pages : Accueil (menu du moment, terrasse, horaires), La Carte (HTML avec prix), Terrasse & Groupes (capacite, privatisation, formulaire), Contact. Schema.org Restaurant + AggregateRating (4.5, 431 avis).',
    impact: '1 visiteur sur 5 perdu sur la privatisation — segment anniversaire/groupes a fort potentiel',
  },
  {
    titre: 'Mettre en avant "Ouvert le dimanche midi" — rare a Nancy',
    pourquoi: 'Camille cherche "restaurant dimanche midi nancy" → Brend\'oliv n\'apparait pas. Tres peu de restaurants nancy sont ouverts le dimanche midi — c\'est un differenciateur fort et peu concurrence en SEO. Un titre hero "Restaurant traditionnel nancy — Ouvert le dimanche midi" + Schema.org OpeningHours = positionnement direct sur cette requete.',
    action: 'Badge "Ouvert dimanche midi" visible en hero. Title SEO optimise. Schema.org OpeningHours avec le dimanche. Une ligne dans la meta description : "Ouvert du lundi au samedi + dimanche midi".',
    impact: 'Requete "restaurant ouvert dimanche midi nancy" = peu concurrence, client motive',
  },
  {
    titre: 'Schema.org Restaurant + AggregateRating',
    pourquoi: '4.5 sur 431 avis non exploites en rich snippets. Zenchef ne genere pas de Schema.org localbusiness complet. Un Schema.org propre = etoiles dans les SERP Google pour 431 avis + horaires directement visibles dans les resultats.',
    action: 'Schema.org JSON-LD : @type Restaurant, name, address (141 Grande Rue), telephone, openingHours (avec dimanche midi), servesCuisine (cuisine francaise traditionnelle), aggregateRating (4.5, 431). Implementable sur un site propre.',
    impact: '+20-30% CTR estime sur les requetes restaurant nancy',
  },
];

const ameliorationsUtiles = [
  {
    titre: 'Autonomie Zenchef — reduire la dependance',
    detail: 'Zenchef prend une commission sur les reservations et peut modifier ses conditions ou sa visibilite. Un site propre avec formulaire de reservation Web3Forms = zero commission + donnees clients controlees. Zenchef peut rester en complementaire pour les canaux Zenchef.',
  },
  {
    titre: 'Photos terrasse dediees + mise en avant saison',
    detail: 'La terrasse Grande Rue est l\'argument #1 au printemps/ete. Une section dediee avec photos + "Terrasse ouverte d\'avril a octobre" = conversion saisonniere maximisee sur les recherches "terrasse nancy".',
  },
];

const ameliorationsDiscuter = [
  {
    emoji: '🍷',
    titre: 'Carte des vins + menu du moment regulierement mis a jour',
    detail: 'Un restaurant avec 431 avis qui change sa carte saisonniere a une opportunite de contenu frais regulier — signal fort pour Google et motif de re-visite pour les habitues.',
  },
];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Correct', ok: true, detail: 'Zenchef — ~55 mobile, LCP ~3.2s' },
  { label: 'Securite', verdict: 'Bon', ok: true, detail: 'HTTPS + HSTS — Zenchef gere' },
  { label: 'SEO local', verdict: 'Absent', ok: false, detail: 'Template Zenchef sans contenu local — invisible hors recherche de marque' },
  { label: 'Donnees structurees', verdict: 'Absent', ok: false, detail: 'Schema.org absent — 4.5 sur 431 avis non exploites en rich snippets' },
  { label: 'Partage reseaux', verdict: 'Correct', ok: true, detail: 'OG present (Zenchef genere)' },
];

const tech = {
  observatory: { grade: 'B-', score: 62, testsOk: 5, testsTotal: 10 },
  pagespdMobile: { performance: 55, accessibility: 80, bestPractices: 78, seo: 68 },
  pagespdDesktop: { performance: 75, accessibility: 85, bestPractices: 82, seo: 74 },
  cwv: { lcp: '~3.2s (Zenchef)', inp: '~220ms', cls: '~0.04' },
  headers: [
    { ok: true, h: 'HTTPS' },
    { ok: true, h: 'HSTS (Zenchef)' },
    { ok: false, h: 'Content-Security-Policy (partiel)' },
    { ok: true, h: 'X-Frame-Options' },
    { ok: false, h: 'Permissions-Policy (absent)' },
  ],
  schema: [
    { item: 'Schema.org Restaurant', ok: false },
    { item: 'NAP Nancy (nom, adresse, tel)', ok: false },
    { item: 'AggregateRating (4.5 / 431 avis)', ok: false },
    { item: 'OpeningHours (avec dimanche midi)', ok: false },
    { item: 'servesCuisine', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'Present (Zenchef)' },
    { item: 'og:description', ok: true, val: 'Present (Zenchef)' },
    { item: 'og:image', ok: true, val: 'Present' },
  ],
  seo: [
    { item: 'Title tag present', ok: true },
    { item: 'HTTPS', ok: true },
    { item: 'Responsive mobile', ok: true },
    { item: 'Menu textuel indexable', ok: false },
    { item: '"Ouvert dimanche midi" mis en avant SEO', ok: false },
    { item: 'Schema.org Restaurant + AggregateRating', ok: false },
    { item: 'Page groupes/privatisation', ok: false },
    { item: 'Page terrasse dediee', ok: false },
    { item: 'Pages longue traine locales', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-48 sm:w-56 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <div class="rounded-2xl p-6 mb-6" style="background: #fefce8; border: 1px solid #fbbf24;">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
      <div>
        <p class="font-semibold text-amber-900 mb-1">Brend'oliv est invisible sur la longue traine — malgre une terrasse et un dimanche midi differenciants</p>
        <p class="text-sm text-amber-800">Le template Zenchef genere zero contenu SEO local. "Restaurant ouvert dimanche midi nancy" et "terrasse vieille ville nancy" sont des requetes peu concurrencees que Brend'oliv devrait dominer — et sur lesquelles il est totalement absent.</p>
      </div>
    </div>
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche un restaurant a Nancy.</p>

    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group bg-white rounded-xl overflow-hidden shadow-sm border border-green-200">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
