const tech = {
  observatory: { grade: 'C-', score: 45, testsOk: 6, testsTotal: 10 },
  pagespdMobile: null, pagespdDesktop: null,
  cwv: { lcp: 'Non mesure (API throttlee)', inp: 'Non mesure', cls: 'Non mesure' },
  headers: [
    { ok: false, h: 'Content Security Policy (CSP) — ABSENT (-25 pts)' },
    { ok: false, h: 'X-Frame-Options — ABSENT (-20 pts)' },
    { ok: false, h: 'X-Content-Type-Options — ABSENT (-5 pts)' },
    { ok: false, h: 'Subresource Integrity (SRI) — ABSENT (-5 pts)' },
    { ok: true, h: 'HTTPS / HSTS precharge — OK' },
    { ok: true, h: 'CORS — Non applique (acceptable)' },
    { ok: true, h: 'Cookies — Aucun detecte' },
  ],
  schema: [
    { item: 'JSON-LD present (2 blocs)', ok: true },
    { item: '@type BarOrPub / Restaurant — coherent', ok: true },
    { item: 'name, url, description — presents', ok: true },
    { item: 'address + geo (lat/lon) — presents', ok: true },
    { item: 'telephone, openingHours — presents', ok: true },
    { item: 'aggregateRating 4.7/5 (196 avis) — present', ok: true },
    { item: 'founder (Niels + Pong) — present', ok: true },
    { item: 'servesCuisine (Thai + Belgian) — present', ok: true },
    { item: 'sameAs (Instagram) — probablement absent', ok: false },
    { item: 'image / logo — a verifier', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'Chill Beach Bar And Grill Koh Tao' },
    { item: 'og:description', ok: true, val: 'Present (en anglais sur /th/ — a corriger)' },
    { item: 'og:image', ok: true, val: 'https://chill-bar.pages.dev/images/og-image.jpg' },
    { item: 'og:url', ok: false, val: 'Pointe vers production — a mettre a jour en prod' },
    { item: 'og:type', ok: false, val: 'ABSENT — devrait etre "website"' },
    { item: 'twitter:card', ok: false, val: 'ABSENT' },
    { item: 'twitter:image', ok: false, val: 'ABSENT' },
  ],
  seo: [
    { item: 'H1 unique en thaï — OK', ok: true },
    { item: 'Hierarchie H2s coherente — OK', ok: true },
    { item: 'robots.txt accessible + IA autorisees (GPTBot, ClaudeBot...)', ok: true },
    { item: 'sitemap-index.xml present (16 URLs x 4 langues)', ok: true },
    { item: 'HTTPS + redirection HTTP', ok: true },
    { item: 'meta description de /th/ en anglais (pas en thaï)', ok: false },
    { item: 'og:type manquant', ok: false },
    { item: 'twitter:card manquant', ok: false },
    { item: '4 headers securite manquants', ok: false },
  ],
};

function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200';
  if (d === 'Hesite') return 'border-amber-200';
  return 'border-neutral-200';
}
function decisionBadge(d: string) {
  if (d === 'Convertit') return 'bg-green-600';
  if (d === 'Hesite') return 'bg-amber-500';
  return 'bg-neutral-400';
}

const accentColor = '#E86C47';
const accentGradient = 'linear-gradient(135deg, #E86C47, #D4572F)';
---

<BaseLayout title={title} description={description} noindex={true} lang="fr" frPath={`/echo/${slug}/th`}>

  <!-- HERO -->
  <section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
    <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style={`background: ${accentColor}; opacity: 0.06;`}></div>
    <div class="absolute bottom-[10%] right-[5%] w-[300px] h-[300px] rounded-full blur-[120px] pointer-events-none" style="background: #3b82f6; opacity: 0.04;"></div>
    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">{formuleLabel} &middot; Rapport confidentiel &middot; Version TH</div>
      <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
      <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">Site analyse : <a href={urlSite} target="_blank" rel="noopener" class="underline hover:text-white transition-colors">{urlSite}</a> &middot; {kpis.nbPersonas} visiteurs thaïlandais simules &middot; {dateAudit}</p>
      <div class="grid grid-cols-3 gap-4">
        <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);"><div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div><div class="text-sm text-green-400/70">vous contactent</div></div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);"><div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div><div class="text-sm text-amber-400/70">hesitent</div></div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);"><div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div><div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div></div>
      </div>
    </div>
  </section>

  <!-- CONSTAT + CANAUX -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style={`background: rgba(232,108,71,0.04); border-color: ${accentColor};`}>
      <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
    </div>
    <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs thaïs</h2>
    <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
    <div class="space-y-4 mb-12">
      {canalData.map(c => {
        const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
        return (<div class="flex items-center gap-4"><div class="w-52 text-sm text-neutral-700 shrink-0">{c.canal}</div><div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden"><div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div></div><div class="w-20 text-right"><span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span><span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span></div></div>);
      })}
    </div>
    <details class="group"><summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2"><svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>Voir les scores moyens</summary>
      <div class="grid grid-cols-3 gap-4 mt-3">
        {[{ label: 'Experience', val: kpis.experience },{ label: 'Confiance', val: kpis.confiance },{ label: 'Clarte', val: kpis.clarte }].map(s => {
          const sColor = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
          return (<div class="bg-white border border-neutral-200 rounded-xl p-4 text-center"><div class={`text-2xl font-bold mb-1 ${sColor}`}>{s.val}<span class="text-sm text-neutral-400">/10</span></div><div class="text-xs text-neutral-500">{s.label}</div></div>);
        })}
      </div>
    </details>
  </section>

  <!-- ALERTES -->
  <section class="py-12" style="background: #fefce8;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
        <div><h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2><p class="text-sm text-neutral-600">{alertes.filter(a => a.type === 'critique').length} critiques &middot; {alertes.filter(a => a.type === 'important').length} importants</p></div>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        {alertes.map(a => (
          <div class={`bg-white rounded-xl p-5 ${a.type === 'critique' ? 'border-2 border-red-300' : 'border border-amber-300'}`}>
            <div class={`inline-block text-2xl font-black px-3 py-1 rounded-lg mb-3 ${a.type === 'critique' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>{a.chiffre}</div>
            <p class="text-[10px] text-neutral-400 uppercase tracking-wider mb-1">{a.chiffreLabel}</p>
            <h3 class="font-semibold text-neutral-900 text-sm mb-2">{a.titre}</h3>
            <p class="text-xs text-neutral-600 leading-relaxed">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VOS VISITEURS -->
  <section class="py-16" style="background: #fafafa;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs thaïlandais</h2>
      <p class="text-neutral-600 mb-8">Voici ce qui se passe quand un Thaï cherche un bar sur Koh Tao et tombe sur votre version thaïe.</p>

      {(['Convertit', 'Hesite', 'Quitte'] as const).map(decision => {
        const filtered = personas.filter(p => p.decision === decision);
        const labelMap = { Convertit: 'Ceux qui vous contactent', Hesite: 'Ceux qui hesitent', Quitte: 'Ceux qui repartent' };
        const colorMap = {
          Convertit: { dot: 'bg-green-500', text: 'text-green-800', sub: 'text-green-600' },
          Hesite: { dot: 'bg-amber-500', text: 'text-amber-800', sub: 'text-amber-600' },
          Quitte: { dot: 'bg-neutral-400', text: 'text-neutral-600', sub: 'text-neutral-500' }
        };
        const c = colorMap[decision];
        return (
          <div class="mb-10">
            <h3 class={`text-base font-bold ${c.text} mb-4 flex items-center gap-2`}>
              <span class={`w-2.5 h-2.5 rounded-full ${c.dot} inline-block`}></span>
              {labelMap[decision]}
              <span class={`text-sm font-normal ${c.sub}`}>({filtered.length})</span>
            </h3>
            <div class="space-y-3">
              {filtered.map(p => (
                <details class={`group bg-white rounded-xl overflow-hidden shadow-sm border ${decisionBorder(p.decision)}`}>
                  <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                        <span class={`text-[10px] ${decisionBadge(p.decision)} text-white px-1.5 py-0.5 rounded font-medium`}>{p.decisionLabel}</span>
                      </div>
                      <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                      <div class="flex flex-wrap items-center gap-1.5">
                        <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                        <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                        <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                      </div>
                    </div>
                    <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                  </summary>
                  <div class={`px-4 pb-5 border-t ${decisionBorder(p.decision)}`}>
                    <div class="grid gap-4 text-xs mt-4">
                      <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                      <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                      <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p><ol class="list-decimal list-inside space-y-1.5 text-neutral-600">{p.parcours.map(([section, reaction]) => (<li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>))}</ol></div>
                      <div class="bg-neutral-50 rounded-lg p-3"><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p><p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p><p class="text-neutral-600">Le site repond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p></div>
                      <div class="grid grid-cols-2 gap-4">
                        <div><p class="font-semibold text-green-700 mb-1.5">Points positifs</p><ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul></div>
                        <div><p class="font-semibold text-amber-700 mb-1.5">Frictions</p><ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul></div>
                      </div>
                      {p.ceQuiFeraitBasculer && <div class="bg-amber-50 rounded-lg p-3"><p class="font-semibold text-amber-700 text-[10px] uppercase tracking-wider mb-1">{p.decision === 'Hesite' ? 'Ce qui le ferait passer a l\'action' : 'Ce qui l\'aurait retenu'}</p><p class="text-neutral-700 text-xs">{p.ceQuiFeraitBasculer}</p></div>}
                      <div class="flex gap-6 pt-3 border-t border-neutral-100">{[{ label: 'Experience', val: p.exp },{ label: 'Confiance', val: p.conf },{ label: 'Clarte', val: p.clarte }].map(s => { const sc = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500'; return (<div class="text-center"><span class={`block text-lg font-bold ${sc}`}>{s.val}</span><span class="text-[10px] text-neutral-400">{s.label}</span></div>);})}</div>
                    </div>
                  </div>
                </details>
              ))}
            </div>
            {decision === 'Hesite' && (
              <div class="rounded-xl p-5 mt-4 bg-amber-50 border border-amber-200 flex items-start gap-3">
                <span class="text-lg shrink-0 mt-0.5">💡</span>
                <div><p class="text-sm font-medium text-amber-900">Ces {kpis.nbHesitent} visiteurs ont besoin de vos services.</p><p class="text-xs text-amber-700 mt-1">Il leur manque un element de rassurance — souvent une photo d'ambiance ou le prix du Happy Hour bien visible. C'est votre plus gros levier de croissance sur le public thaï.</p></div>
              </div>
            )}
            {decision === 'Quitte' && (
              <div class="rounded-xl p-5 mt-4 bg-neutral-100 border border-neutral-200 flex items-start gap-3">
                <span class="text-lg shrink-0 mt-0.5">📉</span>
                <div><p class="text-sm font-medium text-neutral-800">Certains etaient hors cible — c'est normal.</p><p class="text-xs text-neutral-600 mt-1">Khun Sombat (pecheur, ne boit pas), le lyceen de 17 ans et la veille concurrentielle ne sont pas votre public. Ils ne generent pas de perte de chiffre d'affaires.</p></div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <!-- RECOMMANDATIONS -->
