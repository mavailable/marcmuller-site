      </details>

      <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
        <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
          <div class="flex items-center gap-3"><span class="text-base">&#128200;</span><div><h3 class="font-semibold text-neutral-900 text-sm">Open Graph (partage reseaux sociaux)</h3><p class="text-[11px] text-neutral-500">{techVerdicts[4].detail}</p></div></div>
