const ameliorationsUtiles = [
  { titre: 'Expliquer le concept "bieres belges" en thaï pour les non-connaisseurs', detail: 'Khun Wichai (62 ans) et Khun Preecha (55 ans) ne connaissent pas forcement Duvel ou Tripel Karmeliet. 2-3 phrases dans la section bieres : "เบียร์เบลเยียมคืออะไร?" + une description courte du style pour chaque biere. Aide aussi les touristes asiatiques non-anglophones.' },
  { titre: 'Completer la liste des bieres (viser 10-15 sur les 20+)', detail: 'Mint (barmaid) et Ploy (bartender) sont frustrées par la promesse "20+" avec seulement 5 listees. Ces profils professionnels ont une forte influence sur leur entourage. Lister minimum 10 bieres avec style, ABV et prix = moins de WhatsApp "qu\'est-ce que vous avez ce soir ?".' },
  { titre: 'Ajouter une note de reservation pour occasions speciales', detail: 'Wan (lune de miel) et Khun Lek (manager resort) cherchent la procedure de reservation. Une simple note dans la section "Trouver nous" : "Reservation pour un groupe ou occasion speciale ? WhatsApp." Pas besoin d\'un vrai systeme.' },
  { titre: 'Mentionner si le WiFi est disponible', detail: 'Krit (digital nomad) cherche l\'info WiFi. Une ligne dans "A propos" ou "Trouver nous" regle la question pour les nomades digitaux de plus en plus nombreux a Koh Tao.' },
];

const ameliorationsDiscuter = [
  { emoji: '💳', titre: 'PromptPay / QR Code paiement mobile', detail: '"Cash recommande pour garantir la biere froide" est confus pour les Thaïs habitues aux QR codes PromptPay (usage massif). Si vous acceptez le QR, le mentionner. Si cash only, expliquer pourquoi (generator, refrigeration) pour que ca ne semble pas suspect.' },
  { emoji: '💬', titre: 'Ajouter un lien LINE OA', detail: 'LINE est la messagerie dominante en Thaïlande (95% utilisateurs). WhatsApp est surtout pour les touristes etrangers. Un LINE Official Account avec QR code permettrait aux locaux de contacter le bar via leur app habituelle.' },
  { emoji: '⭐', titre: 'Encourager les avis en thaï sur Google', detail: 'Les 196 avis sont majoritairement en langues etrangeres. Les clients thaïs qui cherchent sur Maps voient peu d\'avis dans leur langue. Un QR code au bar ou un message WhatsApp de remerciement peut changer ca.' },
];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Non mesure', ok: false, detail: 'API PageSpeed indisponible — estimation : bon (Astro v5 statique sur Cloudflare Pages)' },
  { label: 'Securite', verdict: 'C- (45/100)', ok: false, detail: '4 headers manquants : CSP, X-Frame-Options, X-Content-Type-Options, SRI' },
  { label: 'SEO', verdict: 'Bon', ok: true, detail: 'Schema.org complet, H1 unique en thaï, robots.txt correct avec IA autorisees' },
