        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {ameliorationsDiscuter.map((a) => (
            <div class="rounded-xl p-5" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
              <div class="text-xl mb-2">{a.emoji}</div>
              <h4 class="font-medium text-white mb-2 text-sm">{a.titre}</h4>
              <p class="text-xs" style="color:rgba(255,255,255,0.5);">{a.detail}</p>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

