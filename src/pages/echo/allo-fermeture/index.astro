  { label: 'Vitesse', verdict: 'Faible', ok: false, detail: 'WordPress + Divi — ~40 mobile, LCP ~4.2s' },
  { label: 'Securite', verdict: 'Bon', ok: true, detail: 'HTTPS + HSTS — grade B estime' },
  { label: 'SEO', verdict: 'Faible', ok: false, detail: 'MaPrimeRenov/CEE non adresses — requetes les plus fortes du secteur' },
