---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'allo-fermeture';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const isProspection = true;
const nomProspect = 'Allo Fermeture Vandoeuvre';
const urlSite = 'https://www.allo-fermeture.fr';
const dateAudit = '31 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 3,
  nbHesitent: 1,
  nbRepartent: 1,
  conversion: 60,
  experience: 6.5,
  confiance: 9.0,
  clarte: 4.8,
};

const verdictHero = 'Sur 5 visiteurs, 3 convertissent — le RGE Qualibat + la note 4.7 sur 322 avis decidient les proprietaires serieux. Marie-France voulait juste demander un devis pour une porte : trop de champs dans le formulaire, elle est partie chez le concurrent qui proposait "devis en 3 clics". Thomas cherchait MaPrimeRenov + RGE : sans page dediee aux aides, il a compare avec un concurrent qui avait un simulateur d\'economies.';

const constat = 'Allo Fermeture possede les deux atouts essentiels du secteur menuiserie renovation : le label RGE Qualibat (eligibilite aux aides financieres MaPrimeRenov, CEE) et une note 4.7 sur 322 avis. Ces deux elements convertissent les decideurs serieux. Mais le formulaire de devis complexe fait partir les comparateurs initiaux, et l\'absence de page dediee MaPrimeRenov manque l\'argument de vente le plus fort du marche en 2026.';

const canalData = [
  { canal: 'Google Search (volets urgence)', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille (fenetres)', nb: 1, convert: 1, rate: 100 },
  { canal: 'IA (RGE MaPrimeRenov)', nb: 1, convert: 0, rate: 0 },
