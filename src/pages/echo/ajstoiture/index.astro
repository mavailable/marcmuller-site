                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-amber-200">
              <div class="grid gap-4 text-xs mt-4">
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p>
                  <p class="text-neutral-600">{p.contexte}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p>
                  <p class="text-neutral-600">{p.impression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                  <p class="text-neutral-600">Le site repond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <p class="font-semibold text-green-700 mb-1.5">Points positifs</p>
                    <ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul>
                  </div>
                  <div>
                    <p class="font-semibold text-amber-700 mb-1.5">Frictions</p>
                    <ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul>
                  </div>
                </div>
                <div class="bg-primary-50 rounded-lg p-3">
                  <p class="font-semibold text-primary-700 text-[10px] uppercase tracking-wider mb-1">Ce qui le ferait passer a l'action</p>
                  <p class="text-primary-800">{p.ceQuiFeraitBasculer}</p>
                </div>
                <div class="flex gap-6 pt-3 border-t border-neutral-100">
                  {[
                    { label: 'Experience', val: p.exp },
                    { label: 'Confiance', val: p.conf },
                    { label: 'Clarte', val: p.clarte },
                  ].map(s => {
                    const sColor = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
                    return (
                      <div class="text-center">
                        <span class={`block text-lg font-bold ${sColor}`}>{s.val}</span>
                        <span class="text-[10px] text-neutral-400">{s.label}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
    <div class="rounded-xl p-5 mb-10 bg-amber-50 border border-amber-200 flex items-start gap-3">
      <span class="text-lg shrink-0 mt-0.5">&#128161;</span>
      <div>
        <p class="text-sm font-medium text-amber-900">Ces {kpis.nbHesitent} visiteurs ont besoin de vos services.</p>
        <p class="text-xs text-amber-700 mt-1">Il leur manque un element de rassurance pour passer a l'action. C'est votre plus gros levier de croissance.</p>
      </div>
    </div>

    <!-- Repartent -->
    <div class="mb-4">
      <h3 class="text-base font-bold text-neutral-600 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-neutral-400 inline-block"></span>
        Ceux qui repartent
        <span class="text-sm font-normal text-neutral-500">({kpis.nbRepartent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Quitte').map(p => (
          <details class="group persona-card bg-white rounded-xl overflow-hidden shadow-sm border border-neutral-200">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
