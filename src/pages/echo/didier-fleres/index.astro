---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'didier-fleres';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Didier Fleres';
const urlSite = 'https://www.didierfleres.com';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 88 76 66 48';
const marcTelLink = 'tel:+33688766648';
const marcWhatsApp = 'https://wa.me/33688766648?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.0,
  confiance: 5.2,
  clarte: 5.4,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'Didier Fleres a de vrais atouts : 25 ans d\'ancience a Metz, Artisan Reference MAAF 2025, partenaire Chappee, presence active sur 5 reseaux. Mais le site ne montre rien de concret. Pas une seule photo de chantier, pas un seul temoignage client, pas un seul tarif. Les visiteurs en phase Comparaison cherchent une preuve avant d\'envoyer leur devis — ils ne la trouvent pas et contactent un concurrent mieux documente.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Sandra',
    age: 41,
    emoji: '🚨',
    situation: 'Proprietaire a Yutz, fuite sous l\'evier depuis ce matin',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence fuite. Elle cherche "plombier urgence Moselle". La zone Yutz est confirmee dans la description. Elle trouve le numero et appelle directement sans lire le site.',
    localisation: 'Yutz (57970)',
    maturite: 'Decision',
    contexte: 'Elle a une fuite sous l\'evier depuis ce matin. Elle cherche une intervention aujourd\'hui, peu importe le prix.',
    impression: '"25 ans d\'experience" rassure. Elle cherche le numero immediatement.',
    parcours: [
      ['Accueil', 'Confirme secteur plomberie + zone Moselle'],
      ['Header', 'Repere le 06 76 18 29 56'],
      ['Appel', 'Decision prise — le numero suffit'],
    ] as [string, string][],
    questionCle: 'Il intervient aujourd\'hui ? Il couvre Yutz ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'La zone Yutz est dans la liste mais aucun CTA "Urgence" en hero, pas d\'horaires affiches.',
    impactVitesse: 'Site lent sur mobile — risque de perdre un visiteur urgent avant chargement complet.',
    impactConfiance: 'Email Gmail visible mais elle ne le regarde pas en urgence.',
    positifs: ['Zone Yutz confirmee dans la description', 'Numero de telephone present', '25 ans d\'experience rassure'],
    frictions: ['Aucun CTA urgence ou intervention rapide', 'Pas d\'horaires d\'ouverture', 'Site lent sur mobile'],
    ceQuiFeraitBasculer: '',
    exp: 5, conf: 6, clarte: 5,
  },
  {
    id: 2,
    name: 'Patrick',
    age: 58,
    emoji: '🔥',
    situation: 'Proprietaire a Metz, remplacement chaudiere condensation recommande par un voisin',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Son voisin a cite Didier Fleres. Il tape le nom sur Google pour confirmer et trouver le contact. Identite confirmee, service "chaudieres a condensation" visible, il envoie un message.',
    localisation: 'Metz (57070)',
    maturite: 'Decision',
    contexte: 'Sa chaudiere a 12 ans et tombe en panne regulierement. Son voisin lui a recommande Didier. Il veut juste confirmer et prendre contact.',
    impression: '"DIDIER FLERES Chauffage Sanitaire" — c\'est bien lui. Nom confirme.',
    parcours: [
      ['Accueil', 'Identite confirmee, "25 ans d\'experience" rassurant'],
      ['Services', '"Chaudieres a condensation" — exactement ce qu\'il cherche'],
      ['Contact', 'Envoie un message ou appelle'],
    ] as [string, string][],
    questionCle: 'C\'est bien lui ? Il fait les chaudieres a condensation ?',
    reponse: 'Oui' as const,
    commentReponse: 'Identite claire, service confirme, contact accessible.',
    impactVitesse: 'Correct sur desktop — pas de friction.',
    impactConfiance: 'La recommandation du voisin pese plus que tout. Email Gmail note mais non bloquant.',
    positifs: ['Identite clairement affichee', 'Service chaudiere confirme', 'Partenaire Chappee (marque connue)', '25 ans d\'experience'],
    frictions: ['Email Gmail — signal d\'amateurisme leger', 'Pas de certifications RGE visibles', 'Pas de delai de reponse precise'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 7, clarte: 7,
  },
  {
    id: 3,
    name: 'Lucie',
    age: 34,
    emoji: '🛁',
    situation: 'Proprietaire a Montigny-les-Metz, projet renovation salle de bain (budget ~8000€)',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle compare 3 plombiers depuis Google Maps. Elle veut voir des realisations de salles de bain avant de choisir. Aucune photo sur le site — elle envoie son devis au concurrent qui lui en a montre.',
    localisation: 'Montigny-les-Metz (57158)',
    maturite: 'Comparaison',
    contexte: 'Elle refait sa salle de bain. Elle a trouve Didier Fleres sur Google Maps. Elle compare la qualite visuelle des realisations avant de contacter.',
    impression: 'Page d\'accueil correcte mais pas de photos. Elle cherche "realisations" dans le menu.',
    parcours: [
      ['Accueil mobile', 'Liste de services — OK. Cherche galerie ou realisations.'],
      ['Navigation', 'Aucune page Realisations dans le menu'],
      ['Services', '"Sanitaire et salles de bains" confirme — mais toujours zero photo'],
      ['Contact', 'Hesite — envoie le devis au concurrent avec photos'],
    ] as [string, string][],
    questionCle: 'Il fait les salles de bain ? C\'est dans quel budget ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le service est liste mais aucune photo, aucun exemple, aucune fourchette de prix.',
    impactVitesse: 'Site lent sur mobile — frustration pendant la navigation.',
    impactConfiance: 'Email Gmail leplombierdemetz@ = signal d\'amateurisme vs concurrents avec email pro.',
    positifs: ['Service sanitaire/salle de bain confirme', 'Zone confirmee', '25 ans d\'experience'],
    frictions: ['Aucune photo de realisation', 'Pas de prix ni fourchette indicative', 'Email Gmail', 'Site lent sur mobile'],
    ceQuiFeraitBasculer: '5-8 photos de salles de bains renovees avec type de travaux et ville. Une fourchette "a partir de X€".',
    exp: 4, conf: 4, clarte: 5,
  },
  {
    id: 4,
    name: 'Thierry',
    age: 47,
    emoji: '🌡️',
    situation: 'Proprietaire a Bouzonville, projet pompe a chaleur air/eau avec MaPrimeRenov\'',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Il cherche un installateur certifie RGE pour beneficier des aides MaPrimeRenov\'. Le service PAC est present sur le site mais aucune certification RGE, aucune mention des aides. Il prefere le concurrent qui affiche clairement RGE.',
    localisation: 'Bouzonville (57220)',
    maturite: 'Comparaison',
    contexte: 'Il veut remplacer sa chaudiere par une PAC air/eau. Il compare des installateurs certifies RGE pour les aides MaPrimeRenov\'.',
    impression: '"Climatisation et pompes a chaleur" — le service est la. Cherche la certification RGE.',
    parcours: [
      ['Accueil', '"Artisan Reference MAAF" — ce n\'est pas RGE, c\'est une distinction assurance'],
      ['Services', '"Climatisation et pompes a chaleur" confirme — mais pas de marques, pas de certifs'],
      ['Bas de page', '"Partenaire Chappee" — chaudieres gaz. Cherche RGE partout, ne trouve pas'],
      ['Contact', 'Envoie quand meme un devis, mais compare avec un concurrent clairement RGE'],
    ] as [string, string][],
    questionCle: 'Il est certifie RGE ? Il aide pour MaPrimeRenov\' ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune mention RGE, aucune aide, aucune certification environnementale visible.',
    impactVitesse: 'Correct sur desktop.',
    impactConfiance: 'Grade F Observatory et email Gmail renforcent le doute.',
    positifs: ['Service PAC mentionne', 'Zone Bouzonville dans la liste', '25 ans d\'experience'],
    frictions: ['Aucune certification RGE visible', 'Aucune mention MaPrimeRenov\' / CEE', 'Pas de marques installees (Daikin, Atlantic...)', 'Email Gmail'],
    ceQuiFeraitBasculer: 'Un badge "Certifie RGE" et "Accompagnement MaPrimeRenov\' inclus dans votre devis".',
    exp: 5, conf: 4, clarte: 5,
  },
  {
    id: 5,
    name: 'Maxime',
    age: 29,
    emoji: '📱',
    situation: 'Locataire a Metz, decouvre Didier Fleres via TikTok — pas decideur',
    canal: 'Reseaux sociaux',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Il a vu une video TikTok sur le desembouage. Il clique par curiosite. Pas de prix, pas de CTA adapte, il est locataire donc pas decideur. Il quitte sans transmettre l\'info a son proprietaire.',
    localisation: 'Metz (57000)',
    maturite: 'Decouverte',
    contexte: 'Il est locataire. Il a vu une video desembouage sur TikTok et clique par curiosite. Il voudrait potentiellement transmettre l\'info a son proprietaire.',
    impression: 'Site artisan classique. Contenu desembouage detaille — pedagogique. Mais pas de prix.',
    parcours: [
      ['Accueil', 'Site charge. Clique sur "desembouage" dans le menu.'],
      ['Page desembouage', 'Contenu technique bien fait — camera thermique, produits Sentinel'],
      ['Cherche tarif', 'Aucun prix. Impossible de transmettre une info utile a son proprio.'],
      ['Quitte', 'Pas de prix = pas de message a faire passer'],
    ] as [string, string][],
    questionCle: 'Ca coute combien ? Je peux transmettre ca a mon proprio.',
    reponse: 'Non' as const,
    commentReponse: 'Aucun prix, aucune fourchette, aucun "devis gratuit en 24h" rassurant.',
    impactVitesse: 'Site lent sur mobile — scrolle lentement.',
    impactConfiance: 'Hors cible — pas decideur, donc la confiance n\'est pas le frein principal.',
    positifs: ['Contenu desembouage detaille et pedagogique', 'Presence TikTok coherente', 'Zone bien expliquee'],
    frictions: ['Aucun prix ni fourchette', 'Pas de CTA "transmettre a mon proprio"', 'Pas de numero facilement copiable'],
    ceQuiFeraitBasculer: 'C\'est hors cible — locataire non decideur. Un prix indicatif aurait pu l\'inciter a partager l\'URL.',
    exp: 4, conf: 5, clarte: 5,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Ajouter 5 photos de chantiers termines sur la page d\'accueil',
    pourquoi: '3 visiteurs sur 5 ont cherche des preuves visuelles sans les trouver. La plomberie et le chauffage sont des metiers invisibles une fois termines — le client ne peut pas evaluer la qualite autrement que par les photos. Lucie (projet salle de bain) et Thierry (projet PAC) ont prefere un concurrent qui montrait son travail.',
    action: 'Integrer une section "Mes dernieres realisations" sur la page d\'accueil : 5 a 8 photos de chantiers termines (salle de bain, chaudiere, PAC, desembouage). Format : photo + type de travaux + ville. Les photos sont probablement deja sur Instagram ou TikTok — il suffit de les integrer au site.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A verifier', ok: false, detail: 'Quota API epuise — WordPress + GTM + Didomi = lenteur estimee ~50/100 mobile.' },
  { label: 'Securite', verdict: 'Mauvais — F', ok: false, detail: 'Grade F Observatory. 6 headers de securite manquants.' },
  { label: 'SEO', verdict: 'Basique', ok: false, detail: 'H1 axe anciennete, pas sur les requetes cibles. Schema.org type trop generique.' },
  { label: 'Donnees structurees', verdict: 'Incomplet', ok: false, detail: 'Schema.org present (All in One SEO) mais type Organization au lieu de Plumber.' },
  { label: 'Partage reseaux', verdict: 'Partiel', ok: false, detail: 'og:title et og:description presents. og:image non confirme.' },
];

const tech = {
  observatory: { grade: 'F', score: 20, testsOk: 4, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible (quota API)', inp: 'Non disponible (quota API)', cls: 'Non disponible (quota API)' },
  headers: [
    { ok: true, h: 'Redirection HTTP vers HTTPS' },
    { ok: true, h: 'Cookies conformes' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (absent)' },
    { ok: false, h: 'Content-Security-Policy (absent)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking)' },
    { ok: false, h: 'X-Content-Type-Options (absent)' },
    { ok: false, h: 'Referrer-Policy (absent)' },
    { ok: false, h: 'Permissions-Policy (absent)' },
  ],
  schema: [
    { item: 'JSON-LD / Schema.org present', ok: true },
    { item: '@type Plumber ou LocalBusiness (utilise Organization)', ok: false },
    { item: 'name, url, description', ok: true },
    { item: 'address complete + geo', ok: false },
    { item: 'telephone dans le schema', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'aggregateRating (avis integres)', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'Didier Fleres- Chauffagiste Sanitaire desembouage- Metz 57' },
    { item: 'og:description', ok: true, val: 'Installation et depannage chauffage, sanitaire...' },
    { item: 'og:url', ok: true, val: 'https://www.didierfleres.com/' },
    { item: 'og:type', ok: true, val: 'website' },
    { item: 'og:image', ok: false, val: 'Non confirme (probablement absent)' },
    { item: 'twitter:card', ok: false, val: 'Non confirme' },
  ],
  seo: [
    { item: 'H1 unique present', ok: true },
    { item: 'Meta title optimise avec zone geographique', ok: true },
    { item: 'Meta description avec zone geographique', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'robots.txt accessible', ok: true },
    { item: 'sitemap.xml accessible (8 sous-sitemaps)', ok: true },
    { item: 'H1 oriente requete (plombier Metz vs "25 ans d\'experience")', ok: false },
    { item: 'Schema.org type Plumber/LocalBusiness', ok: false },
    { item: 'Certifications RGE mentionnees', ok: false },
    { item: 'Open Graph image configuree', ok: false },
  ],
};

const alertes: { type: 'critique' | 'important'; titre: string; detail: string; chiffre: string; chiffreLabel: string }[] = [
  { type: 'critique' as const, titre: 'Grade securite F', detail: 'Mozilla Observatory donne un grade F — headers de securite totalement absents. Risque clickjacking, XSS, interception de donnees de contact.', chiffre: 'F', chiffreLabel: 'grade securite Mozilla Observatory' },
  { type: 'important' as const, titre: 'Aucune photo de realisation', detail: '3 visiteurs sur 5 ont cherche des photos de chantiers termines et ne les ont pas trouvees. Lucie et Thierry ont prefere un concurrent qui montrait son travail.', chiffre: '3/5', chiffreLabel: 'personas bloques par l\'absence de photos' },
  { type: 'important' as const, titre: 'Email Gmail = signal amateurisme', detail: 'Un email @gmail.com sur un site professionnel fait douter du serieux. 3 personas l\'ont note comme friction. Un email pro en @domaine.fr couterait moins de 5€/mois.', chiffre: '3/5', chiffreLabel: 'personas bloques par l\'email Gmail' },
  { type: 'important' as const, titre: 'Certifications RGE invisibles', detail: '2 personas en phase Comparaison cherchent les certifications RGE pour acceder aux aides MaPrimeRenov. Absentes = clients perdus au profit d\'un concurrent certifie visible.', chiffre: '2/5', chiffreLabel: 'personas cherchent les certifications RGE' },
];
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 2b. ALERTES -->
{alertes.length > 0 && (
  <section style="background: #fefce8;" class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <div>
          <h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2>
          <p class="text-sm text-neutral-600">
            {alertes.filter(a => a.type === 'critique').length > 0 && <span class="text-red-700 font-medium">{alertes.filter(a => a.type === 'critique').length} critique{alertes.filter(a => a.type === 'critique').length > 1 ? 's' : ''}</span>}
            {alertes.filter(a => a.type === 'critique').length > 0 && alertes.filter(a => a.type === 'important').length > 0 && <span class="mx-1 text-neutral-400">·</span>}
            {alertes.filter(a => a.type === 'important').length > 0 && <span class="text-amber-700 font-medium">{alertes.filter(a => a.type === 'important').length} important{alertes.filter(a => a.type === 'important').length > 1 ? 's' : ''}</span>}
          </p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {alertes.map(a => (
          <div class={`bg-white rounded-xl p-5 ${a.type === 'critique' ? 'border-2 border-red-300' : 'border border-amber-200'}`}>
            <div class="flex items-start gap-4">
