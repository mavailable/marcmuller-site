---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'start-etude';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Start Etude';
const urlSite = 'https://startetude.fr';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.4,
  confiance: 5.6,
  clarte: 5.0,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'Start Etude a des atouts reels : 238 avis Google "Excellent", 11 ans d\'experience, disponibilite 24h/24, zone Thionville/Yutz bien couverte. Mais 238 avis clients n\'apparaissent pas dans Google — le Schema.org est incomplet (aggregateRating absent). Les etoiles qui rassurent les visiteurs sont visibles sur Maps, pas dans les resultats de recherche. Et sur mobile, le site WordPress Hostinger est probablement lent — ce qui fait partir les appels d\'urgence vers un concurrent plus rapide.';

const canalData = [
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Bouche-a-oreille', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Hamid',
    age: 45,
    emoji: '🚨',
    situation: 'Locataire a Thionville, fuite sous-evier un samedi soir',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence fuite. Il tape "plombier urgence Thionville". Trouve Start Etude, voit "24H/24 7J/7" en hero. Il appelle directement sans lire plus loin.',
    localisation: 'Thionville (57100)',
    maturite: 'Decision',
    contexte: 'Il a une fuite sous son evier depuis 30 minutes, eau qui coule. Il cherche un numero a appeler maintenant.',
    impression: '"Plombier & Chauffagiste — Intervention 24H/24 7J/7" — exactement ce qu\'il cherche. Il cherche le numero.',
    parcours: [
      ['Accueil mobile', 'Voit "24H/24 7J/7" — OK, cherche le telephone'],
      ['Header', 'Trouve "07.61.66.74.04" — appelle directement'],
    ] as [string, string][],
    questionCle: 'Ils viennent maintenant, ce soir ?',
    reponse: 'Oui' as const,
    commentReponse: '"Intervention 24H/24 7J/7" repond directement a sa question urgente.',
    impactVitesse: 'Si le site met 4+ secondes a charger sur mobile, il appelle le numero suivant dans Google.',
    impactConfiance: '238 avis "Excellent" sur Google Maps rassurent — mais ces etoiles n\'apparaissent pas dans les SERPs.',
    positifs: ['Disponibilite 24h/24 tres visible', 'Telephone dans le header', 'Zone Thionville confirmee'],
    frictions: ['Chargement mobile probablement lent (WordPress Hostinger)', 'Pas de CTA "Urgence" dedie avec delai d\'intervention'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 7, clarte: 7,
  },
  {
    id: 2,
    name: 'Nathalie',
    age: 51,
    emoji: '🔥',
    situation: 'Proprietaire a Yutz, recherche remplacement chaudiere',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Elle cherche un chauffagiste sur Google Maps. Voit Start Etude avec 238 avis "Excellent". Clique sur le site pour confirmer les services et le numero, puis appelle.',
    localisation: 'Yutz (57970)',
    maturite: 'Decision',
    contexte: 'Sa chaudiere a 15 ans, elle veut un devis remplacement. Elle connait deja Start Etude via Maps, le site est une validation.',
    impression: 'Site propre, services bien listes. Elle confirme "chauffage" et prend le numero.',
    parcours: [
      ['Fiche Google Maps', 'Voit 238 avis "Excellent" — credibilite maximale'],
      ['Accueil', 'Confirme les services chauffage — OK'],
      ['Header', 'Prend le telephone et appelle'],
    ] as [string, string][],
    questionCle: 'Ils font le remplacement de chaudiere ? Je peux avoir un devis ?',
    reponse: 'Oui' as const,
    commentReponse: '"Chauffage — Installation de Systemes de Chauffage" est liste clairement.',
    impactVitesse: 'Acceptable — elle vient depuis Maps deja convaincue.',
    impactConfiance: 'Les 238 avis Maps font toute la difference pour ce profil.',
    positifs: ['238 avis Google tres visibles sur la fiche Maps', 'Services chauffage clairement listes', 'Formulaire de devis disponible'],
    frictions: ['Les etoiles Google ne s\'affichent pas dans les SERPs (aggregateRating absent)', 'Pas de tarif indicatif pour orienter la demande'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 8, clarte: 7,
  },
  {
    id: 3,
    name: 'Thomas',
    age: 34,
    emoji: '🏡',
    situation: 'Proprietaire a Thionville-Apach, cherche etude thermique avant renovation',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Il cherche "etude thermique Thionville" — le nom "Start Etude" l\'intrigue. Il arrive sur le site mais ne trouve aucune page ni section sur les etudes thermiques. Il compare avec un concurrent qui detaille la prestation.',
    localisation: 'Thionville (57100)',
    maturite: 'Comparaison',
    contexte: 'Il veut isoler sa maison de 1985. Son conseiller France Renov lui a parle d\'etude thermique obligatoire avant travaux. Il cherche quelqu\'un de competent.',
    impression: '"Start Etude" — le mot "etude" dans le nom lui donne de l\'espoir. Il cherche la section correspondante.',
    parcours: [
      ['Accueil', '"Systemes Thermiques Specialises" — ca semble coller'],
      ['Services', 'Lit les 5 services — aucune mention etude thermique'],
      ['A propos', 'Cherche certifications, RGE, qualifications — absent'],
      ['Quitte', 'Ouvre le site concurrent qui detaille bien la prestation'],
    ] as [string, string][],
    questionCle: 'Ils font vraiment les etudes thermiques ? Ils sont qualifies ?',
    reponse: 'Non' as const,
    commentReponse: 'Le nom "Start Etude" evoque la prestation mais aucune page ne la decrit. Aucune certification mentionnee.',
    impactVitesse: 'Acceptable sur desktop.',
    impactConfiance: 'Absence de certifications RGE visible = doute sur la qualification.',
    positifs: ['Nom evocateur pour ce profil', 'Zone Thionville confirmee', '11 ans d\'experience rassure'],
    frictions: ['Aucune mention des etudes thermiques dans les services', 'Aucune certification RGE/Qualibat visible', 'Pas de page dedie a la prestation principale implied par le nom'],
    ceQuiFeraitBasculer: 'Une section "Etudes Thermiques" avec ce qui est inclus, delai, et certifications eventuelles.',
    exp: 4, conf: 5, clarte: 3,
  },
  {
    id: 4,
    name: 'Laura',
    age: 29,
    emoji: '❄️',
    situation: 'Locataire proprietaire a Cattenom, installation climatisation',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Sa voisine lui a recommande Start Etude pour une clim. Elle visite le site, trouve le service climatisation mais aucune photo d\'installation, aucune marque mentionnee. Son frere lui parle d\'un concurrent qui montre ses chantiers. Elle hesite.',
    localisation: 'Cattenom (57570)',
    maturite: 'Comparaison',
    contexte: 'Elle veut une climatisation reversible pour son appartement. Budget : 2 500-3 500€. Elle compare 2-3 artisans.',
    impression: 'Site pro, services listes. Mais elle cherche des photos d\'installations reussies et les marques proposees.',
    parcours: [
      ['Accueil mobile', 'Service climatisation present — OK'],
      ['Section Climatisation', 'Lit "Installation de Climatisation" — mais pas de photo, pas de marque'],
      ['Formulaire', 'Hesite a envoyer une demande sans avoir vu de realisation'],
    ] as [string, string][],
    questionCle: 'Ils font quelle marque de clim ? C\'est quoi leur travail en vrai ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune photo de chantier, aucune marque (Daikin, Atlantic, Mitsubishi ?) mentionnee.',
    impactVitesse: 'Lenteur mobile = frustration supplementaire sur mobile.',
    impactConfiance: 'Sans photos ni marques, impossible d\'evaluer la qualite du travail.',
    positifs: ['Service climatisation liste', 'Disponibilite 24h/24 rassure pour les pannes futures', 'Avis Google accessibles via lien'],
    frictions: ['Aucune photo d\'installation de climatisation', 'Aucune marque partenaire mentionnee pour la clim', 'Pas de fourchette de prix'],
    ceQuiFeraitBasculer: '2-3 photos d\'installations de climatisation avec marque et type de logement.',
    exp: 4, conf: 5, clarte: 4,
  },
  {
    id: 5,
    name: 'Didier',
    age: 58,
    emoji: '🏢',
    situation: 'Bailleur prive a Thionville — 4 appartements',
    canal: 'Reseaux sociaux',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Il gere 4 appartements en location. Il cherche un plombier-chauffagiste pour contrats d\'entretien annuels. Il visite le site mais ne trouve ni SIRET, ni certifications, ni mention de contrats d\'entretien. Il passe au suivant.',
    localisation: 'Thionville (57100)',
    maturite: 'Decouverte',
    contexte: 'Il veut externaliser l\'entretien annuel de ses 4 chaudieres. Il cherche un artisan serieux avec qui signer un contrat annuel.',
    impression: 'Site artisan local — ok pour particuliers. Mais il cherche des garanties professionnelles.',
    parcours: [
      ['Accueil', 'Entreprise depuis 2013 — credible'],
      ['Services', 'Voit "Reparations et Depannage" mais pas "contrat d\'entretien"'],
      ['A propos', 'Cherche SIRET, assurances, certifications — absent'],
      ['Quitte', 'SIRET absent = impossible pour sa comptabilite'],
    ] as [string, string][],
    questionCle: 'Ils peuvent signer un contrat d\'entretien annuel ? Ils ont un SIRET ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune mention SIRET, assurance decennale ni offre de contrat d\'entretien annuel.',
    impactVitesse: 'Sans objet — il quitte pour raison de confiance.',
    impactConfiance: 'Absence de SIRET visible = bloquant pour tout profil bailleur ou professionnel.',
    positifs: ['Anciennete 2013 rassure sur la perennite', 'Telephone disponible'],
    frictions: ['Pas de SIRET visible', 'Pas de certifications', 'Pas d\'offre contrat d\'entretien'],
    ceQuiFeraitBasculer: 'C\'est partiellement hors cible — mais un SIRET visible dans le footer aiderait aussi les particuliers exigeants.',
    exp: 4, conf: 4, clarte: 4,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Ajouter l\'aggregateRating dans le Schema.org',
    pourquoi: '238 avis Google "Excellent" ne s\'affichent pas dans les resultats de recherche Google. Le Schema.org est present mais incomplet : l\'aggregateRating manque. Les concurrents qui l\'ont configure affichent des etoiles directement dans les SERPs — Start Etude non. C\'est la premiere perte de visibilite : un taux de clic potentiellement 20-30% plus eleve avec les etoiles visibles.',
    action: 'Modifier le Schema.org existant pour ajouter : "aggregateRating": {"@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "238", "bestRating": "5"}. Modification technique de 30 minutes. Effet visible dans Google sous 2-4 semaines.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A verifier', ok: false, detail: 'Quota API epuise — WordPress Hostinger, estimation mobile 45-60.' },
  { label: 'Securite', verdict: 'A ameliorer', ok: false, detail: 'HSTS, X-Frame-Options, X-Content-Type-Options absents.' },
  { label: 'SEO', verdict: 'Base correcte', ok: false, detail: 'H1, title, meta OK. aggregateRating manquant = perte etoiles SERPs.' },
  { label: 'Donnees structurees', verdict: 'Incomplet', ok: false, detail: 'Schema.org present (Plumber + Organization) mais aggregateRating absent.' },
  { label: 'Partage reseaux', verdict: 'Bien configure', ok: true, detail: 'Open Graph present avec image, titre et description.' },
];

const tech = {
  observatory: { grade: 'D', score: 25, testsOk: 2, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'Redirection HTTP vers HTTPS' },
    { ok: true, h: 'Content-Security-Policy partielle (upgrade-insecure-requests)' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (absent)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking)' },
    { ok: false, h: 'X-Content-Type-Options (absent)' },
    { ok: false, h: 'Referrer-Policy (absent)' },
  ],
  schema: [
    { item: 'JSON-LD / Schema.org present', ok: true },
    { item: '@type Plumber + Organization', ok: true },
    { item: 'name, url, telephone, email', ok: true },
    { item: 'address + openingHours', ok: true },
    { item: 'aggregateRating (238 avis)', ok: false },
    { item: 'geo (latitude/longitude)', ok: false },
    { item: 'areaServed (zone de chalandise)', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'Plombier Chauffagiste a Thionville (57) | Depannage Urgence' },
    { item: 'og:description', ok: true, val: 'Plombier chauffagiste a Thionville (57), depannage en urgence...' },
    { item: 'og:image', ok: true, val: '/wp-content/uploads/2024/07/Sans-titre.webp' },
    { item: 'og:url', ok: true, val: 'https://startetude.fr/' },
    { item: 'twitter:card', ok: false, val: 'Non detecte' },
  ],
  seo: [
    { item: 'H1 unique ("Plombier & Chauffagiste — Intervention 24H/24 7J/7")', ok: true },
    { item: 'Title optimise (Thionville + urgence)', ok: true },
    { item: 'Meta description presente', ok: true },
    { item: 'robots.txt accessible', ok: true },
    { item: 'sitemap_index.xml accessible', ok: true },
    { item: 'aggregateRating configure', ok: false },
    { item: 'Schema.org complete (geo + areaServed)', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group bg-white rounded-xl overflow-hidden shadow-sm border border-green-200">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]: [string, string]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                  <p class="text-neutral-600">Le site repond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
