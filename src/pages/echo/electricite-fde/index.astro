---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'electricite-fde';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Fernandes Daniel Electricite';
const urlSite = 'https://www.electricite-fde.com';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 6.4,
  confiance: 6.8,
  clarte: 6.2,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart (hors cible).';

const constat = 'La note 4.9/5 avec 48 avis est un atout exceptionnel — elle rassure immediatement ceux qui comparent. Mais le site ne capitalise pas dessus : pas d\'email visible, pas d\'horaires, pas de photo de chantier, aucune certification affichee. Ceux qui cherchent un electricien specialise (IRVE, copropriete) repartent faute d\'informations suffisantes. 2 hesitants representent un potentiel sous-exploite important.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Hors cible', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Kevin',
    age: 38,
    emoji: '⚡',
    situation: 'Proprietaire a Creutzwald, mise aux normes electrique avant travaux',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Il compare 2 artisans locaux. Le H1 cite "Creutzwald" — il est dans la zone. Note 4.9/5 visible. Il trouve le numero et appelle directement.',
    localisation: 'Creutzwald (57150)',
    maturite: 'Decision',
    contexte: 'Il a besoin d\'une mise aux normes electrique avant les travaux. Il compare 2 artisans locaux et cherche a appeler rapidement.',
    impression: '"entre Creutzwald et Metz" dans le H1 — il se voit dans la zone. Note 4.9 le rassure.',
    parcours: [
      ['Hero', '"Creutzwald" dans le titre = bonne pioche, il continue'],
      ['Zone d\'intervention', '"50 km autour d\'Ottonville" confirme'],
      ['Avis clients', '48 avis 4.9/5 — lit 2-3 temoignages, rassurant'],
      ['Contact', 'Trouve le telephone, appelle directement'],
    ] as [string, string][],
    questionCle: 'Il intervient bien a Creutzwald ?',
    reponse: 'Oui' as const,
    commentReponse: 'Le H1 cite "Creutzwald" explicitement, la zone d\'intervention est claire.',
    impactVitesse: 'Scripts tiers — chargement probablement 2-3 sec mais il est motive.',
    impactConfiance: 'La note Plus que Pro compense l\'absence de headers securite.',
    positifs: ['Zone geographique citee dans le H1', 'Note 4.9/5 visible immediatement', 'Numero de telephone accessible'],
    frictions: ['Pas d\'horaires', 'Pas de galerie de chantiers similaires', 'Pas d\'email pour envoyer photos'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 8, clarte: 6,
  },
  {
    id: 2,
    name: 'Lucas',
    age: 29,
    emoji: '🏠',
    situation: 'Jeune actif a Boulay, recommande par son voisin',
    canal: 'Bouche-a-oreille',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Son voisin lui a dit "appelle Fernandes, il est top". Il visite le site, confirme l\'identite, voit les 4.9/5. Appelle dans les 30 secondes.',
    localisation: 'Boulay (57220)',
    maturite: 'Decision',
    contexte: 'Son voisin lui a recommande Fernandes. Il cherche juste a confirmer et trouver le numero.',
    impression: '"Fernandes Daniel Electricite" — c\'est bien eux. Le numero est visible.',
    parcours: [
      ['Accueil', 'Confirme l\'identite, trouve le numero immediatement'],
      ['Avis', 'Jette un oeil, confirme les 4.9/5'],
      ['Contact', 'Appelle directement depuis mobile'],
    ] as [string, string][],
    questionCle: 'C\'est bien Fernandes, j\'ai le bon numero ?',
    reponse: 'Oui' as const,
    commentReponse: 'Nom + numero visible immediatement.',
    impactVitesse: 'Peu importe, il est la pour appeler.',
    impactConfiance: 'Recommandation personnelle prime sur tout.',
    positifs: ['Nom clair, numero visible', 'Note confirme la recommandation du voisin'],
    frictions: [],
    ceQuiFeraitBasculer: '',
    exp: 8, conf: 9, clarte: 8,
  },
  {
    id: 3,
    name: 'Isabelle',
    age: 52,
    emoji: '🏠',
    situation: 'Commercante a Metz, veut installer une borne de recharge IRVE',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle compare 3 artisans pour une borne IRVE deductible fiscalement. Le service est mentionne mais aucune certification Quali\'IRVE n\'est visible. Elle remplit le formulaire sans certitude.',
    localisation: 'Metz (57000)',
    maturite: 'Comparaison',
    contexte: 'Elle veut une borne IRVE deductible fiscalement. Elle compare 3 artisans et veut confirmer la certification Quali\'IRVE.',
    impression: 'IRVE mentionne sur la page domotique — elle est au bon endroit. Mais elle cherche une certification.',
    parcours: [
      ['Accueil', 'Services mentionnes, IRVE visible'],
      ['Page Domotique', '"Bornes IRVE" confirme, mais aucune certification listee'],
      ['Avis clients', 'Lit les temoignages, aucun ne mentionne une installation IRVE'],
      ['Contact', 'Remplit le formulaire mais aurait prefere un email direct'],
    ] as [string, string][],
    questionCle: 'Est-ce qu\'il est certifie Quali\'IRVE ?',
    reponse: 'Non' as const,
    commentReponse: 'Le service est mentionne mais sans aucune preuve de qualification.',
    impactVitesse: 'Desktop, chargement acceptable.',
    impactConfiance: 'Note 4.9 positive mais absence de certifications specifiques IRVE inquiete.',
    positifs: ['IRVE mentionne sur plusieurs pages', 'Note globale rassurante', 'Formulaire fonctionnel'],
    frictions: ['Aucune certification Quali\'IRVE visible', 'Pas d\'email direct pour envoyer documents', 'Aucun temoignage IRVE'],
    ceQuiFeraitBasculer: 'Un badge "Certifie Quali\'IRVE" + 1 temoignage client borne de recharge.',
    exp: 6, conf: 6, clarte: 5,
  },
  {
    id: 4,
    name: 'Fabrice',
    age: 44,
    emoji: '📱',
    situation: 'Gestionnaire de copropriete a Thionville, cherche electricien pour remise aux normes',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Il a vu la note 4.9/5 sur Maps et clique sur le site. Il cherche des references de chantiers professionnels et un email pro — introuvables. Il bookmarke mais ne rappelle pas.',
    localisation: 'Thionville (57100)',
    maturite: 'Comparaison',
    contexte: 'Il a trouve la fiche Google avec 4.9/5. Il clique sur le site pour verifier avant d\'appeler. Besoin de reference chantier pro pour un immeuble.',
    impression: 'Note 4.9/5 sur Maps l\'a amene ici. "Bureaux et magasins" note — signal positif.',
    parcours: [
      ['Accueil', '"Bureaux et magasins" note, mais pas de reference collective'],
      ['Page Electricite', 'Services listes, "professionnels" mentionne sans exemples'],
      ['Avis clients', 'Temoignages tous de particuliers'],
      ['Contact', 'Hesite — prefererait email pro pour envoyer cahier des charges'],
    ] as [string, string][],
    questionCle: 'Ils prennent les chantiers de copropriete ?',
    reponse: 'Partiellement' as const,
    commentReponse: '"Bureaux et magasins" mentionne mais aucune reference professionnelle concrete.',
    impactVitesse: 'Scripts tiers ralentissent sur mobile.',
    impactConfiance: 'Absence de SIRET cree une incertitude pour un devis formel.',
    positifs: ['Note 4.9/5 coherente Maps/site', 'Equipe de 4 mentionnee', 'Services professionnels mentionnes'],
    frictions: ['Aucun email direct', 'Pas de reference chantier pro', 'Pas de SIRET visible', 'Temoignages uniquement particuliers'],
    ceQuiFeraitBasculer: 'Un email visible + 1 temoignage gestionnaire de copropriete.',
    exp: 6, conf: 6, clarte: 5,
  },
  {
    id: 5,
    name: 'Sophie',
    age: 35,
    emoji: '🏢',
    situation: 'Responsable achats PME Nancy, cherche electricien industriel — hors cible',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Elle gere la maintenance de 3 sites industriels. Le site mentionne "artisan" et "particuliers" — pas le bon profil. Elle repart immediatement.',
    localisation: 'Nancy (54000) — hors zone',
    maturite: 'Decouverte',
    contexte: 'Elle cherche un electricien industriel avec habilitations (BR, BC, H0) pour 3 sites. Zone Metz-Thionville, pas Nancy.',
    impression: '"Artisan electricien" et "particuliers" signalent le mauvais profil.',
    parcours: [
      ['Accueil', '"Artisan" et "Moselle" — pas le bon profil'],
      ['Services', 'Residentiels et commerces — confirme le mauvais match'],
      ['Quitte', 'Immediatement'],
    ] as [string, string][],
    questionCle: 'Electricite industrielle avec habilitations ?',
    reponse: 'Non' as const,
    commentReponse: 'Hors perimetre de competence — normal et acceptable.',
    impactVitesse: 'Sans objet.',
    impactConfiance: 'Le positionnement clair evite de perdre son temps.',
    positifs: ['Le positionnement clair evite une perte de temps mutuelle'],
    frictions: ['Hors cible — normal'],
    ceQuiFeraitBasculer: 'Rien — profil hors cible.',
    exp: 5, conf: 5, clarte: 7,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Ajouter l\'email de contact ET les horaires sur toutes les pages',
    pourquoi: '2 visiteurs sur 5 (Isabelle et Fabrice) ont besoin de transmettre des informations avant d\'appeler — plans, CDC, specs techniques. Sans email, ils remettent le contact a plus tard et risquent de ne jamais rappeler. Les horaires manquants creent une friction supplementaire : personne ne veut laisser un message sur repondeur.',
    action: 'Ajouter dans le header ET le footer : l\'adresse email (ex. contact@electricite-fde.com) + les horaires (ex. "Lun-Ven 8h-18h, Sam 9h-12h"). Ces deux infos doivent etre visibles sans scroll sur mobile.',
    impact: '2 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A verifier', ok: false, detail: 'CMS Plus que Pro + scripts tiers — quota API epuise lors de l\'audit.' },
  { label: 'Securite', verdict: 'A ameliorer', ok: false, detail: 'Headers de securite partiels — CSP probablement absent.' },
  { label: 'SEO', verdict: 'A ameliorer', ok: false, detail: 'Sitemap date — a mettre a jour.' },
  { label: 'Donnees structurees', verdict: 'Partiel', ok: false, detail: 'Schema.org via Plus que Pro — type generique, openingHours manquant.' },
  { label: 'Partage reseaux', verdict: 'Non confirme', ok: false, detail: 'Balises OG partielles.' },
];

const tech = {
  observatory: { grade: 'C', score: 55, testsOk: 7, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'Redirection HTTP vers HTTPS' },
    { ok: true, h: 'X-Content-Type-Options: nosniff' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (a verifier)' },
    { ok: false, h: 'Content-Security-Policy (absent probable)' },
    { ok: false, h: 'X-Frame-Options (a verifier)' },
  ],
  schema: [
    { item: 'JSON-LD present (via Plus que Pro)', ok: true },
    { item: '@type LocalBusiness', ok: true },
    { item: 'name, url, telephone', ok: true },
    { item: 'aggregateRating (4.9/48)', ok: true },
    { item: '@type specifique "Electrician"', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'geo (latitude/longitude)', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'Present' },
    { item: 'og:description', ok: false, val: 'Non confirme' },
    { item: 'og:image', ok: false, val: 'Non confirme' },
    { item: 'og:url', ok: false, val: 'Non confirme' },
    { item: 'twitter:card', ok: false, val: 'Non confirme' },
  ],
  seo: [
    { item: 'H1 unique et oriente local SEO', ok: true },
    { item: 'Zone geographique dans le titre', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'Meta description', ok: false },
    { item: 'robots.txt accessible', ok: false },
    { item: 'Sitemap a jour', ok: false },
  ],
};
---
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group bg-white rounded-xl overflow-hidden shadow-sm border border-green-200">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]: [string, string]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                  <p class="text-neutral-600">Le site repond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                  <div><p class="font-semibold text-green-700 mb-1.5">Points positifs</p><ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul></div>
                  <div><p class="font-semibold text-amber-700 mb-1.5">Frictions</p><ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul></div>
                </div>
                <div class="flex gap-6 pt-3 border-t border-neutral-100">
                  {[{ label: 'Experience', val: p.exp }, { label: 'Confiance', val: p.conf }, { label: 'Clarte', val: p.clarte }].map(s => {
                    const sColor = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
                    return <div class="text-center"><span class={`block text-lg font-bold ${sColor}`}>{s.val}</span><span class="text-[10px] text-neutral-400">{s.label}</span></div>;
                  })}
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>

    <div class="mb-4">
      <h3 class="text-base font-bold text-amber-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block"></span>
        Ceux qui hesitent <span class="text-sm font-normal text-amber-600">({kpis.nbHesitent})</span>
