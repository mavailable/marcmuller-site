const ameliorationsHautes = [
  { titre: 'Afficher des fourchettes de prix par service', pourquoi: 'C\'est LA question de chaque visiteur. 17 sur 20 cherchent un tarif. Personne ne trouve. Les visiteurs en mode comparaison quittent systematiquement. Meme un "a partir de X€" debloquerait les hesitants.', action: 'Creer une page Tarifs ou ajouter des fourchettes sur chaque service. "Audit SI : a partir de X€", "Site vitrine : a partir de Y€".', impact: '17 visiteurs sur 20' },
  { titre: 'Transformer les 11 references en etudes de cas', pourquoi: 'Chaque visiteur cherche une preuve que vous avez travaille dans SON secteur — sante, BTP, association, restaurant. Les logos seuls ne prouvent rien. 3 phrases par client changeraient tout : secteur, probleme, solution.', action: 'Pour chaque reference, ajouter : secteur d\'activite, problematique, solution apportee, resultat. Meme 2-3 phrases suffisent.', impact: '16 visiteurs sur 20' },
  { titre: 'Ajouter 3-5 temoignages clients textuels', pourquoi: 'Les logos prouvent l\'existence de clients. Un temoignage prouve leur satisfaction. "Pierre-Yves a simplifie notre SI en 3 mois" vaut plus que 11 logos silencieux.', action: 'Demander 3-5 citations ecrites aux clients satisfaits. Prenom, entreprise, contexte, resultat en 1-2 phrases. Afficher sur la homepage et la page references.', impact: '15 visiteurs sur 20' },
  { titre: 'Creer des pages services detaillees', pourquoi: '"Audit securite", "formation", "analyse donnees" sont des mots dans une liste, pas des offres. Chaque visiteur cherche des details sur le service qui le concerne — perimetre, livrables, duree, publics — et ne trouve rien.', action: 'Une page par service avec : description detaillee, perimetre, livrables, duree indicative, public cible. Chaque service devient une offre structuree.', impact: '14 visiteurs sur 20' },
];

const ameliorationsUtiles = [
  { titre: 'Integrer un outil de prise de RDV en ligne', detail: 'Le diagnostic gratuit 30 min est un bon CTA, mais sans Calendly ou equivalent, le visiteur doit envoyer un email ou appeler pour caler un creneau. 8 personas sont freines par cette friction.' },
  { titre: 'Ajouter une FAQ', detail: '"Combien ca coute ?", "Combien de temps ?", "Vous intervenez en presentiel ?", "Vous travaillez avec des associations ?" — 12 personas cherchent des reponses a ces questions basiques.' },
  { titre: 'Creer un portfolio visuel', detail: 'Les visiteurs qui veulent "voir" un resultat — sites web, dashboards, applications — n\'ont aucune capture d\'ecran ou demonstration visuelle pour se projeter.' },
  { titre: 'Corriger les 3 H1 de la homepage', detail: 'Google et les visiteurs ne savent pas quel est le message principal. Une seule H1 par page, les autres deviennent des H2. Correction rapide, impact SEO direct.' },
];

const ameliorationsDiscuter = [
  { emoji: '🏠', titre: 'Clarifier full remote vs presentiel', detail: 'Le positionnement "full remote" exclut des clients locaux qui veulent un passage sur site. Si vous intervenez en presentiel en Martinique, mentionnez-le clairement.' },
  { emoji: '🌍', titre: 'Migrer l\'hebergement hors Hostinger', detail: 'Hostinger (siege en Lituanie) contredit le discours souverainete numerique. Les profils techniques (DSI, RSSI) reperent cette incoherence. Un hebergeur français ou europeen renforcerait la credibilite.' },
  { emoji: '🤝', titre: 'Ajouter une section Partenaires / Sous-traitance', detail: 'Les prescripteurs (agences, DSI, ESN) sont des apporteurs d\'affaires recurrents. Le site ne s\'adresse qu\'aux clients finaux et ignore ce segment.' },
];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Non mesure', ok: false, detail: 'PageSpeed non disponible — a tester sur pagespeed.web.dev' },
  { label: 'Securite', verdict: 'A+ (115/100)', ok: true, detail: 'Tous les headers de securite en place — excellent' },
  { label: 'SEO', verdict: 'A corriger', ok: false, detail: '3 H1 sur la homepage, 4 images alt generiques' },
  { label: 'Donnees structurees', verdict: 'Incomplet', ok: false, detail: 'Schema.org present mais sans description, priceRange ni speakable' },
  { label: 'Partage reseaux', verdict: 'Bug', ok: false, detail: 'Double bloc OG contradictoire, image carree au lieu de 1200x630' },
];

const tech = {
  observatory: { grade: 'A+', score: 115, testsOk: 10, testsTotal: 10 },
  pagespdMobile: null, pagespdDesktop: null,
  cwv: { lcp: 'Non mesure', inp: 'Non mesure', cls: 'Non mesure' },
  headers: [
    { ok: true, h: 'Content-Security-Policy' }, { ok: true, h: 'Strict-Transport-Security (HSTS preload)' },
    { ok: true, h: 'X-Content-Type-Options' }, { ok: true, h: 'X-Frame-Options (DENY)' },
    { ok: true, h: 'X-XSS-Protection' }, { ok: true, h: 'Referrer-Policy' },
    { ok: true, h: 'Permissions-Policy' }, { ok: true, h: 'Cross-Origin-Resource-Policy' },
    { ok: true, h: 'Cross-Origin-Embedder-Policy' }, { ok: true, h: 'Cross-Origin-Opener-Policy' },
  ],
  schema: [
    { item: 'JSON-LD present (Rank Math)', ok: true },
    { item: '@type ProfessionalService + Organization', ok: true },
    { item: 'name, url, email, telephone', ok: true },
    { item: 'address + geo (lat/lon)', ok: true },
    { item: 'openingHours', ok: true },
    { item: 'logo + ImageObject', ok: true },
    { item: 'description sur Organization', ok: false },
    { item: 'priceRange', ok: false },
    { item: 'hasOfferCatalog / ServiceType', ok: false },
    { item: 'speakable (GEO / IA)', ok: false },
    { item: 'Person / founder', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'Present' },
    { item: 'og:description', ok: true, val: 'Present (Rank Math)' },
    { item: 'og:url', ok: false, val: 'Relatif dans le 1er bloc (bug)' },
    { item: 'og:image', ok: false, val: '919x919 au lieu de 1200x630' },
    { item: 'og:type', ok: true, val: 'website' },
    { item: 'og:locale', ok: true, val: 'fr_FR' },
    { item: 'twitter:card', ok: false, val: '2 valeurs contradictoires' },
  ],
  seo: [
    { item: 'HTTPS + HSTS preload', ok: true },
    { item: 'Canonical coherent (www)', ok: true },
    { item: 'robots.txt accessible', ok: true },
    { item: 'Sitemap accessible (Rank Math)', ok: true },
    { item: '1 seul H1 par page', ok: false },
    { item: 'Images avec alt pertinent', ok: false },
    { item: 'Doublon blocs OG', ok: false },
    { item: 'Meta description optimisee', ok: false },
  ],
};

function decisionBorder(d: string) { if (d === 'Convertit') return 'border-green-200'; if (d === 'Hesite') return 'border-amber-200'; return 'border-neutral-200'; }
function decisionBadge(d: string) { if (d === 'Convertit') return 'bg-green-600'; if (d === 'Hesite') return 'bg-amber-500'; return 'bg-neutral-400'; }
const accentColor = '#2563EB';
const accentGradient = 'linear-gradient(135deg, #2563EB, #1D4ED8)';
---

<BaseLayout title={title} description={description} noindex={true} lang="fr" frPath={`/echo/${slug}`}>

  <section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
    <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style={`background: ${accentColor}; opacity: 0.08;`}></div>
    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">{formuleLabel} &middot; Rapport confidentiel</div>
      <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
      <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">Site analyse : <a href={urlSite} target="_blank" rel="noopener" class="underline hover:text-white transition-colors">{urlSite}</a> &middot; {kpis.nbPersonas} visiteurs simules &middot; {dateAudit}</p>
      <div class="grid grid-cols-3 gap-4">
        <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);"><div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div><div class="text-sm text-green-400/70">vous contactent</div></div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);"><div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div><div class="text-sm text-amber-400/70">hesitent</div></div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);"><div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div><div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div></div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style={`background: rgba(37,99,235,0.04); border-color: ${accentColor};`}><p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p></div>
    <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2><p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal.</p>
    <div class="space-y-4 mb-12">{canalData.map(c => { const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444'; return (<div class="flex items-center gap-4"><div class="w-52 text-sm text-neutral-700 shrink-0">{c.canal}</div><div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden"><div class="h-full rounded-full" style={`width: ${c.rate}%; background: ${color}`}></div></div><div class="w-20 text-right"><span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span><span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span></div></div>); })}</div>
  </section>

  <section class="py-12" style="background: #fefce8;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6"><svg class="w-6 h-6 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg><div><h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2><p class="text-sm text-neutral-600">{alertes.filter(a => a.type === 'critique').length} critiques &middot; {alertes.filter(a => a.type === 'important').length} importants</p></div></div>
      <div class="grid md:grid-cols-2 gap-4">{alertes.map(a => (<div class={`bg-white rounded-xl p-5 ${a.type === 'critique' ? 'border-2 border-red-300' : 'border border-amber-300'}`}><div class={`inline-block text-2xl font-black px-3 py-1 rounded-lg mb-3 ${a.type === 'critique' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>{a.chiffre}</div><p class="text-[10px] text-neutral-400 uppercase tracking-wider mb-1">{a.chiffreLabel}</p><h3 class="font-semibold text-neutral-900 text-sm mb-2">{a.titre}</h3><p class="text-xs text-neutral-600 leading-relaxed">{a.detail}</p></div>))}</div>
    </div>
  </section>

  <section class="py-16" style="background: #fafafa;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2><p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services en Martinique et tombe sur votre site.</p>
      {(['Convertit', 'Hesite', 'Quitte'] as const).map(decision => {
        const filtered = personas.filter(p => p.decision === decision);
        const labels = { Convertit: 'Ceux qui vous contactent', Hesite: 'Ceux qui hesitent', Quitte: 'Ceux qui repartent' };
        const colors = { Convertit: { dot: 'bg-green-500', text: 'text-green-800', sub: 'text-green-600' }, Hesite: { dot: 'bg-amber-500', text: 'text-amber-800', sub: 'text-amber-600' }, Quitte: { dot: 'bg-neutral-400', text: 'text-neutral-600', sub: 'text-neutral-500' } };
        const c = colors[decision];
        return (<div class="mb-10"><h3 class={`text-base font-bold ${c.text} mb-4 flex items-center gap-2`}><span class={`w-2.5 h-2.5 rounded-full ${c.dot} inline-block`}></span>{labels[decision]}<span class={`text-sm font-normal ${c.sub}`}>({filtered.length})</span></h3>
          <div class="space-y-3">{filtered.map(p => (
            <details class={`group bg-white rounded-xl overflow-hidden shadow-sm border ${decisionBorder(p.decision)}`}>
              <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden"><div class="text-xl shrink-0 mt-0.5">{p.emoji}</div><div class="flex-1 min-w-0"><div class="flex items-center gap-2 mb-1 flex-wrap"><h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4><span class={`text-[10px] ${decisionBadge(p.decision)} text-white px-1.5 py-0.5 rounded font-medium`}>{p.decisionLabel}</span></div><p class="text-sm text-neutral-600 mb-2">{p.histoire}</p><div class="flex flex-wrap items-center gap-1.5"><span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span><span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span><span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span></div></div><svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary>
              <div class={`px-4 pb-5 border-t ${decisionBorder(p.decision)}`}><div class="grid gap-4 text-xs mt-4">
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression</p><p class="text-neutral-600">{p.impression}</p></div>
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours</p><ol class="list-decimal list-inside space-y-1.5 text-neutral-600">{p.parcours.map(([s, r]) => (<li><strong class="text-neutral-800">{s}</strong>{r ? ` — ${r}` : ''}</li>))}</ol></div>
                <div class="bg-neutral-50 rounded-lg p-3"><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p><p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p><p class="text-neutral-600">Le site repond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p></div>
                <div class="grid grid-cols-2 gap-4"><div><p class="font-semibold text-green-700 mb-1.5">Points positifs</p><ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul></div><div><p class="font-semibold text-amber-700 mb-1.5">Frictions</p><ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul></div></div>
                {p.ceQuiFeraitBasculer && <div class="bg-amber-50 rounded-lg p-3"><p class="font-semibold text-amber-700 text-[10px] uppercase tracking-wider mb-1">Ce qui le ferait passer a l'action</p><p class="text-neutral-700 text-xs">{p.ceQuiFeraitBasculer}</p></div>}
                <div class="flex gap-6 pt-3 border-t border-neutral-100">{[{ label: 'Exp', val: p.exp },{ label: 'Conf', val: p.conf },{ label: 'Clarte', val: p.clarte }].map(s => { const sc = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500'; return (<div class="text-center"><span class={`block text-lg font-bold ${sc}`}>{s.val}</span><span class="text-[10px] text-neutral-400">{s.label}</span></div>);})}</div>
              </div></div>
            </details>))}</div>
          {decision === 'Hesite' && <div class="mt-4 bg-amber-50 border border-amber-200 rounded-xl p-4 text-center"><p class="text-sm text-amber-800 font-medium">Ces {filtered.length} visiteurs ont besoin de vos services. Ils ne sont pas convaincus — il leur manque un tarif, un exemple, un temoignage.</p></div>}
          {decision === 'Quitte' && <div class="mt-4 bg-neutral-100 border border-neutral-200 rounded-xl p-4 text-center"><p class="text-sm text-neutral-700 font-medium">Chaque visiteur qui part, c'est un client en moins. {filtered.filter(p => !p.histoire.includes('HORS CIBLE')).length > 0 ? 'Certains etaient dans votre cible.' : ''}</p></div>}
        </div>);
      })}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Ce qu'on recommande</h2><p class="text-neutral-600 mb-8">Actions concretes, classees par impact sur vos visiteurs.</p>
    <p class="text-sm font-semibold text-red-700 mb-4">Si vous ne changez qu'une chose, changez ca :</p>
    <div class="space-y-4 mb-12">{ameliorationsHautes.map(a => (<div class="bg-white border-2 border-red-200 rounded-xl p-6 shadow-sm"><div class="flex items-start justify-between gap-4 mb-3"><h4 class="font-bold text-neutral-900">{a.titre}</h4><span class="text-[10px] px-2 py-1 rounded-full bg-red-100 text-red-700 font-semibold shrink-0 whitespace-nowrap">{a.impact}</span></div><p class="text-sm text-neutral-600 mb-3">{a.pourquoi}</p><div class="bg-neutral-50 rounded-lg px-4 py-3 flex items-start gap-2"><svg class="w-4 h-4 text-neutral-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg><p class="text-xs text-neutral-700">{a.action}</p></div></div>))}</div>
    <h3 class="text-lg font-bold text-neutral-900 mb-2">Utile aussi</h3>
    <div class="grid md:grid-cols-2 gap-4 mb-12">{ameliorationsUtiles.map(a => (<div class="bg-white border border-neutral-200 rounded-xl p-5"><h4 class="font-semibold text-neutral-900 text-sm mb-2">{a.titre}</h4><p class="text-xs text-neutral-600">{a.detail}</p></div>))}</div>
    <h3 class="text-lg font-bold text-neutral-900 mb-2">A discuter</h3>
    <div class="space-y-3 mb-12">{ameliorationsDiscuter.map(a => (<div class="bg-neutral-50 border border-neutral-200 rounded-xl p-4 flex gap-3"><span class="text-lg shrink-0">{a.emoji}</span><div><h4 class="font-semibold text-neutral-900 text-sm mb-0.5">{a.titre}</h4><p class="text-xs text-neutral-600">{a.detail}</p></div></div>))}</div>
    {showUpsell && (<div class="rounded-2xl p-8 text-center border-2 border-dashed" style={`border-color: ${accentColor}; background: rgba(37,99,235,0.03);`}><p class="text-lg font-bold text-neutral-900 mb-2">20 visiteurs confirment les tendances. 100 les chiffrent.</p><p class="text-sm text-neutral-600 mb-6">Avec un Echo Pro (250€), 100 visiteurs simules, analyse par canal et par maturite, et un appel de 30 minutes pour parcourir le rapport ensemble.</p><a href="tel:0677138777" class="inline-flex items-center gap-2 px-6 py-3 text-white font-semibold rounded-xl transition-all shadow-md hover:-translate-y-0.5" style={`background: ${accentGradient};`}>Passer a l'Echo Pro — 250€</a></div>)}
  </section>

  <section class="py-16 border-t border-neutral-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Sous le capot</h2><p class="text-neutral-600 mb-8">Ce que les outils techniques disent de votre site.</p>
      <div class="flex flex-wrap gap-3 mb-10">{techVerdicts.map(v => (<div class={`inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border text-sm font-medium ${v.ok ? 'bg-green-50 border-green-200 text-green-800' : 'bg-red-50 border-red-200 text-red-800'}`}>{v.ok ? <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> : <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>}<span>{v.label}</span><span class="text-xs opacity-70">{v.verdict}</span></div>))}</div>
      <div class="space-y-4">
        <details class="bg-white rounded-xl border border-neutral-200 overflow-hidden">
          <summary class="p-4 cursor-pointer font-semibold text-sm text-neutral-900 flex justify-between items-center list-none [&::-webkit-details-marker]:hidden">Securite (Observatory) <span class="text-green-600 text-xs font-medium">{tech.observatory.grade} — {tech.observatory.score}/100</span></summary>
          <div class="px-4 pb-4 border-t border-neutral-100"><div class="grid gap-1.5 mt-3">{tech.headers.map(h => (<div class="flex items-center gap-2 text-xs"><span class={h.ok ? 'text-green-500' : 'text-red-500'}>{h.ok ? '✓' : '✗'}</span><span class="text-neutral-600">{h.h}</span></div>))}</div></div>
        </details>
        <details class="bg-white rounded-xl border border-neutral-200 overflow-hidden">
          <summary class="p-4 cursor-pointer font-semibold text-sm text-neutral-900 flex justify-between items-center list-none [&::-webkit-details-marker]:hidden">Donnees structurees (Schema.org) <span class="text-amber-600 text-xs font-medium">Incomplet</span></summary>
          <div class="px-4 pb-4 border-t border-neutral-100"><div class="grid gap-1.5 mt-3">{tech.schema.map(s => (<div class="flex items-center gap-2 text-xs"><span class={s.ok ? 'text-green-500' : 'text-red-500'}>{s.ok ? '✓' : '✗'}</span><span class="text-neutral-600">{s.item}</span></div>))}</div></div>
        </details>
        <details class="bg-white rounded-xl border border-neutral-200 overflow-hidden">
          <summary class="p-4 cursor-pointer font-semibold text-sm text-neutral-900 flex justify-between items-center list-none [&::-webkit-details-marker]:hidden">Partage reseaux (Open Graph) <span class="text-red-600 text-xs font-medium">Bug</span></summary>
          <div class="px-4 pb-4 border-t border-neutral-100"><div class="grid gap-1.5 mt-3">{tech.og.map(o => (<div class="flex items-center gap-2 text-xs"><span class={o.ok ? 'text-green-500' : 'text-red-500'}>{o.ok ? '✓' : '✗'}</span><span class="text-neutral-600">{o.item} — {o.val}</span></div>))}</div></div>
        </details>
        <details class="bg-white rounded-xl border border-neutral-200 overflow-hidden">
          <summary class="p-4 cursor-pointer font-semibold text-sm text-neutral-900 flex justify-between items-center list-none [&::-webkit-details-marker]:hidden">SEO technique <span class="text-amber-600 text-xs font-medium">A corriger</span></summary>
          <div class="px-4 pb-4 border-t border-neutral-100"><div class="grid gap-1.5 mt-3">{tech.seo.map(s => (<div class="flex items-center gap-2 text-xs"><span class={s.ok ? 'text-green-500' : 'text-red-500'}>{s.ok ? '✓' : '✗'}</span><span class="text-neutral-600">{s.item}</span></div>))}</div></div>
        </details>
        <details class="bg-white rounded-xl border border-neutral-200 overflow-hidden">
          <summary class="p-4 cursor-pointer font-semibold text-sm text-neutral-900 flex justify-between items-center list-none [&::-webkit-details-marker]:hidden">Vitesse (PageSpeed) <span class="text-neutral-400 text-xs font-medium">Non mesure</span></summary>
          <div class="px-4 pb-4 border-t border-neutral-100"><p class="text-xs text-neutral-600 mt-3">Les scores PageSpeed n'ont pas pu etre recuperes (quota API). Testez vous-meme : <a href="https://pagespeed.web.dev/report?url=https://axialdata.net" target="_blank" rel="noopener" class="text-blue-600 underline">pagespeed.web.dev</a></p></div>
        </details>
      </div>
    </div>
  </section>

  <section class="py-12 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-neutral-900 mb-4">Comment on a fait ca</h2>
      <div class="grid md:grid-cols-4 gap-4 text-sm text-neutral-600">
        <div class="bg-white rounded-xl p-4 border border-neutral-200"><div class="text-2xl font-black text-neutral-300 mb-2">1</div><p class="font-semibold text-neutral-800 mb-1">Scraping complet</p><p class="text-xs">12 pages analysees — accueil, services, references, blog, contact.</p></div>
        <div class="bg-white rounded-xl p-4 border border-neutral-200"><div class="text-2xl font-black text-neutral-300 mb-2">2</div><p class="font-semibold text-neutral-800 mb-1">Audit technique</p><p class="text-xs">Observatory, Schema.org, Open Graph, SEO technique.</p></div>
        <div class="bg-white rounded-xl p-4 border border-neutral-200"><div class="text-2xl font-black text-neutral-300 mb-2">3</div><p class="font-semibold text-neutral-800 mb-1">20 personas</p><p class="text-xs">Profils martiniquais realistes — sante, BTP, asso, PME, agences.</p></div>
        <div class="bg-white rounded-xl p-4 border border-neutral-200"><div class="text-2xl font-black text-neutral-300 mb-2">4</div><p class="font-semibold text-neutral-800 mb-1">20 simulations</p><p class="text-xs">Chaque persona parcourt le site et donne son verdict.</p></div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-neutral-200">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-neutral-900 mb-3">Votre expertise est reelle. Votre site ne la montre pas.</h2>
      <p class="text-neutral-600 mb-8">11 clients, Observatory A+, stack technique solide — les fondations sont la. Il manque des tarifs, des etudes de cas et des temoignages pour que votre site travaille aussi bien que vous.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="tel:0677138777" class="inline-flex items-center gap-2 px-6 py-3 text-white font-semibold rounded-xl transition-all shadow-md hover:-translate-y-0.5" style={`background: ${accentGradient};`}>Appeler Marc — 06 77 13 87 77</a>
        <a href="https://wa.me/33677138777" class="inline-flex items-center gap-2 px-6 py-3 border border-neutral-300 text-neutral-700 font-semibold rounded-xl transition-all hover:border-neutral-500">WhatsApp</a>
      </div>
      <p class="text-xs text-neutral-400 mt-6">Ce rapport est confidentiel et non indexe par Google &middot; Genere le {dateAudit}</p>
    </div>
  </section>
</BaseLayout>
