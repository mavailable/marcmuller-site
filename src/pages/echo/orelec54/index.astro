          <div>
            <p class="text-xs text-neutral-400 mb-0.5">{a.chiffreLabel}</p>
            <h3 class="font-bold text-neutral-900 mb-1">{a.titre}</h3>
            <p class="text-sm text-neutral-600">{a.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 3. VOS VISITEURS -->
