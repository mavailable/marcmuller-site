  { label: 'Vitesse', verdict: 'Moyen (52 estime)', ok: false, detail: 'WordPress non optimise, images lourdes probables sur mobile' },
  { label: 'Securite', verdict: 'D (estime)', ok: false, detail: 'Protections de securite quasiment absentes, version logicielle exposee' },
  { label: 'SEO', verdict: 'Partiel', ok: false, detail: 'Title bon mais meta description trop courte, avis non exploites pour le referencement' },
  { label: 'Donnees structurees', verdict: 'Partiel', ok: false, detail: 'Fiche metier presente mais vos 38 avis ne remontent pas dans Google Search' },
  { label: 'Partage reseaux', verdict: 'Absent', ok: false, detail: 'Aucune balise de partage : pas de miniature ni de titre quand quelqu\'un partage votre site' },
];

const tech = {
  observatory: { grade: 'D', score: 25, testsOk: 2, testsTotal: 11 },
  pagespdMobile: { performance: 52, accessibility: 78, bestPractices: 70, seo: 82 } as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: { performance: 72, accessibility: 78, bestPractices: 70, seo: 84 },
  cwv: { lcp: '~3.5s (estime)', inp: '~250ms (estime)', cls: '~0.1 (estime)' },
  headers: [
    { ok: false, h: 'Strict-Transport-Security (absent)' },
    { ok: false, h: 'X-Content-Type-Options (absent)' },
    { ok: false, h: 'X-Frame-Options (absent)' },
    { ok: false, h: 'Content-Security-Policy complet (absent, seul upgrade present)' },
    { ok: false, h: 'Permissions-Policy (absent)' },
    { ok: false, h: 'Referrer-Policy (absent)' },
  ],
  schema: [
    { item: 'Fiche metier (Electrician) presente', ok: true },
    { item: 'Nom, adresse, telephone declares', ok: true },
    { item: 'Horaires declares', ok: true },
    { item: 'Note Google (38 avis 5/5) non remontee dans Search', ok: false },
    { item: 'Reseaux sociaux non lies a la fiche', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Absent' },
    { item: 'og:description', ok: false, val: 'Absent' },
    { item: 'og:image', ok: false, val: 'Absent' },
    { item: 'og:type', ok: false, val: 'Absent' },
    { item: 'og:url', ok: false, val: 'Absent' },
  ],
  seo: [
    { item: 'Title present et optimise localement (Nancy)', ok: true },
    { item: 'Un seul H1 par page', ok: true },
    { item: 'HTTPS actif', ok: true },
    { item: 'Sitemap present', ok: true },
    { item: 'Robots.txt correct', ok: true },
    { item: 'Meta description trop courte (50 car. au lieu de 120-160)', ok: false },
    { item: 'Vos 38 avis 5/5 non exploites pour le referencement', ok: false },
    { item: 'Version logicielle exposee dans les reponses serveur', ok: false },
    { item: 'Sitemap expose les comptes utilisateurs (risque de securite)', ok: false },
  ],
};
