const verdictHero = 'Sur 5 visiteurs, 3 vous contactent. 1 hesite. 1 repart — elle etait hors cible.';

const constat = 'Votre reputation est votre meilleur atout : 52 avis a 4.9 etoiles et un artisan authentique. Mais votre site perd des clients en urgence — ceux qui cherchent un couvreur pour une fuite maintenant ne trouvent pas votre telephone en moins de 3 secondes. Sur mobile, ils rappellent quelqu\'un d\'autre.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Hors cible', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Bernard',
    age: 58,
    emoji: '🏠',
