    localisation: 'Metz (57000)',
    maturite: 'Comparaison',
    contexte: 'Gere des chantiers importants, cherche un prestataire avec capacite de production et references B2B.',
    impression: 'Image de maison individuelle. "C\'est pour les particuliers." Signal d\'alarme immediat.',
    parcours: [
      ['Hero', 'Image de maison individuelle — pas d\'immeuble en vue.'],
