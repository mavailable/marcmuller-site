---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const isProspection = true;
const formule = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const showUpsell = true;

const title = 'Echo Decouverte — Horn Toiture Moselle | Marc M';
const description = 'Analyse gratuite de horntoiture.fr : simulation de 10 visites clients, frictions identifiees, recommandations prioritaires. Rapport confidentiel.';
const dateGeneration = '1er avril 2026';

// ─── PERSONAS ───
const personas = [
  {
    id: 1, name: 'Sandrine', age: 43, role: 'Proprietaire maison individuelle, Forbach (57)', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Mobile', decision: 'Quitte',
    exp: 1, conf: 3, clarte: 1, emoji: '\u{1F3E0}',
    situation: 'Cherche un couvreur pour renovation toiture apres tempete, compare 3 devis dans le 57',
    parcours: ['Accueil'],
    questionCle: 'Vous intervenez a Forbach ? Quel est votre numero pour un devis ?',
    reponse: 'Non',
    premierImpression: 'Belle photo. Note 4,9 etoile. Mais le numero de telephone est introuvable sur mon mobile.',
    positifs: ['Note 4,9 etoile sur Google', 'Devis gratuit mentionne', 'Belle photo d\'accueil'],
    frictions: ['Telephone invisible sur mobile (Divi/JS)', 'Pas de zone d\'intervention listee', 'Pas de tarif ni fourchette', 'Google Fonts = RGPD', 'Pas de formulaire de contact visible'],
    raisonDecision: 'Elle ne trouve pas le numero en 10 secondes. Elle ferme et passe au couvreur suivant.',
    impactTech: 'Le numero charge via JavaScript Divi est inaccessible quand le JS est lent ou bloque sur mobile.',
  },
  {
    id: 2, name: 'Philippe', age: 58, role: 'Proprietaire, Macheren (57), tuiles cassees', canal: 'Google Maps',
    maturite: 'Decision', device: 'Mobile', decision: 'Convertit',
    exp: 6, conf: 7, clarte: 5, emoji: '\u{1F4CD}',
    situation: 'Trouve Horn Toiture sur Google Maps, voit le numero directement sur la fiche Maps',
    parcours: ['Google Maps', 'Appel direct'],
    questionCle: 'Pouvez-vous venir evaluer ma toiture cette semaine ?',
    reponse: 'Oui',
    premierImpression: 'Numero visible sur Maps. 4,9 etoile / 64 avis. Localisation Macheren = il est pres de chez moi.',
    positifs: ['Numero visible sur Google Maps', '4,9 etoile / 64 avis', 'Localisation confirmee'],
    frictions: ['Site contient trop peu d\'info pour confirmer les competences', 'Pas de RGE affiche'],
    raisonDecision: 'Il appelle depuis Google Maps directement — le site n\'a joue aucun role.',
    impactTech: 'La fiche Google My Business compense les lacunes du site. Mais si la fiche disparait, tout s\'effondre.',
  },
  {
    id: 3, name: 'Thomas', age: 36, role: 'Proprietaire primo-accedant, renovation toiture annees 70', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Desktop', decision: 'Quitte',
    exp: 2, conf: 3, clarte: 2, emoji: '\u{1F527}',
    situation: 'Compare plusieurs couvreurs du 57, cherche des references de realisations',
    parcours: ['Accueil'],
    questionCle: 'Vous avez des photos de chantiers realises ? Des references clients ?',
    reponse: 'Non',
    premierImpression: 'Note Google 4,9 est bien. Devis gratuit. Mais zero photo de chantier, zero temoignage.',
    positifs: ['Note Google 4,9', 'Devis gratuit'],
    frictions: ['Pas de galerie de realisations', 'Pas de temoignages clients', 'Pas de certifications', 'Numero difficile a trouver', 'Pas de description des types de toiture realises'],
    raisonDecision: 'Aucune preuve de competence sur le site. Il va chercher un couvreur qui montre son travail.',
    impactTech: 'Desktop : site charge correctement mais contenu quasi absent.',
  },
  {
    id: 4, name: 'Isabelle', age: 51, role: 'Proprietaire, Sarreguemines, renovation facade', canal: 'Bouche-a-oreille',
    maturite: 'Decision', device: 'Tablette', decision: 'Convertit',
    exp: 5, conf: 8, clarte: 4, emoji: '\u{1F3E1}',
    situation: 'Son voisin a utilise Horn Toiture et recommande chaudement pour la facade',
    parcours: ['Accueil', 'Contact'],
    questionCle: 'Mon voisin est tres content. Vous pouvez me faire un devis pour ma facade ?',
    reponse: 'Oui',
    premierImpression: 'La recommandation voisin fait toute la confiance. Le site confirme que l\'entreprise existe.',
    positifs: ['Recommandation forte', 'Facades mentionnees', 'Devis gratuit'],
    frictions: ['Numero parfois difficile a trouver selon device', 'Pas de page facade dediee'],
    raisonDecision: 'La recommandation voisin fait tout. Elle appelle apres quelques recherches du numero.',
    impactTech: 'Tablette : le JS Divi charge plus facilement que sur mobile. Numero accessible.',
  },
  {
    id: 5, name: 'Karim', age: 39, role: 'Proprietaire Metz, cherche couvreur RGE pour MaPrimeRenov', canal: 'IA (ChatGPT)',
    maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte',
    exp: 1, conf: 2, clarte: 1, emoji: '\u{1F4B0}',
    situation: 'Questionne ChatGPT "couvreur RGE Moselle" — MaPrimeRenov oblige un artisan RGE',
    parcours: ['Accueil'],
    questionCle: 'Vous etes certifie RGE ? Je dois avoir un couvreur RGE pour les aides d\'Etat.',
    reponse: 'Non visible',
    premierImpression: 'Bonne note Google. Mais aucune mention RGE nulle part — c\'est eliminatoire pour mes aides.',
    positifs: ['Bonne note Google', 'Devis gratuit'],
    frictions: ['Aucune mention RGE / Qualibat', 'Sans RGE = MaPrimeRenov impossible = prospect perdu', 'Telephone invisible', 'Site non optimise pour les IA'],
    raisonDecision: 'Pas de RGE visible = il ne peut pas engager ce couvreur pour obtenir MaPrimeRenov. Il repart immediatement.',
    impactTech: 'Site non lisible par les IA. Pas de llms.txt, pas de contenu structure sur les certifications.',
  },
  {
    id: 6, name: 'Muriel', age: 62, role: 'Retraitee, ravalement facade maison de campagne', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Desktop', decision: 'Hesite',
    exp: 3, conf: 4, clarte: 2, emoji: '\u{1F6E1}\u{FE0F}',
    situation: 'Cherche un couvreur pour ravalement de facade et peinture, Moselle Est',
    parcours: ['Accueil'],
    questionCle: 'Vous faites quoi exactement sur les facades ? Enduit, peinture, isolation ?',
    reponse: 'Non',
    premierImpression: '"Façadier" dans le titre, c\'est bien. Mais pas de detail sur les prestations facades.',
    positifs: ['Facadier mentionne dans le titre', 'Note Google rassurante'],
    frictions: ['Pas de page dediee facades', 'Types de travaux non details', 'Pas de photos de ravalement', 'Prix absents'],
    raisonDecision: 'Elle hesite. Elle note le nom et cherchera d\'autres informations. Peut-etre appellera-t-elle.',
    impactTech: 'Desktop : charge correctement. Probleme = absence de contenu sur les facades.',
  },
  {
    id: 7, name: 'Jean-Pierre', age: 67, role: 'Retraite, Stiring-Wendel (57), toiture a refaire', canal: 'Bouche-a-oreille',
    maturite: 'Decision', device: 'Mobile', decision: 'Convertit',
    exp: 4, conf: 8, clarte: 3, emoji: '\u{1F9D3}',
    situation: 'Ami d\'un voisin satisfait par Horn Toiture — cherche juste le numero pour appeler',
    parcours: ['Accueil', 'Google Maps'],
    questionCle: 'Je veux un devis pour ma toiture complete.',
    reponse: 'Oui (via Maps)',
    premierImpression: 'Le site est complique pour trouver le numero. Je passe par Google Maps a la place.',
    positifs: ['Recommandation forte', 'Devis gratuit mentionne'],
    frictions: ['Numero difficile a trouver sur mobile (Divi/JS)', 'Pas de formulaire simple comme alternative'],
    raisonDecision: 'Il finit par trouver le numero via Google Maps. Il appelle malgre la friction.',
    impactTech: 'Mobile : JS Divi = telephone inaccessible. Il contourne par Maps.',
  },
  {
    id: 8, name: 'Nadia', age: 34, role: 'Primo-accedant, cherche couvreur serieux avec garanties', canal: 'Reseaux sociaux',
    maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte',
    exp: 1, conf: 2, clarte: 1, emoji: '\u{1F6AB}',
    situation: 'A vu Horn Toiture mentionne dans un groupe Facebook "proprietaires Moselle"',
    parcours: ['Accueil'],
    questionCle: 'Ce couvreur est serieux ? Il a une assurance decennale ? Des certifications ?',
    reponse: 'Non visible',
    premierImpression: 'Bonne note Google mais je ne vois aucune certification, aucune mention decennale, aucun temoignage.',
    positifs: ['Bonne note Google'],
    frictions: ['Pas de mention assurance decennale', 'Pas de certifications visibles', 'Pas de temoignages', 'Google Fonts RGPD', 'Aucun element de confiance pour primo-accedant'],
    raisonDecision: 'Elle ne voit aucune preuve de serieux. Elle cherche un couvreur avec decennale visible.',
    impactTech: 'Mobile : telephone invisible + aucun element de confiance = double friction.',
  },
  {
    id: 9, name: 'Franck', age: 47, role: 'Artisan boulanger, local commercial toiture plate', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Desktop', decision: 'Hesite',
    exp: 3, conf: 4, clarte: 2, emoji: '\u{1F3EA}',
    situation: 'Cherche un couvreur pour toiture plate de son local commercial a Sarreguemines',
    parcours: ['Accueil'],
    questionCle: 'Vous faites les toitures plates sur locaux commerciaux ? Isolation comprise ?',
    reponse: 'Non clairement',
    premierImpression: 'Couvreur local avec bonne note. Mais pas de distinction entre toiture inclinee et terrasse.',
    positifs: ['Couvreur-facadier local', 'Note Google'],
    frictions: ['Pas de distinction toiture inclinee / terrasse / commerciale', 'Pas de references professionnelles', 'Telephone difficile a trouver'],
    raisonDecision: 'Il hesite. Il note le nom mais cherche d\'autres couvreurs specialises en toiture plate.',
    impactTech: 'Desktop : contenu insuffisant pour distinguer les types de chantiers.',
  },
  {
    id: 10, name: 'Christelle', age: 55, role: 'Proprietaire d\'un bien ancien, toiture ardoise', canal: 'IA (Perplexity)',
    maturite: 'Comparaison', device: 'Desktop', decision: 'Quitte',
    exp: 1, conf: 2, clarte: 1, emoji: '\u{1F3F0}',
    situation: 'Perplexity lui a suggere Horn Toiture — veut verifier la competence ardoise ancienne',
    parcours: ['Accueil'],
    questionCle: 'Vous avez de l\'experience sur les toitures en ardoise ancienne ? Photos de realisations ?',
    reponse: 'Non',
    premierImpression: 'Couvreur Moselle confirme. Mais aucune photo de chantier, aucune mention ardoise.',
    positifs: ['Couvreur Moselle confirme'],
    frictions: ['Pas de galerie materiaux (ardoise, tuile, zinc)', 'Pas de photos de chantiers', 'Pas de specialites mentionnees', 'Site non optimise pour les IA'],
    raisonDecision: 'Aucune preuve de competence ardoise. Elle cherche un couvreur qui presente ses realisations.',
    impactTech: 'Site non lisible par Perplexity pour des requetes sur des materiaux specifiques.',
  },
];

// ─── STATS ───
const avgExp = (personas.reduce((s, p) => s + p.exp, 0) / personas.length).toFixed(1);
const avgConf = (personas.reduce((s, p) => s + p.conf, 0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.clarte, 0) / personas.length).toFixed(1);
const convertis = personas.filter(p => p.decision === 'Convertit').length;
const hesitants = personas.filter(p => p.decision === 'Hesite').length;
const quitte = personas.filter(p => p.decision === 'Quitte').length;
const tauxConv = Math.round((convertis / personas.length) * 100);

// ─── CANAL STATS ───
const canalStats = [
  { canal: 'Google Search', total: 4, conv: 0, hesitant: 2, quitte: 2 },
  { canal: 'Google Maps', total: 1, conv: 1, hesitant: 0, quitte: 0 },
  { canal: 'IA (ChatGPT / Perplexity)', total: 2, conv: 0, hesitant: 0, quitte: 2 },
  { canal: 'Reseaux sociaux', total: 1, conv: 0, hesitant: 0, quitte: 1 },
  { canal: 'Bouche-a-oreille', total: 2, conv: 2, hesitant: 0, quitte: 0 },
];

// ─── FRICTIONS ───
const frictions = [
  { label: 'Telephone invisible sur mobile (charge en JS Divi — non cliquable)', count: 7, severity: 'critique' },
  { label: 'RGE non affiche (disqualifie pour MaPrimeRenov / CEE — 40% des prospects)', count: 4, severity: 'critique' },
  { label: 'Aucune galerie de realisations ni photos de chantiers', count: 6, severity: 'critique' },
  { label: 'Assurance decennale et certifications absentes du site', count: 5, severity: 'haute' },
  { label: 'Google Fonts via Divi (violation RGPD)', count: 10, severity: 'haute' },
  { label: 'Zone d\'intervention non listee (le 57 et alentours)', count: 4, severity: 'moyenne' },
  { label: 'Aucune page dediee facades (second metier non valorise)', count: 3, severity: 'moyenne' },
  { label: 'aggregateRating absent en Schema (4,9 etoile / 64 avis non exploites)', count: 10, severity: 'haute' },
];

// ─── RECOMMANDATIONS ───
const recoHaute = {
  title: 'Rendre le telephone cliquable sur mobile — en HTML natif',
  impact: '7/10 personas',
  detail: 'Le numero charge via JavaScript Divi est la friction numero 1. Sur mobile, si le JS est lent ou bloque, le prospect ne peut pas appeler. La correction est simple : un lien HTML natif <a href="tel:XXXXXXXXXX"> visible des le chargement. Sur un site Astro, c\'est la configuration par defaut. Cette seule correction recupererait immediatement une partie des prospects perdus.'
};
const recosMoyennes = [
  {
    title: 'Afficher la certification RGE (ou mentionner clairement si non certifie)',
    impact: '4 personas directs + SEO',
    detail: 'La certification RGE est obligatoire pour que le client beneficie de MaPrimeRenov et des CEE. Un couvreur non RGE rate 30-40% du marche renovation. Si Horn Toiture est RGE, le mentionner clairement + badge = argument commercial fort. Si non certifie, envisager la certification (RGE Qualibat ou RGE Eco Artisan) — investissement 300-600€ pour acceder au marche des aides d\'Etat.'
  },
  {
    title: 'Ajouter une galerie de 8-10 photos de chantiers realises',
    impact: '6 personas',
    detail: 'Dans le BTP, "voir pour croire" est une condition de confiance. 8 photos de chantiers realises (avant/apres, tuile, ardoise, facade, zinc) transformeraient radicalement le taux de conversion des visiteurs en phase de comparaison. Ces photos existent deja — il suffit de les ajouter au site.'
  },
  {
    title: 'Mentionner l\'assurance decennale + ajouter le Schema.org RoofingContractor',
    impact: '5 personas + SEO',
    detail: '"Artisan assure en decennale" + numero de police = element de confiance fondamental pour les primo-accedants et les projets importants. En parallele, ajouter le Schema.org RoofingContractor avec aggregateRating exploitera les 4,9 etoile / 64 avis en rich snippets Google — amelioration du CTR estimee a +20-30%.'
  },
];

// ─── TECHNIQUE ───
const techVerdicts = [
  { label: 'HTTPS actif', ok: true },
  { label: 'Meta description presente', ok: true },
  { label: 'og:image presente', ok: true },
  { label: 'Robots.txt / Sitemap', ok: true },
  { label: 'Pas d\'analytics intrusif (positif RGPD)', ok: true },
  { label: 'Telephone cliquable sur mobile', ok: false },
  { label: 'aggregateRating Schema.org (64 avis 4,9 etoile)', ok: false },
  { label: 'RGE / Qualibat visible', ok: false },
  { label: 'Galerie de realisations', ok: false },
  { label: 'Polices locales (pas de Google Fonts Divi)', ok: false },
];

// ─── HELPERS ───
function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}
function severityColor(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  if (s === 'moyenne') return 'bg-blue-100 text-blue-800';
  return 'bg-neutral-100 text-neutral-600';
}
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath="/echo/horn-toiture"
>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0f1923;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-15 blur-3xl" style="background: #e67e22;"></div>

    <div class="mx-auto max-w-4xl relative z-10">
      <div class="mb-4 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-orange-500/40">
        <span class="w-2 h-2 rounded-full bg-orange-400"></span>
        <span class="text-sm font-semibold text-white/90">Echo Decouverte &middot; Confidentiel</span>
      </div>

      <h1 class="mb-4 text-3xl font-bold leading-tight text-white md:text-4xl lg:text-5xl">
        Horn Toiture : <span class="text-orange-400">7 prospects sur 10 ne trouvent meme pas le numero</span> pour appeler
      </h1>

      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl mb-8">
        Analyse de <strong class="text-white">horntoiture.fr</strong> — simulation de 10 visites clients reelles, frictions identifiees, recommandations prioritaires. Genere le {dateGeneration}.
      </p>

      <div class="flex flex-wrap gap-4 mb-10">
        <div class="px-6 py-4 rounded-xl bg-green-900/40 border border-green-700/40 text-center">
          <p class="text-2xl font-bold text-green-400">{convertis}</p>
          <p class="text-xs text-green-300 mt-1">contactent</p>
        </div>
        <div class="px-6 py-4 rounded-xl bg-amber-900/40 border border-amber-700/40 text-center">
          <p class="text-2xl font-bold text-amber-400">{hesitants}</p>
          <p class="text-xs text-amber-300 mt-1">hesitent</p>
        </div>
        <div class="px-6 py-4 rounded-xl bg-red-900/40 border border-red-700/40 text-center">
          <p class="text-2xl font-bold text-red-400">{quitte}</p>
          <p class="text-xs text-red-300 mt-1">repartent</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">10 personas simules</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">5 canaux d'arrivee</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">Audit technique inclus</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">{dateGeneration}</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ CONSTAT ═══════════════════ -->
  <div class="w-full px-6 py-10 md:px-8 bg-white">
    <div class="mx-auto max-w-4xl">
      <div class="rounded-xl border-l-4 border-l-orange-500 bg-orange-50 p-6 md:p-8">
        <h2 class="text-lg font-bold text-neutral-900 mb-2">Le probleme de Horn Toiture</h2>
        <p class="text-neutral-800 leading-relaxed">
          Horn Toiture a une <strong>note Google solide (4,9 etoile / 64 avis)</strong> et une reputation locale reelle. Mais le site perd la majorite de ses prospects a cause d'une friction technique basique : <strong>le numero de telephone est charge via JavaScript Divi et n'est pas cliquable sur mobile.</strong> Pour un artisan BTP ou 90% des contacts se font par appel, c'est une friction fatale. En parallele, l'absence de certification RGE visible disqualifie 40% des prospects qui cherchent les aides d'Etat MaPrimeRenov.
        </p>
      </div>
    </div>
  </div>

  <!-- ═══════════════════ CANAUX ═══════════════════ -->
  <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-neutral-50">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Conversion par canal</h2>
      <p class="text-neutral-500 mb-8">Seuls le bouche-a-oreille et Google Maps convertissent (les visiteurs contournent le site). Google Search, reseaux sociaux et IA : 0%.</p>
      <div class="grid md:grid-cols-2 gap-4">
        {canalStats.map((c) => {
          const pct = c.total > 0 ? Math.round((c.conv / c.total) * 100) : 0;
          return (
            <div class="rounded-xl border border-neutral-200 bg-white p-5">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-semibold text-neutral-900 text-sm">{c.canal}</h3>
                <span class={`text-lg font-bold ${pct > 50 ? 'text-emerald-600' : pct > 0 ? 'text-amber-600' : 'text-red-600'}`}>{pct}%</span>
              </div>
              <div class="h-3 rounded-full bg-neutral-100 overflow-hidden mb-3">
                <div class="h-full rounded-full flex">
                  <div class="bg-emerald-500" style={`width: ${c.total > 0 ? (c.conv / c.total) * 100 : 0}%`}></div>
                  <div class="bg-amber-400" style={`width: ${c.total > 0 ? (c.hesitant / c.total) * 100 : 0}%`}></div>
                  <div class="bg-red-400" style={`width: ${c.total > 0 ? (c.quitte / c.total) * 100 : 0}%`}></div>
                </div>
              </div>
              <div class="flex gap-4 text-xs text-neutral-400">
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> {c.conv} conv.</span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-400"></span> {c.hesitant} hes.</span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-400"></span> {c.quitte} partis</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- ═══════════════════ PERSONAS ═══════════════════ -->
  <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-white">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">10 visites simulees</h2>
      <p class="text-neutral-500 mb-8">Clients types qui visitent horntoiture.fr — profils, parcours, et raison de leur decision.</p>

      <div class="space-y-8">

        {/* Convertit */}
        <div>
          <h3 class="text-base font-bold text-emerald-700 mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Ceux qui contactent ({convertis})
          </h3>
          <div class="space-y-3">
            {personas.filter(p => p.decision === 'Convertit').map((p) => (
              <details class={`group border ${decisionBorder(p.decision)} rounded-xl overflow-hidden`}>
                <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                      <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                      <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                      <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                    </div>
                    <p class="text-xs text-neutral-500 mb-2">{p.role}</p>
                    <div class="flex flex-wrap items-center gap-1">
                      {p.parcours.map((page, i) => (
                        <Fragment>
                          <span class="text-[10px] text-neutral-600 bg-white border border-neutral-200 px-1.5 py-0.5 rounded">{page}</span>
                          {i < p.parcours.length - 1 && <span class="text-neutral-300 text-[10px]">&rsaquo;</span>}
                        </Fragment>
                      ))}
