const ameliorationsHautes = [
  {
    titre: 'Afficher le numero de telephone en haut de chaque page, cliquable, sans scroll',
    pourquoi: '60% des visiteurs d\'un couvreur arrivent en situation d\'urgence sur mobile. Ils cherchent un numero a appeler en moins de 3 secondes. Actuellement, votre telephone est tout en bas de la one-page — Bernard a du scroller toute la page avant de le trouver. En urgence, la moitie des visiteurs rappellent le prochain couvreur de la liste Google avant d\'arriver en bas.',
    action: 'Ajouter le 07.86.10.17.61 dans le header fixe (menu), visible en permanence sur mobile et desktop. Sous forme de lien tel: tapable en 1 clic. Idealement avec la mention "Disponible 6j/7" ou "Urgence : rappel rapide".',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A ameliorer', ok: false, detail: 'WordPress Divi, page 257Ko, cache desactive — probablement lent sur mobile' },
  { label: 'Securite', verdict: 'D-', ok: false, detail: 'Grade D- Observatory — 5 headers de securite manquants sur 10' },
  { label: 'SEO', verdict: 'Correct', ok: true, detail: 'Meta title/description, H1, alt images, sitemap, robots.txt — OK' },
  { label: 'Donnees structurees', verdict: 'Incomplet', ok: false, detail: 'JSON-LD present mais type LocalBusiness absent — adresse, tel, horaires non structures' },
  { label: 'Partage reseaux', verdict: 'Partiel', ok: false, detail: 'Open Graph OK, Twitter Cards incomplets (title/description/image absents)' },
];

const tech = {
  observatory: { grade: 'D-', score: 25, testsOk: 5, testsTotal: 10 },
  pagespeedMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespeedDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
