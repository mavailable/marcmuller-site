    situation: 'Retraite de la mine, maison de 1960 a Carling, recommande par son voisin',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Venait juste confirmer et trouver le numero. La recommendation du voisin pesait plus que tout — le site a fait son job en confirmant le serieux.',
    localisation: 'Carling (57490)',
    maturite: 'Decision',
    contexte: 'Son voisin a fait refaire sa toiture par Horn. Il veut juste le contact pour prendre rendez-vous.',
    impression: 'Reconnait le nom. Cherche le menu "Contact & Devis". Navigation directe.',
    parcours: [
