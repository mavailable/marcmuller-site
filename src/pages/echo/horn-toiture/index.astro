    frictions: ['Telephone invisible dans le header', 'Aucune mention "intervention urgence" ou "rappel sous 2h"', 'Doit scroller toute la one-page pour trouver le contact', 'Aucun prix indicatif'],
    ceQuiFeraitBasculer: 'Un numero de telephone cliquable en haut de page, visible sans scroll, avec la mention "Urgences bienvenues".',
    exp: 6, conf: 7, clarte: 6,
  },
  {
    id: 2,
    name: 'Stephanie',
    age: 42,
    emoji: '📱',
