      ['Contact', 'Ne remplit pas. "Je veux d\'abord une idee du budget."'],
    ] as [string, string][],
    questionCle: 'Suis-je dans leur budget ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune fourchette, aucun exemple chiffre. Impossible de comparer avec ses autres devis.',
    impactVitesse: 'Chargement lent sur mobile — la galerie Instagram prend du temps a afficher.',
    impactConfiance: 'Les 52 avis 4.9 sont le seul signal fort de confiance. Sans eux, elle serait partie plus tot.',
    positifs: ['Note Google integree directement dans le site', 'Temoignages authentiques et detailles', 'Garantie decennale mentionnee', 'Zone d\'intervention precise (liste de villes)'],
