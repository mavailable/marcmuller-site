      ['Menu Contact & Devis', 'Clique directement depuis le menu.'],
      ['Section contact', 'Telephone + email + adresse + horaires. Satisfait. Appelle.'],
    ] as [string, string][],
    questionCle: 'Comment je les contacte ?',
    reponse: 'Oui' as const,
    commentReponse: 'Le menu "Contact & Devis" est clair, la section contact contient tout. Navigation directe et efficace.',
