          <div class="flex items-center gap-6 py-4">
            <div class="text-center">
              <div class="text-4xl font-black text-green-600 leading-none">{tech.observatory.grade}</div>
              <div class="text-xs text-neutral-500 mt-1">Grade Mozilla</div>
            </div>
            <div class="text-center">
              <div class="text-4xl font-black text-green-600 leading-none">{tech.observatory.score}</div>
              <div class="text-xs text-neutral-500 mt-1">Score /100</div>
            </div>
            <div class="text-center">
              <div class="text-4xl font-black text-green-600 leading-none">{tech.observatory.testsOk}/{tech.observatory.testsTotal}</div>
              <div class="text-xs text-neutral-500 mt-1">Tests passes</div>
            </div>
          </div>
          <div class="space-y-1">
            {tech.headers.map(h => (
              <div class="flex items-center gap-2 text-xs text-neutral-600">
                <span class="text-green-500 shrink-0">✓</span>
                <span>{h.h}</span>
              </div>
            ))}
          </div>
        </div>
      </details>

      <!-- Schema.org -->
      <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
        <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
          <div class="flex items-center gap-3">
            <span class="text-base">📊</span>
            <div>
              <h3 class="font-semibold text-neutral-900 text-sm">Donnees structurees (Schema.org)</h3>
              <p class="text-[11px] text-neutral-500">{techVerdicts[3].detail}</p>
            </div>
          </div>
          <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-4 pb-4 border-t border-neutral-100 pt-4">
          <div class="space-y-2">
            {tech.schema.map(s => (
              <div class="flex items-start gap-2 text-xs text-neutral-600">
                <span class={`shrink-0 font-bold ${s.ok ? 'text-green-500' : 'text-red-400'}`}>{s.ok ? '✓' : '✗'}</span>
                <span>{s.item}</span>
              </div>
            ))}
          </div>
        </div>
      </details>

      <!-- Open Graph -->
      <details class="group border-2 border-red-200 rounded-xl overflow-hidden mb-3 bg-white">
        <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-red-50/30">
          <div class="flex items-center gap-3">
            <span class="text-base">🔗</span>
            <div>
              <h3 class="font-semibold text-red-800 text-sm">Partage reseaux sociaux (Open Graph)</h3>
              <p class="text-[11px] text-red-500">{techVerdicts[4].detail}</p>
            </div>
          </div>
          <svg class="w-4 h-4 text-red-300 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-4 pb-4 border-t border-red-100 pt-4">
          <div class="space-y-2">
            {tech.og.map(o => (
              <div class="flex items-start gap-2 text-xs">
                <span class={`shrink-0 font-bold ${o.ok ? 'text-green-500' : 'text-red-400'}`}>{o.ok ? '✓' : '✗'}</span>
                <span class="text-neutral-700 font-mono">{o.item}</span>
                <span class="text-neutral-400 ml-auto">{o.val}</span>
              </div>
            ))}
          </div>
        </div>
      </details>

      <!-- SEO -->
      <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
        <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
          <div class="flex items-center gap-3">
            <span class="text-base">🔍</span>
            <div>
              <h3 class="font-semibold text-neutral-900 text-sm">SEO technique</h3>
              <p class="text-[11px] text-neutral-500">{techVerdicts[2].detail}</p>
            </div>
          </div>
          <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-4 pb-4 border-t border-neutral-100 pt-4">
          <div class="space-y-2">
            {tech.seo.map(s => (
              <div class="flex items-start gap-2 text-xs text-neutral-600">
                <span class={`shrink-0 font-bold ${s.ok ? 'text-green-500' : 'text-red-400'}`}>{s.ok ? '✓' : '✗'}</span>
                <span>{s.item}</span>
              </div>
            ))}
          </div>
        </div>
      </details>
    </div>
  </section>

  <!-- ═══ METHODOLOGIE ═══ -->
  <section class="py-12 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-neutral-900 mb-4">Comment on a fait ca</h2>
      <div class="grid md:grid-cols-3 gap-4 text-sm text-neutral-600">
        <div class="bg-white rounded-xl p-4 border border-neutral-200">
          <div class="text-2xl font-black text-neutral-300 mb-2">1</div>
          <p class="font-semibold text-neutral-800 mb-1">Scraping complet</p>
          <p class="text-xs">Lecture de toutes les pages accessibles — services, portfolio, FAQ, blog, mentions legales.</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-neutral-200">
          <div class="text-2xl font-black text-neutral-300 mb-2">2</div>
          <p class="font-semibold text-neutral-800 mb-1">Audit technique</p>
          <p class="text-xs">Lighthouse mobile + desktop, Mozilla Observatory, Schema.org, Open Graph, robots.txt, sitemap.</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-neutral-200">
          <div class="text-2xl font-black text-neutral-300 mb-2">3</div>
          <p class="font-semibold text-neutral-800 mb-1">20 personas simules</p>
          <p class="text-xs">Profils realistes adaptes a votre secteur (escape game B2B) — 6 canaux d'arrivee, 3 niveaux de maturite, 12 appareils mobiles.</p>
        </div>
      </div>
      <p class="text-xs text-neutral-400 mt-4 text-center">20 visiteurs = tendances confirmees &middot; 100 visiteurs (Echo Pro) = certitude statistique</p>
    </div>
  </section>

  <!-- ═══ CTA FINAL ═══ -->
  <section class="py-16 border-t border-neutral-200">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-neutral-900 mb-3">Votre site a de vraies forces.</h2>
      <p class="text-neutral-600 mb-8">3 corrections techniques et des pages portfolio detaillees peuvent transformer ces 45% de conversion en 65%+. Je peux m'en occuper — ou juste vous guider.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/echo/" class="inline-flex items-center gap-2 px-6 py-3 text-white font-semibold rounded-xl transition-all shadow-md hover:-translate-y-0.5" style="background: linear-gradient(135deg, #E86C47, #D4572F);">
          Passer a l'Echo Pro — 250€
          <span class="text-xs opacity-70">(100 visiteurs + appel)</span>
        </a>
        <a href="/contact/" class="inline-flex items-center gap-2 px-6 py-3 border border-neutral-300 text-neutral-700 font-semibold rounded-xl transition-all hover:border-neutral-500">
          En discuter avec Marc
        </a>
      </div>
      <p class="text-xs text-neutral-400 mt-6">Ce rapport est confidentiel et non indexe par Google &middot; Genere le {dateAudit}</p>
    </div>
  </section>

</BaseLayout>
