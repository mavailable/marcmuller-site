            const scores = [tech.pagespdMobile!.performance, tech.pagespdMobile!.accessibility, tech.pagespdMobile!.bestPractices, tech.pagespdMobile!.seo];
            const score = scores[i];
            const color = score >= 90 ? '#22c55e' : score >= 50 ? '#f59e0b' : '#ef4444';
            return (
              <div class="text-center">
                <div class="relative w-14 h-14 mx-auto mb-2">
                  <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
