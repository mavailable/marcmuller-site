                  </svg>
                  <span class="absolute inset-0 flex items-center justify-center text-sm font-bold" style={`color: ${color}`}>{score}</span>
                </div>
                <p class="text-[11px] text-neutral-600">{label}</p>
              </div>
            );
          })}
        </div>
