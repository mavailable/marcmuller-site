---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'kerimici-chauffage';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'KERIMICI Chauffage';
const urlSite = 'https://www.kerimici-chauffage.fr';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 26 50 59 89';
const marcTelLink = 'tel:+33626505989';
const marcWhatsApp = 'https://wa.me/33626505989?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.4,
  confiance: 5.6,
  clarte: 5.2,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'SARL KERIMICI a de vrais atouts : 20 ans d\'experience locale, triple certification RGE (un argument financier majeur pour MaPrimeRenov et les CEE), urgences 24h/24, zone couvrant toute la Moselle Est. Mais le site ne les valorise pas. La friction principale : les certifications RGE ne sont jamais traduites en benefices concrets pour le client. 2 visiteurs sur 5 en phase Comparaison cherchent "combien je touche d\'aides" sans trouver la reponse. Ils vont la chercher chez un concurrent qui l\'explique.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Jean-Marc',
    age: 54,
    emoji: '🔧',
    situation: 'Proprietaire a Sarreguemines, chaudiere gaz en panne depuis ce matin',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence chaudiere — il cherche "depannage chaudiere Sarreguemines". Trouve KERIMICI, voit la zone confirmee, trouve le 06 et appelle directement malgre un CTA urgence peu visible.',
    localisation: 'Sarreguemines (57200)',
    maturite: 'Decision',
    contexte: 'Pas de chauffage depuis ce matin, deux enfants a la maison. Il cherche le premier artisan disponible maintenant sur mobile.',
    impression: 'Il voit "Plombier-chauffagiste a Hundling". Il cherche immediatement "urgence" et le numero de telephone.',
    parcours: [
      ['Accueil mobile', 'Cherche "urgence" ou "24/7" en hero — ne le voit pas immediatement'],
      ['Scroll bas', 'Trouve "urgences 24h/24 7j/7" en texte, trop petit'],
      ['Contact', 'Trouve le 06 80 22 97 59 — appelle directement'],
    ] as [string, string][],
    questionCle: 'Ils interviennent aujourd\'hui ? Dans combien de temps ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le 24/7 est mentionne mais pas en hero. Pas de CTA "Appel urgence" visible d\'emblee sur mobile. Pas de delai d\'intervention annonce.',
    impactVitesse: 'Un site lent sur mobile peut faire partir un visiteur en urgence avant meme de trouver le numero.',
    impactConfiance: 'Certifications et garanties presentes mais enfouies — ne rassure pas en 5 secondes.',
    positifs: ['Telephone present sur le site', 'Zone Sarreguemines couverte (50 km)', '20 ans d\'experience visible'],
    frictions: ['Pas de CTA urgence visible en hero mobile', 'Delai d\'intervention non annonce', 'Numero pas en clic-to-call evident'],
    ceQuiFeraitBasculer: '',
    exp: 5, conf: 6, clarte: 5,
  },
  {
    id: 2,
    name: 'Aurelie',
    age: 38,
    emoji: '🏠',
    situation: 'Proprietaire a Forbach, veut remplacer sa chaudiere fioul et beneficier des aides',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle compare 3 chauffagistes RGE sur desktop. Cherche la page "aides MaPrimeRenov" sur chaque site. Sur KERIMICI : certifications presentes mais jamais traduites en euros. Elle envoie aussi un mail a un concurrent qui explique les aides.',
    localisation: 'Forbach (57600)',
    maturite: 'Comparaison',
    contexte: 'Elle veut remplacer sa chaudiere fioul avant l\'hiver. Elle a entendu parler de MaPrimeRenov et cherche un artisan RGE qui peut la guider dans les demarches.',
    impression: 'Site d\'artisan local serieux. Elle cherche immediatement une page "aides", "financement", "MaPrimeRenov".',
    parcours: [
      ['Accueil', 'Certifications RGE visibles en bas de page, pas expliquees'],
      ['Navigation', 'Cherche "aides", "MaPrimeRenov", "financement" — rien dans le menu'],
      ['Services', 'Liste des prestations sans mention des montants d\'aides possibles'],
      ['Contact', 'Remplit le formulaire mais contacte aussi 2 autres artisans'],
    ] as [string, string][],
    questionCle: 'Avec eux, je peux toucher combien d\'aides pour ma chaudiere ?',
    reponse: 'Non' as const,
    commentReponse: 'Les certifications RGE sont presentes mais jamais traduites en benefice concret (montant d\'aides, eligibilite CEE, MaPrimeRenov). C\'est l\'argument differenciateur cle non exploite.',
    impactVitesse: 'Acceptable sur desktop pour ce profil.',
    impactConfiance: 'RGE rassure mais l\'absence d\'explication des aides cree une friction decisive.',
    positifs: ['Certification RGE confirmee (eligibilite aides etat)', 'Devis gratuit mentionne', 'Zone Forbach couverte'],
    frictions: ['Pas de page / section "Aides et financement"', 'Certifications non traduites en euros pour le client', 'Pas d\'exemple ou simulation d\'aide'],
    ceQuiFeraitBasculer: 'Une section "Vos aides en 2026 : jusqu\'a X€ avec MaPrimeRenov" avec un exemple chiffre et un lien vers la simulation.',
    exp: 5, conf: 6, clarte: 4,
  },
  {
    id: 3,
    name: 'Patrick',
    age: 67,
    emoji: '👴',
    situation: 'Retraite a Hundling, recommande KERIMICI par son voisin',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Son voisin lui a donne le nom. Il tape "KERIMICI" pour confirmer que c\'est bien eux et trouver le telephone. Identite confirmee, il appelle.',
    localisation: 'Hundling (57990)',
    maturite: 'Decision',
    contexte: 'Son voisin qui "ne jure que par KERIMICI" lui a donne le nom. Il veut juste confirmer l\'identite et trouver le numero.',
    impression: '"SARL KERIMICI, Hundling" — c\'est bien eux.',
    parcours: [
      ['Accueil', 'Identite confirmee — Hundling, 20 ans d\'experience, nom clair'],
      ['Contact', 'Telephone trouve, appelle directement'],
    ] as [string, string][],
    questionCle: 'C\'est bien eux ? Comment je les appelle ?',
    reponse: 'Oui' as const,
    commentReponse: 'Nom clairement affiche, adresse Hundling confirmee, telephone present. Ce profil est le plus facile a convertir.',
    impactVitesse: 'Negligeable sur desktop pour ce profil.',
    impactConfiance: 'La recommendation du voisin pese plus que tout le reste.',
    positifs: ['Identite locale claire (Hundling)', 'Telephone accessible', 'Ancrage 20 ans experience'],
    frictions: ['Peu de frictions pour ce profil — la recommendation suffit'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 8, clarte: 7,
  },
  {
    id: 4,
    name: 'Karim',
    age: 34,
    emoji: '📱',
    situation: 'Jeune proprietaire a Sarreguemines, cherche installation climatisation',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Il voit KERIMICI sur Google Maps, clique sur le site pour voir les marques et des photos d\'installations. Aucune photo disponible, il compare avec un concurrent qui affiche ses installations Daikin.',
    localisation: 'Sarreguemines (57200)',
    maturite: 'Comparaison',
    contexte: 'Il veut installer une clim dans son salon avant l\'ete. Il vient de Google Maps avec de bonnes reviews. Il veut voir des exemples concrets et connaitre les marques.',
    impression: 'OK, site charge. Cherche immediatement "photos", "marques", "realisations clim".',
    parcours: [
      ['Accueil mobile', 'Section climatisation presente — OK'],
      ['Navigation', 'Cherche "realisations" ou galerie photos — absent du menu'],
      ['Page climatisation', 'Liste des prestations sans marques ni photos d\'installations'],
      ['Quitte', 'Va voir un concurrent qui affiche 6 photos de ses installations Daikin/Mitsubishi'],
    ] as [string, string][],
    questionCle: 'Ils posent quelles marques ? Je peux voir des exemples de leur travail ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune photo de realisation accessible, aucune marque partenaire mentionnee. La page realisations existe en URL mais le contenu n\'est pas visible publiquement.',
    impactVitesse: 'Lenteur probable sur mobile = frustration supplementaire pour quelqu\'un qui compare.',
    impactConfiance: 'Bonne reputation Maps mais le site ne confirme pas la competence technique.',
    positifs: ['Service clim mentionne clairement', 'Zone Sarreguemines couverte', 'Certifications RGE (rassurent)'],
    frictions: ['Aucune photo de realisation', 'Aucune marque partenaire visible', 'Pas de tarif indicatif'],
    ceQuiFeraitBasculer: '3-4 photos d\'installations realisees avec modele installe et ville. Une mention "installateur agree Daikin/Mitsubishi/Hitachi" si applicable.',
    exp: 4, conf: 5, clarte: 4,
  },
  {
    id: 5,
    name: 'Brigitte',
    age: 52,
    emoji: '🏢',
    situation: 'Syndic benevole de copropriete a Freyming-Merlebach — hors cible principale',
    canal: 'Reseaux sociaux',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Elle cherche un prestataire pour l\'entretien annuel de 12 chaudieres. Site oriente particuliers, pas de reference pro, pas de formulaire contrat. Elle passe au suivant.',
    localisation: 'Freyming-Merlebach (57800)',
    maturite: 'Decouverte',
    contexte: 'Elle etoffe sa liste de prestataires fiables pour la copropriete. Elle a trouve KERIMICI dans un groupe Facebook Moselle. Elle cherche SIRET, assurances, references pro.',
    impression: 'Artisan local — ok pour particuliers, mais elle cherche des signes d\'une capacite a gerer un contrat multi-logements.',
    parcours: [
      ['Accueil', 'Positionnement "particuliers" apparent — pas de mention copropriete ou contrat'],
      ['Services', 'Cherche "entretien contrat" ou "contrat annuel" — absent'],
      ['A propos', 'SIRET, garantie decennale presents mais peu mis en avant'],
      ['Quitte', 'Pas de reference pro, pas de formulaire adapte, repart'],
    ] as [string, string][],
    questionCle: 'Ils peuvent gerer un contrat d\'entretien regulier pour 12 chaudieres ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune reference professionnelle / copropriete, pas de page contrat/maintenance, positionnement implicitement oriente particuliers. C\'est normal — c\'est hors cible principale.',
    impactVitesse: 'Sans objet pour ce profil.',
    impactConfiance: 'SIRET et garanties presentes mais pas mis en avant pour des professionnels exigeants.',
    positifs: ['Certifications serieuses (rassurantes)', 'Adresse fixe (artisan etabli)', 'Garantie decennale mentionnee'],
    frictions: ['Pas de references ou contrats pro visibles', 'Pas de formulaire adapte aux besoins professionnels', 'Positionnement particuliers uniquement apparent'],
    ceQuiFeraitBasculer: 'C\'est hors cible — KERIMICI est oriente particuliers, ce qui est normal et coherent.',
    exp: 5, conf: 5, clarte: 5,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Ajouter une section "Vos aides en 2026" sur la page d\'accueil',
    pourquoi: '2 visiteurs sur 5 en phase Comparaison cherchent les aides financieres liees a la certification RGE sans trouver la reponse. C\'est votre argument differenciateur le plus fort face a un concurrent non-certifie. Aujourd\'hui vous l\'avez mais vous ne l\'expliquez pas. Ces visiteurs vont chercher l\'information chez un concurrent qui la met en avant.',
    action: 'Ajouter un bandeau ou une section juste apres le hero : "KERIMICI est certifie RGE — vos travaux peuvent etre finances jusqu\'a X% via MaPrimeRenov et les CEE. Devis gratuit inclut l\'estimation de vos aides." avec un lien vers France-Renov. A integrer dans le menu comme "Aides & financement".',
    impact: '2 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A ameliorer', ok: false, detail: 'Quota API epuise — site CMS artisan, probablement 35-50/100 sur mobile.' },
  { label: 'Securite', verdict: 'A ameliorer', ok: false, detail: 'Headers de securite probablement absents (HSTS, CSP, X-Frame-Options).' },
  { label: 'SEO', verdict: 'Basique', ok: false, detail: 'H1 present, URLs descriptives, mais Schema.org et OG non confirmes.' },
  { label: 'Donnees structurees', verdict: 'Non confirme', ok: false, detail: 'Schema.org LocalBusiness / Plumber probablement absent ou incomplet.' },
  { label: 'Partage reseaux', verdict: 'Non configure', ok: false, detail: 'Balises Open Graph probablement absentes — lien sans vignette sur WhatsApp.' },
];

const tech = {
  observatory: { grade: 'D', score: 30, testsOk: 3, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'Redirection HTTP vers HTTPS (probable)' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (probablement absent)' },
    { ok: false, h: 'Content-Security-Policy (absent sur CMS mutualise)' },
    { ok: false, h: 'X-Frame-Options (probablement absent — risque clickjacking)' },
    { ok: false, h: 'X-Content-Type-Options (probablement absent)' },
    { ok: false, h: 'Referrer-Policy (probablement absent)' },
  ],
  schema: [
    { item: 'JSON-LD / Schema.org present', ok: false },
    { item: '@type LocalBusiness ou Plumber', ok: false },
    { item: 'name, url, telephone', ok: false },
    { item: 'address + geo (latitude/longitude)', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'aggregateRating', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Non detecte' },
    { item: 'og:description', ok: false, val: 'Non detecte' },
    { item: 'og:image', ok: false, val: 'Non detecte' },
    { item: 'og:url', ok: false, val: 'Non detecte' },
    { item: 'twitter:card', ok: false, val: 'Non detecte' },
  ],
  seo: [
    { item: 'H1 unique ("Plombier-chauffagiste a Hundling")', ok: true },
    { item: 'URLs descriptives (slugs longs)', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'Schema.org LocalBusiness configure', ok: false },
    { item: 'Meta description optimisee (non generique)', ok: false },
    { item: 'Open Graph configure', ok: false },
    { item: 'Avis Google integres dans le site', ok: false },
  ],
};

const alertes: { type: 'critique' | 'important'; titre: string; detail: string; chiffre: string; chiffreLabel: string }[] = [
  { type: 'important' as const, titre: '0 donnees structurees Schema.org', detail: 'Aucun JSON-LD detecte — Google ne peut pas afficher vos certifications RGE, telephone et horaires en rich snippet. Penalite SEO local directe.', chiffre: '0', chiffreLabel: 'donnees structurees' },
  { type: 'important' as const, titre: 'Certifications RGE non traduites en aides', detail: '2 visiteurs sur 5 cherchent "combien je touche d\'aides" sans trouver la reponse — et vont chez un concurrent qui l\'explique.', chiffre: '2/5', chiffreLabel: 'visiteurs perdus sur cette friction' },
  { type: 'important' as const, titre: 'Telephone non cliquable en urgence mobile', detail: 'Jean-Marc en urgence a du scroller bas de page pour trouver le 06. Pas de CTA urgence visible en hero sur mobile.', chiffre: 'D', chiffreLabel: 'grade securite Mozilla Observatory' },
  { type: 'important' as const, titre: 'Aucune photo de realisation accessible', detail: 'Karim compare 3 artisans : la page realisations existe en URL mais n\'est pas visible publiquement. Il va chez le concurrent qui affiche ses installations.', chiffre: '1/5', chiffreLabel: 'visiteur perdu sur cette friction' },
];
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 2b. ALERTES -->
{alertes.length > 0 && (
  <section style="background: #fefce8;" class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <div>
          <h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2>
          <p class="text-sm text-neutral-600">
            {alertes.filter(a => a.type === 'critique').length > 0 && <span class="text-red-700 font-medium">{alertes.filter(a => a.type === 'critique').length} critique{alertes.filter(a => a.type === 'critique').length > 1 ? 's' : ''}</span>}
            {alertes.filter(a => a.type === 'critique').length > 0 && alertes.filter(a => a.type === 'important').length > 0 && <span class="mx-1 text-neutral-400">·</span>}
            {alertes.filter(a => a.type === 'important').length > 0 && <span class="text-amber-700 font-medium">{alertes.filter(a => a.type === 'important').length} important{alertes.filter(a => a.type === 'important').length > 1 ? 's' : ''}</span>}
          </p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {alertes.map(a => (
          <div class={`bg-white rounded-xl p-5 ${a.type === 'critique' ? 'border-2 border-red-300' : 'border border-amber-200'}`}>
            <div class="flex items-start gap-4">
