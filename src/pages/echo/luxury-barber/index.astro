---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const isProspection = true;
const formule = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const showUpsell = true;

const title = 'Echo Decouverte — Luxury Barber Nancy | Marc M';
const description = 'Analyse gratuite de luxurybarber.fr : simulation de 10 visites clients, frictions identifiees, recommandations prioritaires. Rapport confidentiel.';
const dateGeneration = '1er avril 2026';

// ─── PERSONAS ───
const personas = [
  {
    id: 1, name: 'Kevin', age: 28, role: 'Commercial terrain', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Mobile', decision: 'Hesite',
    exp: 5, conf: 6, clarte: 5, emoji: '\u{1F4BC}',
    situation: 'Nancy centre, compare 3 barbiers avant de choisir, cherche le meilleur rapport qualite/image',
    parcours: ['Accueil', 'Tarifs', 'Galerie'],
    questionCle: 'C\'est quoi exactement le forfait Prestige ? Le black mask ca donne quoi comme resultat ?',
    reponse: 'Partiellement',
    premierImpression: 'Bonne note Google, tarifs lisibles. Mais les forfaits ne sont pas expliques — je vois un prix, pas une promesse.',
    positifs: ['Note 4,9 rassurante', 'Tarifs clairement affiches', 'Galerie professionnelle'],
    frictions: ['Pas de description des forfaits', 'Pas de photos avant/apres', 'Lien reservation via bit.ly peu rassurant', 'GA4 sans banniere consent'],
    raisonDecision: 'Il hesite. Les prix sont la mais il ne comprend pas ce qu\'inclut chaque forfait. Il met le numero en favori et "verra plus tard".',
    impactTech: 'Mobile correct mais GA4 sans consentement = violation RGPD visible pour un profil attentif.',
  },
  {
    id: 2, name: 'Thomas', age: 35, role: 'Cadre en entreprise', canal: 'Google Maps',
    maturite: 'Decision', device: 'Mobile', decision: 'Convertit',
    exp: 7, conf: 8, clarte: 7, emoji: '\u{1F454}',
    situation: 'Cherche le meilleur barbier Nancy, a vu le 4,9 etoile sur Google Maps',
    parcours: ['Google Maps', 'Accueil', 'Reservation'],
    questionCle: 'Je peux reserver pour samedi matin ?',
    reponse: 'Oui',
    premierImpression: '4,9/5 sur 126 avis — c\'est le meilleur de Nancy selon Google. Le site confirme les horaires et les tarifs.',
    positifs: ['Note 4,9 decisive', 'Tarifs visibles', 'Tel cliquable', 'Horaires clairs'],
    frictions: ['Bit.ly peu rassurant pour un lien de reservation', 'Pas d\'apercu du calendrier en ligne'],
    raisonDecision: 'La note Google a decide. Il clique sur le lien de reservation malgre le bit.ly.',
    impactTech: 'Mobile fluide. La note Maps fait le travail que le site ne fait pas.',
  },
  {
    id: 3, name: 'Karim', age: 22, role: 'Etudiant, passionné de style', canal: 'Reseaux sociaux',
    maturite: 'Decouverte', device: 'Mobile', decision: 'Convertit',
    exp: 8, conf: 7, clarte: 7, emoji: '\u{2702}\u{FE0F}',
    situation: 'Fan de degrades nets, a vu des photos du barbier sur Instagram',
    parcours: ['Instagram', 'Accueil', 'Galerie', 'Reservation'],
    questionCle: 'Ils font les degrades peau ? Les lignes nettes ?',
    reponse: 'Oui',
    premierImpression: 'La galerie 10 photos montre exactement ce que je cherche. "Tracage" dans les services = c\'est eux.',
    positifs: ['Galerie 10 photos de qualite', 'Tracage et degrades mentionnes', 'Ambiance premium visible'],
    frictions: ['Pas de page Instagram liee depuis le site', 'Galerie limitee a 10 photos'],
    raisonDecision: 'Les photos l\'ont convaincu. Il reserve via bit.ly sans hesiter.',
    impactTech: 'Parcours Instagram → site → reservation fluide sur mobile.',
  },
  {
    id: 4, name: 'Philippe', age: 47, role: 'Chef d\'entreprise', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Desktop', decision: 'Quitte',
    exp: 3, conf: 5, clarte: 3, emoji: '\u{1F381}',
    situation: 'Cherche un bon cadeau pour offrir a son fils (anniversaire) — un soin barbier premium',
    parcours: ['Accueil', 'Tarifs'],
    questionCle: 'Vous proposez des cartes cadeaux ? Un bon pour offrir ?',
    reponse: 'Non',
    premierImpression: 'Site propre, tarifs visibles. Mais je cherche une option cadeau — introuvable.',
    positifs: ['Tarifs clairs (30-50€ = fourchette cadeau ideale)', 'Note Google rassurante'],
    frictions: ['Pas de carte cadeau visible', 'Email gmail (peu pro pour profil senior)', 'Pas de section "offrir"', 'Bit.ly peu pro pour un cadeau premium'],
    raisonDecision: 'Il cherchait specifiquement une carte cadeau. Pas trouve = il va chez un concurrent qui propose ca.',
    impactTech: 'Desktop fonctionnel mais l\'absence d\'offre cadeau cree un mur invisible.',
  },
  {
    id: 5, name: 'Sandrine', age: 42, role: 'Mere de famille, cherche un cadeau mari', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Mobile', decision: 'Hesite',
    exp: 4, conf: 6, clarte: 4, emoji: '\u{1F491}',
    situation: 'Veut un soin complet barbe + coupe pour offrir pour un anniversaire',
    parcours: ['Accueil', 'Tarifs', 'Contact'],
    questionCle: 'C\'est possible d\'offrir un forfait Luxe pour un anniversaire ?',
    reponse: 'Non explicitement',
    premierImpression: 'Les forfaits Elegance/Prestige/Luxe sont lisibles et dans une bonne fourchette cadeau. Mais pas de "carte cadeau".',
    positifs: ['Forfaits lisibles avec prix clairs', 'Fourchette 30-50€ parfaite pour un cadeau'],
    frictions: ['Pas de carte cadeau', 'RGPD : banniere absente', 'Email gmail peu rassurant'],
    raisonDecision: 'Elle appelle le numero pour demander si c\'est possible. Conversion possible mais friction inutile.',
    impactTech: 'Mobile correct. Le probleme est commercial, pas technique.',
  },
  {
    id: 6, name: 'Franck', age: 31, role: 'Graphiste freelance, nouveau a Nancy', canal: 'IA (ChatGPT)',
    maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte',
    exp: 3, conf: 5, clarte: 3, emoji: '\u{1F916}',
    situation: 'A demande a ChatGPT "meilleur barbier Nancy" et a recu cette adresse',
    parcours: ['Accueil', 'Tarifs'],
    questionCle: 'L\'ozone machine a vapeur + masque/gommage, c\'est quoi exactement ? Ca fait quoi pour la peau ?',
    reponse: 'Non',
    premierImpression: 'La note 4,9 est bien. Les tarifs sont la. Mais "ozone machine" — c\'est quoi concretement ?',
    positifs: ['Note 4,9', 'Tarifs presents'],
    frictions: ['Aucune description des soins', '"Ozone machine a vapeur" = mystere total', 'Pas de FAQ', 'Site non optimise pour les IA (pas de llms.txt)'],
    raisonDecision: 'Il ne comprend pas ce que les soins font. Il retourne sur ChatGPT pour trouver un barbier qui explique.',
    impactTech: 'Le site n\'est pas lisible par les IA. Pas de contenu structurel que ChatGPT pourrait citer.',
  },
  {
    id: 7, name: 'Jean-Pierre', age: 58, role: 'Retraite, recommandation voisin', canal: 'Bouche-a-oreille',
    maturite: 'Decision', device: 'Tablette', decision: 'Convertit',
    exp: 6, conf: 8, clarte: 6, emoji: '\u{1F9D3}',
    situation: 'Son voisin lui a recommande le barbier. Cherche juste le numero pour appeler.',
    parcours: ['Accueil', 'Contact'],
    questionCle: 'Je peux avoir un rendez-vous cette semaine ?',
    reponse: 'Oui',
    premierImpression: 'Le voisin a deja fait le travail de confiance. Le site confirme que c\'est bien la bonne adresse.',
    positifs: ['Numero visible', 'Horaires clairs', 'Note Google rassurante'],
    frictions: ['Reservation uniquement via bit.ly (peu accessible profil senior)', 'Pas d\'email alternatif simple'],
    raisonDecision: 'La recommandation a tout fait. Il appelle directement — le site n\'a joue aucun role actif.',
    impactTech: 'Tablette : site lisible. Le telephone cliquable est suffisant pour ce profil.',
  },
  {
    id: 8, name: 'Nadia', age: 38, role: 'Infirmiere, cadeau pour son compagnon', canal: 'Google Maps',
    maturite: 'Decision', device: 'Mobile', decision: 'Convertit',
    exp: 6, conf: 8, clarte: 5, emoji: '\u{1F48B}',
    situation: 'A cherche "barbier bien note Nancy" sur Maps, veut offrir un soin premium',
    parcours: ['Google Maps', 'Accueil', 'Reservation'],
    questionCle: 'Le forfait Luxe ca comprend quoi exactement ?',
    reponse: 'Partiellement',
    premierImpression: '4,9 etoile/126 avis. Forfait Luxe a 50€, ca fait un beau cadeau. Je reserve.',
    positifs: ['4,9 etoile sur 126 avis decisif', 'Tel cliquable', 'Forfaits lisibles avec prix'],
    frictions: ['Description forfait Luxe insuffisante', 'Bit.ly peu rassurant pour un cadeau'],
    raisonDecision: 'La note Maps decide. Elle reserve malgre les frictions mineures.',
    impactTech: 'Mobile : rapide et lisible. La note Google compense les lacunes du contenu.',
  },
  {
    id: 9, name: 'Dominique', age: 25, role: 'Etudiant en master, compare les barbiers', canal: 'IA (Perplexity)',
    maturite: 'Comparaison', device: 'Desktop', decision: 'Quitte',
    exp: 4, conf: 5, clarte: 3, emoji: '\u{1F50E}',
    situation: 'A utilise Perplexity pour comparer "luxury barber vs autres barbiers Nancy"',
    parcours: ['Accueil', 'Galerie'],
    questionCle: 'En quoi Luxury Barber est different des autres barbiers Nancy ?',
    reponse: 'Non',
    premierImpression: 'Le site dit "haut de gamme" mais ne montre pas en quoi. Pas d\'histoire, pas de concept explique.',
    positifs: ['Galerie professionnelle', 'Tarifs clairs'],
    frictions: ['Pas de page "Notre concept" ou "A propos"', 'Pas de differentiation claire du positionnement premium', 'Google Fonts = RGPD', 'Aucun contenu pour les IA'],
    raisonDecision: 'Manque de differentiation claire. Il retourne comparer sur Perplexity.',
    impactTech: 'Desktop : site charge correctement. Probleme = manque de contenu differenciateur.',
  },
  {
    id: 10, name: 'Aurelie', age: 33, role: 'Responsable RH, idee team building', canal: 'Reseaux sociaux',
    maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte',
    exp: 2, conf: 4, clarte: 2, emoji: '\u{1F4CB}',
    situation: 'A vu une pub Facebook, cherche une animation barbier pour un evenement corporate',
    parcours: ['Accueil'],
    questionCle: 'Vous faites des prestations pour entreprises ou evenements ?',
    reponse: 'Non',
    premierImpression: 'L\'ambiance premium est visible. Mais rien pour les entreprises ou evenements.',
    positifs: ['Ambiance premium visible', 'Galerie sympathique'],
    frictions: ['Aucune offre B2B ou evenementiel', 'GA4 sans consentement (visible)', 'Email gmail pour un prospect pro', 'Pas de section contact entreprise'],
    raisonDecision: 'Pas d\'offre corporate. Elle cherche ailleurs.',
    impactTech: 'Mobile : chargement correct. Le probleme est l\'absence totale d\'offre B2B.',
  },
];

// ─── STATS ───
const avgExp = (personas.reduce((s, p) => s + p.exp, 0) / personas.length).toFixed(1);
const avgConf = (personas.reduce((s, p) => s + p.conf, 0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.clarte, 0) / personas.length).toFixed(1);
const convertis = personas.filter(p => p.decision === 'Convertit').length;
const hesitants = personas.filter(p => p.decision === 'Hesite').length;
const quitte = personas.filter(p => p.decision === 'Quitte').length;
const tauxConv = Math.round((convertis / personas.length) * 100);

// ─── CANAL STATS ───
const canalStats = [
  { canal: 'Google Search', total: 3, conv: 0, hesitant: 2, quitte: 1 },
  { canal: 'Google Maps', total: 2, conv: 2, hesitant: 0, quitte: 0 },
  { canal: 'IA (ChatGPT / Perplexity)', total: 2, conv: 0, hesitant: 0, quitte: 2 },
  { canal: 'Reseaux sociaux', total: 2, conv: 1, hesitant: 0, quitte: 1 },
  { canal: 'Bouche-a-oreille', total: 1, conv: 1, hesitant: 0, quitte: 0 },
];

// ─── FRICTIONS ───
const frictions = [
  { label: 'Descriptions des forfaits absentes (Prestige, Luxe = mystere)', count: 6, severity: 'critique' },
  { label: 'RGPD : GA4 + Google Fonts sans consentement (violation legale)', count: 10, severity: 'critique' },
  { label: 'Lien reservation via bit.ly (casse l\'image premium)', count: 7, severity: 'haute' },
  { label: 'Pas de carte cadeau visible (occasion manquee evidente)', count: 4, severity: 'haute' },
  { label: 'Soins non expliques (ozone, gommage, black mask = quoi ?)', count: 5, severity: 'haute' },
  { label: 'Pas de page "A propos" / differentiation du concept premium', count: 3, severity: 'moyenne' },
  { label: 'Email gmail (peu professionnel pour positionnement haut de gamme)', count: 3, severity: 'moyenne' },
  { label: 'Aucune offre B2B / evenementielle', count: 2, severity: 'basse' },
];

// ─── RECOMMANDATIONS ───
const recoHaute = {
  title: 'Decrire chaque forfait en 3 lignes',
  impact: '6/10 personas',
  detail: 'Le forfait Prestige inclut une coupe + une pose de black mask (masque purifiant pour la peau) + un soin barbe. Le forfait Luxe ajoute un traitement ozone vapeur (detox de la peau, pores ouverts) + un gommage. Sans ces descriptions, le visiteur voit un prix sans comprendre la valeur. Trois paragraphes courts doubleraient le taux de conversion sur les profils en comparaison.'
};
const recosMoyennes = [
  {
    title: 'Ajouter une mention "Cartes cadeaux disponibles"',
    impact: '4 personas',
    detail: 'Une simple ligne "Bons cadeaux disponibles — appelez le 06 60 13 23 09 ou ecrivez-nous" sur la page tarifs capturerait une partie importante du trafic cadeau. Les barbiers premium sont des cadeaux ideaux (anniversaires, fetes des peres, Noel). Le site ne l\'exploite pas.'
  },
  {
    title: 'Remplacer le bit.ly par un systeme de reservation integre',
    impact: '7 personas',
    detail: 'Un lien bit.ly sur un site "luxury" cree une dissonance de confiance. Integrer Planity ou Booksy directement dans le site (widget ou lien natif) renforcerait l\'image premium et simplifierait le parcours mobile.'
  },
  {
    title: 'Corriger les violations RGPD (GA4 + Google Fonts)',
    impact: '10/10 personas (legal)',
    detail: 'Priorite legale : GA4 sans banniere de consentement expose a une amende CNIL. Google Fonts via CDN transfère les IP visiteurs a Google sans accord. Migration vers un analytics sans cookies (Umami/Pirsch) + polices locales = conformite totale.'
  },
];

// ─── TECHNIQUE ───
const techVerdicts = [
  { label: 'HTTPS actif', ok: true },
  { label: 'Schema.org HairSalon + aggregateRating', ok: true },
  { label: 'Open Graph (title, image, description)', ok: true },
  { label: 'Meta description presente', ok: true },
  { label: 'Tel cliquable (href:tel)', ok: true },
  { label: 'RGPD conforme (GA4 + polices)', ok: false },
  { label: 'Polices locales (pas de Google Fonts)', ok: false },
  { label: 'Banniere consentement analytics', ok: false },
  { label: 'Lien reservation natif (pas de bit.ly)', ok: false },
  { label: 'Security headers (CSP, X-Frame-Options)', ok: false },
];

// ─── HELPERS ───
function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}
function severityColor(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  if (s === 'moyenne') return 'bg-blue-100 text-blue-800';
  return 'bg-neutral-100 text-neutral-600';
}
function scoreBar(val: number) { return `${val * 10}%`; }
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath="/echo/luxury-barber"
>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #C9A84C;"></div>

    <div class="mx-auto max-w-4xl relative z-10">
      <div class="mb-4 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-amber-500/40">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span class="text-sm font-semibold text-white/90">Echo Decouverte &middot; Confidentiel</span>
      </div>

      <h1 class="mb-4 text-3xl font-bold leading-tight text-white md:text-4xl lg:text-5xl">
        Luxury Barber convertit <span class="text-amber-400">4 visiteurs sur 10</span> — voici pourquoi les 6 autres repartent
      </h1>

      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl mb-8">
        Analyse de <strong class="text-white">luxurybarber.fr</strong> — simulation de 10 visites clients reelles, 5 canaux d'arrivee, {frictions.length} frictions identifiees. Genere le {dateGeneration}.
      </p>

      <div class="flex flex-wrap gap-4 mb-10">
        <div class="px-6 py-4 rounded-xl bg-green-900/40 border border-green-700/40 text-center">
          <p class="text-2xl font-bold text-green-400">{convertis}</p>
          <p class="text-xs text-green-300 mt-1">contactent</p>
        </div>
        <div class="px-6 py-4 rounded-xl bg-amber-900/40 border border-amber-700/40 text-center">
          <p class="text-2xl font-bold text-amber-400">{hesitants}</p>
          <p class="text-xs text-amber-300 mt-1">hesitent</p>
        </div>
        <div class="px-6 py-4 rounded-xl bg-red-900/40 border border-red-700/40 text-center">
          <p class="text-2xl font-bold text-red-400">{quitte}</p>
          <p class="text-xs text-red-300 mt-1">repartent</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">10 personas simules</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">5 canaux d'arrivee</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">Audit technique inclus</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">{dateGeneration}</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ CONSTAT ═══════════════════ -->
  <div class="w-full px-6 py-10 md:px-8 bg-white">
    <div class="mx-auto max-w-4xl">
      <div class="rounded-xl border-l-4 border-l-amber-500 bg-amber-50 p-6 md:p-8">
        <h2 class="text-lg font-bold text-neutral-900 mb-2">Le paradoxe Luxury Barber</h2>
        <p class="text-neutral-800 leading-relaxed">
          La note <strong>4,9 etoile sur 126 avis Google</strong> est un actif commercial exceptionnel — mais le site s'en repose entierement. Les visiteurs qui arrivent deja decides (Google Maps, recommandation) convertissent facilement. Ceux qui comparent ou decouvrent — <strong>60% du trafic</strong> — repartent : les forfaits ne sont pas expliques, pas de carte cadeau visible, un lien bit.ly peu premium. Pour une enseigne qui se positionne "luxury", l'experience en ligne ne reflète pas l'experience en salon.
        </p>
      </div>
    </div>
  </div>

  <!-- ═══════════════════ CANAUX ═══════════════════ -->
  <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-neutral-50">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Conversion par canal</h2>
      <p class="text-neutral-500 mb-8">Google Maps et le bouche-a-oreille convertissent bien. Google Search et les IA : 0% — les visiteurs qui cherchent et comparent repartent sans reponse a leurs questions.</p>
      <div class="grid md:grid-cols-2 gap-4">
        {canalStats.map((c) => {
          const pct = c.total > 0 ? Math.round((c.conv / c.total) * 100) : 0;
          return (
            <div class="rounded-xl border border-neutral-200 bg-white p-5">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-semibold text-neutral-900 text-sm">{c.canal}</h3>
                <span class={`text-lg font-bold ${pct > 50 ? 'text-emerald-600' : pct > 0 ? 'text-amber-600' : 'text-red-600'}`}>{pct}%</span>
              </div>
              <div class="h-3 rounded-full bg-neutral-100 overflow-hidden mb-3">
                <div class="h-full rounded-full flex">
                  <div class="bg-emerald-500" style={`width: ${c.total > 0 ? (c.conv / c.total) * 100 : 0}%`}></div>
                  <div class="bg-amber-400" style={`width: ${c.total > 0 ? (c.hesitant / c.total) * 100 : 0}%`}></div>
                  <div class="bg-red-400" style={`width: ${c.total > 0 ? (c.quitte / c.total) * 100 : 0}%`}></div>
                </div>
              </div>
              <div class="flex gap-4 text-xs text-neutral-400">
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> {c.conv} conv.</span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-400"></span> {c.hesitant} hes.</span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-400"></span> {c.quitte} partis</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- ═══════════════════ PERSONAS ═══════════════════ -->
  <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-white">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">10 visites simulees</h2>
      <p class="text-neutral-500 mb-8">Clients types qui visitent luxurybarber.fr aujourd'hui : profils, parcours, et raison de leur decision.</p>

      <div class="space-y-8">

        {/* Convertit */}
        <div>
          <h3 class="text-base font-bold text-emerald-700 mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Ceux qui contactent ({convertis})
          </h3>
          <div class="space-y-3">
            {personas.filter(p => p.decision === 'Convertit').map((p) => (
              <details class={`group border ${decisionBorder(p.decision)} rounded-xl overflow-hidden`}>
                <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                      <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                      <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                      <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                    </div>
                    <p class="text-xs text-neutral-500 mb-2">{p.role}</p>
                    <div class="flex flex-wrap items-center gap-1">
                      {p.parcours.map((page, i) => (
                        <Fragment>
                          <span class="text-[10px] text-neutral-600 bg-white border border-neutral-200 px-1.5 py-0.5 rounded">{page}</span>
                          {i < p.parcours.length - 1 && <span class="text-neutral-300 text-[10px]">&rsaquo;</span>}
                        </Fragment>
                      ))}
