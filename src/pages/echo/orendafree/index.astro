<script is:inline>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const personaCards = document.querySelectorAll('.persona-card');
  if (filterBtns.length > 0) {
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        filterBtns.forEach((b) => { b.classList.remove('bg-neutral-900', 'text-white'); b.classList.add('bg-white', 'text-neutral-600'); });
        btn.classList.remove('bg-white', 'text-neutral-600');
        btn.classList.add('bg-neutral-900', 'text-white');
        personaCards.forEach((card) => { card.style.display = (filter === 'all' || card.dataset.canal === filter) ? '' : 'none'; });
      });
    });
  }
</script>
