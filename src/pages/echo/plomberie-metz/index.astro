---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'plomberie-metz';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Plomberie Metz';
const urlSite = 'https://www.plomberie-metz.com';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 26 50 59 89';
const marcTelLink = 'tel:+33626505989';
const marcWhatsApp = 'https://wa.me/33626505989?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 4.8,
  confiance: 4.8,
  clarte: 5.4,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'Plomberie Metz a un atout cle : le numero de telephone dans le titre de la page, ce qui convertit les urgences sans friction. Mais le site date de 2016 et souffre d\'un manque critique de preuves sociales. Aucun avis client, aucune photo de chantier, aucun nom d\'artisan. Pour les visiteurs en phase de comparaison — devis renovation, recherche de plombier fiable — le site perd face a des concurrents qui affichent des avis Google et des photos de realisations. 3 visiteurs sur 5 ont cherche un element de confiance qu\'ils n\'ont pas trouve.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Christophe',
    age: 48,
    emoji: '🚨',
    situation: 'Proprietaire a Metz-Borny, fuite d\'eau active sous l\'evier',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence fuite active. Il cherche "plombier metz urgence", voit le numero dans le H1 et appelle immediatement. Le site fait son job minimal pour les urgences.',
    localisation: 'Metz-Borny (57070)',
    maturite: 'Decision',
    contexte: 'Fuite active depuis 30 minutes. Il a coupe l\'eau. Il cherche un numero a appeler maintenant, pas a lire un site.',
    impression: 'H1 avec le numero directement — exactement ce qu\'il cherche. Il compose sans aller plus loin.',
    parcours: [
      ['Accueil', 'Lit "Plombier Metz" + numero dans le H1 — cible trouvee'],
      ['Lu "24/24H et 6/7J"', 'Confirmation qu\'ils repondent maintenant'],
      ['Appel', 'Il compose le 03 87 20 91 46 directement'],
    ] as [string, string][],
    questionCle: 'Ils interviennent aujourd\'hui ? Dans l\'heure ?',
    reponse: 'Partiellement' as const,
    commentReponse: '"24/24H" rassure mais sans engagement de delai precis. En urgence, Christophe appelle quand meme.',
    impactVitesse: 'Chargement lent (estimé 3-5 sec mobile) risque de faire partir un visiteur en urgence avant d\'avoir vu le numero.',
    impactConfiance: 'Grade D Observatory invisible pour l\'utilisateur — pas d\'impact direct ici.',
    positifs: ['Numero de telephone dans le H1 — meilleur placement possible', 'Disponibilite 24h/24 affichee', 'Adresse Metz confirmee'],
    frictions: ['Delai d\'intervention vague ("meilleurs delais")', 'Pas de bouton "Appel urgence" cliquable en hero mobile', 'Site lent — risque de rebond avant chargement complet'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 5, clarte: 6,
  },
  {
    id: 2,
    name: 'Sandrine',
    age: 35,
    emoji: '🏠',
    situation: 'Locataire a Montigny-les-Metz, WC bouche depuis hier soir',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle trouve Plomberie Metz sur Google Maps. Elle visite le site pour verifier la serieux. Pas d\'avis, pas de tarif. Elle compare avec un concurrent qui a 47 avis.',
    localisation: 'Montigny-les-Metz (57158)',
    maturite: 'Comparaison',
    contexte: 'WC bouche depuis la veille. Elle a trouve Plomberie Metz sur Maps et verifie le site avant d\'appeler. Elle compare 2 plombiers.',
    impression: 'Site qui semble un peu vieux. Elle cherche les avis clients — introuvables.',
    parcours: [
      ['Accueil mobile', 'Services listes OK, mais design date'],
      ['Cherche avis clients', 'Aucun temoignage, aucune note Google integree'],
      ['Cherche tarif debouchage', 'Aucun prix — formulaire devis uniquement'],
      ['Compare concurrent', 'L\'autre plombier affiche 4,8 etoiles et "des 80E" — elle appelle lui'],
    ] as [string, string][],
    questionCle: 'C\'est serieux ? Combien ca va couter ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucun avis visible, aucun tarif indicatif. Le concurrent avec 47 avis Google gagne par defaut.',
    impactVitesse: 'Chargement lent renforce la perception "site abandonne".',
    impactConfiance: 'Absence d\'avis et de SIRET dans les mentions legales fragilise la credibilite.',
    positifs: ['Debouchage bien documente (techniques mentionnees)', 'Numero accessible'],
    frictions: ['Aucun avis client / temoignage', 'Aucun tarif indicatif', 'Site visuellement date (signale manque d\'investissement)', 'Pas de SIRET identifiable'],
    ceQuiFeraitBasculer: '5 avis Google integres + une fourchette "des X euros pour un debouchage standard".',
    exp: 4, conf: 4, clarte: 5,
  },
  {
    id: 3,
    name: 'Jean-Pierre',
    age: 61,
    emoji: '🔧',
    situation: 'Proprietaire a Metz-Centre, chauffe-eau en panne, recommande par un ami',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Son ami lui a dit "appelle Plomberie Metz, ils sont biens". Il cherche le nom sur Google, confirme l\'identite, trouve le numero et appelle. Conversion certaine.',
    localisation: 'Metz (57000)',
    maturite: 'Decision',
    contexte: 'Chauffe-eau en panne depuis ce matin. Son ami a ete satisfait du service. Il veut juste confirmer que c\'est bien eux et avoir le numero.',
    impression: '"Plombier Metz" — c\'est bien eux. Numero dans le H1. Il appelle.',
    parcours: [
      ['Accueil desktop', 'Identite confirmee — adresse Metz, services plomberie'],
      ['H1', 'Numero lu directement'],
      ['Appel', 'Jean-Pierre compose sans aller plus loin'],
    ] as [string, string][],
    questionCle: 'C\'est bien eux ? Quel est leur numero ?',
    reponse: 'Oui' as const,
    commentReponse: 'Nom + adresse + telephone visible immediatement sur desktop. Confirmation parfaite.',
    impactVitesse: 'Acceptable sur desktop. Pas de probleme.',
    impactConfiance: 'La recommandation de l\'ami pese infiniment plus que tout indicateur du site.',
    positifs: ['Numero de telephone dans le H1', 'Adresse clairement affichee (18 rue Mangin, Metz)', 'Services confirmes visuellement'],
    frictions: ['Presque aucune pour ce profil'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 8, clarte: 7,
  },
  {
    id: 4,
    name: 'Amelie',
    age: 29,
    emoji: '🛁',
    situation: 'Proprietaire a Woippy, projet renovation salle de bain complete',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle cherche un plombier pour un devis renovation salle de bain (5 000E). Elle compare 3 artisans. Sans photos de realisations ni temoignage, Plomberie Metz est elimine avant meme le devis.',
    localisation: 'Woippy (57140)',
    maturite: 'Comparaison',
    contexte: 'Projet renovation complete : douche a l\'italienne, double vasque. Budget 4 000-6 000E. Elle cherche un artisan fiable avec des references visuelles de son travail.',
    impression: '"Ils font l\'installation mais ou sont les photos ?" Elle cherche immediatement une galerie.',
    parcours: [
      ['Accueil', 'Services listes OK, mais pas d\'image de realisation'],
      ['Navigation', 'Cherche "realisations" ou "galerie" — absent du menu'],
      ['Page installation', 'Texte generique sans photos ni references'],
      ['Quitte', 'Le concurrent avec des photos avant/apres l\'emporte'],
    ] as [string, string][],
    questionCle: 'Ils font ce type de chantier ? Je peux voir leurs realisations ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune photo de chantier, aucune reference client, aucun temoignage sur une renovation. Le site documente les types de services mais pas le niveau de realisation.',
    impactVitesse: 'Acceptable sur desktop, mais l\'absence de visuels renforce la sensation de vide.',
    impactConfiance: 'Site 2016 sans mise a jour visible = artisan peu investi dans son image pour un chantier a 5 000E.',
    positifs: ['Services d\'installation bien listes', 'Numero accessible'],
    frictions: ['Aucune photo de realisation', 'Aucun nom/prenom d\'artisan — anonymat total', 'Site date — signal negatif pour un chantier important', 'Aucun avis / temoignage client'],
    ceQuiFeraitBasculer: '3-4 photos de salles de bain renovees avec description du chantier et localisation.',
    exp: 4, conf: 4, clarte: 5,
  },
  {
    id: 5,
    name: 'Karim',
    age: 41,
    emoji: '🏢',
    situation: 'Bailleur a Metz, cherche plombier pour contrat maintenance — hors cible',
    canal: 'Reseaux sociaux',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Il gere 8 appartements et cherche un plombier avec SIRET, RC pro et engagement d\'intervention sous 4h. Mentions legales incompletes, SIRET absent — il passe au suivant.',
    localisation: 'Metz (57000)',
    maturite: 'Decouverte',
    contexte: 'Bailleur cherchant un contrat de maintenance annuelle. Il a besoin de justificatifs legaux pour son contrat : SIRET, attestation RC pro, engagement de delai.',
    impression: 'Plombier a Metz — OK. Mais il cherche les informations legales immediatement.',
    parcours: [
      ['Accueil', '"OK ils sont a Metz, ils font de la maintenance"'],
      ['Mentions legales', 'Editeur du site uniquement — pas l\'artisan. SIRET absent.'],
      ['Cherche assurance', 'Aucune mention RC pro ni decennale'],
      ['Quitte', 'Impossible de valider la conformite legale pour un contrat pro'],
    ] as [string, string][],
    questionCle: 'Ils sont en regle ? Je peux avoir le SIRET et l\'attestation assurance ?',
    reponse: 'Non' as const,
    commentReponse: 'Mentions legales incompletes : seul l\'editeur du site est identifie, pas l\'artisan. SIRET, forme juridique, assurance RC pro — rien.',
    impactVitesse: 'Sans objet pour cette decision.',
    impactConfiance: 'Absence de SIRET et d\'assurance dans les mentions legales est eliminatoire pour un contrat B2B.',
    positifs: ['Zone Metz confirmee', 'Services de maintenance evoques'],
    frictions: ['SIRET absent des mentions legales', 'Pas d\'assurance RC pro / decennale mentionnee', 'Identite de l\'artisan inconnue', 'Mentions legales incompletes'],
    ceQuiFeraitBasculer: 'Ce profil est partiellement hors cible. Mais un SIRET + "assure RC pro" suffirait a rester en lice.',
    exp: 3, conf: 3, clarte: 4,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Afficher des avis clients sur la page d\'accueil',
    pourquoi: '3 visiteurs sur 5 ont cherche des avis clients et ne les ont pas trouves. Pour un plombier, la confiance est le premier critere de selection — les clients ne choisissent pas le moins cher, ils choisissent celui qui les rassure. Sans avis visible, Plomberie Metz perd systematiquement les prospects en comparaison face a des concurrents mieux notes.',
    action: 'Integrer un bloc "Avis clients" sur la page d\'accueil avec 3-5 vrais temoignages (prenom, ville, type de travaux). Si la fiche Google My Business existe, afficher la note et le nombre d\'avis avec lien vers Maps. Placer ce bloc apres les services, avant le formulaire de contact.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Mauvaise (estimee)', ok: false, detail: 'Quota API epuise — estimation : 30-50/100 mobile. Site HTML 2016 non optimise.' },
  { label: 'Securite', verdict: 'Grade D', ok: false, detail: 'Score 30/100 — 4 headers manquants : CSP, HSTS, X-Frame-Options, X-Content-Type-Options.' },
  { label: 'SEO', verdict: 'Partiel', ok: false, detail: 'Sitemap present mais en HTTP. robots.txt absent (404). Schema.org manquant.' },
  { label: 'Donnees structurees', verdict: 'Absent', ok: false, detail: 'Schema.org JSON-LD non detecte — penalite SEO local significative.' },
  { label: 'Partage reseaux', verdict: 'Non configure', ok: false, detail: 'Balises Open Graph absentes — partage sur Facebook/WhatsApp sans image ni description.' },
];

const tech = {
  observatory: { grade: 'D', score: 30, testsOk: 6, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Probable > 4s (non mesure)', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'HTTPS actif (certificat valide)' },
    { ok: true, h: 'Redirection HTTP vers HTTPS' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (absent)' },
    { ok: false, h: 'Content-Security-Policy (absent — risque XSS)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking)' },
    { ok: false, h: 'X-Content-Type-Options (absent)' },
    { ok: false, h: 'Referrer-Policy (absent)' },
  ],
  schema: [
    { item: 'JSON-LD / Schema.org present', ok: false },
    { item: '@type PlumbingService ou LocalBusiness', ok: false },
    { item: 'name, url, telephone', ok: false },
    { item: 'address + geo (latitude/longitude)', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'aggregateRating (avis Google)', ok: false },
    { item: 'sameAs (Facebook, Google Maps)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Non detecte' },
    { item: 'og:description', ok: false, val: 'Non detecte' },
    { item: 'og:image', ok: false, val: 'Non detecte' },
    { item: 'og:url', ok: false, val: 'Non detecte' },
    { item: 'twitter:card', ok: false, val: 'Non detecte' },
  ],
  seo: [
    { item: 'H1 unique avec mot-cle principal ("Plombier Metz")', ok: true },
    { item: 'HTTPS actif', ok: true },
    { item: 'Sitemap.xml accessible (21 URLs)', ok: true },
    { item: 'Schema.org present', ok: false },
    { item: 'robots.txt accessible', ok: false },
    { item: 'Sitemap en HTTPS (URLs en http:// actuellement)', ok: false },
    { item: 'Open Graph configure', ok: false },
    { item: 'Mentions legales completes (SIRET artisan)', ok: false },
  ],
};

const alertes: { type: 'critique' | 'important'; titre: string; detail: string; chiffre: string; chiffreLabel: string }[] = [
  { type: 'critique' as const, titre: 'Grade sécurité D', detail: '4 headers critiques manquants (CSP, HSTS, X-Frame-Options, X-Content-Type-Options). Site HTML 2016 non protégé.', chiffre: 'D', chiffreLabel: 'grade sécurité Mozilla Observatory' },
  { type: 'important' as const, titre: '0 données structurées', detail: 'Google ne peut pas afficher vos coordonnées, horaires et spécialités dans les résultats — pénalité SEO local significative.', chiffre: '0', chiffreLabel: 'Schema.org JSON-LD détecté' },
  { type: 'important' as const, titre: 'Aucun avis client visible', detail: '3 visiteurs sur 5 ont cherché des avis. Pour un plombier, la confiance prime sur le prix — sans avis, vous perdez face aux concurrents mieux notés.', chiffre: '3/5', chiffreLabel: 'visiteurs bloqués par ce manque' },
];
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 2b. ALERTES -->
{alertes.length > 0 && (
  <section style="background: #fefce8;" class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <div>
          <h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2>
          <p class="text-sm text-neutral-600">
            {alertes.filter(a => a.type === 'critique').length > 0 && <span class="text-red-700 font-medium">{alertes.filter(a => a.type === 'critique').length} critique{alertes.filter(a => a.type === 'critique').length > 1 ? 's' : ''}</span>}
            {alertes.filter(a => a.type === 'critique').length > 0 && alertes.filter(a => a.type === 'important').length > 0 && <span class="mx-1 text-neutral-400">·</span>}
            {alertes.filter(a => a.type === 'important').length > 0 && <span class="text-amber-700 font-medium">{alertes.filter(a => a.type === 'important').length} important{alertes.filter(a => a.type === 'important').length > 1 ? 's' : ''}</span>}
          </p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {alertes.map(a => (
          <div class={`bg-white rounded-xl p-5 ${a.type === 'critique' ? 'border-2 border-red-300' : 'border border-amber-200'}`}>
            <div class="flex items-start gap-4">
              <div class={`text-2xl font-black rounded-lg px-3 py-1 shrink-0 ${a.type === 'critique' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>{a.chiffre}</div>
              <div>
                <p class="font-semibold text-neutral-900 text-sm mb-1">{a.titre}</p>
                <p class="text-xs text-neutral-600">{a.detail}</p>
                <p class="text-[10px] text-neutral-400 mt-1">{a.chiffreLabel}</p>
              </div>
            </div>
          </div>
        ))}
