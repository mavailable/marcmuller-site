---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { personas, type Decision } from '../../../data/buddhaview-hostel-personas-v2';

const slug = 'buddhaview-hostel';
const nomProspect = 'Buddha View Hostel';
const urlSite = 'https://buddhaview-hostel.pages.dev';
const dateAudit = '4 juillet 2026';
const title = 'Rapport Personas v2 - Buddha View Hostel | Marc M';
const description = "Echo Pro v2 : 300 voyageurs simulés (100 anglophones, 100 francophones, 100 hispanophones) sur le nouveau site Buddha View Hostel, comparés à l'audit v1 de l'ancien site.";
const phoneDisplay = '+33 6 88 76 66 48';
const whatsapp = '33688766648';

// KPIs sur les 300 visiteurs simulés (36 affichés ci-dessous), calculés depuis simulations.json.
const kpis = { nbPersonas: 300, nbConvertissent: 165, nbHesitent: 63, nbRepartent: 72, conversion: 55, experience: 7.3, confiance: 7.6, clarte: 8.3 };
const kpisV1 = { nbPersonas: 60, conversion: 28, experience: 5.6, confiance: 5.3, clarte: 5.1 };

const verdictHero = "Sur 300 voyageurs simulés, 165 réservent sur votre nouveau site, près du double de l'ancien. Le frein principal restant : des avis qu'on ne peut pas vérifier.";

const constat = "La refonte a levé les cinq freins de l'ancien site : les prix sont affichés, les avis sont là, le Wi-Fi est confirmé, le site parle trois langues et Google reçoit enfin une vraie description. Ce qui retient encore les 63 hésitants n'est plus ce que le site cache, c'est ce qu'il ne prouve pas : une note d'avis vérifiable, un avantage à réserver en direct, une offre pour les plongeurs déjà certifiés.";

// Timeline v1 -> v2
const versionsData = [
  { version: 'v1', date: '20 juin 2026', label: 'Ancien site (Wix)', nbPersonas: 60, taux: 28 },
  { version: 'v2', date: '4 juillet 2026', label: 'Nouveau site', nbPersonas: 300, taux: 55 },
];

const deltaData = [
  { friction: 'Prix 100% cachés derrière le moteur de réservation', statut: '✅', detail: 'Fourchettes « à partir de » affichées partout (dès 500 THB), lien de résa direct par chambre' },
  { friction: 'Zéro avis ni note sur le site', statut: '🟡', detail: '10 témoignages traduits en 3 langues, mais toujours aucune note vérifiable ni lien vers Hostelworld, Booking ou Google' },
  { friction: 'Wi-Fi jamais mentionné', statut: '✅', detail: 'Confirmé sur l\'accueil, en FAQ et dans les infos pratiques, avec espaces de travail' },
  { friction: 'Site 100% anglais', statut: '✅', detail: 'Trois langues natives (EN, FR, ES) avec sélecteur clair. La cohorte francophone rejouée passe de 3 à 12 réservations' },
  { friction: 'Description Google vide, titre faible, partage social sans image', statut: '✅', detail: 'Titres et descriptions optimisés par langue, aperçu de partage complet, 0 erreur mesurée' },
  { friction: 'Page lente et instable sur mobile, sécurité C-', statut: '❓', detail: 'Non mesurable tant que la préversion est privée. Socle technique refait, à re-mesurer au passage sur le domaine public' },
];

// Conversion par langue (le coeur du Pro multilingue)
const langueData = [
  { langue: 'Anglophones', flag: '🇬🇧', total: 100, convert: 55, hesite: 21, quitte: 24, rate: 55, note: "La cohorte v1 rejouée reste à 7 réservations sur 20, mais les départs secs deviennent des hésitations (5 départs au lieu de 8). Les freins restants : avis à vérifier, aucun avantage résa directe, Wi-Fi sans preuve chiffrée." },
  { langue: 'Francophones', flag: '🇫🇷', total: 100, convert: 55, hesite: 21, quitte: 24, rate: 55, note: "Le marché sacrifié de l'ancien site (15% contre 35% pour les anglophones) est à égalité. La cohorte v1 rejouée passe de 3 à 12 réservations : la version française et le staff francophone affiché changent tout." },
  { langue: 'Hispanophones', flag: '🇪🇸', total: 100, convert: 55, hesite: 21, quitte: 24, rate: 55, note: "Nouveau marché testé (remplace l'allemand du v1). Un point spécifique : 17 visiteurs sur 100 relèvent que l'accueil du hostel ne parle pas espagnol, alors que le site et les instructeurs plongée le couvrent." },
];

const canalData = [
  { canal: 'Bouche-à-oreille', nb: 43, convert: 32, rate: 74 },
  { canal: 'Hostelworld / Booking', nb: 61, convert: 35, rate: 57 },
  { canal: 'Google Maps', nb: 45, convert: 24, rate: 53 },
  { canal: 'Google Search', nb: 61, convert: 32, rate: 52 },
  { canal: 'Assistants IA (ChatGPT, Perplexity)', nb: 46, convert: 23, rate: 50 },
  { canal: 'Réseaux sociaux', nb: 44, convert: 19, rate: 43 },
];

// Analyses avancées (Pro)
const maturiteData = [
  { label: 'Découverte', total: 87, convert: 22, hesite: 25, quitte: 40, rate: 25, friction: 'preuve sociale non vérifiable, vie du lieu peu illustrée : ils repartent « y réfléchir »' },
  { label: 'Comparaison', total: 123, convert: 66, hesite: 33, quitte: 24, rate: 54, friction: 'prix exact par date sur le moteur de résa uniquement, aucun avantage à réserver en direct' },
  { label: 'Décision', total: 90, convert: 77, hesite: 5, quitte: 8, rate: 86, friction: 'presque rien ne les arrête ; manque une offre pour plongeurs déjà certifiés' },
];

const deviceData = [
  { device: 'Mobile', total: 197, convert: 119, rate: 60, insight: 'Le site mobile-first excelle, là où sont 2 visiteurs sur 3.' },
  { device: 'Desktop', total: 73, convert: 32, rate: 44, insight: 'Concentre les compareurs méthodiques, onglets Hostelworld ouverts en parallèle.' },
  { device: 'Tablette', total: 30, convert: 14, rate: 47, insight: 'Usage d\'appoint, mêmes réactions que sur mobile.' },
];

const segmentData = [
  { segment: 'Client idéal', total: 75, convert: 70, rate: 93, insight: 'L\'offre parle parfaitement à sa cible.' },
  { segment: 'Client recommandé', total: 30, convert: 27, rate: 90, insight: 'La preuve sociale humaine fonctionne à plein.' },
  { segment: 'Client adjacent', total: 60, convert: 32, rate: 53, insight: 'Nomades, familles, 40+, plongeurs certifiés : rien ne s\'adresse explicitement à eux.' },
  { segment: 'Client hésitant', total: 60, convert: 21, rate: 35, insight: 'Le gisement : 18 basculeraient avec des avis vérifiables, 15 avec un avantage résa directe.' },
  { segment: 'Client en découverte', total: 44, convert: 15, rate: 34, insight: 'Normal à ce stade : à nourrir avec des avis et la vie du lieu.' },
  { segment: 'Client hors cible', total: 31, convert: 0, rate: 0, insight: 'Clarté 8,8/10 : le positionnement calme filtre vite et bien, c\'est un succès.' },
];

const matriceData = [
  { canal: 'Hostelworld / Booking', cells: [{ pct: 60, n: '3/5' }, { pct: 44, n: '16/36' }, { pct: 80, n: '16/20' }] },
  { canal: 'Google Search', cells: [{ pct: 20, n: '4/20' }, { pct: 55, n: '16/29' }, { pct: 100, n: '12/12' }] },
  { canal: 'Google Maps', cells: [{ pct: 20, n: '2/10' }, { pct: 40, n: '6/15' }, { pct: 80, n: '16/20' }] },
  { canal: 'Assistants IA', cells: [{ pct: 32, n: '6/19' }, { pct: 57, n: '12/21' }, { pct: 83, n: '5/6' }] },
  { canal: 'Réseaux sociaux', cells: [{ pct: 23, n: '7/30' }, { pct: 80, n: '8/10' }, { pct: 100, n: '4/4' }] },
  { canal: 'Bouche-à-oreille', cells: [{ pct: 0, n: '0/3' }, { pct: 67, n: '8/12' }, { pct: 86, n: '24/28' }] },
];

// Ce qui freine encore (aucune alerte critique en v2, contre 4 en v1)
const alertes = [
  { titre: "Les avis ne se vérifient pas", detail: "10 témoignages maison, traduits et crédibles, mais aucune note globale ni lien vers Hostelworld, Booking ou Google. Pour un backpacker, un avis qu'on ne peut pas recouper compte à moitié. C'est le premier motif de bascule des hésitants (18 sur 63).", chiffre: '69', chiffreLabel: 'visiteurs sur 300 veulent vérifier' },
  { titre: "Rien à acheter pour les plongeurs certifiés", detail: "L'offre plongée s'arrête à l'Advanced Open Water. Aucun prix par plongée, aucun forfait fun dives : des plongeurs déjà certifiés, prêts à payer, repartent sans pouvoir se projeter.", chiffre: '0', chiffreLabel: 'prix fun dive affiché' },
  { titre: "Aucun avantage à réserver en direct", detail: "Les compareurs arrivent avec un panier Hostelworld ouvert. Le site affiche enfin ses prix, mais rien ne récompense la réservation directe : ni « meilleur prix ici », ni geste (café, late check-out).", chiffre: '15', chiffreLabel: 'hésitants basculeraient' },
];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Non mesurée', state: 'na', detail: 'Préversion privée : les outils de mesure ne voient pas le site. À mesurer au go-live.' },
  { label: 'Sécurité', verdict: 'Configurée', state: 'na', detail: 'Jeu complet de protections en place dans le code ; la note officielle sera mesurable au go-live.' },
  { label: 'Référencement', verdict: 'Optimisé', state: 'ok', detail: 'Titres, descriptions et versions de langue impeccables sur les pages vérifiées.' },
  { label: 'Données business', verdict: 'Présentes', state: 'ok', detail: 'Fiche hostel lisible par Google, 0 erreur sur les pages vérifiées.' },
  { label: 'Partage social', verdict: 'Complet', state: 'ok', detail: 'Image et description de partage présentes, dans les trois langues.' },
];

const tech = {
  schema: [
    { item: 'Fiche hostel lisible par Google (type Hostel), 0 erreur', ok: true },
    { item: 'Identité du site présente sur les trois langues', ok: true },
    { item: 'Liste des chambres balisée (page Rooms)', ok: true },
    { item: 'Avis clients pas encore balisés pour les étoiles Google (à faire avec la note agrégée)', ok: false },
  ],
  og: [
    { item: 'Titre de partage', val: 'présent (3 langues)' },
    { item: 'Description de partage', val: 'présente' },
    { item: 'Image de partage', val: 'présente (1200x630)' },
    { item: 'Aperçu Twitter/X', val: 'complet' },
  ],
  seo: [
    { item: 'Titre optimisé : mot-clé + bénéfice (« Eco hostel on Koh Tao, free pool try-scuba »)', ok: true },
    { item: 'Description remplie et vendeuse, unique par langue', ok: true },
    { item: 'Versions de langue déclarées à Google (EN, FR, ES)', ok: true },
    { item: '3 pages d\'administration présentes dans le sitemap : à retirer avant le go-live', ok: false },
  ],
  headers: [
    { ok: true, h: 'Protections configurées dans le code : politique de sécurité du contenu, anti-clickjacking, chiffrement forcé' },
    { ok: true, h: 'Cache long sur les fichiers statiques, polices hébergées localement' },
    { ok: false, h: 'Note officielle non mesurable tant que la préversion est privée' },
  ],
};

const ameliorationsHautes = [
  { titre: "Afficher une note d'avis vérifiable", pourquoi: "Les témoignages maison rassurent mais ne se recoupent pas. La note existe déjà sur Hostelworld et Google : il suffit de l'afficher avec un lien. C'est le levier le moins cher du rapport.", action: "Ajouter « 9+/10 sur Hostelworld » avec lien près des témoignages, sur l'accueil et la page Rooms.", impact: '69 visiteurs sur 300, 18 hésitants basculent' },
  { titre: "Annoncer un avantage résa directe", pourquoi: "Les compareurs ont un panier Hostelworld ouvert dans l'onglet d'à côté. Sans raison de réserver ici, ils y retournent, et vous payez la commission.", action: "Un bandeau « meilleur prix en direct » ou un geste concret (café offert, late check-out) sur la page Rooms.", impact: '15 hésitants basculent' },
  { titre: "Créer l'offre fun dives pour plongeurs certifiés", pourquoi: "Des certifiés prêts à payer ne trouvent rien après l'Advanced : ni prix par plongée, ni forfait. Ils repartent en phase de décision, le moment le plus rentable.", action: "Une page fun dives avec grille de prix (1, 5, 10 plongées) reliée au formulaire existant.", impact: '20 visiteurs en phase décision' },
  { titre: "Prouver le Wi-Fi", pourquoi: "Le Wi-Fi est confirmé trois fois, mais sans débit ni retour d'usage. Pour un télétravailleur, « Wi-Fi gratuit » sans chiffre reste une promesse.", action: "Afficher un débit mesuré et ajouter un témoignage de télétravailleur.", impact: 'nomades (segment adjacent)' },
  { titre: "Afficher l'accueil hispanophone", pourquoi: "Le site parle un espagnol parfait, mais les infos pratiques annoncent un staff anglais/français. 17 hispanophones sur 100 tiquent, alors que les instructeurs couvrent déjà l'espagnol.", action: "Mentionner l'espagnol côté hostel (instructeurs ES, « un peu d'espagnol au comptoir »).", impact: '17 visiteurs ES sur 100' },
];

const ameliorationsUtiles = [
  { titre: "Un tarif long séjour indicatif", detail: "Les nomades comparent avec des colivings qui affichent un prix au mois. Même un « dès X nuits : -Y% » débloque la projection." },
  { titre: "Parler aux publics adjacents", detail: "Un bloc « première plongée à 40 ans ? », l'âge minimum pour les familles, la remise à niveau après une pause : trois questions récurrentes restées sans réponse." },
  { titre: "Montrer la vie du lieu", detail: "Le positionnement calme est clair, mais les solos sociables veulent voir le lounge vivre : deux photos de la vie commune suffisent." },
  { titre: "Détailler la démarche éco", detail: "« Solaire et eau de pluie » est cru sur parole. Deux ou trois chiffres concrets transformeraient l'argument en preuve." },
  { titre: "Expliquer les frais de carte (3,5%)", detail: "Relevés par 47 visiteurs, surtout hispanophones. Les expliquer (ou proposer un paiement sans frais) évite la mauvaise surprise au calcul." },
];

const ameliorationsDiscuter = [
  { emoji: '📅', titre: "Afficher la disponibilité en direct sur le site ?", detail: "Le prix exact par date reste sur le moteur de résa. Une dispo en temps réel lèverait la friction n.2 du rapport, mais c'est un vrai chantier d'intégration." },
  { emoji: '🤿', titre: "Un package lit + cours en une seule démarche ?", detail: "Aujourd'hui deux réservations séparées (lit d'un côté, plongée de l'autre). Un combo confirmé en une fois rassurerait les planificateurs." },
  { emoji: '🥐', titre: "Le petit-déjeuner", detail: "Non inclus, relevé par 44 visiteurs. Partenariat avec un resto voisin ou option payante affichée : à arbitrer avec Anoush." },
  { emoji: '🤫', titre: "Assumer « calme mais sociable »", detail: "Le filtre anti-fêtards fonctionne parfaitement (0 conversion hors cible, et c'est voulu). Reste à dire aux solos qu'on s'y fait quand même des amis." },
];

function decisionBorder(d: Decision) {
  if (d === 'Convertit') return 'border-green-200';
  if (d === 'Hesite') return 'border-amber-200';
  return 'border-neutral-200';
}
function decisionBadge(d: Decision) {
  if (d === 'Convertit') return 'bg-green-600';
  if (d === 'Hesite') return 'bg-amber-500';
  return 'bg-neutral-400';
}
function scoreColor(n: number) {
  if (n >= 7) return 'text-green-600';
  if (n >= 5) return 'text-amber-600';
  return 'text-red-500';
}
function heatCls(pct: number) {
  if (pct >= 60) return 'bg-green-100 text-green-800';
  if (pct >= 30) return 'bg-amber-100 text-amber-800';
  return 'bg-red-100 text-red-800';
}

const converts = personas.filter((p) => p.decision === 'Convertit');
const hesitates = personas.filter((p) => p.decision === 'Hesite');
const leaves = personas.filter((p) => p.decision === 'Quitte');
---

<BaseLayout title={title} description={description} noindex={true}>

  <!-- ═══ HERO ═══ -->
  <section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
    <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #0EA5E9; opacity: 0.08;"></div>
    <div class="absolute bottom-[10%] right-[5%] w-[300px] h-[300px] rounded-full blur-[120px] pointer-events-none" style="background: #22c55e; opacity: 0.05;"></div>

    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
        Echo Pro &middot; v2 &middot; Confidentiel
      </div>

      <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
        {verdictHero}
      </h1>

      <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
        Site analysé : <a href={urlSite} target="_blank" rel="noopener" class="underline hover:text-white transition-colors">{urlSite}</a> &middot; {kpis.nbPersonas} visiteurs simulés (100 EN, 100 FR, 100 ES) &middot; {dateAudit}
      </p>

      <div class="grid grid-cols-3 gap-4">
        <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
          <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
          <div class="text-sm text-green-400/70">réservent</div>
        </div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
          <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
          <div class="text-sm text-amber-400/70">hésitent</div>
        </div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
          <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
          <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
        </div>
      </div>

      <p class="mt-6 text-sm text-center" style="color: rgba(255,255,255,0.5);">
        Soit <strong class="text-white">{kpis.conversion}%</strong> qui réservent, contre <strong class="text-white">{kpisV1.conversion}%</strong> sur l'ancien site &middot; l'écart entre langues a disparu
      </p>
    </div>
  </section>

  <!-- ═══ ÉVOLUTION v1 -> v2 ═══ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-16">
    <h2 class="text-xl font-bold text-neutral-900 mb-2">Comment votre site a évolué</h2>
    <p class="text-sm text-neutral-500 mb-6">Le v1 (20 juin) auditait l'ancien site. Ce v2 mesure ce que la refonte débloque, avec les mêmes méthodes et, pour 40 profils, les mêmes visiteurs.</p>

    <div class="grid grid-cols-2 gap-4 mb-6">
      {versionsData.map((v, i) => (
        <div class={`rounded-xl p-5 border ${i === versionsData.length - 1 ? 'bg-sky-50 border-sky-200' : 'bg-white border-neutral-200'}`}>
          <div class="flex items-center justify-between mb-2">
            <span class={`text-[10px] font-bold uppercase tracking-widest ${i === versionsData.length - 1 ? 'text-sky-700' : 'text-neutral-400'}`}>{v.version} &middot; {v.date}</span>
            <span class={`text-2xl font-black ${i === versionsData.length - 1 ? 'text-sky-700' : 'text-neutral-500'}`}>{v.taux}%</span>
          </div>
          <p class="text-sm font-semibold text-neutral-900">{v.label}</p>
          <p class="text-xs text-neutral-500 mt-1">{v.nbPersonas} visiteurs simulés</p>
        </div>
      ))}
    </div>

    <div class="rounded-xl p-5 bg-green-50 border border-green-200 flex items-start gap-3 mb-8">
      <span class="text-lg shrink-0 mt-0.5">📈</span>
      <p class="text-sm text-green-900 leading-relaxed">
        <strong>Preuve la plus fiable : les 40 visiteurs du v1 rejoués à l'identique.</strong> Les 20 francophones passent de 3 à <strong>12 réservations (x4)</strong>. Les 20 anglophones restent à 7, mais les départs secs deviennent des hésitations rattrapables (5 départs au lieu de 8).
      </p>
    </div>

    <div class="overflow-x-auto rounded-xl border border-neutral-200 mb-4">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-neutral-50">
            <th class="text-left p-3 text-neutral-500 font-medium">Friction identifiée au v1</th>
            <th class="p-3 text-neutral-500 font-medium w-12">État</th>
            <th class="text-left p-3 text-neutral-500 font-medium">Sur le nouveau site</th>
          </tr>
        </thead>
        <tbody>
          {deltaData.map((d) => (
            <tr class="border-t border-neutral-100">
              <td class="p-3 text-neutral-800">{d.friction}</td>
              <td class="p-3 text-center text-base">{d.statut}</td>
              <td class="p-3 text-neutral-600 text-xs">{d.detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ═══ CONVERSION PAR LANGUE ═══ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-12">
    <h2 class="text-xl font-bold text-neutral-900 mb-2">Conversion par langue</h2>
    <p class="text-sm text-neutral-500 mb-6">100 voyageurs simulés par marché, sur la même grille de profils : les totaux se comparent d'un marché à l'autre.</p>

    <div class="grid md:grid-cols-3 gap-4 mb-6">
      {langueData.map((l) => (
        <div class="bg-white border border-neutral-200 rounded-xl p-5 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="text-2xl">{l.flag}</span>
              <h3 class="font-bold text-neutral-900 text-sm">{l.langue}</h3>
            </div>
            <span class="text-lg font-black text-neutral-800">{l.rate}%</span>
          </div>
          <div class="flex gap-1.5 mb-3">
            <div class="flex-1 text-center rounded-lg py-1.5 bg-green-50 border border-green-100">
              <div class="text-base font-bold text-green-700">{l.convert}</div>
              <div class="text-[10px] text-green-600">réservent</div>
            </div>
            <div class="flex-1 text-center rounded-lg py-1.5 bg-amber-50 border border-amber-100">
              <div class="text-base font-bold text-amber-700">{l.hesite}</div>
              <div class="text-[10px] text-amber-600">hésitent</div>
            </div>
            <div class="flex-1 text-center rounded-lg py-1.5 bg-neutral-50 border border-neutral-100">
              <div class="text-base font-bold text-neutral-600">{l.quitte}</div>
              <div class="text-[10px] text-neutral-500">repartent</div>
            </div>
          </div>
          <p class="text-xs text-neutral-600 leading-relaxed">{l.note}</p>
        </div>
      ))}
    </div>

    <div class="rounded-xl p-5 bg-sky-50 border border-sky-200 flex items-start gap-3 mb-4">
      <span class="text-lg shrink-0 mt-0.5">🌐</span>
      <p class="text-sm text-sky-900 leading-relaxed">
