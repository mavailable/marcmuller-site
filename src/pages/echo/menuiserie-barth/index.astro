---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'menuiserie-barth';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Menuiserie Barth';
const urlSite = 'https://www.menuiseriebarth.com/';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 88 76 66 48';
const marcTelLink = 'tel:+33688766648';
const marcWhatsApp = 'https://wa.me/33688766648?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 1,
  nbHesitent: 2,
  nbRepartent: 2,
  conversion: 20,
  experience: 3.8,
  confiance: 4.2,
  clarte: 4.4,
};

const verdictHero = 'Sur 5 visiteurs, 1 vous contacte. 2 hesitent. 2 repartent sans rien faire.';

const constat = 'Votre expertise de menuisier artisanal depuis 1983 est reelle — labels RGE, reseau Arteba, large gamme. Mais votre site ne la montre pas. Les visiteurs cherchant un artisan en ligne repartent faute de photos de vrais chantiers et d\'un site lisible sur telephone. Seuls ceux qu\'on vous a recommandes vous appellent.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Google Search', nb: 3, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Laurence',
    age: 48,
    emoji: '🏡',
    situation: 'Proprietaire a Augny (57), envisage une renovation complete des menuiseries',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Labels RGE et l\'adresse proche la rassurent, mais l\'absence de photos de vrais chantiers l\'empeche de trancher. Elle va d\'abord verifier le concurrent qui a des avis Google recents.',
    localisation: 'Augny (57), 10 min de Mecleuves',
    maturite: 'Comparaison',
    contexte: 'Elle a clique sur la fiche Google Maps de Menuiserie Barth apres avoir vu qu\'ils etaient a 15 min de chez elle. Elle compare deux artisans.',
    impression: 'Page qui s\'affiche lentement sur mobile. Le titre s\'affiche puis les images arrivent. Design dat qui rappelle les sites des annees 2010. Numero de telephone visible, labels de certifications. Pas d\'image forte ni d\'accroche claire.',
    parcours: [
      ['Accueil', 'Cherche des photos de realisations. Voit "Nos realisations" mais trouve des photos de catalogues fournisseurs, pas de vrais chantiers Barth.'],
      ['Fenetres & portes-fenetres', 'Descriptions des materiaux rassurantes. Mais pas de tarifs.'],
      ['Contact/Devis', 'Formulaire trouve. Hesite : trop de champs sur mobile. Abandonne sans soumettre.'],
    ] as [string, string][],
    questionCle: 'Est-ce que cet artisan a fait des chantiers similaires au mien, et comment le contacter ?',
    reponse: 'Non' as const,
    commentReponse: 'Les realisations montrent des catalogues fournisseurs, pas des photos de vrais chantiers Barth. Impossible de juger le travail reel.',
    impactVitesse: 'Site lent sur mobile — plusieurs CSS et JS bloquants. Plus de 4 secondes. Elle consulte deja le concurrent.',
    impactConfiance: 'Design vieillissant qui inspire moins confiance qu\'un site moderne, meme si les labels sont la.',
    positifs: ['Label RGE Qualibat rassurant et connu', 'Numero de telephone visible en haut', 'Large gamme couvrant tous ses besoins', 'Adresse confirmant la proximite'],
    frictions: ['Aucune photo de vrais chantiers Barth (uniquement catalogues)', 'Pas de temoignages clients', 'Formulaire de devis long et intimidant sur mobile', 'Design daté inspire moins confiance'],
    ceQuiFeraitBasculer: '3 ou 4 photos de vrais chantiers avec le lieu et le type de travaux. Elle aurait soumis le formulaire.',
    exp: 4, conf: 4, clarte: 5,
  },
  {
    id: 2,
    name: 'Patrick',
    age: 62,
    emoji: '🔧',
    situation: 'Retraite proprietaire a Metz-Queuleu, cherche a remplacer sa porte d\'entree',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Son voisin lui a recommande Barth. Il cherche juste a confirmer et a trouver le numero. Le site confirme l\'adresse et les labels — il appelle.',
    localisation: 'Metz Queuleu (57), 20 min de Mecleuves',
    maturite: 'Decision',
    contexte: 'Son voisin lui a dit : "appelle Barth a Mecleuves, ils m\'ont bien refait mes fenetres." Il tape l\'URL pour confirmer.',
    impression: 'Sur desktop, le site s\'affiche correctement. Il voit "Menuiserie Barth", le numero 03 87 74 34 29 et les logos Arteba et RGE que son voisin a mentionnes. "C\'est bien eux."',
    parcours: [
      ['Accueil', 'Confirme l\'adresse a Mecleuves, 15 min de Metz. Bon.'],
      ['Portes d\'entree', 'Parcourt les options (aluminium, bois, PVC, PMR). Ce qu\'il cherche est la.'],
      ['Contact', 'Note le numero de telephone. Prefere appeler plutot que remplir un formulaire.'],
    ] as [string, string][],
    questionCle: 'C\'est bien eux ? Comment je les appelle ?',
    reponse: 'Oui' as const,
    commentReponse: 'Le numero est visible en haut de chaque page. L\'adresse confirme Mecleuves. Les labels rassurent.',
    impactVitesse: 'Desktop avec bonne connexion — chargement acceptable malgre les ressources multiples.',
    impactConfiance: 'La recommandation du voisin pese plus que le design. Les labels confirment le serieux.',
    positifs: ['Numero de telephone bien visible', 'Gamme portes d\'entree complete', 'Labels RGE et Arteba confirment le serieux', 'Adresse confirmant la localisation'],
    frictions: ['Pas de page A propos avec photo de l\'artisan', 'Pas de temoignages pour conforter la recommandation du voisin'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 7, clarte: 6,
  },
  {
    id: 3,
    name: 'Mehdi',
    age: 34,
    emoji: '📱',
    situation: 'Nouveau proprietaire a Montigny-les-Metz, veut installer des volets roulants',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Sans prix et avec un site difficile sur mobile, il prefere passer au concurrent suivant dans ses resultats Google. Pourtant l\'offre de Barth correspondait exactement a son besoin.',
    localisation: 'Montigny-les-Metz (57), 18 min de Mecleuves',
    maturite: 'Comparaison',
    contexte: 'Il a trouve Menuiserie Barth via Google Maps, a clique sur le lien site web. Compare 3 devis.',
    impression: 'Site qui rame sur iPhone. Design old school — "C\'est un site de 2010 ca." Les elements ne semblent pas optimises pour mobile.',
    parcours: [
      ['Volets', 'Trouve la section volets roulants. Descriptions correctes mais pas de tarifs.'],
      ['Cherche les prix', 'Rien. Pas la moindre fourchette.'],
      ['Cherche les delais', 'Rien non plus.'],
      ['Contact', 'Formulaire qui s\'affiche mal sur mobile. Champs trop nombreux.'],
    ] as [string, string][],
    questionCle: 'Combien ca coute et dans combien de temps peuvent-ils intervenir ?',
    reponse: 'Non' as const,
    commentReponse: 'Ni prix, ni delai mentionne nulle part sur le site.',
    impactVitesse: 'Tres mauvaise sur mobile. Chargement lent, mise en page non responsive. Maximum-scale=1.0 empeche le zoom.',
    impactConfiance: 'Site peu professionnel visuellement par rapport aux concurrents avec des sites modernes.',
    positifs: ['Labels RGE et Qualibat presents', 'Large gamme de volets proposee'],
    frictions: ['Aucun prix ni fourchette tarifaire', 'Site non adapte mobile (layout problematique)', 'Chargement tres lent', 'Aucun delai d\'intervention mentionne', 'Aucun temoignage'],
    ceQuiFeraitBasculer: 'Une fourchette de prix + un formulaire de devis simplifie en 3 champs sur mobile. Il aurait soumis.',
    exp: 2, conf: 3, clarte: 3,
  },
  {
    id: 4,
    name: 'Isabelle',
    age: 41,
    emoji: '🌿',
    situation: 'Proprietaire a Peltre, interessee par une pergola bioclimatique pour son jardin',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Le configurateur de store l\'a interessee et elle a soumis un formulaire — mais avec doute. Elle va aussi demander des devis a d\'autres artisans avec plus d\'avis Google.',
    localisation: 'Peltre (57), 8 min de Mecleuves',
    maturite: 'Decouverte',
    contexte: 'Elle a vu des publicites pour des pergolas et cherche un artisan local de confiance. Debut de projet, 5 000-20 000 euros d\'investissement potentiel.',
    impression: 'Sur desktop, le site s\'affiche correctement mais parait vieilli. Elle cherche inspiration visuelle — des photos belles et modernes. Clique sur "Pergolas & stores".',
    parcours: [
      ['Pergolas & stores', 'Contenu detaille : pergolas bioclimatiques, velums, stores, verandas. Rassurante.'],
      ['Configurateur store', 'Fonctionnel et interactif. Elle apprecie pouvoir visualiser. Differenciateur positif.'],
      ['Realisations', 'Photos de catalogues fournisseurs, pas de vrais chantiers Barth. Deception.'],
      ['Avis clients', 'Rien sur le site. Seuls 2 avis Google trouves. Inquietant pour un investissement important.'],
      ['Contact', 'Soumet le formulaire en mentionnant "pergola bioclimatique". Avec doute.'],
    ] as [string, string][],
    questionCle: 'Cet artisan fait-il vraiment des pergolas de qualite ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le configurateur et les descriptions montrent une offre serieuse. Mais sans photos de realisations reelles ni temoignages, impossible de juger la qualite d\'execution.',
    impactVitesse: 'Desktop — chargement lent mais acceptable.',
    impactConfiance: 'Seulement 2 avis Google et aucun temoignage sur le site. Pour un achat a 10 000 euros, c\'est insuffisant.',
    positifs: ['Configurateur de store interactif — differenciateur apprecie', 'Gamme pergola complete (bioclimatique, velum, brise-soleil)', 'Labels RGE Qualibat', 'Formulaire de devis disponible'],
    frictions: ['Aucune photo de realisations reelles Barth (uniquement catalogues)', 'Aucun temoignage client', 'Pas de prix indicatif pour un premier budget', 'Seulement 2 avis Google pour un investissement de 5 000-20 000 euros'],
    ceQuiFeraitBasculer: 'Des photos de 2-3 pergolas posees par Barth avec l\'accord du client. Isabelle aurait ete convaincue.',
    exp: 5, conf: 4, clarte: 5,
  },
  {
    id: 5,
    name: 'Kevin',
    age: 26,
    emoji: '🛒',
    situation: 'Locataire a Metz centre, cherche une fenetre PVC economique, budget max 150 euros',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Hors cible totale — locataire cherchant du bon marche, artisan proposant du sur-mesure qualitatif. Son depart est normal et souhaitable.',
    localisation: 'Metz centre (57)',
    maturite: 'Decision',
    contexte: 'Besoin urgent d\'une fenetre PVC standard economique. Il est locataire et ne veut pas investir dans de la menuiserie sur mesure.',
    impression: 'Site lent. Design vieilli. "C\'est serieux mais trop pour moi."',
    parcours: [
      ['Accueil', 'Voit "sur mesure selon vos besoins" et "fabrication francaise". Realise que c\'est du haut de gamme artisanal.'],
      ['Cherche les prix', 'Rien.'],
      ['Quitte', 'Comprend que c\'est une menuiserie artisanale sur mesure, pas un distributeur de produits standards.'],
    ] as [string, string][],
    questionCle: 'C\'est combien une simple fenetre PVC standard ?',
    reponse: 'Non' as const,
    commentReponse: 'Ni prix, ni offre standard, ni produits en stock. Ce n\'est pas la bonne cible pour Barth.',
    impactVitesse: 'N/A — il part avant de vraiment naviguer.',
    impactConfiance: 'Non pertinent — il n\'est pas la cible.',
    positifs: [],
    frictions: ['Hors cible : locataire cherchant du cheap, artisan faisant du sur-mesure qualitatif'],
    ceQuiFeraitBasculer: 'Rien — persona hors cible.',
    exp: 2, conf: 3, clarte: 3,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Ajouter une galerie de photos de vrais chantiers Barth',
    pourquoi: '4 visiteurs sur 5 ont cherche des photos de vrais travaux realises par votre entreprise et n\'en ont pas trouve. Les "Nos realisations" actuelles montrent des catalogues fournisseurs, pas votre travail. C\'est la friction qui fait perdre le plus de clients potentiels — particulierement ceux qui comparent plusieurs artisans.',
    action: 'Photographier 8 a 12 chantiers termines (fenetres, volets, pergolas, portes) avec un smartphone. Creer une page "Nos realisations" avec ces photos, le type de travaux et la commune (ex : "Remplacement fenetres PVC — Metz"). Ajouter 2-3 photos en page d\'accueil.',
    impact: '4 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const alertes: { type: 'critique' | 'important'; titre: string; detail: string; chiffre: string; chiffreLabel: string }[] = [
  { type: 'critique' as const, titre: 'Grade securite F', detail: 'Aucune protection active : 6 headers de securite manquants, cookies de session non securises. Les navigateurs modernes peuvent alerter vos visiteurs.', chiffre: 'F', chiffreLabel: 'grade securite Mozilla' },
  { type: 'critique' as const, titre: '0 donnees structurees', detail: 'Aucun Schema.org JSON-LD detecte. Google ne peut pas afficher vos coordonnees, horaires ou avis dans les resultats de recherche. Vos concurrents avec ces donnees apparaissent devant vous.', chiffre: '0', chiffreLabel: 'donnees structurees' },
  { type: 'important' as const, titre: 'Aucune photo de chantiers reels', detail: '4 visiteurs sur 5 ont cherche des photos de vrais travaux realises et n\'en ont pas trouve. Les catalogues fournisseurs ne remplacent pas votre propre travail.', chiffre: '4/5', chiffreLabel: 'visiteurs cherchent vos realisations' },
  { type: 'important' as const, titre: 'Site non adapte mobile', detail: 'Layout rigide, texte trop petit sur telephone. Plus de 50% de vos visiteurs arrivent sur mobile — ils voient un site difficile a naviguer.', chiffre: '50%+', chiffreLabel: 'du trafic est mobile' },
];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Mauvaise', ok: false, detail: 'Site PHP 2016, 7 CSS + 5 JS charges en sequence, pas de cache navigateur' },
  { label: 'Securite', verdict: 'F (0/100)', ok: false, detail: '6 headers de securite manquants, cookie session non securise' },
  { label: 'SEO', verdict: 'A ameliorer', ok: false, detail: 'Pas de H1, pas de sitemap, pas de robots.txt, pas de canonical' },
  { label: 'Donnees structurees', verdict: 'Absent', ok: false, detail: 'Aucun Schema.org JSON-LD — Google ne peut pas afficher d\'infos riches' },
  { label: 'Partage reseaux', verdict: 'Absent', ok: false, detail: 'Aucun Open Graph — aucun apercu lors d\'un partage WhatsApp ou Facebook' },
];

const tech = {
  observatory: { grade: 'F', score: 0, testsOk: 4, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible (API epuisee)', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: false, h: 'Content-Security-Policy (absent — score -25)' },
    { ok: false, h: 'Cookies session sans flag Secure (score -40)' },
    { ok: true, h: 'Redirection HTTP vers HTTPS presente' },
    { ok: false, h: 'Strict-Transport-Security HSTS (absent — score -20)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking, score -20)' },
    { ok: false, h: 'X-Content-Type-Options (absent — score -5)' },
    { ok: false, h: 'Subresource Integrity scripts externes (absent — score -50)' },
    { ok: false, h: 'Referrer-Policy (absent)' },
  ],
  schema: [
    { item: 'JSON-LD present', ok: false },
    { item: '@type coherent avec l\'activite (LocalBusiness / HomeAndConstructionBusiness)', ok: false },
    { item: 'name, url, description', ok: false },
    { item: 'address + geo (localisation Mecleuves)', ok: false },
    { item: 'telephone (03 87 74 34 29)', ok: false },
    { item: 'openingHours (L-V 8h-12h / 14h-18h)', ok: false },
    { item: 'image / logo', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Absent' },
    { item: 'og:description', ok: false, val: 'Absent' },
    { item: 'og:image', ok: false, val: 'Absent' },
    { item: 'og:type', ok: false, val: 'Absent' },
    { item: 'og:url', ok: false, val: 'Absent' },
    { item: 'twitter:card', ok: false, val: 'Absent' },
    { item: 'canonical', ok: false, val: 'Absent' },
    { item: '<title> page', ok: true, val: 'Menuiserie Barth | Agence Arteba a Metz, Moselle' },
    { item: '<meta description>', ok: true, val: 'Votre agence Arteba sur la region de Metz et alentours...' },
  ],
  seo: [
    { item: 'Un seul H1 par page', ok: false },
    { item: 'Hierarchie coherente (H1 > H2 > H3)', ok: false },
    { item: 'Meta description presente', ok: true },
    { item: 'Attributs alt sur les images', ok: false },
    { item: 'robots.txt accessible', ok: false },
    { item: 'sitemap.xml accessible', ok: false },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'Polices locales (RGPD)', ok: false },
    { item: 'Charset UTF-8', ok: false },
    { item: 'Balise canonical', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO — Verdict immediat -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>

  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilite, fluidite</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Credibilite, preuves, rassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
        <p class="text-[10px] text-neutral-400 mt-1">Comprehension de l'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- 2b. ALERTES -->
{alertes.length > 0 && (
  <section style="background: #fefce8;" class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
