        <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-neutral-100">
        <div class="py-4">
          <p class="text-sm text-neutral-600 mb-3">Scores estimes (API indisponible au moment de l'audit) :</p>
          <div class="grid grid-cols-2 gap-3 mb-4">
            {[
              { label: 'Performance mobile', score: 30 },
              { label: 'Accessibilite', score: 50 },
              { label: 'Bonnes pratiques', score: 45 },
              { label: 'SEO', score: 55 },
            ].map(s => {
              const color = s.score >= 90 ? '#22c55e' : s.score >= 50 ? '#f59e0b' : '#ef4444';
              return (
                <div class="flex items-center gap-3 text-xs">
                  <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-white text-[10px] shrink-0" style={`background: ${color}`}>{s.score}</div>
                  <span class="text-neutral-600">{s.label}</span>
                </div>
              );
            })}
          </div>
          <p class="text-xs text-neutral-500 mb-2">Causes principales : 7 fichiers CSS + 5 scripts JS charges en sequence, pas de cache navigateur, Google Fonts CDN externe, charset ISO-8859-15.</p>
          <a href={`https://pagespeed.web.dev/report?url=${urlSite}`} target="_blank" class="text-sm text-primary-600 underline hover:text-primary-800 mt-2 inline-block">Tester sur PageSpeed →</a>
        </div>
      </div>
    </details>

    <!-- Observatory -->
    <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
        <div class="flex items-center gap-3">
          <span class="text-base">🔒</span>
          <div>
            <h3 class="font-semibold text-neutral-900 text-sm">Securite</h3>
            <p class="text-[11px] text-neutral-500">{techVerdicts[1].detail}</p>
          </div>
        </div>
        <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-neutral-100">
        <p class="text-xs text-neutral-500 py-2">Note Mozilla Observatory : {tech.observatory.grade} — Score {tech.observatory.score}/100 ({tech.observatory.testsOk}/{tech.observatory.testsTotal} tests passes)</p>
        {tech.headers.map(h => (
          <div class="flex items-center gap-2 py-1">
            {h.ok
              ? <svg class="w-3.5 h-3.5 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              : <svg class="w-3.5 h-3.5 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            }
            <span class={`text-xs ${h.ok ? 'text-neutral-600' : 'text-red-500'}`}>{h.h}</span>
          </div>
        ))}
      </div>
    </details>

    <!-- Schema.org -->
    <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
        <div class="flex items-center gap-3">
          <span class="text-base">📊</span>
          <div>
            <h3 class="font-semibold text-neutral-900 text-sm">Donnees structurees (Schema.org)</h3>
            <p class="text-[11px] text-neutral-500">{techVerdicts[3].detail}</p>
          </div>
        </div>
        <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-neutral-100">
        {tech.schema.map(s => (
          <div class="flex items-center gap-2 py-1">
            {s.ok
              ? <svg class="w-3.5 h-3.5 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              : <svg class="w-3.5 h-3.5 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            }
            <span class={`text-xs ${s.ok ? 'text-neutral-600' : 'text-red-500 font-medium'}`}>{s.item}</span>
          </div>
        ))}
      </div>
    </details>

    <!-- Open Graph -->
    <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
        <div class="flex items-center gap-3">
          <span class="text-base">🔗</span>
          <div>
            <h3 class="font-semibold text-neutral-900 text-sm">Apercu reseaux sociaux (Open Graph)</h3>
            <p class="text-[11px] text-neutral-500">{techVerdicts[4].detail}</p>
          </div>
        </div>
        <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-neutral-100">
        {tech.og.map(o => (
          <div class="flex items-start gap-2 py-1">
            {o.ok
              ? <svg class="w-3.5 h-3.5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              : <svg class="w-3.5 h-3.5 text-amber-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
            }
            <span class={`text-xs ${o.ok ? 'text-neutral-600' : 'text-neutral-500'}`}>{o.item} <span class="text-neutral-400">{o.val}</span></span>
          </div>
        ))}
      </div>
    </details>

    <!-- SEO -->
    <details class="group border border-neutral-200 rounded-xl overflow-hidden bg-white">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
        <div class="flex items-center gap-3">
          <span class="text-base">🔍</span>
          <div>
            <h3 class="font-semibold text-neutral-900 text-sm">SEO technique</h3>
            <p class="text-[11px] text-neutral-500">{techVerdicts[2].detail}</p>
          </div>
        </div>
        <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-neutral-100">
        {tech.seo.map(s => (
          <div class="flex items-center gap-2 py-1">
            {s.ok
              ? <svg class="w-3.5 h-3.5 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              : <svg class="w-3.5 h-3.5 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            }
            <span class={`text-xs ${s.ok ? 'text-neutral-600' : 'text-red-500'}`}>{s.item}</span>
          </div>
        ))}
      </div>
    </details>

    <!-- Micro-CTA technique -->
    <div class="mt-8 rounded-xl p-5 bg-white border border-neutral-200 flex items-start gap-3">
      <span class="text-lg shrink-0 mt-0.5">🔧</span>
      <div>
        <p class="text-sm font-medium text-neutral-800">Tout ca est corrigeable.</p>
        <p class="text-xs text-neutral-600 mt-1">Un site bien construit obtient 90+ sur tous les indicateurs. C'est ce que je livre a mes clients.</p>
      </div>
    </div>

  </div>
</section>

<!-- 6. METHODOLOGIE -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-neutral-200">
  <h2 class="text-base font-bold text-neutral-900 mb-4">Comment ca marche</h2>
  <ol class="space-y-3 text-sm text-neutral-600">
    <li class="flex gap-3">
      <span class="w-6 h-6 rounded-full bg-neutral-100 text-neutral-500 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">1</span>
      <span>On scrape votre site — on lit chaque page comme un visiteur le ferait</span>
    </li>
    <li class="flex gap-3">
      <span class="w-6 h-6 rounded-full bg-neutral-100 text-neutral-500 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">2</span>
