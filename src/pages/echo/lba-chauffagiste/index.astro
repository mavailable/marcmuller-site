---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'lba-chauffagiste';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'LBA Chauffagiste Sarreguemines';
const urlSite = 'https://lba-chauffagiste-sarreguemines.fr';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.0,
  confiance: 4.4,
  clarte: 4.8,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'LBA Chauffagiste Sarreguemines est bien positionne sur les mots-cles locaux et le numero de telephone est visible. Mais le site souffre d\'un deficit de confiance critique : aucun avis client visible, aucune certification (RGE, QualiPAC), un contenu generique de reseau. En Moselle en 2026, les projets pompe a chaleur sont en forte demande — et les clients exigent un artisan RGE visible pour acceder a MaPrimeRenov\'. 2 visiteurs sur 5 hesitent precisement parce qu\'ils ne trouvent pas ces elements de rassurance.';

const canalData = [
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Stephane',
    age: 47,
    emoji: '🔥',
    situation: 'Proprietaire a Sarreguemines, chaudiere fioul en panne en plein hiver',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence totale. Il cherche "chauffagiste urgence Sarreguemines". Trouve LBA, voit le numero en haut de page, appelle immediatement.',
    localisation: 'Sarreguemines (57200)',
    maturite: 'Decision',
    contexte: 'Sa chaudiere fioul est tombee en panne la nuit precedente. Il fait -5 dehors. Il a besoin d\'un chauffagiste aujourd\'hui, maintenant.',
    impression: 'Il voit "Chauffagiste Sarreguemines" en H1 et le numero. C\'est suffisant pour appeler.',
    parcours: [
      ['Accueil mobile', 'H1 confirme la zone — OK'],
      ['Telephone', 'Visible en quelques secondes — 09 72 17 37 46'],
      ['Appelle', 'Il est en Decision absolue — le numero suffit'],
    ] as [string, string][],
    questionCle: 'Ils peuvent intervenir aujourd\'hui ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le service urgence est mentionne mais aucun delai d\'intervention ni disponibilite n\'est precise.',
    impactVitesse: 'Site lent sur mobile peut frustrer un visiteur en urgence avant qu\'il trouve le numero.',
    impactConfiance: 'En urgence, la confiance est secondaire — le numero prime.',
    positifs: ['Numero visible rapidement', 'Zone Sarreguemines confirmee', 'Urgence mentionnee dans les services'],
    frictions: ['Pas de delai d\'intervention affiche', 'Pas de CTA "Urgence 24h/24" en hero', 'Pas de disponibilite claire'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 6, clarte: 6,
  },
  {
    id: 2,
    name: 'Nathalie',
    age: 54,
    emoji: '🏠',
    situation: 'Locataire a Sarralbe, cherche chauffagiste pour contrat entretien annuel chaudiere Saunier Duval',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Elle cherche sur Maps "chauffagiste Sarreguemines", clique sur LBA, voit que Saunier Duval est cite parmi les marques, appelle pour demander un devis entretien.',
    localisation: 'Sarralbe (57430)',
    maturite: 'Decision',
    contexte: 'Elle doit faire l\'entretien annuel de sa chaudiere Saunier Duval avant la fin de contrat d\'assurance. Elle cherche un prestataire local fiable.',
    impression: 'Saunier Duval est mentionne parmi les marques — c\'est rassurant. Elle appelle.',
    parcours: [
      ['Fiche Google Maps', 'Clique sur le lien du site'],
      ['Accueil', 'Voit "Saunier Duval" dans les marques partenaires'],
      ['Telephone', 'Appelle pour devis entretien'],
    ] as [string, string][],
    questionCle: 'Ils connaissent les chaudieres Saunier Duval ?',
    reponse: 'Oui' as const,
    commentReponse: 'Saunier Duval est explicitement cite dans la liste des marques traitees.',
    impactVitesse: 'Mobile lent peut decourager avant le chargement complet.',
    impactConfiance: 'Aucun avis sur le site — elle s\'appuie sur les avis Google Maps.',
    positifs: ['Marques partenaires bien listees', 'Saunier Duval present', 'Zone Moselle confirmee'],
    frictions: ['Aucun avis sur le site', 'Pas de tarif entretien indicatif', 'Email de contact generique'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 5, clarte: 5,
  },
  {
    id: 3,
    name: 'Cyril',
    age: 38,
    emoji: '♨️',
    situation: 'Proprietaire a Bitche, projet installation pompe a chaleur air-eau, cherche artisan RGE pour MaPrimeRenov\'',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Il cherche "chauffagiste RGE Moselle pompe a chaleur". Trouve LBA. Les PAC sont mentionnees mais aucune certification RGE ou QualiPAC n\'est affichee. Il ne peut pas confirmer l\'eligibilite aux aides. Il compare avec un concurrent qui affiche "RGE QualiPAC" en evidence.',
    localisation: 'Bitche (57230)',
    maturite: 'Comparaison',
    contexte: 'Il veut remplacer sa chaudiere fioul par une pompe a chaleur air-eau. Budget total : 12 000€. Il a besoin d\'un artisan RGE certifie pour acceder a MaPrimeRenov\' et aux CEE.',
    impression: 'Les pompes a chaleur sont mentionnees — positif. Mais il cherche aussitot une certification visible.',
    parcours: [
      ['Accueil', 'Pompes a chaleur citees dans le contenu — OK'],
      ['Recherche certif', 'Scrute la page pour RGE, QualiPAC — absent'],
      ['Compare', 'Ouvre le concurrent suivant qui affiche son label RGE'],
    ] as [string, string][],
    questionCle: 'Ils sont certifies RGE ? Je peux avoir MaPrimeRenov\' ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune certification RGE ou QualiPAC mentionnee nulle part sur le site.',
    impactVitesse: 'Acceptable sur desktop.',
    impactConfiance: 'L\'absence de certification est un bloquant absolu pour ce profil.',
    positifs: ['Pompes a chaleur mentionnees dans le contenu', 'Plusieurs marques partenaires'],
    frictions: ['Certification RGE invisible', 'QualiPAC absent', 'Aucune info MaPrimeRenov\'', 'Contenu PAC generique sans expertise visible'],
    ceQuiFeraitBasculer: 'Un bandeau "Artisan RGE certifie" avec numero de qualification QUALIBAT ou RGE Qualipac.',
    exp: 5, conf: 4, clarte: 4,
  },
  {
    id: 4,
    name: 'Martine',
    age: 61,
    emoji: '👩',
    situation: 'Proprietaire a Forbach, remplacement chaudiere gaz, recommandee par une voisine',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Sa voisine lui a parle de LBA. Elle verifie le site avant d\'appeler. Elle ne trouve pas d\'avis clients, pas de temoignages, pas de photos de chantiers. Le contenu lui semble generique. Elle envoie aussi un formulaire chez un concurrent qui affiche 47 avis Google sur son site.',
    localisation: 'Forbach (57600)',
    maturite: 'Comparaison',
    contexte: 'Sa chaudiere gaz a 18 ans. Elle veut la remplacer. Budget 3 000-5 000€. La recommendation de sa voisine l\'a orientee mais elle compare avant de s\'engager.',
    impression: 'Site correct mais rien ne la convainc que ce sont "les bons". Pas de visages, pas de temoignages, texte impersonnel.',
    parcours: [
      ['Accueil', 'Site pro en apparence — mais contenu generique'],
      ['Cherche avis', 'Scrute la page pour temoignages — absent'],
      ['Cherche photos', 'Aucune photo de chantier de remplacement chaudiere'],
      ['Compare', 'Envoie aussi un formulaire chez un concurrent avec avis affichés'],
    ] as [string, string][],
    questionCle: 'Est-ce que d\'autres clients les ont utilises ? Ils font du bon travail ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucun avis client, aucun temoignage, aucune photo de realisation sur le site.',
    impactVitesse: 'Acceptable sur desktop.',
    impactConfiance: 'Absence totale de preuve sociale — critique pour ce profil en phase Comparaison.',
    positifs: ['Nom du site correspond a la recommandation', 'Remplacement chaudiere gaz mentionne', 'Marques De Dietrich et Chappee citees'],
    frictions: ['Aucun temoignage client', 'Aucune photo de realisation', 'Contenu generique (texte SEO sans humanite)', 'Mentions legales vides'],
    ceQuiFeraitBasculer: '3-4 temoignages nominatifs avec prenom, ville, type de travaux realises.',
    exp: 5, conf: 4, clarte: 5,
  },
  {
    id: 5,
    name: 'Julien',
    age: 29,
    emoji: '📱',
    situation: 'Locataire a Sarreguemines-centre, radiateur en panne, cherche via Facebook local',
    canal: 'Reseaux sociaux',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Il cherche un chauffagiste sur le groupe Facebook "Sarreguemines Entraide". LBA n\'a pas de page Facebook visible, pas de publication dans les groupes locaux. Il contacte un concurrent qui poste regulierement des avant-apres sur Facebook.',
    localisation: 'Sarreguemines (57200)',
    maturite: 'Decouverte',
    contexte: 'Son radiateur ne chauffe plus. Il cherche un artisan local pas cher et disponible rapidement. Il commence par les reseaux sociaux avant Google.',
    impression: 'LBA n\'est pas trouve sur les reseaux. Il n\'arrive meme pas sur le site.',
    parcours: [
      ['Facebook groupe local', 'Cherche "chauffagiste Sarreguemines" — LBA absent'],
      ['Ne trouve pas', 'Contacte un concurrent actif sur les reseaux'],
    ] as [string, string][],
    questionCle: 'Est-ce qu\'ils sont actifs et disponibles rapidement ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune presence sur les reseaux sociaux detectable. Pas de page Facebook, pas d\'Instagram.',
    impactVitesse: 'Sans objet — il n\'arrive pas au site.',
    impactConfiance: 'Absence totale de signal social.',
    positifs: ['N/A — ne visite pas le site'],
    frictions: ['Aucune page Facebook', 'Aucune publication dans les groupes locaux', 'Pas d\'Instagram', 'Invisible sur les reseaux sociaux locaux'],
    ceQuiFeraitBasculer: 'Une page Facebook avec 2-3 posts de chantiers par mois suffirait a capter ce profil.',
    exp: 3, conf: 3, clarte: 4,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Afficher des avis clients et certifications RGE/QualiPAC sur la page d\'accueil',
    pourquoi: '3 visiteurs sur 5 ont cherche des preuves de confiance et ne les ont pas trouvees. Un chauffagiste est choisi sur la confiance — c\'est lui qui entre chez vous et touche votre installation. Sans temoignages visibles et sans certifications affichees, le site ne convainc pas en phase Comparaison. Les projets pompe a chaleur (marche en forte croissance en Moselle) exigent de surcroit un artisan RGE certifie pour acceder a MaPrimeRenov\'.',
    action: 'Ajouter en page d\'accueil : (1) une section "Nos clients temoignent" avec 3-4 temoignages nominatifs (prenom, ville, type de travaux), (2) les logos de certifications si RGE/QualiPAC existe avec numero de qualification, (3) un widget ou lien vers les avis Google. Si LBA est certifie RGE, le mettre en bandeau hero — c\'est un critere decisif pour 20-30% des demandes chauffagiste en 2026.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A verifier', ok: false, detail: 'Quota API epuise — PHP 7.4 + WebSite X5, estimation mobile 35-55/100.' },
  { label: 'Securite', verdict: 'Insuffisant', ok: false, detail: 'Headers critiques absents (HSTS, CSP, X-Frame-Options).' },
  { label: 'SEO', verdict: 'Partiel', ok: false, detail: 'Plusieurs H1, og:title = "Index", sitemap present mais minimal.' },
  { label: 'Donnees structurees', verdict: 'Absent', ok: false, detail: 'Pas de JSON-LD Schema.org — penalite SEO local significative.' },
  { label: 'Partage reseaux', verdict: 'Mal configure', ok: false, detail: 'og:title = "Index", doublon og:site_name, image non standard.' },
];

const tech = {
  observatory: { grade: 'D', score: 15, testsOk: 1, testsTotal: 7 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'Redirection HTTP vers HTTPS' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (absent)' },
    { ok: false, h: 'Content-Security-Policy (absent)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking)' },
    { ok: false, h: 'X-Content-Type-Options (absent)' },
    { ok: false, h: 'Referrer-Policy (absent)' },
    { ok: false, h: 'Permissions-Policy (absent)' },
  ],
  schema: [
    { item: 'JSON-LD / Schema.org present', ok: false },
    { item: '@type LocalBusiness ou HVACBusiness', ok: false },
    { item: 'name, url, telephone', ok: false },
    { item: 'address + geo', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'aggregateRating', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: '"Index" — non optimise' },
    { item: 'og:description', ok: false, val: 'Absente' },
    { item: 'og:image', ok: false, val: 'Presente mais 500x555px (non standard)' },
    { item: 'og:url', ok: true, val: 'https://lba-chauffagiste-sarreguemines.fr' },
    { item: 'twitter:card', ok: true, val: 'summary_large_image' },
  ],
  seo: [
    { item: 'H1 unique', ok: false },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'Schema.org presente', ok: false },
    { item: 'Meta description optimisee', ok: false },
    { item: 'robots.txt accessible', ok: true },
    { item: 'sitemap.xml accessible', ok: true },
    { item: 'Open Graph correctement configure', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group bg-white rounded-xl overflow-hidden shadow-sm border border-green-200">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]: [string, string]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
