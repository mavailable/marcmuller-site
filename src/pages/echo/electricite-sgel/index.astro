---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'electricite-sgel';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'SGEL Electricite';
const urlSite = 'https://www.electricite-sgel.com';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 88 76 66 48';
const marcTelLink = 'tel:+33688766648';
const marcWhatsApp = 'https://wa.me/33688766648?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 3,
  nbHesitent: 1,
  nbRepartent: 1,
  conversion: 60,
  experience: 6.4,
  confiance: 7.4,
  clarte: 5.4,
};

const verdictHero = 'Sur 5 visiteurs, 3 vous contactent. 1 hesite. 1 repart sans rien faire.';

const constat = 'Votre note 4,8/5 et vos 78 avis verifies convertissent les visiteurs deja convaincus. Mais ceux qui comparent encore — professionnels, projets importants — repartent faute de voir vos certifications et une idee de vos tarifs.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Kevin',
    age: 38,
    emoji: '🏠',
    situation: 'Proprietaire en renovation a Thionville, cherche un electricien pour mise en conformite',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'La note 4,8/78 avis fait pencher la balance face a son autre devis — il envoie le formulaire malgre l\'absence de prix.',
    localisation: 'Thionville (57100) — 8km',
    maturite: 'Comparaison',
    contexte: 'Il a deja un devis d\'un concurrent et cherche une deuxieme offre. Il compare sur mobile pendant sa pause dejeuner.',
    impression: 'Site propre, note 4,8/5 visible immediatement. Entreprise credible. Mais le chargement est un peu lent sur mobile.',
    parcours: [
      ['Accueil', 'Note 4,8/78 avis rassure immediatement — argument fort face au concurrent'],
      ['Electricite generale', 'Confirme la mise en conformite. Mais aucun prix ni fourchette.'],
      ['Contact', 'Formulaire trouve. Pas d\'email visible, juste telephone.'],
      ['Formulaire devis', 'Remplit et envoie. La note a convaincu.'],
    ] as [string, string][],
    questionCle: 'Sont-ils serieux et a quel prix approximatif travaillent-ils ?',
    reponse: 'Partiellement' as const,
    commentReponse: '78 avis 4,8/5 prouvent le serieux. Mais zero indication tarifaire — impossible de comparer.',
    impactVitesse: 'Chargement mobile percu comme lent (scripts GTM + Didomi). Agace mais ne bloque pas.',
    impactConfiance: 'Schema.org LocalBusiness + avis Plus que Pro genere une confiance elevee.',
    positifs: ['78 avis verifies 4,8/5 — argument decisif', 'Depannage 7j/7 24h/24 mentionne', 'Telephone visible en haut de page', 'Services clairement listes'],
    frictions: ['Aucun prix ni fourchette indicative', 'Pas d\'email visible', 'Horaires absents'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 8, clarte: 5,
  },
  {
    id: 2,
    name: 'Nathalie',
    age: 52,
    emoji: '⚡',
    situation: 'Proprietaire a Fameck, panne electrique urgente ce matin',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Disjoncteur saute, elle cherche un numero. Le telephone est visible et "7j/7 24h/24" est la — elle appelle sans remplir de formulaire.',
    localisation: 'Fameck (57290) — 5km',
    maturite: 'Decision',
    contexte: 'Panne electrique depuis ce matin. Situation d\'urgence. Elle cherche sur Google Maps "electricien urgence" et clique sur SGEL (5km, 4,8 etoiles).',
    impression: 'Elle cherche le telephone en premier. Le trouve en 3 secondes. Mission accomplie.',
    parcours: [
      ['Accueil', 'Numero de telephone en haut. Le note immediatement.'],
      ['Electricite generale', 'Confirme "depannage 7j/7 24h/24". Valide.'],
      ['Appel direct', 'N\'utilise pas le formulaire — appelle directement.'],
    ] as [string, string][],
    questionCle: 'Peuvent-ils intervenir aujourd\'hui en urgence ?',
    reponse: 'Partiellement' as const,
    commentReponse: '"7j/7 24h/24" est mentionne mais les horaires precis sont absents. Elle appelle pour confirmer.',
    impactVitesse: 'Chargement un peu lent en situation d\'urgence — source de stress. Trouve le tel quand meme.',
    impactConfiance: 'Avis 4,8/5 la rassurent avant d\'appeler.',
    positifs: ['Telephone visible immediatement', 'Mention depannage 7j/7 24h/24', '4,8/5 sur Google Maps = pre-selection'],
    frictions: ['Horaires d\'ouverture absents', 'Chargement mobile lent = friction en urgence', 'Pas de confirmation du delai d\'intervention'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 8, clarte: 6,
  },
  {
    id: 3,
    name: 'Lucas',
    age: 27,
    emoji: '🚗',
    situation: 'Jeune proprietaire a Hayange, vient d\'acheter une voiture electrique',
    canal: 'Bouche-a-oreille',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Son voisin lui a recommande SGEL pour la borne. Il vient confirmer et appelle directement — recommandation + site coherent = confiance maximale.',
    localisation: 'Hayange (57700) — meme ville',
    maturite: 'Decision',
    contexte: 'Son voisin a fait installer une borne par SGEL il y a 2 mois. Il lui recommande chaudement. Lucas tape "electricite-sgel.com" directement.',
    impression: 'Il connait deja SGEL. Il cherche la confirmation "bornes de recharge" et le contact.',
    parcours: [
      ['Accueil', 'Confirme que c\'est bien SGEL. Cherche "borne" dans la navigation.'],
      ['Services', '"Bornes de recharge VE" listees. Confirmation trouvee.'],
      ['Contact', 'Appelle directement pour prendre rendez-vous.'],
    ] as [string, string][],
    questionCle: 'Font-ils vraiment les bornes IRVE et comment les contacter ?',
    reponse: 'Oui' as const,
    commentReponse: 'Bornes VE mentionnees dans les services et telephone accessible en 2 secondes.',
    impactVitesse: 'Parcours court, chargement acceptable.',
    impactConfiance: 'Recommandation personnelle + avis 4,8 = confiance maximale.',
    positifs: ['Bornes de recharge mentionnees clairement', 'Telephone visible', 'Note 4,8 confirme la recommandation', 'Zone Hayange = aucune question sur la distance'],
    frictions: ['Pas de page dediee bornes IRVE avec photos et details', 'Pas d\'email pour envoyer les infos de son installation'],
    ceQuiFeraitBasculer: '',
    exp: 8, conf: 9, clarte: 7,
  },
  {
    id: 4,
    name: 'Jerome',
    age: 44,
    emoji: '🔌',
    situation: 'Gerant d\'un local commercial a Metz, projet installation alarme + camera pro',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Services correspondants et marques credibles, mais zero certification visible ni reference pro. Il met en signet et continue de comparer.',
    localisation: 'Metz (57000) — 30km, limite de zone',
    maturite: 'Comparaison',
    contexte: 'Compare 3 prestataires pour securiser son entrepot. Budget 8-12k euros. Il veut un pro avec references.',
    impression: 'Site propre, services listes. Mais ca ressemble a un site oriente particuliers. Il cherche une section "Pro" ou des references B2B.',
    parcours: [
      ['Accueil', 'OK, entreprise credible. Mais pas de section "Professionnels".'],
      ['Domotique & Securite', 'Alarmes, cameras, surveillance listes. Pas de references photos.'],
      ['Avis clients', 'Tous des particuliers. Pas une seule reference pro.'],
      ['Contact', 'Commence a remplir. Marque une pause. Met en signet.'],
    ] as [string, string][],
    questionCle: 'Ont-ils l\'experience et les certifications pour un chantier pro de 10k euros ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune certification affichee, aucune reference pro, Metz en limite de zone — trop d\'incertitudes pour un engagement important.',
    impactVitesse: 'Desktop, pas de probleme de vitesse.',
    impactConfiance: 'Note 4,8 rassure mais 78 avis particuliers ne prouvent pas la competence pro.',
    positifs: ['Services domotique/securite clairement listes', 'Marques reconnues (Hager, Delta Dore)', 'Site structure et professionnel'],
    frictions: ['Aucune certification visible', 'Aucune reference de chantier pro', 'Metz en limite de zone ambigue', 'Pas de garanties explicites', 'Pas d\'email pour une demande formelle'],
    ceQuiFeraitBasculer: 'Une certification Qualifelec ou RGE visible + 2-3 photos de chantiers pro + mention assurance responsabilite.',
    exp: 6, conf: 6, clarte: 5,
  },
  {
    id: 5,
    name: 'Sandrine',
    age: 61,
    emoji: '🏢',
    situation: 'Gestionnaire de 3 coproprietes a Sarreguemines, cherche un electricien pour renovation parties communes',
    canal: 'Reseaux sociaux',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Sarreguemines en limite de zone + aucune reference copropriete = hors cible. Elle repart chercher un electricien plus proche.',
    localisation: 'Sarreguemines (57200) — 40km, hors zone',
    maturite: 'Decouverte',
    contexte: 'Elle a vu un lien SGEL partage dans un groupe Facebook de gestionnaires de coproprietes Moselle. Elle explore.',
    impression: 'Site propre, note solide. Elle cherche immediatement la zone d\'intervention.',
    parcours: [
      ['Accueil', 'Sarreguemines mentionne — espoir. Mais "limite de zone" inquiete.'],
      ['Services', 'Parcourt les prestations. Rien de specifique copropriete.'],
      ['Avis clients', 'Uniquement des particuliers. Pas de gestionnaire de copropriete.'],
      ['Contact', 'Ne remplit pas. Trop d\'incertitudes sur la zone et le type de chantier.'],
    ] as [string, string][],
    questionCle: 'Interviennent-ils a Sarreguemines sur des coproprietes ?',
    reponse: 'Non' as const,
    commentReponse: 'Sarreguemines cite en limite de zone, coproprietes non evoquees dans les references.',
    impactVitesse: 'Desktop, pas de probleme.',
    impactConfiance: 'Site serieux mais ne repond pas a ses besoins specifiques.',
    positifs: ['Zone Sarreguemines mentionnee', 'Site clair et professionnel', 'Note 4,8 credible'],
    frictions: ['Zone ambigue — "limite" sans confirmation', 'Aucune reference copropriete', 'Aucun email pour une demande formelle', 'Pas de section "Batiments collectifs"'],
    ceQuiFeraitBasculer: 'Une page ou section "Coproprietes et batiments collectifs" avec references + confirmation zone Sarreguemines.',
    exp: 5, conf: 6, clarte: 4,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Afficher certifications, garanties et horaires',
    pourquoi: 'Votre note 4,8/5 convainc ceux qui vous decouvrent. Mais les clients qui comparent activement — professionnels, projets importants — veulent voir vos qualifications officielles et vos garanties avant de vous contacter. Sans ces elements, ils continuent de chercher.',
    action: 'Ajouter sur la page d\'accueil une section "Nos engagements" : horaires d\'ouverture precis (avec confirmation disponibilite urgences), certifications (RGE si applicable, qualifications electricien QUALIFELEC), mention assurance RC pro + garantie travaux, et ann\u00e9es d\'exp\u00e9rience (2011 = 14 ans). Repeter sur la page Contact.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Non mesuree', ok: false, detail: 'Scripts GTM + Didomi chargent en plus — impact mobile probable' },
  { label: 'Securite', verdict: 'C (55/100)', ok: false, detail: 'CSP et HSTS manquants — 2 tests echoues sur 10' },
  { label: 'SEO', verdict: 'A ameliorer', ok: false, detail: 'robots.txt et sitemap.xml absents (erreur 404)' },
  { label: 'Donnees structurees', verdict: 'Partiel', ok: false, detail: 'LocalBusiness + avis OK, mais geo, logo et sameAs manquants' },
  { label: 'Partage reseaux', verdict: 'Absent', ok: false, detail: 'Aucune balise Open Graph — partage sans image ni titre' },
];

const tech = {
  observatory: { grade: 'C', score: 55, testsOk: 8, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'X-Content-Type-Options : nosniff (present)' },
    { ok: true, h: 'X-Frame-Options : SAMEORIGIN (present)' },
    { ok: true, h: 'Referrer-Policy : same-origin (present)' },
    { ok: true, h: 'Permissions-Policy : liste complete (present)' },
    { ok: true, h: 'Cross-Origin-Resource-Policy : same-origin (present)' },
    { ok: true, h: 'Redirection HTTP vers HTTPS (active)' },
    { ok: false, h: 'Strict-Transport-Security (HSTS) : absent — risque attaque MITM' },
    { ok: false, h: 'Content-Security-Policy (CSP) : absent — penalite -25 pts' },
  ],
  schema: [
    { item: 'JSON-LD present (3 blocs)', ok: true },
    { item: '@type LocalBusiness coherent', ok: true },
    { item: 'name + url + telephone', ok: true },
    { item: 'address (Hayange)', ok: true },
    { item: 'aggregateRating 4.8/5 (78 avis)', ok: true },
    { item: 'Review (10 avis detailles)', ok: true },
    { item: 'geo (latitude/longitude)', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'image / logo', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
    { item: 'description', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Absent' },
    { item: 'og:description', ok: false, val: 'Absent' },
    { item: 'og:image', ok: false, val: 'Absent' },
    { item: 'og:url', ok: false, val: 'Absent' },
    { item: 'og:type', ok: false, val: 'Absent' },
    { item: 'twitter:card', ok: false, val: 'Absent' },
    { item: 'canonical', ok: false, val: 'Non detecte' },
  ],
  seo: [
    { item: 'Meta title present : "Entreprise d\'Electricite | Thionville (57) | SGEL"', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'robots.txt accessible', ok: false },
    { item: 'sitemap.xml accessible', ok: false },
    { item: 'Open Graph complete', ok: false },
    { item: 'Images avec alt text', ok: false },
    { item: 'Canonical tag', ok: false },
  ],
};

const alertes: { type: 'critique' | 'important'; titre: string; detail: string; chiffre: string; chiffreLabel: string }[] = [
  { type: 'important' as const, titre: 'Open Graph completement absent', detail: 'Aucune balise Open Graph — un partage sur Facebook ou LinkedIn affiche un lien sans image ni titre. Impact negatif sur le click-through.', chiffre: '0/6', chiffreLabel: 'balises Open Graph presentes' },
  { type: 'important' as const, titre: 'Horaires absents du site', detail: 'Sans horaires visibles, les visiteurs qui cherchent une intervention urgente ne savent pas si vous etes joignables. Friction pour les profils urgence.', chiffre: '2/5', chiffreLabel: 'visiteurs touches par cette friction' },
  { type: 'important' as const, titre: 'Certifications non affichees', detail: 'Les visiteurs en phase Comparaison (professionnels, gros projets) cherchent QUALIFELEC, RGE ou equivalents. Sans certification visible, ils continuent de comparer.', chiffre: 'C', chiffreLabel: 'grade securite Mozilla Observatory' },
];
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO — Verdict immediat -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>

  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilite, fluidite</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Credibilite, preuves, rassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
        <p class="text-[10px] text-neutral-400 mt-1">Comprehension de l'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- 2b. ALERTES -->
{alertes.length > 0 && (
  <section style="background: #fefce8;" class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <div>
          <h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2>
          <p class="text-sm text-neutral-600">
            {alertes.filter(a => a.type === 'critique').length > 0 && <span class="text-red-700 font-medium">{alertes.filter(a => a.type === 'critique').length} critique{alertes.filter(a => a.type === 'critique').length > 1 ? 's' : ''}</span>}
            {alertes.filter(a => a.type === 'critique').length > 0 && alertes.filter(a => a.type === 'important').length > 0 && <span class="mx-1 text-neutral-400">·</span>}
            {alertes.filter(a => a.type === 'important').length > 0 && <span class="text-amber-700 font-medium">{alertes.filter(a => a.type === 'important').length} important{alertes.filter(a => a.type === 'important').length > 1 ? 's' : ''}</span>}
          </p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {alertes.map(a => (
          <div class={`bg-white rounded-xl p-5 ${a.type === 'critique' ? 'border-2 border-red-300' : 'border border-amber-200'}`}>
            <div class="flex items-start gap-4">
              <div class={`text-2xl font-black rounded-lg px-3 py-1 shrink-0 ${a.type === 'critique' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>{a.chiffre}</div>
              <div>
                <p class="font-semibold text-neutral-900 text-sm mb-1">{a.titre}</p>
                <p class="text-xs text-neutral-600">{a.detail}</p>
