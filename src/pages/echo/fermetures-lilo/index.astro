---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'fermetures-lilo';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Fermetures Lilo et Fils';
const urlSite = 'https://www.fermetures-lilo.com/';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 88 76 66 48';
const marcTelLink = 'tel:+33688766648';
const marcWhatsApp = 'https://wa.me/33688766648?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.8,
  confiance: 7.4,
  clarte: 5.8,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart sans rien faire.';

const constat = 'Votre note 4.8/5 et votre certification RGE font un travail remarquable : ceux qui vous cherchent specifiquement vous contactent. Mais ceux qui comparent repartent faute de photos de realisations et d\'information sur les aides de l\'Etat — deux elements qu\'ils cherchent systematiquement avant de demander un devis.';

const canalData = [
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 1, convert: 0, rate: 0 },
  { canal: 'Facebook', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Sandrine',
    age: 47,
    emoji: '🏡',
    situation: 'Proprietaire en renovation a Forbach, veut 8 fenetres et 3 volets RGE',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Le RGE la retient et les avis la convainquent de la qualite, mais elle ne peut pas estimer son budget sans prix. Elle compare avec 2 autres artisans qui affichent des fourchettes.',
    localisation: 'Forbach (57), 25 km',
    maturite: 'Comparaison',
    contexte: 'Elle veut remplacer 8 fenetres et 3 volets pour beneficier de MaPrimeRenov. Son conseiller CEE lui a dit de choisir un artisan RGE certifie.',
    impression: 'Le H1 localisé et le badge RGE la retiennent immediatement. Mais elle attend 3-4 secondes le chargement sur son Android.',
    parcours: [
      ['Accueil', 'Badge RGE et note 4.8 rassurent. Elle cherche une mention des aides energetiques.'],
      ['Nos prestations', 'Fenetres, volets presents. Aucun prix ni fourchette.'],
      ['Avis clients', '184 avis 4.8/5. Confiante sur la qualite. Mais toujours pas de budget indicatif.'],
      ['Contact', 'Cherche un email. Aucun. Formulaire long. Elle ne remplit pas.'],
    ] as [string, string][],
    questionCle: 'Cet artisan peut m\'aider avec les aides energetiques, et combien ca va me couter ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le RGE est visible mais aucune mention de MaPrimeRenov ou CEE. Les prix sont absents.',
    impactVitesse: 'Site probablement lent sur mobile — elle patiente car motivee mais le chargement penalise.',
    impactConfiance: 'La note 4.8 et le RGE compensent la lenteur percue.',
    positifs: ['Badge RGE immediatement visible', '184 avis 4.8/5 tres rassurants', 'Navigation claire par type de produit'],
    frictions: ['Aucun prix ni fourchette tarifaire', 'Aucune mention des aides (MaPrimeRenov, CEE)', 'Email absent — formulaire trop engageant pour comparer'],
    ceQuiFeraitBasculer: 'Une fourchette de prix indicative et une section "Aides de l\'Etat" auraient double ses chances de la convaincre avant ses concurrents.',
    exp: 6, conf: 7, clarte: 5,
  },
  {
    id: 2,
    name: 'Kevin',
    age: 31,
    emoji: '📍',
    situation: 'Primo-accedant a Sarreguemines, veut remplacer sa porte d\'entree',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Il arrive deja convaincu par Google Maps. Il voit le telephone, clique et appelle. La note 4.8 et la proximite suffisent pour passer a l\'action.',
    localisation: 'Sarreguemines (57), meme ville',
    maturite: 'Decision',
    contexte: 'Il cherche un artisan proche et bien note pour remplacer sa porte d\'entree avant l\'hiver. Il tape "menuisier Sarreguemines" sur Google Maps.',
    impression: 'Le site confirme ce qu\'il a vu sur Maps. Pro, local, note. Il cherche le bouton appeler.',
    parcours: [
      ['Accueil', 'Note 4.8 confirmee. Telephone visible. Il clique pour appeler.'],
      ['Contact', 'Adresse confirmee. Formulaire en backup.'],
    ] as [string, string][],
    questionCle: 'Comment je les contacte et quand peuvent-ils venir ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le telephone est la et cliquable. Mais aucun horaire — il ne sait pas s\'il peut appeler maintenant.',
    impactVitesse: 'Quelques secondes, il attend car tres motive.',
    impactConfiance: 'Maximale — il arrive deja avec une forte intention depuis Google Maps.',
    positifs: ['Telephone cliquable sur mobile', 'Note 4.8/5 confirmee', 'Adresse locale rassurante'],
    frictions: ['Aucun horaire d\'ouverture affiché', 'Pas d\'email direct', 'Pas de delai de reponse'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 9, clarte: 7,
  },
  {
    id: 3,
    name: 'Helene',
    age: 55,
    emoji: '🪟',
    situation: 'Proprietaire a Sarralbe, cherche des volets motorises sur recommandation',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Sa voisine est satisfaite. Elle trouve la page volets/motorisation, confirme la competence, et remplit le formulaire. La recommandation transforme la visite en contact immediat.',
    localisation: 'Sarralbe (57), 20 km',
    maturite: 'Decision',
    contexte: 'Sa voisine a fait remplacer ses fenetres par Lilo. Helene veut des volets roulants motorises pour sa veranda. Elle cherche "Fermetures Lilo" sur Google.',
    impression: 'Le site confirme la recommandation. Sobre, professionnel. Elle trouve "Volets" dans le menu directement.',
    parcours: [
      ['Navigation', 'Clique sur "Volets" puis "Motorisation". La competence est confirmee.'],
      ['Avis clients', 'Lit 2-3 temoignages. Un mentionne des volets. Rassurant.'],
      ['Contact', 'Remplit le formulaire en decrivant son projet (4 volets roulants motorises).'],
    ] as [string, string][],
    questionCle: 'Ils font bien les volets motorises, et comment je prends rendez-vous ?',
    reponse: 'Oui' as const,
    commentReponse: 'Section motorisation explicite. Formulaire accessible en 2 clics.',
    impactVitesse: 'Desktop, chargement correct.',
    impactConfiance: 'La recommandation personnelle pese plus que tout signal technique.',
    positifs: ['Section volets et motorisation clairement identifiable', 'Formulaire complet', 'Temoignages rassurants'],
    frictions: ['Aucune photo de realisation de volets motorises', 'Pas de prix indicatifs', 'Pas de mention du delai de reponse'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 8, clarte: 7,
  },
  {
    id: 4,
    name: 'Arnaud',
    age: 38,
    emoji: '🏢',
    situation: 'Gestionnaire de copropriete a Metz, cherche un RGE pour 40 fenetres',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Metz est a 75 km — hors zone des 50 km. Le site est oriente particuliers, pas de references en copropriete. Il repart chercher un autre prestataire. Persona hors cible — c\'est attendu.',
    localisation: 'Metz (57), 75 km — hors zone',
    maturite: 'Comparaison',
    contexte: 'Il doit remplacer 40 fenetres dans un immeuble. Il compare 3 artisans RGE de la region. Il cherche un prestataire avec des references en copropriete.',
    impression: '"Artisan Menuisier a Sarreguemines" — Sarreguemines, c\'est loin de Metz. Il cherche la zone d\'intervention.',
    parcours: [
      ['Accueil', '"Rayon 50 km". Metz est a 75 km. Signal d\'alarme.'],
      ['Nos prestations', 'Oriente particuliers. Aucune mention copropriete ou gros volumes.'],
      ['Contact', 'Pas d\'email pro. Formulaire pas adapte au B2B. Il quitte.'],
    ] as [string, string][],
    questionCle: 'Ils font les grands chantiers copropriete et ils interviennent a Metz ?',
    reponse: 'Non' as const,
    commentReponse: 'Zone 50 km exclut Metz. Aucune reference copropriete. Hors cible.',
    impactVitesse: 'Non pertinent — il quitte rapidement.',
    impactConfiance: 'Note positive mais inadaptee a son besoin B2B.',
    positifs: ['RGE clairement affiché (critere syndics)', 'Zone d\'intervention precisee (meme si negative pour lui)'],
    frictions: ['Zone limitee a 50 km (Metz exclue)', 'Pas de references en copropriete', 'Pas d\'email pro pour une demande B2B'],
    ceQuiFeraitBasculer: 'Ce prospect est hors cible — son depart est normal et attendu.',
    exp: 4, conf: 6, clarte: 6,
  },
  {
    id: 5,
    name: 'Brigitte',
    age: 63,
    emoji: '☀️',
    situation: 'Retraitee a Sarralbe, curieuse des Brise-Soleil Orientables apres un post Facebook',
    canal: 'Facebook',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Interessee par les BSO mais la section est trop courte et sans photos. Elle ne comprend pas assez le produit pour remplir un formulaire. Elle retourne sur Facebook.',
    localisation: 'Sarralbe (57), 20 km',
    maturite: 'Decouverte',
    contexte: 'Elle a vu une publication Facebook de Lilo sur les BSO. Elle clique sur le lien du site pour en savoir plus.',
    impression: 'Note 4.8 rassurante. Design correct sur mobile. Elle cherche les photos de BSO du post Facebook.',
    parcours: [
      ['Accueil', 'Note 4.8 convaincante. Elle cherche une galerie de realisations. Rien.'],
      ['Nos prestations', 'Section BSO presente mais tres courte, sans photo, sans explication.'],
      ['Avis clients', 'Avis sur fenetres et portes. Aucun sur les BSO specifiquement.'],
      ['Contact', 'Le formulaire l\'intimide. Elle veut juste en savoir plus, pas "faire une demande". Elle repart.'],
    ] as [string, string][],
    questionCle: 'C\'est quoi exactement les brise-soleil et est-ce que ca vaut le coup pour ma veranda ?',
    reponse: 'Non' as const,
    commentReponse: 'Section BSO trop courte, pas pedagogique, sans photos, sans prix. Elle repart sans avoir compris le produit.',
    impactVitesse: 'Mobile probablement lent — patience limitee a cet age et sur ce type d\'appareil.',
    impactConfiance: 'Note 4.8 rassure mais insuffisante pour passer a l\'action depuis une simple curiosite.',
    positifs: ['Note 4.8/5 tres rassurante', 'Navigation mobile correcte', 'Coherence avec le post Facebook (BSO mentionne)'],
    frictions: ['Aucune photo de realisation BSO', 'Section BSO trop courte et non pedagogique', 'Pas de prix indicatif', 'Formulaire percu comme trop engageant pour une decouverte'],
    ceQuiFeraitBasculer: 'Des photos de realisations avec une explication simple des benefices (confort, economie, esthetique) et une fourchette de prix auraient transforme sa curiosite en demande de devis.',
    exp: 5, conf: 7, clarte: 4,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Ajouter une galerie de realisations et une section Aides de l\'Etat',
    pourquoi: '3 visiteurs sur 5 cherchent des photos de chantiers termines avant de demander un devis. Et vos clients en renovation cherchent systematiquement comment financer leurs travaux grace au RGE — une information que votre site ne met pas en avant.',
    action: 'Creer une page "Nos realisations" avec 8 a 12 photos de chantiers (avant/apres si possible), et ajouter une section visible sur l\'accueil : "Travaux eligibles MaPrimeRenov et CEE grace a notre certification RGE". Ces deux ajouts repondent aux questions des visiteurs hesitants.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A evaluer', ok: false, detail: 'API quota epuise — estimee lente sur mobile (CMS lourd + widget avis tiers)' },
  { label: 'Securite', verdict: 'D-C estime', ok: false, detail: 'Headers de securite probablement absents (CMS sans configuration avancee)' },
  { label: 'SEO', verdict: 'A ameliorer', ok: false, detail: 'robots.txt absent (404), Open Graph absent, Schema.org incomplet' },
  { label: 'Donnees structurees', verdict: 'Partiel', ok: false, detail: 'LocalBusiness present mais incomplet (pas de geo, horaires, sameAs)' },
  { label: 'Partage reseaux', verdict: 'Absent', ok: false, detail: 'Aucun tag Open Graph detecte — aucun apercu lors du partage' },
];

const tech = {
  observatory: { grade: 'N/D', score: 0, testsOk: 0, testsTotal: 0 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'HTTPS force (redirection active)' },
    { ok: false, h: 'Content-Security-Policy (probablement absent)' },
    { ok: false, h: 'X-Content-Type-Options (probablement absent)' },
    { ok: false, h: 'X-Frame-Options (probablement absent — risque clickjacking)' },
    { ok: false, h: 'Strict-Transport-Security (probablement absent)' },
    { ok: false, h: 'Permissions-Policy (probablement absent)' },
  ],
  schema: [
    { item: 'JSON-LD present', ok: true },
    { item: '@type coherent (LocalBusiness)', ok: true },
    { item: 'name, url', ok: true },
    { item: 'address (38 route de Nancy, Sarreguemines)', ok: true },
    { item: 'telephone (03 54 88 69 57)', ok: true },
    { item: 'aggregateRating (4.8 / 184 avis)', ok: true },
    { item: 'geo (latitude/longitude)', ok: false },
    { item: 'openingHours (horaires absents du site)', ok: false },
    { item: 'image / logo', ok: false },
    { item: 'sameAs (Facebook, annuaires)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Absent' },
    { item: 'og:description', ok: false, val: 'Absent' },
    { item: 'og:image', ok: false, val: 'Absent' },
    { item: 'og:url', ok: false, val: 'Absent' },
    { item: 'og:type', ok: false, val: 'Absent' },
    { item: 'twitter:card', ok: false, val: 'Absent' },
    { item: 'canonical', ok: false, val: 'A verifier' },
  ],
  seo: [
    { item: 'H1 unique et localise', ok: true },
    { item: 'sitemap.xml accessible', ok: true },
    { item: 'HTTPS force', ok: true },
    { item: 'Mobile friendly (viewport)', ok: true },
    { item: 'robots.txt accessible', ok: false },
    { item: 'Open Graph (partage reseaux)', ok: false },
    { item: 'Schema.org complet (geo, horaires, sameAs)', ok: false },
    { item: 'Galerie photos / realisations', ok: false },
  ],
};

const alertes: { type: 'critique' | 'important'; titre: string; detail: string; chiffre: string; chiffreLabel: string }[] = [
  { type: 'important' as const, titre: 'Open Graph completement absent', detail: 'Aucune balise Open Graph — un partage sur Facebook ou LinkedIn affiche un lien sans image ni titre. Impact negatif sur le click-through.', chiffre: '0/6', chiffreLabel: 'balises Open Graph presentes' },
  { type: 'important' as const, titre: 'Email de contact absent', detail: 'Sandrine (prospect type) a cherche un email pour comparer sans s\'engager. Sans email, elle est passee chez un concurrent qui en affichait un.', chiffre: '2/5', chiffreLabel: 'visiteurs touches par cette friction' },
  { type: 'important' as const, titre: 'Galerie de realisations absente', detail: '3 visiteurs sur 5 cherchent des photos de chantiers termines avant de demander un devis. L\'absence de visuels freine la decision.', chiffre: '3/5', chiffreLabel: 'visiteurs cherchant des photos' },
  { type: 'important' as const, titre: 'Horaires non affiches', detail: 'Kevin a voulu appeler mais ne savait pas si le cabinet etait ouvert maintenant. Les horaires manquants creent une hesitation avant l\'appel.', chiffre: '2/5', chiffreLabel: 'visiteurs touches par cette friction' },
];
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO — Verdict immediat -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>

  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilite, fluidite</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Credibilite, preuves, rassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
        <p class="text-[10px] text-neutral-400 mt-1">Comprehension de l'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- 2b. ALERTES -->
{alertes.length > 0 && (
  <section style="background: #fefce8;" class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <div>
          <h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2>
          <p class="text-sm text-neutral-600">
            {alertes.filter(a => a.type === 'critique').length > 0 && <span class="text-red-700 font-medium">{alertes.filter(a => a.type === 'critique').length} critique{alertes.filter(a => a.type === 'critique').length > 1 ? 's' : ''}</span>}
            {alertes.filter(a => a.type === 'critique').length > 0 && alertes.filter(a => a.type === 'important').length > 0 && <span class="mx-1 text-neutral-400">·</span>}
            {alertes.filter(a => a.type === 'important').length > 0 && <span class="text-amber-700 font-medium">{alertes.filter(a => a.type === 'important').length} important{alertes.filter(a => a.type === 'important').length > 1 ? 's' : ''}</span>}
          </p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {alertes.map(a => (
          <div class={`bg-white rounded-xl p-5 ${a.type === 'critique' ? 'border-2 border-red-300' : 'border border-amber-200'}`}>
            <div class="flex items-start gap-4">
