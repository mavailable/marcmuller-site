      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden bg-white">
        <h3 class="font-semibold text-neutral-900 text-sm">Securite HTTP — Mozilla Observatory <span class="text-xs font-normal text-neutral-500 ml-2">Note {tech.observatory.grade} ({tech.observatory.score}/100)</span></h3>
        <svg class="w-5 h-5 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 bg-white border-t border-neutral-100">
        <div class="mt-3 space-y-1">
          {tech.headers.map(h => (
            <div class="flex items-center gap-2 py-1">
              {h.ok
                ? <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                : <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              }
              <span class={`text-xs ${h.ok ? 'text-neutral-700' : 'text-red-500'}`}>{h.h}</span>
            </div>
          ))}
        </div>
      </div>
    </details>

    <!-- Schema.org -->
    <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden bg-white">
        <h3 class="font-semibold text-neutral-900 text-sm">Schema.org <span class="text-xs font-normal text-red-500 ml-2">{tech.schema.filter(s => s.ok).length}/{tech.schema.length} elements</span></h3>
        <svg class="w-5 h-5 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 bg-white border-t border-neutral-100">
        <div class="mt-3 space-y-1">
          {tech.schema.map(s => (
            <div class="flex items-center gap-2 py-1">
              {s.ok
                ? <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                : <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              }
              <span class={`text-xs ${s.ok ? 'text-neutral-700' : 'text-red-500'}`}>{s.item}</span>
            </div>
          ))}
        </div>
      </div>
    </details>

    <!-- OG + SEO -->
    <details class="group border border-neutral-200 rounded-xl overflow-hidden">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden bg-white">
        <h3 class="font-semibold text-neutral-900 text-sm">Open Graph + SEO technique</h3>
        <svg class="w-5 h-5 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 bg-white border-t border-neutral-100">
        <p class="text-xs font-semibold text-neutral-700 mt-3 mb-2">Open Graph</p>
        <div class="space-y-1 mb-4">
          {tech.og.map(o => (
            <div class="flex items-start gap-2 py-0.5">
              {o.ok
                ? <svg class="w-4 h-4 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                : <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              }
              <span class="text-xs text-neutral-700">{o.item} <span class="text-neutral-400">— {o.val}</span></span>
            </div>
          ))}
        </div>
        <p class="text-xs font-semibold text-neutral-700 mb-2">SEO technique</p>
        <div class="space-y-1">
          {tech.seo.map(s => (
            <div class="flex items-center gap-2 py-0.5">
              {s.ok
                ? <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                : <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              }
              <span class={`text-xs ${s.ok ? 'text-neutral-700' : 'text-red-500'}`}>{s.item}</span>
            </div>
          ))}
        </div>
      </div>
    </details>
  </section>

  <!-- ═══ 7. METHODOLOGIE ═══ -->
  <section class="bg-neutral-50 py-16 border-t border-neutral-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-6">Methodologie</h2>
      <div class="grid gap-4 md:grid-cols-5">
        {[
          { step: '1', title: 'Scraping', desc: 'Extraction du contenu, navigation, meta tags, Schema.org' },
          { step: '2', title: 'Audit technique', desc: 'PageSpeed, Observatory, headers, donnees structurees' },
          { step: '3', title: 'Personas', desc: `Creation de ${kpis.nbPersonas} profils visiteurs realistes et diversifies` },
          { step: '4', title: 'Simulation', desc: `${kpis.nbPersonas} visites simulees par agents IA independants` },
          { step: '5', title: 'Synthese', desc: 'Agregation des frictions, recommandations priorisees' },
        ].map(s => (
          <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
            <div class="text-lg font-black mb-1" style="color: #E86C47;">{s.step}</div>
            <div class="text-sm font-semibold text-neutral-900 mb-1">{s.title}</div>
            <p class="text-[11px] text-neutral-500">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

