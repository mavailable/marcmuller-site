---

<BaseLayout title={`Echo Decouverte — ${nomProspect}`} description={`Rapport Echo : ${kpis.nbPersonas} visiteurs simules sur ${urlSite}`} noindex={true}>

  <!-- ═══ 1. HERO ═══ -->
  <section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
    <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2); color: #ef4444;">
        Rapport confidentiel — {formuleLabel}
      </div>
      <h1 class="mb-4 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
        {nomProspect}<br/>
        <span class="text-lg md:text-xl font-normal" style="color: rgba(255,255,255,0.5);">{verdictHero}</span>
      </h1>
      <p class="mb-8 text-sm md:text-base" style="color: rgba(255,255,255,0.45);">
        Site teste : <a href={urlSite} target="_blank" rel="noopener" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} personas · {dateAudit}
      </p>

      <!-- KPI cards -->
      <div class="grid grid-cols-3 gap-4">
        <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.2);">
          <div class="text-3xl font-bold text-green-400 mb-1">{kpis.nbConvertissent}</div>
          <div class="text-xs" style="color: rgba(255,255,255,0.5);">Contactent</div>
        </div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2);">
          <div class="text-3xl font-bold text-amber-400 mb-1">{kpis.nbHesitent}</div>
          <div class="text-xs" style="color: rgba(255,255,255,0.5);">Hesitent</div>
        </div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1);">
          <div class="text-3xl font-bold mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
          <div class="text-xs" style="color: rgba(255,255,255,0.35);">Repartent</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 2. LE CONSTAT ═══ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl font-bold text-neutral-900 mb-6">Le constat</h2>
    <div class="rounded-xl p-6 mb-10 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
      <p class="text-sm md:text-base text-neutral-700 leading-relaxed">{constat}</p>
    </div>

    <!-- Scores -->
    <div class="grid grid-cols-3 gap-4 mb-10">
      <div class="bg-white border border-neutral-200 rounded-xl p-5 text-center">
        <div class="text-3xl font-bold text-neutral-800 mb-1">{kpis.experience}</div>
        <div class="text-xs text-neutral-500">Experience /10</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-5 text-center">
        <div class="text-3xl font-bold text-neutral-800 mb-1">{kpis.confiance}</div>
        <div class="text-xs text-neutral-500">Confiance /10</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-5 text-center">
        <div class="text-3xl font-bold text-neutral-800 mb-1">{kpis.clarte}</div>
        <div class="text-xs text-neutral-500">Clarte /10</div>
      </div>
    </div>

    <!-- Conversion par canal -->
    <h3 class="text-lg font-bold text-neutral-900 mb-4">Conversion par canal d'arrivee</h3>
    <div class="space-y-3">
      {canalData.map(c => (
        <div>
          <div class="flex items-center justify-between text-sm mb-1">
            <span class="text-neutral-700">{c.canal} <span class="text-neutral-400 text-xs">({c.nb} visiteurs)</span></span>
            <span class="font-semibold" style={`color: ${c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444'}`}>{c.rate}%</span>
          </div>
          <div class="h-2 bg-neutral-100 rounded-full overflow-hidden">
