---

<BaseLayout title="Echo Complet \u2014 numinam.com" description="Rapport Echo Complet : 20 visiteurs ont teste votre site. Voici ce qu'ils en pensent." noindex={true} lang="fr" frPath="/echo/numinam" ogImage="/og-echo.png">

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} &middot; Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> &middot; {kpis.nbPersonas} visiteurs simules &middot; {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      {[{l:'Experience',v:kpis.experience,d:'Navigation, lisibilite, fluidite'},{l:'Confiance',v:kpis.confiance,d:'Credibilite, preuves, rassurance'},{l:'Clarte',v:kpis.clarte,d:"Comprehension de l'offre et des prix"}].map(s=>(
        <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-neutral-800 mb-1">{s.v}<span class="text-sm text-neutral-400">/10</span></div>
          <div class="text-xs text-neutral-500">{s.l}</div>
          <p class="text-[10px] text-neutral-400 mt-1">{s.d}</p>
        </div>
      ))}
    </div>
  </details>
</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    {['Convertit','Hesite','Quitte'].map(dec => {
      const filtered = personas.filter(p => p.decision === dec);
      const cfg = dec === 'Convertit' ? {border:'border-green-200',badge:'bg-green-600',title:'Ceux qui vous contactent',titleColor:'text-green-800',dot:'bg-green-500',count:kpis.nbConvertissent,countColor:'text-green-600'}
        : dec === 'Hesite' ? {border:'border-amber-200',badge:'bg-amber-500',title:'Ceux qui hesitent',titleColor:'text-amber-800',dot:'bg-amber-500',count:kpis.nbHesitent,countColor:'text-amber-600'}
        : {border:'border-neutral-200',badge:'bg-neutral-400',title:'Ceux qui repartent',titleColor:'text-neutral-600',dot:'bg-neutral-400',count:kpis.nbRepartent,countColor:'text-neutral-500'};
      return (
        <div class="mb-10">
          <h3 class={`text-base font-bold ${cfg.titleColor} mb-4 flex items-center gap-2`}>
            <span class={`w-2.5 h-2.5 rounded-full ${cfg.dot} inline-block`}></span>
            {cfg.title}
            <span class={`text-sm font-normal ${cfg.countColor}`}>({cfg.count})</span>
          </h3>
          <div class="space-y-3">
            {filtered.map(p => (
              <details class={`group persona-card bg-white rounded-xl overflow-hidden shadow-sm border ${cfg.border}`} data-canal={p.canal}>
                <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                      <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                      <span class={`text-[10px] ${cfg.badge} text-white px-1.5 py-0.5 rounded font-medium`}>{p.decisionLabel}</span>
                    </div>
                    <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                    <div class="flex flex-wrap items-center gap-1.5">
                      <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                      <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                      <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                    </div>
                  </div>
                  <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class={`px-4 pb-5 border-t ${cfg.border}`}>
                  <div class="grid gap-4 text-xs mt-4">
                    <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                    <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                    <div>
                      <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                      <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                        {p.parcours.map(([section, reaction]: [string, string]) => (<li><strong class="text-neutral-800">{section}</strong>{reaction ? ` \u2014 ${reaction}` : ''}</li>))}
                      </ol>
                    </div>
                    <div class="bg-neutral-50 rounded-lg p-3">
                      <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                      <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                      <p class="text-neutral-600">Le site repond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> \u2014 {p.commentReponse}</p>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                      <div><p class="font-semibold text-green-700 mb-1.5">{'\u2713'} Points positifs</p><ul class="space-y-1 text-neutral-600">{p.positifs.map((pt: string) => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">{'\u00B7'}</span>{pt}</li>)}</ul></div>
                      <div><p class="font-semibold text-amber-700 mb-1.5">{'\u2717'} Frictions</p><ul class="space-y-1 text-neutral-600">{p.frictions.map((f: string) => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">{'\u00B7'}</span>{f}</li>)}</ul></div>
                    </div>
                    {p.ceQuiFeraitBasculer && (
                      <div class="rounded-lg p-3" style="background: rgba(232,108,71,0.05);">
                        <p class="font-semibold text-[10px] uppercase tracking-wider mb-1" style="color: #E86C47;">{dec === 'Hesite' ? "Ce qui le ferait passer a l'action" : "Ce qui l'aurait retenu"}</p>
                        <p style="color: #D4572F;">{p.ceQuiFeraitBasculer}</p>
                      </div>
                    )}
                    <div class="flex gap-6 pt-3 border-t border-neutral-100">
                      {[{label:'Experience',val:p.exp},{label:'Confiance',val:p.conf},{label:'Clarte',val:p.clarte}].map(s => {
                        const sColor = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
                        return (<div class="text-center"><span class={`block text-lg font-bold ${sColor}`}>{s.val}</span><span class="text-[10px] text-neutral-400">{s.label}</span></div>);
                      })}
                    </div>
                  </div>
                </div>
              </details>
            ))}
          </div>
          {dec === 'Hesite' && (
            <div class="rounded-xl p-5 mt-4 bg-amber-50 border border-amber-200 flex items-start gap-3">
              <span class="text-lg shrink-0 mt-0.5">{'\u{1F4A1}'}</span>
              <div><p class="text-sm font-medium text-amber-900">Ces {kpis.nbHesitent} visiteurs ont besoin de vos services.</p><p class="text-xs text-amber-700 mt-1">Il leur manque un element de rassurance pour passer a l'action. C'est votre plus gros levier de croissance.</p></div>
            </div>
          )}
          {dec === 'Quitte' && (
            <div class="rounded-xl p-5 mt-4 bg-neutral-100 border border-neutral-200 flex items-start gap-3">
              <span class="text-lg shrink-0 mt-0.5">{'\u{1F4C9}'}</span>
              <div><p class="text-sm font-medium text-neutral-800">Chaque visiteur qui repart, c'est un client en moins.</p><p class="text-xs text-neutral-600 mt-1">Certains n'etaient pas dans votre cible — c'est normal. Mais d'autres avaient un vrai besoin et votre site ne les a pas convaincus.</p></div>
            </div>
          )}
        </div>
      );
    })}
  </div>
</section>

<!-- 4. CE QU'ON RECOMMANDE -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <h2 class="text-2xl font-bold text-neutral-900 mb-2">Ce qu'on recommande</h2>
  <p class="text-neutral-600 mb-8">Actions concretes, classees par impact sur vos visiteurs.</p>
  <p class="text-sm font-semibold text-red-700 mb-4">Si vous ne changez que {ameliorationsHautes.length} choses :</p>
  <div class="space-y-4 mb-12">
    {ameliorationsHautes.map(a => (
      <div class="bg-white border-2 border-red-200 rounded-xl p-6 shadow-sm">
        <div class="flex items-start justify-between gap-4 mb-3">
          <h4 class="font-bold text-neutral-900">{a.titre}</h4>
          <span class="text-[10px] px-2 py-1 rounded-full bg-red-100 text-red-700 font-semibold shrink-0 whitespace-nowrap">{a.impact}</span>
        </div>
        <p class="text-sm text-neutral-600 mb-3">{a.pourquoi}</p>
        <div class="bg-neutral-50 rounded-lg px-4 py-3 flex items-start gap-2">
          <svg class="w-4 h-4 text-neutral-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          <p class="text-xs text-neutral-700">{a.action}</p>
        </div>
      </div>
    ))}
  </div>
  <h3 class="text-lg font-bold text-neutral-900 mb-2">Utile aussi</h3>
  <div class="grid md:grid-cols-2 gap-4 mb-12">
    {ameliorationsUtiles.map(a => (<div class="bg-white border border-neutral-200 rounded-xl p-5"><h4 class="font-semibold text-neutral-900 text-sm mb-2">{a.titre}</h4><p class="text-xs text-neutral-600">{a.detail}</p></div>))}
  </div>
  <h3 class="text-lg font-bold text-neutral-900 mb-2">A discuter</h3>
  <p class="text-sm text-neutral-500 mb-4">Decisions business — pas de bonne ou mauvaise reponse.</p>
  <div class="space-y-3 mb-12">
    {ameliorationsDiscuter.map(a => (<div class="bg-neutral-50 border border-neutral-200 rounded-xl p-4 flex gap-3"><span class="text-lg shrink-0">{a.emoji}</span><div><h4 class="font-semibold text-neutral-900 text-sm mb-0.5">{a.titre}</h4><p class="text-xs text-neutral-600">{a.detail}</p></div></div>))}
  </div>
  <div class="rounded-2xl p-8 text-center border-2 border-dashed" style="border-color: #E86C47; background: rgba(232,108,71,0.03);">
    <p class="text-lg font-bold text-neutral-900 mb-2">{kpis.nbPersonas} visiteurs confirment des tendances claires.</p>
    <p class="text-sm text-neutral-600 mb-6">Avec 100 visiteurs (Echo Pro), vous obtenez une fiabilite statistique : analyse par canal, par maturite, et un appel de 30 min pour parcourir le rapport ensemble.</p>
    <a href="/echo/" class="inline-flex items-center gap-2 px-6 py-3 text-white font-semibold rounded-xl transition-all shadow-md hover:-translate-y-0.5" style="background: linear-gradient(135deg, #E86C47, #D4572F);">Echo Pro — 250&#8364; <span class="text-xs opacity-70 ml-1">(100 visiteurs + appel 30 min)</span></a>
  </div>
</section>

<!-- 5. SOUS LE CAPOT -->
<section class="py-16 border-t border-neutral-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Sous le capot</h2>
    <p class="text-neutral-600 mb-8">Pour les curieux : ce que les outils techniques disent de votre site.</p>
    <div class="flex flex-wrap gap-3 mb-10">
      {techVerdicts.map(v => (
        <div class={`inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border text-sm font-medium ${v.ok ? 'bg-green-50 border-green-200 text-green-800' : 'bg-red-50 border-red-200 text-red-800'}`}>
          {v.ok ? <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> : <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>}
          <span>{v.label}</span><span class="text-xs opacity-70">{v.verdict}</span>
        </div>
      ))}
    </div>

    {/* PageSpeed */}
    <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
        <div class="flex items-center gap-3"><span class="text-base">{'\u26A1'}</span><div><h3 class="font-semibold text-neutral-900 text-sm">Vitesse du site</h3><p class="text-[11px] text-neutral-500">{techVerdicts[0].detail}</p></div></div>
        <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-neutral-100">
        <p class="text-xs text-neutral-500 py-2 mb-2">Scores Google PageSpeed Insights (mobile)</p>
        <div class="grid grid-cols-4 gap-4 py-2">
          {['Performance', 'Accessibilite', 'Bonnes pratiques', 'SEO'].map((label, i) => {
            const scores = [tech.pagespdMobile.performance, tech.pagespdMobile.accessibility, tech.pagespdMobile.bestPractices, tech.pagespdMobile.seo];
            const score = scores[i]; const color = score >= 90 ? '#22c55e' : score >= 50 ? '#f59e0b' : '#ef4444';
            return (<div class="text-center"><div class="relative w-14 h-14 mx-auto mb-2"><svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36"><path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e5e7eb" stroke-width="3" /><path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke={color} stroke-width="3" stroke-dasharray={`${score}, 100`} stroke-linecap="round" /></svg><span class="absolute inset-0 flex items-center justify-center text-sm font-bold" style={`color: ${color}`}>{score}</span></div><p class="text-[11px] text-neutral-600">{label}</p></div>);
          })}
        </div>
      </div>
    </details>

    {/* Observatory */}
    <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
        <div class="flex items-center gap-3"><span class="text-base">{'\u{1F512}'}</span><div><h3 class="font-semibold text-neutral-900 text-sm">Securite</h3><p class="text-[11px] text-neutral-500">{techVerdicts[1].detail}</p></div></div>
        <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-neutral-100">
        <p class="text-xs text-neutral-500 py-2">Note : {tech.observatory.grade} ({tech.observatory.testsOk}/{tech.observatory.testsTotal} tests passes)</p>
        {tech.headers.map(h => (<div class="flex items-center gap-2 py-1">{h.ok ? <svg class="w-3.5 h-3.5 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> : <svg class="w-3.5 h-3.5 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>}<span class={`text-xs ${h.ok ? 'text-neutral-600' : 'text-red-500'}`}>{h.h}</span></div>))}
      </div>
    </details>

    {/* Schema.org */}
    <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
        <div class="flex items-center gap-3"><span class="text-base">{'\u{1F4CA}'}</span><div><h3 class="font-semibold text-neutral-900 text-sm">Donnees structurees (Schema.org)</h3><p class="text-[11px] text-neutral-500">{techVerdicts[3].detail}</p></div></div>
        <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-neutral-100">
        {tech.schema.map(s => (<div class="flex items-center gap-2 py-1">{s.ok ? <svg class="w-3.5 h-3.5 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> : <svg class="w-3.5 h-3.5 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>}<span class={`text-xs ${s.ok ? 'text-neutral-600' : 'text-red-500 font-medium'}`}>{s.item}</span></div>))}
      </div>
    </details>

    {/* OG */}
    <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
        <div class="flex items-center gap-3"><span class="text-base">{'\u{1F517}'}</span><div><h3 class="font-semibold text-neutral-900 text-sm">Apercu reseaux sociaux (Open Graph)</h3><p class="text-[11px] text-neutral-500">{techVerdicts[4].detail}</p></div></div>
        <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-neutral-100">
        {tech.og.map(o => (<div class="flex items-start gap-2 py-1"><svg class="w-3.5 h-3.5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span class="text-xs text-neutral-600">{o.item} <span class="text-neutral-400">{o.val}</span></span></div>))}
      </div>
    </details>

    {/* SEO */}
    <details class="group border border-neutral-200 rounded-xl overflow-hidden bg-white">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
        <div class="flex items-center gap-3"><span class="text-base">{'\u{1F50D}'}</span><div><h3 class="font-semibold text-neutral-900 text-sm">SEO technique</h3><p class="text-[11px] text-neutral-500">{techVerdicts[2].detail}</p></div></div>
        <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-neutral-100">
        {tech.seo.map(s => (<div class="flex items-center gap-2 py-1"><svg class="w-3.5 h-3.5 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span class="text-xs text-neutral-600">{s.item}</span></div>))}
      </div>
    </details>

    <div class="mt-8 rounded-xl p-5 bg-white border border-neutral-200 flex items-start gap-3">
      <span class="text-lg shrink-0 mt-0.5">{'\u{1F527}'}</span>
      <div><p class="text-sm font-medium text-neutral-800">Votre site est deja tres bien construit techniquement.</p><p class="text-xs text-neutral-600 mt-1">Les quelques ajustements recommandes (CSP, mentions legales) sont rapides a implementer et fermeraient les dernieres portes ouvertes.</p></div>
    </div>
  </div>
</section>

<!-- 6. METHODOLOGIE -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-neutral-200">
  <h2 class="text-base font-bold text-neutral-900 mb-4">Comment ca marche</h2>
  <ol class="space-y-3 text-sm text-neutral-600">
    {['On scrape votre site \u2014 on lit chaque page comme un visiteur le ferait','On audite la technique \u2014 vitesse, securite, referencement, donnees structurees',`On cree ${kpis.nbPersonas} profils realistes \u2014 adaptes a votre secteur et votre zone geographique`,'Chaque profil visite votre site et donne son avis \u2014 premiere impression, parcours, decision','On compile les resultats \u2014 frictions recurrentes, canaux performants, recommandations'].map((t,i) => (
      <li class="flex gap-3"><span class="w-6 h-6 rounded-full bg-neutral-100 text-neutral-500 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">{i+1}</span><span>{t}</span></li>
    ))}
  </ol>
</section>

<!-- 7. CTA FINAL -->
<section class="relative w-full px-6 py-20 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute bottom-[10%] right-[10%] w-[400px] h-[400px] rounded-full blur-[160px] pointer-events-none" style="background: #E86C47; opacity: 0.05;"></div>
  <div class="relative mx-auto max-w-3xl z-10 text-center">
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-4 leading-tight">20 visiteurs. Imaginez ce que 100 prouveraient.</h2>
    <p class="text-sm mb-8" style="color: rgba(255,255,255,0.5);">L'Echo Pro : 100 visiteurs pour une fiabilite statistique, analyse par canal et par maturite, et 30 minutes ensemble pour parcourir le rapport.</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/echo/" class="inline-flex items-center gap-2 px-8 py-4 text-white font-semibold rounded-xl transition-all shadow-lg hover:-translate-y-0.5" style="background: linear-gradient(135deg, #E86C47, #D4572F); box-shadow: 0 4px 24px rgba(232, 108, 71, 0.35);">
        Echo Pro — 250&#8364;
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
      <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 border border-neutral-600 font-semibold rounded-xl transition-all hover:border-white/40" style="color: rgba(255,255,255,0.6);">En discuter d'abord</a>
    </div>
  </div>
</section>

</BaseLayout>
