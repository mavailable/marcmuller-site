---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'menuiserie-ade';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Menuiserie ADE';
const urlSite = 'https://www.menuiserie-ade.fr';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 88 76 66 48';
const marcTelLink = 'tel:+33688766648';
const marcWhatsApp = 'https://wa.me/33688766648?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.2,
  confiance: 5.8,
  clarte: 5.8,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'Menuiserie ADE a de vrais atouts : 160 ans d\'histoire familiale, certification RGE, galerie de realisations complete et une gamme de services rare (fenetres, parquets, portes, volets — tout en un). Mais le site souffre d\'un manque critique : aucun avis client, aucun temoignage, aucune note Google visible. Pour un artisan qui intervient a domicile, la confiance est le premier declencheur d\'appel. 2 visiteurs sur 5 ont cherche une preuve sociale avant de composer le numero — et n\'ont rien trouve. La certification RGE — qui ouvre droit aux aides MaPrimeRenov — n\'est pas mise en valeur, alors qu\'elle est un argument commercial decisif.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Sandrine',
    age: 48,
    emoji: '🪟',
