      ['Accueil', '"Depuis 1863, 5eme generation" — credibilite immediate'],
      ['Nos prestations', 'Trouve "installateur fenetres PVC Metz" — exactement ce qu\'elle cherche'],
      ['La menuiserie ADE', 'Logo RGE visible — argument decisif pour les aides'],
      ['Contact', 'Appelle le 03 87 32 49 58'],
    ] as [string, string][],
    questionCle: 'Ils sont bien RGE ? Je peux avoir les aides MaPrimeRenov ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Logo RGE visible mais les aides MaPrimeRenov ne sont pas expliquees — argument commercial manque.',
    impactVitesse: 'Acceptable sur desktop. Elle patiente.',
    impactConfiance: 'Logo RGE compense l\'absence de temoignages pour ce profil en Decision.',
    positifs: ['Logo RGE visible', '"Depuis 1863" rassure', 'Email pro contact@menuiserie-ade.fr', 'Gamme fenetres complete (bois, PVC, alu, mixtes)'],
    frictions: ['Aides MaPrimeRenov non mentionnees', 'Pas de fourchette de prix', 'Pas de temoignages'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 7, clarte: 6,
  },
  {
    id: 2,
    name: 'Jean-Pierre',
    age: 64,
    emoji: '🚪',
    situation: 'Retraite a Woippy, recommande par son beau-frere',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Son beau-frere a fait poser un parquet par Menuiserie ADE l\'an dernier. Jean-Pierre veut remplacer ses volets battants. Il tape le nom dans Google, confirme l\'identite, trouve le telephone et appelle.',
    localisation: 'Woippy (57140)',
    maturite: 'Decision',
    contexte: 'Son beau-frere a eu de bons retours. Il cherche juste a confirmer que c\'est bien eux et a trouver le numero de telephone.',
    impression: '"Menuiserie ADE — Parc Artisanal Plesnois" — c\'est bien eux. Il cherche le telephone.',
    parcours: [
      ['Accueil', 'Identite confirmee — entreprise familiale, adresse Plesnois'],
      ['Volets battants', 'Page dediee — ils font bien ca'],
      ['Contact', 'Telephone 03 87 32 49 58 trouve, appelle'],
    ] as [string, string][],
    questionCle: 'C\'est bien eux ? Comment je les appelle ?',
    reponse: 'Oui' as const,
    commentReponse: 'Nom clairement affiche, adresse visible, telephone present en pied de page.',
    impactVitesse: 'OK sur desktop, pas de probleme.',
    impactConfiance: 'La recommandation du beau-frere pese plus que tout.',
    positifs: ['Identite claire', 'Adresse et telephone presents', 'Email professionnel', 'Ton artisanal familial'],
    frictions: ['Telephone uniquement en pied de page — pas dans le header'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 8, clarte: 7,
  },
  {
    id: 3,
    name: 'Amandine',
    age: 35,
    emoji: '📱',
    situation: 'Proprietaire a Metz-Nord, cherche un artisan pour sa porte d\'entree',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle voit Menuiserie ADE sur Google Maps. Clique sur le site depuis la fiche. Cherche des avis clients — elle n\'en trouve aucun sur le site. Retourne sur Maps pour comparer.',
    localisation: 'Metz (57000)',
    maturite: 'Comparaison',
    contexte: 'Elle compare 3 artisans pour remplacer sa porte d\'entree. Elle veut voir des avis avant d\'appeler quelqu\'un qui interviendra chez elle.',
    impression: 'Site qui charge lentement sur mobile. "Menuiserie ADE" — ok, elle cherche la note Google et les avis.',
    parcours: [
      ['Accueil mobile', 'Chargement lent — cherche note Google / avis → absents du site'],
