    ceQuiFeraitBasculer: '2-3 temoignages clients parquet avec montant indicatif ou "chantier de X m2". Fourchette "a partir de X e/m2 pose comprise".',
    exp: 5, conf: 5, clarte: 5,
  },
  {
    id: 5,
    name: 'Lucie',
    age: 29,
    emoji: '🏢',
    situation: 'Locataire a Metz — hors cible',
    canal: 'Reseaux sociaux',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Locataire, elle suit un groupe Facebook local. Quelqu\'un mentionne Menuiserie ADE pour des stores. Elle clique. En 10 secondes, elle comprend que l\'offre est pour proprietaires qui renovent. Elle quitte.',
    localisation: 'Metz (57000)',
    maturite: 'Decouverte',
    contexte: 'Elle cherche des stores decoratifs pas chers pour son appartement en location. Elle n\'a pas les droits pour faire des travaux structurels.',
    impression: 'Site d\'artisan orienté travaux de renovation. Pas pour son profil locataire.',
    parcours: [
      ['Accueil mobile', 'Chargement lent — comprend que c\'est pour proprietaires qui renovent'],
      ['Stores interieurs', 'Pose et installation — trop important pour une location'],
      ['Quitte', 'Hors cible — cherche ailleurs'],
    ] as [string, string][],
    questionCle: 'Ils font des stores pour locataires aussi ?',
    reponse: 'Non' as const,
    commentReponse: 'Le site est clairement oriente renovation / installation — ce qui est normal pour une menuiserie. Lucie n\'est pas la cible.',
    impactVitesse: 'Sans objet — hors cible de toute facon.',
    impactConfiance: 'Sans objet.',
    positifs: ['Positionnement clair (propriétaires renovateurs)'],
    frictions: ['Hors cible — c\'est normal et acceptable'],
    ceQuiFeraitBasculer: 'Rien — ce profil n\'est pas la cible de Menuiserie ADE.',
    exp: 4, conf: 5, clarte: 6,
  },
