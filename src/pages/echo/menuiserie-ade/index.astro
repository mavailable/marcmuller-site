    frictions: ['Aucun avis client / temoignage', 'Pas de note Google visible', 'Chargement lent mobile', 'Pas de fourchette de prix'],
    ceQuiFeraitBasculer: '3-4 temoignages clients avec prenom + ville + type de travaux. Une note /5 Google visible en page d\'accueil.',
    exp: 4, conf: 4, clarte: 5,
