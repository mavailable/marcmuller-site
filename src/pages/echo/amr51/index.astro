  { label: 'Sécurité', verdict: "B", ok: true, detail: "Grade Mozilla Observatory : B" },
  { label: 'Fiche métier', verdict: "\u00c0 compl\u00e9ter", ok: false, detail: "Pas reconnue par Google comme entreprise locale" },
  { label: 'Partage réseaux', verdict: "Incomplet", ok: false, detail: "Aper\u00e7u cass\u00e9 sur Facebook / WhatsApp" },
  { label: 'Visibilité Google', verdict: "\u00c0 am\u00e9liorer", ok: false, detail: "M\u00e9tier \u00e9nonc\u00e9, indexable" },
];

const tech = {
  observatory: { grade: "B", score: 75 },
  pagespdMobile: { performance: 48 },
  pagespdDesktop: { performance: 70 },
  cwv: { lcp: "11,2 s", cls: "0,29" },
  schema: [
    { item: 'Fiche Organization (identité de l\'entreprise)', ok: true },
    { item: 'Fiche LocalBusiness (entreprise locale géolocalisée)', ok: false },
    { item: 'Fil d\'Ariane (BreadcrumbList)', ok: true },
    { item: 'Site identifié (WebSite)', ok: true },
    { item: 'Avis structurés (aggregateRating)', ok: false }
  ],
};

function decisionBorder(d) {
  if (d === 'Convertit') return 'border-green-200';
  if (d === 'Hésite') return 'border-amber-200';
  return 'border-neutral-200';
}
function decisionBadge(d) {
  if (d === 'Convertit') return 'bg-green-600';
  if (d === 'Hésite') return 'bg-amber-500';
  return 'bg-neutral-400';
}
---
<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath={`/echo/${slug}`}
>

  <!-- HERO -->
  <section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
    <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
        {formuleLabel} &middot; Rapport confidentiel
      </div>
      <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
        {verdictHero}
      </h1>
      <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
        Site analysé : <a href={urlSite} target="_blank" rel="noopener" class="underline hover:text-white transition-colors">{urlSite}</a> &middot; {kpis.nbPersonas} visiteurs simulés &middot; {dateAudit}
      </p>
      <div class="grid grid-cols-3 gap-4">
        <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
          <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
          <div class="text-sm text-green-400/70">vous contactent</div>
        </div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
          <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
          <div class="text-sm text-amber-400/70">hésitent</div>
        </div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
          <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
          <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONSTAT -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
      <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
    </div>

    <h2 class="text-xl font-bold text-neutral-900 mb-2">D'où viennent vos visiteurs</h2>
    <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivée.</p>
    <div class="space-y-4 mb-12">
      {canalData.map(c => {
        const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
        return (
          <div class="flex items-center gap-4">
            <div class="w-52 text-sm text-neutral-700 shrink-0">{c.canal}</div>
            <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
            </div>
            <div class="w-20 text-right">
              <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
              <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- ALERTES -->
  <section class="py-12" style="background: #fefce8;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
        <div>
          <h2 class="text-lg font-bold text-neutral-900">Problèmes détectés</h2>
          <p class="text-sm text-neutral-600">
            {alertes.filter(a => a.type === 'critique').length} critiques &middot; {alertes.filter(a => a.type === 'important').length} importants
          </p>
        </div>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        {alertes.map(a => (
          <div class={`bg-white rounded-xl p-5 ${a.type === 'critique' ? 'border-2 border-red-300' : 'border border-amber-300'}`}>
            <div class={`inline-block text-2xl font-black px-3 py-1 rounded-lg mb-3 ${a.type === 'critique' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>
              {a.chiffre}
            </div>
            <p class="text-[10px] text-neutral-400 uppercase tracking-wider mb-1">{a.chiffreLabel}</p>
            <h3 class="font-semibold text-neutral-900 text-sm mb-2">{a.titre}</h3>
            <p class="text-xs text-neutral-600 leading-relaxed">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PERSONAS -->
  <section class="py-16" style="background: #fafafa;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
      <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

      <div class="mb-10">
        <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
          Ceux qui vous contactent
          <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
        </h3>
        <div class="space-y-3">
          {personas.filter(p => p.decision === 'Convertit').map(p => (
            <details class={`group bg-white rounded-xl overflow-hidden shadow-sm border ${decisionBorder(p.decision)}`}>
              <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                    <span class={`text-[10px] ${decisionBadge(p.decision)} text-white px-1.5 py-0.5 rounded font-medium`}>{p.decisionLabel}</span>
                  </div>
                  <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                    <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                    <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                  </div>
                </div>
              </summary>
              <div class="px-4 pb-5 border-t border-green-200">
                <div class="grid gap-4 text-xs mt-4">
                  <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                  <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Première impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                  <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                    <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                      {p.parcours.map(([section, reaction]) => (<li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>))}
                    </ol>
                  </div>
                  <div class="bg-neutral-50 rounded-lg p-3">
                    <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                    <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                    <p class="text-neutral-600">Le site répond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p>
                  </div>
                  <div class="grid grid-cols-2 gap-4">
                    <div><p class="font-semibold text-green-700 mb-1.5">✓ Points positifs</p>
                      <ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul></div>
                    <div><p class="font-semibold text-amber-700 mb-1.5">✗ Frictions</p>
                      <ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul></div>
                  </div>
                  {p.ceQuiFeraitBasculer && (
                    <div class="rounded-lg p-3" style="background: rgba(232,108,71,0.06);">
                      <p class="font-semibold text-[10px] uppercase tracking-wider mb-1" style="color: #E86C47;">À noter</p>
                      <p class="text-neutral-700 text-xs">{p.ceQuiFeraitBasculer}</p>
                    </div>
                  )}
                  <div class="flex gap-6 pt-3 border-t border-neutral-100">
                    {[{ label: 'Expérience', val: p.exp }, { label: 'Confiance', val: p.conf }, { label: 'Clarté', val: p.clarte }].map(s => {
                      const sc = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
                      return (<div class="text-center"><span class={`block text-lg font-bold ${sc}`}>{s.val}</span><span class="text-[10px] text-neutral-400">{s.label}</span></div>);
                    })}
                  </div>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>

      <div class="mb-4">
        <h3 class="text-base font-bold text-amber-800 mb-4 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block"></span>
          Ceux qui hésitent
          <span class="text-sm font-normal text-amber-600">({kpis.nbHesitent})</span>
        </h3>
        <div class="space-y-3">
          {personas.filter(p => p.decision === 'Hésite').map(p => (
            <details class={`group bg-white rounded-xl overflow-hidden shadow-sm border ${decisionBorder(p.decision)}`}>
              <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                    <span class={`text-[10px] ${decisionBadge(p.decision)} text-white px-1.5 py-0.5 rounded font-medium`}>{p.decisionLabel}</span>
                  </div>
                  <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                    <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                    <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                  </div>
                </div>
              </summary>
              <div class="px-4 pb-5 border-t border-amber-200">
                <div class="grid gap-4 text-xs mt-4">
                  <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                  <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Première impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                  <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                    <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                      {p.parcours.map(([section, reaction]) => (<li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>))}
                    </ol>
                  </div>
                  <div class="bg-neutral-50 rounded-lg p-3">
                    <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                    <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                    <p class="text-neutral-600">Le site répond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p>
                  </div>
                  <div class="grid grid-cols-2 gap-4">
                    <div><p class="font-semibold text-green-700 mb-1.5">✓ Points positifs</p>
                      <ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul></div>
                    <div><p class="font-semibold text-amber-700 mb-1.5">✗ Frictions</p>
                      <ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul></div>
                  </div>
                  {p.ceQuiFeraitBasculer && (
                    <div class="rounded-lg p-3" style="background: rgba(232,108,71,0.06);">
                      <p class="font-semibold text-[10px] uppercase tracking-wider mb-1" style="color: #E86C47;">Ce qui le ferait passer à l'action</p>
                      <p class="text-neutral-700 text-xs">{p.ceQuiFeraitBasculer}</p>
                    </div>
                  )}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-xl p-5 mb-10 bg-amber-50 border border-amber-200 flex items-start gap-3">
        <span class="text-lg shrink-0 mt-0.5">💡</span>
        <div>
          <p class="text-sm font-medium text-amber-900">Ces {kpis.nbHesitent} visiteurs ont besoin d'un dernier signal pour vous contacter.</p>
          <p class="text-xs text-amber-700 mt-1">Ils sont la cible idéale : motivés, déjà sur votre site, mais retenus par un détail (preuve manquante, vitesse, prix, zone). C'est votre plus grand levier de conversion.</p>
        </div>
      </div>

      <div class="mb-4">
        <h3 class="text-base font-bold text-neutral-600 mb-4 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-neutral-400 inline-block"></span>
          Ceux qui repartent
          <span class="text-sm font-normal text-neutral-500">({kpis.nbRepartent})</span>
        </h3>
        <div class="space-y-3">
          {personas.filter(p => p.decision === 'Quitte').map(p => (
            <details class={`group bg-white rounded-xl overflow-hidden shadow-sm border ${decisionBorder(p.decision)}`}>
              <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                    <span class={`text-[10px] ${decisionBadge(p.decision)} text-white px-1.5 py-0.5 rounded font-medium`}>{p.decisionLabel}</span>
                  </div>
                  <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                    <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                    <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                  </div>
                </div>
              </summary>
              <div class="px-4 pb-5 border-t border-neutral-200">
                <div class="grid gap-4 text-xs mt-4">
                  <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                  <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Première impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                  <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                    <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                      {p.parcours.map(([section, reaction]) => (<li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>))}
                    </ol>
                  </div>
                  <div class="grid grid-cols-2 gap-4">
                    <div><p class="font-semibold text-green-700 mb-1.5">✓ Points positifs</p>
                      <ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul></div>
                    <div><p class="font-semibold text-amber-700 mb-1.5">✗ Frictions</p>
                      <ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul></div>
                  </div>
                  {p.ceQuiFeraitBasculer && (
                    <div class="rounded-lg p-3" style="background: rgba(232,108,71,0.06);">
                      <p class="font-semibold text-[10px] uppercase tracking-wider mb-1" style="color: #E86C47;">Ce qui l'aurait retenu</p>
                      <p class="text-neutral-700 text-xs">{p.ceQuiFeraitBasculer}</p>
                    </div>
                  )}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-xl p-5 bg-neutral-100 border border-neutral-200 flex items-start gap-3">
        <span class="text-lg shrink-0 mt-0.5">📉</span>
        <div>
          <p class="text-sm font-medium text-neutral-800">Chaque visiteur qui repart, c'est un client en moins.</p>
          <p class="text-xs text-neutral-600 mt-1">Certains étaient hors cible (étudiant, gestionnaire B2B sans réf, particulier hors zone) : c'est normal. Mais d'autres avaient un vrai besoin et n'ont pas été convaincus.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- RECOMMANDATIONS -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Ce qu'on recommande</h2>
    <p class="text-neutral-600 mb-8">La priorité numéro 1 identifiée sur vos 10 visiteurs.</p>

    <p class="text-sm font-semibold text-red-700 mb-4">Si vous ne changez qu'une chose, changez ça :</p>

    <div class="space-y-4 mb-12">
      {ameliorationsHautes.map(a => (
        <div class="bg-white border-2 border-red-200 rounded-xl p-6 shadow-sm">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h4 class="font-bold text-neutral-900">{a.titre}</h4>
            <span class="text-[10px] px-2 py-1 rounded-full bg-red-100 text-red-700 font-semibold shrink-0 whitespace-nowrap">{a.impact}</span>
          </div>
          <p class="text-sm text-neutral-600 mb-3">{a.pourquoi}</p>
          <div class="bg-neutral-50 rounded-lg px-4 py-3">
            <p class="text-[10px] text-neutral-400 uppercase tracking-wider mb-1">Action concrète</p>
            <p class="text-xs text-neutral-700">{a.action}</p>
          </div>
        </div>
      ))}
    </div>

    {ameliorationsUtiles.length > 0 && (
      <>
        <h3 class="text-lg font-bold text-neutral-900 mb-2">Utile aussi</h3>
        <div class="grid md:grid-cols-2 gap-4 mb-12">
          {ameliorationsUtiles.map(a => (
            <div class="bg-white border border-neutral-200 rounded-xl p-5">
              <h4 class="font-semibold text-neutral-900 text-sm mb-2">{a.titre}</h4>
              <p class="text-xs text-neutral-600">{a.detail}</p>
            </div>
          ))}
        </div>
      </>
    )}

    {showUpsell && (
      <div class="rounded-2xl p-8 text-center border-2 border-dashed" style="border-color: #E86C47; background: rgba(232,108,71,0.03);">
        <p class="text-lg font-bold text-neutral-900 mb-2">10 visiteurs, c'est une tendance.</p>
        <p class="text-sm text-neutral-600 mb-6">Avec 20 visiteurs (Echo Complet), ces frictions deviennent des certitudes. Avec 100 (Echo Pro), vous savez exactement quel canal investir.</p>
      </div>
    )}
  </section>

  <!-- TECHNIQUE -->
  <section class="py-16 border-t border-neutral-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Sous le capot</h2>
      <p class="text-neutral-600 mb-8">Pour les curieux : ce que les outils techniques disent de votre site.</p>

      <div class="flex flex-wrap gap-3 mb-10">
        {techVerdicts.map(v => (
          <div class={`inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border text-sm font-medium ${v.ok ? 'bg-green-50 border-green-200 text-green-800' : 'bg-red-50 border-red-200 text-red-800'}`}>
            {v.ok
              ? <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              : <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            }
            <span>{v.label}</span>
            <span class="text-xs opacity-70">{v.verdict}</span>
          </div>
        ))}
      </div>

      <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
        <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
          <div class="flex items-center gap-3">
            <span class="text-base">⚡</span>
            <div>
              <h3 class="font-semibold text-neutral-900 text-sm">Vitesse mobile</h3>
              <p class="text-[11px] text-neutral-500">{techVerdicts[0].detail}</p>
            </div>
          </div>
        </summary>
        <div class="px-4 pb-4 border-t border-neutral-100 pt-4">
          <div class="grid grid-cols-2 gap-4 mb-3">
            <div class="text-center">
              <div class="text-3xl font-black leading-none" style="color: #E86C47;">{tech.pagespdMobile.performance ?? '—'}</div>
              <div class="text-xs text-neutral-500 mt-1">Performance mobile /100</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-black leading-none" style="color: #E86C47;">{tech.pagespdDesktop.performance ?? '—'}</div>
              <div class="text-xs text-neutral-500 mt-1">Performance desktop /100</div>
            </div>
          </div>
          <p class="text-xs text-neutral-600">Délai d'affichage mobile : {tech.cwv.lcp} (cible : sous 2,5 s). Stabilité de mise en page : {tech.cwv.cls} (cible : sous 0,1).</p>
          <p class="text-[10px] text-neutral-400 mt-2 italic">Source : Google PageSpeed Insights v5, mesure réelle.</p>
        </div>
      </details>

      <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
        <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
          <div class="flex items-center gap-3">
            <span class="text-base">🔒</span>
            <div>
              <h3 class="font-semibold text-neutral-900 text-sm">Sécurité du site</h3>
              <p class="text-[11px] text-neutral-500">{techVerdicts[1].detail}</p>
            </div>
          </div>
        </summary>
        <div class="px-4 pb-4 border-t border-neutral-100 pt-4">
          <div class="flex items-center gap-6 mb-3">
            <div class="text-center">
              <div class="text-4xl font-black leading-none" style="color: #E86C47;">{tech.observatory.grade}</div>
              <div class="text-xs text-neutral-500 mt-1">Grade Mozilla Observatory</div>
            </div>
            <div class="text-center">
              <div class="text-4xl font-black leading-none" style="color: #E86C47;">{tech.observatory.score}</div>
              <div class="text-xs text-neutral-500 mt-1">Score /100</div>
            </div>
          </div>
          <p class="text-xs text-neutral-600">Le grade indique la robustesse face aux attaques classiques (injection, vol de session, contenu détourné). Plus c'est bas, plus le site est vulnérable.</p>
          <p class="text-[10px] text-neutral-400 mt-2 italic">Source : Mozilla Observatory v2, mesure réelle.</p>
        </div>
      </details>

      <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
        <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
          <div class="flex items-center gap-3">
            <span class="text-base">📊</span>
            <div>
              <h3 class="font-semibold text-neutral-900 text-sm">Fiche métier (reconnue par Google et les IA)</h3>
              <p class="text-[11px] text-neutral-500">{techVerdicts[2].detail}</p>
            </div>
          </div>
        </summary>
        <div class="px-4 pb-4 border-t border-neutral-100 pt-4">
          <div class="space-y-2">
            {tech.schema.map(s => (
              <div class="flex items-start gap-2 text-xs text-neutral-600">
                <span class={`shrink-0 font-bold ${s.ok ? 'text-green-500' : 'text-red-400'}`}>{s.ok ? '✓' : '✗'}</span>
                <span>{s.item}</span>
              </div>
            ))}
          </div>
          <p class="text-[10px] text-neutral-400 mt-3 italic">Cette fiche structurée est ce que Google et les IA (ChatGPT, Perplexity) lisent en priorité pour catégoriser votre entreprise.</p>
        </div>
      </details>

      <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
        <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
          <div class="flex items-center gap-3">
            <span class="text-base">🔗</span>
            <div>
              <h3 class="font-semibold text-neutral-900 text-sm">Partage sur les réseaux sociaux</h3>
              <p class="text-[11px] text-neutral-500">{techVerdicts[3].detail}</p>
            </div>
          </div>
        </summary>
        <div class="px-4 pb-4 border-t border-neutral-100 pt-4">
          <p class="text-xs text-neutral-600">Quand un visiteur partage le lien de votre site (Facebook, WhatsApp, Messenger, LinkedIn), un aperçu (titre + image + description) doit s'afficher. Si l'aperçu est cassé ou absent, le lien ressemble à un lien suspect et le destinataire ne clique pas.</p>
        </div>
      </details>
    </div>
  </section>

  <!-- METHODOLOGIE -->
  <section class="py-12 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-neutral-900 mb-4">Comment on a fait ça</h2>
      <div class="grid md:grid-cols-3 gap-4 text-sm text-neutral-600">
        <div class="bg-white rounded-xl p-4 border border-neutral-200">
          <div class="text-2xl font-black text-neutral-300 mb-2">1</div>
          <p class="font-semibold text-neutral-800 mb-1">Scraping du site</p>
          <p class="text-xs">Lecture de la page d'accueil et des pages secondaires accessibles. Identification du métier, de la zone, des contenus visibles.</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-neutral-200">
          <div class="text-2xl font-black text-neutral-300 mb-2">2</div>
          <p class="font-semibold text-neutral-800 mb-1">Audit technique mesuré</p>
          <p class="text-xs">PageSpeed Insights mobile + desktop (Google PSI v5), Mozilla Observatory v2, validation fiche métier + partage réseaux. Aucun chiffre inventé.</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-neutral-200">
          <div class="text-2xl font-black text-neutral-300 mb-2">3</div>
          <p class="font-semibold text-neutral-800 mb-1">10 visiteurs simulés</p>
          <p class="text-xs">Profils réalistes adaptés à votre métier — 5 canaux d'arrivée (Google Search, Maps, IA, Réseaux sociaux, Bouche-à-oreille), 3 niveaux de maturité, 3 devices, contextes typiques du secteur.</p>
        </div>
      </div>
      <p class="text-xs text-neutral-400 mt-4 text-center">10 visiteurs = tendance solide &middot; 20 visiteurs (Echo Complet) = confirmation &middot; 100 visiteurs (Echo Pro) = certitude statistique</p>
    </div>
  </section>

  <!-- CTA PROSPECTION -->
  <section class="relative w-full px-6 py-20 overflow-hidden" style="background: #0A0A0A;">
    <div class="absolute bottom-[10%] right-[10%] w-[400px] h-[400px] rounded-full blur-[160px] pointer-events-none" style="background: #E86C47; opacity: 0.05;"></div>
    <div class="relative mx-auto max-w-3xl z-10 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4 leading-tight">
        Votre site peut faire beaucoup mieux.
      </h2>
      <p class="text-sm mb-8" style="color: rgba(255,255,255,0.5);">
        Ces recommandations sont actionnables en quelques jours. Un appel de 10 minutes suffit pour en discuter.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`tel:${phone}`} class="inline-flex items-center gap-2 px-8 py-4 text-white font-bold text-lg rounded-xl transition-all shadow-lg hover:-translate-y-0.5 bg-green-600 hover:bg-green-500">
          Appeler Marc — {phoneDisplay}
        </a>
        <a href={`https://wa.me/${phoneNoPlus}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-8 py-4 border border-neutral-600 font-semibold rounded-xl transition-all hover:border-white/40" style="color: rgba(255,255,255,0.6);">
          WhatsApp
        </a>
      </div>
      <p class="text-xs mt-6" style="color: rgba(255,255,255,0.3);">Ce rapport est confidentiel et non indexé par Google &middot; Généré le {dateAudit}</p>
    </div>
  </section>

</BaseLayout>
