---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'modernity-peinture';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Modernity Peinture';
const urlSite = 'https://modernitypeinture.fr';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 4.4,
  confiance: 5.6,
  clarte: 4.6,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart sans rien faire.';

const constat = 'Votre fiche Google (4.7 etoiles, 59 avis) fait le vrai travail de conviction. Votre site, lui, freine ceux qui auraient pu vous appeler : le telephone est cache en sous-page, les 18 ans de metier sont invisibles, et les 59 avis clients n\'apparaissent nulle part.';

const canalData = [
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Sandrine',
    age: 43,
    emoji: '🏠',
    situation: 'Proprietaire a Thionville, compare 3 artisans avant de renover son salon',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle a trouve le numero sur /contact.php apres 3 clics mais le portfolio de 3 photos et l\'absence de prix la maintiennent dans l\'hesitation face a ses autres devis.',
    localisation: 'Thionville (57)',
    maturite: 'Comparaison',
    contexte: 'Elle compare 3 artisans locaux. Elle a deja un devis d\'un peintre standard et cherche a valider son choix.',
    impression: 'Site simple, liste de services sans photo d\'ambiance en hero. Elle cherche immediatement un numero ou un bouton devis — absent.',
    parcours: [
      ['Accueil', 'Services listes, images de prestations. Pas de CTA ni de telephone visible.'],
      ['Realisations', '3 photos seulement. "C\'est peu, mon autre artisan avait 20 realisations."'],
      ['Contact', 'Telephone trouve enfin. Mais pas de formulaire, juste un mailto.'],
    ] as [string, string][],
    questionCle: 'Est-ce qu\'il intervient bien a Thionville, et combien ca coute ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'La zone est confirmee sur /contact.php mais impossible a trouver en accueil. Pas de prix.',
    impactVitesse: 'Site leger, chargement correct sur mobile.',
    impactConfiance: 'Design vieillissant (PHP sans responsive moderne) diminue la perception de serieux.',
    positifs: ['Services decoratifs bien listes (enduits, effets)', 'Adresse et horaires trouves sur /contact.php'],
    frictions: ['Telephone absent de l\'accueil', 'Seulement 3 photos dans le portfolio', 'Aucun avis client visible', 'Pas de prix ni de fourchette'],
    ceQuiFeraitBasculer: 'Un numero de telephone visible en haut de page + 2-3 photos supplementaires + la note Google 4.7 en evidence.',
    exp: 4, conf: 5, clarte: 5,
  },
  {
    id: 2,
    name: 'Kevin',
    age: 31,
    emoji: '📍',
    situation: 'Futur proprietaire a Cattenom, cherche un peintre pour 3 pieces avant emmenagement',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'La note 4.7 etoiles sur Google Maps l\'a convaincu avant d\'arriver sur le site. Il a trouve le telephone apres 2 clics et a appele directement.',
    localisation: 'Yutz / Cattenom (57)',
    maturite: 'Decision',
    contexte: 'Il a vu la fiche Google (4.7 etoiles, 59 avis) et clique sur le site pour confirmer et appeler.',
    impression: 'Il arrive convaincu par Maps. Il cherche juste le numero. Absent de l\'accueil — friction inutile.',
    parcours: [
      ['Accueil', 'Scrolle vite, cherche un bouton "Appeler" ou un numero. Rien.'],
      ['Contact', 'Navigue vers Contact. Trouve le 06 87 02 16 72 et l\'adresse.'],
      ['Appel', 'Appelle directement depuis son mobile.'],
    ] as [string, string][],
    questionCle: 'Le telephone, c\'est ou ?',
    reponse: 'Oui' as const,
    commentReponse: 'Trouve sur /contact.php. Mais 2 clics necessaires alors qu\'il est en decision — friction inutile.',
    impactVitesse: 'Site leger, correct.',
    impactConfiance: 'La note Google Maps compense totalement le site basique.',
    positifs: ['La note Maps l\'a convaincu avant d\'arriver', 'Telephone trouvable (2 clics)', 'Adresse confirme la proximite (Yutz)'],
    frictions: ['Telephone absent de l\'accueil', 'Aucun rappel des avis Google sur le site', 'Pas de bouton "Appeler maintenant"'],
    ceQuiFeraitBasculer: '',
    exp: 5, conf: 7, clarte: 5,
  },
  {
    id: 3,
    name: 'Marie-Claire',
    age: 58,
    emoji: '🛋️',
    situation: 'Retraitee a Metz, cherche un specialiste enduits decoratifs recommande par une amie',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Recommandee par une amie de Thionville, elle vient confirmer et prendre contact. La recommandation personnelle l\'emporte sur les lacunes du site.',
    localisation: 'Metz (57) — 35 km de Yutz',
    maturite: 'Decision',
    contexte: 'Son amie lui a donne le nom. Elle tape "Modernity Peinture" dans Google pour voir les exemples et prendre contact.',
    impression: 'Le nom correspond, les enduits decoratifs sont mentionnes. Mais le site semble vieux.',
    parcours: [
      ['Accueil', 'Services : enduits decoratifs mentionnes. Bien.'],
      ['Realisations', 'Cherche des photos d\'enduits specifiquement. 3 photos generiques — pas assez.'],
      ['Contact', '"Rayon 40 km autour de Thionville" — Metz a 35 km, c\'est bon. Telephone note.'],
    ] as [string, string][],
    questionCle: 'Il intervient jusqu\'a Metz et c\'est quoi ses realisations d\'enduits ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Zone confirmee sur /contact.php. Mais aucune photo specifique d\'enduits decoratifs / stucs.',
    impactVitesse: 'Desktop, pas de probleme perceptible.',
    impactConfiance: 'La recommandation personnelle est le vrai facteur de confiance. Le site sert juste a confirmer.',
    positifs: ['Specialisation enduits/effets bien mentionnee', 'Zone d\'intervention trouvee', 'Telephone et adresse accessibles'],
    frictions: ['Seulement 3 photos de realisations', 'Pas de photo specifique d\'enduits decoratifs ou stucs', 'Pas d\'avis clients visibles'],
    ceQuiFeraitBasculer: '',
    exp: 5, conf: 7, clarte: 6,
  },
  {
    id: 4,
    name: 'Dylan',
    age: 26,
    emoji: '🎨',
    situation: 'Etudiant a Thionville, cherche un peintre pour une chambre avec budget 200-300€',
    canal: 'Reseaux sociaux',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Hors cible : budget inadapte et absence totale de prix. Il ne trouve pas de petites prestations et repart sans interagir.',
    localisation: 'Thionville (57)',
    maturite: 'Decouverte',
    contexte: 'Un lien partage dans le groupe Facebook "Bons plans Thionville". Il clique par curiosite.',
    impression: 'Site simple, liste de services. Scrolle en cherchant des prix. Rien.',
    parcours: [
      ['Accueil', 'Scrolle vite, cherche "tarif" ou "prix". Rien.'],
      ['Realisations', '"C\'est pour des grands apparts, pas pour moi."'],
      ['Contact', 'Voit "demander votre devis" mais pas de formulaire. Juste un mailto. Ne donne pas suite.'],
    ] as [string, string][],
    questionCle: 'C\'est combien pour une chambre ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucun prix, aucune indication tarifaire. Pas de petites prestations mentionnees.',
    impactVitesse: 'Correct.',
    impactConfiance: 'Non pertinent — il n\'est pas dans la cible.',
    positifs: ['Services bien listes', 'Photo de chambre dans les realisations'],
    frictions: ['Aucun prix ni fourchette', 'Pas de formulaire de contact simple', 'Aucun reseau social pour suivre'],
    ceQuiFeraitBasculer: 'Un compte Instagram avec les realisations l\'aurait fait suivre meme sans achat immediat.',
    exp: 4, conf: 4, clarte: 3,
  },
  {
    id: 5,
    name: 'Francois',
    age: 49,
    emoji: '🏢',
    situation: 'Gerant de PME a Yutz, compare des artisans pour refaire 150 m2 de bureaux en 6 semaines',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Artisan local et joignable, mais aucun signal de capacite a gerer un chantier professionnel. Il note le numero mais garde 2 autres contacts en parallele.',
    localisation: 'Yutz (57)',
    maturite: 'Comparaison',
    contexte: 'Il cherche "peintre en batiment professionnel Yutz Thionville" et compare 2-3 artisans. Delai contraint (6 semaines), budget pro.',
    impression: 'Site artisanal. Cherche des signaux de serieux (avis, references pro). Rien en premiere impression.',
    parcours: [
      ['Accueil', 'Services generiques, rien sur les chantiers professionnels. "C\'est du particulier."'],
      ['Realisations', '3 photos d\'appartements. Aucune reference pro.'],
      ['Contact', 'Telephone trouve. Zone OK. Mais pas de formulaire pro, pas de devis en ligne.'],
    ] as [string, string][],
    questionCle: 'Est-ce qu\'il fait du pro et peut-il intervenir en 6 semaines ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune mention de chantiers professionnels, aucun temoignage entreprise, delai non mentionne.',
    impactVitesse: 'Desktop, chargement rapide.',
    impactConfiance: 'Absence d\'avis visibles et de references pro le refroidit face a des concurrents avec un site professionnel.',
    positifs: ['Telephone trouvable', 'Zone d\'intervention definie', 'Artisan local = proximite valorisee'],
    frictions: ['Aucune reference chantier professionnel', 'Avis Google 4.7 non visibles sur le site', 'Pas de garantie/assurance mentionnee', 'Pas de formulaire de devis'],
    ceQuiFeraitBasculer: 'Mentionner explicitement les chantiers professionnels + afficher les avis Google + ajouter une assurance/garantie decennale.',
    exp: 4, conf: 5, clarte: 4,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Afficher le telephone et les 59 avis Google directement en page d\'accueil',
    pourquoi: 'Vos 2 seules conversions viennent de visiteurs convaincus AVANT d\'arriver sur votre site (Maps, recommandation). Ceux qui arrivent via Google Search convertissent a 0% car ils ne trouvent pas immediatement le signal de confiance cle : votre numero et votre note 4.7 etoiles. C\'est votre plus gros levier, et il ne coute rien a activer.',
    action: 'Placer en haut de la page d\'accueil, visible sans scroller : le numero 06 87 02 16 72 en gros avec un lien "tel:", la note Google "4.7 etoiles / 59 avis" avec lien vers votre fiche, et 2-3 phrases courtes tirees de vos meilleurs avis Google.',
    impact: '4 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A mesurer', ok: false, detail: 'Quota API epuise — site PHP Apache sans CDN ni WebP' },
  { label: 'Securite', verdict: 'D- (25/100)', ok: false, detail: 'Grade D- Mozilla Observatory — 5 headers manquants' },
  { label: 'SEO', verdict: 'Insuffisant', ok: false, detail: 'Pas de meta description, pas de sitemap, zone non indexee' },
  { label: 'Donnees structurees', verdict: 'Absent', ok: false, detail: 'Aucun Schema.org JSON-LD — avis et adresse non transmis a Google' },
  { label: 'Partage reseaux', verdict: 'Absent', ok: false, detail: 'Open Graph manquant — partage sans apercu visuel' },
];

const tech = {
  observatory: { grade: 'D-', score: 25, testsOk: 5, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible (quota API)', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: false, h: 'Strict-Transport-Security HSTS (absent — HTTPS non force)' },
    { ok: false, h: 'Content-Security-Policy (absent — risque XSS)' },
    { ok: false, h: 'X-Content-Type-Options (absent — risque MIME sniffing)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking)' },
    { ok: false, h: 'Permissions-Policy (absent)' },
    { ok: true, h: 'HTTPS disponible (non force cote serveur)' },
  ],
  schema: [
    { item: 'JSON-LD present', ok: false },
    { item: '@type LocalBusiness / HomeAndConstructionBusiness', ok: false },
    { item: 'name, url, description', ok: false },
    { item: 'address + geo (57970 Yutz)', ok: false },
    { item: 'telephone (06 87 02 16 72)', ok: false },
    { item: 'openingHours (Lun-sam 8h-20h)', ok: false },
    { item: 'image / logo', ok: false },
    { item: 'aggregateRating (4.7 / 59 avis)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Absent' },
    { item: 'og:description', ok: false, val: 'Absent' },
    { item: 'og:image', ok: false, val: 'Absent' },
    { item: 'og:url', ok: false, val: 'Absent' },
    { item: 'twitter:card', ok: false, val: 'Absent' },
    { item: 'meta description', ok: false, val: 'Absente' },
    { item: 'canonical', ok: false, val: 'Absent' },
  ],
  seo: [
    { item: 'Hierarchie de titres H1 > H2', ok: false },
    { item: 'Meta description', ok: false },
    { item: 'Images avec alt text', ok: true },
    { item: 'robots.txt accessible', ok: true },
    { item: 'sitemap.xml accessible', ok: false },
    { item: 'Redirection HTTP vers HTTPS', ok: false },
    { item: 'Zone geographique dans le contenu', ok: false },
    { item: 'Mots-cles metier dans les titres', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO — Verdict immediat -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>

  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilite, fluidite</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Credibilite, preuves, rassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
        <p class="text-[10px] text-neutral-400 mt-1">Comprehension de l'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <!-- Ceux qui contactent -->
    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent
        <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group persona-card bg-white rounded-xl overflow-hidden shadow-sm border border-green-200" data-canal={p.canal}>
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p>
                  <p class="text-neutral-600">{p.contexte}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p>
                  <p class="text-neutral-600">{p.impression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]: [string, string]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                  <p class="text-neutral-600">Le site repond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p>
