    ] as [string, string][],
    questionCle: 'Ce serrurier est fiable pour plusieurs interventions ?',
    reponse: 'Oui' as const,
    commentReponse: '"Honnete" + 340 avis = reponse sans ambiguite pour un chantier important.',
    impactVitesse: 'Tablette — moins critique',
    impactConfiance: '4.9★ + "honnete" + 340 avis = triple garantie pour un chantier multi-portes',
    positifs: ['Positionnement "honnete" = differenciateur fort pour les gros chantiers', 'Volume d\'avis rassure sur la regularite du service'],
