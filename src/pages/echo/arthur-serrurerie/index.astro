    { item: 'Title tag present', ok: true },
    { item: 'Meta description', ok: true },
    { item: 'HTTPS', ok: true },
    { item: 'Responsive mobile', ok: true },
    { item: 'URL propre (domaine dedie Nancy)', ok: false },
    { item: 'Tarifs de base affiches', ok: false },
    { item: 'Schema.org Locksmith', ok: false },
