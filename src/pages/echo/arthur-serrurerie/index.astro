---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'arthur-serrurerie';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const isProspection = true;
const nomProspect = 'Arthur Serrurerie Nancy';
const urlSite = 'https://www.arthurserrurerie.com/nancy';
const dateAudit = '31 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 3,
  nbHesitent: 1,
  nbRepartent: 1,
  conversion: 60,
  experience: 7.0,
  confiance: 9.2,
  clarte: 4.2,
};

const verdictHero = 'Sur 5 visiteurs, 3 appellent — en urgence, la note 4.9 sur 340 avis est le seul signal qui compte et il convertit a chaque fois. Kevin voulait une serrure blindee A2P : sans prix, impossible de budgeter son projet — il a compare avec un concurrent qui affichait "des 180€ pose". Julien voulait un devis volets roulants en ligne : sans formulaire, il est parti directement chez le concurrent avec "devis gratuit 24h".';

const constat = 'Arthur Serrurerie detient le positionnement ideal pour le secteur : "serrurier honnete" + note 4.9 sur 340 avis dans un secteur gangrenee par les arnaques. Ces deux elements convertissent massivement les urgences nocturnes et les clients mefiant. Mais l\'URL parametrique (/nancy) affaiblit le SEO local, le contenu Wix est peu indexable, et l\'absence de tarifs de base nuit aux projets non-urgents (blindage, volets) qui necessitent une estimation avant appel.';

const canalData = [
  { canal: 'Google Search (urgence)', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'IA (serrure blindee A2P prix)', nb: 1, convert: 0, rate: 0 },
  { canal: 'Google Maps (multi-portes)', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search (volets devis)', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'David',
    age: 38,
    emoji: '🔑',
