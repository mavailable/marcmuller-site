---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 25% 50%, #6366f1 0%, transparent 50%), radial-gradient(circle at 75% 50%, #8b5cf6 0%, transparent 50%);"></div>
  <div class="relative max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium mb-6" style="background: rgba(99,102,241,0.15); color: #818cf8; border: 1px solid rgba(99,102,241,0.3);">
      Echo {formuleLabel}
    </div>
    <h1 class="text-3xl md:text-5xl font-bold text-white mb-4" style="line-height:1.15;">
      {nomProspect}
      <span class="block text-2xl md:text-3xl mt-2" style="color:#818cf8;">ce que vos visiteurs vivent vraiment</span>
    </h1>
    <p class="text-lg mb-8" style="color: rgba(255,255,255,0.6);">Audit du {dateAudit} · <a href={urlSite} target="_blank" rel="noopener noreferrer" style="color:#818cf8;">{urlSite}</a></p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      <div class="rounded-xl p-4 text-center" style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08);">
        <div class="text-3xl font-bold text-white">{kpis.conversion}%</div>
        <div class="text-xs mt-1" style="color:rgba(255,255,255,0.5);">conversion simulée</div>
      </div>
      <div class="rounded-xl p-4 text-center" style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08);">
        <div class="text-3xl font-bold text-white">{kpis.experience}<span class="text-lg">/10</span></div>
        <div class="text-xs mt-1" style="color:rgba(255,255,255,0.5);">expérience</div>
      </div>
      <div class="rounded-xl p-4 text-center" style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08);">
        <div class="text-3xl font-bold text-white">{kpis.confiance}<span class="text-lg">/10</span></div>
        <div class="text-xs mt-1" style="color:rgba(255,255,255,0.5);">confiance</div>
      </div>
      <div class="rounded-xl p-4 text-center" style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08);">
        <div class="text-3xl font-bold text-white">{kpis.clarte}<span class="text-lg">/10</span></div>
        <div class="text-xs mt-1" style="color:rgba(255,255,255,0.5);">clarté</div>
      </div>
    </div>
    <div class="rounded-2xl p-6" style="background:rgba(99,102,241,0.1); border:1px solid rgba(99,102,241,0.25);">
      <p class="text-base leading-relaxed" style="color:rgba(255,255,255,0.85);">"{verdictHero}"</p>
    </div>
  </div>
</section>

<!-- 2. CONSTAT -->
<section class="w-full px-6 py-16" style="background:#111111;">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-6">Ce que nous avons observé</h2>
    <p class="text-base leading-relaxed mb-8" style="color:rgba(255,255,255,0.7);">{constat}</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="rounded-xl p-5 flex flex-col gap-2" style="background:rgba(34,197,94,0.08); border:1px solid rgba(34,197,94,0.2);">
        <span class="text-2xl font-bold" style="color:#4ade80;">{kpis.nbConvertissent}</span>
        <span class="text-sm font-medium text-white">appellent directement</span>
        <span class="text-xs" style="color:rgba(255,255,255,0.5);">4.9★ convertit même l'urgence nocturne</span>
      </div>
      <div class="rounded-xl p-5 flex flex-col gap-2" style="background:rgba(234,179,8,0.08); border:1px solid rgba(234,179,8,0.2);">
        <span class="text-2xl font-bold" style="color:#facc15;">{kpis.nbHesitent}</span>
        <span class="text-sm font-medium text-white">hésite</span>
        <span class="text-xs" style="color:rgba(255,255,255,0.5);">pas de tarifs pour budgéter A2P</span>
      </div>
      <div class="rounded-xl p-5 flex flex-col gap-2" style="background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.2);">
        <span class="text-2xl font-bold" style="color:#f87171;">{kpis.nbRepartent}</span>
        <span class="text-sm font-medium text-white">repart chez un concurrent</span>
        <span class="text-xs" style="color:rgba(255,255,255,0.5);">formulaire devis manquant</span>
      </div>
    </div>
  </div>
</section>

<!-- 3. VISITEURS -->
<section class="w-full px-6 py-16" style="background:#0A0A0A;">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">5 visiteurs, 5 histoires</h2>
    <p class="text-sm mb-10" style="color:rgba(255,255,255,0.5);">Simulation comportementale — chaque profil représente un segment réel de votre audience.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {personas.map((p) => (
        <div class="rounded-2xl p-6" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
          <div class="flex items-start justify-between mb-4">
            <div>
              <span class="text-lg mr-2">{p.emoji}</span>
              <span class="font-semibold text-white">{p.name}, {p.age} ans</span>
              <div class="text-xs mt-1" style="color:rgba(255,255,255,0.4);">{p.canal} · {p.device} · {p.maturite}</div>
            </div>
            <span class={`text-xs px-2 py-1 rounded-full font-medium ${p.decision === 'Convertit' ? 'bg-green-900/40 text-green-400' : p.decision === 'Hesite' ? 'bg-yellow-900/40 text-yellow-400' : 'bg-red-900/40 text-red-400'}`}>
              {p.decisionLabel}
            </span>
          </div>
          <p class="text-sm mb-4" style="color:rgba(255,255,255,0.65);">{p.histoire}</p>
          {p.ceQuiFeraitBasculer && (
            <div class="rounded-lg p-3 text-xs" style="background:rgba(99,102,241,0.1); color:rgba(255,255,255,0.7); border-left:3px solid #6366f1;">
              <strong style="color:#818cf8;">Ce qui aurait changé la donne :</strong> {p.ceQuiFeraitBasculer}
            </div>
          )}
        </div>
      ))}
    </div>
    <div class="mt-10">
      <h3 class="text-lg font-semibold text-white mb-4">Résultats par canal</h3>
      <div class="space-y-3">
        {canalData.map((c) => (
          <div class="flex items-center gap-4">
            <span class="text-sm w-64 shrink-0" style="color:rgba(255,255,255,0.7);">{c.canal}</span>
            <div class="flex-1 rounded-full h-2" style="background:rgba(255,255,255,0.08);">
              <div class="h-2 rounded-full" style={`width:${c.rate}%; background:${c.rate >= 66 ? '#4ade80' : c.rate >= 33 ? '#facc15' : '#f87171'};`}></div>
            </div>
            <span class="text-sm shrink-0" style="color:rgba(255,255,255,0.5);">{c.convert}/{c.nb}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

