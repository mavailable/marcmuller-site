  observatory: { grade: 'C+', score: 45, testsOk: 4, testsTotal: 10 },
  pagespdMobile: { performance: 38, accessibility: 73, bestPractices: 70, seo: 67 },
  pagespdDesktop: { performance: 60, accessibility: 77, bestPractices: 73, seo: 71 },
  cwv: { lcp: '~4.5s (Wix JS + images)', inp: '~360ms', cls: '~0.10' },
  headers: [
    { ok: true, h: 'HTTPS' },
    { ok: false, h: 'HSTS (Wix ne garantit pas)' },
    { ok: false, h: 'Content-Security-Policy (absent)' },
    { ok: false, h: 'X-Frame-Options (Wix)' },
