function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200';
  if (d === 'Hesite') return 'border-amber-200';
  return 'border-neutral-200';
}
function decisionBadge(d: string) {
  if (d === 'Convertit') return 'bg-green-600';
  if (d === 'Hesite') return 'bg-amber-500';
  return 'bg-neutral-400';
}

const accentColor = '#059669';
const accentGradient = 'linear-gradient(135deg, #059669, #047857)';
---

<BaseLayout title={title} description={description} noindex={true} lang="fr" frPath={`/echo/${slug}`}>

  <!-- HERO -->
  <section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
    <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style={`background: ${accentColor}; opacity: 0.06;`}></div>
    <div class="absolute bottom-[10%] right-[5%] w-[300px] h-[300px] rounded-full blur-[120px] pointer-events-none" style="background: #6366f1; opacity: 0.04;"></div>
    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">{formuleLabel} &middot; Rapport confidentiel</div>
      <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
      <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">Site analyse : <a href={urlSite} target="_blank" rel="noopener" class="underline hover:text-white transition-colors">{urlSite}</a> &middot; {kpis.nbPersonas} visiteurs simules &middot; {dateAudit}</p>
      <div class="grid grid-cols-3 gap-4">
        <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);"><div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div><div class="text-sm text-green-400/70">s'inscrivent</div></div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);"><div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div><div class="text-sm text-amber-400/70">hesitent</div></div>
