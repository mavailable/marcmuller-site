---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'lba-plombier-forbach';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'LBA Plombier Forbach';
const urlSite = 'https://lba-plombier-forbach.fr';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 1,
  nbHesitent: 1,
  nbRepartent: 3,
  conversion: 20,
  experience: 4.4,
  confiance: 2.8,
  clarte: 3.6,
};

const verdictHero = 'Sur 5 visiteurs, 1 vous contacte. 1 hesite. 3 repartent sans rien faire.';

const constat = 'Votre site convertit uniquement les urgences — ceux qui n\'ont pas le temps de comparer. Les autres partent chez un concurrent parce qu\'ils ne savent pas qui vous etes. Un seul changement suffit a inverser ca.';

const canalData = [
  { canal: 'Google Search (urgence)', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Bouche-a-oreille', nb: 2, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Karim',
    age: 38,
    emoji: '🚨',
    situation: 'Employe en logistique a Forbach, fuite sous l\'evier a 22h',
    canal: 'Google Search (urgence)',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence absolue : il voit le numero, il appelle. Le site n\'a pas le temps de le convaincre ou de le perdre.',
    localisation: 'Forbach centre (57600)',
    maturite: 'Decision',
    contexte: 'L\'eau coule sous l\'evier depuis 20 minutes. Il cherche un numero a appeler maintenant, pas demain.',
    impression: 'Le numero est visible. C\'est tout ce dont il a besoin a 22h avec une fuite active.',
    parcours: [
      ['Hero', 'Voit le numero 09 72 17 37 45 en haut de page'],
      ['Appel immediat', 'N\'a pas lu le reste du site — urgence prime'],
    ] as [string, string][],
    questionCle: 'Ils interviennent la nuit et le week-end ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune mention d\'horaires ni de disponibilite 24h/7j — il appelle sans le savoir.',
    impactVitesse: 'Urgence : il appelle en 3 secondes sans attendre le chargement complet.',
    impactConfiance: 'En urgence, la confiance est secondaire. Le numero suffit.',
    positifs: ['Numero tres visible dans le header', 'Nom "Plombier Forbach" localise'],
    frictions: ['Aucune confirmation d\'horaires d\'urgence ou disponibilite nuit', 'Si le numero ne repond pas : zero alternative sur le site'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 5, clarte: 5,
  },
  {
    id: 2,
    name: 'Thomas',
    age: 29,
    emoji: '📱',
    situation: 'Locataire a Forbach Bellevue, WC bouche, cherche sur Google Maps',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Arrive depuis Maps, cherche une adresse et des avis avant d\'appeler. Trouve ni l\'un ni l\'autre. Appelle quand meme mais sans conviction.',
    localisation: 'Forbach Bellevue (57600)',
    maturite: 'Decision',
    contexte: 'Il cherche sur Maps, voit plusieurs plombiers, clique sur LBA pour voir le site avant d\'appeler — reflexe normal en 2026.',
    impression: 'Site generique, pas d\'adresse visible. "C\'est ou exactement ?" Il scroll chercher une confirmation.',
    parcours: [
      ['Hero', 'Pas d\'adresse physique — premier signal d\'alerte'],
      ['Scroll services', 'Bellevue est mentionne dans le texte — rassure un peu'],
      ['Cherche une carte Maps', 'Aucune carte embedee ni adresse confirmee'],
      ['Hesite', 'Appelle finalement mais avec doute — si concurrent repond en premier il ira ailleurs'],
    ] as [string, string][],
    questionCle: 'Ils interviennent bien a Bellevue et c\'est ou leur depot ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Bellevue cite dans le texte mais pas d\'adresse ni de carte. Confirmation floue.',
    impactVitesse: 'PHP 7.4 sans CDN — ressent un petit delai sur mobile en 4G.',
    impactConfiance: 'Pas d\'adresse = doute sur le caractere local du prestataire.',
    positifs: ['Bellevue mentionne dans le contenu', 'HTTPS actif (pas de warning navigateur)', 'Numero visible'],
    frictions: ['Aucune adresse physique', 'Aucune carte Google Maps embedee', 'Aucun avis client visible'],
    ceQuiFeraitBasculer: 'Une adresse ou une carte + 3-4 avis clients avec noms et quartiers.',
    exp: 5, conf: 4, clarte: 5,
  },
  {
    id: 3,
    name: 'Sylvie',
    age: 52,
    emoji: '🔧',
    situation: 'Proprietaire d\'un pavillon a Stiring-Wendel, chauffe-eau en panne',
    canal: 'Google Search (urgence)',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'A le temps de comparer. Cherche un artisan credible avec prix indicatifs. Trouve un site sans nom, sans prix, avec mentions legales vides. Repart chez un concurrent.',
    localisation: 'Stiring-Wendel (57350), 5 km de Forbach',
    maturite: 'Comparaison',
    contexte: 'Elle a deja un devis d\'un autre plombier et cherche un 2e avis. Prise en charge non urgente — elle peut attendre.',
    impression: 'Design tres generique. "C\'est peut-etre une publicite." Cherche des signes de credibilite, n\'en trouve pas.',
    parcours: [
      ['Hero', 'Pas de photo, pas de nom. "C\'est qui ?"'],
      ['Services', 'Liste complete — seul point positif'],
      ['Cherche prix', '"Tarifs competitifs" sans chiffre. Frustrant.'],
      ['Cherche A propos', 'N\'existe pas'],
      ['Mentions legales', 'Page vide. Signal d\'alarme fort.'],
      ['Quitte', 'Va chez un plombier concurrent ayant une vraie page d\'identite'],
    ] as [string, string][],
    questionCle: 'C\'est qui exactement, et combien ca coute ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucun nom, aucun prix, mentions legales vides. Impossible de valider la credibilite.',
    impactVitesse: 'Desktop — chargement correct, pas de probleme.',
    impactConfiance: 'Mentions legales vides = illegal en France + signal d\'arnaque potentielle pour un profil prudent.',
    positifs: ['Liste de services exhaustive', 'Numero de telephone visible'],
    frictions: ['Zero identite de l\'artisan (nom, photo, SIRET)', 'Zero prix indicatif', 'Mentions legales vides', 'Zero avis client ou temoignage'],
    ceQuiFeraitBasculer: 'Nom + photo de l\'artisan, SIRET, et au minimum "a partir de X€" sur les services principaux.',
    exp: 4, conf: 2, clarte: 3,
  },
  {
    id: 4,
    name: 'Ingrid',
    age: 44,
    emoji: '🇩🇪',
    situation: 'Residante francaise en Sarre (Allemagne), 12 km de Forbach, cherche un plombier',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Frontaliere francophone, elle esperait que "Forbach et environs" inclurait la Sarre. Le site ne dit rien de la zone transfrontaliere. Repart vers un plombier de Sarrebruck.',
    localisation: 'Wiebling, Saarland (DE) — hors zone probable',
    maturite: 'Decouverte',
    contexte: 'Une voisine lui a dit "cherche un plombier a Forbach". Elle est front-end de zone, parle francais couramment.',
    impression: 'Site en francais, zone "Forbach". Elle cherche si ca couvre son cote de la frontiere. Rien ne lui repond.',
    parcours: [
      ['Hero', 'Zone "Forbach et environs" — ambigue pour elle'],
      ['Scroll services', 'Pas de mention d\'interventions en Allemagne ou zone Sarre'],
      ['Cherche carte', 'Aucune carte. Aucune liste de villes precisee.'],
      ['Quitte', 'Va vers un plombier allemand de Sarrebruck avec adresse claire'],
    ] as [string, string][],
    questionCle: 'Est-ce qu\'ils interviennent en Sarre, cote allemand ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune mention de zone transfrontaliere — elle est hors cible mais le site ne lui dit meme pas clairement.',
    impactVitesse: 'Pas de probleme technique notable.',
    impactConfiance: 'Site sans identite concrete — pas credible pour quelqu\'un exigeant une garantie.',
    positifs: ['Site en francais accessible', 'Services listes'],
    frictions: ['Zone d\'intervention floue — pas de liste de villes, pas de rayon km', 'Aucune identite de l\'artisan', 'Design generique identique a des dizaines de sites LBA'],
    ceQuiFeraitBasculer: 'Une carte precise + liste des villes couvertes. Pas pertinent ici car hors zone.',
    exp: 3, conf: 2, clarte: 2,
  },
  {
    id: 5,
    name: 'Jerome',
    age: 61,
    emoji: '🏠',
    situation: 'Retraite a Behren-les-Forbach, canalisation bouchee, pas d\'urgence',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Cherche un artisan de confiance, pas le moins cher. Le site anonyme sans avis ni artisan identifie le fait fuir vers un concurrent qui a une vraie page.',
    localisation: 'Behren-les-Forbach (57460), 3 km de Forbach',
    maturite: 'Comparaison',
    contexte: 'Il a le temps. Il compare. Il cherche un artisan local qu\'il pourrait recommander apres, pas un reseau anonyme.',
    impression: 'Design basique. "C\'est un peu generique." Cherche le nom de l\'artisan. Ne le trouve pas.',
    parcours: [
      ['Hero', 'Ni photo, ni nom, ni anciennete. "C\'est qui ?"'],
      ['Services', 'Complete. Seul point positif.'],
      ['Cherche A propos / Equipe', 'N\'existe pas'],
      ['Cherche avis clients', 'Zero avis, zero temoignage'],
      ['Mentions legales', 'Page vide. "C\'est louche."'],
      ['Quitte', 'Choisit un plombier local avec photo et avis Google'],
    ] as [string, string][],
    questionCle: 'A qui j\'ai affaire ? C\'est serieux ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune identite, mentions legales vides, reseau anonyme. Un retraite prudent ne fait pas confiance a ca.',
    impactVitesse: 'Desktop — pas de probleme technique.',
    impactConfiance: 'Mentions legales vides = signal fort d\'anonymat volontaire. Tres mauvais pour un profil prudent.',
    positifs: ['Liste de services exhaustive', 'Numero accessible'],
    frictions: ['Zero identite de l\'artisan', 'Mentions legales vides (illegal)', 'Zero avis client', 'Design generique identique a des dizaines de sites LBA du reseau'],
    ceQuiFeraitBasculer: 'Page "Votre artisan" avec nom, photo, SIRET + 5 avis Google integres.',
    exp: 4, conf: 1, clarte: 3,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Creer une vraie identite d\'artisan local',
    pourquoi: 'Le site ne dit pas qui est le plombier. Pas de nom, pas de photo, pas de SIRET visible, des mentions legales vides. 4 visiteurs sur 5 cherchent a savoir a qui ils font confiance avant d\'appeler — et ne trouvant rien, ils vont chez un concurrent qui repond a cette question.',
    action: 'Ajouter une section courte "Votre plombier a Forbach" avec : nom et prenom de l\'artisan, photo, annees d\'experience, mention du SIRET, et 3-5 avis clients reels (Google ou autre). Corriger les mentions legales obligatoires.',
    impact: '4 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Moyen', ok: false, detail: 'PHP 7.4 fin de vie, pas de CDN — estimation 40-60/100 mobile' },
  { label: 'Securite', verdict: 'F (0/100)', ok: false, detail: '7 tests echoues sur 10 — aucun header de securite' },
  { label: 'SEO', verdict: 'A ameliorer', ok: false, detail: 'Double H1, og:title="Index", 0 alt text, meta tronquee avec fautes' },
  { label: 'Donnees structurees', verdict: 'Absent', ok: false, detail: 'Zero Schema.org JSON-LD — invisible pour les rich snippets Google' },
  { label: 'Partage reseaux', verdict: 'Mauvais', ok: false, detail: 'og:title="Index", pas d\'image OG reelle, doublon site_name' },
];

const tech = {
  observatory: { grade: 'F', score: 0, testsOk: 3, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible (quota API)', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: false, h: 'Content-Security-Policy (absent)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking)' },
    { ok: false, h: 'X-Content-Type-Options (absent)' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (absent)' },
    { ok: false, h: 'Referrer-Policy (absent)' },
    { ok: false, h: 'Permissions-Policy (absent)' },
    { ok: true, h: 'HTTPS actif (redirection HTTP → HTTPS)' },
    { ok: false, h: 'PHP/7.4 expose via x-powered-by (version fin de vie)' },
  ],
  schema: [
    { item: 'JSON-LD present', ok: false },
    { item: '@type LocalBusiness / Plumber', ok: false },
    { item: 'name, url, description', ok: false },
    { item: 'address + geo (localisation precise)', ok: false },
    { item: 'telephone', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'image / logo', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: '"Index" — jamais personnalise' },
    { item: 'og:description', ok: false, val: 'Absente' },
    { item: 'og:image', ok: false, val: 'Dimensions declarees mais URL absente' },
    { item: 'og:url', ok: true, val: 'https://lba-plombier-forbach.fr' },
    { item: 'og:type', ok: true, val: 'website' },
    { item: 'og:locale', ok: true, val: 'fr' },
    { item: 'og:site_name', ok: false, val: 'Doublon (deux valeurs differentes)' },
    { item: 'twitter:card', ok: true, val: 'summary_large_image' },
    { item: 'twitter:image', ok: false, val: 'Absente' },
  ],
  seo: [
    { item: 'Un seul H1 par page', ok: false },
    { item: 'Meta description presente', ok: true },
    { item: 'Meta description bien redigee (sans fautes, non tronquee)', ok: false },
    { item: 'Images avec attribut alt', ok: false },
    { item: 'robots.txt accessible', ok: true },
    { item: 'sitemap.xml accessible', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'Canonical present', ok: true },
    { item: 'Mentions legales completes (obligation legale FR)', ok: false },
    { item: 'Viewport meta present', ok: true },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO — Verdict immediat -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>

  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilite, fluidite</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Credibilite, preuves, rassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
        <p class="text-[10px] text-neutral-400 mt-1">Comprehension de l'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <!-- Ceux qui contactent -->
    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent
        <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group persona-card bg-white rounded-xl overflow-hidden shadow-sm border border-green-200" data-canal={p.canal}>
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p>
                  <p class="text-neutral-600">{p.contexte}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p>
                  <p class="text-neutral-600">{p.impression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
