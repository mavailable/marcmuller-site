// ─── Groupes ─────────────────────────────────────────────────────────────────
const convertissent = personas.filter(p => p.decision === 'Convertit');
const hesitent = personas.filter(p => p.decision === 'Hesite');
const repartent = personas.filter(p => p.decision === 'Quitte');

// Couleur heatmap helper
function heatColor(rate: number): string {
  if (rate >= 85) return 'bg-green-600 text-white';
  if (rate >= 65) return 'bg-green-400 text-white';
  if (rate >= 45) return 'bg-yellow-300 text-neutral-800';
  if (rate >= 25) return 'bg-orange-400 text-white';
  return 'bg-red-500 text-white';
}
---

<BaseLayout title={`Echo Pro — ${nomProspect}`} description={`Rapport Echo Pro confidentiel — ${nomProspect} — ${dateAudit}`} noindex={true} lang="fr" frPath="/echo/talent-bs/">

  <!-- ═══════════════════════════════════════════════════════
       1. HERO
  ═══════════════════════════════════════════════════════ -->
  <section class="bg-[#0A0A0A] text-white py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <span class="inline-block mb-6 px-3 py-1 rounded-full text-xs font-mono bg-white/10 text-white/70 border border-white/20">
        {formuleLabel} · Rapport confidentiel
      </span>
      <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-6">
        {verdictHero}
      </h1>
      <p class="text-white/60 text-sm mb-10">
        Audit de <a href={urlSite} target="_blank" rel="noopener" class="underline hover:text-white">{urlSite}</a>
        · {kpis.nbPersonas} visiteurs simulés · {dateAudit}
      </p>

      <!-- 3 KPI cards -->
      <div class="grid grid-cols-3 gap-4 max-w-lg mx-auto">
        <div class="rounded-2xl bg-green-900/40 border border-green-500/30 p-5">
          <div class="text-4xl font-bold text-green-400">{kpis.nbConvertissent}</div>
          <div class="text-xs text-green-300/70 mt-1">contactent</div>
        </div>
        <div class="rounded-2xl bg-amber-900/40 border border-amber-500/30 p-5">
          <div class="text-4xl font-bold text-amber-400">{kpis.nbHesitent}</div>
          <div class="text-xs text-amber-300/70 mt-1">hésitent</div>
        </div>
        <div class="rounded-2xl bg-neutral-800 border border-neutral-600 p-5">
          <div class="text-4xl font-bold text-neutral-300">{kpis.nbRepartent}</div>
          <div class="text-xs text-neutral-400 mt-1">repartent</div>
        </div>
      </div>

      <!-- Scores -->
      <div class="mt-10 flex flex-wrap justify-center gap-6 text-sm text-white/60">
        <span>Expérience <strong class="text-white">{kpis.experience}/10</strong></span>
        <span>Confiance <strong class="text-white">{kpis.confiance}/10</strong></span>
        <span>Clarté <strong class="text-white">{kpis.clarte}/10</strong></span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       2. CONSTAT + ANALYSES PRO
  ═══════════════════════════════════════════════════════ -->
  <section class="py-16 px-4 bg-white">
    <div class="max-w-5xl mx-auto space-y-14">

      <!-- Constat -->
      <div class="border-l-4 pl-6" style="border-color: var(--color-accent)">
        <p class="text-xl font-medium text-neutral-800">{constat}</p>
      </div>

      <!-- Canal -->
      <div>
        <h2 class="text-2xl font-bold text-neutral-900 mb-6">Conversion par canal d'arrivée</h2>
        <div class="space-y-3">
          {canalData.sort((a, b) => b.rate - a.rate).map(c => (
            <div class="flex items-center gap-4">
              <span class="text-sm text-neutral-600 w-56 flex-shrink-0">{c.canal}</span>
              <div class="flex-1 bg-neutral-100 rounded-full h-3 relative">
                <div
                  class="h-3 rounded-full"
                  style={`width:${c.rate}%; background-color: var(--color-accent)`}
                ></div>
              </div>
              <span class="text-sm font-bold w-12 text-right text-neutral-800">{c.rate}%</span>
              <span class="text-xs text-neutral-400 w-20">{c.convert}/{c.nb} contactent</span>
            </div>
          ))}
        </div>
      </div>

      <!-- PRO : Maturite -->
      <div>
        <h2 class="text-2xl font-bold text-neutral-900 mb-6">Analyse par maturité</h2>
        <div class="grid md:grid-cols-3 gap-4">
          {maturiteData.map(m => (
            <div class="rounded-2xl border border-neutral-200 p-5">
              <div class="flex items-start justify-between mb-3">
                <span class="font-bold text-neutral-900">{m.label}</span>
                <span class="text-2xl font-bold" style="color: var(--color-accent-text)">{m.rate}%</span>
              </div>
              <div class="text-sm text-neutral-500 mb-3">{m.total} visiteurs · {m.convert} contactent</div>
              <div class="flex gap-1 mb-3">
                <div class="h-2 rounded-full bg-green-500" style={`width:${(m.convert/m.total)*100}%`}></div>
                <div class="h-2 rounded-full bg-amber-400" style={`width:${(m.hesite/m.total)*100}%`}></div>
                <div class="h-2 rounded-full bg-neutral-300" style={`width:${(m.quitte/m.total)*100}%`}></div>
              </div>
              <p class="text-xs text-neutral-500 italic">{m.friction}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- PRO : Device -->
      <div>
        <h2 class="text-2xl font-bold text-neutral-900 mb-6">Analyse par device</h2>
        <div class="grid md:grid-cols-3 gap-4">
          {deviceData.map(d => (
            <div class={`rounded-2xl border p-5 ${d.device === 'Mobile' ? 'border-red-200 bg-red-50' : 'border-neutral-200'}`}>
              <div class="flex items-start justify-between mb-2">
                <span class="font-bold text-neutral-900">{d.device}</span>
