---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'lorsav';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'LORSAV Chauffage Plomberie';
const urlSite = 'https://www.lorsav.fr/';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.6,
  confiance: 5.6,
  clarte: 5.8,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'Votre site informe correctement sur vos services et vos tarifs. Mais il ne convainc pas les visiteurs qui comparent. Avec 81 avis Google a 4.8 etoiles, vous avez le levier de confiance le plus puissant du secteur — et il est invisible sur votre site.';

const canalData = [
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Bouche-a-oreille', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Sylvie',
    age: 52,
    emoji: '🔧',
    situation: 'Proprietaire a Marange-Silvange, chauffe-eau HS',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Elle cherche un plombier local sur Maps, voit les 4.8 etoiles, clique, confirme la localisation et appelle directement.',
    localisation: 'Marange-Silvange (57)',
    maturite: 'Comparaison',
    contexte: 'Son chauffe-eau ne chauffe plus. Elle cherche "plombier Marange-Silvange" sur Google Maps. LORSAV apparait en premier avec 81 avis.',
    impression: 'Les 4.8 etoiles sur Maps rassurent immediatement. Le site confirme l\'adresse locale. Elle appelle.',
    parcours: [
      ['Google Maps', '81 avis 4.8 — signal de confiance fort'],
      ['Accueil', 'Adresse Marange-Silvange visible — meme commune'],
      ['Contact', 'Telephone trouve, appel passe directement'],
    ] as [string, string][],
    questionCle: 'Ils sont vraiment pres de chez moi et fiables ?',
    reponse: 'Oui' as const,
    commentReponse: 'Localisation claire, telephone accessible, avis Google excellents sur Maps.',
    impactVitesse: 'Mobile, chargement Wix correct.',
    impactConfiance: 'Les avis Google compensent le design date.',
    positifs: ['Adresse locale visible', 'Telephone present dans le footer', 'Astreinte 24/7 mentionnee', '81 avis sur Maps (hors site)'],
    frictions: ['Design vieillissant cree un doute', 'Telephone absent du header', 'Pas de photos d\'equipe'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 8, clarte: 7,
  },
  {
    id: 2,
    name: 'Jerome',
    age: 45,
    emoji: '🏢',
    situation: 'Gestionnaire de 12 logements a Metz, cherche un contrat annuel',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Il cherche un contrat entretien chaudieres multi-logements. Il trouve la page tarifs avec 3 formules claires et remplit le formulaire de devis.',
    localisation: 'Metz (57)',
    maturite: 'Decouverte',
    contexte: 'Il gere 12 appartements en Moselle. Chaque annee il doit assurer l\'entretien obligatoire des chaudieres. Il cherche un prestataire fiable sur la zone.',
    impression: 'Site sobre, page tarifs existante avec 3 formules. Le perimetre geographique (Moselle + M&M) correspond a ses logements.',
    parcours: [
      ['Google Search', '"contrat entretien chaudiere Metz" — site en bonne position'],
      ['Services', 'Detartrage, desembouage, maintenance : tout est couvert'],
      ['Tarifs', '3 formules : Essentiel, Securite, Serenite — structure claire'],
      ['Demande de devis', 'Formulaire rempli. Il indique 12 logements.'],
    ] as [string, string][],
    questionCle: 'Vous faites des contrats multi-logements avec attestation ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Page tarifs presente mais pas de mention "gestionnaire de biens" ou "multi-logements".',
    impactVitesse: 'Desktop, navigation fluide.',
    impactConfiance: 'Email outlook.fr moins professionnel qu\'un @lorsav.fr.',
    positifs: ['Page tarifs avec 3 formules', 'Formulaire de devis fonctionnel', 'Zone geographique large precisee', 'Attestation obligatoire mentionnee'],
    frictions: ['Pas de mention gestionnaire/multi-logements', 'Email outlook.fr', 'Aucun avis client sur le site'],
    ceQuiFeraitBasculer: 'Une mention "Contrat pour gestionnaires et coproprietes" + avis clients.',
    exp: 7, conf: 6, clarte: 7,
  },
  {
    id: 3,
    name: 'Kevin',
    age: 38,
    emoji: '🌡️',
    situation: 'Proprietaire a Amneville, chaudiere en panne depuis hier soir',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'En urgence chauffage, il compare 3 sites. LORSAV a l\'astreinte 24/7 mentionnee mais ses 81 avis ne sont pas visibles. Le site concurrent a mis ses avis en avant. Kevin hesite.',
    localisation: 'Amneville (57)',
    maturite: 'Comparaison',
    contexte: 'Sa chaudiere est tombee en panne hier soir, il fait -3 dehors. Il cherche "chauffagiste urgence Amneville" sur son telephone. Il compare les 3 premiers resultats.',
    impression: 'Site qui charge correctement. L\'astreinte 24/7 est mentionnee quelque part. Mais par rapport au concurrent qui affiche ses 120 avis en hero, LORSAV semble moins etabli.',
    parcours: [
      ['Hero (mobile)', 'Titre metier OK mais pas de CTA "Urgence" immediat'],
      ['Services', 'Depannage express trouve apres navigation'],
      ['Contact', 'Telephone dans le footer — trop bas pour une urgence mobile'],
      ['Concurrent', 'Ouvre un 2e onglet — le concurrent a ses avis en hero'],
    ] as [string, string][],
    questionCle: 'Est-ce qu\'ils interviennent vraiment ce soir et sont-ils fiables ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Astreinte mentionnee mais enfouie. 81 avis absents du site — il ne les voit pas.',
    impactVitesse: 'Mobile Wix : chargement moyen, plusieurs bundles JS.',
    impactConfiance: '81 avis 4.8 sur Google ne sont pas sur le site — manque le levier #1.',
    positifs: ['Astreinte 24/7 mentionnee', 'Zone geographique claire', 'Telephone present'],
    frictions: ['Pas de CTA urgence en hero', 'Telephone absent du header mobile', 'Aucun avis client visible sur le site', 'Design date fragilise la perception'],
    ceQuiFeraitBasculer: 'Un bandeau "Urgence 24/7 — 06 46 73 75 85" en hero + les 81 avis Google en section accueil.',
    exp: 5, conf: 5, clarte: 5,
  },
  {
    id: 4,
    name: 'Marie-Claire',
    age: 61,
    emoji: '👩',
    situation: 'Proprietaire a Clouange, recommandee par sa voisine',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle tape lorsav.fr directement mais ne trouve pas le telephone en haut de page. Le design date la rend moins sure. Elle finit par appeler mais son parcours a ete laborieux.',
    localisation: 'Clouange (57)',
    maturite: 'Decision',
    contexte: 'Sa voisine lui a dit "appelle LORSAV, ils sont tres biens". Elle ouvre son ordinateur et cherche le site.',
    impression: 'La page charge. Elle cherche instinctivement le telephone en haut a droite — absent. Le design lui semble "vieillot" par rapport aux sites qu\'elle voit en 2026.',
    parcours: [
      ['Accueil', 'Cherche le telephone en header — absent'],
      ['Scroll bas', 'Trouve l\'adresse et le telephone dans le footer'],
      ['Contact', 'Page contact trouvee : adresse, email, horaires'],
      ['Hesite', '"Le site fait un peu vieux, j\'espere qu\'ils sont bien quand meme"'],
    ] as [string, string][],
    questionCle: 'Comment je les appelle et est-ce que c\'est bien serieux ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Telephone trouve mais laborieusement. Design date fragilise la confiance.',
    impactVitesse: 'Desktop, OK.',
    impactConfiance: 'Absence de photos equipe + design date = doute sur le serieux.',
    positifs: ['Telephone present (footer)', 'Adresse physique rassurante', 'Horaires clairs (Lun-Ven 08h-18h)'],
    frictions: ['Telephone absent du header', 'Pas de photo de l\'equipe ou des interventions', 'Design Wix vieillissant', 'Pas de temoignages clients sur le site'],
    ceQuiFeraitBasculer: 'Telephone en header + 1 photo de l\'equipe en uniforme + quelques avis clients.',
    exp: 5, conf: 6, clarte: 5,
  },
  {
    id: 5,
    name: 'Nassim',
    age: 29,
    emoji: '📱',
    situation: 'Locataire a Hagondange, compare sur mobile apres une pub Facebook',
    canal: 'Reseaux sociaux',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Il decouvre LORSAV par un partage sur Facebook. Le design lui semble date par rapport au concurrent moderne qu\'il vient de voir. Pas de temoignages. Il repart.',
    localisation: 'Hagondange (57)',
    maturite: 'Decouverte',
    contexte: 'Son robinet fuit. Un ami a partage une page Facebook de LORSAV. Il ouvre le lien sur son telephone.',
    impression: 'Premiere impression : "design vieux jeu". Il compare avec un concurrent dont le site est moderne avec des photos d\'equipe et des avis integres.',
    parcours: [
      ['Accueil mobile', 'Design Wix 2019, peu engageant en 2026'],
      ['Services', 'Contenu correct mais aucune photo d\'intervention reelle'],
      ['Quitte', 'Apres 45 secondes, retourne vers le concurrent moderne'],
    ] as [string, string][],
    questionCle: 'Ces gens sont professionnels et modernes ?',
    reponse: 'Non' as const,
    commentReponse: 'Design date ne passe pas le filtre des attentes visuelles 2026 sur mobile.',
    impactVitesse: 'Wix mobile : chargement lent ressenti (plusieurs bundles JS).',
    impactConfiance: 'Aucun avis, aucune photo equipe = zero signal de confiance visuel.',
    positifs: ['Contenu services correct', 'Zone geographique claire'],
    frictions: ['Design visuellement obsolete', 'Pas de photos d\'equipe ou d\'interventions reelles', 'Pas de temoignages clients', 'Email outlook.fr visible'],
    ceQuiFeraitBasculer: 'Un site avec design moderne, photos reelles et avis integres.',
    exp: 3, conf: 3, clarte: 5,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Afficher vos 81 avis Google 4.8 etoiles sur votre site',
    pourquoi: '3 visiteurs sur 5 cherchent une preuve que vous etes fiables avant d\'appeler. Vos 81 avis sont votre actif le plus puissant — ils sont sur Google Maps mais invisibles sur votre site. C\'est votre levier de confiance numero 1.',
    action: 'Ajouter une section "Nos clients en parlent" sur la page d\'accueil avec 3 temoignages textuels (copier-coller depuis Google) + un lien "Voir tous nos avis". Afficher egalement la note 4.8/5 en chiffre cle.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Non mesure', ok: true, detail: 'Wix Thunderbolt + Fastly CDN — quota API epuise lors de l\'audit' },
  { label: 'Securite', verdict: 'C-', ok: false, detail: 'Observatory MDN : 45/100 — 4 headers manquants sur 10' },
  { label: 'SEO', verdict: 'A ameliorer', ok: false, detail: 'Titles/meta OK, sitemap OK — og:title pages internes trop generiques' },
  { label: 'Donnees structurees', verdict: 'Incomplet', ok: false, detail: 'LocalBusiness present mais sans horaires, geo, avis, @type specifique' },
  { label: 'Partage reseaux', verdict: 'Partiel', ok: false, detail: 'OG images OK — og:site_name affiche "My Vxw Site 3p5f16" (Wix non configure)' },
];

const tech = {
  observatory: { grade: 'C-', score: 45, testsOk: 6, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'Strict-Transport-Security (HSTS) — max-age=31556952' },
    { ok: true, h: 'X-Content-Type-Options — nosniff' },
    { ok: false, h: 'Content-Security-Policy (absent)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking)' },
    { ok: false, h: 'Permissions-Policy (absent)' },
    { ok: false, h: 'Referrer-Policy (absent)' },
  ],
  schema: [
    { item: 'JSON-LD present (@type LocalBusiness)', ok: true },
    { item: '@type specifique : Plumber / HVACBusiness', ok: false },
    { item: 'name, url, telephone', ok: true },
    { item: 'address complet et correct', ok: false },
    { item: 'openingHours (horaires + astreinte)', ok: false },
    { item: 'geo (latitude/longitude)', ok: false },
    { item: 'aggregateRating (81 avis 4.8)', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
  ],
  og: [
    { item: 'og:title (accueil)', ok: true, val: 'LORSAV CHAUFFAGE PLOMBERIE' },
    { item: 'og:description (accueil)', ok: true, val: 'Present et pertinent' },
    { item: 'og:image', ok: true, val: 'Image presente (Wix static)' },
    { item: 'og:url', ok: true, val: 'https://www.lorsav.fr' },
    { item: 'og:site_name', ok: false, val: '"My Vxw Site 3p5f16" — nom Wix par defaut non configure' },
    { item: 'og:title pages internes', ok: false, val: '"Services" / "Contact" / "Pricing" (trop generiques)' },
    { item: 'twitter:card', ok: true, val: 'summary_large_image' },
  ],
  seo: [
    { item: 'Title tag accueil pertinent', ok: true },
    { item: 'Meta description accueil', ok: true },
    { item: 'Title pages internes optimises', ok: true },
    { item: 'robots.txt correctement configure', ok: true },
    { item: 'sitemap.xml accessible', ok: true },
    { item: 'HTTPS force', ok: true },
    { item: 'og:title pages internes (generiques)', ok: false },
    { item: 'Sitemap a jour (dernier update : juin 2024)', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO — Verdict immediat -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>

  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilite, fluidite</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Credibilite, preuves, rassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
        <p class="text-[10px] text-neutral-400 mt-1">Comprehension de l'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <!-- Ceux qui contactent -->
    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent
        <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group persona-card bg-white rounded-xl overflow-hidden shadow-sm border border-green-200" data-canal={p.canal}>
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p>
                  <p class="text-neutral-600">{p.contexte}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p>
                  <p class="text-neutral-600">{p.impression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]: [string, string]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
