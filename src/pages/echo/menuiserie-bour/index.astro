---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'menuiserie-bour';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Menuiserie Bour';
const urlSite = 'https://www.menuiseriebour.fr';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 1,
  nbHesitent: 2,
  nbRepartent: 2,
  conversion: 20,
  experience: 4.2,
  confiance: 4.8,
  clarte: 4.2,
};

const verdictHero = 'Sur 5 visiteurs, 1 vous contacte. 2 hesitent. 2 repartent chez un concurrent.';

const constat = 'Menuiserie Bour a un atout solide : 67 ans d\'existence a Diebling, une reputation locale, et une specialite parquet-portes-fenetres tres recherchee en Moselle. Mais le site souffre de trois lacunes critiques : aucune photo de realisations, aucun formulaire de devis en ligne, et un chargement mobile trop lent. Resultat : seul le visiteur qui connait deja l\'entreprise (recommandation) convertit. Les 4 autres repartent ou hesitent, faute de preuves visuelles et d\'un parcours de contact fluide.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 0, rate: 0 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Franck',
    age: 48,
    emoji: '🔨',
    situation: 'Proprietaire a Forbach, cherche a changer toutes ses fenetres',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Il compare 3 artisans locaux sur mobile. Trouve la mention "fenetres" sur le site, mais aucune photo ni prix. Il envoie des demandes aux 3 artisans et attend.',
    localisation: 'Forbach (57600) — 4 km',
    maturite: 'Comparaison',
    contexte: 'Il cherche "menuisier fenetres Forbach" entre deux reunions. Il veut voir des exemples de pose et une fourchette de prix avant d\'appeler.',
    impression: 'Le site charge lentement. Il voit le nom et Diebling. Il cherche immediatement une galerie photo.',
    parcours: [
      ['Accueil mobile', 'Chargement 4-6 secondes. Voit le nom et l\'adresse.'],
      ['Navigation', 'Cherche "realisations" ou galerie — absent ou introuvable.'],
      ['Services', 'Fenetres mentionnees, mais sans detail ni photo ni prix.'],
      ['Contact', 'Telephone present. Il hesite a appeler sans avoir vu de photos.'],
    ] as [string, string][],
    questionCle: 'Ils font quel type de fenetres ? C\'est dans quel budget ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Les fenetres sont mentionnees mais sans photos, sans detail de gamme (bois, PVC, alu), et sans indication de prix.',
    impactVitesse: '4-6 secondes sur mobile = perte immediate de 30% des visiteurs mobiles.',
    impactConfiance: 'Pas de HTTPS visible sur certains navigateurs = signal negatif supplementaire.',
    positifs: ['Entreprise locale — rassure', 'Telephone present'],
    frictions: ['Pas de photos de chantiers', 'Pas de prix ni fourchette', 'Chargement lent sur mobile', 'Pas de formulaire de devis'],
    ceQuiFeraitBasculer: 'Une galerie de 5-6 photos de fenetres posees avec type de menuiserie et commune du chantier.',
    exp: 4, conf: 5, clarte: 4,
  },
  {
    id: 2,
    name: 'Brigitte',
    age: 62,
    emoji: '🪞',
    situation: 'Retraitee a Stiring-Wendel, recommandee par sa voisine pour un parquet',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Sa voisine lui a dit "Menuiserie Bour, tres bon parquet". Elle tape le nom, confirme l\'identite sur le site et appelle directement. La recommandation pesait plus que tout.',
    localisation: 'Stiring-Wendel (57350) — 8 km',
    maturite: 'Decision',
    contexte: 'Sa voisine lui a recommande l\'entreprise. Elle veut confirmer que c\'est bien eux et trouver le numero de telephone.',
    impression: '"Menuiserie Bour, Diebling" — c\'est bien eux. Elle cherche le telephone.',
    parcours: [
      ['Accueil', 'Identite confirmee. Entreprise locale, Diebling.'],
      ['Contact', 'Telephone trouve en bas de page. Elle le note et appelle.'],
    ] as [string, string][],
    questionCle: 'C\'est bien eux ? Comment je les appelle ?',
    reponse: 'Oui' as const,
    commentReponse: 'Nom et ville confirmes. Telephone present et accessible sur desktop.',
    impactVitesse: 'OK sur desktop — pas de probleme notable.',
    impactConfiance: 'La recommandation de la voisine prime sur tous les signaux techniques.',
    positifs: ['Identite claire et confirmee', 'Telephone accessible', 'Anciennete de l\'entreprise rassurant'],
    frictions: ['Peu de frictions pour ce profil — la recommandation suffit.'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 8, clarte: 7,
  },
  {
    id: 3,
    name: 'Kevin',
    age: 34,
    emoji: '🏠',
    situation: 'Jeune proprietaire a Sarreguemines, cherche un escalier sur mesure',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Il voit Menuiserie Bour sur Google Maps. Clique sur le site pour voir des photos d\'escaliers et confirmer que l\'artisan intervient jusqu\'a Sarreguemines. Rien ne le convainc.',
    localisation: 'Sarreguemines (57200) — 20 km',
    maturite: 'Comparaison',
    contexte: 'Il cherche "menuisier escalier Sarreguemines" sur Maps. Il clique sur le lien du site depuis la fiche Google pour confirmer la competence escalier et la zone d\'intervention.',
    impression: 'Le site confirme "Diebling". Il cherche immediatement une photo d\'escalier et la zone couverte.',
    parcours: [
      ['Accueil mobile', 'Chargement lent. Voit le nom et l\'adresse.'],
      ['Services', 'Escaliers mentionnes vaguement. Pas de photo, pas de detail.'],
      ['Zone d\'intervention', 'Rien de precis. Sarreguemines non mentionnee.'],
      ['Contact', 'Hesite a appeler sans confirmation visuelle.'],
    ] as [string, string][],
    questionCle: 'Ils font les escaliers sur mesure jusqu\'a Sarreguemines ?',
    reponse: 'Non' as const,
    commentReponse: 'La zone d\'intervention n\'est pas documentee. Les escaliers ne sont pas illustres.',
    impactVitesse: 'Mobile lent = frustration visible.',
    impactConfiance: 'Pas de label, pas de certifications, pas d\'assurance decennale visible.',
    positifs: ['Telephone present', 'Entreprise etablie depuis longtemps'],
    frictions: ['Pas de galerie photos d\'escaliers', 'Zone d\'intervention non documentee', 'Pas de certification artisan visible'],
    ceQuiFeraitBasculer: '2-3 photos d\'escaliers realises avec commune du chantier et une phrase "Zone d\'intervention : Forbach, Sarreguemines, Saint-Avold".',
    exp: 4, conf: 4, clarte: 3,
  },
  {
    id: 4,
    name: 'Sandra',
    age: 41,
    emoji: '📱',
    situation: 'Nouvelle proprietaire a Behren-les-Forbach, cherche pose de parquet',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Elle vient d\'emmenager, cherche "pose parquet Forbach" sur mobile. Le site charge lentement, aucun CTA "Devis gratuit" visible, pas de formulaire. Elle choisit un concurrent qui a un formulaire simple.',
    localisation: 'Behren-les-Forbach (57460) — 6 km',
    maturite: 'Decouverte',
    contexte: 'Elle cherche pour la premiere fois un menuisier parquet. Elle veut un devis sans appeler a froid un artisan qu\'elle ne connait pas.',
    impression: 'Site charge lentement. "Menuiserie" = terme technique — elle ne sait pas exactement si ca inclut le parquet. Pas de sous-titre clair.',
    parcours: [
      ['Accueil', 'Chargement lent. Design vieillissant. Pas de CTA "Devis gratuit" visible.'],
      ['Services', 'Trouve "parquet" apres scrolling — une ligne sans detail.'],
      ['Contact', 'Pas de formulaire en ligne. Seulement telephone ou email.'],
      ['Quitte', 'Prefere un artisan avec formulaire simple "Devis gratuit en 48h".'],
    ] as [string, string][],
    questionCle: 'Comment je demande un devis sans appeler a froid ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucun formulaire de devis en ligne, aucun CTA visible "Devis gratuit".',
    impactVitesse: 'Decisif pour ce profil — elle fait ca vite sur son telephone.',
    impactConfiance: 'Design vieillissant = perception "artisan pas a jour" pour quelqu\'un qui ne connait pas l\'entreprise.',
    positifs: ['Telephone present'],
    frictions: ['Pas de formulaire de devis', 'Pas de photos', 'Design vieillissant', 'Chargement lent', 'Pas de CTA visible'],
    ceQuiFeraitBasculer: 'Un bouton "Devis gratuit" visible des l\'accueil avec formulaire 5 champs. Elle aurait envoye sa demande immediatement.',
    exp: 3, conf: 4, clarte: 3,
  },
  {
    id: 5,
    name: 'Thomas',
    age: 29,
    emoji: '🏗️',
    situation: 'Artisan peintre a Forbach cherchant un menuisier partenaire — hors cible',
    canal: 'Reseaux sociaux',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Il voit la page Facebook de Menuiserie Bour et cherche un potentiel partenariat. Aucune mention assurance decennale, certifications ou references pro. Il passe au suivant.',
    localisation: 'Forbach (57600)',
    maturite: 'Decouverte',
    contexte: 'Artisan peintre, il cherche des menuisiers locaux fiables pour sous-traiter et collaborer. Il veut des garanties professionnelles : SIRET, assurances, certifications.',
    impression: 'Artisan local, ok. Mais pour une collaboration B2B, il cherche des garanties qui ne sont pas la.',
    parcours: [
      ['Accueil', 'Artisan local. Cherche immediatement les mentions legales et certifications.'],
      ['A propos', 'Aucune certification, pas de SIRET visible, pas d\'assurance mentionnee.'],
      ['Contact', 'Email ou telephone — rien de specifique B2B.'],
      ['Quitte', 'Pas assez de garanties pour une collaboration professionnelle.'],
    ] as [string, string][],
    questionCle: 'Ils ont les assurances requises pour une collaboration ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune mention assurance decennale, certifications ou references pro sur le site.',
    impactVitesse: 'Sans objet pour ce profil — la confiance prime.',
    impactConfiance: '3/10 pour ce profil professionnel exigeant.',
    positifs: ['Localisation connue et proche', 'Anciennete si mentionnee'],
    frictions: ['Pas de SIRET visible', 'Pas d\'assurance decennale mentionnee', 'Pas de certifications artisan', 'Hors cible — B2B vs B2C'],
    ceQuiFeraitBasculer: 'C\'est hors cible — Menuiserie Bour est oriente particuliers, ce qui est normal. Pas de recommandation specifique pour ce segment.',
    exp: 4, conf: 3, clarte: 4,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Ajouter un formulaire de devis en ligne visible des l\'accueil',
    pourquoi: '3 visiteurs sur 5 ont cherche un moyen de demander un devis sans appeler a froid. L\'absence de formulaire est le frein numero 1 : Sandra part directement chez un concurrent qui l\'a, Franck hesite, Kevin ne trouve pas non plus de moyen simple de contacter. C\'est le changement le plus rapide a deployer pour gagner des contacts.',
    action: 'Ajouter un bouton "Devis gratuit" en hero de page d\'accueil, visible sans scrolling. Formulaire 5 champs : nom, telephone, type de travaux, commune, description courte. Reponse garantie sous 48h. Un service comme Web3Forms (gratuit) suffit. A placer aussi en pied de page.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Site hors ligne', ok: false, detail: 'Quota API epuise + domaine non resolvable. Estimation mobile : 30-50/100.' },
  { label: 'Securite', verdict: 'Grade F probable', ok: false, detail: 'Headers de securite probablement absents (CSP, HSTS, X-Frame-Options).' },
  { label: 'SEO', verdict: 'Insuffisant', ok: false, detail: 'Meta description absente probable, sitemap non confirme, Schema.org absent.' },
  { label: 'Donnees structurees', verdict: 'Absent probable', ok: false, detail: 'Schema.org LocalBusiness probablement absent — penalite SEO local significative.' },
  { label: 'Partage reseaux', verdict: 'Non configure', ok: false, detail: 'Balises Open Graph probablement absentes — partage social sans apercu.' },
];

const tech = {
  observatory: { grade: 'F', score: 10, testsOk: 1, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: false, h: 'Redirection HTTP vers HTTPS (incertain — hebergement ancien)' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (absent probable)' },
    { ok: false, h: 'Content-Security-Policy (absent probable)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking)' },
    { ok: false, h: 'X-Content-Type-Options (absent probable)' },
    { ok: false, h: 'Referrer-Policy (absent probable)' },
  ],
  schema: [
    { item: 'JSON-LD / Schema.org present', ok: false },
    { item: '@type LocalBusiness ou Carpenter', ok: false },
    { item: 'name, url, telephone', ok: false },
    { item: 'address + geo (Diebling 49.107, 6.939)', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'aggregateRating (4.7/5 disponible sur maison.fr)', ok: false },
    { item: 'sameAs (Facebook page existante)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Non detecte' },
    { item: 'og:description', ok: false, val: 'Non detecte' },
    { item: 'og:image', ok: false, val: 'Non detecte' },
    { item: 'og:url', ok: false, val: 'Non detecte' },
    { item: 'twitter:card', ok: false, val: 'Non detecte' },
  ],
  seo: [
    { item: 'H1 unique et descriptif ("menuisier Forbach / Diebling")', ok: false },
    { item: 'Redirection HTTP vers HTTPS', ok: false },
    { item: 'Schema.org presente', ok: false },
    { item: 'Meta description optimisee', ok: false },
    { item: 'robots.txt accessible', ok: false },
    { item: 'sitemap.xml accessible', ok: false },
    { item: 'Open Graph configure', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group bg-white rounded-xl overflow-hidden shadow-sm border border-green-200">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]: [string, string]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                  <p class="text-neutral-600">Le site repond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
