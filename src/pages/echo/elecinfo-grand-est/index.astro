---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'elecinfo-grand-est';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'ELECINFO Grand Est';
const urlSite = 'https://www.elecinfograndest.fr/';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 3,
  nbHesitent: 1,
  nbRepartent: 1,
  conversion: 60,
  experience: 5.8,
  confiance: 6.6,
  clarte: 5.0,
};

const verdictHero = 'Sur 5 visiteurs, 3 vous contactent. 1 hesite. 1 repart sans rien faire.';

const constat = 'Votre reputation (4,7/5 sur 114 avis) et vos 17 specialistes sont vos meilleurs atouts commerciaux. Mais votre site ne les met pas assez en avant. Ceux qui vous trouvent via Google Maps ou par recommandation convertissent bien. Ceux qui comparent — notamment les professionnels et B2B — repartent faute d\'informations sur vos zones, vos certifications et vos references.';

const canalData = [
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'LinkedIn', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Laurent',
    age: 44,
    emoji: '🔌',
    situation: 'Proprietaire a Metz, vient d\'acheter un vehicule electrique',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Les 114 avis 4,7/5 l\'ont convaincu avant meme d\'arriver sur le site. Il a trouve le service IRVE et a appele directement malgre l\'absence de prix.',
    localisation: 'Metz (57)',
    maturite: 'Decision',
    contexte: 'Il vient de recevoir sa Tesla Model 3 et cherche "electricien borne recharge Metz" sur Google Maps. ELECINFO apparait en tete avec 4,7/5 et 114 avis. Il clique sur le lien du site.',
    impression: 'Site professionnel, 3 agences Grand Est, 17 specialistes. Les avis le rassurent immediatement. Il cherche directement le service IRVE.',
    parcours: [
      ['Accueil', 'Section IRVE visible. Rassurant. Cherche un prix — absent.'],
      ['Page Electricite', 'Gamme IRVE de 2,2 kW a 350 kW trouvee. Competence etablie.'],
      ['Contact', 'Formulaire sans indication de delai. Prefere appeler.'],
      ['Appel direct', 'Numero 03 72 39 55 00 utilise depuis le header.'],
    ] as [string, string][],
    questionCle: 'Combien ca coute une borne et peuvent-ils venir rapidement ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le service est confirme mais sans prix ni delai. Il finit par appeler pour avoir les informations.',
    impactVitesse: 'Challenge Cloudflare peut ralentir le premier affichage sur mobile.',
    impactConfiance: 'Les 114 avis compensent l\'absence de garanties affichees.',
    positifs: ['114 avis 4,7/5 immediatement visibles', 'Service IRVE clairement present', 'Numero de telephone accessible', '3 agences en Grand Est = presence regionale'],
    frictions: ['Aucun prix ni fourchette tarifaire', 'Delai d\'intervention non affiché', 'Horaires pas visibles immediatement', 'Formulaire sans indication de delai de reponse'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 8, clarte: 5,
  },
  {
    id: 2,
    name: 'Sandrine',
    age: 38,
    emoji: '💼',
    situation: 'Responsable technique PME 50 salaries a Nancy, cherche un prestataire reseau',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'La double competence electrique + informatique est interessante pour son projet, mais elle ne peut pas monter un dossier interne sans references B2B ni certifications. Elle bookmarke et continue de comparer.',
    localisation: 'Nancy (54) — ELECINFO-54 a 10 km',
    maturite: 'Comparaison',
    contexte: 'Elle compare 3 prestataires pour refaire le reseau informatique de ses locaux. A besoin d\'un dossier de validation pour son DG avec references et certifications.',
    impression: 'Site professionnel, couverture regionale interessante. Mais elle cherche des references entreprises et ne trouve rien.',
    parcours: [
      ['Accueil', 'Note les 114 avis et les 3 agences. Cherche les certifications : CAPEB oui, mais pas RGE ni Qualifelec.'],
      ['Services', 'Double competence electrique + informatique = differenciateur. Mais pas de reference B2B.'],
      ['Contact', 'Cherche un email direct ou un interlocuteur commercial nomme. Trouve seulement un formulaire.'],
      ['Quitte', 'Ouvre un autre onglet pour chercher leurs certifications ailleurs.'],
    ] as [string, string][],
    questionCle: 'Ont-ils deja travaille avec des entreprises comme la mienne ?',
    reponse: 'Non' as const,
    commentReponse: 'Zero reference client entreprise, zero temoignage B2B, zero logo client professionnel affiché.',
    impactVitesse: 'Desktop, chargement acceptable.',
    impactConfiance: 'Absence d\'Open Graph — quand elle partage le lien en interne, aucun apercu ne s\'affiche.',
    positifs: ['Double competence electrique + informatique (rare)', '3 agences dans le Grand Est', '114 avis = volume d\'activite prouve', 'Agree Aiphone'],
    frictions: ['Aucune reference client entreprise / B2B', 'Certifications absentes (RGE, Qualifelec)', 'Pas d\'email direct', 'Pas d\'interlocuteur nomme', 'Garanties et assurances absentes'],
    ceQuiFeraitBasculer: 'Une section "References entreprises" avec 3-4 logos clients + les certifications officielles detenues + un email commercial direct.',
    exp: 6, conf: 5, clarte: 6,
  },
  {
    id: 3,
    name: 'Kevin',
    age: 29,
    emoji: '⚡',
    situation: 'Locataire a Metz, prise electrique defectueuse, cherche depannage urgent',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Stress eleve, navigation rapide au pouce. A mis 45 secondes a trouver les horaires de depannage qui auraient du etre visibles en 5 secondes. A failli partir chez un concurrent.',
    localisation: 'Metz centre (57)',
    maturite: 'Decision',
    contexte: 'Prise electrique qui grille chez lui. Cherche "electricien urgence Metz" depuis son mobile, stresse. Compare les premiers resultats rapidement.',
    impression: 'Site trouve, logo ELECINFO, mais ou sont les horaires de depannage ? Il scroll pour chercher.',
    parcours: [
      ['Accueil (mobile)', 'Scroll rapide. Cherche "urgence" ou "depannage" dans le hero : absent.'],
      ['Services', 'Trouve "Depannage lun-ven 8h-18h" enfui dans le texte. Soulagement mais trop long a trouver.'],
      ['Header', 'Numero 03 72 39 55 00 trouve apres recherche. Appel.'],
    ] as [string, string][],
    questionCle: 'Ils font le depannage urgent et ils sont disponibles aujourd\'hui ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'L\'info existe (lun-ven 8h-18h) mais n\'est pas visible immediatement en hero sur mobile. Il a failli quitter.',
    impactVitesse: 'Challenge Cloudflare peut faire croire que le site est en panne — inquietant pour quelqu\'un en urgence.',
    impactConfiance: 'OK une fois le numero trouve, mais le temps de recherche cree du stress.',
    positifs: ['Numero de telephone present', 'Service depannage mentionne', 'Zone Metz clairement couverte'],
    frictions: ['Pas de "depannage urgent" visible en hero mobile', 'Horaires enfouis dans une page service', 'Pas d\'indication si intervention le jour meme possible', 'Challenge Cloudflare peut sembler un bug'],
    ceQuiFeraitBasculer: '',
    exp: 5, conf: 7, clarte: 4,
  },
  {
    id: 4,
    name: 'Marie-Claire',
    age: 62,
    emoji: '🏡',
    situation: 'Retraitee proprietaire, cherche un electricien pour remise en conformite',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'La recommandation de sa voisine + les 114 avis 4,7/5 ont suffi a la convaincre d\'appeler malgre l\'absence d\'horaires et de garanties visibles.',
    localisation: 'Metz peripherie (57)',
    maturite: 'Decouverte',
    contexte: 'Sa voisine lui a recommande ELECINFO. Peu a l\'aise avec le web, elle tape le nom sur Google et arrive sur le site pour se rassurer avant d\'appeler.',
    impression: 'Site propre, logo CAPEB et "Plus que PRO" lui semblent serieux. Les etoiles 4,7/5 la rassurent.',
    parcours: [
      ['Accueil', 'Lit attentivement. Les avis clients la rassurent. Cherche l\'adresse : Metz, c\'est bien.'],
      ['Cherche horaires', 'Header, footer, contact — introuvables. Frustration.'],
      ['Contact', 'Trouve le telephone. Appelle.'],
    ] as [string, string][],
    questionCle: 'Sont-ils serieux et puis-je leur faire confiance ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Les 114 avis rassurent mais l\'absence d\'horaires, garanties et mentions legales visibles laisse un doute qu\'elle surmonte grace a la recommandation.',
    impactVitesse: 'Desktop, acceptable.',
    impactConfiance: 'L\'absence de mentions legales facilement accessibles est un signal negatif pour elle.',
    positifs: ['4,7/5 sur 114 avis = preuve sociale forte', 'Logos CAPEB et Plus que PRO rassurants', 'Adresse physique Metz visible', '17 specialistes = structure serieuse'],
    frictions: ['Horaires introuvables rapidement', 'Pas de garantie ou assurance affichee', 'Pas de page "Qui sommes-nous" accessible', 'Pas de SIRET visible'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 7, clarte: 6,
  },
  {
    id: 5,
    name: 'Jerome',
    age: 35,
    emoji: '📐',
    situation: 'Architecte independant a Strasbourg, cherche un partenaire electricien Grand Est',
    canal: 'LinkedIn',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Hors cible geographique probable (Strasbourg non mentionnee) et aucun signal de partenariat avec des architectes. Quitte sans laisser de coordonnees.',
    localisation: 'Strasbourg (67) — probablement hors zone',
    maturite: 'Comparaison',
    contexte: 'Un confrere a partage un post ELECINFO sur LinkedIn. Il visite le profil d\'entreprise puis clique sur le site pour evaluer un potentiel partenariat regulier.',
    impression: 'Site correct mais generique. Cherche une carte d\'intervention et des references de chantiers architecte.',
    parcours: [
      ['Accueil', 'Services interessants. Double competence rare. Mais ou interviennent-ils exactement ?'],
      ['Contact', '3 agences : Metz, Ludres, Saint-Sauveur. Strasbourg non mentionnee. Doute.'],
      ['Services', 'Aucune photo de chantier. Aucune reference architecte ou maitre d\'oeuvre.'],
      ['Quitte', 'Incertitude sur la zone + zero signal partenariat = repart sans contacter.'],
    ] as [string, string][],
    questionCle: 'Ils interviennent jusqu\'a Strasbourg et travaillent-ils avec des architectes ?',
    reponse: 'Non' as const,
    commentReponse: 'Zone d\'intervention floue, pas de carte, Strasbourg non mentionnee, zero reference architecte.',
    impactVitesse: 'Desktop, OK.',
    impactConfiance: 'Absence d\'Open Graph — quand il partage le lien a son associe, aucun apercu ne s\'affiche.',
    positifs: ['3 agences Grand Est = couverture potentielle', 'Double competence rare', '17 specialistes = capacite multi-projets'],
    frictions: ['Zone d\'intervention floue (carte absente)', 'Aucune reference architecte ou maitre d\'oeuvre', 'Aucune photo de chantier', 'Strasbourg non mentionnee', 'Pas d\'email direct pour un premier contact pro'],
    ceQuiFeraitBasculer: 'Une carte interactive des zones d\'intervention + une section "Partenaires" avec references architectes + un email direct pour contact pro.',
    exp: 5, conf: 6, clarte: 4,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Afficher horaires et disponibilite depannage en haut de chaque page',
    pourquoi: 'Pour un electricien, la disponibilite est le critere de decision numero 1. 3 visiteurs sur 5 ont cherche les horaires ou le delai d\'intervention sans trouver rapidement. Kevin a failli partir chez un concurrent faute de voir l\'info en 5 secondes. L\'information existe sur le site mais elle est enfouie dans une page de service.',
    action: 'Ajouter dans le header et le footer : "Depannage lun-ven 8h-18h — 03 72 39 55 00" + un badge "Devis gratuit sous 48h" en hero. Sur mobile, epingler le numero avec un bouton "Appeler" visible sans scroll.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Non mesure', ok: true, detail: 'Quota API epuise — tester sur pagespeed.web.dev' },
  { label: 'Securite', verdict: 'Grade C', ok: false, detail: 'Score 55/100 — 2 tests echoues sur 10 (Observatory MDN)' },
  { label: 'SEO', verdict: 'A ameliorer', ok: false, detail: 'Meta description absente, alt images incomplets' },
  { label: 'Donnees structurees', verdict: 'Partiel', ok: false, detail: 'Schema.org present mais incomplet (horaires, geo, sameAs manquants)' },
  { label: 'Partage reseaux', verdict: 'Absent', ok: false, detail: 'Open Graph completement absent — aucun apercu au partage' },
];

const tech = {
  observatory: { grade: 'C', score: 55, testsOk: 8, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'HTTPS force (Cloudflare)' },
    { ok: true, h: 'Strict-Transport-Security (HSTS via Cloudflare)' },
    { ok: false, h: 'X-Content-Type-Options — manquant (contribue aux 2 echecs)' },
    { ok: false, h: 'X-Frame-Options — manquant (risque clickjacking)' },
    { ok: false, h: 'Content-Security-Policy — probablement absent' },
    { ok: true, h: 'Cloudflare Rocket Loader (JS differe)' },
  ],
  schema: [
    { item: 'JSON-LD present', ok: true },
    { item: '@type LocalBusiness', ok: true },
    { item: 'name, url, telephone', ok: true },
    { item: 'address (Metz 57070)', ok: true },
    { item: 'aggregateRating (4.7/5 — 114 avis)', ok: true },
    { item: 'geo (latitude/longitude)', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'image / logo dans JSON-LD', ok: false },
    { item: 'sameAs (Facebook, LinkedIn)', ok: false },
    { item: 'description complete', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Absent' },
    { item: 'og:description', ok: false, val: 'Absent' },
    { item: 'og:image', ok: false, val: 'Absent' },
    { item: 'og:url', ok: false, val: 'Absent' },
    { item: 'og:type', ok: false, val: 'Absent' },
    { item: 'twitter:card', ok: false, val: 'Absent' },
    { item: 'meta description', ok: false, val: 'Absente' },
    { item: 'canonical', ok: false, val: 'Absent' },
    { item: 'viewport', ok: true, val: 'Present' },
    { item: 'HTTPS force', ok: true, val: 'Cloudflare' },
  ],
  seo: [
    { item: 'Un seul H1 par page', ok: true },
    { item: 'H1 pertinent ("Entreprise d\'Electricite a Metz, Ludres et Saint-Sauveur")', ok: true },
    { item: 'Meta description', ok: false },
    { item: 'Images avec alt text', ok: false },
    { item: 'robots.txt accessible', ok: false },
    { item: 'sitemap.xml accessible', ok: false },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'Canonical', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO — Verdict immediat -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>

  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilite, fluidite</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Credibilite, preuves, rassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
        <p class="text-[10px] text-neutral-400 mt-1">Comprehension de l'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <!-- Ceux qui contactent -->
    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent
        <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group persona-card bg-white rounded-xl overflow-hidden shadow-sm border border-green-200" data-canal={p.canal}>
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
