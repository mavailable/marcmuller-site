const kpis = { nbPersonas: 10, nbConvertissent: 4, nbHesitent: 3, nbRepartent: 3, conversion: 40, experience: 6.8, confiance: 7.5, clarte: 5.5 };

const verdictHero = '4 clients sur 10 reservent. 6 repartent — parce qu\'ils ne trouvent pas les prix de vos menus.';

const constat = '1 etoile Michelin, 752 avis a 4.7 etoiles, Prix Taittinger, 3 toques Gault&Millau — votre reputation est exceptionnelle. Votre site est beau et coherent avec votre positionnement. Mais il manque la seule chose que chaque visiteur cherche en premier : les prix. "Menu Degustation en 6 services" — combien ? Le site ne le dit pas. Et chaque visiteur qui ne trouve pas la reponse quitte pour aller voir la fiche Michelin ou TheFork.';

const canalData = [
