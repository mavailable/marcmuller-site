  { label: 'SEO', verdict: 'Partiel', ok: false, detail: 'Meta presentes mais Schema.org Restaurant/Menu absent' },
  { label: 'Donnees structurees', verdict: 'Faible', ok: false, detail: 'Pas de Schema Restaurant, Menu, AggregateRating' },
  { label: 'Reservation', verdict: 'ZenChef OK', ok: true, detail: 'Reservation en ligne fonctionnelle via ZenChef' },
];

const tech = {
