  { type: 'critique' as const, titre: '752 avis Google invisibles sur le site', detail: '4.7 etoiles sur 752 avis — c\'est exceptionnel, meme pour un etoile. Mais votre site ne montre aucun temoignage. Les visiteurs qui arrivent par Google Search ou IA ne voient pas cette preuve sociale.', chiffre: '0/752', chiffreLabel: 'avis sur le site' },
