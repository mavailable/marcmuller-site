  { type: 'important' as const, titre: 'Carte/plats du moment non detailles', detail: 'Un critique gastronomique ou un foodie veut savoir ce que vous servez MAINTENANT. "Menu du Moment" sans les plats = curiosite non satisfaite. La carte doit etre vivante et mise a jour regulierement.', chiffre: '0', chiffreLabel: 'plats detailles' },
