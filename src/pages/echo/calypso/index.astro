                      <div class="text-[10px] text-neutral-400 uppercase tracking-wider">FR</div>
                      <div class={`text-xs font-semibold ${decisionTextColor(p.fr.decision)}`}>{decisionEmoji(p.fr.decision)} {p.fr.decision}</div>
                    </div>
                    <div class="text-center px-2 py-1 rounded bg-neutral-50">
                      <div class="text-[10px] text-neutral-400 uppercase tracking-wider">EN</div>
                      <div class={`text-xs font-semibold ${decisionTextColor(p.en.decision)}`}>{decisionEmoji(p.en.decision)} {p.en.decision}</div>
