                          <span class="text-[10px] text-neutral-400 uppercase tracking-wider">{label}</span>
                          <span class={`text-[10px] ${decisionBadge(data.decision)} text-white px-1.5 py-0.5 rounded font-medium`}>{data.decision}</span>
                        </div>
                        <p class="text-xs text-neutral-700 mb-3 leading-relaxed">{data.resume}</p>
                        <div class="flex gap-3 pt-2 border-t border-neutral-100 justify-around">
