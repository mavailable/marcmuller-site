                    <div class="text-center px-2 py-1 rounded bg-neutral-50">
                      <div class="text-[10px] text-neutral-400 uppercase tracking-wider">DE</div>
                      <div class={`text-xs font-semibold ${decisionTextColor(p.de.decision)}`}>{decisionEmoji(p.de.decision)} {p.de.decision}</div>
