const ameliorationsHautes = [
  {
    titre: 'Afficher un email de contact visible sur toutes les pages',
    pourquoi: '3 personas sur 5 ont cherche un email pour envoyer plans, mesures ou cahier des charges. Le formulaire Simplebo est percu comme une "boite noire" — on ne sait pas a qui on ecrit ni si le message arrive. Un email affiché en clair reduirait immediatement la friction pour les profils Comparaison et B2B.',
    action: 'Ajouter contact@menuiserieteitgen.fr (ou l\'email existant) dans le pied de page, la page Contact, et idealement en header sur mobile. Prend moins de 10 minutes a configurer dans Simplebo.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Correcte', ok: true, detail: 'Simplebo heberge en France — chargement correct desktop.' },
  { label: 'Securite', verdict: 'Grade B', ok: true, detail: 'Observatory MDN : B — bonne securite de base.' },
  { label: 'SEO', verdict: 'A ameliorer', ok: false, detail: 'Sitemap a verifier, meta descriptions a optimiser.' },
