const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart (hors cible).';

const constat = 'Menuiserie Teitgen a de vrais atouts : QUALIBAT, garantie decennale, entreprise depuis 1902, interventions confirmees sur les fenetres et escaliers. Mais 3 visiteurs sur 5 ont cherche un email pour envoyer plans ou cahier des charges — et ne l\'ont pas trouve. Le formulaire seul ne suffit pas pour les projets complexes. Un email affiche en clair pourrait basculer 1-2 hesitants en clients.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
