  { type: 'important' as const, titre: 'Téléphone non cliquable sur mobile', detail: 'Un visiteur en déplacement ne peut pas appeler en un tap — il doit recopier le numéro à la main.', chiffre: '!', chiffreLabel: 'Lien tel: manquant sur mobile' },
  { type: 'important' as const, titre: 'Email de contact invisible', detail: '3 visiteurs sur 5 ont cherché un email pour envoyer leurs plans ou cahier des charges et ne l\'ont pas trouvé.', chiffre: '3/5', chiffreLabel: 'visiteurs bloqués par cette friction' },
