const ameliorationsUtiles = [
  {
    titre: 'Schema.org LocalBusiness / HairSalon pour Nancy Centre',
    detail: '580 avis a 4.0 non exploites en rich snippets. Un Schema.org avec AggregateRating + OpeningHours + Address Nancy = etoiles dans les SERP + horaires directement dans Google. Facile a implementer sur une page propre.',
  },
  {
