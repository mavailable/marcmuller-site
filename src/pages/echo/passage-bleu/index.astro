  },
];

const ameliorationsDiscuter = [
  {
    emoji: '🏪',
    titre: 'Independance progressive vis-a-vis de la franchise',
    detail: 'Le site franchise peut changer, reduire la visibilite de Nancy ou fermer sans preavis. Un site propre cree une fondation digitale independante — la marque locale survit aux decisions nationales. A discuter selon les contraintes de la franchise.',
  },
