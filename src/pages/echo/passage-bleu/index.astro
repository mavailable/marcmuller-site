  observatory: { grade: 'B-', score: 58, testsOk: 4, testsTotal: 10 },
  pagespdMobile: { performance: 42, accessibility: 75, bestPractices: 72, seo: 65 },
  pagespdDesktop: { performance: 65, accessibility: 80, bestPractices: 75, seo: 70 },
  cwv: { lcp: '~4.0s (catalogue lourd)', inp: '~300ms', cls: '~0.08' },
  headers: [
    { ok: true, h: 'HTTPS' },
    { ok: true, h: 'HSTS probable' },
    { ok: false, h: 'Content-Security-Policy (partiel)' },
    { ok: true, h: 'X-Frame-Options' },
    { ok: false, h: 'Permissions-Policy (absent)' },
