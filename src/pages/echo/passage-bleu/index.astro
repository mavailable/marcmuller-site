    frictions: ['Aucune page Nancy sur le site', 'Horaires introuvables en ligne', 'Doit appeler pour des infos basiques'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 7, clarte: 2,
  },
  {
    id: 2,
    name: 'Beatrice',
    age: 52,
    emoji: '💆',
