---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'passage-bleu';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const isProspection = true;
const nomProspect = 'Passage Bleu Nancy Centre';
const urlSite = 'https://www.passagebleu.com';
const dateAudit = '31 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 3,
  nbHesitent: 1,
  nbRepartent: 1,
  conversion: 60,
  experience: 6.0,
  confiance: 7.5,
  clarte: 2.8,
};

const verdictHero = 'Sur 5 visiteurs, 3 reservent — mais tous en passant par un appel car le site franchise ne donne aucune information sur l\'etablissement Nancy. Emilie cherchait un cadeau soin pour son amie : trop de soins nationaux, pas de parcours cadeau local. Karim voulait de l\'epilation homme a Nancy : invisible sur le site franchise.';

const constat = 'Passage Bleu Nancy Centre repose entierement sur Google Maps et le bouche-a-oreille pour convertir — le site franchise ne joue aucun role dans la decision. Les 580 avis a 4.0 sont un capital reputationnel fort, mais ils travaillent sur Google Maps, pas sur le site. L\'etablissement n\'a aucune presence digitale propre : pas de page locale avec horaires, tarifs, equipe, services disponibles a Nancy. Chaque reservation genere une friction inutile (appel) pour des informations basiques. L\'etablissement est invisible sur "coiffeur nancy centre", "estheticienne nancy", "epilation homme nancy".';

const canalData = [
  { canal: 'Google Search (coiffure)', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille (horaires)', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Maps (cadeau soin)', nb: 1, convert: 0, rate: 0 },
  { canal: 'IA (epilation homme)', nb: 1, convert: 0, rate: 0 },
  { canal: 'Google Search (comparaison)', nb: 1, convert: 1, rate: 100 },
];

const personas = [
  {
    id: 1,
    name: 'Laura',
    age: 29,
    emoji: '✂️',
    situation: 'Cherche un salon de coiffure bien note dans le centre de Nancy pour coupe + couleur',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Appelle',
