    localisation: 'Nancy (54)',
    maturite: 'Comparaison',
    contexte: 'Budget coiffure regulier : 60-80€ tous les 2 mois. Veut un salon fiable et accessible en centre-ville.',
    impression: 'Les 580 avis font la difference dans la comparaison — meme sans tarifs sur le site, le volume d\'avis et leur contenu donnent confiance.',
    parcours: [
      ['Google Search', '"coiffeur femme nancy"'],
      ['Google Maps', 'Passage Bleu — 580 avis 4.0, 14 rue Notre Dame'],
      ['Site', 'Catalogue national — pas de tarifs Nancy'],
      ['Maps', 'Retour sur Maps — lecture d\'avis mentionnant les prix'],
      ['Reservation', 'Appelle pour reserver'],
    ] as [string, string][],
    questionCle: 'Quel est le tarif coupe + couleur femme et comment je reserve ?',
    reponse: 'Non' as const,
    commentReponse: 'Les tarifs ne sont pas sur le site — elle les devine via les avis Google, pas via le site lui-meme.',
    impactVitesse: 'Desktop — non bloquant',
    impactConfiance: '580 avis 4.0 — volume compensateur tres efficace',
    positifs: ['580 avis 4.0 = preuve de regularite', 'Localisation centre-ville ideale', 'Avis mentionnent les prix accessibles'],
