    parcours: [
      ['ChatGPT', '"epilation homme nancy soin visage" — Passage Bleu cite'],
      ['Site', 'Catalogue national — cherche "homme" ou "masculin" → difficilement trouvable'],
      ['Adresse', 'Cherche l\'etablissement Nancy → non trouvable directement'],
      ['Decision', 'Quitte — va sur un concurrent "Institut soins homme nancy" avec page dediee et tarifs'],
    ] as [string, string][],
    questionCle: 'Est-ce que Passage Bleu Nancy fait vraiment des soins homme et combien ca coute ?',
    reponse: 'Non' as const,
    commentReponse: 'Impossible de valider la disponibilite des soins homme a Nancy ni les tarifs — trop de contenu generique national.',
    impactVitesse: 'Mobile — catalogue lourd, contenu non pertinent',
    impactConfiance: 'Marque reconnue mais trop nationale pour rassurer sur un service specifique local',
    positifs: ['Marque reconnue', 'Large catalogue en theorie'],
    frictions: ['Pas de section homme claire', 'Aucune info locale Nancy', 'Pas de tarifs', 'Catalogue trop vaste et non filtre'],
    ceQuiFeraitBasculer: 'Une page Nancy Centre avec la liste des soins disponibles localement, une section "soins homme" et des tarifs. Karim cherchait une adresse de confiance — il avait juste besoin de confirmation que c\'etait pour lui aussi.',
    exp: 3, conf: 5, clarte: 1,
  },
  {
    id: 5,
    name: 'Nathalie',
    age: 38,
    emoji: '🖥️',
    situation: 'Compare 3 salons de coiffure a Nancy pour ses soins reguliers',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Reserve',
