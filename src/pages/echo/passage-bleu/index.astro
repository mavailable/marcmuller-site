      ['Google Search', '"salon coiffure nancy centre"'],
      ['Google Maps', 'Passage Bleu — 4.0 sur 580 avis, 14 rue Notre Dame'],
      ['Site franchise', 'Cherche horaires Nancy — pas de page locale'],
      ['Appel', 'Appelle via Maps pour verifier horaires et disponibilite'],
      ['Reservation', 'Reserve directement par telephone'],
    ] as [string, string][],
    questionCle: 'Quels sont les horaires et comment je reserve ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune information locale sur le site — doit appeler pour des questions basiques.',
