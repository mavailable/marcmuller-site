    questionCle: 'Quels sont les horaires du salon Nancy Centre ?',
    reponse: 'Non' as const,
    commentReponse: 'Le site national ne donne pas les horaires du salon Nancy Centre.',
    impactVitesse: 'Desktop — non bloquant',
    impactConfiance: 'Recommandation directe = confiance totale, site irrelevant',
    positifs: ['Recommandation forte de la soeur', 'Telephone disponible via Maps'],
    frictions: ['Aucune info Nancy sur le site', 'Doit appeler pour des horaires'],
    ceQuiFeraitBasculer: '',
    exp: 5, conf: 8, clarte: 2,
  },
  {
    id: 3,
    name: 'Emilie',
    age: 35,
    emoji: '🎁',
    situation: 'Cherche un cadeau soin pour son amie — institut beaute a Nancy',
    canal: 'Google Maps',
