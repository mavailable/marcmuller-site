const techVerdicts = [
  { label: 'Vitesse', verdict: 'Moyen', ok: false, detail: 'Site franchise CMS — ~42 mobile, catalogue 300+ soins' },
  { label: 'Securite', verdict: 'Acceptable', ok: true, detail: 'HTTPS + HSTS probable — grade B- estime' },
