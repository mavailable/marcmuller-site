---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'menuiserie-didier';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Menuiserie Didier';
const urlSite = 'https://www.menuiserie-didier.com';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 26 50 59 89';
const marcTelLink = 'tel:+33626505989';
const marcWhatsApp = 'https://wa.me/33626505989?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.0,
  confiance: 5.6,
  clarte: 5.2,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'Menuiserie Didier a de vrais atouts : fabricant local avec deux ateliers propres a Montigny-les-Metz, partenaires reconnus (REHAU, VELUX, Euradif), zone 50 km bien affichee, telephone fixe rassurant. Mais le site souffre d\'un manque critique : aucune photo de realisations. Pour un metier aussi visuel que la menuiserie, les visiteurs en phase Comparaison ont besoin de voir votre travail avant d\'appeler. 3 visiteurs sur 5 ont cherche ces photos sans les trouver — et 2 hesitants sont repartis chez des concurrents mieux documentes.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Sylvie',
    age: 54,
    emoji: '🏠',
    situation: 'Proprietaire a Montigny-les-Metz, cherche a changer ses fenetres pour reduire sa facture de chauffage',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle cherche "remplacement fenetres Metz" apres une facture de gaz elevee. Trouve Menuiserie Didier, voit les fenetres PVC et REHAU — credible. Mais aucune aide MaPrimeRenov mentionnee, aucun prix. Elle compare avec un concurrent qui affiche les aides 2026.',
    localisation: 'Montigny-les-Metz (57950)',
    maturite: 'Comparaison',
    contexte: 'Elle a recu une facture de gaz elevee cet hiver. Son mari lui a dit de se renseigner sur les aides MaPrimeRenov. Elle cherche un artisan local proche.',
    impression: '"Menuisier pres de Metz" la rassure. Elle cherche immediatement les aides financieres et les prix.',
    parcours: [
      ['Accueil', 'Artisan local confirme. Cherche "MaPrimeRenov" ou "aides" — absent'],
      ['Page Fenetres', 'REHAU visible, TVA 5,5% mentionnee. Mais aucune aide ni prix'],
      ['Contact', 'Formulaire trouve. Hesite a appeler sans avoir vu de photos ni de budget'],
      ['Quitte', 'Part comparer un concurrent qui affiche ses aides 2026'],
    ] as [string, string][],
    questionCle: 'Est-ce qu\'ils font les fenetres avec les aides de l\'Etat ?',
    reponse: 'Non' as const,
    commentReponse: 'TVA 5,5% mentionnee mais aucune mention de MaPrimeRenov, CEE ou Eco-PTZ — les aides principales pour 2026.',
    impactVitesse: 'Site probablement lent sur mobile (WordPress + scripts tiers). Frustration pour une visiteuse qui compare plusieurs artisans.',
    impactConfiance: 'HTTPS et adresse physique rassurent. Mais l\'absence d\'aides nuit a la conversion.',
    positifs: ['Artisan local avec atelier physique a Montigny — tres proche', 'Partenaire REHAU (marque connue)', 'Telephone fixe 03 87 — signal de serieux'],
    frictions: ['Aucune mention des aides MaPrimeRenov, CEE — sa motivation principale', 'Aucun prix ni fourchette tarifaire', 'Pas de photos de realisations recentes'],
    ceQuiFeraitBasculer: 'Une section "Aides & financement" avec les aides actuelles 2026 + un formulaire de devis mentionnant l\'eligibilite.',
    exp: 5, conf: 6, clarte: 4,
  },
  {
    id: 2,
    name: 'Franck',
    age: 41,
    emoji: '🔧',
    situation: 'Proprietaire a Metz-Nord, sa porte de garage est cassee depuis 3 jours — urgence',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence porte de garage. Il cherche sur Maps "menuisier Metz". Trouve Menuiserie Didier, voit l\'adresse locale, trouve le telephone 03 87 69 11 11 et appelle directement.',
    localisation: 'Metz (57000)',
    maturite: 'Decision',
    contexte: 'Urgence pratique — sa porte de garage est bloquee. Il cherche le premier artisan local disponible sur Maps.',
    impression: 'Il arrive depuis Google Maps. Voit le logo, l\'adresse Montigny-les-Metz — confirme que c\'est local. Cherche le numero.',
    parcours: [
      ['Accueil', 'Voit le telephone 03 87 69 11 11. C\'est l\'essentiel.'],
      ['Appelle', 'En Decision, urgence reelle — le numero suffit. Il appelle.'],
    ] as [string, string][],
    questionCle: 'Ils peuvent venir vite ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Page "Vitre cassee" suggere une capacite d\'urgence mais pas de CTA "intervention rapide" visible en accueil.',
    impactVitesse: 'Meme si le site est lent, Franck est en urgence — il cherche le numero, le trouve, appelle.',
    impactConfiance: 'Adresse physique + telephone fixe = rassurant pour un profil en Decision.',
    positifs: ['Telephone visible (03 87 69 11 11)', 'Adresse Montigny-les-Metz — proche', 'Zone intervention 50 km clairement affichee'],
    frictions: ['Pas de mention "urgence" ou "intervention rapide" en hero', 'Page Vitre cassee datee 2019 — signal de site non entretenu'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 7, clarte: 6,
  },
  {
    id: 3,
    name: 'Nathalie',
    age: 38,
    emoji: '🪟',
    situation: 'Proprietaire a Augny, projet de baie vitree pour agrandir son salon',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Sa voisine lui a recommande Menuiserie Didier pour une baie vitree. Elle tape l\'URL pour confirmer l\'identite, voit la page service baie vitree, remplit le formulaire de contact.',
    localisation: 'Augny (57685)',
    maturite: 'Decision',
    contexte: 'Sa voisine lui a donne le nom. Elle veut confirmer que c\'est bien l\'entreprise recommandee et trouver le contact.',
    impression: '"Menuiserie Didier — Menuisier pres de Metz". C\'est bien eux. Identite confirmee immediatement.',
    parcours: [
      ['Accueil', 'Identite confirmee. Cherche "baie vitree" dans le menu.'],
      ['Page Baie vitree', 'Service decrit, mais aucune photo de realisation.'],
      ['Contact', 'Remplit le formulaire pour demander un devis.'],
    ] as [string, string][],
    questionCle: 'C\'est bien eux ? Est-ce qu\'ils ont deja fait des baies vitrees ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'La page baie vitree existe et liste les services, mais aucune photo de chantier ne permet de voir le resultat reel.',
    impactVitesse: 'Sur desktop, le site charge de facon acceptable.',
    impactConfiance: 'La recommandation de la voisine + adresse physique + formulaire correct = suffisant pour passer a l\'action.',
    positifs: ['Identite claire, adresse physique', 'Page baie vitree dediee', 'Formulaire de contact fonctionnel', 'Telephone fixe professionnel'],
    frictions: ['Aucune photo de baie vitree posee — elle ne peut pas voir le rendu', 'Aucun temoignage client ni avis integre', 'Site date, design 2019'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 7, clarte: 6,
  },
  {
    id: 4,
    name: 'Thomas',
    age: 29,
    emoji: '📱',
    situation: 'Locataire a Metz, cherche un artisan pour sa proprietaire — remplacement porte interieure',
    canal: 'Reseaux sociaux',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Sa proprietaire lui demande de trouver des artisans locaux. Il clique sur un lien Facebook de Menuiserie Didier. Le lien arrive sans image d\'apercu (pas d\'OG). Site lent sur mobile. Design date. Pas de photos recentes. Il hesite a recommander ce contact.',
    localisation: 'Metz (57000)',
    maturite: 'Decouverte',
    contexte: 'Sa proprietaire lui a demande de trouver des artisans pour changer une porte interieure. Il a vu passer un lien vers la page Facebook de Menuiserie Didier.',
    impression: 'Il clique depuis Facebook. Pas d\'image d\'apercu sur le lien (pas d\'OG). La page charge lentement. Design vieillissant.',
    parcours: [
      ['Accueil', 'Chargement lent. Design 2019. Scrolle pour chercher des photos.'],
      ['Page Porte interieure', 'Service decrit mais peu de photos attractives recentes.'],
      ['Hesite', 'Pas de formulaire devis simple, pas d\'avis clients. Difficile de recommander.'],
    ] as [string, string][],
    questionCle: 'Ils font les portes interieures ? C\'est serieux ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'La page existe et le service est decrit, mais l\'absence de photos recentes et d\'avis clients ne donne pas assez confiance pour recommander.',
    impactVitesse: 'Lenteur sur mobile = friction immediate pour un utilisateur jeune habitue aux sites rapides.',
    impactConfiance: 'Absence d\'OG lors du partage Facebook = apercu brut sans image = signal non professionnel.',
    positifs: ['Service porte interieure bien present', 'Adresse physique rassurante', 'Zone Metz confirmee'],
    frictions: ['Chargement lent sur mobile', 'Aucune photo de realisation recente', 'Aucun avis client / temoignage', 'Pas d\'OG — lien partage sans image ni description', 'Design date'],
    ceQuiFeraitBasculer: 'Quelques photos de portes interieures posees recemment + 2-3 avis Google integres.',
    exp: 4, conf: 4, clarte: 5,
  },
  {
    id: 5,
    name: 'Michel',
    age: 63,
    emoji: '🏢',
    situation: 'Gerant d\'une petite residence de 6 logements a Woippy — hors cible',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Il cherche un menuisier pour remplacer les fenetres de 6 appartements. Cherche label RGE, certifications, references pro — absents. Site oriente particuliers. Il repart vers un menuisier certifie.',
    localisation: 'Woippy (57140)',
    maturite: 'Comparaison',
    contexte: 'Il cherche un menuisier pour remplacer les fenetres de toute la residence. Il a besoin d\'assurances, certifications RGE, et capacite chantier collectif.',
    impression: '"Menuisier pres de Metz" — OK. Mais le site ressemble a un site artisan oriente particuliers.',
    parcours: [
      ['Accueil', 'Design artisanal, oriente renovation particuliers. Cherche "certifications".'],
      ['Navigation', 'Pas de page "A propos" ni "L\'entreprise". Pas de certifications visibles.'],
      ['Quitte', 'Aucun label RGE, aucune reference chantier collectif. Part vers un menuisier certifie.'],
    ] as [string, string][],
    questionCle: 'Ils peuvent gerer 6 appartements ? Ils ont les certifications ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune certification visible, pas de page entreprise, pas de references de chantiers collectifs.',
    impactVitesse: 'Acceptable sur desktop pour ce profil.',
    impactConfiance: 'L\'absence de certifications est redhibitoire pour ce profil professionnel exigeant.',
    positifs: ['Zone Metz confirmee', 'Deux ateliers independants (signal de capacite)', 'REHAU + Euradif — marques reconnues'],
    frictions: ['Aucun label RGE visible — bloquant pour les aides collectives', 'Pas de page Entreprise avec historique et equipe', 'Aucune reference de chantier collectif', 'C\'est probablement hors cible de Menuiserie Didier'],
    ceQuiFeraitBasculer: 'C\'est hors cible — Menuiserie Didier est oriente particuliers, ce qui est coherent avec leur positionnement local.',
    exp: 4, conf: 4, clarte: 5,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Creer une page Realisations avec photos avant/apres',
    pourquoi: '3 visiteurs sur 5 ont cherche des photos de chantiers termines et ne les ont pas trouvees. La menuiserie est un metier visuel — un client ne peut pas evaluer la qualite du travail sans voir des exemples concrets. Les 2 hesitants (40% des visiteurs) repartent actuellement chez des concurrents mieux documentes visuellement.',
    action: 'Ajouter une page /realisations/ avec 8 a 12 photos de chantiers termines : fenetres PVC, baie vitree, porte d\'entree, meuble sur mesure. Format : photo avant + photo apres + type de travaux + ville (ex : "Remplacement fenetres PVC — Montigny-les-Metz"). A integrer dans le menu principal.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const alertes: { type: 'critique' | 'important'; titre: string; detail: string; chiffre: string; chiffreLabel: string }[] = [
  { type: 'important' as const, titre: 'Aucune page realisations', detail: '3 visiteurs sur 5 ont cherche des photos de chantiers termines et ne les ont pas trouvees. Sans preuves visuelles, les hesitants choisissent un concurrent mieux documente.', chiffre: '3/5', chiffreLabel: 'visiteurs cherchent des realisations' },
  { type: 'important' as const, titre: 'Schema.org LocalBusiness absent', detail: 'Votre site a du Schema.org mais pas de type LocalBusiness. Google ne peut pas afficher vos coordonnees, horaires et avis dans les resultats locaux. Vos concurrents avec ces donnees apparaissent devant vous.', chiffre: '0', chiffreLabel: 'donnees de contact structurees' },
  { type: 'important' as const, titre: 'Open Graph non configure', detail: 'Aucune balise Open Graph detectee. Vos liens partages sur WhatsApp ou Facebook s\'affichent sans image ni description — un signal de site non professionnel.', chiffre: '0', chiffreLabel: 'balises Open Graph' },
];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A verifier', ok: false, detail: 'Quota API epuise — WordPress + scripts tiers. Estimation mobile : 35-55/100.' },
  { label: 'Securite', verdict: 'Partielle', ok: false, detail: 'HTTPS + nosniff OK, mais CSP en report-only seulement, X-Frame-Options absent.' },
  { label: 'SEO', verdict: 'Moyen', ok: false, detail: 'Title + meta + sitemap OK. Schema.org LocalBusiness et Open Graph absents.' },
  { label: 'Donnees structurees', verdict: 'Incomplet', ok: false, detail: 'WebSite/WebPage presents, mais pas de LocalBusiness — penalite SEO local.' },
  { label: 'Partage reseaux', verdict: 'Non configure', ok: false, detail: 'Aucune balise OG — liens partages sans image ni description.' },
];

const tech = {
  observatory: { grade: 'C-D', score: 40, testsOk: 3, testsTotal: 7 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible (estimé ~4s)', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'Redirection HTTP vers HTTPS' },
    { ok: true, h: 'X-Content-Type-Options (nosniff present)' },
    { ok: false, h: 'Strict-Transport-Security (max-age=30j seulement — trop court, recommande : 1 an)' },
    { ok: false, h: 'Content-Security-Policy (report-only uniquement — pas de protection active)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking)' },
    { ok: false, h: 'Referrer-Policy (absent)' },
    { ok: false, h: 'Permissions-Policy (absent)' },
  ],
  schema: [
    { item: 'JSON-LD / Schema.org present', ok: true },
    { item: '@type WebSite present', ok: true },
    { item: '@type LocalBusiness ou Carpenter', ok: false },
    { item: 'name, url, telephone', ok: false },
    { item: 'address + geo', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'aggregateRating', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Non detecte' },
    { item: 'og:description', ok: false, val: 'Non detecte' },
    { item: 'og:image', ok: false, val: 'Non detecte' },
    { item: 'og:url', ok: false, val: 'Non detecte' },
    { item: 'twitter:card', ok: false, val: 'Non detecte' },
  ],
  seo: [
    { item: 'Title optimise ("Menuisier pres de Metz")', ok: true },
    { item: 'Meta description presente', ok: true },
    { item: 'robots.txt accessible et bien configure', ok: true },
    { item: 'sitemap_index.xml accessible', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'Schema.org LocalBusiness presente', ok: false },
    { item: 'Open Graph configure', ok: false },
    { item: 'PHP a jour (actuellement PHP 7.4 — EOL dec. 2022)', ok: false },
    { item: 'Contenu a jour (14/20 pages datent de 2020)', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 2b. ALERTES -->
{alertes.length > 0 && (
  <section style="background: #fefce8;" class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <div>
          <h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2>
          <p class="text-sm text-neutral-600">
            {alertes.filter(a => a.type === 'critique').length > 0 && <span class="text-red-700 font-medium">{alertes.filter(a => a.type === 'critique').length} critique{alertes.filter(a => a.type === 'critique').length > 1 ? 's' : ''}</span>}
            {alertes.filter(a => a.type === 'critique').length > 0 && alertes.filter(a => a.type === 'important').length > 0 && <span class="mx-1 text-neutral-400">·</span>}
            {alertes.filter(a => a.type === 'important').length > 0 && <span class="text-amber-700 font-medium">{alertes.filter(a => a.type === 'important').length} important{alertes.filter(a => a.type === 'important').length > 1 ? 's' : ''}</span>}
          </p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {alertes.map(a => (
