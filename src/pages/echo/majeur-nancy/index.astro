    decisionLabel: 'Repart',
    histoire: '"restaurant ouvert samedi nancy" → Le Majeur visible → site → horaires peu lisibles, pas de menu ni tarifs directs sur mobile → 2 concurrents avec menus et "formule samedi midi 18€" → choisit un concurrent.',
    localisation: 'Nancy (54)',
    maturite: 'Comparaison',
    contexte: 'Dejeune tot le samedi avant une activite. Compare 3 adresses sur Maps en 5 minutes. Prend la premiere qui lui donne assez d\'infos pour decider.',
    impression: 'Le Majeur a une tres bonne note mais Stephane ne trouve pas rapidement le menu et le tarif — ce qu\'il cherche en 30 secondes. Il passe au suivant.',
    parcours: [
      ['Google Maps', '"restaurant samedi midi nancy" — Le Majeur visible'],
      ['Site', 'Cherche menu + tarif — pas trouve rapidement sur mobile'],
      ['Concurrent', '"Formule samedi midi 2 plats + cafe 18€" + menu visible'],
      ['Decision', 'Choisit le concurrent — information immediate'],
    ] as [string, string][],
    questionCle: 'Qu\'est-ce que je mange et combien ca coute le samedi midi ?',
    reponse: 'Non' as const,
    commentReponse: 'Pas de menu visible, pas de tarif formule midi — informations introuvables en 30 secondes sur mobile.',
    impactVitesse: 'Wix mobile lent + contenu absent = double friction',
    impactConfiance: '4.8★ remarquee mais insuffisant sans info concrete',
    positifs: ['4.8★ visible sur Maps — attire l\'oeil'],
    frictions: ['Menu du jour invisible sur mobile', 'Tarif formule midi introuvable', 'Site lent Wix frustrant'],
    ceQuiFeraitBasculer: 'Un plat du jour + prix en une ligne sur la page d\'accueil. Stephane aurait choisi Le Majeur si l\'information avait ete la en 5 secondes.',
    exp: 3, conf: 7, clarte: 2,
  },
  {
    id: 5,
    name: 'Nathalie',
    age: 52,
    emoji: '👨‍👩‍👧',
    situation: 'Cherche un bistrot de quartier pour un repas de famille (6 personnes)',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Appelle',
    histoire: '"bistrot nancy repas famille" → Le Majeur → 4.8★ 253 avis + depuis 2018 → avis chaleureux → appelle directement.',
    localisation: 'Nancy (54)',
    maturite: 'Comparaison',
    contexte: 'Anniversaire de la belle-mere. Cherche un endroit chaleureux, cuisine maison, table suffisamment grande. Pas de restaurant gastronomique — une vraie table de quartier.',
    impression: 'Les avis decrivent exactement ce qu\'elle cherche : chaleureux, cuisine genereux, accueil familial. La note 4.8 + l\'anciennete depuis 2018 la convainquent sans meme voir le menu.',
    parcours: [
      ['Google Search', '"bistrot nancy ambiance familiale"'],
      ['Maps', '4.8★ sur 253 avis + "bistrot depuis 2018"'],
      ['Avis', 'Lecture des avis : chaleur, genereux, service attentif'],
      ['Contact', 'Appelle pour verifier la disponibilite et reserver pour 6'],
    ] as [string, string][],
    questionCle: 'C\'est un endroit chaleureux et peut-on reserver pour 6 personnes ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Les avis repondent a la chaleur — mais la capacite groupe doit etre verifiee par appel, pas de page groupe/privatisation.',
    impactVitesse: 'Desktop — non bloquant',
    impactConfiance: '4.8★ + 253 avis + depuis 2018 = triple reassurance',
    positifs: ['Note 4.8★ exceptionnelle', 'Ambiance decrite dans les avis', 'Depuis 2018 = stabilite rassurante'],
    frictions: ['Pas de page "groupes/reservations speciales"', 'Doit appeler pour confirmer disponibilite pour 6'],
    ceQuiFeraitBasculer: '',
    exp: 8, conf: 10, clarte: 5,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Page brunch dediee — l\'opportunite SEO non exploitee',
    pourquoi: 'Juliette cherche "brunch nancy dimanche menu" → pas de page brunch → concurrent avec page complete gagne. Le brunch 24€ adulte / 12€ enfant est un produit defini et recherche. "Brunch nancy dimanche" et "brunch nancy samedi" sont des requetes actives avec peu de concurrence optimisee. Clara a du chercher le tarif dans les avis Google au lieu de le trouver sur le site.',
    action: 'Page brunch : tarifs adulte (24€) et enfant (12€) en evidence, horaires brunch (samedi + dimanche), quelques elements du menu du moment, 5-6 photos de la table dressée, mention reservation recommandee ou spontanee. Titre H1 "Brunch Nancy — Le Majeur, samedi et dimanche".',
    impact: 'Capture de "brunch nancy dimanche" et "brunch nancy samedi" — requetes sans page optimisee concurrente',
  },
  {
    titre: 'Mettre en avant "ouvert lundi + dimanche" — differenciateur rare',
    pourquoi: 'Francois cherche specifiquement le lundi — cette information doit etre visible immediatement. A Nancy, les restaurants ouverts le lundi sont rarissimes. "Restaurant ouvert lundi nancy" est une requete sans concurrence directe. Les horaires atypiques (ouvert lundi, ferme mar-mer-jeu) sont une force commerciale, pas une contrainte.',
    action: 'Banniere ou badge en homepage : "Ouvert lundi et dimanche — ferme mardi, mercredi, jeudi". Title SEO : "Le Majeur Nancy — Bistrot ouvert lundi et dimanche". Page "Horaires" claire avec les jours ouverts en evidence. Schema.org OpeningHours structure avec lundi et dimanche explicites.',
    impact: 'Capture unique de "restaurant ouvert lundi nancy" — requete pratiquement sans concurrence',
  },
  {
    titre: 'Schema.org Restaurant + AggregateRating + BrunchMenu',
    pourquoi: '253 avis a 4.8 etoiles non exploites en rich snippets — c\'est la note la plus haute de ce batch. Schema.org Restaurant + AggregateRating (4.8, 253) + OpeningHours (avec lundi + dimanche explicites) + BrunchMenu = etoiles SERP visibles + horaires directs dans Google Knowledge Panel.',
    action: 'Ajouter Schema.org JSON-LD : @type Restaurant, name, address, telephone, openingHours (Mo / Fr / Sa / Su), servesCuisine ("bistrot", "cuisine de saison"), aggregateRating (ratingValue: 4.8, reviewCount: 253), hasMenu (brunch). Sur Wix via panneau SEO avance ou code HTML personnalise.',
    impact: 'Etoiles SERP pour 253 avis 4.8★ — CTR organique +25-40% estime',
  },
];

const ameliorationsUtiles = [
  {
    titre: 'Menu du moment visible — meme partiel',
    detail: 'Stephane n\'a trouve ni menu ni tarif → parti en 30 secondes. Une section simple "Aujourd\'hui : entree X, plat Y, dessert Z — formule 19€" sur la homepage suffit a maintenir les comparateurs. Le menu saisonnier mis a jour chaque semaine = contenu frais pour Google.',
  },
  {
    titre: 'Email de contact visible',
    detail: 'L\'email n\'est pas accessible publiquement. Pour les demandes de groupe, privatisation ou evenements, une adresse email visible sur la page contact evite la friction pour les clients qui ne veulent pas appeler.',
  },
];

const ameliorationsDiscuter = [
  {
    emoji: '🎂',
    titre: 'Page groupes et evenements prives',
    detail: 'Nathalie cherche pour 6 personnes, Francois pour un repas de famille — deux clients qui doivent appeler pour confirmer la capacite. Une page simple "Groupes & evenements" avec la capacite maximale, les conditions de reservation et un formulaire dedie = capture sans appel du segment evenementiel.',
  },
  {
    emoji: '📱',
    titre: 'Instagram actif avec plats du moment',
    detail: 'Un bistrot saisonnier qui change ses plats regulierement a un sujet naturel pour Instagram : photo du plat du jour, de la table dressee le dimanche matin, du brunch. 3 posts par semaine = audience fidelee + vitrine avant/pendant la visite.',
  },
];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Faible', ok: false, detail: 'Wix — ~35 mobile, LCP ~4.8s' },
  { label: 'Securite', verdict: 'Correct', ok: true, detail: 'HTTPS — Wix gere la securite de base' },
  { label: 'SEO', verdict: 'Faible', ok: false, detail: 'Wix SEO limite — pas de page brunch, horaires non structures' },
  { label: 'Donnees structurees', verdict: 'Absent', ok: false, detail: 'Schema.org absent — 4.8★ 253 avis non exploites' },
  { label: 'Partage reseaux', verdict: 'Correct', ok: true, detail: 'OG present (Wix genere)' },
];

const tech = {
  observatory: { grade: 'C+', score: 45, testsOk: 4, testsTotal: 10 },
  pagespdMobile: { performance: 35, accessibility: 72, bestPractices: 68, seo: 65 },
  pagespdDesktop: { performance: 58, accessibility: 76, bestPractices: 72, seo: 70 },
  cwv: { lcp: '~4.8s (Wix JS lourd + images)', inp: '~380ms', cls: '~0.12' },
  headers: [
    { ok: true, h: 'HTTPS' },
    { ok: false, h: 'HSTS (Wix ne garantit pas)' },
    { ok: false, h: 'Content-Security-Policy (absent)' },
    { ok: false, h: 'X-Frame-Options (Wix)' },
    { ok: false, h: 'Permissions-Policy (absent)' },
  ],
  schema: [
    { item: 'Schema.org Restaurant / LocalBusiness', ok: false },
    { item: 'Nom + Adresse + Telephone (NAP)', ok: false },
    { item: 'Avis agreges (4.8★ / 253 avis)', ok: false },
    { item: 'OpeningHours (lundi + dimanche)', ok: false },
    { item: 'BrunchMenu', ok: false },
    { item: 'ServesCuisine (bistrot, saisonnier)', ok: false },
    { item: 'FoundingDate (2018)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'Present (Wix auto)' },
    { item: 'og:description', ok: true, val: 'Present (Wix auto)' },
    { item: 'og:image', ok: true, val: 'Present probable' },
    { item: 'og:type', ok: true, val: 'website' },
  ],
  seo: [
    { item: 'Title tag present', ok: true },
    { item: 'Meta description', ok: true },
    { item: 'HTTPS', ok: true },
    { item: 'Responsive mobile', ok: true },
    { item: 'Page brunch dediee', ok: false },
    { item: '"Ouvert lundi dimanche" en hero', ok: false },
    { item: 'Schema.org Restaurant', ok: false },
    { item: 'Menu visible sur mobile', ok: false },
    { item: 'Tarif formule midi visible', ok: false },
    { item: 'Page groupes / evenements', ok: false },
