---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'majeur-nancy';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const isProspection = true;
const nomProspect = 'Le Majeur Nancy';
const urlSite = 'https://www.lemajeur-nancy.fr';
const dateAudit = '31 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 3,
  nbHesitent: 1,
  nbRepartent: 1,
  conversion: 60,
  experience: 6.8,
  confiance: 9.2,
  clarte: 3.8,
};

const verdictHero = 'Sur 5 visiteurs, 3 reservent — portes par une note exceptionnelle : 4.8 sur 253 avis, ca ne laisse aucun doute. Juliette cherchait le menu brunch complet avec photos : le concurrent qui montre son brunch l\'a capturee. Stephane comparait sur mobile et ne trouvait ni menu ni tarifs : parti en 30 secondes.';

const constat = 'Le Majeur a la meilleure note de ce secteur : 4.8 etoiles sur 253 avis. C\'est un signal de confiance exceptionnel qui convertit les clients motives et les recommandes sans effort. Mais le site Wix est une coquille vide — aucune page brunch malgre un tarif defini et un creneau dimanche tres recherche, pas de menu visible, des horaires atypiques (ouvert lundi, ferme mar-mer-jeu) qui sont un differenciateur rarissime mais totalement invisible sur le site. "Ouvert le dimanche et le lundi" devrait etre en gros titre sur la page d\'accueil — c\'est la requete sans concurrence qui manque.';

const canalData = [
  { canal: 'Google Search (brunch dimanche)', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille (lundi)', nb: 1, convert: 1, rate: 100 },
  { canal: 'IA (brunch menu photos)', nb: 1, convert: 0, rate: 0 },
  { canal: 'Google Maps (samedi midi)', nb: 1, convert: 0, rate: 0 },
  { canal: 'Google Search (bistrot famille)', nb: 1, convert: 1, rate: 100 },
];

const personas = [
  {
    id: 1,
    name: 'Clara',
    age: 31,
    emoji: '🥞',
    situation: 'Cherche un brunch du dimanche a Nancy pour 4 amis',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Reserve',
    histoire: '"brunch nancy dimanche" → Maps → Le Majeur 4.8★ → tarif 24€ dans les avis → site → pas de page brunch mais note excellente → reserve par telephone.',
    localisation: 'Nancy (54)',
    maturite: 'Decision',
    contexte: 'Organise le brunch du groupe ce week-end. Prete a reserver des ce soir si le lieu lui plait.',
    impression: 'La note 4.8 avec 253 avis est parfaite. Le tarif brunch vu dans les avis Google valide le budget. Le site est peu informatif mais la note parle pour elle.',
    parcours: [
      ['Google Search', '"brunch nancy dimanche" — Le Majeur bien place sur Maps'],
      ['Fiche Maps', '4.8★ sur 253 avis — note exceptionnelle'],
      ['Avis Google', 'Tarif 24€ adulte / 12€ enfant mentionne dans les avis'],
      ['Site', 'Peu informatif mais la note a deja convaincu'],
      ['Contact', 'Appelle le 09 51 13 53 94 pour reserver'],
    ] as [string, string][],
    questionCle: 'Y a-t-il un brunch le dimanche et a quel prix ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'L\'info existe dans les avis Google mais pas directement sur le site — friction evitable.',
    impactVitesse: 'Wix mobile ~35 — lent mais decidee motivee',
    impactConfiance: '4.8★ sur 253 avis = note la plus haute du marche local',
    positifs: ['4.8★ sur 253 avis = confiance maximale', 'Brunch dimanche + samedi confirme via avis', 'Tarif trouve dans les avis (24€ adulte)'],
    frictions: ['Pas de page brunch dediee — info dispersee dans les avis', 'Pas de reservation en ligne — doit appeler'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 10, clarte: 4,
  },
  {
    id: 2,
    name: 'Francois',
    age: 44,
    emoji: '🍽️',
    situation: 'Recommande par un ami — cherche pour un diner en famille le lundi',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Appelle',
    histoire: '"Le Majeur Nancy" → site → horaires confirmes (lundi ouvert) → appelle pour reserver pour 6 personnes.',
    localisation: 'Nancy (54)',
    maturite: 'Decision',
    contexte: 'Repas de famille le lundi — seul jour ou toute la famille est disponible. Un ami lui a recommande Le Majeur comme un des rares restaurants ouverts le lundi.',
    impression: 'Confirme que le restaurant est ouvert le lundi — c\'est la seule chose qui comptait. La note conforte le choix.',
    parcours: [
      ['Recherche directe', '"Le Majeur Nancy"'],
      ['Site', 'Horaires — confirme lundi ouvert'],
      ['Contact', 'Appelle pour reserver 6 couverts'],
    ] as [string, string][],
    questionCle: 'Le restaurant est-il ouvert le lundi et peut-il recevoir 6 personnes ?',
    reponse: 'Oui' as const,
    commentReponse: 'Horaires trouves — mais la page groupe/famille n\'existe pas, doit appeler pour confirmer la capacite.',
    impactVitesse: 'Desktop — non bloquant',
    impactConfiance: 'Recommandation + 4.8★ = confiance maximale',
    positifs: ['Horaires confirmes lundi ouvert', '4.8★ confirme la recommandation', 'Accessible par telephone'],
    frictions: ['Pas de page "grand groupe" pour confirmer la capacite sans appeler'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 9, clarte: 5,
  },
  {
    id: 3,
    name: 'Juliette',
    age: 27,
    emoji: '📸',
    situation: 'Cherche un brunch dimanche a Nancy avec menu detaille et photos',
    canal: 'IA (ChatGPT)',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: '"brunch nancy dimanche menu" via ChatGPT → Le Majeur cite → site → cherche page brunch, menu, photos → contenu limite → concurrent avec page brunch complete → hesite.',
    localisation: 'Nancy (54)',
    maturite: 'Decouverte',
    contexte: 'Amatrice de brunch. Compare sur Instagram et Google avant de choisir. La decision se fait sur les photos et le detail du menu.',
    impression: 'La note est excellente mais elle ne peut pas voir ce qu\'elle va manger. Le concurrent qui montre son brunch la convainc plus facilement.',
    parcours: [
      ['ChatGPT', '"brunch nancy dimanche" — Le Majeur cite avec bonne note'],
      ['Site', 'Cherche page brunch, galerie, menu detaille — introuvable'],
      ['Instagram', 'Cherche compte Le Majeur — peu actif ou difficile a trouver'],
      ['Concurrent', 'Page brunch avec photos, "brunch illimite 29€", galerie de tables dressees'],
      ['Decision', 'Hesite — le concurrent montre ce qu\'elle va manger'],
    ] as [string, string][],
    questionCle: 'A quoi ressemble le brunch et qu\'est-ce qu\'il y a dans le menu ?',
    reponse: 'Non' as const,
    commentReponse: 'Pas de page brunch, pas de menu visible, pas de photos de table — impossible de visualiser l\'experience.',
    impactVitesse: 'Wix mobile lent — second frein',
    impactConfiance: '4.8★ rassurant mais insuffisant pour une acheteuse visuelle',
    positifs: ['4.8★ sur 253 avis = signal fort', 'Brunch mentionne dans les avis'],
    frictions: ['Pas de page brunch avec menu et photos', 'Impossible de visualiser l\'experience avant de reserver'],
    ceQuiFeraitBasculer: 'Une page brunch avec 5-6 photos et la liste des elements inclus. Juliette voulait venir — elle avait besoin de voir le brunch pour se decider.',
    exp: 4, conf: 8, clarte: 2,
  },
  {
    id: 4,
    name: 'Stephane',
    age: 38,
    emoji: '📱',
    situation: 'Cherche un restaurant ouvert le samedi midi a Nancy',
    canal: 'Google Maps',
    device: 'Mobile',
