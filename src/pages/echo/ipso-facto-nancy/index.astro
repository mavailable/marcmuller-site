---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'ipso-facto-nancy';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const isProspection = true;
const nomProspect = 'Ipso Facto Nancy';
const urlSite = 'https://www.ipsofactonancy.com';
const dateAudit = '31 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 3,
  nbHesitent: 1,
  nbRepartent: 1,
  conversion: 60,
  experience: 6.5,
  confiance: 8.2,
  clarte: 4.0,
};

const verdictHero = 'Sur 5 visiteurs, 3 appellent — emportes par 340 avis et 27 ans de maison. Anais cherchait une galerie avant/apres pour sa coloration : elle a choisi un concurrent avec des realisations Instagram. Mohamed cherchait un barbier avec sa propre page et des photos de coupes : sans page barbier dediee, le concurrent plus clair a gagne.';

const constat = 'Ipso Facto possede deux atouts de confiance solides : 340 avis a 4.4 etoiles et 27 ans d\'experience dans le quartier. Ces deux signaux convertissent les clients motives et ceux qui viennent sur recommandation. Mais le site est une vitrine sans profondeur — aucune page par prestation, aucune galerie de realisations, aucune page barbier dediee. Dans un secteur ou la preuve visuelle est l\'argument de vente numero 1, l\'absence de galerie avant/apres coute chaque mois des clients comparateurs qui choisissent le concurrent qui montre son travail.';

const canalData = [
  { canal: 'Google Search (balayage)', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille (barbier)', nb: 1, convert: 1, rate: 100 },
  { canal: 'IA (coloration avant/apres)', nb: 1, convert: 0, rate: 0 },
  { canal: 'Google Maps (barbier nancy)', nb: 1, convert: 0, rate: 0 },
  { canal: 'Google Search (coiffeur famille)', nb: 1, convert: 1, rate: 100 },
];

const personas = [
