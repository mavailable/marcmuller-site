---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'toit-ideal';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Toit Ideal';
const urlSite = 'https://www.toitideal.com';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.4,
  confiance: 5.2,
  clarte: 4.8,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'Toit Ideal a un positionnement fort : artisan couvreur-charpentier depuis 1979, fabricant de fermettes en propre, RGE Qualibat. Mais le site ne valorise aucun de ces atouts visuellement. Pas de galerie de chantiers, pas d\'avis Google integres, pas d\'email visible. Les visiteurs en phase Comparaison ne trouvent pas les preuves dont ils ont besoin pour choisir Toit Ideal face a un concurrent mieux documente.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Sylvie',
    age: 54,
    emoji: '🏠',
    situation: 'Proprietaire a Faulquemont, infiltration detectee apres les orages',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Infiltration dans la chambre. Elle cherche "couvreur Faulquemont" et trouve Toit Ideal en premier resultat (page geo dediee). Voit "RGE Qualibat" et "devis gratuit". Trouve le telephone. Appelle.',
    localisation: 'Faulquemont (57380)',
    maturite: 'Decision',
    contexte: 'Infiltration dans la chambre apres les orages. Elle cherche un couvreur local disponible rapidement.',
    impression: 'Toit Ideal en premier resultat sur "couvreur Faulquemont" — page geo bien positionnee. RGE visible.',
    parcours: [
      ['Accueil', 'Voit "devis gratuit" et "47 ans d\'experience". Rassurante.'],
      ['Services', 'Couverture, charpente, zinguerie — tout ce dont elle a besoin'],
      ['Contact', 'Trouve le telephone, appelle directement'],
    ] as [string, string][],
    questionCle: 'Ils peuvent venir vite et sont-ils fiables ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'RGE et anciennete rassurent. Mais pas de mention "urgence", pas d\'horaires, pas de delai d\'intervention.',
    impactVitesse: 'Site Solocal — chargement acceptable sur mobile.',
    impactConfiance: 'RGE Qualibat = signal de confiance fort pour les aides et la qualite.',
    positifs: ['Page geo "couverture-faulquemont" — bon SEO local', 'RGE visible', '47 ans d\'experience mentionnes', 'Telephone accessible'],
    frictions: ['Pas de mention delai d\'intervention', 'Pas d\'horaires', 'Pas d\'email si elle prefere ecrire'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 6, clarte: 6,
  },
  {
    id: 2,
    name: 'Jean-Paul',
    age: 60,
    emoji: '🔧',
    situation: 'Proprietaire a Teting-sur-Nied, recommande par un ami',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Son ami lui a dit "appelle Toit Ideal, ils sont tres serieux et locaux". Il tape l\'URL directement. Confirme l\'identite, voit les 47 ans d\'experience, trouve le telephone. Appelle.',
    localisation: 'Teting-sur-Nied (57385)',
    maturite: 'Decision',
    contexte: 'Son ami vient de faire faire sa toiture par Toit Ideal. Il veut refaire ses gouttières et une partie de couverture.',
    impression: '"Toit Ideal, depuis 1979" — c\'est bien eux. Il cherche le telephone.',
    parcours: [
      ['Accueil', 'Confirme l\'identite et l\'anciennete'],
      ['Contact', 'Trouve le telephone. Appelle.'],
    ] as [string, string][],
    questionCle: 'C\'est bien eux ? J\'ai le bon numero ?',
    reponse: 'Oui' as const,
    commentReponse: 'Nom et telephone facilement trouves. Navigation desktop fluide.',
    impactVitesse: 'Desktop, correct.',
    impactConfiance: 'La recommandation personnelle + l\'anciennete depuis 1979 = confiance maximale.',
    positifs: ['Identite claire', 'Anciennete 1979 = gage de serieux', 'Telephone accessible', 'RGE Qualibat visible'],
    frictions: ['Pas de mention du nom du dirigeant (entreprise anonyme)'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 7, clarte: 7,
  },
  {
    id: 3,
    name: 'Thomas',
    age: 42,
    emoji: '♻️',
    situation: 'Proprietaire a Forbach, veut isolation combles + renovation toiture avec MaPrimeRenov',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Il compare 3 couvreurs RGE. Toit Ideal est RGE mais le site ne detaille pas les aides (MaPrimeRenov, CEE, eco-PTZ). Pas d\'email pour envoyer les photos de son toit. Il remplit le formulaire mais continue a comparer.',
    localisation: 'Forbach (57600)',
    maturite: 'Comparaison',
    contexte: 'Il veut isolation combles + refection toiture. Son conseiller l\'a oriente vers les aides MaPrimeRenov avec un artisan RGE. Budget total : 15 000 €.',
    impression: 'RGE Qualibat visible — c\'est le bon. Mais ou sont les infos sur les aides ?',
    parcours: [
      ['Accueil', 'RGE confirme. Cherche "MaPrimeRenov" ou "aides" — absent'],
      ['Isolation', 'Mention eligibilite aides mais aucun detail'],
      ['Contact', 'Remplit le formulaire Solocal. Aucun email visible. Continue sa recherche.'],
    ] as [string, string][],
    questionCle: 'Combien ca va me couter net apres les aides ?',
    reponse: 'Non' as const,
    commentReponse: 'RGE confirme mais aucun contenu sur les aides, aucune simulation, aucune fourchette.',
    impactVitesse: 'Desktop, correct.',
    impactConfiance: 'RGE et anciennete rassurent mais le manque d\'infos sur les aides fragilise.',
    positifs: ['RGE Qualibat clairement visible', 'Isolation mentionnee comme service', 'Pages geo bien positionnees'],
    frictions: ['Aucun detail sur MaPrimeRenov / CEE', 'Pas d\'email visible', 'Pas de fourchette de prix', 'Aucun temoignage client'],
    ceQuiFeraitBasculer: 'Une section "Vos aides RGE : MaPrimeRenov + CEE" avec montants indicatifs.',
    exp: 5, conf: 5, clarte: 4,
  },
  {
    id: 4,
    name: 'Laura',
    age: 36,
    emoji: '🏗️',
    situation: 'Agente immobiliere a Sarreguemines, cherche couvreur pour expertises avant vente',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle compare 3 couvreurs sur Google Maps. Elle clique sur Toit Ideal depuis la fiche. Le site mentionne "devis gratuit" et RGE. Mais elle cherche des references de chantiers — pas de galerie. Elle bookmarke et continue sa recherche.',
    localisation: 'Sarreguemines (57200)',
    maturite: 'Comparaison',
    contexte: 'Elle a besoin recurrent de couvreurs certifies pour evaluer l\'etat des toitures avant transactions immobilieres.',
    impression: 'RGE + devis gratuit — bien. Mais pas de photos de references pour evaluer le niveau de travail.',
    parcours: [
      ['Accueil', '"Devis gratuit", RGE, 47 ans — bon debut'],
      ['Services', 'Large catalogue de services — positif'],
      ['Galerie', 'Cherche des photos de chantiers termines — absent'],
      ['Contact', 'Pas d\'email visible. Bookmarke et continue sa recherche.'],
    ] as [string, string][],
    questionCle: 'Est-ce qu\'ils font un travail propre et rapide ? Je peux en faire un prestataire regulier ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'L\'anciennete et le RGE rassurent sur les competences, mais sans photos elle ne peut pas evaluer la qualite.',
    impactVitesse: 'Solocal mobile — chargement correct.',
    impactConfiance: 'RGE + 47 ans = credible. Mais l\'absence de galerie laisse un doute.',
    positifs: ['RGE Qualibat', '47 ans d\'experience', 'Zone Sarreguemines clairement couverte', 'Formulaire de contact'],
    frictions: ['Pas de galerie de realisations', 'Pas d\'email direct', 'Aucun temoignage client'],
    ceQuiFeraitBasculer: '5-6 photos de chantiers avant/apres avec localisation.',
    exp: 5, conf: 5, clarte: 4,
  },
  {
    id: 5,
    name: 'Antoine',
    age: 29,
    emoji: '📱',
    situation: 'Locataire a Thionville — hors zone, hors cible',
    canal: 'Reseaux sociaux',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Il a vu Toit Ideal partage sur un groupe Facebook local. Il est locataire, vit a Thionville (40 km). Ne correspond pas a la cible. Il repart rapidement.',
    localisation: 'Thionville (57100) — 40 km, hors zone',
    maturite: 'Decouverte',
    contexte: 'Locataire sans besoin immediat. Tombe sur le site par hasard via un partage Facebook.',
    impression: '"Teting-sur-Nied" — trop loin de Thionville. Il repart.',
    parcours: [
      ['Accueil', 'Voit la zone d\'intervention — Teting, Faulquemont, pas Thionville'],
      ['Quitte', 'Zone trop eloignee, pas locataire'],
    ] as [string, string][],
    questionCle: 'Ils viennent a Thionville ?',
    reponse: 'Non' as const,
    commentReponse: 'Hors zone + hors cible (locataire). Normal.',
    impactVitesse: 'Irrelevant.',
    impactConfiance: 'Non pertinent pour ce profil.',
    positifs: ['La zone est clairement mentionnee — evite une perte de temps'],
    frictions: ['Hors cible — normal'],
    ceQuiFeraitBasculer: 'Rien — profil hors zone.',
    exp: 4, conf: 4, clarte: 4,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Ajouter une galerie de realisations et integrer les avis clients sur le site',
    pourquoi: '2 visiteurs sur 5 hesitent parce qu\'ils ne trouvent pas les preuves visuelles de votre savoir-faire. Vous avez 47 ans de chantiers reussis mais zero photo sur votre site. Laura (agente immo) et Thomas (reno energetique) veulent voir votre travail avant de choisir. Sans galerie, ils vont chez un concurrent qui en a une.',
    action: 'Ajouter dans Solocal : (1) une section "Nos realisations" avec 8-10 photos de chantiers avant/apres avec ville et type de travaux, (2) vos avis Google ou Pages Jaunes integres sur la page d\'accueil avec la note globale visible. Contactez votre gestionnaire Solocal pour configurer ca.',
    impact: '2 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Correcte', ok: true, detail: 'Site Solocal heberge en France — chargement correct.' },
  { label: 'Securite', verdict: 'A ameliorer', ok: false, detail: 'Headers de securite standards manquants (CSP, HSTS).' },
  { label: 'SEO', verdict: 'Bien structure', ok: true, detail: 'Pages geo dediees bien indexees (Faulquemont, Forbach, Sarreguemines).' },
  { label: 'Donnees structurees', verdict: 'Partiel', ok: false, detail: 'Schema RoofingContractor present mais incomplet (sans geo, horaires, avis).' },
  { label: 'Partage reseaux', verdict: 'Absent', ok: false, detail: 'Open Graph absent — partage Facebook/WhatsApp sans apercu.' },
];

const tech = {
  observatory: { grade: 'D', score: 35, testsOk: 4, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'Redirection HTTP vers HTTPS' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (absent)' },
    { ok: false, h: 'Content-Security-Policy (absent)' },
    { ok: false, h: 'X-Frame-Options (absent)' },
    { ok: false, h: 'X-Content-Type-Options (absent)' },
  ],
  schema: [
    { item: 'JSON-LD present (@type RoofingContractor)', ok: true },
    { item: 'name, url, telephone', ok: true },
    { item: 'address (Teting-sur-Nied)', ok: true },
    { item: 'geo (latitude/longitude)', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'aggregateRating', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Absent' },
    { item: 'og:description', ok: false, val: 'Absent' },
    { item: 'og:image', ok: false, val: 'Absent' },
    { item: 'og:url', ok: false, val: 'Absent' },
    { item: 'twitter:card', ok: false, val: 'Absent' },
  ],
  seo: [
    { item: 'H1 unique et pertinent', ok: true },
    { item: 'Pages geo dediees (Faulquemont, Forbach...)', ok: true },
    { item: 'Yoast SEO actif (WordPress)', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'Schema.org RoofingContractor present', ok: true },
    { item: 'Meta description optimisee', ok: false },
    { item: 'Open Graph configure', ok: false },
    { item: 'Canonical', ok: false },
  ],
};
---
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group bg-white rounded-xl overflow-hidden shadow-sm border border-green-200">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]: [string, string]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                  <p class="text-neutral-600">Le site repond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                  <div><p class="font-semibold text-green-700 mb-1.5">Points positifs</p><ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul></div>
                  <div><p class="font-semibold text-amber-700 mb-1.5">Frictions</p><ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul></div>
                </div>
                <div class="flex gap-6 pt-3 border-t border-neutral-100">
                  {[{ label: 'Experience', val: p.exp }, { label: 'Confiance', val: p.conf }, { label: 'Clarte', val: p.clarte }].map(s => {
                    const sColor = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
                    return <div class="text-center"><span class={`block text-lg font-bold ${sColor}`}>{s.val}</span><span class="text-[10px] text-neutral-400">{s.label}</span></div>;
                  })}
                </div>
              </div>
            </div>
