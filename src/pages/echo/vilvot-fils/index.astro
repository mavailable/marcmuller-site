---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'vilvot-fils';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Vilvot et Fils';
const urlSite = 'https://vilvotetfils.fr';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.0,
  confiance: 5.6,
  clarte: 4.8,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'Vilvot & Fils a de vrais atouts : 40 ans d\'experience, triple certification RGE, entreprise familiale reconnue en Moselle. Mais le site souffre de deux manques critiques : aucun numero de telephone visible des l\'accueil, et zero photo de realisations. Pour un plombier-chauffagiste, les visiteurs en urgence ont besoin du numero en 3 secondes — et ceux en phase comparaison veulent voir des chantiers concrets avant d\'appeler.';

const canalData = [
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Bouche-a-oreille', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Nathalie',
    age: 48,
    emoji: '🚰',
    situation: 'Proprietaire a Bertrange, fuite sous evier depuis ce matin',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence fuite. Elle cherche "plombier urgence Bertrange 57". Trouve Vilvot & Fils, scrolle jusqu\'au footer pour trouver le numero, appelle.',
    localisation: 'Bertrange (57310)',
    maturite: 'Decision',
    contexte: 'Fuite sous evier, arrivee d\'eau coupee. Elle cherche un plombier disponible maintenant pour intervenir dans la journee.',
    impression: '"40 ans d\'experience" la rassure. Mais elle cherche un numero immediatement — absent du header.',
    parcours: [
      ['Accueil mobile', '"40 ans d\'experience" OK — cherche un numero → absent du header'],
      ['Scroll footer', 'Trouve le +33 3 82 82 63 15 en bas de page'],
      ['Appelle', 'Elle est en Decision — le numero suffit malgre les frictions'],
    ] as [string, string][],
    questionCle: 'Ils peuvent venir aujourd\'hui ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Numero trouvable mais cache dans le footer. Aucune mention "depannage urgence" ni horaires.',
    impactVitesse: 'Lenteur WordPress sur mobile peut faire partir un visiteur en urgence avant de trouver le numero.',
    impactConfiance: 'Entreprise familiale 40 ans rassurant. Mais pas d\'avis Google integres ni CTA urgence.',
    positifs: ['Numero existant (footer)', 'Entreprise familiale visible', 'Zone Moselle confirmee'],
    frictions: ['Telephone absent du header', 'Pas de CTA urgence en hero', 'Pas d\'horaires d\'ouverture', 'Site lent sur mobile'],
    ceQuiFeraitBasculer: '',
    exp: 5, conf: 6, clarte: 5,
  },
  {
    id: 2,
    name: 'David',
    age: 36,
    emoji: '🏠',
    situation: 'Proprietaire a Yutz, cherche installation pompe a chaleur air/eau',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Il a 2 devis, cherche un 3e artisan sur Maps. Vilvot & Fils bien place. Confirme la certification QualiPAC, remplit le formulaire.',
    localisation: 'Yutz (57970)',
    maturite: 'Decision',
    contexte: 'Il compare 3 artisans pour l\'installation d\'une PAC air/eau. Il arrive depuis la fiche Google Maps apres avoir vu la certification RGE.',
    impression: 'Arrive convaincu depuis Maps. Cherche a confirmer la competence PAC et la zone Thionville.',
    parcours: [
      ['Accueil', '"Chauffage, sanitaire, climatisation" OK — QualiPAC apercu'],
      ['Page Chauffage', 'PAC mentionnee, zone Thionville confirmee, certifications visibles'],
      ['Contact', 'Remplit le formulaire — sujet "Chauffage"'],
    ] as [string, string][],
    questionCle: 'Ils font vraiment les PAC ? Ils interviennent a Yutz ?',
    reponse: 'Oui' as const,
    commentReponse: 'Certification QualiPAC visible, zone Thionville/Moselle confirmee. Les certifications repondent a sa question.',
    impactVitesse: 'Acceptable — il est en Decision et prend le temps de chercher.',
    impactConfiance: 'Triple certification RGE = credibilite forte pour un chantier a 10 000€+.',
    positifs: ['Certification QualiPAC visible', 'Zone Thionville confirmee', 'Entreprise familiale rassure pour gros chantier', 'Acces aides MaPrimeRenov\''],
    frictions: ['Pas de galerie realisations PAC', 'Pas de fourchette de prix', 'Pas d\'avis clients integres'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 7, clarte: 6,
  },
  {
    id: 3,
    name: 'Sandrine',
    age: 42,
    emoji: '🔍',
    situation: 'Proprietaire a Thionville, compare 3 plombiers pour renovation salle de bain',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Budget 8 000€, elle prend le temps de comparer. Cherche des photos de realisations — absentes. Finit par envoyer un formulaire mais moins convaincue que les concurrents avec galerie.',
    localisation: 'Thionville (57100)',
    maturite: 'Comparaison',
    contexte: 'Elle compare 3 artisans pour une renovation complete de salle de bain. Elle veut voir des realisations concretes avant d\'appeler.',
    impression: 'Site propre, 40 ans d\'experience, partenaire Kinedo — credible. Mais elle cherche immediatement une galerie.',
    parcours: [
      ['Accueil', 'Entreprise familiale, Kinedo mentionne — correct'],
      ['Page Sanitaire', 'Services OK, personnalisation mentionnee, mais 0 photo'],
      ['Navigation', 'Cherche "Realisations" ou "Galerie" → absent du menu'],
      ['Contact', 'Hesite — envoie un formulaire mais compare avec concurrent qui a des photos'],
    ] as [string, string][],
    questionCle: 'Ils ont deja renove des salles de bain dans mon style ? Je peux voir ?',
    reponse: 'Non' as const,
    commentReponse: 'Zero photo de realisation, aucune galerie, pas de page dediee. Partenariat Kinedo mentionne mais sans visuel.',
    impactVitesse: 'Acceptable sur desktop.',
    impactConfiance: 'Kinedo rassurant, 40 ans d\'experience rassure. Mais l\'absence de photos cree un doute sur la qualite de finition.',
    positifs: ['Partenariat Kinedo (marque reconnue)', 'Entreprise familiale (confiance)', 'Certifications RGE'],
    frictions: ['Aucune photo de chantier', 'Pas de page realisations', 'Pas de prix indicatifs', 'Site WordPress lent'],
    ceQuiFeraitBasculer: '5-6 photos de salles de bain renovees avec type de materiaux Kinedo et localisation (ville).',
    exp: 5, conf: 5, clarte: 4,
  },
  {
    id: 4,
    name: 'Eric',
    age: 55,
    emoji: '🏚️',
    situation: 'Proprietaire a Florange, veut remplacer sa chaudiere fuel, decouvre MaPrimeRenov\'',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Un collegue lui a cite Vilvot & Fils. Il tape le nom directement. Certifications RGE visibles — rassurant. Mais il cherche un guide sur MaPrimeRenov\' et ne le trouve pas. Quitte sans contacter.',
    localisation: 'Florange (57190)',
    maturite: 'Decouverte',
    contexte: 'Il veut remplacer sa vieille chaudiere fuel par une PAC mais ne sait pas combien il peut toucher en aides. Il est en phase d\'information.',
    impression: '"Vilvot & Fils" — c\'est bien eux. Triple certification RGE visible = professionnel. Mais il cherche des infos sur les aides.',
    parcours: [
      ['Accueil', 'Identite confirmee, RGE visible, MaPrimeRenov\' mentionnee'],
      ['Page Chauffage', 'PAC mentionnee, aides evoques vaguement — pas de guide pratique'],
      ['Qui sommes-nous', 'Certifications detaillees — rassurant. Mais toujours pas d\'info sur les montants d\'aides'],
      ['Quitte', 'Repart chercher les montants sur le site de l\'ANAH'],
    ] as [string, string][],
    questionCle: 'Combien je peux toucher avec MaPrimeRenov\' ? Ils m\'aident a monter le dossier ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Certifications RGE confirmees (deblocage des aides) mais aucun guide, aucun montant indicatif, aucune demarche expliquee.',
    impactVitesse: 'OK — il prend son temps, pas d\'urgence.',
    impactConfiance: 'Triple RGE (Qualibat + Qualigaz + QualiPAC) = tres rassurant pour ce profil averti.',
    positifs: ['Triple certification RGE clairement expliquee', 'Entreprise familiale et longevite (40 ans)', 'Acces aides confirme'],
    frictions: ['Pas de guide MaPrimeRenov\' avec montants', 'Pas de simulateur d\'aides', 'Pas de numero en header', 'Pas d\'horaires'],
    ceQuiFeraitBasculer: 'Une section ou page "Aides financieres" avec montants indicatifs et demarche expliquee etape par etape.',
    exp: 5, conf: 6, clarte: 4,
  },
  {
    id: 5,
    name: 'Aurelien',
    age: 29,
    emoji: '🏢',
    situation: 'Gestionnaire technique residence locative Metz — hors zone principale',
    canal: 'Reseaux sociaux',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Il clique sur un post Facebook de Vilvot & Fils. Cherche un plombier pour entretien annuel de 12 logements. Pas de mention B2B, pas de contrats d\'entretien, Metz hors zone principale. Il passe au suivant.',
    localisation: 'Metz (57000)',
    maturite: 'Comparaison',
    contexte: 'Il gere 12 logements locatifs et cherche un prestataire pour les entretiens annuels chaudiere. Il decouvre Vilvot & Fils via Facebook.',
    impression: 'Site artisan local — visuellement OK mais pas configure pour les gestionnaires de parc.',
    parcours: [
      ['Accueil', '"Pere et fils" — PME locale, pas l\'echelle d\'un parc de 12 logements'],
      ['Navigation', 'Cherche "Contrats", "Pro", "Copropriete" → absent'],
      ['Contact', 'Formulaire generique sans option "professionnel". Metz non mis en avant. Quitte.'],
    ] as [string, string][],
    questionCle: 'Ils font des contrats d\'entretien pour parc locatif ? Ils interviennent a Metz ?',
    reponse: 'Non' as const,
    commentReponse: 'Pas de mention prestations B2B, pas de contrats multi-logements, formulaire generique. Metz est cite mais en dernier dans la zone.',
    impactVitesse: 'Lenteur mobile = frustration supplementaire pour ce profil qui compare vite.',
    impactConfiance: 'Certifications RGE crees une confiance technique mais hors sujet pour ce besoin contractuel.',
    positifs: ['Zone Moselle mentionnee (Metz inclus)', 'Certifications pro visibles', 'Entreprise etablie'],
    frictions: ['Pas de ciblage B2B / gestionnaires', 'Pas de contrats d\'entretien mentionnes', 'Formulaire generique', 'Site lent sur mobile'],
    ceQuiFeraitBasculer: 'C\'est hors cible — Vilvot & Fils est oriente particuliers, ce qui est normal pour cette zone.',
    exp: 4, conf: 5, clarte: 4,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Afficher le numero de telephone en header — visible en 3 secondes sur mobile',
    pourquoi: '4 visiteurs sur 5 ont cherche le numero de telephone. Sur mobile (60-70% du trafic artisan), le numero est cache dans le footer. Pour un plombier-chauffagiste, une part critique des appels vient de personnes en urgence : fuite, panne de chauffage en hiver. Si le numero n\'est pas visible immediatement, le visiteur rappelle le concurrent suivant.',
    action: 'Ajouter un bandeau sticky en haut de page avec le +33 3 82 82 63 15 cliquable sur mobile, accompagne de "Depannage Moselle" ou "Urgence — on repond". Sur desktop, numero dans le header a cote du logo. Cout : 1-2h de developpement WordPress.',
    impact: '4 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A verifier', ok: false, detail: 'Quota API epuise — estimation : ~45-55 mobile (mauvais). WordPress + GTM + reCAPTCHA.' },
  { label: 'Securite', verdict: 'Grade D-', ok: false, detail: 'Score 25/100. CSP, HSTS, X-Frame-Options manquants.' },
  { label: 'SEO', verdict: 'Incomplet', ok: false, detail: 'Robots.txt OK, sitemap present. Canonical absent, title faible.' },
  { label: 'Donnees structurees', verdict: 'Partiel', ok: false, detail: 'WebSite + Organization OK. LocalBusiness/Plumber absent — penalite SEO local.' },
  { label: 'Partage reseaux', verdict: 'Non configure', ok: false, detail: 'Balises Open Graph non detectees. Partage = apercu vide.' },
];

const tech = {
  observatory: { grade: 'D-', score: 25, testsOk: 5, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible (estime : 3-5s)', inp: 'Non disponible (estime : 250-400ms)', cls: 'Non disponible (estime : 0.1-0.2)' },
  headers: [
    { ok: true, h: 'Redirection HTTP vers HTTPS' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (absent)' },
    { ok: false, h: 'Content-Security-Policy (absent — risque XSS)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking)' },
    { ok: false, h: 'X-Content-Type-Options (absent)' },
    { ok: false, h: 'Referrer-Policy (absent)' },
  ],
  schema: [
    { item: 'JSON-LD / Schema.org present', ok: true },
    { item: '@type WebSite + Organization', ok: true },
    { item: '@type LocalBusiness ou Plumber (absent)', ok: false },
    { item: 'address + geo (absents)', ok: false },
    { item: 'telephone dans Schema.org (absent)', ok: false },
    { item: 'openingHours (absent)', ok: false },
    { item: 'aggregateRating (absent)', ok: false },
    { item: 'sameAs complet (absent)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Non detecte' },
    { item: 'og:description', ok: false, val: 'Non detecte' },
    { item: 'og:image', ok: false, val: 'Non detecte' },
    { item: 'og:url', ok: false, val: 'Non detecte' },
    { item: 'twitter:card', ok: false, val: 'Non detecte' },
  ],
  seo: [
    { item: 'H1 unique present', ok: true },
    { item: 'Meta description presente', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'robots.txt accessible (Yoast)', ok: true },
    { item: 'sitemap_index.xml present', ok: true },
    { item: 'Canonical absent (risque contenu duplique)', ok: false },
    { item: 'Schema.org LocalBusiness absent', ok: false },
    { item: 'Open Graph configure', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group bg-white rounded-xl overflow-hidden shadow-sm border border-green-200">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]: [string, string]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
