---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'electricite-port';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Port C. Electricite';
const urlSite = 'https://www.electricite-port.com';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.2,
  confiance: 5.4,
  clarte: 5.4,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'Port C. Electricite a de vrais atouts : 30 ans d\'experience, double competence courant fort et domotique, membre du reseau Plus que PRO. Mais le site souffre d\'un probleme invisible et pourtant critique : seulement 2 avis, tous de juillet 2022. Pour un visiteur en phase Comparaison, cette stagnation ressemble a une entreprise qui ne travaille plus. 3 visiteurs sur 5 ont ete freines par cette absence de preuves recentes.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Jean-Marc',
    age: 57,
    emoji: '⚡',
    situation: 'Proprietaire a Sarralbe, tableau electrique en panne depuis hier soir',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Panne electrique urgente. Il cherche "electricien Sarralbe urgent". Voit Port C. Electricite, reconnait l\'adresse locale, trouve le 06 et appelle dans la minute.',
    localisation: 'Sarralbe (57430)',
    maturite: 'Decision',
    contexte: 'Son tableau a disjoncte hier soir, rien ne repart. Il cherche un electricien disponible rapidement, de preference local.',
    impression: 'Le H1 "Electricien proche Sarreguemines" et l\'adresse Sarralbe : c\'est le bon. Il cherche le telephone.',
    parcours: [
      ['Accueil', '"Electricien proche Sarreguemines" — zone confirmee, cherche le numero'],
      ['Header', 'Telephone 06 21 50 10 04 trouve — clique et appelle directement'],
    ] as [string, string][],
    questionCle: 'Il est disponible aujourd\'hui ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le telephone est present et accessible. Mais aucune mention de disponibilite urgence ou delai d\'intervention n\'est affichee.',
    impactVitesse: 'Site sur Cloudflare : charge assez vite. Pas de blocage technique.',
    impactConfiance: '4,5/5 visible via Plus que PRO — mais seulement 2 avis. Il ne remarque pas le nombre.',
    positifs: ['Telephone accessible depuis le header', 'Zone Sarralbe confirmee immediatement', 'Label Plus que PRO visible'],
    frictions: ['Aucune mention "intervention rapide" ou "urgence"', 'Pas d\'horaires visibles', 'Seulement 2 avis — fragilise la confiance'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 6, clarte: 6,
  },
  {
    id: 2,
    name: 'Claudine',
    age: 67,
    emoji: '🏡',
    situation: 'Retraitee a Sarralbe, recommandee par son voisin pour installation stores electriques',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Son voisin lui a parle de Christophe PORT. Elle tape le nom sur Google, trouve le site, confirme que c\'est bien lui et note le numero pour appeler le lendemain matin.',
    localisation: 'Sarralbe (57430)',
    maturite: 'Decision',
    contexte: 'Elle veut faire installer des volets et stores electriques. Son voisin lui a recommande Christophe PORT qui lui a refait son tableau.',
    impression: '"Port Christophe Electricite, Sarralbe" — c\'est bien lui. Elle cherche confirmation et telephone.',
    parcours: [
      ['Accueil', '"Christophe PORT", "Sarralbe" — exactement ce que son voisin a dit'],
      ['Services', 'Lit "stores et volets electriques" — parfait pour son projet'],
      ['Contact', 'Note le telephone. Appellera demain matin.'],
    ] as [string, string][],
    questionCle: 'C\'est bien lui qui fait les stores et volets electriques ?',
    reponse: 'Oui' as const,
    commentReponse: 'Le service "motorisation, stores et volets electriques" est liste clairement. Identite confirmee.',
    impactVitesse: 'Bonne sur desktop via Cloudflare.',
    impactConfiance: 'La recommandation personnelle prime tout. Le site confirme simplement.',
    positifs: ['Nom et ville immediatement visibles', 'Service volets electriques liste', 'Telephone accessible', 'Ton serieux et professionnel'],
    frictions: ['Navigation dense — elle doit scroller pour les services specifiques', 'Horaires d\'appel non visibles'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 8, clarte: 7,
  },
  {
    id: 3,
    name: 'Nathalie',
    age: 42,
    emoji: '🏠',
    situation: 'Proprietaire a Sarreguemines, cherche electricien pour installation alarme et domotique',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle compare 3 electriciens. Port C. Electricite a l\'air competent en domotique mais seulement 2 avis de 2022. Elle continue a comparer avant de contacter.',
    localisation: 'Sarreguemines (57200)',
    maturite: 'Comparaison',
    contexte: 'Elle veut faire installer une alarme connectee et des thermostats intelligents. Budget : 3 000-4 000 €. Elle compare 3 artisans locaux.',
    impression: 'Site propre. Double competence courant fort et faible — exactement ce qu\'elle cherche. Elle veut voir des preuves recentes.',
    parcours: [
      ['Accueil', 'Competences courant fort et faible confirmees. Interesse.'],
      ['Securite-Domotique', 'Page dediee alarmes et domotique — parfait. Mais pas de photos de chantiers.'],
      ['Avis', 'Voit "4,5/5" — bien. Puis voit "2 avis". Dernier : juillet 2022. Doute.'],
      ['Contact', 'Formulaire sans email visible. Decide de comparer encore.'],
    ] as [string, string][],
    questionCle: 'Il fait vraiment de la domotique recente ? Ses installations sont a jour ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Page domotique presente et coherente. Mais seulement 2 avis de 2022 creent un doute sur l\'activite recente.',
    impactVitesse: 'Acceptable sur desktop.',
    impactConfiance: '2 avis anciens = signal negatif fort pour un profil Comparaison avec budget consequent.',
    positifs: ['Page securite-domotique bien detaillee', 'Membre Plus que PRO rassure', '30 ans d\'experience mentionnes'],
    frictions: ['Seulement 2 avis de juillet 2022 — stagnation visible', 'Pas de photos de realisations domotique', 'Aucun email pour envoyer ses specs', 'Prix et delais non mentionnes'],
    ceQuiFeraitBasculer: 'Une dizaine d\'avis recents (2024-2026) et 2-3 photos de chantiers domotique avec equipements installes.',
    exp: 5, conf: 4, clarte: 5,
  },
  {
    id: 4,
    name: 'Thierry',
    age: 49,
    emoji: '🔌',
    situation: 'Proprietaire a Bitche, cherche electricien pour refection complete tableau + VMC + clim',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Il arrive depuis Google Maps (4,5/5). Voit une note rassurante. Clique sur le site pour verifier les references. Voit 2 avis de 2022 et prefere ne pas risquer pour un chantier de 10 000 €.',
    localisation: 'Bitche (57230)',
    maturite: 'Comparaison',
    contexte: 'Il refait entierement son installation electrique : nouveau tableau, VMC double flux, climatisation. Budget : 8 000-12 000 €. Il veut un electricien fiable.',
    impression: 'Il arrive depuis Maps avec confiance. Le site doit confirmer les references pour un gros chantier.',
    parcours: [
      ['Accueil mobile', 'Sarralbe — dans la zone 25 km. 30 ans d\'experience : rassure.'],
      ['Services', 'Climatisation et VMC listes — bien. Pas de photos de chantiers illustres.'],
      ['Avis', '4,5/5 sur 2 avis de juillet 2022. Pour 10 000 €, insuffisant.'],
      ['Quitte', 'Retourne sur Maps, regarde un concurrent avec plus d\'avis recents.'],
    ] as [string, string][],
    questionCle: 'Il a deja gere des chantiers de cette ampleur ? Il est disponible ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucun chantier illustre, aucune reference de renovation complete. 2 avis de 2022 ne prouvent pas l\'activite recente.',
    impactVitesse: 'Cloudflare aide, site acceptable sur mobile.',
    impactConfiance: 'Le score Maps rassure en theorie. Mais seulement 2 avis creent une zone grise pour un gros budget.',
    positifs: ['30 ans d\'experience credibilisant', 'VMC et clim listes explicitement', 'Zone Bitche incluse dans le rayon'],
    frictions: ['Seulement 2 avis depuis 2022 — doute sur l\'activite actuelle', 'Pas de chantiers references pour des projets de grande ampleur', 'Navigation mobile dense', 'Aucune info sur les delais'],
    ceQuiFeraitBasculer: 'Minimum 10 avis recents (2024-2025) et 1 exemple de renovation complete avec description.',
    exp: 4, conf: 5, clarte: 4,
  },
  {
    id: 5,
    name: 'Maxime',
    age: 31,
    emoji: '🏢',
    situation: 'Gerant de PME a Forbach, cherche electricien pour cablage VDI et videosurveillance de bureaux',
    canal: 'Reseaux sociaux',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Tombe sur Port C. Electricite via LinkedIn. Le site est oriente particuliers, sans reference B2B, sans SIRET visible, sans email professionnel. Il passe au suivant.',
    localisation: 'Forbach (57600)',
    maturite: 'Decouverte',
    contexte: 'Il equipe ses nouveaux bureaux : cablage reseau VDI, cameras, alarme. Budget : 5 000-7 000 €. Il cherche un electricien qualifie pour une installation professionnelle.',
    impression: 'Site clair mais oriente particuliers. Il cherche immediatement les references B2B et les certifications.',
    parcours: [
      ['Accueil', 'Site particuliers. Cherche section "entreprises" dans la navigation.'],
      ['Navigation', '"Entreprises" mentionne mais aucune page ni reference B2B dedicee.'],
      ['Contact', 'Pas de SIRET, pas d\'email professionnel, formulaire generique. Quitte.'],
    ] as [string, string][],
    questionCle: 'Il a deja cable des bureaux professionnels ? Il peut fournir une attestation d\'assurance ?',
    reponse: 'Non' as const,
    commentReponse: 'Mention "entreprises" dans la navigation mais aucune page, aucune reference, aucun chantier pro illustre. SIRET et assurance absents.',
    impactVitesse: 'Sans objet.',
    impactConfiance: 'Absence de SIRET et d\'email professionnel : signal dirimant pour un acheteur B2B.',
    positifs: ['Competence VDI et videosurveillance clairement mentionnee', 'Zone Forbach incluse dans le rayon d\'intervention'],
    frictions: ['Aucune reference B2B illustree', 'SIRET non visible', 'Pas d\'email professionnel', 'Pas de certification Qualifelec ou equivalent'],
    ceQuiFeraitBasculer: 'C\'est hors cible — Port C. Electricite est positionne particuliers, ce qui est coherent.',
    exp: 4, conf: 4, clarte: 5,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Solliciter activement de nouveaux avis Google',
    pourquoi: '3 visiteurs sur 5 ont ete freines par la stagnation des avis : seulement 2 avis, tous de juillet 2022. Pour un visiteur qui compare 3 electriciens, cette date envoie un signal fort : "Cette entreprise ne travaille plus — ou ses clients ne sont plus satisfaits." La note 4,5/5 est excellente mais elle ne compte pas si le volume ne suit pas.',
    action: 'Envoyer un SMS simple apres chaque intervention : "Si vous etes satisfait, un avis Google m\'aiderait beaucoup. Voici le lien direct : [lien GBP]". Objectif : 10 avis en 3 mois, 20+ avis d\'ici fin 2026. C\'est le levier numero 1 pour passer de 40% a 60%+ de conversion chez les visiteurs en phase Comparaison.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A estimer', ok: false, detail: 'Quota API epuise — CDN Cloudflare devrait aider. Tester sur pagespeed.web.dev.' },
  { label: 'Securite', verdict: 'A ameliorer', ok: false, detail: 'Grade C (55/100) — Content-Security-Policy manquant. Cloudflare protege les bases.' },
  { label: 'SEO', verdict: 'A completer', ok: false, detail: 'robots.txt absent (404), sitemap date de juillet 2024 (9 mois de retard), canonical absent.' },
  { label: 'Donnees structurees', verdict: 'Partiel', ok: false, detail: 'JSON-LD present mais type "LocalBusiness" generique — devrait etre "Electrician" pour le SEO local.' },
  { label: 'Partage reseaux', verdict: 'Incomplet', ok: false, detail: 'og:image present mais og:url, og:type et twitter:card absents.' },
];

const tech = {
  observatory: { grade: 'C', score: 55, testsOk: 8, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non mesure (quota API epuise)', inp: 'Non mesure', cls: 'Non mesure' },
  headers: [
    { ok: true, h: 'HTTPS force via Cloudflare' },
    { ok: true, h: 'Strict-Transport-Security (HSTS) via Cloudflare' },
    { ok: true, h: 'X-Content-Type-Options: nosniff' },
    { ok: true, h: 'X-Frame-Options: SAMEORIGIN' },
    { ok: true, h: 'Permissions-Policy configure' },
    { ok: true, h: 'Referrer-Policy: same-origin' },
    { ok: false, h: 'Content-Security-Policy (CSP) — absent : risque XSS' },
    { ok: false, h: 'Subresource Integrity (SRI) — a verifier' },
  ],
  schema: [
    { item: 'JSON-LD / Schema.org present', ok: true },
    { item: '@type specifique "Electrician" (actuellement LocalBusiness generique)', ok: false },
    { item: 'name, url, telephone, address', ok: true },
    { item: 'aggregateRating (4,5/5 sur 2 avis)', ok: true },
    { item: 'geo (latitude/longitude)', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'image / logo dans JSON-LD', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'Present (via schema.org)' },
    { item: 'og:description', ok: false, val: 'Non detecte' },
    { item: 'og:image', ok: true, val: 'ogImage.jpg present' },
    { item: 'og:url', ok: false, val: 'Non detecte' },
    { item: 'og:type', ok: false, val: 'Non detecte' },
    { item: 'twitter:card', ok: false, val: 'Non detecte' },
  ],
  seo: [
    { item: 'H1 unique ("Electricien proche Sarreguemines")', ok: true },
    { item: 'Hierarchie H1 > H2 > H3 coherente', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'Blog actif (1 article/mois depuis novembre 2025)', ok: true },
    { item: 'robots.txt accessible', ok: false },
    { item: 'sitemap.xml a jour (juillet 2024 — 9 mois de retard)', ok: false },
    { item: 'Meta description confirmee', ok: false },
    { item: 'Images avec attribut alt (partiel)', ok: false },
    { item: 'Canonical configure', ok: false },
    { item: 'Open Graph complet', ok: false },
  ],
};
---
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group bg-white rounded-xl overflow-hidden shadow-sm border border-green-200">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]: [string, string]) => (
