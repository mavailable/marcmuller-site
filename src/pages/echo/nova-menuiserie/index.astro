---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'nova-menuiserie';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Nova Menuiserie';
const urlSite = 'https://www.nova-menuiserie.com';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 26 50 59 89';
const marcTelLink = 'tel:+33626505989';
const marcWhatsApp = 'https://wa.me/33626505989?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 1,
  nbRepartent: 2,
  conversion: 40,
  experience: 5.6,
  confiance: 6.8,
  clarte: 4.6,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 1 hesite. 2 repartent sans rien faire.';

const constat = 'Votre note 4,9/5 sur 115 avis fait le travail pour ceux qui vous connaissent deja. Mais ceux qui vous decouvrent via Google partent faute de photos de realisations et d\'informations concretes — ils ne savent pas a quoi ressemble votre travail avant d\'appeler.';

const canalData = [
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Instagram', nb: 1, convert: 0, rate: 0 },
  { canal: 'Google Search', nb: 2, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Sylvie',
    age: 52,
    emoji: '🍳',
    situation: 'Proprietaire a Briey, refait sa cuisine, credit travaux en poche',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Les 115 avis verifies la rassurent suffisamment pour decrocher le telephone, malgre l\'absence de photos et de prix.',
    localisation: 'Briey (54) — 12 km',
    maturite: 'Comparaison',
    contexte: 'Elle a deux devis en main et cherche un troisieme artisan. Elle voit Nova sur Maps avec 4,9/5 et 115 avis. Elle clique sur le site pour valider avant d\'appeler.',
    impression: 'Le badge 4,9/5 et 115 avis saute aux yeux en 3 secondes. Le design est propre. Mais elle cherche immediatement des photos de cuisines.',
    parcours: [
      ['Accueil', 'Badge avis visible — signal fort. Cherche une galerie de photos : introuvable.'],
      ['Nos prestations', 'Liste des services claire. Cuisines, dressings, salles de bains. Mais zero photo de realisation.'],
      ['Avis clients', 'Lit 4 temoignages. Les villes (Jarny, Metz, Laxou) la rassurent sur la proximite.'],
      ['Contact', 'Voit trois numeros. Pas d\'email sur cette page. Appelle le 03 82 46 57 23.'],
    ] as [string, string][],
    questionCle: 'Est-ce qu\'ils font le genre de cuisine que je veux, et dans quel budget ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Les services sont listes mais aucune photo de realisation, aucun prix. Elle doit appeler pour tout savoir.',
    impactVitesse: 'Site Cloudflare, chargement correct sur mobile.',
    impactConfiance: 'Les 115 avis verifies Plus que PRO compensent le manque de galerie photos.',
    positifs: ['Badge 4,9/5 / 115 avis immediatement visible', 'Temoignages avec noms de villes reconnaissables', 'Trois numeros dont un direct (Cyrille Bidenbach)'],
    frictions: ['Aucune photo de realisation cuisine visible', 'Aucun tarif indicatif', 'Email non affiche sur la page contact'],
    ceQuiFeraitBasculer: 'Une galerie de 6 photos de cuisines realisees aurait confirme son choix sans qu\'elle ait besoin d\'appeler.',
    exp: 6, conf: 8, clarte: 5,
  },
  {
    id: 2,
    name: 'Kevin',
    age: 31,
    emoji: '🛠️',
    situation: 'Primo-accedant a Metz, budget serre, cherche un menuisier pour un dressing',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Sans prix ni zone d\'intervention claire, il repart vers un concurrent qui affiche au moins une fourchette de tarif.',
    localisation: 'Metz (57) — 35 km',
    maturite: 'Decouverte',
    contexte: 'Vient d\'acheter une maison. Cherche ses premiers devis via Google. N\'a pas encore d\'idee des prix du sur mesure.',
    impression: 'Design correct mais generique. Pas de prix visible. "C\'est loin Jarny de Metz ca ?"',
    parcours: [
      ['Accueil', 'Comprend que c\'est un menuisier a Jarny. Distance percue comme un frein.'],
      ['Nos prestations', 'Voit les dressings dans la gamme. Zero indication de prix.'],
      ['Avis clients', 'Quelques villes notees (Metz, Pont-a-Mousson). Rassurance partielle sur la zone.'],
      ['Contact', 'Uniquement des numeros de telephone. Pas d\'email. Trop engageant sans savoir le budget.'],
    ] as [string, string][],
    questionCle: 'Combien ca coute un dressing sur mesure et est-ce qu\'ils viennent jusqu\'a Metz ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucun prix, zone d\'intervention non precisee. Deux blocages redhibitoires pour un visiteur en phase decouverte.',
    impactVitesse: 'Chargement OK sur mobile.',
    impactConfiance: 'Les avis rassurent mais sans prix, le niveau de confiance ne suffit pas pour appeler un inconnu.',
    positifs: ['Note 4,9/5 visible', 'Quelques villes clients dans les avis (Metz presente)'],
    frictions: ['Aucun prix ni fourchette', 'Zone d\'intervention non precisee', 'Distance percue (Jarny = inconnu)', 'Email non affiche — appeler trop engageant'],
    ceQuiFeraitBasculer: 'Une fourchette indicative ("dressing a partir de X euros") + mention de la zone (Metz - Moselle) aurait declenche un contact.',
    exp: 5, conf: 5, clarte: 3,
  },
  {
    id: 3,
    name: 'Patricia',
    age: 47,
    emoji: '🏢',
    situation: 'Syndic de copropriete en Moselle, cherche un artisan pour renovation parties communes',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'La recommandation d\'un confrere + les avis verifies la convainquent. Elle finit par trouver l\'email dans les mentions legales et envoie sa demande.',
    localisation: 'Thionville (57) — 40 km',
    maturite: 'Decision',
    contexte: 'Un collegue syndic lui a recommande Cyrille Bidenbach. Elle cherche le site pour confirmer et trouver un email professionnel.',
    impression: 'Site lisible en desktop. Les trois numeros suggerent une structure avec plusieurs interlocuteurs. Cherche un email.',
    parcours: [
      ['Accueil', 'Confirme que c\'est le bon site. Les avis 4,9/5 rassurent.'],
      ['Contact', 'Voit les trois numeros. Cherche un email professionnel. Non affiche sur cette page.'],
      ['Mentions legales', 'Trouve contact@nova-menuiserie.com. Satisfaction mitigee : "C\'est pas logique."'],
      ['Envoi email', 'Envoie sa demande de devis pour renovation de parties communes.'],
    ] as [string, string][],
    questionCle: 'Comment les contacter par email pour une demande de devis pro ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'L\'email existe mais est cache dans les mentions legales. La page contact ne le montre pas.',
    impactVitesse: 'Desktop, pas de probleme.',
    impactConfiance: 'Recommandation personnelle + avis = confiance tres elevee.',
    positifs: ['Trois interlocuteurs identifiables', 'Avis verifies nombreux', 'Mentions legales completes (SIRET, capital social)'],
    frictions: ['Email absent de la page contact', 'Pas de section Professionnels / Partenaires', 'Formulaire oriente particuliers'],
    ceQuiFeraitBasculer: 'Elle a converti, mais afficher l\'email directement sur la page contact aurait reduit son parcours de 3 etapes.',
    exp: 7, conf: 9, clarte: 6,
  },
  {
    id: 4,
    name: 'Fabrice',
    age: 38,
    emoji: '🖌️',
    situation: 'Artisan peintre a Nancy, cherche un menuisier partenaire a recommander a ses clients',
    canal: 'Instagram',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Les avis sont un bon argument mais le site ne lui donne pas assez d\'elements visuels et humains pour recommander avec conviction.',
    localisation: 'Nancy (54) — 45 km',
    maturite: 'Comparaison',
    contexte: 'A vu des photos de realisations sur Instagram. Va sur le site pour verifier le serieux avant de parler de Nova a ses clients.',
    impression: 'Design propre mais generique (CMS tiers). "Ca manque un peu d\'authenticite par rapport aux photos Insta."',
    parcours: [
      ['Accueil', 'Design generique mais avis 4,9/5 rassurants.'],
      ['Nos prestations', 'Gamme claire et complete. Pas de photos des realisations sur le site.'],
      ['Avis clients', 'Lit 3 temoignages. Noms de villes autour de Metz/Moselle.'],
      ['Contact', 'Pas d\'email visible. Deux portables (Cyrille + Victorien) : signal positif.'],
    ] as [string, string][],
    questionCle: 'C\'est une vraie boite serieuse que je peux recommander a mes clients ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Les avis valident le serieux mais l\'absence de photos sur le site, de page equipe et de galerie cree un doute.',
    impactVitesse: 'Desktop, OK.',
    impactConfiance: 'Note elevee rassurante, mais manque de preuves visuelles sur le site lui-meme.',
    positifs: ['115 avis verifies — difficile de douter', 'Deux portables identifies (Cyrille + Victorien)', 'Gamme complete et coherente'],
    frictions: ['Pas de galerie photos realisations sur le site', 'Pas de page equipe / qui sommes-nous', 'Design CMS generique', 'Email non visible en page contact'],
    ceQuiFeraitBasculer: 'Une galerie de realisations sur le site + une courte page "Notre equipe" auraient scelle sa recommandation.',
    exp: 6, conf: 7, clarte: 6,
  },
  {
    id: 5,
    name: 'Dominique',
    age: 29,
    emoji: '📐',
    situation: 'Etudiant BTS Agencement a Metz, cherche un stage de 6 semaines',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Hors cible — cherche un stage dans une zone ou le site n\'est pas oriente recrutement. Repart sans contact.',
    localisation: 'Metz (57) — 35 km',
    maturite: 'Decouverte',
    contexte: 'Cherche un terrain de stage. A trouve Nova via la page Offres d\'emploi dans Google.',
    impression: 'Site professionnel. Cherche une section Carrieres ou Nous rejoindre.',
    parcours: [
      ['Accueil', 'Rien sur les stages en page d\'accueil.'],
      ['Offres d\'emploi', 'Page trouvee dans le menu. Cherche la mention stage.'],
      ['Contact', 'Pas de nom RH visible. Email non affiche. Trop vague pour une candidature spontanee.'],
    ] as [string, string][],
    questionCle: 'Est-ce qu\'ils prennent des stagiaires et comment les contacter ?',
    reponse: 'Non' as const,
    commentReponse: 'Hors cible commerciale. Le site n\'est pas fait pour le recrutement de stagiaires.',
    impactVitesse: 'Non pertinent.',
    impactConfiance: 'Non pertinent pour ce persona.',
    positifs: ['Page offres d\'emploi existante (signal de croissance)', 'Telephone disponible'],
    frictions: ['Pas de mention stage', 'Pas de nom RH visible', 'Email non affiche'],
    ceQuiFeraitBasculer: 'Hors cible — ce visiteur n\'est pas votre client ideal.',
    exp: 4, conf: 5, clarte: 3,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Ajouter une galerie de realisations sur la page d\'accueil',
    pourquoi: 'Sans photos de votre travail sur le site, les visiteurs qui vous decouvrent via Google ne peuvent pas evaluer si votre style correspond a ce qu\'ils cherchent. 3 visiteurs sur 5 bloquent sur ce point. Vos avis 4,9/5 attirent le clic mais ne remplacent pas la preuve visuelle.',
    action: 'Creer une section "Nos realisations" sur la page d\'accueil avec 6 photos (2 cuisines, 2 dressings, 2 autres projets), chacune avec un titre court (projet + ville). Relier a une page realisations complete.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Non mesure', ok: true, detail: 'Heberge sur Plus que PRO + Cloudflare CDN — bonne base de distribution' },
  { label: 'Securite', verdict: 'Grade C', ok: false, detail: 'Score 55/100 Observatory — 2 tests echoues sur 10' },
  { label: 'SEO', verdict: 'A ameliorer', ok: false, detail: 'Sitemap present, robots.txt absent, meta non confirmes' },
  { label: 'Donnees structurees', verdict: 'Partiel', ok: false, detail: 'Schema.org present (LocalBusiness + 115 avis) mais incomplet' },
  { label: 'Partage reseaux', verdict: 'Non confirme', ok: false, detail: 'Open Graph non accessible au scraping (protection Cloudflare)' },
];

const tech = {
  observatory: { grade: 'C', score: 55, testsOk: 8, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'HTTPS force via Cloudflare' },
    { ok: true, h: 'X-Content-Type-Options : nosniff' },
    { ok: true, h: 'X-Frame-Options : SAMEORIGIN' },
    { ok: true, h: 'Permissions-Policy (tres complet)' },
    { ok: true, h: 'Referrer-Policy : same-origin' },
    { ok: true, h: 'Cross-Origin-Embedder-Policy : require-corp' },
    { ok: true, h: 'Cross-Origin-Opener-Policy : same-origin' },
    { ok: false, h: 'Content-Security-Policy (non detecte — probablement manquant)' },
    { ok: false, h: 'Strict-Transport-Security HSTS (non visible dans la reponse)' },
  ],
  schema: [
    { item: 'JSON-LD present', ok: true },
    { item: '@type coherent avec l\'activite (LocalBusiness)', ok: true },
    { item: 'aggregateRating (4,9/5 — 115 avis)', ok: true },
    { item: 'name present', ok: true },
    { item: 'address + geo (localisation)', ok: false },
    { item: 'telephone', ok: false },
    { item: 'image / logo', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
    { item: 'openingHours', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Non confirme (protection Cloudflare)' },
    { item: 'og:description', ok: false, val: 'Non confirme' },
    { item: 'og:image', ok: false, val: 'Non confirme' },
    { item: 'og:type', ok: false, val: 'Non confirme' },
    { item: 'og:url', ok: false, val: 'Non confirme' },
    { item: 'twitter:card', ok: false, val: 'Non confirme' },
    { item: 'canonical', ok: false, val: 'Non confirme' },
  ],
  seo: [
    { item: 'Un seul H1 par page', ok: true },
    { item: 'Hierarchie coherente (H1 > H2 > H3)', ok: true },
    { item: 'Meta description', ok: false },
    { item: 'Images avec alt text', ok: false },
    { item: 'robots.txt accessible', ok: false },
    { item: 'sitemap.xml accessible', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
  ],
};

const alertes: { type: 'critique' | 'important'; titre: string; detail: string; chiffre: string; chiffreLabel: string }[] = [
  { type: 'important' as const, titre: 'Grade sécurité C', detail: '2 tests de sécurité échoués sur 10 — votre site est passable mais sous le seuil attendu par les navigateurs modernes.', chiffre: 'C', chiffreLabel: 'grade sécurité Mozilla Observatory' },
  { type: 'important' as const, titre: 'Galerie réalisations absente', detail: '3 visiteurs sur 5 ont cherché des photos de cuisines ou dressings. Sans galerie en accueil, vos 4,9/5 ne compensent pas le manque de preuve visuelle.', chiffre: '3/5', chiffreLabel: 'visiteurs bloqués par ce manque' },
];
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO — Verdict immediat -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesite</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>

  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilite, fluidite</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Credibilite, preuves, rassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
        <p class="text-[10px] text-neutral-400 mt-1">Comprehension de l'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- 2b. ALERTES -->
{alertes.length > 0 && (
  <section style="background: #fefce8;" class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <div>
          <h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2>
          <p class="text-sm text-neutral-600">
            {alertes.filter(a => a.type === 'critique').length > 0 && <span class="text-red-700 font-medium">{alertes.filter(a => a.type === 'critique').length} critique{alertes.filter(a => a.type === 'critique').length > 1 ? 's' : ''}</span>}
            {alertes.filter(a => a.type === 'critique').length > 0 && alertes.filter(a => a.type === 'important').length > 0 && <span class="mx-1 text-neutral-400">·</span>}
            {alertes.filter(a => a.type === 'important').length > 0 && <span class="text-amber-700 font-medium">{alertes.filter(a => a.type === 'important').length} important{alertes.filter(a => a.type === 'important').length > 1 ? 's' : ''}</span>}
          </p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {alertes.map(a => (
          <div class={`bg-white rounded-xl p-5 ${a.type === 'critique' ? 'border-2 border-red-300' : 'border border-amber-200'}`}>
            <div class="flex items-start gap-4">
              <div class={`text-2xl font-black rounded-lg px-3 py-1 shrink-0 ${a.type === 'critique' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>{a.chiffre}</div>
              <div>
                <p class="font-semibold text-neutral-900 text-sm mb-1">{a.titre}</p>
                <p class="text-xs text-neutral-600">{a.detail}</p>
