  { label: 'Données structurées', verdict: 'Bon ↑', ok: true, detail: 'Bug price:"null" corrigé — Rich Results Test propre. FAQPage 13 Q&A maintenue.' },
  { label: 'Partage réseaux', verdict: 'OK', ok: true, detail: 'OG images présentes, og:image:width/height toujours à renseigner' },
  { label: 'i18n', verdict: 'Nouveau', ok: true, detail: 'Version /en/* + auto-redirect — attention : friction si navigateur FR configuré en anglais' },
];

const tech = {
  observatory: { grade: 'B', score: 75, testsOk: 9, testsTotal: 10 },
  pagespdMobile: { performance: 85, accessibility: 95, bestPractices: 100, seo: 100 },
  pagespdDesktop: { performance: 98, accessibility: 95, bestPractices: 100, seo: 100 },
  cwv: { lcp: '~2.8s (mobile)', inp: '< 200ms', cls: '~0.02' },
  headers: [
    { ok: true, h: 'strict-transport-security' },
    { ok: true, h: 'x-content-type-options' },
    { ok: true, h: 'x-frame-options' },
    { ok: true, h: 'referrer-policy' },
    { ok: true, h: 'permissions-policy' },
    { ok: false, h: 'content-security-policy (absent)' },
  ],
  schema: [
    { item: 'WebSite — name, url, description, inLanguage', ok: true },
    { item: 'ProfessionalService — areaServed, priceRange, makesOffer', ok: true },
    { item: 'FAQPage — 13 Q&A structurées en JSON-LD', ok: true },
    { item: 'ItemList réalisations — 33 projets non structurés', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'Création de sites web sur mesure — Marc M' },
    { item: 'og:description', ok: true, val: '151 caractères' },
    { item: 'og:image', ok: true, val: 'og-default.png (home) / og-echo.png (/echo/*)' },
    { item: 'og:image:width/height', ok: false, val: 'Absent — à renseigner' },
  ],
  seo: [
    { item: 'Title unique par page (40-60 car.)', ok: true },
    { item: 'Meta description unique (130-160 car.)', ok: true },
    { item: 'Canonical présent toutes pages', ok: true },
    { item: 'Sitemap XML complet', ok: true },
    { item: 'Robots.txt configuré', ok: true },
    { item: 'H1 unique et sémantique', ok: true },
    { item: 'Fonts locales (RGPD)', ok: true },
    { item: 'Noindex pages /echo/[slug]/', ok: true },
  ],
};

const ameliorationsHautes = [
  {
    titre: 'Preload image hero — LCP mobile < 2.5s',
    pourquoi: 'Sur 100 visiteurs, ~60 arrivent sur mobile. Le LCP de ~2.8s est perçu comme lent sur 4G — et c\'est la première impression. Toutes les améliorations de contenu ne compensent pas un départ sur fond blanc de 3 secondes.',
    action: 'Ajouter <link rel="preload" as="image" fetchpriority="high"> sur l\'image hero dans le <head>. Ajouter fetchpriority="high" sur la balise <img> correspondante. ~30 minutes de dev.',
    impact: '~60 personas sur 100',
  },
  {
    titre: 'Portfolio beauté / santé / créatif',
    pourquoi: '12 personas cherchent un exemple de leur secteur et ne le trouvent pas : coiffeuses, esthéticiennes, ostéopathes, maquilleuses, yoga, wedding planners. Sans exemple, ils ne peuvent pas projeter le rendu de leur propre site.',
    action: '3 à 5 exemples ajoutés aux réalisations : un salon de beauté, un professionnel de santé libéral, un créatif (photographe, artiste). Ou une mention explicite "je réalise des sites pour les professions libérales de santé et les métiers de la beauté" dans /offre.',
    impact: '12 personas sur 100',
  },
  {
    titre: '"100% à distance" dans le hero',
    pourquoi: 'La FAQ géographie couvre désormais la France entière — mais les personas au scroll rapide (mobile, attention courte) ne descendent pas jusqu\'à la FAQ. Ils repartent en pensant être hors zone alors qu\'ils ne le sont pas.',
    action: 'Une ligne sous le H1 du hero : "100% à distance — je travaille avec des clients dans toute la France." 12 mots. Applicable même si le client est à 500 km.',
    impact: '~8 personas sur 100',
  },
  {
    titre: 'Correction auto-redirect i18n — bouton "Revenir en français"',
    pourquoi: 'Nouvelle friction V2 : les visiteurs français avec un navigateur configuré en anglais (iPhone neuf, config pro, reset) sont redirigés vers /en/ sans explication. Claire (consultante), Christophe (prof tech) ont quitté sans comprendre.',
    action: 'Ajouter une bannière discrète sur les pages /en/* : "You were redirected / Revenir en français →" ou un switcher FR/EN visible dans le header. Empêche le départ immédiat des francophones égarés.',
    impact: '3-5% des visiteurs FR',
  },
];

const ameliorationsUtiles = [
  {
    titre: 'Afficher "33 projets réalisés" (pas "11 livrés")',
    detail: 'Le compteur "11 projets livrés" est meilleur que "0+" mais plusieurs profils analytiques (Julien, Thomas) font le calcul : "11 c\'est peu". Afficher les 33 projets réels du portfolio ou reformuler "11 nouvelles Vitrines offertes sur 100" clarifie la distinction.',
  },
  {
    titre: 'Mention "refonte WordPress/Wix" dans l\'offre ou la FAQ',
    detail: 'Sébastien (P81) et 4 autres personas cherchent explicitement à migrer depuis WordPress ou Wix. Aucune mention de "refonte" dans les titres de l\'offre — ils doivent inférer que le Multi-pages 1290€ couvre leur cas. Une FAQ ou une ligne suffit.',
  },
  {
    titre: 'Content-Security-Policy — Observatory A',
    detail: 'Header CSP toujours absent, grade B persistant. Les profils tech (Amandine, Julien, Maxime) le voient et y voient un manque de rigueur. Un header CSP dans /public/_headers = grade A en 20 minutes.',
  },
  {
    titre: 'og:image:width/height',
    detail: 'Absent depuis V1 — renseigner 1200×630 améliore le rendu des partages LinkedIn, WhatsApp, Twitter. Impact sur les personas qui partagent le site avant de décider.',
  },
];

const ameliorationsDiscuter = [
  {
    emoji: '🗺️',
    titre: 'Pages géo : Mulhouse et Colmar à renforcer',
    detail: 'Les pages /mulhouse et /colmar existent mais sont moins denses que /metz. Enrichir avec des exemples locaux récupérerait les prospects du Haut-Rhin qui doutent de la distance.',
  },
  {
    emoji: '🔗',
    titre: 'Page sous-traitance /graphistes à promouvoir',
    detail: 'Aurélien (dev) et Thomas (graphiste) ont trouvé cette page — mais uniquement parce qu\'ils cherchaient activement. Une mention dans le footer ou dans les pages partenaires doublerait le trafic sur ce canal.',
  },
  {
    emoji: '🌍',
    titre: 'Mention bilingue FR/DE dans les add-ons',
    detail: 'Émeline (viticultrice Ribeauvillé) et Sarah (traductrice Strasbourg) ont demandé le bilingue FR/DE. Grand Est = zone frontalière. Mentionner "bilingue FR/DE disponible sur devis" dans les add-ons coûte une ligne.',
  },
  {
    emoji: '📸',
    titre: 'Gallery/avant-après secteur BTP',
    detail: 'Vincent (installateur solaire), Éric (peintre bâtiment), Djamila (danse) : tous veulent des photos avant/après. Une section "galerie" dans les add-ons avec exemple visuel convertirait mieux que la description texte actuelle.',
  },
];
---

<BaseLayout
  title={`Echo Suivi V2 — ${nomProspect} — Rapport confidentiel`}
  description={`Rapport Echo Suivi V2 pour ${nomProspect} — ${kpis.nbPersonas} visiteurs simulés sur ${urlSite}`}
  noindex={true}
  lang="fr"
  frPath={`/echo/${slug}/`}
>

<!-- ═══════════════════════════════════════════════════ -->
<!-- 1. HERO — Verdict immédiat                         -->
<!-- ═══════════════════════════════════════════════════ -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analysé : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simulés · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hésitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════ -->
<!-- 1b. ÉVOLUTION — Timeline des versions              -->
<!-- ═══════════════════════════════════════════════════ -->
{showTimeline && (
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <h2 class="text-xl font-bold text-neutral-900 mb-2">Évolution du site</h2>
  <p class="text-sm text-neutral-500 mb-6">Progression du taux de conversion à chaque version auditée.</p>

  <div class="flex flex-wrap gap-4 mb-8">
    {versionsData.map((v, i) => {
      const isCurrent = i === versionsData.length - 1;
      const color = v.tauxConversion >= 60 ? 'green' : v.tauxConversion >= 40 ? 'amber' : 'neutral';
      const bgClass = isCurrent ? 'bg-neutral-900 text-white' : 'bg-white border border-neutral-200';
      const scoreColor = color === 'green' ? 'text-green-400' : color === 'amber' ? 'text-amber-500' : 'text-neutral-400';
      return (
        <div class={`rounded-xl p-5 flex-1 min-w-[140px] ${bgClass}`}>
          <div class={`text-3xl font-black mb-1 ${isCurrent ? 'text-green-400' : scoreColor}`}>{v.tauxConversion}%</div>
          <div class={`text-xs font-semibold mb-0.5 ${isCurrent ? 'text-white' : 'text-neutral-800'}`}>{v.version.toUpperCase()}</div>
          <div class={`text-[11px] ${isCurrent ? 'text-neutral-400' : 'text-neutral-500'}`}>{v.date}</div>
          <div class={`text-[10px] mt-1 ${isCurrent ? 'text-neutral-500' : 'text-neutral-400'}`}>{v.formule}</div>
        </div>
      );
    })}
  </div>

  <!-- Delta table -->
  <div class="bg-white border border-neutral-200 rounded-xl overflow-hidden">
    <div class="grid grid-cols-5 gap-0 text-[11px] font-semibold text-neutral-500 uppercase tracking-wider bg-neutral-50 px-4 py-3 border-b border-neutral-200">
      <div class="col-span-2">Friction V3</div>
      <div>Statut V4</div>
      <div class="col-span-2">Impact mesuré</div>
    </div>
    {[
      { friction: 'Observatory B (pas de CSP)', statut: '✅', label: 'Résolue', impact: 'Elsa P25 confiance +1.5, Damien P40 confiance +0.5 — profils tech rassurés', color: 'green' },
      { friction: 'Referrer-Policy absent', statut: '✅', label: 'Résolue', impact: 'Contribution au score sécurité global', color: 'green' },
      { friction: 'Module boutique invisible', statut: '⚠️', label: 'Partielle', impact: 'Kidnapping en Direct = preuve e-commerce. Lucie P31 confiance +1. Emma P98 : Repart → Hésite', color: 'amber' },
      { friction: '/blog → 404', statut: '❌', label: 'Non traitée', impact: 'Laura P86 repart en 8s, Emma P98 hésite (au lieu de partir), Valérie P19 repart', color: 'red' },
      { friction: '/fr/ → 404', statut: '❌', label: 'Non traitée', impact: 'Ibrahim P75, Véronique P88 repartent. Jacques P6, Valérie P19 impactés', color: 'red' },
      { friction: 'Compteur "0+" bug JS', statut: '❌', label: 'Non traitée', impact: 'Jacques P6 confus, Valérie P19, Damien P40 — crédibilité entamée', color: 'red' },
      { friction: 'Schema.org price:"null"', statut: '❌', label: 'Non traitée', impact: 'Damien P40 le détecte en inspectant le code', color: 'red' },
      { friction: '"11 sites" vs "14 Projects"', statut: '❌', label: 'Non traitée', impact: '3 chiffres contradictoires (0+, 11, 14) — signal de négligence', color: 'red' },
      { friction: '—', statut: '🆕', label: 'Amélioration', impact: 'Filtres catégories portfolio : aide Lucie (Crafts & Retail), mais révèle absence de secteurs pour François-Xavier', color: 'blue' },
    ].map(row => {
      const rowBg = row.color === 'green' ? 'bg-green-50' : row.color === 'amber' ? 'bg-amber-50' : row.color === 'red' ? 'bg-red-50' : 'bg-blue-50';
      const labelColor = row.color === 'green' ? 'text-green-700 bg-green-100' : row.color === 'amber' ? 'text-amber-700 bg-amber-100' : row.color === 'red' ? 'text-red-700 bg-red-100' : 'text-blue-700 bg-blue-100';
      return (
        <div class={`grid grid-cols-5 gap-0 px-4 py-3 border-b border-neutral-100 text-xs items-start ${rowBg}`}>
          <div class="col-span-2 text-neutral-700 font-medium">{row.friction}</div>
          <div><span class={`px-1.5 py-0.5 rounded text-[10px] font-semibold ${labelColor}`}>{row.statut} {row.label}</span></div>
          <div class="col-span-2 text-neutral-600">{row.impact}</div>
        </div>
      );
    })}
  </div>
</section>
)}

<!-- ═══════════════════════════════════════════════════ -->
<!-- 2. LE CONSTAT — Données et analyses                -->
<!-- ═══════════════════════════════════════════════════ -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: var(--color-accent);">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'où viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivée.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-44 sm:w-52 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>


  <!-- Scores détaillés -->
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores détaillés (expérience, confiance, clarté)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Expérience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilité, fluidité</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Crédibilité, preuves, réassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarté</div>
        <p class="text-[10px] text-neutral-400 mt-1">Compréhension de l\'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- ═══════════════════════════════════════════════════ -->
<!-- 3. VOS VISITEURS — Les histoires                   -->
<!-- ═══════════════════════════════════════════════════ -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu\'un cherche vos services et tombe sur votre site.</p>

    <!-- Filtres par canal -->
    <div class="flex flex-wrap gap-2 mb-8" id="persona-filters">
      <button data-filter="all" class="filter-btn active px-3 py-1.5 rounded-full text-xs font-medium bg-neutral-900 text-white">Tous ({kpis.nbPersonas})</button>
      {canalData.map(c => (
        <button data-filter={c.canal} class="filter-btn px-3 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-600 border border-neutral-200 hover:border-neutral-400">{c.canal} ({c.nb})</button>
      ))}
    </div>

    <!-- Ceux qui contactent -->
    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent
        <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3" id="list-convertit">
        {personas.filter(p => p.decision === 'Convertit').slice(0, 5).map(p => {
          const borderColor = 'border-green-200';
          const badgeBg = 'bg-green-600';
          return (
            <details class={`group persona-card bg-white rounded-xl overflow-hidden shadow-sm border ${borderColor}`} data-canal={p.canal}>
              <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                    <span class={`text-[10px] ${badgeBg} text-white px-1.5 py-0.5 rounded font-medium`}>{p.decisionLabel}</span>
                  </div>
                  <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                    <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                    <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                  </div>
                </div>
                <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class={`px-4 pb-5 border-t ${borderColor}`}>
                <div class="grid gap-4 text-xs mt-4">
                  <div>
                    <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p>
                    <p class="text-neutral-600">{p.contexte}</p>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Première impression (5 sec)</p>
                    <p class="text-neutral-600">{p.impression}</p>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                    <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                      {p.parcours.map(([section, reaction]) => (
                        <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                      ))}
                    </ol>
                  </div>
                  <div class="bg-neutral-50 rounded-lg p-3">
                    <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                    <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                    <p class="text-neutral-600">Le site répond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong>{p.commentReponse ? ` — ${p.commentReponse}` : ''}</p>
                  </div>
                  <div class="grid grid-cols-2 gap-4">
                    <div>
                      <p class="font-semibold text-green-700 mb-1.5">✓ Points positifs</p>
                      <ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul>
                    </div>
                    <div>
                      <p class="font-semibold text-amber-700 mb-1.5">✗ Frictions</p>
                      <ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul>
                    </div>
                  </div>
