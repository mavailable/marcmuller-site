<!-- Filtre JS -->
<script>
  const filters = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.persona-card');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      filters.forEach(b => {
        b.classList.remove('bg-neutral-900', 'text-white');
        b.classList.add('bg-white', 'text-neutral-600', 'border', 'border-neutral-200');
      });
      btn.classList.add('bg-neutral-900', 'text-white');
      btn.classList.remove('bg-white', 'text-neutral-600', 'border', 'border-neutral-200');

      const filter = btn.getAttribute('data-filter');
      cards.forEach(card => {
        const canal = card.getAttribute('data-canal');
        if (filter === 'all' || canal === filter) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

