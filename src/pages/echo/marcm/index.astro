<BaseLayout
  title={`Echo Pro — ${nomProspect} — Rapport confidentiel`}
  description={`Rapport Echo Pro pour ${nomProspect} — ${kpis.nbPersonas} visiteurs simulés sur ${urlSite}`}
  noindex={true}
  lang="fr"
  frPath={`/echo/${slug}/`}
>

<!-- ═══════════════════════════════════════════════════ -->
<!-- 1. HERO — Verdict immédiat                         -->
<!-- ═══════════════════════════════════════════════════ -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analysé : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simulés · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hésitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════ -->
<!-- 2. LE CONSTAT — Données et analyses                -->
<!-- ═══════════════════════════════════════════════════ -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: var(--color-accent);">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'où viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivée.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-44 sm:w-52 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Analyses avancées Pro -->
  <>
    <h2 class="text-xl font-bold text-neutral-900 mb-2">Le parcours de vos visiteurs</h2>
    <p class="text-sm text-neutral-500 mb-6">De la découverte à la décision, où vous les perdez.</p>

    <div class="grid md:grid-cols-3 gap-4 mb-12">
      {maturiteData.map(m => {
        const color = m.rate >= 50 ? '#22c55e' : m.rate >= 25 ? '#f59e0b' : '#6b7280';
        return (
          <div class="bg-white border border-neutral-200 rounded-xl p-5">
            <div class="text-2xl font-black mb-1" style={`color: ${color}`}>{m.rate}%</div>
            <div class="text-sm font-semibold text-neutral-900 mb-1">{m.label}</div>
            <div class="text-xs text-neutral-500 mb-3">{m.total} visiteurs</div>
            <div class="flex gap-1 mb-3">
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-green-100 text-green-700">{m.convert} ✓</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-700">{m.hesite} ~</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-neutral-100 text-neutral-500">{m.quitte} ✗</span>
            </div>
            <p class="text-xs text-neutral-500 italic">Friction : {m.friction}</p>
          </div>
        );
      })}
    </div>

    <h2 class="text-xl font-bold text-neutral-900 mb-2">Mobile vs Desktop</h2>
    <p class="text-sm text-neutral-500 mb-6">Votre site convertit-il aussi bien sur téléphone ?</p>
    <div class="grid md:grid-cols-3 gap-4 mb-12">
      {deviceData.map(d => {
        const color = d.rate >= 55 ? '#22c55e' : d.rate >= 35 ? '#f59e0b' : '#6b7280';
        return (
          <div class="bg-white border border-neutral-200 rounded-xl p-5">
            <div class="text-2xl font-black mb-1" style={`color: ${color}`}>{d.rate}%</div>
            <div class="text-sm font-semibold text-neutral-900 mb-1">{d.device}</div>
            <div class="text-xs text-neutral-500 mb-2">{d.total} visiteurs</div>
            <p class="text-xs text-neutral-500 italic">{d.insight}</p>
          </div>
        );
      })}
    </div>

    <h2 class="text-xl font-bold text-neutral-900 mb-2">Où investir</h2>
    <p class="text-sm text-neutral-500 mb-6">Croisement canal × maturité : les cases rouges sont vos opportunités.</p>
    <div class="overflow-x-auto rounded-xl border border-neutral-200 mb-12">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-neutral-50">
            <th class="text-left p-3 text-neutral-500 font-medium">Canal</th>
            <th class="p-3 text-neutral-500 font-medium">Découverte</th>
            <th class="p-3 text-neutral-500 font-medium">Comparaison</th>
            <th class="p-3 text-neutral-500 font-medium">Décision</th>
          </tr>
        </thead>
        <tbody>
          {matriceData.map(row => (
            <tr class="border-t border-neutral-100">
              <td class="p-3 font-medium text-neutral-900">{row.canal}</td>
              {[row.decouverte, row.comparaison, row.decision].map(pct => {
                const cls = pct >= 60 ? 'bg-green-100 text-green-800' : pct >= 30 ? 'bg-amber-100 text-amber-800' : 'bg-red-100 text-red-800';
                return <td class={`p-3 text-center font-bold ${cls}`}>{pct}%</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </>

  <!-- Scores détaillés -->
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores détaillés (expérience, confiance, clarté)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Expérience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilité, fluidité</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Crédibilité, preuves, réassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarté</div>
        <p class="text-[10px] text-neutral-400 mt-1">Compréhension de l\'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- ═══════════════════════════════════════════════════ -->
<!-- 3. VOS VISITEURS — Les histoires                   -->
<!-- ═══════════════════════════════════════════════════ -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu\'un cherche vos services et tombe sur votre site.</p>

    <!-- Filtres par canal -->
    <div class="flex flex-wrap gap-2 mb-8" id="persona-filters">
      <button data-filter="all" class="filter-btn active px-3 py-1.5 rounded-full text-xs font-medium bg-neutral-900 text-white">Tous ({kpis.nbPersonas})</button>
      {canalData.map(c => (
        <button data-filter={c.canal} class="filter-btn px-3 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-600 border border-neutral-200 hover:border-neutral-400">{c.canal} ({c.nb})</button>
      ))}
    </div>

    <!-- Ceux qui contactent -->
    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent
        <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
