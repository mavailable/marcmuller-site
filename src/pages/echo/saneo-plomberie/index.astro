---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const isProspection = true;
const formule = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const showUpsell = true;

const title = 'Echo Decouverte — Saneo Plomberie Nancy | Marc M';
const description = 'Analyse gratuite de saneo-plomberie.fr : simulation de 10 visites clients, frictions identifiees, recommandations prioritaires. Rapport confidentiel.';
const dateGeneration = '1er avril 2026';

// ─── PERSONAS ───
const personas = [
  {
    id: 1, name: 'Laurence', age: 39, role: 'Proprietaire appartement Nancy, chauffe-eau en panne', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Mobile', decision: 'Quitte',
    exp: 2, conf: 4, clarte: 2, emoji: '\u{1F6A8}',
    situation: 'Cherche un plombier-chauffagiste Nancy en urgence, compare les premiers resultats Google',
    parcours: ['Accueil'],
    questionCle: 'Vous intervenez en urgence sur Nancy pour un chauffe-eau en panne ?',
    reponse: 'Non',
    premierImpression: '4,6 etoile / 180 avis. RGE mentionne. Mais le numero est introuvable sur mon mobile.',
    positifs: ['Note 4,6 etoile / 180 avis', 'RGE mentionne', 'Nom professionnel Saneo'],
    frictions: ['Telephone non accessible sur mobile (Divi/JS)', 'Pas de mention urgence ou delai d\'intervention', 'Pas de tarifs', 'Google Fonts = RGPD'],
    raisonDecision: 'Elle ne trouve pas le numero rapidement. Elle passe au plombier suivant.',
    impactTech: 'Mobile : telephone charge en JS Divi = non cliquable. Urgence + friction = perte du prospect.',
  },
  {
    id: 2, name: 'Dominique', age: 53, role: 'Gestionnaire de copropriete, fuite eau colonne commune', canal: 'Google Maps',
    maturite: 'Decision', device: 'Mobile', decision: 'Convertit',
    exp: 6, conf: 7, clarte: 5, emoji: '\u{1F3E2}',
    situation: 'Cherche "plombier Nancy" sur Maps, voit la note 4,6 etoile de Saneo, fuite urgente',
    parcours: ['Google Maps', 'Appel direct'],
    questionCle: 'Vous pouvez intervenir aujourd\'hui pour une fuite en colonne montante ?',
    reponse: 'Oui (via Maps)',
    premierImpression: '4,6 etoile / 180 avis. Numero sur Maps. Plombier-chauffagiste Nancy confirme.',
    positifs: ['4,6 etoile / 180 avis', 'Numero visible sur Maps', 'Nancy confirme'],
    frictions: ['Pas d\'info sur interventions copropriete', 'Pas de delai annonce'],
    raisonDecision: 'Il appelle depuis Maps directement. Le site n\'est pas consulte.',
    impactTech: 'Google My Business compense les lacunes du site. La fiche Maps fait le travail.',
  },
  {
    id: 3, name: 'Kevin', age: 31, role: 'Futur proprietaire, projet installation pompe a chaleur RGE', canal: 'IA (ChatGPT)',
    maturite: 'Decouverte', device: 'Desktop', decision: 'Quitte',
    exp: 3, conf: 5, clarte: 2, emoji: '\u{2665}\u{FE0F}',
    situation: 'A demande a ChatGPT "installateur pompe a chaleur RGE Nancy" — recoit le nom Saneo',
    parcours: ['Accueil', 'Services'],
    questionCle: 'Vous installez des pompes a chaleur ? Vous etes RGE pour les aides ?',
    reponse: 'Partiellement',
    premierImpression: 'RGE mentionne c\'est bien. Mais je ne trouve pas de page dediee pompe a chaleur avec detail du service.',
    positifs: ['RGE mentionne', 'Nom professionnel', 'Nancy confirme'],
    frictions: ['Pompe a chaleur non mise en avant clairement', 'Pas de page dediee PAC', 'Pas de tarif ni simulation', 'Site non optimise pour les IA'],
    raisonDecision: 'Il ne trouve pas les infos sur la PAC. Il cherche un installateur specialise qui detaille ce service.',
    impactTech: 'Site non optimise pour les IA. ChatGPT ne peut pas citer des infos sur la PAC depuis ce site.',
  },
  {
    id: 4, name: 'Sandrine', age: 46, role: 'Proprietaire maison Nancy, recommandation d\'un ami', canal: 'Bouche-a-oreille',
    maturite: 'Decision', device: 'Tablette', decision: 'Convertit',
    exp: 5, conf: 8, clarte: 4, emoji: '\u{1F44D}',
    situation: 'Son ami a fait appel a Saneo pour sa chaudiere — excellent retour',
    parcours: ['Accueil', 'Contact'],
    questionCle: 'Mon ami m\'a recommande. Vous pouvez entretenir ma chaudiere gaz ?',
    reponse: 'Oui',
    premierImpression: 'Recommandation forte + site professionnel. Je cherche le numero et j\'appelle.',
    positifs: ['Recommandation forte', 'Chaudiere gaz dans les services', 'Nancy confirme'],
    frictions: ['Numero difficile a trouver', 'Pas de formulaire de demande d\'entretien en ligne'],
    raisonDecision: 'La recommandation fait tout. Elle finit par trouver le numero et appelle.',
    impactTech: 'Tablette : JS Divi charge mieux. Numero trouvable apres quelques secondes.',
  },
  {
    id: 5, name: 'Thomas', age: 42, role: 'Proprietaire maison neuve, cherche contrat entretien chaudiere annuel', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Desktop', decision: 'Hesite',
    exp: 3, conf: 6, clarte: 2, emoji: '\u{1F4CB}',
    situation: 'Compare les offres de contrat entretien chaudiere a Nancy',
    parcours: ['Accueil', 'Services'],
    questionCle: 'Vous proposez un contrat d\'entretien annuel pour chaudiere ? Quel tarif ?',
    reponse: 'Non clairement',
    premierImpression: '4,6 etoile / 180 avis + RGE. Plomberie + chauffage = utile. Mais je ne trouve pas d\'offre entretien structuree.',
    positifs: ['4,6 etoile / 180 avis', 'RGE', 'Plombier + chauffage combines'],
    frictions: ['Contrat entretien non mentionne explicitement', 'Pas de tarif annuel', 'Pas de formulaire de souscription'],
    raisonDecision: 'Il hesite. Il note Saneo mais cherche un concurrent qui detaille son offre d\'entretien annuel.',
    impactTech: 'Desktop : site charge. Probleme = absence de contenu sur l\'offre entretien.',
  },
  {
    id: 6, name: 'Muriel', age: 58, role: 'Proprietaire appartement Nancy, probleme de pression eau', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Mobile', decision: 'Quitte',
    exp: 1, conf: 4, clarte: 1, emoji: '\u{1F6B0}',
    situation: 'Cherche un plombier rapide sur Nancy, compare 4 entreprises',
    parcours: ['Accueil'],
    questionCle: 'Vous pouvez venir rapidement pour un probleme de pression d\'eau ?',
    reponse: 'Non',
    premierImpression: 'Note Google solide. Mais impossible de trouver le numero sur mobile.',
    positifs: ['Note Google solide'],
    frictions: ['Numero invisible sur mobile', 'Pas de delai d\'intervention', 'Pas de mention disponibilite rapide', 'Google Fonts RGPD'],
    raisonDecision: 'Elle ne trouve pas le numero. Elle appelle le plombier suivant.',
    impactTech: 'Mobile + telephone JS = double friction = perte systematique.',
  },
  {
    id: 7, name: 'Philippe', age: 35, role: 'Jeune proprietaire, renovation salle de bain', canal: 'Reseaux sociaux',
    maturite: 'Decouverte', device: 'Mobile', decision: 'Quitte',
    exp: 2, conf: 4, clarte: 1, emoji: '\u{1F6BF}',
    situation: 'A vu Saneo dans un groupe Facebook Nancy, cherche un plombier pour remplacement douche',
    parcours: ['Accueil'],
    questionCle: 'Vous faites les remplacements de douche ? Vous avez des photos de realisations ?',
    reponse: 'Non',
    premierImpression: 'Note Google. Nom professionnel. Mais pas de photos de realisations de salle de bain.',
    positifs: ['Note Google', 'Nom professionnel'],
    frictions: ['Pas de galerie de realisations', 'Pas de photos avant/apres', 'Pas de tarif', 'Numero invisible mobile'],
    raisonDecision: 'Pas de photos de realisations = il ne peut pas evaluer la qualite du travail. Il continue.',
    impactTech: 'Mobile : telephone JS + pas de galerie = double friction pour ce profil.',
  },
  {
    id: 8, name: 'Isabelle', age: 62, role: 'Retraitee, appartement Nancy, chaudiere qui lache en hiver', canal: 'Google Maps',
    maturite: 'Decision', device: 'Mobile', decision: 'Convertit',
    exp: 5, conf: 7, clarte: 4, emoji: '\u{2744}\u{FE0F}',
    situation: 'Cherche "plombier chauffagiste Nancy" sur Maps en urgence, chaudiere en panne',
    parcours: ['Google Maps', 'Appel direct'],
    questionCle: 'Ma chaudiere ne s\'allume plus. Vous pouvez venir ?',
    reponse: 'Oui (via Maps)',
    premierImpression: 'Numero visible sur Maps. 4,6 etoile. Nancy confirme. J\'appelle.',
    positifs: ['Numero visible sur Maps', '4,6 etoile', 'Nancy confirme'],
    frictions: ['Pas de mention depannage urgence explicite', 'Horaires non verifiables sur le site'],
    raisonDecision: 'Urgence chaudiere + Maps = elle appelle directement. Le site n\'est pas visite.',
    impactTech: 'Fiche Google My Business + urgence = conversion directe sans passer par le site.',
  },
  {
    id: 9, name: 'Jean-Pierre', age: 71, role: 'Retraite, entretien annuel chaudiere fioul', canal: 'Bouche-a-oreille',
    maturite: 'Decision', device: 'Tablette', decision: 'Convertit',
    exp: 4, conf: 8, clarte: 3, emoji: '\u{1F9D3}',
    situation: 'Son voisin lui recommande Saneo pour l\'entretien chaudiere',
    parcours: ['Accueil', 'Contact'],
    questionCle: 'Mon voisin fait faire son entretien chez vous. C\'est pour une chaudiere fioul.',
    reponse: 'Oui (partiellement)',
    premierImpression: 'Recommandation du voisin. Le site confirme que c\'est la bonne entreprise. Je cherche le numero.',
    positifs: ['Recommandation forte', 'Chaudiere dans les services'],
    frictions: ['Fioul non mentionne explicitement', 'Numero difficile sur tablette'],
    raisonDecision: 'La recommandation voisin fait tout. Il appelle malgre la friction du numero.',
    impactTech: 'Tablette : JS Divi accessible. Numero trouve apres recherche.',
  },
  {
    id: 10, name: 'Nadia', age: 44, role: 'Gestionnaire d\'immeuble, marches annuels plomberie', canal: 'IA (Perplexity)',
    maturite: 'Comparaison', device: 'Desktop', decision: 'Hesite',
    exp: 3, conf: 6, clarte: 2, emoji: '\u{1F4C4}',
    situation: 'Utilise Perplexity pour comparer les plombiers Nancy avec des marches professionnels',
    parcours: ['Accueil'],
    questionCle: 'Vous travaillez avec des gestionnaires d\'immeubles ? Devis pour marches annuels ?',
    reponse: 'Non clairement',
    premierImpression: '4,6 etoile / 180 avis. RGE. Entreprise structuree. Mais pas de section pro visible.',
    positifs: ['4,6 etoile / 180 avis', 'RGE', 'Entreprise structuree'],
    frictions: ['Pas de section B2B / gestion immobiliere', 'Pas de formulaire devis professionnel', 'Site non optimise pour les IA'],
    raisonDecision: 'Elle hesite. Elle note Saneo mais cherche d\'autres plombiers avec une offre pro structuree.',
    impactTech: 'Site non optimise pour les IA. Perplexity ne peut pas caracteriser l\'offre pro de Saneo.',
  },
];

// ─── STATS ───
const avgExp = (personas.reduce((s, p) => s + p.exp, 0) / personas.length).toFixed(1);
const avgConf = (personas.reduce((s, p) => s + p.conf, 0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.clarte, 0) / personas.length).toFixed(1);
const convertis = personas.filter(p => p.decision === 'Convertit').length;
const hesitants = personas.filter(p => p.decision === 'Hesite').length;
const quitte = personas.filter(p => p.decision === 'Quitte').length;
const tauxConv = Math.round((convertis / personas.length) * 100);

// ─── CANAL STATS ───
const canalStats = [
  { canal: 'Google Search', total: 3, conv: 0, hesitant: 1, quitte: 2 },
  { canal: 'Google Maps', total: 2, conv: 2, hesitant: 0, quitte: 0 },
  { canal: 'IA (ChatGPT / Perplexity)', total: 2, conv: 0, hesitant: 1, quitte: 1 },
  { canal: 'Reseaux sociaux', total: 1, conv: 0, hesitant: 0, quitte: 1 },
  { canal: 'Bouche-a-oreille', total: 2, conv: 2, hesitant: 0, quitte: 0 },
];

// ─── FRICTIONS ───
const frictions = [
  { label: 'Telephone invisible sur mobile (Divi/JS — non cliquable sur smartphone)', count: 6, severity: 'critique' },
  { label: 'Aucune page dediee par service (PAC, entretien, urgence, salle de bain)', count: 6, severity: 'critique' },
  { label: 'aggregateRating absent Schema.org (180 avis 4,6 etoile non exploites en rich snippets)', count: 10, severity: 'haute' },
  { label: 'RGE mentionne mais non valorise (sans page aides d\'Etat ni MaPrimeRenov)', count: 4, severity: 'haute' },
  { label: 'Pas de galerie de realisations (salle de bain, chaudiere, PAC)', count: 3, severity: 'haute' },
  { label: 'Google Fonts via Divi (violation RGPD)', count: 10, severity: 'haute' },
  { label: 'Pas d\'offre B2B / gestion immobiliere', count: 2, severity: 'moyenne' },
];

// ─── RECOMMANDATIONS ───
const recoHaute = {
  title: 'Rendre le telephone cliquable sur mobile — HTML natif obligatoire',
  impact: '6/10 personas',
  detail: 'Le numero de telephone charge via JavaScript Divi est inaccessible quand le JS est lent ou bloque sur mobile. Pour un plombier ou 80% des contacts urgents se font par appel, c\'est la friction la plus couteuse possible. La correction : lien HTML natif <a href="tel:XXXXXXXXXX"> visible des le premier rendu. Sur un site Astro, c\'est la configuration par defaut — aucun JavaScript requis.'
};
const recosMoyennes = [
  {
    title: 'Creer des pages dediees par service cle (PAC, entretien, urgences)',
    impact: '6 personas + SEO long-tail',
    detail: '"Installateur pompe a chaleur RGE Nancy", "entretien chaudiere gaz Nancy tarif", "plombier urgence Nancy" — ce sont les requetes Google a forte valeur commerciale. Sans pages dediees, Saneo est invisible sur ces mots-cles. Chaque page de service capterait un flux de leads qualifies supplementaire. La certification RGE est un atout commercial fort — une page "Profitez des aides MaPrimeRenov avec Saneo" transformerait cet argument en levier de conversion.'
  },
  {
    title: 'Exploiter les 180 avis en Schema.org aggregateRating (type Plumber)',
    impact: '10/10 personas (SEO)',
    detail: 'Les 4,6 etoile sur 180 avis ne sont pas declares en JSON-LD Schema. Ajouter @type Plumber + aggregateRating + areaServed (Nancy + Meurthe-et-Moselle) generera des rich snippets avec etoiles dans les resultats Google — amelioration du CTR estimee a 20-30%. Un atout particulierement precieux sur un marche local concurrentiel comme la plomberie nancéienne.'
  },
];

// ─── TECHNIQUE ───
const techVerdicts = [
  { label: 'HTTPS actif', ok: true },
  { label: 'RGE mentionne (bon argument)', ok: true },
  { label: 'Note Google 4,6 etoile / 180 avis', ok: true },
  { label: 'WP Rocket (performance amelioree)', ok: true },
  { label: 'Robots.txt / Sitemap', ok: true },
  { label: 'Telephone cliquable sur mobile', ok: false },
  { label: 'aggregateRating Schema.org (180 avis)', ok: false },
  { label: 'Pages dediees par service', ok: false },
  { label: 'Galerie de realisations', ok: false },
  { label: 'Polices locales (pas de Google Fonts Divi)', ok: false },
];

// ─── HELPERS ───
function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}
function severityColor(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  if (s === 'moyenne') return 'bg-blue-100 text-blue-800';
  return 'bg-neutral-100 text-neutral-600';
}
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath="/echo/saneo-plomberie"
>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0a1929;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-15 blur-3xl" style="background: #2196f3;"></div>

    <div class="mx-auto max-w-4xl relative z-10">
      <div class="mb-4 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-blue-500/40">
        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
        <span class="text-sm font-semibold text-white/90">Echo Decouverte &middot; Confidentiel</span>
      </div>

      <h1 class="mb-4 text-3xl font-bold leading-tight text-white md:text-4xl lg:text-5xl">
        Saneo a 180 avis et une certif RGE — mais <span class="text-blue-400">6 prospects sur 10 ne peuvent pas appeler</span> depuis son site
      </h1>

      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl mb-8">
        Analyse de <strong class="text-white">saneo-plomberie.fr</strong> — simulation de 10 visites clients reelles, frictions identifiees, recommandations prioritaires. Genere le {dateGeneration}.
      </p>

      <div class="flex flex-wrap gap-4 mb-10">
        <div class="px-6 py-4 rounded-xl bg-green-900/40 border border-green-700/40 text-center">
          <p class="text-2xl font-bold text-green-400">{convertis}</p>
          <p class="text-xs text-green-300 mt-1">contactent</p>
        </div>
        <div class="px-6 py-4 rounded-xl bg-amber-900/40 border border-amber-700/40 text-center">
          <p class="text-2xl font-bold text-amber-400">{hesitants}</p>
          <p class="text-xs text-amber-300 mt-1">hesitent</p>
        </div>
        <div class="px-6 py-4 rounded-xl bg-red-900/40 border border-red-700/40 text-center">
          <p class="text-2xl font-bold text-red-400">{quitte}</p>
          <p class="text-xs text-red-300 mt-1">repartent</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">10 personas simules</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">5 canaux d'arrivee</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">Audit technique inclus</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">{dateGeneration}</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ CONSTAT ═══════════════════ -->
  <div class="w-full px-6 py-10 md:px-8 bg-white">
    <div class="mx-auto max-w-4xl">
      <div class="rounded-xl border-l-4 border-l-blue-500 bg-blue-50 p-6 md:p-8">
        <h2 class="text-lg font-bold text-neutral-900 mb-2">Le probleme de Saneo Plomberie</h2>
        <p class="text-neutral-800 leading-relaxed">
          Saneo est un acteur solide : <strong>4,6 etoile sur 180 avis, certification RGE</strong>, expertise plomberie + chauffage. Mais le site capte uniquement les visiteurs deja decides (Maps, bouche-a-oreille). <strong>60% des prospects repartent</strong> — principalement a cause du telephone invisible sur mobile (Divi/JS) et de l'absence de pages par service. La certification RGE — le principal differenciateur de Saneo — n'est pas exploitee dans le SEO. Pas de page PAC, pas de page "aides MaPrimeRenov", pas de page entretien. Saneo rate les requetes long-tail a forte valeur commerciale sur la renovation thermique.
        </p>
      </div>
    </div>
  </div>

  <!-- ═══════════════════ CANAUX ═══════════════════ -->
  <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-neutral-50">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Conversion par canal</h2>
      <p class="text-neutral-500 mb-8">Maps et bouche-a-oreille convertissent (en contournant le site). Google Search, IA, reseaux sociaux : 0% — ces visiteurs ne peuvent pas appeler ou ne trouvent pas les informations qu'ils cherchent.</p>
      <div class="grid md:grid-cols-2 gap-4">
        {canalStats.map((c) => {
          const pct = c.total > 0 ? Math.round((c.conv / c.total) * 100) : 0;
          return (
            <div class="rounded-xl border border-neutral-200 bg-white p-5">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-semibold text-neutral-900 text-sm">{c.canal}</h3>
                <span class={`text-lg font-bold ${pct > 50 ? 'text-emerald-600' : pct > 0 ? 'text-amber-600' : 'text-red-600'}`}>{pct}%</span>
              </div>
              <div class="h-3 rounded-full bg-neutral-100 overflow-hidden mb-3">
                <div class="h-full rounded-full flex">
                  <div class="bg-emerald-500" style={`width: ${c.total > 0 ? (c.conv / c.total) * 100 : 0}%`}></div>
                  <div class="bg-amber-400" style={`width: ${c.total > 0 ? (c.hesitant / c.total) * 100 : 0}%`}></div>
                  <div class="bg-red-400" style={`width: ${c.total > 0 ? (c.quitte / c.total) * 100 : 0}%`}></div>
                </div>
              </div>
              <div class="flex gap-4 text-xs text-neutral-400">
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> {c.conv} conv.</span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-400"></span> {c.hesitant} hes.</span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-400"></span> {c.quitte} partis</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- ═══════════════════ PERSONAS ═══════════════════ -->
  <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-white">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">10 visites simulees</h2>
      <p class="text-neutral-500 mb-8">Clients types qui visitent saneo-plomberie.fr — profils, parcours, et raison de leur decision.</p>

      <div class="space-y-8">

        {/* Convertit */}
        <div>
          <h3 class="text-base font-bold text-emerald-700 mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Ceux qui contactent ({convertis})
          </h3>
          <div class="space-y-3">
            {personas.filter(p => p.decision === 'Convertit').map((p) => (
              <details class={`group border ${decisionBorder(p.decision)} rounded-xl overflow-hidden`}>
                <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                      <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                      <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                      <span class="text-[11px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                    </div>
                    <p class="text-xs text-neutral-500 mb-2">{p.role}</p>
                    <div class="flex flex-wrap items-center gap-1">
                      {p.parcours.map((page, i) => (
                        <Fragment>
                          <span class="text-[10px] text-neutral-600 bg-white border border-neutral-200 px-1.5 py-0.5 rounded">{page}</span>
                          {i < p.parcours.length - 1 && <span class="text-neutral-300 text-[10px]">&rsaquo;</span>}
                        </Fragment>
                      ))}
