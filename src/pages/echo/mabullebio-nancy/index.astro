                    </div>
                  )}
                </div>
                <div class="flex gap-6 pt-3 border-t border-neutral-100">
                  {[
                    { label: 'Experience', val: p.exp },
                    { label: 'Confiance', val: p.conf },
                    { label: 'Clarte', val: p.clarte },
                  ].map(s => {
                    const sColor = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
                    return (
