---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'rohr-chauffage';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Rohr Chauffage Sanitaire';
const urlSite = 'https://www.rohr-chauffage-sanitaire.com';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 88 76 66 48';
const marcTelLink = 'tel:+33688766648';
const marcWhatsApp = 'https://wa.me/33688766648?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.2,
  confiance: 6.2,
  clarte: 5.2,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'Rohr Chauffage a deux atouts solides : 196 avis a 4,9/5 et des certifications RGE/QualiPac qui ouvrent les droits aux aides d\'Etat (MaPrimeRenov\', CEE). Mais le site ne les exploite pas. Aucune photo de realisations, aucune mention des aides d\'Etat, aucun horaire d\'ouverture. Les visiteurs en phase Comparaison — notamment pour une pompe a chaleur ou une renovation salle de bains — manquent des elements cles pour passer a l\'action.';

const canalData = [
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
  { canal: 'Bouche-a-oreille', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Nathalie',
    age: 48,
    emoji: '🔥',
    situation: 'Proprietaire a Sarreguemines, chaudiere en panne depuis 2 jours en plein mars',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence chaudiere. Elle cherche "chauffagiste Sarreguemines urgence", trouve Rohr en 2e position, voit le logo RGE et le numero, appelle directement. L\'urgence depasse toutes les frictions.',
    localisation: 'Sarreguemines (57200)',
    maturite: 'Decision',
    contexte: 'Sa chaudiere est tombee en panne 2 jours avant. Elle a froid, elle cherche quelqu\'un de disponible rapidement dans sa ville.',
    impression: 'Certifications visibles, telephone accessible, zone confirmee — elle appelle.',
    parcours: [
      ['Google Search mobile', 'Tape "chauffagiste Sarreguemines urgence" — Rohr apparait'],
      ['Accueil', 'Voit RGE, QualiPac, telephone 03 56 57 57 56 — OK'],
      ['Appelle', 'L\'urgence prime — elle n\'a pas besoin d\'en savoir plus'],
    ] as [string, string][],
    questionCle: 'Ils peuvent venir aujourd\'hui ou demain ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le depannage est mentionne mais aucun delai affiché, aucune mention "disponible rapidement" en hero.',
    impactVitesse: 'Sur mobile en urgence, 1 seconde de trop peut faire quitter — estimation mobile mediocre (45-65).',
    impactConfiance: 'RGE et 196 avis rassurent meme sans y preter trop attention.',
    positifs: ['Telephone visible', 'Zone Sarreguemines confirmee', 'Certifications credibilisent', '196 avis 4,9/5'],
    frictions: ['Aucun delai d\'intervention affiche', 'Horaires absents — ne sait pas si quelqu\'un repond', 'Pas de CTA "Urgence" en hero'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 7, clarte: 6,
  },
  {
    id: 2,
    name: 'Kevin',
    age: 34,
    emoji: '♻️',
    situation: 'Jeune proprietaire a Forbach, projet pompe a chaleur — a vu Rohr sur Google Maps (4,9 etoiles)',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Il cherche un installateur PAC RGE pour toucher MaPrimeRenov\'. Voit Rohr sur Maps avec 196 avis a 4,9. Clique sur le site, trouve PAC mentionnee, ne trouve pas les aides d\'Etat — mais les 196 avis suffisent a le convaincre de remplir le formulaire devis.',
    localisation: 'Forbach (57600) — 25 km',
    maturite: 'Comparaison',
    contexte: 'Il veut installer une pompe a chaleur et profiter des aides d\'Etat (MaPrimeRenov\'). Il cherche un artisan certifie RGE dans sa region.',
    impression: 'Google Maps : 196 avis, 4,9 etoiles, certifie RGE — exactement ce qu\'il cherche.',
    parcours: [
      ['Fiche Google Maps', '196 avis, 4,9, lien site — clique'],
      ['Page Chauffage', 'PAC aérothermique et geothermique listees — OK'],
      ['Cherche aides d\'Etat', 'MaPrimeRenov\', CEE — absent du site'],
      ['Formulaire devis', 'Les avis rassurent suffisamment — envoie le formulaire'],
    ] as [string, string][],
    questionCle: 'Je peux avoir MaPrimeRenov\' avec eux ? Ca coute combien en gros ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune mention des aides d\'Etat sur le site malgre le label RGE/QualiPac. Aucune fourchette de prix.',
    impactVitesse: 'Lenteur probable sur mobile peut creer de la frustration entre les pages.',
    impactConfiance: 'Les 196 avis compensent les frictions du site pour ce profil.',
    positifs: ['RGE et QualiPac confirmes — eligibilite aides', 'Tres bonne note Google Maps', 'PAC mentionnee dans les services'],
    frictions: ['Aucune mention MaPrimeRenov\' / CEE — argument de vente manque', 'Pas de fourchette de prix', 'Zone Metz/Nancy/Strasbourg = peu credible pour artisan solo'],
    ceQuiFeraitBasculer: 'Une section "Aides d\'Etat" avec montants indicatifs — argument de conversion majeur.',
    exp: 6, conf: 7, clarte: 4,
  },
  {
    id: 3,
    name: 'Muriel',
    age: 55,
    emoji: '🛁',
    situation: 'Proprietaire a Sarrebourg, compare 3 artisans pour une renovation salle de bains complete',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle compare 3 chauffagistes-plombiers pour une renovation complete. Elle cherche des photos de realisations. Sur le site Rohr : zero photo. Elle envoie aussi le formulaire chez un concurrent qui montre ses chantiers en photos.',
    localisation: 'Sarrebourg (57400) — 40 km',
    maturite: 'Comparaison',
    contexte: 'Budget renovation salle de bains : 8 000 a 15 000 euros. Elle veut voir la qualite des finitions avant de choisir. Elle compare 3 artisans.',
    impression: 'Site propre, certifications credibles. Mais elle cherche immediatement une galerie photos.',
    parcours: [
      ['Accueil desktop', 'Bonne premiere impression, RGE visible'],
      ['Page Salle de bains', 'Services listes (WC, douches, baignoires) — pas de photos'],
      ['Navigation', 'Cherche "Realisations" ou "Galerie" dans le menu — absent'],
      ['Contact', 'Envoie le formulaire mais aussi celui du concurrent avec photos'],
    ] as [string, string][],
    questionCle: 'Ils font des belles salles de bains ? Je veux voir leur travail avant de les appeler.',
    reponse: 'Non' as const,
    commentReponse: 'Aucune photo de realisation sur tout le site. La salle de bains est un achat emotionnel — les photos sont indispensables.',
    impactVitesse: 'Acceptable sur desktop.',
    impactConfiance: '196 avis rassurent mais ne remplacent pas les photos pour un achat visuel.',
    positifs: ['Certifications credibles (RGE, Qualibat)', '196 avis 4,9 — excellente preuve sociale', 'Services clairement listes'],
    frictions: ['Aucune photo de realisation', 'Aucune fourchette de prix', 'Pas de page Realisations dans le menu'],
    ceQuiFeraitBasculer: '6 a 8 photos avant/apres de salles de bains renovees avec type de travaux et ville.',
    exp: 5, conf: 6, clarte: 5,
  },
  {
    id: 4,
    name: 'Jean-Marc',
    age: 62,
    emoji: '📞',
    situation: 'Retraite a Sarreguemines, recommande par son fils qui a fait appel a Rohr pour une chaudiere',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Son fils lui a recommande Rohr. Il tape le nom, trouve le site, veut appeler — mais ne sait pas quand. Les horaires sont absents. Il reporte l\'appel au lendemain.',
    localisation: 'Sarreguemines (57200)',
    maturite: 'Decision',
    contexte: 'La recommandation de son fils est forte. Il veut juste confirmer l\'identite et trouver un moment pour appeler. Un detail manquant — les horaires — bloque inutilement le passage a l\'action.',
    impression: '"Rohr Christophe SAS" — c\'est bien eux. Il cherche quand appeler.',
    parcours: [
      ['Accueil', 'Identite confirmee, telephone visible'],
      ['Footer et Contact', 'Cherche horaires d\'ouverture — absents'],
      ['Hesite', 'Ne sait pas s\'il va deranger en appelant maintenant'],
    ] as [string, string][],
    questionCle: 'Je peux appeler maintenant ? Ils sont ouverts ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucun horaire affiche nulle part sur le site. Friction simple mais inutile pour un visiteur en Decision.',
    impactVitesse: 'Sans objet — desktop, pas en urgence.',
    impactConfiance: 'La recommandation familiale est le principal vecteur de confiance.',
    positifs: ['Telephone disponible', 'Identite claire', 'Certifications rassurent'],
    frictions: ['Horaires absents — bloquant pour appeler sereinement', 'Pas d\'email affiche comme alternative'],
    ceQuiFeraitBasculer: 'Horaires d\'ouverture en header ou footer — correction de 5 minutes.',
    exp: 5, conf: 6, clarte: 5,
  },
  {
    id: 5,
    name: 'Arnaud',
    age: 41,
    emoji: '🏢',
    situation: 'Proprietaire de 4 appartements a Metz, cherche un plombier pour interventions recurrentes',
    canal: 'Reseaux sociaux',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Il voit une publication Facebook Rohr Chauffage. Il cherche un partenaire pour son parc locatif. Le site ne mentionne pas de clients professionnels, pas de SIRET, pas d\'assurance pro. Il passe au suivant — ce n\'est pas la cible.',
    localisation: 'Metz (57000) — 65 km',
    maturite: 'Decouverte',
    contexte: 'Il gere 4 appartements et cherche un plombier de confiance pour des interventions regulieres (entretien chaudiere, petites reparations). Il cherche un artisan assure et structure.',
    impression: 'Artisan competent pour les particuliers — pas le bon profil pour du locatif pro.',
    parcours: [
      ['Publication Facebook', 'Voit Rohr Chauffage — clique par curiosite'],
      ['Accueil', 'Oriente particuliers, pas de mention pro ou locatif'],
      ['Cherche SIRET, assurance', 'Absents — quitte'],
    ] as [string, string][],
    questionCle: 'Ils travaillent avec les proprietaires bailleurs ? Ils sont assures ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune mention de clientele professionnelle. SIRET absent. Assurance decennale non mentionnee. C\'est hors cible — et c\'est normal.',
    impactVitesse: 'Sans objet.',
    impactConfiance: 'Absence de SIRET et assurance = signal d\'amateurisme pour un profil pro.',
    positifs: ['Zone de Metz mentionnee', 'Certifications visibles'],
    frictions: ['Aucune mention clientele pro ou locatif', 'SIRET absent', 'Assurance decennale non mentionnee'],
    ceQuiFeraitBasculer: 'Hors cible — Rohr Chauffage est oriente particuliers, ce qui est coherent avec son positionnement.',
    exp: 4, conf: 5, clarte: 6,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Ajouter une section Aides d\'Etat sur la page Chauffage (MaPrimeRenov\', CEE)',
    pourquoi: '2 visiteurs sur 5 — et probablement la majorite de vos prospects PAC — cherchent si leurs travaux sont eligibles aux aides d\'Etat. Vous etes certifie RGE et QualiPac. Ca veut dire jusqu\'a 11 000 euros de prime pour une pompe a chaleur. Mais votre site n\'en dit rien. Chaque visiteur qui ne trouve pas la reponse chez vous va la chercher chez un concurrent.',
    action: 'Ajouter un encart sur la page Chauffage et en accueil : "Certifie RGE et QualiPac — vos travaux sont eligibles a MaPrimeRenov\' et aux Certificats d\'Economie d\'Energie (jusqu\'a 11 000 euros de prime pour une pompe a chaleur)." + lien vers France Renov\' pour simulation. C\'est 30 minutes de travail pour un argument de conversion majeur.',
    impact: '2 a 3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A estimer', ok: false, detail: 'API indisponible — estimation : 45-65 sur mobile, sous le seuil bon (90+).' },
  { label: 'Securite', verdict: 'Moyen (C)', ok: false, detail: 'Grade C / 55 sur 100 — CSP et HSTS manquants.' },
  { label: 'SEO technique', verdict: 'Partiel', ok: false, detail: 'Sitemap OK (11 URLs) — robots.txt absent — Schema.org manquant.' },
  { label: 'Donnees structurees', verdict: 'Absent', ok: false, detail: 'Schema.org LocalBusiness non detecte — etoiles et telephone pas affichables dans Google.' },
  { label: 'Partage reseaux', verdict: 'Non configure', ok: false, detail: 'Open Graph absent — partage Facebook/WhatsApp sans image ni description.' },
];

const tech = {
  observatory: { grade: 'C', score: 55, testsOk: 8, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Estime 3-5s (mauvais)', inp: 'Non mesure', cls: 'Potentiellement eleve' },
  headers: [
    { ok: true, h: 'Redirection HTTP vers HTTPS' },
    { ok: true, h: 'X-Frame-Options : SAMEORIGIN' },
    { ok: true, h: 'X-Content-Type-Options : nosniff' },
    { ok: true, h: 'Referrer-Policy : same-origin' },
    { ok: true, h: 'Cookies securises (HttpOnly)' },
    { ok: false, h: 'Content-Security-Policy (absent — risque injection XSS)' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (absent — risque downgrade HTTPS)' },
  ],
  schema: [
    { item: 'JSON-LD / Schema.org present', ok: false },
    { item: '@type Plumber ou LocalBusiness', ok: false },
    { item: 'name, url, telephone', ok: false },
    { item: 'address + geo (coordonnees)', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'aggregateRating (4,9/5 sur 196 avis)', ok: false },
    { item: 'sameAs (Facebook, Instagram)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Non detecte' },
    { item: 'og:description', ok: false, val: 'Non detecte' },
    { item: 'og:image', ok: false, val: 'Non detecte' },
    { item: 'og:url', ok: false, val: 'Non detecte' },
    { item: 'twitter:card', ok: false, val: 'Non detecte' },
  ],
  seo: [
    { item: 'H1 unique par page', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'sitemap.xml accessible (11 URLs)', ok: true },
    { item: 'Schema.org LocalBusiness', ok: false },
    { item: 'robots.txt accessible', ok: false },
    { item: 'Open Graph configure', ok: false },
    { item: 'Sitemap mis a jour recemment (dernier : juillet 2024)', ok: false },
  ],
};

const alertes: { type: 'critique' | 'important'; titre: string; detail: string; chiffre: string; chiffreLabel: string }[] = [
  { type: 'critique' as const, titre: '0 donnees structurees', detail: 'Schema.org absent — vos 196 avis a 4,9/5 n\'apparaissent pas en etoiles dans Google Search. Perte directe de clics et de conversions.', chiffre: '0', chiffreLabel: 'champs Schema.org' },
  { type: 'important' as const, titre: 'Aides d\'Etat absentes du site', detail: 'Vous etes certifie RGE et QualiPac — jusqu\'a 11 000€ d\'aides pour une PAC. Aucun visiteur ne le sait en lisant votre site. Argument de vente majeur manque.', chiffre: 'RGE', chiffreLabel: 'certification non valorisee' },
  { type: 'important' as const, titre: 'Aucune photo de realisation', detail: 'Pour un projet renovation salle de bains (8 000-15 000€), les visiteurs veulent voir votre travail avant de vous contacter. Zero photo = frein direct.', chiffre: '0', chiffreLabel: 'photos de chantiers' },
];

---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 2b. ALERTES -->
{alertes.length > 0 && (
  <section style="background: #fefce8;" class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <div>
          <h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2>
          <p class="text-sm text-neutral-600">
            {alertes.filter(a => a.type === 'critique').length > 0 && <span class="text-red-700 font-medium">{alertes.filter(a => a.type === 'critique').length} critique{alertes.filter(a => a.type === 'critique').length > 1 ? 's' : ''}</span>}
            {alertes.filter(a => a.type === 'critique').length > 0 && alertes.filter(a => a.type === 'important').length > 0 && <span class="mx-1 text-neutral-400">·</span>}
            {alertes.filter(a => a.type === 'important').length > 0 && <span class="text-amber-700 font-medium">{alertes.filter(a => a.type === 'important').length} important{alertes.filter(a => a.type === 'important').length > 1 ? 's' : ''}</span>}
          </p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {alertes.map(a => (
          <div class={`bg-white rounded-xl p-5 ${a.type === 'critique' ? 'border-2 border-red-300' : 'border border-amber-200'}`}>
            <div class="flex items-start gap-4">
              <div class={`text-2xl font-black rounded-lg px-3 py-1 shrink-0 ${a.type === 'critique' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>{a.chiffre}</div>
              <div>
                <p class="font-semibold text-neutral-900 text-sm mb-1">{a.titre}</p>
