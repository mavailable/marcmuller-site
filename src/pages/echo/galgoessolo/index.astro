    { ok: true, h: 'Strict-Transport-Security (HSTS)' },
    { ok: true, h: 'Referrer-Policy' },
    { ok: true, h: 'X-Content-Type-Options (nosniff)' },
    { ok: true, h: 'HTTPS actif' },
  ],
  schema: [
    { item: 'JSON-LD present (2 blocs)', ok: true },
    { item: 'WebSite (basique)', ok: true },
    { item: 'LocalBusiness (mais mauvais type pour ce business)', ok: false },
    { item: 'Person (Jennifer Varner) — manque', ok: false },
    { item: 'Service / OfferCatalog (les packs) — manque', ok: false },
    { item: 'BreadcrumbList — manque', ok: false },
    { item: 'FAQPage — manque', ok: false },
    { item: 'sameAs (vers profils sociaux) — manque', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'Present' },
    { item: 'og:description', ok: true, val: 'Present' },
    { item: 'og:url', ok: true, val: 'Present' },
    { item: 'og:site_name', ok: true, val: 'Present' },
    { item: 'og:type', ok: true, val: 'Present' },
    { item: 'og:image', ok: false, val: 'Absent' },
    { item: 'twitter:card', ok: true, val: 'Present' },
    { item: 'twitter:title', ok: true, val: 'Present' },
    { item: 'twitter:description', ok: true, val: 'Present' },
    { item: 'twitter:image', ok: false, val: 'Absent' },
  ],
  seo: [
    { item: 'HTTPS actif', ok: true },
    { item: 'Title optimise', ok: true },
    { item: 'Meta description (148 caracteres)', ok: true },
    { item: 'H1 unique par page', ok: true },
    { item: 'lang="en" defini', ok: true },
    { item: 'Canonical defini', ok: true },
    { item: 'Viewport mobile', ok: true },
    { item: 'llms.txt (referentiel IA 2026)', ok: false },
  ],
};

function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200';
  if (d === 'Hesite') return 'border-amber-200';
  return 'border-neutral-200';
}
function decisionBadge(d: string) {
  if (d === 'Convertit') return 'bg-green-600';
  if (d === 'Hesite') return 'bg-amber-500';
  return 'bg-neutral-400';
}
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath={`/echo/${slug}`}
>

  <!-- HERO -->
  <section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
    <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #14B8A6; opacity: 0.08;"></div>
    <div class="absolute bottom-[10%] right-[5%] w-[300px] h-[300px] rounded-full blur-[120px] pointer-events-none" style="background: #FBBF24; opacity: 0.05;"></div>

    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
        {formuleLabel} &middot; Rapport confidentiel
      </div>

      <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
        {verdictHero}
      </h1>

      <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
        Site analyse : <a href={urlSite} target="_blank" rel="noopener" class="underline hover:text-white transition-colors">{urlSite}</a> &middot; {kpis.nbPersonas} visiteuses simulees &middot; {dateAudit}
      </p>

      <div class="grid grid-cols-3 gap-4">
        <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
          <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
          <div class="text-sm text-green-400/70">reservent</div>
        </div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
          <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
          <div class="text-sm text-amber-400/70">hesitent</div>
        </div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
          <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
          <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONSTAT -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(20,184,166,0.04); border-color: #14B8A6;">
      <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
    </div>

    <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteuses</h2>
    <p class="text-sm text-neutral-500 mb-6">Et combien reservent un call selon leur canal d'arrivee.</p>

    <div class="space-y-4 mb-12">
      {canalData.map(c => {
        const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
        return (
          <div class="flex items-center gap-4">
            <div class="w-52 text-sm text-neutral-700 shrink-0">{c.canal}</div>
            <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
            </div>
            <div class="w-20 text-right">
              <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
              <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
            </div>
          </div>
        );
      })}
    </div>

    <details class="group">
      <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
        <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        Voir les scores moyens (experience, confiance, clarte)
      </summary>
      <div class="grid grid-cols-3 gap-4 mt-3">
        {[
          { label: 'Experience', val: kpis.experience },
          { label: 'Confiance', val: kpis.confiance },
          { label: 'Clarte', val: kpis.clarte },
        ].map(s => {
          const sColor = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
          return (
            <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
              <div class={`text-2xl font-bold mb-1 ${sColor}`}>{s.val}<span class="text-sm text-neutral-400">/10</span></div>
              <div class="text-xs text-neutral-500">{s.label}</div>
            </div>
          );
        })}
      </div>
    </details>
  </section>

  <!-- ALERTES -->
  <section class="py-12" style="background: #fefce8;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
        <div>
          <h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2>
          <p class="text-sm text-neutral-600">
            {alertes.filter(a => a.type === 'critique').length} critiques &middot; {alertes.filter(a => a.type === 'important').length} importants
          </p>
        </div>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        {alertes.map(a => (
          <div class={`bg-white rounded-xl p-5 ${a.type === 'critique' ? 'border-2 border-red-300' : 'border border-amber-300'}`}>
            <div class={`inline-block text-2xl font-black px-3 py-1 rounded-lg mb-3 ${a.type === 'critique' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>
              {a.chiffre}
            </div>
            <p class="text-[10px] text-neutral-400 uppercase tracking-wider mb-1">{a.chiffreLabel}</p>
            <h3 class="font-semibold text-neutral-900 text-sm mb-2">{a.titre}</h3>
            <p class="text-xs text-neutral-600 leading-relaxed">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VOS VISITEURS -->
  <section class="py-16" style="background: #fafafa;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteuses</h2>
      <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche du conseil voyage solo Thailande/Koh Tao et tombe sur votre site.</p>

      <!-- Convertit -->
      <div class="mb-10">
        <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
          Celles qui reservent
          <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
