                </div>
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- Hesite -->
      <div class="mb-4">
        <h3 class="text-base font-bold text-amber-800 mb-4 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block"></span>
