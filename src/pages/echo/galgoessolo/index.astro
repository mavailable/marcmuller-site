                      <ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">{'·'}</span>{pt}</li>)}</ul>
                    </div>
                    <div>
                      <p class="font-semibold text-amber-700 mb-1.5">{'✗'} Frictions</p>
                      <ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">{'·'}</span>{f}</li>)}</ul>
                    </div>
                  </div>
                  {p.ceQuiFeraitBasculer && (
                    <div class="rounded-lg p-3" style="background: rgba(20,184,166,0.06);">
                      <p class="font-semibold text-[10px] uppercase tracking-wider mb-1" style="color: #14B8A6;">Ce qui la ferait passer a l'action</p>
                      <p class="text-neutral-700 text-xs">{p.ceQuiFeraitBasculer}</p>
                    </div>
                  )}
                  <div class="flex gap-6 pt-3 border-t border-neutral-100">
                    {[{ label: 'Experience', val: p.exp }, { label: 'Confiance', val: p.conf }, { label: 'Clarte', val: p.clarte }].map(s => {
                      const sc = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
                      return (
                        <div class="text-center">
                          <span class={`block text-lg font-bold ${sc}`}>{s.val}</span>
                          <span class="text-[10px] text-neutral-400">{s.label}</span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- Micro-CTA hesitants -->
      <div class="rounded-xl p-5 mb-10 bg-amber-50 border border-amber-200 flex items-start gap-3">
        <span class="text-lg shrink-0 mt-0.5">{'\u{1F4A1}'}</span>
        <div>
          <p class="text-sm font-medium text-amber-900">Ces {kpis.nbHesitent} visiteuses ont besoin de votre conseil.</p>
          <p class="text-xs text-amber-700 mt-1">Il leur manque a chacune un signal de confiance precis : une photo de Gal, un Instagram a verifier, un pack 90 min, un temoignage de leur tranche d'age. C'est votre plus grand levier de conversion : un seul element en plus sur la home et la moitie d'entre elles passent a l'action.</p>
        </div>
