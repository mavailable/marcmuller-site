  },
  {
    id: 5, name: 'Nicolas', age: 40, emoji: '🏢',
    situation: 'Gerant d\'immeuble, travaux toiture apres sinistre assurance',
    canal: 'Google Search', device: 'Desktop', decision: 'Quitte', decisionLabel: 'Repart',
    histoire: 'Besoin d\'un couvreur assure pour un chantier d\'immeuble. Le site ne mentionne ni assurance decennale ni references d\'immeubles. Impossible de presenter au syndic.',
    localisation: 'Metz', maturite: 'Comparaison',
    contexte: 'Sinistre assurance, expertise ordonnee. 3 devis requis. Budget 25 000€.',
    impression: 'Pas d\'assurance decennale affichee. Impossible pour un chantier de cette taille.',
    parcours: [['Accueil', 'Cherche mentions assurance — rien'], ['Realisations', 'Pas de reference immeuble']],
    questionCle: 'Assurance decennale ? References immeuble ?',
    reponse: 'Non', commentReponse: 'Aucune mention d\'assurance ni de references grands chantiers',
    positifs: ['Schema.org present'],
    frictions: ['Assurance decennale non mentionnee', 'Pas de references immeubles', 'Email Gmail pas pro'],
    ceQuiFeraitBasculer: '', exp: 4, conf: 4, clarte: 5,
