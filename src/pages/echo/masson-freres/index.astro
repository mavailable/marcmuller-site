---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'masson-freres';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Masson Freres';
const urlSite = 'https://www.massonfreres.com';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.0,
  confiance: 6.6,
  clarte: 5.0,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart sans rien faire.';

const constat = 'Votre site rassure ceux qui vous cherchent deja — les urgences et les recommandes appellent. Mais ceux qui comparent repartent faute de voir vos certifications RGE en evidence et sans pouvoir vous ecrire un email.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Laurent',
    age: 48,
    emoji: '🏠',
    situation: 'Proprietaire a Woippy (57140), toiture qui fuit apres les pluies',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence sinistre — le telephone est visible dans le footer et la mention "intervention urgente" le convainc d\'appeler avant d\'avoir tout lu.',
    localisation: 'Woippy (57140)',
    maturite: 'Decision',
    contexte: 'Sinistre en cours apres fortes pluies. Il cherche sur Google "couvreur urgence Metz" et arrive sur le site.',
    impression: 'H1 "Couvreur a Metz" clair, mais le site met 5 secondes a charger. Il scanne pour trouver un numero.',
    parcours: [
      ['Hero', 'Voit "intervention urgente en cas de sinistre" dans le texte — rassurant'],
      ['Footer', 'Trouve le 09 75 93 61 25 et le 06 62 57 00 08 (Frederic)'],
      ['Appel', 'Compose directement depuis son mobile'],
    ] as [string, string][],
    questionCle: 'Est-ce qu\'ils interviennent en urgence et comment les appeler tout de suite ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Mention urgence presente mais noyee dans un paragraphe, pas en hero. Telephone accessible en scrollant.',
    impactVitesse: 'Frustrant : 5 secondes de chargement en urgence. Il trouve quand meme le numero avant d\'abandonner.',
    impactConfiance: 'Grade B- Observatory irrelevant pour lui — il veut juste un numero.',
    positifs: ['Telephone visible dans le footer', 'Mention intervention urgente presente', 'Certification RGE citee'],
    frictions: ['CTA urgence absent du hero', 'Site lent sur mobile', 'Aucun email pour contact ecrit'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 7, clarte: 6,
  },
  {
    id: 2,
    name: 'Sylvie',
    age: 62,
    emoji: '🏚️',
    situation: 'Proprietaire a Thionville (57100), veut refaire la toiture avant la vente',
    canal: 'Google Maps',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Convaincue par les 51 avis 4.6 etoiles, elle envoie le formulaire mais attend aussi 2 autres devis car aucune fourchette de prix n\'est affichee.',
    localisation: 'Thionville (57100)',
    maturite: 'Comparaison',
    contexte: 'Elle compare 3 couvreurs depuis Google Maps. Elle a lu les avis avant d\'aller sur le site.',
    impression: 'Site WordPress Divi, design basique mais lisible. Voit "20 ans d\'experience" et "RGE Qualibat". Cherche les prix.',
    parcours: [
      ['Accueil', 'Lit les 3 temoignages clients — Christophe, Laurent, Thibaut. Positif.'],
      ['Realisations', 'Photos presentes. Cherche des chantiers similaires a sa toiture (tuiles, annees 60). Pas de legende.'],
      ['La societe', 'Lit l\'historique. Garantie decennale mentionnee. Toujours pas de prix.'],
      ['Contact', 'Remplit le formulaire mais en attente des 2 autres devis pour comparer.'],
    ] as [string, string][],
    questionCle: 'Quel tarif approximatif pour une renovation complete de toiture ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune indication tarifaire, pas meme "tarif sur devis" avec fourchette indicative.',
    impactVitesse: 'Desktop, page realisations lente. Quelques secondes d\'attente pour les photos.',
    impactConfiance: 'Les avis Google (51, 4.6) rassurent plus que le site lui-meme.',
    positifs: ['3 temoignages avec prenom visible', 'Note Google 4.6 sur 51 avis', 'Garantie decennale mentionnee', 'Galerie de realisations existante'],
    frictions: ['Aucune fourchette de prix', 'Photos sans contexte (superficie, materiau)', 'Logo RGE absent du hero'],
    ceQuiFeraitBasculer: 'Une fourchette indicative "toiture 100m2 : a partir de X euros" accelererait la decision de 48h.',
    exp: 5, conf: 7, clarte: 4,
  },
  {
    id: 3,
    name: 'Jerome',
    age: 35,
    emoji: '🔧',
    situation: 'Gestionnaire de patrimoine immobilier a Metz (57000), 12 logements en location',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Recommande par un autre bailleur — il va sur le site uniquement pour valider la certification RGE. La mention suffit pour appeler Frederic.',
    localisation: 'Metz (57000)',
    maturite: 'Decision',
    contexte: 'Un autre bailleur lui a donne le numero de Masson Freres. Il verifie le site avant d\'appeler pour confirmer le RGE (MaPrimeRenov obligatoire).',
    impression: 'Site professionnel, structure claire. Cherche immediatement "RGE" ou "Qualibat". Trouve dans un paragraphe.',
    parcours: [
      ['Accueil', 'Repere "certifie RGE QUALIBAT" dans le texte. Suffisant.'],
      ['La societe', 'Confirme 20 ans d\'experience, garantie decennale.'],
      ['Appel', 'Appelle le 06 62 57 00 08 (Frederic) directement.'],
    ] as [string, string][],
    questionCle: 'Sont-ils bien certifies RGE pour que mes locataires beneficient de MaPrimeRenov ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'RGE cite oralement mais aucun logo officiel ni lien vers attestation. Il fait confiance a la recommandation.',
    impactVitesse: 'Desktop, chargement correct.',
    impactConfiance: 'La recommandation personnelle pese plus que tout signal technique.',
    positifs: ['RGE Qualibat mentionne', 'Garantie decennale', 'Telephone Frederic visible', 'Recommandation confirme'],
    frictions: ['Pas de logo RGE officiel avec lien vers attestation', 'Pas d\'email pro pour cahier des charges', 'Pas de reference a des clients professionnels (bailleurs)'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 8, clarte: 6,
  },
  {
    id: 4,
    name: 'Amina',
    age: 29,
    emoji: '📱',
    situation: 'Locataire a Metz centre, cherche un couvreur pour son proprietaire bailleur',
    canal: 'Reseaux sociaux',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Cherche un email a transmettre a son proprietaire — impossible a trouver. Le site lent sur mobile aggrave la frustration. Repart bredouille.',
    localisation: 'Metz centre (57000)',
    maturite: 'Decouverte',
    contexte: 'A clique sur un lien de la page Facebook Masson Freres. Elle n\'est pas la decision-maker, elle relaie la demande de son proprietaire.',
    impression: 'Site lent. Voit "Couvreur a Metz". Scanne pour trouver un email rapidement.',
    parcours: [
      ['Accueil', 'Scanne le header et footer. Telephone visible. Pas d\'email.'],
      ['Contact', 'Trouve le formulaire et le telephone. Toujours pas d\'email.'],
      ['Abandon', 'Son proprietaire ne veut pas remplir un formulaire. Elle note le telephone mais ne peut pas le copier facilement.'],
    ] as [string, string][],
    questionCle: 'Quel est leur email pour que je transmette la demande a mon proprietaire ?',
    reponse: 'Non' as const,
    commentReponse: 'Email totalement absent du site. Seul formulaire de contact disponible.',
    impactVitesse: 'Tres lent sur mobile (5-6 secondes). Aggrave la frustration d\'une recherche deja infructueuse.',
    impactConfiance: 'Irrelevant — elle cherche juste un email.',
    positifs: ['Telephone accessible en fin de page'],
    frictions: ['Aucun email affiche nulle part', 'Site tres lent sur mobile', 'Formulaire inadapte pour relayer a un tiers'],
    ceQuiFeraitBasculer: 'Un email visible en page contact et dans le footer.',
    exp: 3, conf: 5, clarte: 4,
  },
  {
    id: 5,
    name: 'Didier',
    age: 55,
    emoji: '🏗️',
    situation: 'Architecte independant a Metz (57050), cherche un couvreur-zingueur RGE pour chantier de renovation',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Qualite reconnue et experience solide, mais les certifications sans logo officiel et les photos de chantiers sans legende technique ne le differencient pas assez de ses 2 autres options.',
    localisation: 'Metz (57050)',
    maturite: 'Comparaison',
    contexte: 'Cherche "couvreur zingueur RGE Metz" sur Google pour un DOE de renovation patrimoniale. Compare 3 artisans.',
    impression: 'Site clair, services bien listes. "RGE Qualibat" confirme. Cherche des preuves techniques differenciantes.',
    parcours: [
      ['Accueil', 'Services couverture/charpente/zinguerie visibles. RGE cite. Logo officiel absent.'],
      ['La societe', '20 ans experience. Aucune liste formelle de certifications avec logos.'],
      ['Realisations', 'Photos presentes mais sans legendes : type de couverture, materiau, surface, date.'],
      ['Contact', 'Hesite. Envoie le formulaire mais compare encore 2 concurrents.'],
    ] as [string, string][],
    questionCle: 'Ont-ils les certifications et les references pour un chantier de renovation patrimoniale en zinguerie ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'RGE cite verbalement, competence probable, mais preuves techniques insuffisantes vs concurrents mieux documentes.',
    impactVitesse: 'Desktop, chargement acceptable.',
    impactConfiance: 'Schema.org incomplet lui donne une impression de site "un peu en retard techniquement".',
    positifs: ['Services zinguerie clairement presentes', 'Experience 20 ans credible', 'RGE Qualibat mentionne'],
    frictions: ['Certifications sans logo officiel ni lien attestation', 'Photos de realisations sans legende technique', 'Pas d\'email pro pour DOE', 'Pas de fiche technique par savoir-faire'],
    ceQuiFeraitBasculer: 'Logos certifications avec lien + au moins 3 photos de chantiers zinguerie avec materiau et surface indiques.',
    exp: 5, conf: 6, clarte: 5,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Afficher les badges RGE Qualibat + un email de contact',
    pourquoi: 'RGE est la certification qui declenche MaPrimeRenov et les aides CEE — vos clients la cherchent avant tout. Sans badge visible, ils doutent meme si vous etes certifie. Et sans email, ceux qui ne veulent pas remplir un formulaire partent chez un concurrent.',
    action: 'Ajouter les logos officiels RGE et Qualibat (telechargeables sur qualibat.com) dans la section hero ou juste sous le H1. Afficher un email professionnel (ex: contact@massonfreres.com) sur la page contact et dans le footer.',
    impact: '4 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Lente', ok: false, detail: 'WordPress Divi non optimise — chargement > 4s sur mobile' },
  { label: 'Securite', verdict: 'B-', ok: false, detail: 'CSP absent, Permissions-Policy absent (3 tests echoues sur 10)' },
  { label: 'SEO', verdict: 'Correct', ok: true, detail: 'Yoast actif, meta OK, robots.txt et sitemap valides' },
  { label: 'Donnees structurees', verdict: 'Incomplet', ok: false, detail: 'LocalBusiness Schema manquant — adresse et telephone non declares' },
  { label: 'Partage reseaux', verdict: 'OK', ok: true, detail: 'Open Graph et Twitter Cards bien configures' },
];

const tech = {
  observatory: { grade: 'B-', score: 65, testsOk: 7, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible (quota API)', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'Strict-Transport-Security (HSTS) — max-age=31536000' },
    { ok: true, h: 'X-Content-Type-Options — nosniff' },
    { ok: true, h: 'X-Frame-Options — SAMEORIGIN' },
    { ok: true, h: 'X-XSS-Protection — 1; mode=block' },
    { ok: true, h: 'Referrer-Policy — no-referrer-when-downgrade' },
    { ok: true, h: 'HTTPS actif' },
    { ok: false, h: 'Content-Security-Policy (absent — risque XSS)' },
    { ok: false, h: 'Permissions-Policy (absent)' },
    { ok: false, h: 'Cross-Origin headers COOP/COEP (absents)' },
  ],
  schema: [
    { item: 'JSON-LD present (WebPage + Organization via Yoast)', ok: true },
    { item: 'LocalBusiness Schema (absent — critique pour couvreur local)', ok: false },
    { item: 'address + geo (absent du JSON-LD)', ok: false },
    { item: 'telephone dans le JSON-LD (absent)', ok: false },
    { item: 'openingHours (absent)', ok: false },
    { item: 'aggregateRating 4.6/51 avis (present)', ok: true },
    { item: 'sameAs reseaux sociaux (absent)', ok: false },
    { item: 'areaServed / zone d\'intervention (absent)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'Couvreur a Metz - MASSON FRERES' },
    { item: 'og:description', ok: true, val: 'Present et pertinent' },
    { item: 'og:image', ok: true, val: '/wp-content/uploads/2020/10/Construction-88-3.png' },
    { item: 'og:url', ok: true, val: 'https://www.massonfreres.com/' },
    { item: 'og:type', ok: true, val: 'website' },
    { item: 'og:locale', ok: true, val: 'fr_FR' },
    { item: 'twitter:card', ok: true, val: 'summary_large_image' },
  ],
  seo: [
    { item: 'Un seul H1 par page ("Couvreur a Metz")', ok: true },
    { item: 'Meta description pertinente et presente', ok: true },
    { item: 'robots.txt accessible et bien configure', ok: true },
    { item: 'sitemap_index.xml accessible', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'Page "Peinture" listee en meta mais absente du menu et sitemap', ok: false },
    { item: 'Images avec alt text (non verifiable — JS lazy-load)', ok: false },
    { item: 'Cache HTTP tres court (max-age=60s) sur les assets', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO — Verdict immediat -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>

  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilite, fluidite</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Credibilite, preuves, rassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
        <p class="text-[10px] text-neutral-400 mt-1">Comprehension de l'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <!-- Ceux qui contactent -->
    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent
        <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group persona-card bg-white rounded-xl overflow-hidden shadow-sm border border-green-200" data-canal={p.canal}>
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p>
                  <p class="text-neutral-600">{p.contexte}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p>
                  <p class="text-neutral-600">{p.impression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
