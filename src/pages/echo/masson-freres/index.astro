const alertes = [
  { type: 'critique' as const, titre: 'Site extremement lent sur mobile', detail: 'WordPress + Divi est l\'une des combinaisons les plus lourdes du web. Sur mobile, votre site met 5-8 secondes a charger. 53% des visiteurs mobiles quittent un site qui met plus de 3 secondes. Avec 60% de trafic mobile, c\'est votre frein #1.', chiffre: '~6s', chiffreLabel: 'temps de chargement mobile' },
  { type: 'critique' as const, titre: 'Aucune mention d\'assurance decennale', detail: 'Un couvreur sans assurance decennale affichee = un signal d\'alarme pour les proprietaires. Les projets >5000€ (refection toiture, charpente) exigent cette garantie. Les architectes ne travaillent qu\'avec des artisans assures.', chiffre: '0', chiffreLabel: 'mention assurance' },
  { type: 'important' as const, titre: '60 avis Google invisibles sur le site', detail: '4.5 etoiles sur 60 avis — c\'est une excellente reputation. Mais seuls les visiteurs Google Maps les voient. Ceux qui arrivent par Google Search, IA ou reseaux sociaux ne voient aucun temoignage sur votre site.', chiffre: '0/60', chiffreLabel: 'avis affiches sur le site' },
  { type: 'important' as const, titre: 'Aucun tarif indicatif', detail: 'Les proprietaires qui comparent 3 couvreurs contactent en priorite ceux qui affichent un ordre de grandeur. "Refection toiture a partir de X€/m²" filtre les mauvais profils et rassure les bons.', chiffre: '0', chiffreLabel: 'prix affiche' },
];

const personas = [
  {
    id: 1, name: 'Philippe', age: 52, emoji: '🌧️',
    situation: 'Proprietaire a Metz, fuite de toiture urgente apres tempete',
