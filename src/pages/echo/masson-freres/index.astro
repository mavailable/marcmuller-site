---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'masson-freres';
const formule = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Masson Freres';
const urlSite = 'https://www.massonfreres.com/';
const dateAudit = '1er avril 2026';
const isProspection = true;
const showUpsell = true;

const title = 'Echo Decouverte — Masson Freres | Marc M';
const description = 'Analyse de massonfreres.com : simulation de 10 visites clients, audit technique, recommandations. Rapport confidentiel.';

const kpis = { nbPersonas: 10, nbConvertissent: 4, nbHesitent: 3, nbRepartent: 3, conversion: 40, experience: 5.5, confiance: 5.7, clarte: 5.0 };

const verdictHero = '4 clients sur 10 vous contactent. 6 repartent — parce que votre site met 6 secondes a s\'afficher sur leur telephone.';

const constat = '60 avis Google a 4.5 etoiles, des services solides (couverture, charpente, zinguerie, isolation) et une reputation locale etablie. Mais votre site est si lourd que les visiteurs sur mobile n\'ont pas la patience d\'attendre. Et ceux qui restent ne trouvent ni vos tarifs, ni votre assurance decennale, ni vos avis — les 3 choses qu\'un proprietaire cherche avant d\'appeler un couvreur.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Maps', nb: 2, convert: 2, rate: 100 },
  { canal: 'Google Search', nb: 3, convert: 1, rate: 33 },
  { canal: 'IA (ChatGPT / Perplexity)', nb: 2, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 2, convert: 0, rate: 0 },
