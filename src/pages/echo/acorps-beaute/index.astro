      <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white"><summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50"><div class="flex items-center gap-3"><span class="text-base">&#128274;</span><div><h3 class="font-semibold text-neutral-900 text-sm">Headers de securite</h3><p class="text-[11px] text-neutral-500">{techVerdicts[1].detail}</p></div></div><svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary><div class="px-4 pb-4 border-t border-neutral-100 pt-4"><div class="space-y-2">{tech.headers.map(s => (<div class="flex items-start gap-2 text-xs text-neutral-600"><span class={`shrink-0 font-bold ${s.ok ? 'text-green-500' : 'text-red-400'}`}>{s.ok ? '✓' : '✗'}</span><span>{s.h}</span></div>))}</div></div></details>
      <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white"><summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50"><div class="flex items-center gap-3"><span class="text-base">&#128202;</span><div><h3 class="font-semibold text-neutral-900 text-sm">Donnees structurees (Schema.org)</h3><p class="text-[11px] text-neutral-500">{techVerdicts[3].detail}</p></div></div><svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary><div class="px-4 pb-4 border-t border-neutral-100 pt-4"><div class="space-y-2">{tech.schema.map(s => (<div class="flex items-start gap-2 text-xs text-neutral-600"><span class={`shrink-0 font-bold ${s.ok ? 'text-green-500' : 'text-red-400'}`}>{s.ok ? '✓' : '✗'}</span><span>{s.item}</span></div>))}</div></div></details>
      <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white"><summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50"><div class="flex items-center gap-3"><span class="text-base">&#128269;</span><div><h3 class="font-semibold text-neutral-900 text-sm">SEO technique</h3><p class="text-[11px] text-neutral-500">{techVerdicts[2].detail}</p></div></div><svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></summary><div class="px-4 pb-4 border-t border-neutral-100 pt-4"><div class="space-y-2">{tech.seo.map(s => (<div class="flex items-start gap-2 text-xs text-neutral-600"><span class={`shrink-0 font-bold ${s.ok ? 'text-green-500' : 'text-red-400'}`}>{s.ok ? '✓' : '✗'}</span><span>{s.item}</span></div>))}</div></div></details>
    </div>
