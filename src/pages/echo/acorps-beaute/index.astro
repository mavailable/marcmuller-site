---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const isProspection = true;
const formule = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const showUpsell = true;

const title = 'Echo Decouverte — A\'Corps Beaute Nancy & Metz | Marc M';
const description = 'Analyse gratuite de acorpsbeaute.com : simulation de 10 visites clients, frictions identifiees, recommandations prioritaires. Rapport confidentiel.';
const dateGeneration = '1er avril 2026';

// ─── PERSONAS ───
const personas = [
  {
    id: 1, name: 'Isabelle', age: 44, role: 'Cadre superieure, budget beaute 200 euros/mois', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Mobile', decision: 'Hesite',
    exp: 4, conf: 7, clarte: 3, emoji: '\u{1F4B3}',
    situation: 'Compare A\'Corps Beaute avec un autre institut Nancy pour un Hydrafacial, veut connaitre les prix',
    parcours: ['Accueil', 'Services', 'Contact'],
    questionCle: 'Combien coute un Hydrafacial chez vous ? Et combien de seances pour voir un resultat ?',
    reponse: 'Non',
    premierImpression: '4,9 etoile sur 500+ avis est impressionnant. Mais les prix sont introuvables — je dois appeler pour savoir si c\'est dans mon budget.',
    positifs: ['4,9 etoile / 500+ avis rassurant', 'Equipements medicaux mentionnes', 'Hydrafacial mis en avant', 'Bilan offert'],
    frictions: ['Prix totalement absents', 'Doit appeler pour savoir', 'Pas de protocole Hydrafacial explique', 'GTM + Facebook Pixel sans banniere consentement'],
    raisonDecision: 'Elle hesite. Elle rappellera peut-etre, ou choisira l\'autre institut qui affiche ses prix directement.',
    impactTech: 'Mobile correct visuellement mais performances probablement degradees (Elementor + GTM + FB Pixel).',
  },
  {
    id: 2, name: 'Christelle', age: 38, role: 'Entrepreneuse, EMSculpt post-grossesse', canal: 'Google Maps',
    maturite: 'Decision', device: 'Mobile', decision: 'Convertit',
    exp: 7, conf: 9, clarte: 6, emoji: '\u{1F4AA}',
    situation: 'A vu A\'Corps Beaute sur Maps avec 4,9 etoile / 500+ avis, veut un bilan corps',
    parcours: ['Google Maps', 'Accueil', 'Planity'],
    questionCle: 'Vous avez de la disponibilite cette semaine pour un bilan corps ?',
    reponse: 'Oui',
    premierImpression: '4,9 etoile sur 500+ avis — c\'est la meilleure note que j\'aie vue pour un institut dans le secteur. Le bilan est offert. Je reserve.',
    positifs: ['4,9 etoile decisif', 'Planity integre', 'EMSculpt bien mis en avant', 'Bilan offert mentionne'],
    frictions: ['Prix EMSculpt absent (devra demander lors du bilan)', 'Planity parfois lent a charger'],
    raisonDecision: 'La note Google Maps + Planity = conversion directe. Elle reserve un bilan.',
    impactTech: 'Mobile : Planity charge correctement. Le parcours Maps → Planity fonctionne.',
  },
  {
    id: 3, name: 'Muriel', age: 52, role: 'Retraitee, laser recommande par une amie', canal: 'Bouche-a-oreille',
    maturite: 'Decision', device: 'Tablette', decision: 'Convertit',
    exp: 6, conf: 9, clarte: 5, emoji: '\u{1F4A1}',
    situation: 'Collègue recommande A\'Corps pour l\'epilation laser — veut confirmer le serieux de l\'institut',
    parcours: ['Accueil', 'Epilation laser', 'Contact'],
    questionCle: 'Vos lasers sont bien CE medical ? Vous traitez les peaux mates ?',
    reponse: 'Partiellement',
    premierImpression: 'La certification CE medical est mentionnee, les 500+ avis confirment le serieux. La recommandation de mon amie fait le reste.',
    positifs: ['Certification CE medical visible', '500+ avis', 'Recommandation amie = confiance maximale'],
    frictions: ['Types de peaux traitees non precises', 'Pas de FAQ epilation laser', 'Prix absents'],
    raisonDecision: 'Recommandation + CE medical suffisent. Elle appelle pour un RDV.',
    impactTech: 'Tablette : site lisible. Le telephone cliquable fonctionne.',
  },
  {
    id: 4, name: 'Laurence', age: 35, role: 'Enseignante, curieuse du microneedling', canal: 'Google Search',
    maturite: 'Decouverte', device: 'Desktop', decision: 'Quitte',
    exp: 2, conf: 5, clarte: 2, emoji: '\u{1F4DA}',
    situation: 'Cherche "microneedling Nancy avis" — veut comprendre le traitement avant de decider',
    parcours: ['Accueil', 'Services'],
    questionCle: 'C\'est quoi exactement le microneedling ? Pour quels problemes de peau ? Ca fait mal ?',
    reponse: 'Non',
    premierImpression: 'Microneedling liste dans les services mais aucune explication. Je ne sais toujours pas ce que c\'est apres avoir visite le site.',
    positifs: ['Microneedling liste dans les services'],
    frictions: ['Pas de page explicative par traitement', 'Pas de FAQ', 'Pas de description des resultats attendus', 'Pas de photos avant/apres', 'Prix absents'],
    raisonDecision: 'Elle ne comprend pas le traitement depuis le site. Elle va chercher l\'info sur YouTube.',
    impactTech: 'Desktop : site charge correctement. Probleme = absence totale de contenu educatif.',
  },
  {
    id: 5, name: 'Thomas', age: 41, role: 'Homme qui perd ses cheveux, tricopigmentation', canal: 'IA (ChatGPT)',
    maturite: 'Decouverte', device: 'Desktop', decision: 'Quitte',
    exp: 3, conf: 6, clarte: 2, emoji: '\u{1F9D1}',
    situation: 'A eu le nom d\'A\'Corps via ChatGPT pour la tricopigmentation, veut en savoir plus',
    parcours: ['Accueil', 'Services'],
    questionCle: 'C\'est quoi la difference tricopigmentation vs tatouage capillaire ? Combien de seances ? Resultat ?',
    reponse: 'Partiellement',
    premierImpression: 'Le service existe, la note est bonne. Mais aucune explication de ce qu\'est la tricopigmentation concretement.',
    positifs: ['Service existe et mentionne', 'Note elevee rassurante'],
    frictions: ['Pas de page dediee tricopigmentation', 'Pas d\'explication technique', 'Pas de photos avant/apres', 'Prix absents', 'Site non lisible par les IA'],
    raisonDecision: 'Il ne trouve pas les reponses a ses questions. Il cherche ailleurs.',
    impactTech: 'Site non optimise pour les IA. Pas de llms.txt, pas de contenu structurel que ChatGPT pourrait citer.',
  },
  {
    id: 6, name: 'Nadia', age: 29, role: 'Etudiante en ecole de commerce, curieuse EMSculpt', canal: 'Reseaux sociaux',
    maturite: 'Decouverte', device: 'Mobile', decision: 'Hesite',
    exp: 3, conf: 6, clarte: 2, emoji: '\u{1F4F1}',
    situation: 'A vu une pub Instagram EMSculpt, curieuse mais sensible au budget',
    parcours: ['Instagram', 'Accueil', 'Services corps'],
    questionCle: 'L\'EMSculpt c\'est pour qui ? Ca coute combien ? Resultats visibles en combien de temps ?',
    reponse: 'Non',
    premierImpression: 'EMSculpt mis en avant, belle presentation. Mais pas le moindre prix ni protocole explique.',
    positifs: ['EMSculpt bien presente', 'Belle presentation visuelle', 'Avis rassurants'],
    frictions: ['Prix absents (bloquant pour un etudiant)', 'Protocole EMSculpt non explique', 'Facebook Pixel sans consentement', 'Pas de temoignages avec resultats concrets'],
    raisonDecision: 'Elle hesite. Sans le prix, elle ne peut pas decider. Elle save la page Instagram.',
    impactTech: 'Mobile : performances probablement degradees (Elementor lourd). FB Pixel depose sans consentement.',
  },
  {
    id: 7, name: 'Kevin', age: 36, role: 'Chef cuisinier, veut une reconversion formation esthetique', canal: 'Google Search',
    maturite: 'Comparaison', device: 'Desktop', decision: 'Quitte',
    exp: 2, conf: 5, clarte: 1, emoji: '\u{1F393}',
    situation: 'Cherche une formation professionnelle en esthetique, a vu qu\'A\'Corps propose des formations',
    parcours: ['Accueil', 'Services'],
    questionCle: 'Vous proposez quelles formations exactement ? C\'est certifiant ? Ca dure combien ? Quel prix ?',
    reponse: 'Non',
    premierImpression: 'Formations mentionnees en bas de liste entre les soins. Impossible de trouver un detail.',
    positifs: ['Formations mentionnees dans les services'],
    frictions: ['Pas de page dediee formations', 'Pas de programme, duree, certification', 'Prix absents', 'Formations noyees parmi les soins esthetiques'],
    raisonDecision: 'Il ne trouve pas l\'information. Il va sur un organisme de formation specialise.',
    impactTech: 'Desktop : site charge mais architecture confuse pour trouver les formations.',
  },
  {
    id: 8, name: 'Sandrine', age: 48, role: 'Pharmacienne, soin anti-age haut de gamme Metz', canal: 'Google Maps',
    maturite: 'Decision', device: 'Mobile', decision: 'Convertit',
    exp: 7, conf: 9, clarte: 6, emoji: '\u{1F48E}',
    situation: 'Trouve A\'Corps sur Google Maps Metz, note 4,9 etoile la convainc pour un Hydrafacial',
    parcours: ['Google Maps', 'Accueil', 'Planity Metz'],
    questionCle: 'Vous avez de la disponibilite pour un Hydrafacial a Metz ?',
    reponse: 'Oui',
    premierImpression: '4,9 etoile sur Metz. 2 centres = serieux. Planity integre pour Metz. Je reserve.',
    positifs: ['4,9 etoile decisif', 'Planity Metz integre', '2 centres = fiabilite', '15 000+ clients satisfaits'],
    frictions: ['Prix absents (demandera lors du RDV)', 'Horaires Metz complexes a lire'],
    raisonDecision: 'La note Google Maps + Planity = conversion directe. Elle reserve a Metz.',
    impactTech: 'Mobile : Planity charge. Parcours Maps → Planity fonctionne bien.',
  },
  {
    id: 9, name: 'Philippe', age: 55, role: 'Directeur commercial, hyperhidrose (transpiration excessive)', canal: 'IA (Perplexity)',
    maturite: 'Comparaison', device: 'Desktop', decision: 'Quitte',
    exp: 2, conf: 5, clarte: 1, emoji: '\u{1F4BC}',
    situation: 'Perplexity l\'a oriente vers A\'Corps pour le traitement hyperhidrose en Lorraine',
    parcours: ['Accueil', 'Services'],
    questionCle: 'Votre traitement hyperhidrose, c\'est quoi exactement ? Resultats durables ? Tarif ?',
    reponse: 'Non',
    premierImpression: 'Hyperhidrose liste dans les services mais zero detail. Je ne sais pas ce que le traitement fait concretement.',
    positifs: ['Hyperhidrose dans la liste des services'],
    frictions: ['Pas de page dediee hyperhidrose', 'Pas d\'explication du traitement', 'Pas de duree des resultats', 'Prix absents', 'Site non optimise pour les IA'],
    raisonDecision: 'Il cherchait des reponses precises. Le site n\'en donne aucune. Il continue a chercher.',
    impactTech: 'Site non indexable par les IA pour des requetes medicales specifiques.',
  },
  {
    id: 10, name: 'Aurelie', age: 32, role: 'Comptable, epilation laser visage', canal: 'Reseaux sociaux',
    maturite: 'Comparaison', device: 'Mobile', decision: 'Hesite',
    exp: 4, conf: 7, clarte: 3, emoji: '\u{2728}',
    situation: 'Compare A\'Corps et un autre institut Nancy pour l\'epilation laser visage',
    parcours: ['Instagram', 'Accueil', 'Epilation laser', 'Contact'],
    questionCle: 'Combien de seances pour le visage complet ? Quel tarif a la seance / forfait ?',
    reponse: 'Non',
    premierImpression: '4,9 etoile sur 500+ avis est rassurante. CE medical = serieux. Mais aucun prix — je dois appeler.',
    positifs: ['4,9 etoile / 500+ avis', 'CE medical', 'Planity pour reserver'],
    frictions: ['Prix absents (decision impossible sans budget)', 'Pas de comparatif seances/forfait', 'Facebook Pixel sans consentement'],
    raisonDecision: 'Elle hesite. Appellera pour les prix, ou choisira l\'autre institut qui les affiche.',
    impactTech: 'Mobile : FB Pixel depose sans consentement visible. Performances degradees par Elementor.',
  },
];

// ─── STATS ───
const avgExp = (personas.reduce((s, p) => s + p.exp, 0) / personas.length).toFixed(1);
const avgConf = (personas.reduce((s, p) => s + p.conf, 0) / personas.length).toFixed(1);
const avgClarte = (personas.reduce((s, p) => s + p.clarte, 0) / personas.length).toFixed(1);
const convertis = personas.filter(p => p.decision === 'Convertit').length;
const hesitants = personas.filter(p => p.decision === 'Hesite').length;
const quitte = personas.filter(p => p.decision === 'Quitte').length;
const tauxConv = Math.round((convertis / personas.length) * 100);

// ─── CANAL STATS ───
const canalStats = [
  { canal: 'Google Search', total: 3, conv: 0, hesitant: 1, quitte: 2 },
  { canal: 'Google Maps', total: 2, conv: 2, hesitant: 0, quitte: 0 },
  { canal: 'IA (ChatGPT / Perplexity)', total: 2, conv: 0, hesitant: 0, quitte: 2 },
  { canal: 'Reseaux sociaux', total: 2, conv: 0, hesitant: 2, quitte: 0 },
  { canal: 'Bouche-a-oreille', total: 1, conv: 1, hesitant: 0, quitte: 0 },
];

// ─── FRICTIONS ───
const frictions = [
  { label: 'Prix totalement absents — 10/10 personas demandent un tarif sans reponse', count: 10, severity: 'critique' },
  { label: 'Aucune page dediee par traitement (microneedling, EMSculpt, tricopigmentation...)', count: 7, severity: 'critique' },
  { label: 'RGPD : Facebook Pixel + GA4 via GTM sans banniere consentement', count: 10, severity: 'critique' },
  { label: 'aggregateRating absent en Schema.org (538 avis 4,9 etoile non exploites)', count: 10, severity: 'haute' },
  { label: 'Performances mobiles degradees (Elementor Pro + GTM + FB Pixel)', count: 8, severity: 'haute' },
  { label: 'Segment formations inexploite sur le site (page absente)', count: 2, severity: 'moyenne' },
  { label: 'Horaires des 2 centres complexes a lire sur mobile', count: 3, severity: 'moyenne' },
];

// ─── RECOMMANDATIONS ───
const recoHaute = {
  title: 'Afficher des prix indicatifs — meme "a partir de X euros"',
  impact: '10/10 personas',
  detail: 'L\'absence totale de prix est la friction numero 1. Pas besoin d\'un tarif exhaustif : "Hydrafacial a partir de 89€", "Bilan EMSculpt offert", "Epilation laser visage : forfait 6 seances a partir de X€". Meme des fourchettes indicatives filtrent les prospects, qualifient les appels, et convertissent les visiteurs qui ne veulent pas appeler pour savoir si c\'est dans leur budget.'
};
const recosMoyennes = [
  {
    title: 'Creer des pages dediees pour chaque traitement phare',
    impact: '7 personas',
    detail: 'Hydrafacial, EMSculpt, epilation laser, microneedling, tricopigmentation : chaque traitement merite sa propre page avec protocole (avant/pendant/apres), nombre de seances recommande, resultats attendus, photos avant/apres. Ces pages capturent le trafic Google ("hydrafacial Nancy", "emssculpt resultats") et positionnent A\'Corps sur des requetes a tres haute valeur que le site rate actuellement.'
  },
  {
    title: 'Exploiter les 538 avis en Schema.org aggregateRating',
    impact: '10/10 personas (SEO)',
    detail: 'Les 4,9 etoile sur 538 avis ne sont pas declares en JSON-LD Schema. Google ne peut donc pas afficher les etoiles dans les resultats de recherche. Ajouter aggregateRating au Schema LocalBusiness generera des rich snippets avec les etoiles — amelioration du CTR organique de 15-30% estimee.'
  },
  {
    title: 'Installer une banniere de consentement RGPD (CMP)',
    impact: '10/10 personas (legal)',
    detail: 'Facebook Pixel + GA4 deposes via GTM sans consentement = violation RGPD directement actionnable. Une CMP conforme (Axeptio, Didomi) avec Google Consent Mode v2 est obligatoire. A coupler avec une migration vers un analytics sans cookies (Umami) pour simplifier la conformite a long terme.'
  },
];

// ─── TECHNIQUE ───
const techVerdicts = [
  { label: 'HTTPS actif', ok: true },
  { label: 'Planity reserve integre (Nancy + Metz)', ok: true },
  { label: 'Open Graph (title, image, description)', ok: true },
  { label: 'Meta description presente', ok: true },
  { label: 'Tel cliquable (href:tel)', ok: true },
  { label: 'aggregateRating Schema.org (538 avis)', ok: false },
  { label: 'RGPD conforme (FB Pixel + GA4 sans CMP)', ok: false },
  { label: 'Performances mobiles (Elementor + GTM + FB Pixel)', ok: false },
  { label: 'Pages dediees par traitement', ok: false },
  { label: 'Prix affiches (meme indicatifs)', ok: false },
];

// ─── HELPERS ───
function decisionBorder(d: string) {
  if (d === 'Convertit') return 'border-green-200 bg-green-50/40';
  if (d === 'Hesite') return 'border-amber-200 bg-amber-50/40';
  return 'border-neutral-200 bg-neutral-50/40';
}
function severityColor(s: string) {
  if (s === 'critique') return 'bg-red-100 text-red-800';
  if (s === 'haute') return 'bg-orange-100 text-orange-800';
  if (s === 'moyenne') return 'bg-blue-100 text-blue-800';
  return 'bg-neutral-100 text-neutral-600';
}
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
  lang="fr"
  frPath="/echo/acorps-beaute"
>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #1a0a2e;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-15 blur-3xl" style="background: #9b59b6;"></div>

    <div class="mx-auto max-w-4xl relative z-10">
      <div class="mb-4 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-purple-400/40">
        <span class="w-2 h-2 rounded-full bg-purple-400"></span>
        <span class="text-sm font-semibold text-white/90">Echo Decouverte &middot; Confidentiel</span>
      </div>

      <h1 class="mb-4 text-3xl font-bold leading-tight text-white md:text-4xl lg:text-5xl">
        538 avis 4,9 etoile — et pourtant <span class="text-purple-300">7 visiteurs sur 10 repartent sans reserver</span>
      </h1>

      <p class="text-lg text-neutral-300 md:text-xl max-w-2xl mb-8">
        Analyse de <strong class="text-white">acorpsbeaute.com</strong> — simulation de 10 visites clients reelles, 5 canaux d'arrivee, frictions identifiees. Genere le {dateGeneration}.
      </p>

      <div class="flex flex-wrap gap-4 mb-10">
        <div class="px-6 py-4 rounded-xl bg-green-900/40 border border-green-700/40 text-center">
          <p class="text-2xl font-bold text-green-400">{convertis}</p>
          <p class="text-xs text-green-300 mt-1">contactent</p>
        </div>
        <div class="px-6 py-4 rounded-xl bg-amber-900/40 border border-amber-700/40 text-center">
          <p class="text-2xl font-bold text-amber-400">{hesitants}</p>
          <p class="text-xs text-amber-300 mt-1">hesitent</p>
        </div>
        <div class="px-6 py-4 rounded-xl bg-red-900/40 border border-red-700/40 text-center">
          <p class="text-2xl font-bold text-red-400">{quitte}</p>
          <p class="text-xs text-red-300 mt-1">repartent</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">10 personas simules</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">5 canaux d'arrivee</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">Audit technique inclus</span>
        <span class="px-4 py-2 rounded-lg bg-white/10 text-white text-sm">{dateGeneration}</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ CONSTAT ═══════════════════ -->
  <div class="w-full px-6 py-10 md:px-8 bg-white">
    <div class="mx-auto max-w-4xl">
      <div class="rounded-xl border-l-4 border-l-purple-500 bg-purple-50 p-6 md:p-8">
        <h2 class="text-lg font-bold text-neutral-900 mb-2">Le paradoxe A'Corps Beaute</h2>
        <p class="text-neutral-800 leading-relaxed">
          <strong>538 avis, 4,9 etoile, equipements medicaux CE, 2 centres, 20 ans d'experience.</strong> C'est un actif concurrentiel rarissime en Lorraine. Pourtant, <strong>10 visiteurs sur 10 cherchent un prix — et n'en trouvent aucun.</strong> Les 3 qui convertissent (Maps, bouche-a-oreille) etaient deja decides. Les 7 autres repartent vers un concurrent qui affiche ses tarifs. Le paradoxe : plus l'enseigne est connue et chere, plus l'absence de prix est une friction forte.
        </p>
      </div>
    </div>
  </div>

  <!-- ═══════════════════ CANAUX ═══════════════════ -->
  <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-neutral-50">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Conversion par canal</h2>
      <p class="text-neutral-500 mb-8">Google Maps et le bouche-a-oreille convertissent. Google Search et les IA : 0% de conversion — ces visiteurs cherchent des informations que le site ne fournit pas.</p>
      <div class="grid md:grid-cols-2 gap-4">
        {canalStats.map((c) => {
          const pct = c.total > 0 ? Math.round((c.conv / c.total) * 100) : 0;
          return (
            <div class="rounded-xl border border-neutral-200 bg-white p-5">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-semibold text-neutral-900 text-sm">{c.canal}</h3>
                <span class={`text-lg font-bold ${pct > 50 ? 'text-emerald-600' : pct > 0 ? 'text-amber-600' : 'text-red-600'}`}>{pct}%</span>
              </div>
              <div class="h-3 rounded-full bg-neutral-100 overflow-hidden mb-3">
                <div class="h-full rounded-full flex">
                  <div class="bg-emerald-500" style={`width: ${c.total > 0 ? (c.conv / c.total) * 100 : 0}%`}></div>
                  <div class="bg-amber-400" style={`width: ${c.total > 0 ? (c.hesitant / c.total) * 100 : 0}%`}></div>
                  <div class="bg-red-400" style={`width: ${c.total > 0 ? (c.quitte / c.total) * 100 : 0}%`}></div>
                </div>
              </div>
              <div class="flex gap-4 text-xs text-neutral-400">
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> {c.conv} conv.</span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-400"></span> {c.hesitant} hes.</span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-400"></span> {c.quitte} partis</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- ═══════════════════ PERSONAS ═══════════════════ -->
  <div class="w-full px-6 py-12 md:px-8 md:py-16 bg-white">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">10 visites simulees</h2>
      <p class="text-neutral-500 mb-8">Clients types qui visitent acorpsbeaute.com — profils, parcours, et raison de leur decision.</p>

      <div class="space-y-8">

        {/* Convertit */}
        <div>
          <h3 class="text-base font-bold text-emerald-700 mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Ceux qui contactent ({convertis})
          </h3>
          <div class="space-y-3">
            {personas.filter(p => p.decision === 'Convertit').map((p) => (
              <details class={`group border ${decisionBorder(p.decision)} rounded-xl overflow-hidden`}>
                <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                      <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                      <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
