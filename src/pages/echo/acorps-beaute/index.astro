            <div class="space-y-3">
              {filtered.map(p => (
                <details class={`group bg-white rounded-xl overflow-hidden shadow-sm border ${decisionBorder(p.decision)}`}>
                  <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
                    <div class="flex-1 min-w-0">
