---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { personas, type Decision } from '../../../data/buddhaview-dive-personas';

const slug = 'buddhaview-dive';
const nomProspect = 'Buddha View Dive Centre';
const urlSite = 'https://www.buddhaviewdivecentre.com';
const dateAudit = '20 juin 2026';

const title = 'Rapport Personas - Buddha View Dive Centre | Marc M';
const description = "Un regard confidentiel sur buddhaviewdivecentre.com a travers 60 visiteurs simules (20 anglophones, 20 francophones, 20 germanophones) : qui vous contacte, qui hesite, qui repart, et les correctifs qui transformeraient plus de visites en reservations.";

// Marc contact (from business.ts - phone +33688766648)
const phoneDisplay = '+33 6 88 76 66 48';
const whatsapp = '33688766648';

// KPIs sur l'ensemble des 60 visiteurs simules (pas seulement les 24 affiches)
const kpis = { nbPersonas: 60, nbConvertissent: 15, nbHesitent: 26, nbRepartent: 19, conversion: 25, experience: 5.3, confiance: 5.2, clarte: 5.2 };

const verdictHero = "Sur 60 visiteurs adaptés à votre activité, 15 vous contactent. Les 45 autres non, et trois raisons reviennent : aucun avis client, des prix absents de la page d'aperçu des cours, et un site 100% anglais alors que votre équipe parle six langues.";

const constat = "Votre contenu inspire confiance : centre PADI 5 étoiles, prix de fun-diving clairs, spot de Tanote Bay plus calme. La fuite se situe entre l'arrivée et la prise de contact. Trois trous reviennent chez la majorité des 60 visiteurs : aucune preuve sociale (zéro avis sur tout le site), des prix invisibles sur la page d'aperçu des cours (il faut ouvrir chaque cours un par un), et un site entièrement en anglais qui laisse les voyageurs francophones et germanophones sans repère, alors même que votre équipe parle leurs langues sans jamais le dire là où ça compte.";

// Conversion par langue (le coeur de cet audit)
const langueData = [
  { langue: 'Anglophones', flag: '🇬🇧', total: 20, convert: 5, hesite: 10, quitte: 5, rate: 25, upside: 0, note: "Aucune barrière de langue. Ce sont vos frictions de contenu (zéro avis, prix cachés, mobile lent) qui plafonnent la conversion." },
  { langue: 'Francophones', flag: '🇫🇷', total: 20, convert: 5, hesite: 8, quitte: 7, rate: 25, upside: 6, note: "Même taux, mais la langue y contribue. 6 de plus vous contacteraient si le site parlait français et signalait l'instructeur francophone, que votre équipe propose déjà." },
  { langue: 'Germanophones', flag: '🇩🇪', total: 20, convert: 5, hesite: 8, quitte: 7, rate: 25, upside: 11, note: "Bon niveau d'anglais, mais l'absence d'avis et de politique d'annulation les bloque. 11 de plus avec ces repères et un signal instructeur germanophone." }
];

// D'ou viennent vos visiteurs (trie par taux de conversion)
const canalData = [
  { canal: 'Bouche-à-oreille', nb: 9, convert: 6, rate: 67 },
  { canal: 'Google Maps', nb: 9, convert: 4, rate: 44 },
  { canal: 'Google Search', nb: 15, convert: 3, rate: 20 },
  { canal: 'Agrégateurs (PADI Travel, lien hostel)', nb: 9, convert: 1, rate: 11 },
  { canal: 'Assistants IA (ChatGPT, Perplexity)', nb: 9, convert: 1, rate: 11 },
  { canal: 'Réseaux sociaux', nb: 9, convert: 0, rate: 0 }
];

// Alertes (1 critique + 3 important)
const alertes = [
  { type: 'critique' as const, titre: "Aucun avis client sur tout le site", detail: "Zéro preuve sociale alors que Google et TripAdvisor en regorgent. C'est la friction numéro un, citée par la majorité des 60 visiteurs : sans avis, un inconnu ne sait pas s'il peut vous faire confiance.", chiffre: '0', chiffreLabel: 'avis ou témoignages' },
  { type: 'important' as const, titre: "Sur mobile, le site met près de 7 secondes à s'afficher", detail: "La plupart de vos clients vous trouvent sur leur téléphone. Le visuel principal met 6,9 secondes à apparaître sur mobile (1,7s sur ordinateur). Beaucoup ferment l'onglet avant de voir quoi que ce soit. Le problème est mobile uniquement.", chiffre: '6,9s', chiffreLabel: 'chargement mobile' },
  { type: 'important' as const, titre: "Les prix sont absents de la page d'aperçu des cours", detail: "L'Open Water (10 900 THB) n'est visible qu'en ouvrant sa propre page. Impossible de comparer d'un coup d'oeil. Les voyageurs au budget serré passent à un centre qui affiche ses prix.", chiffre: '0', chiffreLabel: "prix sur l'aperçu" },
  { type: 'important' as const, titre: "Un site 100% anglais, langues parlées invisibles", detail: "Votre équipe parle anglais, thaï, chinois, allemand, espagnol et français, mais le site est entièrement en anglais et ne le signale jamais sur l'accueil ni les pages cours. Un visiteur francophone ou germanophone ne sait pas qu'il sera compris.", chiffre: '1/6', chiffreLabel: 'langues affichées' }
];

// Verdict technique (badges)
const techVerdicts = [
  { label: 'Vitesse', verdict: 'Lente sur mobile', ok: false, detail: "6,9s pour s'afficher sur téléphone, 1,7s sur ordinateur" },
  { label: 'Sécurité', verdict: 'Faible', ok: false, detail: 'Note C-, 4 protections standard manquantes' },
  { label: 'Référencement', verdict: 'Bon', ok: true, detail: 'Bien configuré pour Google (92/100)' },
  { label: 'Données business', verdict: 'Présentes', ok: true, detail: 'Google lit votre fiche (LocalBusiness)' },
  { label: 'Partage social', verdict: 'Incomplet', ok: false, detail: 'Aucune image lors d\'un partage' }
];

const tech = {
  observatory: { grade: 'C-', score: 45, testsOk: 6, testsTotal: 10 },
  pagespdMobile: { performance: 63, accessibility: 93, bestPractices: 96, seo: 92 },
  pagespdDesktop: { performance: 87, accessibility: 97, bestPractices: 96, seo: 92 },
  headers: [
    { ok: true, h: 'Chiffrement HTTPS et protections de base en place (6 des 10 contrôles réussis)' },
    { ok: false, h: 'Politique de sécurité du contenu (CSP) : absente' },
    { ok: false, h: 'Protection contre le clickjacking (X-Frame-Options) : absente' },
    { ok: false, h: 'Contrôle d\'intégrité des scripts externes : absent' }
  ],
  schema: [
    { item: 'Fiche business lisible par Google (LocalBusiness)', ok: true },
    { item: 'Identité du site présente', ok: true },
    { item: 'Avis clients non balisés pour les étoiles Google', ok: false }
  ],
  og: [
    { item: 'Titre de partage', ok: true, val: 'présent' },
    { item: 'Description de partage', ok: true, val: 'présente' },
    { item: 'Image de partage', ok: false, val: 'absente' },
    { item: 'Lien et type', ok: true, val: 'présents' }
  ],
  seo: [
    { item: 'Titre et description bien rédigés', ok: true },
    { item: 'Lisible par les moteurs de recherche', ok: true },
    { item: 'Données structurées présentes', ok: true },
    { item: "Vitesse mobile (facteur de classement n°1 de Google) : faible", ok: false }
  ]
};

// Recommandations
const ameliorationsHautes = [
  { titre: "Afficher les avis clients sur le site", pourquoi: "Aujourd'hui, zéro preuve sociale. C'est la première chose que cherchent vos visiteurs. Vous avez d'excellents avis sur Google et TripAdvisor, ils ne sont juste pas sur votre site.", action: "Intégrer un mur d'avis (widget Google) sur l'accueil et en bas de chaque page de cours.", impact: 'majorité des 60' },
  { titre: "Afficher un prix sur la page d'aperçu des cours", pourquoi: "Les prix existent mais sont cachés un par un. Un prix visible, même un 'à partir de', est l'un des signaux de confiance les plus forts.", action: "Ajouter un tableau de prix clair sur la page d'aperçu des cours, pour comparer d'un coup d'oeil.", impact: 'la plupart des 60' },
  { titre: "Signaler les langues parlées sur l'accueil et les pages cours", pourquoi: "Votre équipe parle français, allemand, espagnol et chinois, mais personne ne le sait. Un simple 'Instructeurs francophones et germanophones disponibles' rassure et débloque.", action: "Ajouter une ligne sur les langues parlées sur l'accueil, les pages cours et baptême.", impact: 'jusqu\'à +17 visiteurs' },
  { titre: "Accélérer le site sur mobile", pourquoi: "Le contenu met près de 7 secondes à apparaître sur téléphone, là où se trouve la majorité de votre trafic.", action: "Compresser et redimensionner les images (page de 2,8 Mo), les servir dans un format léger, et charger les images du bas seulement au défilement. Objectif : moins de 3 secondes.", impact: 'tout le trafic mobile' },
  { titre: "Ajouter une politique d'annulation et un 'ce qu'il faut prévoir'", pourquoi: "Surtout pour les voyageurs minutieux (germanophones), l'absence de règles écrites pousse à aller demander ailleurs plutôt qu'à réserver.", action: "Ajouter une courte section annulation, contre-indications, et ce qu'il faut apporter, sur chaque page de cours.", impact: '8 visiteurs (germanophones)' }
];

const ameliorationsUtiles = [
  { titre: "Une prise de contact plus simple, avec délai de réponse annoncé", detail: "La réservation passe par WhatsApp ou un formulaire. Un bouton clair par cours, avec un 'nous répondons sous 24h', transforme l'hésitation en conversation." },
  { titre: "Une image de partage (Open Graph)", detail: "Quand votre lien est partagé sur les réseaux, aucune image n'apparaît, alors que le social est un canal fort pour un centre de plongée." },
  { titre: "Publier une FAQ structurée", detail: "La page brouillon existe déjà. Répondre à 'est-ce sûr, faut-il savoir nager, contre-indications, ce qui est inclus' convertit exactement les hésitants." },
  { titre: "Nettoyer les pages résiduelles du sitemap", detail: "Des pages brouillon (copy-of, kopyasi, my-addresses) sont indexables. Un nettoyage améliore l'image aux yeux de Google." }
];

const ameliorationsDiscuter = [
  { emoji: '🌏', titre: "Une version française et allemande du site ?", detail: "Le potentiel débloquable est réel (jusqu'à +17 contacts latents), mais cela n'a de sens que si vous pouvez gérer confortablement les demandes et un cours dans ces langues. Votre équipe les parle déjà." },
  { emoji: '🏗️', titre: "Sortir de Wix ?", detail: "La plateforme plafonne la vitesse mobile et la sécurité. Un autre socle lèverait ce plafond, mais c'est un chantier à peser." },
  { emoji: '📅', titre: "Réservation et paiement en ligne, ou rester sur WhatsApp ?", detail: "Une réservation en ligne convertirait les planificateurs automatiquement, mais demande de gérer des créneaux fixes. À vous de voir le niveau d'automatisation souhaité." }
];

function decisionBorder(d: Decision) {
  if (d === 'Convertit') return 'border-green-200';
  if (d === 'Hesite') return 'border-amber-200';
  return 'border-neutral-200';
}
function decisionBadge(d: Decision) {
  if (d === 'Convertit') return 'bg-green-600';
  if (d === 'Hesite') return 'bg-amber-500';
  return 'bg-neutral-400';
}
function scoreColor(n: number) {
  if (n >= 7) return 'text-green-600';
  if (n >= 5) return 'text-amber-600';
  return 'text-red-500';
}

const converts = personas.filter((p) => p.decision === 'Convertit');
const hesitates = personas.filter((p) => p.decision === 'Hesite');
const leaves = personas.filter((p) => p.decision === 'Quitte');
---

<BaseLayout title={title} description={description} noindex={true}>

  <!-- ═══ HERO ═══ -->
  <section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
    <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #0EA5E9; opacity: 0.08;"></div>
    <div class="absolute bottom-[10%] right-[5%] w-[300px] h-[300px] rounded-full blur-[120px] pointer-events-none" style="background: #E86C47; opacity: 0.05;"></div>

    <div class="relative mx-auto max-w-4xl z-10">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
        Rapport personas &middot; Confidentiel
      </div>

      <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
        {verdictHero}
      </h1>

      <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
        Site analysé : <a href={urlSite} target="_blank" rel="noopener" class="underline hover:text-white transition-colors">{urlSite}</a> &middot; {kpis.nbPersonas} visiteurs simulés &middot; {dateAudit}
      </p>

      <div class="grid grid-cols-3 gap-4">
        <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
          <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
          <div class="text-sm text-green-400/70">vous contactent</div>
        </div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
          <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
          <div class="text-sm text-amber-400/70">hésitent</div>
        </div>
        <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
          <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
          <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
        </div>
      </div>

      <p class="mt-6 text-sm text-center" style="color: rgba(255,255,255,0.5);">
        Soit <strong class="text-white">{kpis.conversion}%</strong> qui prennent contact &middot; <strong class="text-green-400">67%</strong> via le bouche-à-oreille &middot; <strong class="text-amber-400">0%</strong> via les réseaux sociaux
      </p>
    </div>
  </section>

  <!-- ═══ CONVERSION PAR LANGUE ═══ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Conversion par langue</h2>
    <p class="text-neutral-600 mb-8">C'est le coeur de cet audit. Vos visiteurs viennent de trois marchés, et chacun bute sur des freins différents.</p>

    <div class="grid md:grid-cols-3 gap-4 mb-6">
      {langueData.map((l) => (
        <div class="bg-white border border-neutral-200 rounded-2xl p-5 shadow-sm">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-2xl">{l.flag}</span>
            <h3 class="font-bold text-neutral-900">{l.langue}</h3>
            <span class="ml-auto text-sm font-bold text-neutral-700">{l.rate}%</span>
          </div>
          <div class="flex h-3 rounded-full overflow-hidden mb-3">
            <div class="bg-green-500" style={`width: ${(l.convert / l.total) * 100}%`}></div>
            <div class="bg-amber-400" style={`width: ${(l.hesite / l.total) * 100}%`}></div>
            <div class="bg-neutral-300" style={`width: ${(l.quitte / l.total) * 100}%`}></div>
          </div>
          <div class="flex justify-between text-[11px] text-neutral-500 mb-3">
            <span><strong class="text-green-700">{l.convert}</strong> contactent</span>
            <span><strong class="text-amber-700">{l.hesite}</strong> hésitent</span>
            <span><strong class="text-neutral-600">{l.quitte}</strong> repartent</span>
          </div>
          {l.upside > 0 && (
            <div class="inline-flex items-center gap-1 text-[11px] font-semibold text-sky-700 bg-sky-50 border border-sky-200 rounded-full px-2 py-0.5 mb-2">
              +{l.upside} récupérables aujourd'hui
            </div>
          )}
          <p class="text-xs text-neutral-600 leading-relaxed mt-1">{l.note}</p>
        </div>
      ))}
    </div>

    <div class="rounded-2xl p-6 border-l-4" style="background: rgba(14,165,233,0.04); border-color: #0EA5E9;">
      <p class="text-sm md:text-base text-neutral-800 leading-relaxed">
        Les trois marchés plafonnent à <strong>25%</strong>, mais le potentiel débloquable est très inégal : <strong>+6 visiteurs francophones</strong> et <strong>+11 germanophones</strong> sont aujourd'hui perdus faute de version localisée et d'un simple signal "instructeur dans votre langue". Si ce potentiel se concrétisait, la conversion passerait d'environ 25% à plus de 50%.
      </p>
    </div>
  </section>

  <!-- ═══ THE TAKEAWAY ═══ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-4">
    <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.05); border-color: #E86C47;">
      <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
    </div>

    <h2 class="text-xl font-bold text-neutral-900 mb-2">D'où viennent vos visiteurs</h2>
    <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent, selon la façon dont ils vous ont trouvé.</p>

    <div class="space-y-4 mb-12">
      {canalData.map((c) => {
        const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
        return (
          <div class="flex items-center gap-4">
            <div class="w-44 sm:w-56 text-sm text-neutral-700 shrink-0">{c.canal}</div>
            <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
            </div>
            <div class="w-20 text-right">
              <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
              <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
            </div>
          </div>
        );
      })}
    </div>

    <details class="group mb-4">
      <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
        <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        Voir les scores détaillés (expérience, confiance, clarté)
      </summary>
      <div class="grid grid-cols-3 gap-4 mt-3">
        <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
          <div class="text-xs text-neutral-500">Expérience</div>
          <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilité, vitesse</p>
        </div>
        <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
          <div class="text-xs text-neutral-500">Confiance</div>
          <p class="text-[10px] text-neutral-400 mt-1">Crédibilité, preuves, réassurance</p>
        </div>
        <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
          <div class="text-xs text-neutral-500">Clarté</div>
          <p class="text-[10px] text-neutral-400 mt-1">Comprendre l'offre et les prix</p>
        </div>
      </div>
    </details>
  </section>

  <!-- ═══ ALERTS ═══ -->
  <section class="py-14" style="background: #fefce8;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 mb-2">
        <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01"/></svg>
        <h2 class="text-xl font-bold text-neutral-900">Ce qui retient vos visiteurs</h2>
      </div>
      <p class="text-sm text-neutral-500 mb-6">{alertes.filter((a) => a.type === 'critique').length} critique &middot; {alertes.filter((a) => a.type === 'important').length} importants</p>

      <div class="grid sm:grid-cols-2 gap-4">
        {alertes.map((a) => {
          const crit = a.type === 'critique';
          return (
            <div class={`bg-white rounded-xl p-5 ${crit ? 'border-2 border-red-300' : 'border border-amber-200'}`}>
              <div class="flex items-start gap-4">
                <div class={`shrink-0 rounded-lg px-3 py-2 text-center ${crit ? 'bg-red-600' : 'bg-amber-500'}`}>
                  <div class="text-lg font-black text-white leading-none">{a.chiffre}</div>
                </div>
                <div>
                  <h3 class="font-semibold text-neutral-900 text-sm mb-1">{a.titre}</h3>
                  <p class="text-[11px] text-neutral-400 mb-2">{a.chiffreLabel}</p>
                  <p class="text-xs text-neutral-600 leading-relaxed">{a.detail}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ═══ VISITORS ═══ -->
  <section class="py-16" style="background: #fafafa;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
      <p class="text-neutral-600 mb-2">Voici ce qui se passe quand une personne qui cherche à plonger à Koh Tao arrive sur votre site. Touchez un profil pour voir son parcours complet.</p>
      <p class="text-sm text-neutral-500 mb-6">Profils représentatifs. 60 visiteurs simulés au total, 20 par langue.</p>

      <!-- Filtre par langue -->
      <div class="flex flex-wrap gap-2 mb-8">
        <button class="filter-btn px-3.5 py-1.5 rounded-full text-sm font-medium bg-neutral-900 text-white transition-colors" data-langue="all">Toutes</button>
        <button class="filter-btn px-3.5 py-1.5 rounded-full text-sm font-medium bg-white text-neutral-600 border border-neutral-200 transition-colors" data-langue="EN">🇬🇧 Anglophones</button>
        <button class="filter-btn px-3.5 py-1.5 rounded-full text-sm font-medium bg-white text-neutral-600 border border-neutral-200 transition-colors" data-langue="FR">🇫🇷 Francophones</button>
        <button class="filter-btn px-3.5 py-1.5 rounded-full text-sm font-medium bg-white text-neutral-600 border border-neutral-200 transition-colors" data-langue="DE">🇩🇪 Germanophones</button>
      </div>

      <!-- ✅ Contactent -->
      <div class="mb-10">
        <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
          Ceux qui vous contactent
