---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'racine-nancy';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const isProspection = true;
const nomProspect = 'Racine Nancy';
const urlSite = 'https://racine-nancy.com';
const dateAudit = '31 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 3,
  nbHesitent: 1,
  nbRepartent: 1,
  conversion: 60,
  experience: 7.2,
  confiance: 8.8,
  clarte: 4.5,
};

const verdictHero = 'Sur 5 visiteurs, 3 reservent — emportes par le Guide Michelin 2025 et 605 avis a 4.6. Paul cherchait les plats du terroir avec les producteurs : le menu PDF illisible sur mobile l\'a envoye chez le concurrent. Thomas avait besoin d\'un prix pour valider son repas d\'affaires : pas de tarif = exclu d\'office.';

const constat = 'Racine possede deux atouts de confiance rares a Nancy : la mention Guide Michelin 2025 et 605 avis a 4.6. Ces deux signaux convertissent les decideurs motives et les clients recommandes. Mais le menu PDF est un mur invisible qui bloque les comparateurs et les chercheurs de longue traine : zero texte sur les plats, zero tarif, zero histoire sur les producteurs locaux. Un restaurant avec ce niveau de distinction devrait dominer "restaurant michelin nancy", "cuisine terroir nancy", "circuits courts restaurant nancy" — il est quasi-absent de ces SERP car son menu n\'existe pas pour Google.';

const canalData = [
  { canal: 'Google Search (gastronomique)', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille (anniversaire)', nb: 1, convert: 1, rate: 100 },
  { canal: 'IA (terroir/circuits courts)', nb: 1, convert: 0, rate: 0 },
  { canal: 'Google Search (Michelin)', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Maps (repas affaires)', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Clement',
    age: 32,
    emoji: '🍽️',
    situation: 'Cherche un restaurant gastronomique a Nancy pour un diner en amoureux',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Reserve',
    histoire: '"restaurant gastronomique nancy" → Racine, 4.6 sur 605 avis + Guide Michelin. Menu PDF difficile sur mobile, prix introuvables — mais Michelin + 605 avis decidident. Reserve en ligne.',
    localisation: 'Nancy (54)',
    maturite: 'Decision',
    contexte: 'Diner romantique prevu ce week-end. Pret a investir pour une experience memorable. Le Guide Michelin = valeur sure.',
    impression: 'La note et la mention Michelin rassurent immediatement. Le PDF est frustrant sur mobile — mais le signal de qualite est trop fort pour partir.',
    parcours: [
      ['Google Search', '"restaurant gastronomique nancy" — Racine bien classe'],
      ['Fiche Maps', '4.6 sur 605 avis — tres bon volume'],
      ['Site', 'Mention Guide Michelin 2025 — signal de qualite maximum'],
      ['La Carte', 'PDF difficile a lire sur mobile — prix non visibles'],
      ['Reservation', 'Reserve en ligne malgre le menu illisible — Michelin + note decidient'],
    ] as [string, string][],
    questionCle: 'Est-ce une experience a la hauteur et quel est le budget ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le Michelin + la note validient la qualite — mais le budget reste mystere jusqu\'a la reservation.',
    impactVitesse: 'WordPress Elementor mobile ~45 — acceptable pour un decideur motive',
    impactConfiance: '4.6 sur 605 avis + Guide Michelin 2025 = double validation rarissime',
    positifs: ['Guide Michelin 2025 = signal de qualite incontestable', 'Note 4.6 sur 605 avis — excellent volume', 'Reservation en ligne disponible'],
    frictions: ['Menu uniquement en PDF — illisible sur mobile', 'Prix non visibles avant de reserver', 'Concept terroir/producteurs peu developpe en texte'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 9, clarte: 5,
  },
  {
    id: 2,
    name: 'Sophie',
    age: 48,
    emoji: '💼',
    situation: 'Recommande par un collegue, cherche pour un anniversaire d\'entreprise (table de 8)',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Reserve',
    histoire: 'Collegue tres satisfait. Tape "Racine Nancy restaurant". Trouve site → horaires Mar-Sam → formulaire reservation → envoie demande pour 8 personnes + occasion speciale.',
    localisation: 'Nancy (54)',
    maturite: 'Decision',
    contexte: 'Anniversaire de la DG, 8 personnes. Responsabilite de choisir une adresse irrepprochable. Recommandation + Michelin = couverture maximale.',
    impression: 'Le site confirme le serieux de la recommandation. Pas besoin de voir tous les details — la legitimite est claire.',
    parcours: [
      ['Recherche directe', '"Racine Nancy restaurant"'],
      ['Site', 'Design sobre, horaires clairs (Mar-Sam)'],
      ['Contact/Reservation', 'Formulaire envoye avec la date et le nombre de personnes'],
    ] as [string, string][],
    questionCle: 'Comment je reserve pour un groupe et un evenement special ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le formulaire generique existe — mais pas de page "groupes/privatisation" pour rassurer sur la capacite et les conditions.',
    impactVitesse: 'Desktop — non bloquant',
    impactConfiance: 'Recommandation directe + Michelin + 605 avis = confiance maximale',
    positifs: ['Site coherent avec l\'image premium attendue', 'Horaires clairs', 'Formulaire de reservation disponible'],
    frictions: ['Pas de page dediee evenements/groupes/privatisation', 'Doit croire que le formulaire generique sera lu et traite rapidement'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 9, clarte: 6,
  },
  {
    id: 3,
    name: 'Paul',
    age: 29,
    emoji: '🌿',
    situation: 'Cherche un restaurant cuisine du terroir avec circuits courts a Nancy — ne connait pas Racine',
    canal: 'IA (ChatGPT)',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: '"restaurant cuisine terroir circuits courts nancy" via ChatGPT → Racine cite. Site → cherche menu textuel → PDF illisible mobile → producteurs non mentionnes en texte → concurrent avec carte HTML + prix + section producteurs locaux → compare.',
    localisation: 'Nancy (54)',
    maturite: 'Decouverte',
    contexte: 'Convaincu par l\'alimentation locale. Veut une experience authentique et coherente avec ses valeurs. L\'histoire du restaurant est aussi importante que la carte.',
    impression: 'Le nom Michelin rassure — mais il ne trouve pas l\'histoire derriere le restaurant : quels producteurs, quels terroirs, quelle philosophie. Le PDF ne repond a rien de ses questions.',
    parcours: [
      ['ChatGPT', '"restaurant terroir circuits courts nancy" — Racine cite'],
      ['Site', 'Design sobre — cherche une section "nos producteurs" ou "notre philosophie"'],
      ['La Carte', 'PDF ouvert sur mobile — difficile a lire, plats listes sans contexte ni prix'],
      ['Concurrent', '"Notre cave a vin de Meuse, nos legumes de la ferme Lefebvre a Liverdun, nos viandes de l\'eleveur Morelle a Dombasle" — texte, prix, histoire'],
      ['Decision', 'Contacte le concurrent — l\'information disponible directement l\'a convaincu'],
    ] as [string, string][],
    questionCle: 'Quels producteurs locaux, quels terroirs, quelle philosophie — et combien ca coute ?',
    reponse: 'Non' as const,
    commentReponse: 'Zero texte sur les producteurs, zero philosophie visible, zero prix — le PDF ne repond a rien de ce qu\'il cherche.',
    impactVitesse: 'Mobile lent avec PDF — experience frustrante',
    impactConfiance: 'Michelin rassurant mais insuffisant pour valider la coherence avec ses valeurs',
    positifs: ['Guide Michelin = signal de qualite', 'Concept "circuits courts" mentionne en sous-titre'],
    frictions: ['Menu PDF incompatible avec la navigation mobile', 'Pas de section producteurs locaux, pas d\'histoire du restaurant', 'Aucun prix visible'],
    ceQuiFeraitBasculer: 'Une section "Nos producteurs" avec leurs noms, leurs fermes, leurs terroirs. Et une carte en HTML avec les plats et les prix. Paul voulait venir — il avait juste besoin de l\'histoire derriere les assiettes.',
    exp: 5, conf: 7, clarte: 2,
  },
  {
    id: 4,
    name: 'Anne',
    age: 54,
    emoji: '🖥️',
    situation: 'Cherche le meilleur restaurant pour un diner d\'exception a Nancy — compare 3 adresses',
    canal: 'Google Search',
    device: 'Tablette',
    decision: 'Convertit' as const,
    decisionLabel: 'Reserve',
    histoire: '"restaurant michelin nancy" sur tablette → Racine → Guide Michelin 2025 + 4.6 sur 605 avis → site → PDF moins pratique mais accepte → reserve directement.',
    localisation: 'Metz (57)',
    maturite: 'Comparaison',
    contexte: 'Venue a Nancy pour affaires. Cherche le meilleur de la ville pour impressionner ses invites. Budget non limite, qualite maximale.',
    impression: 'Le Michelin + la note de masse = la reference. Sur tablette le PDF est lisible — elle le parcourt et se decide rapidement.',
    parcours: [
      ['Google Search', '"restaurant michelin nancy" — Racine en evidence'],
      ['Site', 'Guide Michelin + 605 avis 4.6 — aucun doute possible'],
      ['La Carte', 'PDF consulte sur tablette — vision suffisante pour valider le niveau'],
      ['Reservation', 'Reserve directement — Michelin + note de masse = double garantie'],
    ] as [string, string][],
    questionCle: 'Quel est le meilleur restaurant de Nancy pour un diner d\'exception ?',
    reponse: 'Oui' as const,
    commentReponse: 'Michelin + 605 avis = reponse incontestable. Elle n\'a pas besoin de plus.',
    impactVitesse: 'Tablette — PDF lisible, vitesse acceptable',
    impactConfiance: 'Michelin + 605 avis = double garantie impossible a contester',
    positifs: ['Guide Michelin 2025 = meilleure garantie possible', 'Volume et note des avis rassurantes', 'Concept cuisine canaille/terroir differenciants'],
    frictions: ['PDF moins pratique qu\'une carte HTML pour comparer les plats'],
    ceQuiFeraitBasculer: '',
    exp: 8, conf: 10, clarte: 6,
  },
  {
    id: 5,
    name: 'Thomas',
    age: 41,
    emoji: '📱',
    situation: 'Cherche un restaurant pour un repas d\'affaires a Nancy, budget 50-60€ par personne',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: '"restaurant affaires nancy" sur Maps → Racine 4.6. Site → cherche les prix → menu PDF non consulte sur mobile → zero tarif visible → impossible de valider le budget → passe au restaurant affichant "formule affaires 45€ par personne".',
    localisation: 'Nancy (54)',
    maturite: 'Comparaison',
    contexte: 'Repas d\'affaires avec client parisien. Doit valider le budget avec son responsable avant de reserver. Besoin d\'un chiffre concret.',
    impression: 'La note interesse et le Michelin rassure — mais sans fourchette de prix, impossible d\'inclure Racine dans le choix final. Le concurrent qui affiche clairement ses tarifs professionnnels est prefere.',
    parcours: [
      ['Google Maps', '"restaurant affaires nancy" — Racine visible avec 4.6'],
      ['Site', 'Cherche une fourchette de prix ou une formule affaires'],
      ['La Carte', 'PDF sur mobile — non consulte, trop peu pratique'],
      ['Decision', 'Passe au concurrent qui affiche "formule affaires 45€ pp, reservation groupe possible"'],
    ] as [string, string][],
    questionCle: 'Quel est le budget pour un repas d\'affaires et y a-t-il une formule groupe ?',
    reponse: 'Non' as const,
    commentReponse: 'Zero information tarifaire accessible, zero formule affaires — impossible de valider le budget avec son responsable.',
    impactVitesse: 'PDF inutilisable sur mobile = zero information disponible en pratique',
    impactConfiance: 'Michelin + 605 avis = note tres attirante, mais insuffisante sans prix',
    positifs: ['Note 4.6 + Michelin = preuve de qualite forte', 'Localisation centrale (rue Stanislas)'],
    frictions: ['Aucune fourchette de prix visible', 'Pas de formule affaires/groupes visible', 'Menu PDF inexploitable sur mobile'],
    ceQuiFeraitBasculer: 'Une fourchette tarifaire visible : "Entrees 12-18€, plats 24-32€, desserts 9€" ou "Menu affaires 42€ pp (3 plats)". Thomas n\'est pas sensible au prix — il a juste besoin d\'un chiffre a valider en interne.',
    exp: 4, conf: 8, clarte: 2,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Menu textuel HTML — la cle de voute du SEO restaurant',
    pourquoi: 'Thomas cherche un budget → aucun prix accessible sur mobile. Paul cherche "cuisine terroir circuits courts nancy" → le PDF est invisible pour Google. Un restaurant avec 605 avis et une distinction Michelin devrait dominer les SERP locaux — il est quasi-invisible hors recherche de marque car son menu n\'existe pas en texte pour les crawlers.',
    action: 'Transformer la carte en contenu web : sections (entrees, plats, desserts), description courte de chaque plat, prix, mise en avant des producteurs locaux (ex: "Truite de la Moselle, legumes de la ferme X a Ludres"). Conserver le PDF en complementaire. Impact SEO immediat sur toute la longue traine des plats + producteurs.',
    impact: '2 visiteurs sur 5 bloqués par l\'absence de contenu textuel',
  },
  {
    titre: 'Mettre en avant le Guide Michelin 2025 en position hero',
    pourquoi: 'Anne cherche "restaurant michelin nancy" → Racine devrait apparaitre en premier ET convaincre des le premier coup d\'oeil. Actuellement la mention Michelin est discrete. C\'est l\'atout differenciant maximal a Nancy — zero autre restaurant local n\'a cette distinction. Un badge "Guide Michelin 2025" en hero, un title H1 avec "restaurant Michelin Nancy" transforment ce signal en moteur de conversion.',
    action: 'Bandeau ou badge hero "Guide Michelin 2025" visible immediatement. Titre H1 avec "restaurant Michelin Nancy" ou "cuisine de terroir Nancy". Schema.org Award pour la distinction Michelin. Plugin SEO (Yoast/Rank Math) pour le meta title : "Racine — Restaurant Michelin Nancy | Cuisine de terroir".',
    impact: '+30-50% CTR estime sur la requete "restaurant michelin nancy"',
  },
  {
    titre: 'Schema.org Restaurant + AggregateRating + Menu',
    pourquoi: '4.6 sur 605 avis non exploites en rich snippets Google. La distinction Michelin ne genere pas d\'etoiles dans les SERP car Schema.org est absent. Un Schema.org Restaurant avec AggregateRating + OpeningHours + servesCuisine = etoiles dans les resultats + horaires directs + positionnement cuisine de terroir.',
    action: 'Ajouter Schema.org JSON-LD : @type Restaurant, name, address, telephone, openingHours, servesCuisine ("cuisine de terroir", "circuits courts"), aggregateRating (ratingValue: 4.6, reviewCount: 605), award (Guide Michelin 2025). WordPress + Yoast/Rank Math permet l\'implementation sans code.',
    impact: 'Etoiles dans les SERP Google pour 605 avis — CTR organique +20-35% estime',
  },
];

const ameliorationsUtiles = [
  {
    titre: 'Page dediee "Evenements & Privatisation"',
    detail: 'Sophie a envoye une demande via formulaire generique pour 8 personnes — friction inutile. Une page "Reservations groupes / anniversaires / repas d\'affaires" avec capacite, conditions, formule groupe et formulaire dedie = capture du segment evenementiel et professionnel sans appel.',
  },
  {
    titre: 'Afficher les fourchettes de prix',
    detail: '"Entrees a partir de 12€, plats 24-32€, desserts 9€" suffit pour les comparateurs professionnels. Pas besoin de tarif exact — une fourchette rassure et maintient Racine dans la liste des candidats pour les repas d\'affaires et les groupes.',
  },
];

const ameliorationsDiscuter = [
  {
    emoji: '📖',
    titre: 'Section "Nos producteurs" — raconter l\'histoire derriere les assiettes',
    detail: 'Les circuits courts Lorraine sont mentionnes en sous-titre mais pas exploites en contenu. Une section avec les noms des producteurs, leurs fermes, leurs terroirs = contenu unique impossible a copier, tres valorise en SEO local et differenciateur fort pour les clients Paul (valeurs) et les clients media.',
  },
  {
    emoji: '📅',
    titre: 'Actus/menus du moment sur le site',
    detail: 'Un restaurant saisonnier qui change sa carte regulierement a une opportunite de contenu frais regulier — signal fort pour Google et motif de re-visite sur le site pour les habitues.',
  },
];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Moyen', ok: false, detail: 'WordPress + Elementor — ~45 mobile, LCP ~3.8s' },
  { label: 'Securite', verdict: 'Bon', ok: true, detail: 'HTTPS + HSTS — grade B- estime (WordPress standard)' },
  { label: 'SEO', verdict: 'Faible', ok: false, detail: 'Menu PDF = invisible Google, aucune page longue traine' },
  { label: 'Donnees structurees', verdict: 'Absent', ok: false, detail: 'Schema.org absent — 4.6 sur 605 avis + Michelin non exploites en rich snippets' },
  { label: 'Partage reseaux', verdict: 'Correct', ok: true, detail: 'OG present (WordPress genere)' },
];

const tech = {
  observatory: { grade: 'B-', score: 60, testsOk: 5, testsTotal: 10 },
  pagespdMobile: { performance: 45, accessibility: 78, bestPractices: 75, seo: 70 },
  pagespdDesktop: { performance: 68, accessibility: 82, bestPractices: 80, seo: 76 },
  cwv: { lcp: '~3.8s (Elementor + PDF)', inp: '~280ms', cls: '~0.06' },
  headers: [
    { ok: true, h: 'HTTPS' },
    { ok: true, h: 'HSTS probable' },
    { ok: false, h: 'Content-Security-Policy (absent)' },
    { ok: true, h: 'X-Frame-Options' },
    { ok: false, h: 'Permissions-Policy (absent)' },
  ],
  schema: [
    { item: 'Schema.org Restaurant / LocalBusiness', ok: false },
    { item: 'Nom + Adresse + Telephone (NAP)', ok: false },
    { item: 'Avis agreges (4.6 / 605 avis)', ok: false },
    { item: 'Horaires structures', ok: false },
    { item: 'servesCuisine (terroir, circuits courts)', ok: false },
    { item: 'Menu structure', ok: false },
    { item: 'Award (Guide Michelin 2025)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'Present (WordPress)' },
    { item: 'og:description', ok: true, val: 'Present (WordPress)' },
    { item: 'og:image', ok: true, val: 'Present probable' },
    { item: 'og:type', ok: true, val: 'website' },
  ],
  seo: [
    { item: 'Title tag present', ok: true },
    { item: 'Meta description', ok: true },
    { item: 'HTTPS', ok: true },
    { item: 'Responsive mobile', ok: true },
    { item: 'Menu textuel indexable', ok: false },
    { item: 'Guide Michelin mis en avant en H1/hero', ok: false },
    { item: 'Schema.org Restaurant', ok: false },
    { item: 'Pages longue traine (terroir, michelin, circuits courts)', ok: false },
    { item: 'Fourchette de prix visible', ok: false },
