    impression: 'Arrive depuis Maps convaincu par la fiche. Site lent. Images grises. Cherche les avis — absents.',
    parcours: [
      ['Accueil mobile depuis Maps', 'Charge lentement, images en placeholder gris'],
      ['Meubles salle de bains', 'Page dediee presente, peu de photos specifiques'],
      ['Cherche avis clients', 'Absent du site — voit email @free.fr en bas de page'],
      ['Retourne sur Google Maps', 'Lit les avis directement sur la fiche GMB'],
    ] as [string, string][],
    questionCle: 'Ils ont des avis clients ? Le style me correspondrait ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le service existe et des photos sont presentes, mais sans avis site ni contexte projet pour chaque photo.',
    impactVitesse: 'Tres impactant : lazy-loading JS cree un CLS visible et degrade l\'experience mobile.',
    impactConfiance: 'Email @free.fr + absence d\'avis sur le site = credibilite insuffisante pour valider 2000-3000 euros.',
    positifs: ['Fiche Google Maps existante avec avis', 'Page salle de bains dediee', 'Zone confirmee'],
    frictions: ['Images lentes (placeholder gris)', 'Aucun avis integre au site', 'Email @free.fr signal negatif', 'Formulaire contact 404'],
