---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'menuiserie-aubertin';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Menuiserie Aubertin';
const urlSite = 'https://www.menuiserie-aubertin.fr';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 88 76 66 48';
const marcTelLink = 'tel:+33688766648';
const marcWhatsApp = 'https://wa.me/33688766648?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.0,
  confiance: 5.4,
  clarte: 5.2,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'Menuiserie Aubertin a de vrais atouts : 100 ans d\'histoire familiale, label Maitre Artisan, zone bien referencee en Moselle (Elvange, Faulquemont, Boulay, Metz, Thionville). Schema.org partiellement configure, sitemap present, galerie de photos existante. Mais deux obstacles bloquent la conversion : les photos ne s\'affichent pas sur mobile (placeholders gris pendant 4-5 secondes), et aucun avis client n\'est integre au site. Pour un projet a plusieurs milliers d\'euros, les visiteurs en phase Comparaison ont besoin de validation sociale avant d\'appeler. 3 sur 5 ont cherche ces avis sans les trouver.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Gerard',
    age: 58,
    emoji: '🚪',
    situation: 'Proprietaire a Bouzonville, porte d\'entree en bois a remplacer',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence devis porte entree. Il cherche "menuisier porte bois Bouzonville". Trouve Aubertin, voit la page Portes, trouve le numero et appelle directement.',
    localisation: 'Bouzonville (57320) — 12 km d\'Elvange',
    maturite: 'Decision',
    contexte: 'Sa porte d\'entree est abimee depuis l\'hiver. Il cherche un menuisier local capable de fabriquer une porte sur mesure rapidement.',
    impression: '"Menuisier a Elvange" — zone proche. Il cherche "Portes" dans le menu.',
