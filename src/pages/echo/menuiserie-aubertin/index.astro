    ] as [string, string][],
    questionCle: 'Ils font les portes sur mesure ? Je peux les appeler ?',
    reponse: 'Oui' as const,
    commentReponse: 'Page Portes presente, numero accessible en header. La decision est deja prise avant l\'arrivee.',
    impactVitesse: 'Lenteur mobile remarquee mais il est en phase Decision — ne part pas.',
    impactConfiance: 'Email @free.fr remarque mais pas bloquant pour ce profil.',
    positifs: ['Zone confirmee (Elvange proche Bouzonville)', 'Page Portes dediee', 'Numero visible en header', '100 ans d\'histoire rassure'],
    frictions: ['Chargement lent sur mobile (4-5s)', 'Email menuiserie.aubertin@free.fr peu professionnel', 'Pas d\'avis clients visibles'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 6, clarte: 7,
  },
  {
    id: 2,
    name: 'Nathalie',
    age: 47,
    emoji: '🪑',
    situation: 'Proprietaire a Faulquemont, recommandee par sa voisine pour une cuisine',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Sa voisine a fait faire une cuisine chez Aubertin. Elle tape "Menuiserie Aubertin" sur Google pour confirmer l\'identite et trouver le contact. Le formulaire de contact est en 404 — elle appelle via le numero du header.',
    localisation: 'Faulquemont (57380) — 8 km d\'Elvange',
    maturite: 'Decision',
    contexte: 'Recommandation directe d\'une voisine satisfaite. Elle veut confirmer l\'identite, voir quelques photos de cuisines, et les contacter.',
    impression: '"MENUISERIE AUBERTIN DOMINIQUE - ARTISAN MAITRE" — identite confirmee. Elle cherche des photos de cuisines.',
    parcours: [
