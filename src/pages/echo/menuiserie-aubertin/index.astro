      ['Contact', 'Formulaire 404 — effort trop grand pour une visite incertaine a 35 km'],
    ] as [string, string][],
    questionCle: 'Ils savent vraiment restaurer un meuble ancien de valeur ? Ca vaut le deplacement ?',
    reponse: 'Non' as const,
    commentReponse: 'La competence est mentionnee mais les preuves visuelles sont insuffisantes (pas d\'avant/apres detailles) pour justifier 35 km.',
    impactVitesse: 'Acceptable sur desktop.',
    impactConfiance: '100 ans d\'histoire rassure, mais pas assez pour ce profil exigeant qui a besoin de preuves concretes de restauration.',
    positifs: ['Histoire familiale forte (100 ans)', '"Ebenisterie" mentionnee explicitement', 'Page dediee Restauration'],
    frictions: ['Pas de photos avant/apres de restauration', 'Formulaire contact en 404', 'Distance (35 km) mal justifiee par le contenu'],
    ceQuiFeraitBasculer: '5-6 photos avant/apres de restauration de meubles anciens avec description du travail accompli et type de bois.',
    exp: 5, conf: 5, clarte: 4,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Integrer les avis clients Google sur la page d\'accueil',
    pourquoi: '3 visiteurs sur 5 (Sandrine, Kevin, Eliane) ont cherche des avis clients et ne les ont pas trouves sur le site. Pour un projet a plusieurs milliers d\'euros (escalier, cuisine, restauration), l\'absence de validation sociale est le premier motif d\'hesitation. La Menuiserie Aubertin a probablement des avis sur sa fiche Google My Business — ils ne sont pas visibles sur le site.',
    action: 'Ajouter les 4-5 meilleurs avis Google directement sur la page d\'accueil (copie manuelle du texte : prenom, ville, type de travaux, note etoilee). Placer ce bloc entre la section Services et la section Histoire. Un visiteur en phase Comparaison qui voit "Marie, Boulay — escalier parfait, delai respecte, 5 etoiles" est rassure immediatement.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A ameliorer', ok: false, detail: 'Quota API epuise — images lentes sur mobile, cache desactive, Google Fonts CDN bloquant.' },
  { label: 'Securite', verdict: 'Grade F', ok: false, detail: 'Observatory F (0/100) — 7 headers de securite manquants, PHP 5.6 expose.' },
  { label: 'SEO', verdict: 'Partiel', ok: false, detail: 'Sitemap et robots.txt presents, H1 correct, mais faute de frappe dans title/OG et formulaire contact en 404.' },
  { label: 'Donnees structurees', verdict: 'Bon socle', ok: true, detail: 'Schema.org LocalBusiness present — manque openingHours, geo, aggregateRating.' },
  { label: 'Partage reseaux', verdict: 'Partiel', ok: false, detail: 'OG title/description/image presents, mais faute de frappe et twitter:card absent.' },
];

const tech = {
  observatory: { grade: 'F', score: 0, testsOk: 3, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible (quota API)', inp: 'Non disponible (quota API)', cls: 'Non disponible (quota API)' },
  headers: [
    { ok: true, h: 'Redirection HTTP vers HTTPS' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (absent)' },
    { ok: false, h: 'Content-Security-Policy (absent)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking)' },
    { ok: false, h: 'X-Content-Type-Options (absent)' },
    { ok: false, h: 'Referrer-Policy (absent)' },
    { ok: false, h: 'PHP 5.6.40 expose dans X-Powered-By (fin de vie 2018)' },
  ],
  schema: [
    { item: 'JSON-LD / Schema.org present', ok: true },
    { item: '@type LocalBusiness declare', ok: true },
    { item: 'name, url, telephone, email', ok: true },
    { item: 'address (rue, ville, CP, pays)', ok: true },
    { item: 'logo + image OG', ok: true },
    { item: 'sameAs (Facebook + Google Maps)', ok: true },
    { item: 'priceRange (€€)', ok: true },
    { item: 'openingHours (absent malgre les horaires affiches)', ok: false },
    { item: 'geo latitude/longitude (absent)', ok: false },
    { item: 'aggregateRating (absent — aucun avis integre)', ok: false },
    { item: '@type specialise Carpenter (utilise LocalBusiness generique)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: '"Menuisier ELVANGE - DOMINQIUE AUBERTIN" (typo DOMINQIUE)' },
    { item: 'og:description', ok: true, val: '"L\'entreprise de menuiserie DOMINIQUE AUBERTIN a Elvange..."' },
    { item: 'og:image', ok: true, val: '/ressources/images/opengraph_cc7c.png' },
    { item: 'og:url', ok: true, val: 'https://www.menuiserie-aubertin.fr/' },
    { item: 'twitter:card', ok: false, val: 'Absent' },
  ],
  seo: [
    { item: 'H1 unique ("Menuisier a Elvange")', ok: true },
    { item: 'Meta description presente', ok: true },
    { item: 'Canonical configuree', ok: true },
    { item: 'robots.txt accessible (disallow /admin/)', ok: true },
    { item: 'sitemap.xml accessible (55+ URLs)', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'Pages SEO locales par ville', ok: true },
    { item: 'Faute de frappe dans title et og:title (DOMINQIUE)', ok: false },
    { item: 'Formulaire de contact en 404', ok: false },
    { item: 'Google Fonts CDN (non RGPD-conforme)', ok: false },
    { item: 'Cache-Control: no-store (performances degradees)', ok: false },
  ],
};

const alertes: { type: 'critique' | 'important'; titre: string; detail: string; chiffre: string; chiffreLabel: string }[] = [
  { type: 'critique' as const, titre: 'Grade securite F', detail: 'Aucune protection active : 7 headers de securite manquants, PHP 5.6 expose. Les navigateurs modernes peuvent alerter vos visiteurs.', chiffre: 'F', chiffreLabel: 'grade securite Mozilla' },
  { type: 'important' as const, titre: 'Formulaire de contact en 404', detail: 'La page de contact affiche une erreur 404. Un visiteur qui veut vous ecrire repart chez un concurrent plutot que de chercher le numero.', chiffre: '404', chiffreLabel: 'erreur page contact' },
  { type: 'important' as const, titre: 'Aucun avis client visible sur le site', detail: '3 visiteurs sur 5 ont cherche des avis avant de contacter. Sans validation sociale visible, les projets a plusieurs milliers d\'euros restent en suspens.', chiffre: '0', chiffreLabel: 'avis integres au site' },
];
---
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 2b. ALERTES -->
{alertes.length > 0 && (
  <section style="background: #fefce8;" class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <div>
          <h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2>
          <p class="text-sm text-neutral-600">
