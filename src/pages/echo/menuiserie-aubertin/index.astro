    questionCle: 'C\'est bien eux ? Comment je les contacte ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Identite claire, photos de cuisines presentes, mais le formulaire de contact est en 404.',
    impactVitesse: 'Acceptable sur desktop.',
    impactConfiance: 'La recommandation voisine prime. Le 404 sur Contact cree un doute de derniere minute.',
    positifs: ['Identite claire et professionnelle', 'Page Cuisine avec photos', 'Label Maitre Artisan visible', 'Histoire familiale rassurante'],
    frictions: ['Formulaire de contact en 404', 'Email @free.fr peu professionnel'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 7, clarte: 6,
  },
  {
    id: 3,
    name: 'Sandrine',
    age: 39,
    emoji: '🔍',
    situation: 'Proprietaire a Boulay-Moselle, cherche un menuisier pour escalier tournant',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle compare 3 menuisiers en parallele. Elle cherche des photos d\'escaliers tournants et des avis clients. Les images restent en gris pendant 4 secondes sur son mobile. Aucun avis sur le site. Elle ouvre l\'onglet du concurrent suivant.',
    localisation: 'Boulay-Moselle (57220) — 6 km d\'Elvange',
    maturite: 'Comparaison',
    contexte: 'Projet escalier tournant pour etage. Budget significatif. Elle veut voir des realisations comparables et lire des avis avant de demander un devis.',
