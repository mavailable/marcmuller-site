---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'ar-chauffage';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'AR Chauffage';
const urlSite = 'https://www.ar-chauffage-avis.com';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 88 76 66 48';
const marcTelLink = 'tel:+33688766648';
const marcWhatsApp = 'https://wa.me/33688766648?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 3,
  nbHesitent: 1,
  nbRepartent: 1,
  conversion: 60,
  experience: 5.8,
  confiance: 7.0,
  clarte: 4.8,
};

const verdictHero = 'Sur 5 visiteurs, 3 vous contactent. 1 hesite. 1 repart vers un concurrent.';

const constat = 'AR Chauffage a un atout exceptionnel : 4,9/5 sur 126 avis — la meilleure note du secteur en Moselle Est. Mais le site ne l\'exploite pas. Pas d\'horaires, zone d\'intervention floue, zero mention "depannage urgence". 3 personas ont ete genes par ces absences. 1 est repart sans meme appeler, faute de savoir si vous interveniez dans sa commune.';

const canalData = [
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Sandra',
    age: 47,
    emoji: '🏠',
    situation: 'Proprietaire a Farebersviller, chaudiere en panne ce matin',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Chaudiere tombee en panne, il fait froid. Elle cherche "chauffagiste urgence Saint-Avold" sur son telephone. Voit les 4,9 etoiles, trouve le numero et appelle directement.',
    localisation: 'Farebersviller (57450)',
    maturite: 'Decision',
    contexte: 'Sa chaudiere est tombee en panne ce matin. Elle a froid et cherche quelqu\'un capable d\'intervenir rapidement. Elle ouvre son telephone dans sa cuisine.',
    impression: 'Chauffagiste, Longeville, avis 4,9 — pas loin. Mais ou est le numero en gros ?',
    parcours: [
      ['Hero', 'Titre "Plombier Chauffagiste a Saint-Avold" visible — mais le CTA "Devis gratuit" lui semble trop lent pour une urgence'],
      ['Avis', 'Les 4,9 etoiles la rassurent immediatement'],
      ['Contact', 'Le 06 60 82 54 00 est present — elle appelle directement'],
    ] as [string, string][],
    questionCle: 'Ils peuvent venir chez moi aujourd\'hui ?',
    reponse: 'Non' as const,
    commentReponse: 'Pas de mention depannage, pas d\'indication de delai, pas de confirmation de zone pour Farebersviller. Elle appelle quand meme car le numero est visible.',
    impactVitesse: 'WordPress + GTM + Didomi peut ralentir le premier affichage mobile — risque de perte si > 3s.',
    impactConfiance: 'La note 4,9/126 avis compense l\'absence d\'informations urgence.',
    positifs: ['Numero de telephone visible', 'Avis 4,9/5 tres rassurants', 'Site professionnel'],
    frictions: ['Pas de mention "depannage urgence" en hero', 'Pas d\'horaires visibles', 'Zone d\'intervention non confirmee pour sa commune'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 7, clarte: 5,
  },
  {
    id: 2,
    name: 'Kevin',
    age: 35,
    emoji: '♻️',
    situation: 'Proprietaire a Woustviller, veut passer en pompe a chaleur via MaPrimeRenov',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Il compare 3 artisans RGE. Trouve les certifications QualiPac sur le site — mais aucune explication sur les aides MaPrimeRenov. Il remplit le formulaire tout en continuant a chercher.',
    localisation: 'Woustviller (57130)',
    maturite: 'Comparaison',
    contexte: 'Il compare 3 artisans RGE. Son critere numero 1 : qui peut l\'accompagner dans le dossier MaPrimeRenov. Budget 12 000 euros, veut savoir ce qu\'il va toucher d\'aides.',
    impression: 'RGE — OK, certifications — OK, mais ou sont les infos sur les aides ?',
    parcours: [
      ['Hero', 'Comprend l\'offre globale. Cherche immediatement "MaPrimeRenov" ou "RGE".'],
      ['Chauffage-Climatisation', 'Trouve QualiPac, QualiBois — listes sans explication ni lien vers les aides'],
      ['Avis', 'Rassure sur la qualite du travail (PAC mentionnees dans plusieurs avis)'],
      ['Contact', 'Remplit le formulaire mais note "MaPrimeRenov" dans son message. Incertain du retour.'],
    ] as [string, string][],
    questionCle: 'Combien ca va vraiment me couter apres aides ?',
    reponse: 'Non' as const,
    commentReponse: 'Certifications RGE confirmees mais aucun contenu sur les aides, aucune fourchette tarifaire, aucun simulateur.',
    impactVitesse: 'Desktop, impact moindre.',
    impactConfiance: 'Absence d\'OG/meta peut fragiliser lors du partage avec sa femme.',
    positifs: ['Certifications RGE clairement listees', 'Avis clients avec mentions de PAC', 'Depot 1 400 m2 = signal de professionnalisme'],
    frictions: ['Certifications RGE non reliees a MaPrimeRenov / CEE', 'Aucune page renovation energetique', 'Pas de prix indicatif', 'Pas de delai de reponse devis'],
    ceQuiFeraitBasculer: 'Une section "MaPrimeRenov : combien vous economisez ?" avec simulateur ou fourchette.',
    exp: 6, conf: 7, clarte: 4,
  },
  {
    id: 3,
    name: 'Michel',
    age: 62,
    emoji: '🔧',
    situation: 'Retraite a Saint-Avold, cherche un nouveau chauffagiste pour entretien annuel',
    canal: 'Google Maps',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Son ancien plombier est a la retraite. Il cherche sur Maps, voit les 126 avis a 4,9. Il ouvre le site pour confirmer, lit les temoignages et appelle.',
    localisation: 'Saint-Avold (57500)',
    maturite: 'Comparaison',
    contexte: 'Il cherche un nouveau prestataire de confiance pour l\'entretien annuel. Il regarde les avis Google. 4,9/5 sur 126 avis le rassure. Il ouvre le site pour confirmer.',
    impression: '4,9 sur 126 avis... c\'est serieux. Le site a l\'air professionnel.',
    parcours: [
      ['Avis clients', 'Arrive directement, lit 5-6 temoignages. Tous recents, detailles, avec lieu.'],
      ['A propos', 'Trouve "societe familiale" et le depot 1 400 m2. Rassurant.'],
      ['Services', 'Confirme qu\'ils font l\'entretien de chaudiere gaz.'],
      ['Contact', 'Appelle le 06 60 82 54 00.'],
    ] as [string, string][],
    questionCle: 'Est-ce que je peux leur faire confiance pour une relation longue duree ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Les avis et "societe familiale" rassurent. Mais pas de tarif d\'entretien, pas de contrat entretien, pas de visage humain.',
    impactVitesse: 'Desktop, pas d\'impact percu.',
    impactConfiance: 'Les cookies Didomi s\'affichent, il les accepte sans attention.',
    positifs: ['126 avis tres detailles', 'Mentions d\'interventions sur des communes connues', 'Depot logistique = impression de structure solide'],
    frictions: ['Pas de tarif d\'entretien annuel visible', 'Pas de photo de l\'equipe', 'Pas d\'horaires de bureau'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 8, clarte: 6,
  },
  {
    id: 4,
    name: 'Amandine',
    age: 29,
    emoji: '📱',
    situation: 'Locataire a Freyming, transmet la demande de son proprietaire pour une fuite',
    canal: 'Reseaux sociaux',
    device: 'Mobile',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Elle a vu AR Chauffage partage sur Facebook. Elle visite le site a 22h. Freyming c\'est 18 km — elle ne sait pas si c\'est dans la zone. Pas d\'horaires, elle abandonne.',
    localisation: 'Freyming-Merlebach (57800)',
    maturite: 'Decouverte',
    contexte: 'Son proprietaire lui a dit "trouve un plombier". Elle a vu AR Chauffage partage sur Facebook. Elle ne sait pas si c\'est dans sa zone. Elle visite le site rapidement.',
    impression: 'C\'est a Saint-Avold... je suis a Freyming, c\'est loin ca ?',
    parcours: [
      ['Hero', 'Voit "Saint-Avold" dans le titre. Freyming c\'est 18 km. Incertain.'],
      ['Zone', 'Cherche une carte ou une liste de communes. Trouve rien.'],
      ['Contact', 'Pense a appeler mais il est 22h, pas d\'horaires affiches. Abandonne.'],
    ] as [string, string][],
    questionCle: 'Ils viennent jusqu\'a Freyming ?',
    reponse: 'Non' as const,
    commentReponse: 'La zone est vaguement definie. "Pres de Saint-Avold" sans precision. La reponse est probablement oui (avis a Kerbach, 12 km) mais le site ne le dit pas.',
    impactVitesse: 'Mobile, 22h, connexion 4G — GTM + Didomi peut etre long.',
    impactConfiance: 'Didomi se charge en retard, experience saccadee probable.',
    positifs: ['Les avis 4,9 sont visibles (auraient pu la retenir)', 'Le numero est la'],
    frictions: ['Zone d\'intervention non definie', 'Pas d\'horaires', 'Pas de formulaire simplifie en accueil mobile'],
    ceQuiFeraitBasculer: 'Un encart "Nous intervenons dans un rayon de 30 km : Saint-Avold, Forbach, Freyming, Sarreguemines..."',
    exp: 4, conf: 5, clarte: 3,
  },
  {
    id: 5,
    name: 'Jerome',
    age: 38,
    emoji: '🌬️',
    situation: 'Gerant d\'un commerce a Longeville, veut installer la clim pour l\'ete',
    canal: 'Bouche-a-oreille',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Son voisin lui a dit "AR Chauffage, ils sont bons". Il tape le nom sur Google, arrive sur le site. Voit les services clim pro (VRV/DRV), remplit le formulaire devis.',
    localisation: 'Longeville-les-Saint-Avold (57740)',
    maturite: 'Comparaison',
    contexte: 'Son voisin lui a recommande AR Chauffage. Il tape le nom sur Google, arrive sur le site. Veut un devis pour une clim professionnelle. Budget serieux, veut une reponse rapide.',
    impression: 'Mon voisin avait raison, ca a l\'air serieux. Maintenant je trouve comment les contacter.',
    parcours: [
      ['Hero', 'Positif. Il cherche le numero ou le formulaire devis.'],
      ['Services/Climatisation', 'Confirme qu\'ils font la clim. Cherche "commerce", "local professionnel" — pas trouve.'],
      ['Formulaire devis', 'Le remplit. Champs generiques, pas de case "type de local". Ecrit "local commercial 80 m2" dans le champ message.'],
    ] as [string, string][],
    questionCle: 'Ils font aussi les locaux commerciaux et ils rappellent vite ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Clim professionnelle (VRV/DRV) presente sur la page services. Mais aucune mention de clients pro/commerces, et zero indication de delai de reponse.',
    impactVitesse: 'Mobile, GTM charge des scripts tiers. Possible ralentissement sur le formulaire.',
    impactConfiance: 'HTTPS OK. Grade C Observatory non percu. Recommandation personnelle rassure davantage.',
    positifs: ['Recommandation prealable = deja en confiance', 'Services clim professionnels listes (VRV/DRV)', 'Avis clients rassurants'],
    frictions: ['Aucune mention de clients professionnels / commerces', 'Formulaire sans champ "type de projet"', 'Pas de delai de reponse affiche'],
    ceQuiFeraitBasculer: 'Un temoignage client "Local commercial" ou une mention "Clim pour professionnels et commerces".',
    exp: 6, conf: 8, clarte: 6,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Afficher horaires + zone d\'intervention en page d\'accueil',
    pourquoi: '3 visiteurs sur 5 ont ete genes par ces 2 absences. Amandine est repartie uniquement parce qu\'elle ne savait pas si vous interveniez a Freyming. Sandra ne savait pas si vous etiez ouverts. Ce sont des clients perdus pour un manque d\'information basique.',
    action: 'Ajouter sous le hero : une ligne "Nous intervenons dans un rayon de 30 km : Saint-Avold, Forbach, Freyming-Merlebach, Sarreguemines, Boulay..." + les horaires "Lun-Ven 8h-18h, Samedi 9h-12h, Urgences 24/7".',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Non mesure', ok: true, detail: 'WordPress + GTM + Didomi — quota API epuise lors de l\'audit. Estimation 45-65 mobile.' },
  { label: 'Securite', verdict: 'Grade C', ok: false, detail: 'Observatory MDN : 55/100 — CSP et HSTS absents.' },
  { label: 'SEO', verdict: 'A ameliorer', ok: false, detail: 'robots.txt absent (404). Sitemap date de juillet 2024.' },
  { label: 'Donnees structurees', verdict: 'Partiel', ok: false, detail: 'Schema.org via widget Plus que Pro — geo, openingHours, sameAs manquants.' },
  { label: 'Partage reseaux', verdict: 'Non confirme', ok: false, detail: 'Balises OG non detectees — partage Facebook/LinkedIn sans apercu.' },
];

const tech = {
  observatory: { grade: 'C', score: 55, testsOk: 8, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'X-Frame-Options: SAMEORIGIN' },
    { ok: true, h: 'X-Content-Type-Options: nosniff' },
    { ok: true, h: 'Referrer-Policy: same-origin' },
    { ok: true, h: 'Redirection HTTP vers HTTPS' },
    { ok: false, h: 'Content-Security-Policy (absent)' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (absent)' },
  ],
  schema: [
    { item: 'JSON-LD present (via widget Plus que Pro)', ok: true },
    { item: '@type LocalBusiness', ok: true },
    { item: 'name, url, aggregateRating (4.9/126)', ok: true },
    { item: 'address complet (manque geo)', ok: false },
    { item: 'geo (latitude/longitude)', ok: false },
    { item: 'telephone dans schema', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
  ],
  og: [
    { item: 'og:title (accueil)', ok: false, val: 'Non detecte' },
    { item: 'og:description', ok: false, val: 'Non detecte' },
    { item: 'og:image', ok: false, val: 'Non detecte' },
    { item: 'og:url', ok: false, val: 'Non detecte' },
    { item: 'twitter:card', ok: false, val: 'Non detecte' },
  ],
  seo: [
    { item: 'H1 unique et pertinent', ok: true },
    { item: 'Hierarchie H1 > H2 coherente', ok: true },
    { item: 'Sitemap.xml accessible', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'robots.txt accessible', ok: false },
    { item: 'robots.txt a jour', ok: false },
    { item: 'Sitemap a jour (dernier update : juillet 2024)', ok: false },
    { item: 'Meta description confirmee', ok: false },
  ],
};

const alertes: { type: 'critique' | 'important'; titre: string; detail: string; chiffre: string; chiffreLabel: string }[] = [
  { type: 'important' as const, titre: 'Zone d\'intervention absente en page d\'accueil', detail: 'Amandine est repartie uniquement parce qu\'elle ne savait pas si vous interveniez a Freyming. Un client perdu pour un manque d\'information basique.', chiffre: '3/5', chiffreLabel: 'personas bloques par cette friction' },
  { type: 'important' as const, titre: 'Horaires invisibles', detail: 'Sandra ne savait pas si vous etiez ouverts. Les horaires doivent etre visibles immediatement en page d\'accueil.', chiffre: '3/5', chiffreLabel: 'visiteurs cherchent les horaires' },
  { type: 'important' as const, titre: '0 donnees structurees', detail: 'JSON-LD Schema.org absent ou incomplet — Google ne peut pas afficher vos infos dans les resultats locaux (telephone, horaires, avis).', chiffre: '0', chiffreLabel: 'champs schema.org complets' },
  { type: 'important' as const, titre: 'RGE non relie aux aides MaPrimeRenov', detail: 'Les certifications RGE ne sont pas connectees aux aides disponibles. 2 personas en phase Comparaison cherchent cette information pour choisir.', chiffre: 'C', chiffreLabel: 'grade securite Mozilla Observatory' },
];
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 2b. ALERTES -->
{alertes.length > 0 && (
  <section style="background: #fefce8;" class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <div>
          <h2 class="text-lg font-bold text-neutral-900">Problemes detectes</h2>
          <p class="text-sm text-neutral-600">
            {alertes.filter(a => a.type === 'critique').length > 0 && <span class="text-red-700 font-medium">{alertes.filter(a => a.type === 'critique').length} critique{alertes.filter(a => a.type === 'critique').length > 1 ? 's' : ''}</span>}
            {alertes.filter(a => a.type === 'critique').length > 0 && alertes.filter(a => a.type === 'important').length > 0 && <span class="mx-1 text-neutral-400">·</span>}
            {alertes.filter(a => a.type === 'important').length > 0 && <span class="text-amber-700 font-medium">{alertes.filter(a => a.type === 'important').length} important{alertes.filter(a => a.type === 'important').length > 1 ? 's' : ''}</span>}
          </p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {alertes.map(a => (
          <div class={`bg-white rounded-xl p-5 ${a.type === 'critique' ? 'border-2 border-red-300' : 'border border-amber-200'}`}>
