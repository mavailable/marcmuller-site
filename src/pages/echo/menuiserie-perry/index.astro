            <span class={`text-xs ${s.ok ? 'text-neutral-600' : 'text-red-500'}`}>{s.item}</span>
          </div>
        ))}
      </div>
    </details>

    <!-- Micro-CTA technique -->
    <div class="mt-8 rounded-xl p-5 bg-white border border-neutral-200 flex items-start gap-3">
      <span class="text-lg shrink-0 mt-0.5">🔧</span>
      <div>
        <p class="text-sm font-medium text-neutral-800">Tout ça est corrigeable.</p>
        <p class="text-xs text-neutral-600 mt-1">Un site bien construit obtient 90+ sur tous les indicateurs. C'est ce que je livre à mes clients.</p>
      </div>
    </div>

  </div>
</section>

