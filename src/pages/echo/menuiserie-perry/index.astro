    exp: 3, conf: 5, clarte: 4,
  },
];
---

<BaseLayout
  title={`Echo Complet — ${nomProspect}`}
  description={`Rapport confidentiel Echo Complet pour ${nomProspect}`}
  noindex={true}
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analysé : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simulés · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hésitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- 2. CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'où viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivée.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-44 sm:w-52 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-24 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>

  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores détaillés (expérience, confiance, clarté)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Expérience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilité, fluidité</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Crédibilité, preuves, réassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarté</div>
        <p class="text-[10px] text-neutral-400 mt-1">Compréhension de l'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <!-- Ceux qui contactent -->
    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent
        <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group persona-card bg-white rounded-xl overflow-hidden shadow-sm border border-green-200" data-canal={p.canal}>
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p>
                  <p class="text-neutral-600">{p.contexte}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Première impression (5 sec)</p>
                  <p class="text-neutral-600">{p.impression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                  <p class="text-neutral-600">Le site répond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <p class="font-semibold text-green-700 mb-1.5">✓ Points positifs</p>
                    <ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul>
                  </div>
                  <div>
                    <p class="font-semibold text-amber-700 mb-1.5">✗ Frictions</p>
                    <ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul>
                  </div>
                </div>
                <div class="flex gap-6 pt-3 border-t border-neutral-100">
                  {[{ label: 'Expérience', val: p.exp }, { label: 'Confiance', val: p.conf }, { label: 'Clarté', val: p.clarte }].map(s => {
                    const sColor = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
                    return (
                      <div class="text-center">
                        <span class={`block text-lg font-bold ${sColor}`}>{s.val}</span>
                        <span class="text-[10px] text-neutral-400">{s.label}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- Ceux qui hesitent -->
    <div class="mb-4">
      <h3 class="text-base font-bold text-amber-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block"></span>
        Ceux qui hésitent
        <span class="text-sm font-normal text-amber-600">({kpis.nbHesitent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Hesite').map(p => (
          <details class="group persona-card bg-white rounded-xl overflow-hidden shadow-sm border border-amber-200" data-canal={p.canal}>
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-amber-500 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-amber-200">
              <div class="grid gap-4 text-xs mt-4">
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p>
                  <p class="text-neutral-600">{p.contexte}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Première impression (5 sec)</p>
                  <p class="text-neutral-600">{p.impression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                  <p class="text-neutral-600">Le site répond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <p class="font-semibold text-green-700 mb-1.5">✓ Points positifs</p>
                    <ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul>
                  </div>
                  <div>
                    <p class="font-semibold text-amber-700 mb-1.5">✗ Frictions</p>
                    <ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul>
                  </div>
                </div>
                {p.ceQuiFeraitBasculer && (
                  <div class="bg-orange-50 rounded-lg p-3">
                    <p class="font-semibold text-orange-700 text-[10px] uppercase tracking-wider mb-1">Ce qui le ferait passer à l'action</p>
                    <p class="text-orange-800">{p.ceQuiFeraitBasculer}</p>
                  </div>
                )}
                <div class="flex gap-6 pt-3 border-t border-neutral-100">
                  {[{ label: 'Expérience', val: p.exp }, { label: 'Confiance', val: p.conf }, { label: 'Clarté', val: p.clarte }].map(s => {
                    const sColor = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
                    return (
                      <div class="text-center">
                        <span class={`block text-lg font-bold ${sColor}`}>{s.val}</span>
                        <span class="text-[10px] text-neutral-400">{s.label}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- Micro-CTA hesitants -->
    <div class="rounded-xl p-5 mb-10 bg-amber-50 border border-amber-200 flex items-start gap-3">
      <span class="text-lg shrink-0 mt-0.5">💡</span>
      <div>
        <p class="text-sm font-medium text-amber-900">Ces {kpis.nbHesitent} visiteurs ont besoin de vos services.</p>
        <p class="text-xs text-amber-700 mt-1">Il leur manque un élément de réassurance pour passer à l'action. C'est votre plus gros levier de croissance.</p>
      </div>
    </div>

    <!-- Ceux qui repartent -->
    <div class="mb-4">
      <h3 class="text-base font-bold text-neutral-600 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-neutral-400 inline-block"></span>
        Ceux qui repartent
        <span class="text-sm font-normal text-neutral-500">({kpis.nbRepartent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Quitte').map(p => (
          <details class="group persona-card bg-white rounded-xl overflow-hidden shadow-sm border border-neutral-200" data-canal={p.canal}>
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-neutral-400 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-neutral-200">
              <div class="grid gap-4 text-xs mt-4">
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p>
                  <p class="text-neutral-600">{p.contexte}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Première impression (5 sec)</p>
                  <p class="text-neutral-600">{p.impression}</p>
                </div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                  <p class="text-neutral-600">Le site répond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <p class="font-semibold text-green-700 mb-1.5">✓ Points positifs</p>
                    <ul class="space-y-1 text-neutral-600">{p.positifs.map(pt => <li class="flex gap-1.5"><span class="text-green-500 shrink-0">·</span>{pt}</li>)}</ul>
                  </div>
                  <div>
                    <p class="font-semibold text-amber-700 mb-1.5">✗ Frictions</p>
                    <ul class="space-y-1 text-neutral-600">{p.frictions.map(f => <li class="flex gap-1.5"><span class="text-amber-500 shrink-0">·</span>{f}</li>)}</ul>
                  </div>
                </div>
                {p.ceQuiFeraitBasculer && (
                  <div class="bg-orange-50 rounded-lg p-3">
                    <p class="font-semibold text-orange-700 text-[10px] uppercase tracking-wider mb-1">Ce qui l'aurait retenu</p>
                    <p class="text-orange-800">{p.ceQuiFeraitBasculer}</p>
                  </div>
                )}
                <div class="flex gap-6 pt-3 border-t border-neutral-100">
                  {[{ label: 'Expérience', val: p.exp }, { label: 'Confiance', val: p.conf }, { label: 'Clarté', val: p.clarte }].map(s => {
                    const sColor = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
                    return (
                      <div class="text-center">
                        <span class={`block text-lg font-bold ${sColor}`}>{s.val}</span>
                        <span class="text-[10px] text-neutral-400">{s.label}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- Micro-CTA repartent -->
    <div class="rounded-xl p-5 bg-neutral-100 border border-neutral-200 flex items-start gap-3">
      <span class="text-lg shrink-0 mt-0.5">📉</span>
      <div>
        <p class="text-sm font-medium text-neutral-800">Chaque visiteur qui repart, c'est un client en moins.</p>
        <p class="text-xs text-neutral-600 mt-1">Certains n'étaient pas dans votre cible — c'est normal. Mais d'autres avaient un vrai besoin et votre site ne les a pas convaincus.</p>
      </div>
    </div>

  </div>
</section>

<!-- 4. CE QU'ON RECOMMANDE -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <h2 class="text-2xl font-bold text-neutral-900 mb-2">Ce qu'on recommande</h2>
  <p class="text-neutral-600 mb-8">Actions concrètes, classées par impact sur vos visiteurs.</p>

  <p class="text-sm font-semibold text-red-700 mb-4">Si vous ne changez que {ameliorationsHautes.length} choses :</p>

  <div class="space-y-4 mb-12">
    {ameliorationsHautes.map(a => (
      <div class="bg-white border-2 border-red-200 rounded-xl p-6 shadow-sm">
        <div class="flex items-start justify-between gap-4 mb-3">
          <h4 class="font-bold text-neutral-900">{a.titre}</h4>
          <span class="text-[10px] px-2 py-1 rounded-full bg-red-100 text-red-700 font-semibold shrink-0 whitespace-nowrap">{a.impact}</span>
        </div>
        <p class="text-sm text-neutral-600 mb-3">{a.pourquoi}</p>
        <div class="bg-neutral-50 rounded-lg px-4 py-3 flex items-start gap-2">
          <svg class="w-4 h-4 text-neutral-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          <p class="text-xs text-neutral-700">{a.action}</p>
        </div>
      </div>
    ))}
  </div>

  <h3 class="text-lg font-bold text-neutral-900 mb-2">Utile aussi</h3>
  <div class="grid md:grid-cols-2 gap-4 mb-12">
    {ameliorationsUtiles.map(a => (
      <div class="bg-white border border-neutral-200 rounded-xl p-5">
        <h4 class="font-semibold text-neutral-900 text-sm mb-2">{a.titre}</h4>
        <p class="text-xs text-neutral-600">{a.detail}</p>
      </div>
    ))}
  </div>

  <h3 class="text-lg font-bold text-neutral-900 mb-2">À discuter</h3>
  <p class="text-sm text-neutral-500 mb-4">Décisions business — pas de bonne ou mauvaise réponse.</p>
  <div class="space-y-3 mb-12">
    {ameliorationsDiscuter.map(a => (
      <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-4 flex gap-3">
        <span class="text-lg shrink-0">{a.emoji}</span>
        <div>
          <h4 class="font-semibold text-neutral-900 text-sm mb-0.5">{a.titre}</h4>
          <p class="text-xs text-neutral-600">{a.detail}</p>
        </div>
      </div>
    ))}
  </div>

  <!-- Upsell -->
  {showUpsell && (
    <div class="rounded-2xl p-8 text-center border-2 border-dashed" style="border-color: #E86C47; background: rgba(232,108,71,0.03);">
      <p class="text-lg font-bold text-neutral-900 mb-2">{kpis.nbPersonas} visiteurs confirment des tendances claires.</p>
      <p class="text-sm text-neutral-600 mb-6">Avec 100 visiteurs (Echo Pro), vous obtenez une fiabilité statistique : analyse par canal, par maturité, et un appel de 30 min pour parcourir le rapport ensemble.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/echo/" data-umami-event="echo-report-upsell-pro" class="inline-flex items-center gap-2 px-6 py-3 text-white font-semibold rounded-xl transition-all shadow-md hover:-translate-y-0.5" style="background: linear-gradient(135deg, #E86C47, #D4572F);">
          Echo Pro — 250€ <span class="text-xs opacity-70 ml-1">(100 visiteurs + appel 30 min)</span>
        </a>
      </div>
    </div>
  )}

</section>

<!-- 5. SOUS LE CAPOT -->
<section class="py-16 border-t border-neutral-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Sous le capot</h2>
    <p class="text-neutral-600 mb-8">Pour les curieux : ce que les outils techniques disent de votre site.</p>

    <div class="flex flex-wrap gap-3 mb-10">
      {techVerdicts.map(v => (
        <div class={`inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border text-sm font-medium ${v.ok ? 'bg-green-50 border-green-200 text-green-800' : 'bg-red-50 border-red-200 text-red-800'}`}>
          {v.ok
            ? <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            : <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          }
          <span>{v.label}</span>
          <span class="text-xs opacity-70">{v.verdict}</span>
        </div>
      ))}
    </div>

    <!-- PageSpeed -->
    <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
        <div class="flex items-center gap-3">
          <span class="text-base">⚡</span>
          <div>
            <h3 class="font-semibold text-neutral-900 text-sm">Vitesse du site</h3>
            <p class="text-[11px] text-neutral-500">{techVerdicts[0].detail}</p>
          </div>
        </div>
        <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-neutral-100">
        <div class="py-4">
          <p class="text-sm text-neutral-600">Données non disponibles lors de l'audit (quota API épuisé).</p>
          <a href={`https://pagespeed.web.dev/report?url=${urlSite}`} target="_blank" class="text-sm text-orange-600 underline hover:text-orange-800 mt-1 inline-block">Tester sur PageSpeed →</a>
        </div>
      </div>
    </details>

    <!-- Observatory / Securite -->
    <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
        <div class="flex items-center gap-3">
          <span class="text-base">🔒</span>
          <div>
            <h3 class="font-semibold text-neutral-900 text-sm">Sécurité</h3>
            <p class="text-[11px] text-neutral-500">{techVerdicts[1].detail}</p>
          </div>
        </div>
        <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-neutral-100">
        <p class="text-xs text-neutral-500 py-2">Note : {tech.observatory.grade} — score {tech.observatory.score}/100 ({tech.observatory.testsOk}/{tech.observatory.testsTotal} tests passés)</p>
        {tech.headers.map(h => (
          <div class="flex items-center gap-2 py-1">
            {h.ok
              ? <svg class="w-3.5 h-3.5 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              : <svg class="w-3.5 h-3.5 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            }
            <span class={`text-xs ${h.ok ? 'text-neutral-600' : 'text-red-500'}`}>{h.h}</span>
          </div>
        ))}
      </div>
    </details>

    <!-- Schema.org -->
    <details class="group border border-neutral-200 rounded-xl overflow-hidden mb-3 bg-white">
      <summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-neutral-50/50">
        <div class="flex items-center gap-3">
          <span class="text-base">📊</span>
