    positifs: ['Nom de domaine clair (ajstoiture.fr)', 'Zone Metz confirmee', 'Telephone disponible'],
    frictions: ['Telephone non visible au premier coup d\'oeil mobile', 'Aucun CTA "Urgence" en hero', 'Pas de garantie d\'intervention sous X heures'],
    ceQuiFeraitBasculer: '',
    exp: 5, conf: 6, clarte: 6,
  },
  {
    id: 2,
    name: 'Bernard',
    age: 67,
    emoji: '👴',
    situation: 'Retraite a Sainte-Ruffine, recommande par un voisin satisfait',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Son voisin lui a donne le nom. Il tape "AJS Toiture" directement. Confirme l\'identite, trouve le telephone, appelle.',
    localisation: 'Sainte-Ruffine (57130)',
    maturite: 'Decision',
    contexte: 'Son voisin lui a donne le nom d\'AJS Toiture. Il veut confirmer que c\'est serieux et trouver le numero de telephone.',
    impression: '"AJS Toiture Pere et Fils" — c\'est bien eux. Il cherche le telephone.',
    parcours: [
      ['Accueil', 'Identite confirmee, entreprise familiale'],
      ['Contact', 'Telephone trouve rapidement sur desktop, appelle'],
    ] as [string, string][],
