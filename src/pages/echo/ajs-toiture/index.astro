    parcours: [
      ['Accueil', 'Entreprise familiale, Metz — credible'],
      ['Navigation', 'Cherche "realisations" ou "galerie" — absent du menu'],
      ['Contact', 'Email Yahoo visible — signal negatif definitif'],
    ] as [string, string][],
    questionCle: 'Ils ont deja fait ca ? C\'est dans quel budget ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune page realisations, aucun avant/apres, aucune fourchette de prix.',
    impactVitesse: 'Acceptable sur desktop.',
