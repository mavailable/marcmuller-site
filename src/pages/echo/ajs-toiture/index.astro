---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'ajs-toiture';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'AJS Toiture Pere et Fils';
const urlSite = 'https://www.ajstoiture.fr';
const dateAudit = '30 mars 2026';
const showUpsell = false;
const isProspection = true;
const marcTel = '06 26 50 59 89';
const marcTelLink = 'tel:+33626505989';
const marcWhatsApp = 'https://wa.me/33626505989?text=Bonjour%20Marc%2C%20j%27ai%20lu%20votre%20rapport%20sur%20mon%20site';

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.0,
  confiance: 5.4,
  clarte: 5.2,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'AJS Toiture a de bons atouts : entreprise familiale reconnue a Metz, partenaires de qualite (Point.P, Velux), 5 etoiles sur Google Maps. Mais le site souffre d\'un manque critique : aucune photo de chantiers. Pour un metier aussi visuel que la couverture, les visiteurs en phase Comparaison ont besoin de voir votre travail avant d\'appeler. 3 sur 5 ont cherche ces photos sans les trouver.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Michel',
    age: 52,
    emoji: '🏠',
    situation: 'Proprietaire a Montigny-les-Metz, infiltration depuis 3 jours',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence infiltration. Il cherche "couvreur Metz urgence". Trouve AJS Toiture, voit la zone confirmee, trouve le numero et appelle directement.',
    localisation: 'Montigny-les-Metz (57158)',
    maturite: 'Decision',
    contexte: 'Il a une infiltration depuis 3 jours apres les fortes pluies. Il cherche un couvreur disponible rapidement.',
    impression: 'Le titre "couvreur Metz" le rassure. Il cherche un numero immediatement.',
    parcours: [
      ['Accueil', 'Voit "couvreur Metz" — OK, cherche "urgence"'],
      ['Telephone', 'Le trouve apres scrolling — 06 34 11 41 07'],
      ['Appelle', 'Il est en Decision — le numero suffit'],
    ] as [string, string][],
    questionCle: 'Ils interviennent quand ? Aujourd\'hui ?',
