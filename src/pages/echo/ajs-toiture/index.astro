    maturite: 'Comparaison',
    contexte: 'Il a vu AJS Toiture sur Google Maps avec 5 etoiles. Il clique sur le lien du site depuis la fiche Google pour confirmer la competence toit plat.',
    impression: 'Il arrive convaincu par les etoiles. Il cherche des photos de toits plats.',
    parcours: [
      ['Accueil mobile', 'OK, site charge. Cherche galerie ou photos.'],
      ['Navigation', 'Cherche "realisations" — absent'],
      ['Quitte', 'Verifie le concurrent suivant sur Maps'],
    ] as [string, string][],
    questionCle: 'Ils font les toits plats ? C\'est credible ?',
    reponse: 'Non' as const,
