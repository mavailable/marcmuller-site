  },
  {
    id: 3,
    name: 'Isabelle',
    age: 44,
    emoji: '🔍',
    situation: 'Proprietaire a Woippy, cherche devis pour demoussage complet',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
