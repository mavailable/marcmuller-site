---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'roger-maire';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'Roger Maire et Fils';
const urlSite = 'https://roger-maire-et-cie.com';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 2,
  nbHesitent: 2,
  nbRepartent: 1,
  conversion: 40,
  experience: 5.2,
  confiance: 5.0,
  clarte: 5.4,
};

const verdictHero = 'Sur 5 visiteurs, 2 vous contactent. 2 hesitent. 1 repart vers un concurrent.';

const constat = 'Roger Maire et Fils a de bons fondamentaux : entreprise familiale implantee a Marly depuis de nombreuses annees, zone Moselle bien couverte (171 pages indexees), telephone accessible. Mais deux frictions majeures freinent la conversion : la page "Nos Realisations" retourne une erreur — les visiteurs qui cherchent a voir votre travail tombent sur un message d\'erreur. Et l\'email Wanadoo visible sur le site signale une entreprise qui n\'a pas evolue depuis 2005. Ces deux points font partir les visiteurs en phase de comparaison.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Google Maps', nb: 1, convert: 0, rate: 0 },
  { canal: 'Reseaux sociaux', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Jean-Luc',
    age: 54,
    emoji: '🔧',
    situation: 'Proprietaire a Montigny-les-Metz, chaudiere en panne depuis ce matin',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Urgence chauffage. Il cherche "plombier chauffagiste urgence Metz" sur son telephone. Trouve Roger Maire et Fils, voit le numero et appelle directement.',
    localisation: 'Montigny-les-Metz (57158)',
    maturite: 'Decision',
    contexte: 'Plus de chauffage un matin de mars. Il cherche quelqu\'un qui vient aujourd\'hui.',
    impression: 'Le titre "Plombier chauffagiste Metz" le rassure. Il cherche un numero immediatement.',
    parcours: [
      ['Accueil', 'Voit "plombier chauffagiste Metz" — OK, cherche "urgence"'],
      ['Header', 'Repere le telephone 03 87 62 56 92'],
      ['Appel', 'Il est en Decision — le numero suffit'],
    ] as [string, string][],
    questionCle: 'Ils viennent aujourd\'hui ? C\'est quoi le delai ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Les horaires de depannage (oct-avril) sont mentionnes mais pas en hero. Il trouve le numero et appelle sans certitude.',
    impactVitesse: 'Si le site met 4 secondes a charger sur mobile, il peut raccrocher avant de voir le numero.',
    impactConfiance: 'Grade F Observatory = invisible pour lui. Seul le numero compte.',
    positifs: ['Numero de telephone accessible', 'Zone Metz/Moselle confirmee', 'Nom familial rassurant'],
    frictions: ['Pas de bandeau "Urgence chauffage" visible', 'Pas de mention "Intervention aujourd\'hui"', 'Lenteur mobile estimee (45-60/100)'],
    ceQuiFeraitBasculer: '',
    exp: 6, conf: 6, clarte: 6,
  },
  {
    id: 2,
    name: 'Martine',
    age: 61,
    emoji: '🏠',
    situation: 'Proprietaire a Marly, retraitee — recommandee par une voisine',
    canal: 'Bouche-a-oreille',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Sa voisine lui a donne le nom. Elle tape "Roger Maire et Fils" sur Google. Confirme l\'identite, trouve le telephone, appelle.',
    localisation: 'Marly (57155)',
    maturite: 'Decision',
    contexte: 'Sa voisine lui a donne le nom de l\'entreprise. Elle veut confirmer que c\'est serieux et trouver le numero.',
    impression: '"Roger Maire et Fils" — le nom correspond. Elle est rassure instantanement.',
    parcours: [
      ['Accueil', 'Identite confirmee, entreprise familiale a Marly'],
      ['Contact', 'Telephone trouve facilement sur desktop'],
      ['Appel', 'La recommandation pese tout'],
    ] as [string, string][],
    questionCle: 'C\'est bien eux ? Comment je les contacte ?',
    reponse: 'Oui' as const,
    commentReponse: 'Nom visible, telephone accessible, adresse Marly confirmee.',
    impactVitesse: 'OK sur desktop.',
    impactConfiance: 'Email Wanadoo visible — legere interrogation mais la recommandation prime.',
    positifs: ['Nom identifiable immediatement', 'Entreprise locale a Marly', 'Telephone accessible'],
    frictions: ['Email maire.et.cie@wanadoo.fr — signal de vieillissement', 'Aucun avis affiche (cherche une confirmation)'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 7, clarte: 7,
  },
  {
    id: 3,
    name: 'Camille',
    age: 35,
    emoji: '🚿',
    situation: 'Proprietaire a Woippy, cherche un artisan pour renover sa salle de bain',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle compare 3-4 plombiers pour un projet renovation salle de bain. Elle clique "Nos Realisations" — erreur 500. Elle garde le numero en favori mais part voir les concurrents.',
    localisation: 'Woippy (57140)',
    maturite: 'Comparaison',
    contexte: 'Projet renovation salle de bain entre 8 000 et 12 000 euros. Elle prend le temps de comparer, elle veut voir du travail concret.',
    impression: 'Site sobre, titre clair. Elle cherche immediatement "realisations" dans le menu.',
    parcours: [
      ['Accueil', 'Services listes — voit "salle de bain", cherche la galerie'],
      ['Menu', 'Clique sur "Nos realisations"'],
      ['Erreur 500', 'Page inaccessible — frustration immediate'],
      ['Retour accueil', 'Cherche des avis — introuvable'],
      ['Quitte', 'Part chez un concurrent qui affiche ses realisations'],
    ] as [string, string][],
    questionCle: 'Ils font les salles de bain ? C\'est dans quel budget ?',
    reponse: 'Non' as const,
    commentReponse: '"Salle de bain" est liste mais la page realisations retourne une erreur, aucun prix, aucun temoignage.',
    impactVitesse: 'Lenteur mobile amplifie la frustration apres l\'erreur 500.',
    impactConfiance: 'Page en erreur + email Wanadoo = deux signaux negatifs consecutifs.',
    positifs: ['Service salle de bain mentionne', 'Zone Woippy confirmee'],
    frictions: ['Page realisations inaccessible (erreur 500)', 'Aucune photo ni temoignage', 'Email Wanadoo', 'Aucune fourchette de prix'],
    ceQuiFeraitBasculer: '3-4 photos de salles de bain renovees + un temoignage client + la page realisations qui fonctionne.',
    exp: 4, conf: 4, clarte: 4,
  },
  {
    id: 4,
    name: 'Theo',
    age: 29,
    emoji: '📱',
    situation: 'Locataire a Metz-Centre, fuite sous l\'evier — cherche un plombier',
    canal: 'Google Maps',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Il arrive depuis la fiche Google Maps. Il veut confirmer la zone, voir des avis. Pas d\'avis sur le site, email Wanadoo vu en bas de page. Il repart lire les avis directement sur Maps.',
    localisation: 'Metz (57000)',
    maturite: 'Comparaison',
    contexte: 'Fuite sous l\'evier dans son appartement. Il cherche sur Maps, clique sur le lien du site depuis la fiche GBP.',
    impression: 'Il arrive avec de bonnes intentions — la fiche Maps lui a montre l\'entreprise. Il cherche a confirmer.',
    parcours: [
      ['Accueil', 'Voit Marly — cherche "Metz" dans la couverture zone'],
      ['Footer', 'Trouve des liens "plomberie Metz" — zone confirmee'],
      ['Cherche avis', 'Aucun temoignage, aucune note sur le site'],
      ['Voit email Wanadoo', 'Signal negatif'],
      ['Retour Maps', 'Repart lire les avis Google directement'],
    ] as [string, string][],
    questionCle: 'Ils interviennent a Metz-Centre ? C\'est combien ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Zone Metz couverte (liens footer) mais aucun tarif, aucun delai, aucun avis.',
    impactVitesse: 'Lenteur mobile = impatience accrue pour un besoin urgent.',
    impactConfiance: 'Aucune note ni avis integres = il repart sur Maps pour verifier.',
    positifs: ['Zone Metz presente dans les pages localisees', 'Telephone accessible'],
    frictions: ['Aucun avis ni note sur le site', 'Email Wanadoo', 'Aucune indication de tarif ou delai'],
    ceQuiFeraitBasculer: '3-4 avis Google integres sur l\'accueil + une ligne "Intervention sous 24h sur Metz et Moselle".',
    exp: 5, conf: 5, clarte: 5,
  },
  {
    id: 5,
    name: 'Sylvie',
    age: 47,
    emoji: '♻️',
    situation: 'Proprietaire a Peltre, cherche un artisan certifie RGE pour une pompe a chaleur',
    canal: 'Reseaux sociaux',
    device: 'Desktop',
    decision: 'Quitte' as const,
    decisionLabel: 'Repart',
    histoire: 'Mentionnee sur un groupe Facebook Moselle. Elle cherche une certification RGE pour obtenir MaPrimeRenov\'. Aucune mention de certification sur le site. Elle va sur RGE.fr.',
    localisation: 'Peltre (57245)',
    maturite: 'Decouverte',
    contexte: 'Projet PAC avec aides MaPrimeRenov\'. Elle a besoin d\'un artisan certifie RGE — l\'enjeu est plusieurs milliers d\'euros d\'aides.',
    impression: 'Site sobre, entreprise familiale. Elle cherche "RGE" ou un logo de certification des la premiere vue.',
    parcours: [
      ['Accueil', 'Voit "Pompe a chaleur" dans les services — bien'],
      ['Cherche RGE', 'Aucune mention, aucun logo de certification'],
      ['Page prestations', 'Erreur 500 — inaccessible'],
      ['Footer', 'Aucun logo partenaire ni accréditation'],
      ['Quitte', 'Va sur RGE.fr chercher un artisan certifie'],
    ] as [string, string][],
    questionCle: 'Ils sont certifies RGE ? Je peux avoir les aides MaPrimeRenov\' ?',
    reponse: 'Non' as const,
    commentReponse: 'Aucune mention de certification RGE ni QualiPAC sur le site. L\'enjeu financier est trop important pour supposer.',
    impactVitesse: 'Sans objet — elle repart avant de s\'attarder.',
    impactConfiance: 'Absence de certification = blocage definitif pour ce profil.',
    positifs: ['"Pompe a chaleur" mentionne dans les services', 'Zone Peltre confirmee'],
    frictions: ['Aucune certification RGE ni QualiPAC mentionnee', 'Page prestations inaccessible (500)', 'Aucun logo de partenaire ou d\'accreditation'],
    ceQuiFeraitBasculer: 'C\'est potentiellement hors cible si non certifie RGE. Si certifie : un badge visible avec le numero de certification changerait tout.',
    exp: 4, conf: 3, clarte: 5,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Corriger la page Realisations et y ajouter 4 a 6 photos de chantiers',
    pourquoi: '2 visiteurs sur 5 ont clique sur "Nos Realisations" et sont tombes sur une erreur 500. C\'est la friction la plus directe et la plus facile a corriger. Pour Camille (projet 8 000€+), voir une salle de bain renovee aurait suffi a la convaincre d\'appeler. Les visiteurs en phase Comparaison ont besoin de voir votre travail avant de vous contacter.',
    action: 'Corriger l\'erreur serveur sur /nos-realisations, puis ajouter 4 a 6 photos de chantiers termines (salle de bain, chaudiere, plomberie) avec le type de travaux et la ville. Pas besoin d\'etre parfait — 4 vraies photos valent mieux que zero.',
    impact: '2 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'A verifier', ok: false, detail: 'Quota API epuise — estimation mobile : 45-60/100. Tester sur pagespeed.web.dev.' },
  { label: 'Securite', verdict: 'Mauvais', ok: false, detail: 'Grade F — 5/100. 6 headers de securite manquants sur 10.' },
  { label: 'SEO', verdict: 'Partiel', ok: false, detail: 'Sitemap 171 URLs present, robots.txt OK. Schema.org et Open Graph absents.' },
  { label: 'Donnees structurees', verdict: 'Absent', ok: false, detail: 'Schema.org LocalBusiness absent — penalite SEO local et rich snippets perdus.' },
  { label: 'Partage reseaux', verdict: 'Non configure', ok: false, detail: 'Balises Open Graph absentes — partage Facebook/WhatsApp sans apercu.' },
];

const tech = {
  observatory: { grade: 'F', score: 5, testsOk: 4, testsTotal: 10 },
  pagespdMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespdDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible (quota API)', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'Redirection HTTP vers HTTPS' },
    { ok: false, h: 'Strict-Transport-Security / HSTS (absent)' },
    { ok: false, h: 'Content-Security-Policy (absent)' },
    { ok: false, h: 'X-Frame-Options (absent — risque clickjacking)' },
    { ok: false, h: 'X-Content-Type-Options (absent)' },
    { ok: false, h: 'Referrer-Policy (absent)' },
  ],
  schema: [
    { item: 'JSON-LD / Schema.org present', ok: false },
    { item: '@type LocalBusiness ou Plumber', ok: false },
    { item: 'name, url, telephone', ok: false },
    { item: 'address + geo (latitude/longitude)', ok: false },
    { item: 'openingHours', ok: false },
    { item: 'aggregateRating (avis Google)', ok: false },
    { item: 'sameAs (reseaux sociaux)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: false, val: 'Non detecte' },
    { item: 'og:description', ok: false, val: 'Non detecte' },
    { item: 'og:image', ok: false, val: 'Non detecte' },
    { item: 'og:url', ok: false, val: 'Non detecte' },
    { item: 'twitter:card', ok: false, val: 'Non detecte' },
  ],
  seo: [
    { item: 'H1 unique ("Plombier chauffagiste Metz")', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'robots.txt accessible', ok: true },
    { item: 'sitemap.xml present (171 URLs)', ok: true },
    { item: 'Schema.org presente', ok: false },
    { item: 'Meta description optimisee', ok: false },
    { item: 'Open Graph configure', ok: false },
    { item: 'Page /nos-realisations accessible', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>
    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">{verdictHero}</h1>
    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>
    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>
  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>
  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>
  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
      </div>
    </div>
  </details>
</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group bg-white rounded-xl overflow-hidden shadow-sm border border-green-200">
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p><p class="text-neutral-600">{p.contexte}</p></div>
                <div><p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Premiere impression (5 sec)</p><p class="text-neutral-600">{p.impression}</p></div>
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Parcours sur le site</p>
                  <ol class="list-decimal list-inside space-y-1.5 text-neutral-600">
                    {p.parcours.map(([section, reaction]: [string, string]) => (
                      <li><strong class="text-neutral-800">{section}</strong>{reaction ? ` — ${reaction}` : ''}</li>
                    ))}
                  </ol>
                </div>
                <div class="bg-neutral-50 rounded-lg p-3">
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Sa question</p>
                  <p class="text-neutral-700 italic mb-1">"{p.questionCle}"</p>
                  <p class="text-neutral-600">Le site repond : <strong class={p.reponse === 'Oui' ? 'text-green-700' : p.reponse === 'Non' ? 'text-red-600' : 'text-amber-600'}>{p.reponse}</strong> — {p.commentReponse}</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
