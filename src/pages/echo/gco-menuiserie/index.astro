---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'gco-menuiserie';
const formule: 'decouverte' | 'complet' | 'pro' = 'decouverte';
const formuleLabel = 'Echo Decouverte';
const nomProspect = 'G&Co Menuiserie';
const urlSite = 'https://gco-menuiserie.fr';
const dateAudit = '30 mars 2026';
const showUpsell = true;

const kpis = {
  nbPersonas: 5,
  nbConvertissent: 3,
  nbHesitent: 2,
  nbRepartent: 0,
  conversion: 60,
  experience: 6.8,
  confiance: 8.0,
  clarte: 6.0,
};

const verdictHero = 'Sur 5 visiteurs, 3 vous contactent. 2 hesitent. Votre reputation est excellente — vos prix manquent.';

const constat = 'Votre site inspire une confiance remarquable : 60 avis 5 etoiles, schema.org complet, design professionnel. Ceux qui viennent via Google Maps ou par recommandation vous appellent directement. Ceux qui comparent plusieurs artisans hesitent — ils ne peuvent pas evaluer votre budget sans fourchette de prix.';

const canalData = [
  { canal: 'Bouche-a-oreille', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Maps', nb: 1, convert: 1, rate: 100 },
  { canal: 'Google Search', nb: 2, convert: 1, rate: 50 },
  { canal: 'Instagram', nb: 1, convert: 0, rate: 0 },
];

const personas = [
  {
    id: 1,
    name: 'Kevin',
    age: 34,
    emoji: '🏡',
    situation: 'Proprietaire a Metz, projet terrasse bois pour l\'ete',
    canal: 'Google Search',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Contacte',
    histoire: 'Les 60 avis 5 etoiles + la galerie de realisations emportent la decision malgre l\'absence de prix. Il envoie le formulaire en demandant une fourchette.',
    localisation: 'Metz (57), 40 km',
    maturite: 'Comparaison',
    contexte: 'Il compare 3 artisans trouves en ligne. Il a deja un devis d\'un concurrent et cherche une 2e opinion.',
    impression: 'La note 5/5 et les 60 avis s\'affichent immediatement. Design propre, photos de realisations en evidence. "Ces gens-la sont serieux."',
    parcours: [
      ['Accueil', 'Impressionne par la note. Fait defiler pour voir les realisations.'],
      ['Realisations', 'Parcourt la galerie, filtre "Terrasse bois". 60+ photos, qualite visible.'],
      ['Prestations', 'Confirme l\'offre terrasse bois. Cherche les prix — aucun.'],
      ['Contact', 'Remplit le formulaire en precisant son projet et en demandant une fourchette.'],
    ] as [string, string][],
    questionCle: 'C\'est combien une terrasse bois, et ces artisans sont-ils serieux ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le serieux est prouv\u00e9 (avis + realisations) mais aucune fourchette de prix pour comparer avec son devis concurrent.',
    impactVitesse: 'Mobile, site charge correctement grace au cache CDN. Aucune friction perceptible.',
    impactConfiance: 'HTTPS force, note 5/5 deja visible sur Google avant de cliquer. Confiance etablie avant la visite.',
    positifs: ['60 avis 5 etoiles tres visibles', 'Galerie riche et filtrable par categorie', 'Formulaire de contact simple', 'Zone geographique clairement identifiee'],
    frictions: ['Aucun prix indicatif', 'Pas de temoignages textuels sur le site', 'Pas de delai de realisation mentionne'],
    ceQuiFeraitBasculer: 'Une fourchette indicative (ex. "terrasse bois a partir de 3 500 euros") aurait accelere sa decision sans attendre le retour du formulaire.',
    exp: 7, conf: 8, clarte: 5,
  },
  {
    id: 2,
    name: 'Christine',
    age: 52,
    emoji: '🪟',
    situation: 'Proprietaire a Forbach, projet escalier interieur sur mesure',
    canal: 'Google Maps',
    device: 'Desktop',
    decision: 'Convertit' as const,
    decisionLabel: 'Appelle',
    histoire: 'Elle avait deja decide avant d\'arriver : 60 avis 5 etoiles sur Maps. Le site confirme le serieux sans freiner. Elle note le numero et appelle.',
    localisation: 'Forbach (57), 5 km',
    maturite: 'Decision',
    contexte: 'Elle cherche un menuisier local fiable pour un escalier. Les 60 avis sur Google Maps l\'ont convaincue de cliquer en premier.',
    impression: 'Le site confirme immediatement ce qu\'elle attendait : design professionnel, adresse visible, telephone en evidence.',
    parcours: [
      ['Accueil', 'Confirme l\'adresse et le telephone. Cherche la page escaliers.'],
      ['Prestations', 'Trouve "Fabrication et pose d\'escaliers". Description suffisante.'],
      ['Realisations', 'Filtre "Escalier". Voit plusieurs realisations. Qualite satisfaisante.'],
      ['Contact', 'Prefere appeler directement. Note le numero et ferme le site.'],
    ] as [string, string][],
    questionCle: 'Ces artisans sont-ils fiables et comment les joindre ?',
    reponse: 'Oui' as const,
    commentReponse: 'Les 60 avis + adresse + telephone = tout ce qu\'elle cherchait. Mission accomplie.',
    impactVitesse: 'Desktop, site rapide. Aucun probleme.',
    impactConfiance: 'HTTPS, SIRET visible, adresse reelle. Signaux de legitimite presents.',
    positifs: ['Telephone en evidence sur toutes les pages', 'Adresse et SIRET visibles', 'Galerie escaliers convaincante', 'Gerants nommes (Thibault + Yann)'],
    frictions: ['Pas de photo des artisans sur le site', 'Pas d\'assurance decennale mentionnee', 'Pas de systeme de prise de RDV en ligne'],
    ceQuiFeraitBasculer: '',
    exp: 8, conf: 9, clarte: 7,
  },
  {
    id: 3,
    name: 'Sebastien',
    age: 41,
    emoji: '🌲',
    situation: 'Resident luxembourgeois, maison avec grand jardin, projet pergola aluminium',
    canal: 'Google Search',
    device: 'Desktop',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'La zone Luxembourg est revendiquee dans le titre mais aucune realisation taggee Luxembourg dans la galerie + aucun prix. Il met le site en signet et continue de comparer.',
    localisation: 'Luxembourg-Ville, 60 km',
    maturite: 'Comparaison',
    contexte: 'Cherche un artisan francais competitif par rapport aux prix luxembourgeois. Compare 3 prestataires.',
    impression: 'Design moderne et professionnel. Il note "Moselle & Luxembourg" dans le titre — signal positif. Cherche a confirmer.',
    parcours: [
      ['Accueil', 'Voit "Moselle, Grand Est et Luxembourg" mentionne. Bon signal. Fait defiler.'],
      ['Realisations', 'Cherche des tags "Luxembourg" dans la galerie. Voit Metz, Thionville, Moselle-Est — mais pas Luxembourg.'],
      ['Prestations', 'Pergolas aluminium confirmees dans l\'offre. Mais aucun prix.'],
      ['Contact', 'Commence a remplir, bloque sur l\'absence de prix. Met le site en signet.'],
    ] as [string, string][],
    questionCle: 'Interviennent-ils vraiment au Luxembourg et a quel budget ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'La zone Luxembourg est mentionnee mais aucune realisation luxembourgeoise n\'est visible et aucun prix n\'est donne.',
    impactVitesse: 'Desktop, rapide. Aucun probleme technique.',
    impactConfiance: 'Schema.org solide, note 5/5 dans Google. Mais l\'absence de realisation luxembourgeoise cree un doute sur l\'experience specifique.',
    positifs: ['Zone Luxembourg clairement revendiquee (titre, meta, Schema.org)', 'Design professionnel pour un budget premium', '60 avis rassurants meme sans exemple luxembourgeois'],
    frictions: ['Aucune realisation taggee "Luxembourg" dans la galerie', 'Aucun prix ou fourchette tarifaire', 'Pas de mention de l\'experience transfrontaliere'],
    ceQuiFeraitBasculer: 'Une section "Ils nous font confiance depuis le Luxembourg" + une fourchette tarifaire indicative aurait probablement converti.',
    exp: 6, conf: 7, clarte: 5,
  },
  {
    id: 4,
    name: 'Emilie',
    age: 28,
    emoji: '📱',
    situation: 'Locataire a Sarreguemines, cherche un artisan pour sa proprietaire (parquet)',
    canal: 'Instagram',
    device: 'Mobile',
    decision: 'Hesite' as const,
    decisionLabel: 'Hesite',
    histoire: 'Elle trouve le numero mais la friction du formulaire + l\'absence de WhatsApp la ralentissent. Elle transmet le numero a sa proprietaire mais pas le lien vers le site.',
    localisation: 'Sarreguemines (57), 25 km',
    maturite: 'Decouverte',
    contexte: 'Elle a vu des reels de chantiers sur @gco.menuiserie et a clique sur le lien en bio. Veut juste passer le contact a sa proprio.',
    impression: 'Le site est visuellement coherent avec l\'Instagram. Design propre, photos de qualite. Mais elle est en mode "contact rapide" — pas en mode "decouverte".',
    parcours: [
      ['Accueil', 'Fait defiler rapidement. Cherche un bouton WhatsApp ou email direct — absents.'],
      ['Contact', 'Trouve la page contact. Formulaire long. Trop complexe pour juste transmettre un contact.'],
      ['Accueil', 'Repere le telephone en haut de page. Note le numero.'],
    ] as [string, string][],
    questionCle: 'Comment je les contacte rapidement pour ma proprietaire ?',
    reponse: 'Partiellement' as const,
    commentReponse: 'Le telephone est present mais pas en evidence en mobile. Pas de WhatsApp ni d\'email cliquable visible.',
    impactVitesse: 'Mobile, site charge correctement.',
    impactConfiance: 'Design coherent avec Instagram renforce la credibilite pour ce canal.',
    positifs: ['Coherence visuelle avec le compte Instagram', 'Telephone present sur le site', 'Design moderne et professionnel'],
    frictions: ['Pas de bouton WhatsApp (canal prefere 25-35 ans)', 'Email non affiche en lien cliquable en mobile', 'Formulaire trop long pour un passage rapide', 'Pas de CTA appel au-dessus de la ligne de flottaison'],
    ceQuiFeraitBasculer: 'Un bouton WhatsApp flottant ou un lien tel: cliquable en evidence au-dessus de la ligne de flottaison.',
    exp: 6, conf: 7, clarte: 6,
  },
  {
    id: 5,
    name: 'Jean-Pierre',
    age: 63,
    emoji: '🔧',
    situation: 'Retraite a Thionville, porte de garage et volet bloques, recommande par un voisin',
    canal: 'Bouche-a-oreille',
    device: 'Mobile',
    decision: 'Convertit' as const,
    decisionLabel: 'Appelle',
    histoire: 'Recommandation directe de son voisin. Il verifie le site, trouve le numero, confirme que le depannage est dans l\'offre. Il appelle dans la minute.',
    localisation: 'Thionville (57), 50 km',
    maturite: 'Decision',
    contexte: 'Son voisin a eu une terrasse faite par G&Co et l\'a specifiquement recommande. Jean-Pierre verifie avant d\'appeler.',
    impression: 'Il cherche immediatement le numero de telephone. Le trouve en haut de page. "C\'est bon, c\'est eux."',
    parcours: [
      ['Accueil', 'Cherche le telephone. Trouve en haut. Fait un peu defiler.'],
      ['Prestations', 'Cherche "depannage". Trouve la section Maintenance — 3e categorie, moins visible.'],
      ['Contact', 'Decide d\'appeler directement.'],
    ] as [string, string][],
    questionCle: 'Ils font du depannage et c\'est quoi leur numero ?',
    reponse: 'Oui' as const,
    commentReponse: 'Le depannage est bien dans l\'offre et le telephone est visible.',
    impactVitesse: 'Mobile, chargement rapide.',
    impactConfiance: 'Les 60 avis confirment la recommandation de son voisin. Double validation.',
    positifs: ['Telephone immediatement visible', 'Section depannage presente', 'Les 60 avis confirment la recommandation'],
    frictions: ['Le depannage est moins mis en avant que les grands projets', 'Navigation mobile perfectible pour les 60+', 'Pas de mention "urgence" ou "intervention rapide"'],
    ceQuiFeraitBasculer: '',
    exp: 7, conf: 9, clarte: 7,
  },
];

const ameliorationsHautes = [
  {
    titre: 'Ajouter des fourchettes tarifaires indicatives sur la page Prestations',
    pourquoi: 'Sans indication de prix, les visiteurs qui comparent plusieurs artisans ne peuvent pas evaluer votre positionnement. 3 visiteurs sur 5 bloquent ou hesitent sur ce point — c\'est votre seul vrai frein, car votre confiance (8/10) est deja excellente.',
    action: 'Ajouter sous chaque categorie de service une fourchette indicative (ex. "Terrasse bois : a partir de 3 500 euros" ou "Pergola aluminium : entre 4 000 et 8 000 euros selon dimensions"). Preciser que le devis est gratuit et sur-mesure.',
    impact: '3 visiteurs sur 5',
  },
];

const ameliorationsUtiles: { titre: string; detail: string }[] = [];
const ameliorationsDiscuter: { emoji: string; titre: string; detail: string }[] = [];

const techVerdicts = [
  { label: 'Vitesse', verdict: 'Non mesure', ok: true, detail: 'Next.js avec cache CDN — chargement rapide observe' },
  { label: 'Securite', verdict: 'B (75/100)', ok: true, detail: '9/10 tests passes — HSTS, X-Frame, X-Content-Type presents. CSP absent.' },
  { label: 'SEO', verdict: 'Bon', ok: true, detail: 'Title geographique, meta, canonical, robots.txt et sitemap.xml presents' },
  { label: 'Donnees structurees', verdict: 'Tres complet', ok: true, detail: 'Schema.org LocalBusiness complet : adresse, geo, horaires, avis, fondateurs, zone' },
  { label: 'Partage reseaux', verdict: 'Complet', ok: true, detail: 'Open Graph et Twitter Cards complets avec og:image 1200x630' },
];

const tech = {
  observatory: { grade: 'B', score: 75, testsOk: 9, testsTotal: 10 },
  pagespeedMobile: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  pagespeedDesktop: null as { performance: number; accessibility: number; bestPractices: number; seo: number } | null,
  cwv: { lcp: 'Non disponible', inp: 'Non disponible', cls: 'Non disponible' },
  headers: [
    { ok: true, h: 'Strict-Transport-Security (HSTS) — max-age=31536000, includeSubDomains' },
    { ok: true, h: 'X-Content-Type-Options — nosniff' },
    { ok: true, h: 'X-Frame-Options — SAMEORIGIN (anti-clickjacking)' },
    { ok: true, h: 'X-XSS-Protection — 1; mode=block' },
    { ok: true, h: 'Referrer-Policy — strict-origin-when-cross-origin' },
    { ok: false, h: 'Content-Security-Policy — absent (seul test echoue)' },
  ],
  schema: [
    { item: 'JSON-LD present', ok: true },
    { item: '@type LocalBusiness coherent', ok: true },
    { item: 'name, url, description', ok: true },
    { item: 'address + geo (coordonnees GPS)', ok: true },
    { item: 'telephone + email', ok: true },
    { item: 'openingHours', ok: true },
    { item: 'aggregateRating (5/5, 60 avis)', ok: true },
    { item: 'areaServed (Moselle, Grand Est, Luxembourg)', ok: true },
    { item: 'founder (Thibault + Yann Gerber)', ok: true },
    { item: 'image / logo', ok: false },
    { item: 'sameAs (Instagram, Facebook, TikTok)', ok: false },
  ],
  og: [
    { item: 'og:title', ok: true, val: 'G&Co Menuiserie — Artisan Menuisier en Moselle & Luxembourg' },
    { item: 'og:description', ok: true, val: 'Present et pertinent' },
    { item: 'og:image', ok: true, val: 'og-image.png (1200x630)' },
    { item: 'og:url', ok: true, val: 'https://gco-menuiserie.fr' },
    { item: 'og:type', ok: true, val: 'website' },
    { item: 'twitter:card', ok: true, val: 'summary_large_image' },
    { item: 'canonical', ok: true, val: 'https://gco-menuiserie.fr' },
  ],
  seo: [
    { item: 'Title avec mot-cle geographique', ok: true },
    { item: 'Meta description presente', ok: true },
    { item: 'Un seul H1 par page', ok: true },
    { item: 'robots.txt accessible (sitemap declare)', ok: true },
    { item: 'sitemap.xml accessible', ok: true },
    { item: 'Redirection HTTP vers HTTPS', ok: true },
    { item: 'Images alt text (galerie 60+ photos)', ok: false },
    { item: 'Schema.org image + sameAs', ok: false },
  ],
};
---

<BaseLayout
  title={`${formuleLabel} — ${nomProspect}`}
  description={`Rapport Echo Decouverte pour ${nomProspect}. ${kpis.nbPersonas} visiteurs simules, audit technique, recommandation prioritaire.`}
  noindex={true}
  frPath={`/echo/${slug}`}
  ogImage="/og-echo.png"
>

<!-- 1. HERO — Verdict immediat -->
<section class="relative w-full px-6 py-20 md:py-28 overflow-hidden" style="background: #0A0A0A;">
  <div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full blur-[180px] pointer-events-none" style="background: #E86C47; opacity: 0.06;"></div>
  <div class="relative mx-auto max-w-4xl z-10">

    <div class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-widest" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
      {formuleLabel} · Rapport confidentiel
    </div>

    <h1 class="mb-6 text-3xl md:text-4xl font-bold text-white leading-tight tracking-tight">
      {verdictHero}
    </h1>

    <p class="mb-10 text-sm" style="color: rgba(255,255,255,0.4);">
      Site analyse : <a href={urlSite} target="_blank" class="underline hover:text-white transition-colors">{urlSite}</a> · {kpis.nbPersonas} visiteurs simules · {dateAudit}
    </p>

    <div class="grid grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2);">
        <div class="text-4xl md:text-5xl font-black text-green-400 mb-1">{kpis.nbConvertissent}</div>
        <div class="text-sm text-green-400/70">vous contactent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
        <div class="text-4xl md:text-5xl font-black text-amber-400 mb-1">{kpis.nbHesitent}</div>
        <div class="text-sm text-amber-400/70">hesitent</div>
      </div>
      <div class="rounded-xl p-5 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
        <div class="text-4xl md:text-5xl font-black mb-1" style="color: rgba(255,255,255,0.5);">{kpis.nbRepartent}</div>
        <div class="text-sm" style="color: rgba(255,255,255,0.3);">repartent</div>
      </div>
    </div>

  </div>
</section>

<!-- 2. LE CONSTAT -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

  <div class="rounded-2xl p-6 md:p-8 mb-12 border-l-4" style="background: rgba(232,108,71,0.04); border-color: #E86C47;">
    <p class="text-lg md:text-xl font-medium text-neutral-800 leading-relaxed">{constat}</p>
  </div>

  <h2 class="text-xl font-bold text-neutral-900 mb-2">D'ou viennent vos visiteurs</h2>
  <p class="text-sm text-neutral-500 mb-6">Et combien vous contactent selon leur canal d'arrivee.</p>

  <div class="space-y-4 mb-12">
    {canalData.map(c => {
      const color = c.rate >= 50 ? '#22c55e' : c.rate >= 25 ? '#f59e0b' : '#ef4444';
      return (
        <div class="flex items-center gap-4">
          <div class="w-40 sm:w-48 text-sm text-neutral-700 shrink-0">{c.canal}</div>
          <div class="flex-1 h-3 bg-neutral-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all" style={`width: ${c.rate}%; background: ${color}`}></div>
          </div>
          <div class="w-20 text-right">
            <span class="text-sm font-bold" style={`color: ${color}`}>{c.rate}%</span>
            <span class="text-xs text-neutral-400 ml-1">({c.convert}/{c.nb})</span>
          </div>
        </div>
      );
    })}
  </div>

  <details class="group mb-4">
    <summary class="flex items-center gap-2 cursor-pointer text-sm text-neutral-500 hover:text-neutral-700 py-2">
      <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      Voir les scores detailles (experience, confiance, clarte)
    </summary>
    <div class="grid grid-cols-3 gap-4 mt-3">
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.experience}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Experience</div>
        <p class="text-[10px] text-neutral-400 mt-1">Navigation, lisibilite, fluidite</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.confiance}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Confiance</div>
        <p class="text-[10px] text-neutral-400 mt-1">Credibilite, preuves, rassurance</p>
      </div>
      <div class="bg-white border border-neutral-200 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-neutral-800 mb-1">{kpis.clarte}<span class="text-sm text-neutral-400">/10</span></div>
        <div class="text-xs text-neutral-500">Clarte</div>
        <p class="text-[10px] text-neutral-400 mt-1">Comprehension de l'offre et des prix</p>
      </div>
    </div>
  </details>

</section>

<!-- 3. VOS VISITEURS -->
<section class="py-16" style="background: #fafafa;">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="text-2xl font-bold text-neutral-900 mb-2">Vos visiteurs</h2>
    <p class="text-neutral-600 mb-8">Voici ce qui se passe quand quelqu'un cherche vos services et tombe sur votre site.</p>

    <!-- Ceux qui contactent -->
    <div class="mb-10">
      <h3 class="text-base font-bold text-green-800 mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
        Ceux qui vous contactent
        <span class="text-sm font-normal text-green-600">({kpis.nbConvertissent})</span>
      </h3>
      <div class="space-y-3">
        {personas.filter(p => p.decision === 'Convertit').map(p => (
          <details class="group persona-card bg-white rounded-xl overflow-hidden shadow-sm border border-green-200" data-canal={p.canal}>
            <summary class="p-4 flex gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="text-xl shrink-0 mt-0.5">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h4 class="font-semibold text-neutral-900 text-sm">{p.name}, {p.age} ans</h4>
                  <span class="text-[10px] bg-green-600 text-white px-1.5 py-0.5 rounded font-medium">{p.decisionLabel}</span>
                </div>
                <p class="text-sm text-neutral-600 mb-2">{p.histoire}</p>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">{p.canal}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.device}</span>
                  <span class="text-[10px] text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">{p.maturite}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-neutral-300 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-4 pb-5 border-t border-green-200">
              <div class="grid gap-4 text-xs mt-4">
                <div>
                  <p class="font-semibold text-neutral-500 uppercase tracking-wider text-[10px] mb-1">Contexte</p>
                  <p class="text-neutral-600">{p.contexte}</p>
