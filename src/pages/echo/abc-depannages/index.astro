                    const sColor = s.val >= 7 ? 'text-green-600' : s.val >= 5 ? 'text-amber-600' : 'text-red-500';
                    return (
                      <div class="text-center">
                        <span class={`block text-lg font-bold ${sColor}`}>{s.val}</span>
                        <span class="text-[10px] text-neutral-400">{s.label}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
