---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    id: 'fb-perso',
    label: 'Facebook — compte perso',
    icon: '👤',
    color: '#1877F2',
    note: 'Colle le lien en 1er commentaire après publication',
    text: `J'ai tout quitté en 30 jours.

Mon patron n'a jamais compris. En même temps, il utilisait encore Wix.

Aujourd'hui je travaille depuis un terminal, n'importe où dans le monde, avec Claude Code et du café filtre.

J'ai tout mis dans une formation. Lien en commentaire 👇`,
  },
  {
    id: 'fb-pro',
    label: 'Facebook — page pro',
    icon: '🏢',
    color: '#1877F2',
    note: 'Colle le lien en 1er commentaire après publication',
    text: `Ce que l'IA a changé dans ma façon de travailler — honnêtement.

Pas de chiffre inventé. Pas de capture Stripe floutée.

Juste ce que ça a vraiment changé, ce que ça n'a pas changé, et pourquoi la plupart des gens qui vous vendent une "méthode IA" vous racontent une histoire.

J'ai tout documenté. Lien en commentaire 👇`,
  },
  {
    id: 'linkedin',
    label: 'LinkedIn',
    icon: '💼',
    color: '#0A66C2',
    note: 'Colle le lien en 1er commentaire après publication (boost algorithmique)',
    text: `En 2026, tout le monde peut "faire de l'IA".

Tout le monde peut se filmer devant un MacBook et annoncer une transformation.
Tout le monde peut écrire "j'ai tout quitté" et vendre une formation à 997€.

Alors voilà ce que j'ai décidé de faire.

J'ai construit la page la plus honnête que je pouvais sur le sujet.

Elle répond à une seule question : est-ce que le Vibe Coding avec Claude Code peut vraiment changer quelque chose — ou c'est juste du contenu ?

Réponse en commentaire 👇`,
  },
];
---

<BaseLayout
  title="Kit publication — Formation poisson d'avril — Marc M"
  description="Kit de publication interne — visuel et posts réseaux sociaux."
  noindex={true}
  lang="fr"
>

<div style="background:#0D0D0D; min-height:100vh; padding: 2rem 1.5rem 4rem;">
  <div style="max-width:680px; margin:0 auto;">

    <!-- Header -->
    <div style="margin-bottom:2.5rem; padding-top:1rem;">
      <p style="font-size:0.75rem; font-weight:700; letter-spacing:0.15em; color:#E86C47; text-transform:uppercase; margin-bottom:0.5rem;">Kit de publication</p>
      <h1 style="font-size:1.75rem; font-weight:900; color:#FAFAF8; margin-bottom:0.5rem;">Formation — Poisson d'avril</h1>
      <p style="font-size:0.9rem; color:#555;">Visuel + posts réseaux prêts à l'emploi.</p>
    </div>

    <!-- Visuel + téléchargement -->
    <div style="background:#111; border:1px solid #222; border-radius:12px; padding:1.5rem; margin-bottom:2rem;">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
        <div>
          <p style="font-size:0.75rem; font-weight:700; color:#E86C47; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.2rem;">Visuel carré 1080×1080</p>
          <p style="font-size:0.8rem; color:#555;">Instagram · Facebook · LinkedIn</p>
        </div>
        <button
          id="btn-download"
          style="background:#E86C47; color:white; border:none; border-radius:8px; padding:0.6rem 1.2rem; font-size:0.85rem; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:0.5rem;"
        >
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          Télécharger PNG
        </button>
      </div>
      <!-- Preview SVG -->
      <div style="border-radius:8px; overflow:hidden; border:1px solid #1E1E1E;">
        <img
          id="preview-svg"
          src="/social-formation-carre.svg"
          alt="Visuel formation poisson d'avril"
          style="width:100%; display:block;"
        />
      </div>
      <p id="dl-status" style="font-size:0.75rem; color:#555; margin-top:0.75rem; text-align:center; min-height:1rem;"></p>
    </div>

    <!-- Posts -->
    <h2 style="font-size:1rem; font-weight:700; color:#FAFAF8; margin-bottom:1.25rem;">Posts prêts à publier</h2>

    <div style="display:flex; flex-direction:column; gap:1.25rem;">
      {posts.map(post => (
        <div style={`background:#111; border:1px solid #222; border-radius:12px; overflow:hidden;`}>
          <!-- Header post -->
          <div style={`display:flex; align-items:center; justify-content:space-between; padding:0.9rem 1.25rem; border-bottom:1px solid #1E1E1E; background:#0F0F0F;`}>
            <div style="display:flex; align-items:center; gap:0.6rem;">
              <span style={`font-size:1rem; width:28px; height:28px; border-radius:6px; display:flex; align-items:center; justify-content:center; background:${post.color}22;`}>{post.icon}</span>
              <span style="font-size:0.85rem; font-weight:600; color:#CCC;">{post.label}</span>
            </div>
            <button
              class="btn-copy"
              data-target={post.id}
              style="background:#1E1E1E; color:#CCC; border:1px solid #333; border-radius:6px; padding:0.4rem 0.9rem; font-size:0.78rem; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:0.4rem; transition:all 0.15s;"
            >
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              Copier
            </button>
          </div>
          <!-- Note lien commentaire -->
          <div style="padding:0.5rem 1.25rem; background:#0A0A0A; border-bottom:1px solid #1A1A1A; display:flex; align-items:center; gap:0.5rem;">
            <svg width="12" height="12" fill="none" stroke="#E86C47" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            <span style="font-size:0.72rem; color:#555; font-weight:500;">{post.note}</span>
            <span style="margin-left:auto; font-size:0.72rem; font-weight:700; color:#E86C47; font-family:monospace;">marcm.fr/formation</span>
          </div>
          <!-- Corps du post -->
          <textarea
            id={post.id}
            readonly
            rows="8"
            style="width:100%; background:transparent; border:none; padding:1.25rem; font-size:0.875rem; line-height:1.7; color:#AAA; font-family:system-ui,-apple-system,sans-serif; resize:vertical; outline:none; box-sizing:border-box;"
          >{post.text}</textarea>
        </div>
      ))}
    </div>

  </div>
</div>

<script>
  const ICON_DL = `<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>`;

  function resetBtn() {
    const btn = document.getElementById('btn-download')!;
    const status = document.getElementById('dl-status')!;
    btn.innerHTML = ICON_DL + ' Télécharger PNG';
    (btn as HTMLButtonElement).disabled = false;
    status.textContent = '';
  }

  function fallbackSvg(svgText: string) {
    const blob = new Blob([svgText], { type: 'image/svg+xml' });
    const a = document.createElement('a');
    a.download = 'marcm-formation-poisson-davril.svg';
    a.href = URL.createObjectURL(blob);
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 5000);
    document.getElementById('dl-status')!.textContent = '⚠️ PNG impossible sur ce navigateur — SVG téléchargé à la place (convertissez sur cloudconvert.com)';
    setTimeout(resetBtn, 5000);
  }

  // --- Copier post ---
  document.querySelectorAll('.btn-copy').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = (btn as HTMLElement).dataset.target!;
      const ta = document.getElementById(id) as HTMLTextAreaElement;
      navigator.clipboard.writeText(ta.value).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = `<svg width="12" height="12" fill="none" stroke="#4ADE80" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg> <span style="color:#4ADE80;">Copié !</span>`;
        setTimeout(() => { btn.innerHTML = orig; }, 2000);
      });
    });
  });

  // --- Télécharger PNG ---
  document.getElementById('btn-download')?.addEventListener('click', async () => {
    const status = document.getElementById('dl-status')!;
    const btn = document.getElementById('btn-download') as HTMLButtonElement;
    btn.innerHTML = 'Génération…';
    btn.disabled = true;
    status.textContent = 'Conversion en cours…';

    // Timeout de sécurité : si rien ne se passe après 8s → fallback SVG
    let done = false;
    const timeout = setTimeout(() => {
      if (!done) {
        fetch('/social-formation-carre.svg').then(r => r.text()).then(fallbackSvg).catch(() => {
          status.textContent = 'Erreur — téléchargez le SVG manuellement.';
          setTimeout(resetBtn, 4000);
        });
      }
    }, 8000);

    try {
      const res = await fetch('/social-formation-carre.svg');
      const svgText = await res.text();

      // Encoder en data URI base64 (évite les problèmes de taint avec blob URL)
      const svgB64 = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svgText)));

      const img = new Image();
      img.onload = () => {
        try {
          const canvas = document.createElement('canvas');
          canvas.width = 1080;
          canvas.height = 1080;
          const ctx = canvas.getContext('2d')!;
          ctx.drawImage(img, 0, 0, 1080, 1080);

          // toBlob peut échouer silencieusement si canvas est taché
          canvas.toBlob(pngBlob => {
            done = true;
            clearTimeout(timeout);
            if (!pngBlob) {
              fallbackSvg(svgText);
              return;
            }
            const a = document.createElement('a');
            a.download = 'marcm-formation-poisson-davril.png';
            a.href = URL.createObjectURL(pngBlob);
            a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 5000);
            status.textContent = '✓ PNG téléchargé — 1080×1080px';
            btn.innerHTML = `<svg width="14" height="14" fill="none" stroke="#4ADE80" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg> <span style="color:#4ADE80;">Téléchargé</span>`;
            setTimeout(resetBtn, 3000);
          }, 'image/png');
        } catch {
          done = true;
          clearTimeout(timeout);
          fallbackSvg(svgText);
        }
      };
      img.onerror = () => {
        done = true;
        clearTimeout(timeout);
        fallbackSvg(svgText);
      };
      img.src = svgB64;
    } catch {
      done = true;
      clearTimeout(timeout);
      status.textContent = 'Erreur réseau.';
      setTimeout(resetBtn, 3000);
    }
  });
</script>

</BaseLayout>
