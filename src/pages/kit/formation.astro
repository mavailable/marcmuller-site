---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    id: 'fb-perso',
    label: 'Facebook — compte perso',
    icon: '👤',
    color: '#1877F2',
    text: `J'ai quitté mon job en 30 jours grâce au Vibe Coding avec Claude Code.

Voilà ce que j'aurais pu vous faire croire aujourd'hui.

La vérité : je suis dev web indépendant à Metz. Je bosse depuis un terminal avec du café filtre. Mes sites coûtent 490€ et arrivent en 7 jours.

Pas de rooftop à Dubai. Pas de Ferrari mentale. Pas de formation à 997€ avec module bonus "L'art de manifester ses factures".

Juste du vrai travail — pour des coiffeurs, des plombiers, des artisans qui ont besoin d'un site qui ramène des clients. Pas d'une slide deck.

Bonne fête du poisson 🐟

👉 marcm.fr/formation (pour les curieux qui veulent voir le poisson en entier)`,
  },
  {
    id: 'fb-pro',
    label: 'Facebook — page pro',
    icon: '🏢',
    color: '#1877F2',
    text: `Aujourd'hui j'aurais pu vous vendre une formation à 997€.

J'ai décidé de ne pas le faire.

Non pas parce que le Vibe Coding ne fonctionne pas — il fonctionne très bien, j'en use tous les jours. Mais parce que personne n'a besoin d'une formation de plus pour avoir un site qui convertit.

Ce que font les artisans et indépendants qui me contactent : ils m'envoient 15 minutes d'infos sur leur activité. Je construis. Une semaine plus tard, leur site est en ligne, il charge en moins d'une seconde, et il est référencé.

490€. Livré en 7 jours. Sans webinaire de 3h, sans groupe Telegram VIP, sans garantie résultat "en manifestant plus fort".

Bonne fête du poisson 🐟 marcm.fr`,
  },
  {
    id: 'linkedin',
    label: 'LinkedIn',
    icon: '💼',
    color: '#0A66C2',
    text: `J'aurais pu écrire ce post différemment aujourd'hui.

"Comment j'ai fait X par mois en 30 jours grâce à l'IA"
"La méthode que les agences ne veulent pas que vous connaissiez"
"Rejoignez ma formation exclusive (places limitées — non)"

J'ai construit la page. Elle existe. Elle est très bien faite.

Mais voilà ce que je préfère vous dire à la place :

→ Je suis développeur web solo à Metz
→ Je livre des sites performants (Lighthouse 100/100) en 7 jours
→ Mes clients sont des artisans, des indépendants, des petits commerces
→ Ça coûte 490€, tout inclus, hébergement à vie

L'IA m'a rendu plus rapide. Pas plus riche de façon mystérieuse. Juste plus efficace — et cette efficacité, elle profite au prix que vous payez, pas à ma marge.

Il y a beaucoup de formations qui vous apprennent à vendre des formations.

Moi je fais des sites.

Bonne fête du poisson 🐟

#DeveloppementWeb #IndependantWeb #ArtisanDuCode #VibeCoding`,
  },
];
---

<BaseLayout
  title="Kit publication — Formation poisson d'avril — Marc M"
  description="Kit de publication interne — visuel et posts réseaux sociaux."
  noindex={true}
  lang="fr"
>

<div style="background:#0D0D0D; min-height:100vh; padding: 2rem 1.5rem 4rem;">
  <div style="max-width:680px; margin:0 auto;">

    <!-- Header -->
    <div style="margin-bottom:2.5rem; padding-top:1rem;">
      <p style="font-size:0.75rem; font-weight:700; letter-spacing:0.15em; color:#E86C47; text-transform:uppercase; margin-bottom:0.5rem;">Kit de publication</p>
      <h1 style="font-size:1.75rem; font-weight:900; color:#FAFAF8; margin-bottom:0.5rem;">Formation — Poisson d'avril</h1>
      <p style="font-size:0.9rem; color:#555;">Visuel + posts réseaux prêts à l'emploi.</p>
    </div>

    <!-- Visuel + téléchargement -->
    <div style="background:#111; border:1px solid #222; border-radius:12px; padding:1.5rem; margin-bottom:2rem;">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
        <div>
          <p style="font-size:0.75rem; font-weight:700; color:#E86C47; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.2rem;">Visuel carré 1080×1080</p>
          <p style="font-size:0.8rem; color:#555;">Instagram · Facebook · LinkedIn</p>
        </div>
        <button
          id="btn-download"
          style="background:#E86C47; color:white; border:none; border-radius:8px; padding:0.6rem 1.2rem; font-size:0.85rem; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:0.5rem;"
        >
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          Télécharger PNG
        </button>
      </div>
      <!-- Preview SVG -->
      <div style="border-radius:8px; overflow:hidden; border:1px solid #1E1E1E;">
        <img
          id="preview-svg"
          src="/social-formation-carre.svg"
          alt="Visuel formation poisson d'avril"
          style="width:100%; display:block;"
        />
      </div>
      <p id="dl-status" style="font-size:0.75rem; color:#555; margin-top:0.75rem; text-align:center; min-height:1rem;"></p>
    </div>

    <!-- Posts -->
    <h2 style="font-size:1rem; font-weight:700; color:#FAFAF8; margin-bottom:1.25rem;">Posts prêts à publier</h2>

    <div style="display:flex; flex-direction:column; gap:1.25rem;">
      {posts.map(post => (
        <div style={`background:#111; border:1px solid #222; border-radius:12px; overflow:hidden;`}>
          <!-- Header post -->
          <div style={`display:flex; align-items:center; justify-content:space-between; padding:0.9rem 1.25rem; border-bottom:1px solid #1E1E1E; background:#0F0F0F;`}>
            <div style="display:flex; align-items:center; gap:0.6rem;">
              <span style={`font-size:1rem; width:28px; height:28px; border-radius:6px; display:flex; align-items:center; justify-content:center; background:${post.color}22;`}>{post.icon}</span>
              <span style="font-size:0.85rem; font-weight:600; color:#CCC;">{post.label}</span>
            </div>
            <button
              class="btn-copy"
              data-target={post.id}
              style="background:#1E1E1E; color:#CCC; border:1px solid #333; border-radius:6px; padding:0.4rem 0.9rem; font-size:0.78rem; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:0.4rem; transition:all 0.15s;"
            >
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              Copier
            </button>
          </div>
          <!-- Corps du post -->
          <textarea
            id={post.id}
            readonly
            rows="10"
            style="width:100%; background:transparent; border:none; padding:1.25rem; font-size:0.875rem; line-height:1.7; color:#AAA; font-family:system-ui,-apple-system,sans-serif; resize:vertical; outline:none; box-sizing:border-box;"
          >{post.text}</textarea>
        </div>
      ))}
    </div>

  </div>
</div>

<script>
  // --- Copier post ---
  document.querySelectorAll('.btn-copy').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = (btn as HTMLElement).dataset.target!;
      const ta = document.getElementById(id) as HTMLTextAreaElement;
      navigator.clipboard.writeText(ta.value).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = `<svg width="12" height="12" fill="none" stroke="#4ADE80" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg> <span style="color:#4ADE80;">Copié !</span>`;
        setTimeout(() => { btn.innerHTML = orig; }, 2000);
      });
    });
  });

  // --- Télécharger PNG ---
  document.getElementById('btn-download')?.addEventListener('click', async () => {
    const status = document.getElementById('dl-status')!;
    const btn = document.getElementById('btn-download')!;
    btn.textContent = 'Génération…';
    status.textContent = 'Conversion SVG → PNG en cours…';

    try {
      const svgUrl = '/social-formation-carre.svg';
      const res = await fetch(svgUrl);
      const svgText = await res.text();
      const blob = new Blob([svgText], { type: 'image/svg+xml' });
      const url = URL.createObjectURL(blob);

      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = 1080;
        canvas.height = 1080;
        const ctx = canvas.getContext('2d')!;
        ctx.drawImage(img, 0, 0, 1080, 1080);
        URL.revokeObjectURL(url);

        canvas.toBlob(pngBlob => {
          if (!pngBlob) { status.textContent = 'Erreur de conversion.'; return; }
          const a = document.createElement('a');
          a.download = 'marcm-formation-poisson-davril.png';
          a.href = URL.createObjectURL(pngBlob);
          a.click();
          setTimeout(() => URL.revokeObjectURL(a.href), 5000);
          status.textContent = '✓ PNG téléchargé — 1080×1080px';
          btn.innerHTML = `<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg> Téléchargé`;
          setTimeout(() => {
            btn.innerHTML = `<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg> Télécharger PNG`;
            status.textContent = '';
          }, 3000);
        }, 'image/png');
      };
      img.onerror = () => { status.textContent = 'Erreur de chargement du SVG.'; };
      img.src = url;
    } catch (e) {
      status.textContent = 'Erreur — essayez dans Chrome.';
      btn.textContent = 'Télécharger PNG';
    }
  });
</script>

</BaseLayout>
