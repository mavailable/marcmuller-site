---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

const apprentissages = [
  'Par où commencer quand tu pars de zéro et que personne autour de toi n\'a monté de boîte',
  'Comment aller chercher tes premiers clients toi-même, sans attendre que ça vienne',
  'Savoir quoi dire, et à qui, pour donner envie de bosser avec toi',
  'Les outils qui te font gagner du temps dès le départ, sans te noyer dedans',
  'Comment ne plus laisser filer un prospect : suivre, relancer, conclure',
  'Garder la main sur tout, pour continuer seul une fois lancé',
];
---

<BaseLayout
  title="La formation : apprendre à trouver tes clients | Marc M"
  description="La formation pour te lancer et aller chercher tes clients toi-même, même si personne autour de toi n'a jamais monté de boîte. Je la prépare en ce moment. Laisse-moi ton mail, je te préviens dès qu'elle sort."
  lang="fr"
  frPath="/formation"
>

  <!-- HERO -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-24 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-10 blur-3xl" style="background: #E86C47;"></div>

    <div class="mx-auto max-w-3xl relative z-10">
      <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color: #E86C47; letter-spacing: 0.2em;">La formation · bientôt</p>
      <h1 class="text-3xl font-bold text-white md:text-4xl lg:text-5xl mb-6 leading-tight">
        Apprendre à aller chercher<br/>
        <span class="bg-gradient-to-r from-[#E86C47] to-[#F5C8B3] bg-clip-text text-transparent">tes propres clients.</span>
      </h1>
      <p class="text-lg text-neutral-400 max-w-xl leading-relaxed">
        Tu veux te lancer mais tu ne sais pas par où commencer ? Tu connais ton métier, pas le fait d'aller chercher des clients, et personne autour de toi n'a monté de boîte pour te guider. C'est exactement ce que cette formation débloque.
      </p>
    </div>
  </section>

  <!-- ÉDITORIAL : ce que c'est, pourquoi -->
  <section class="w-full bg-[var(--color-bg)] px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-2xl">

      <p class="text-xl md:text-2xl leading-relaxed text-[var(--color-text)] font-medium mb-10">
        C'est la porte d'entrée. Avant de bosser ensemble dans la durée, il y a un déclic à provoquer : passer de « j'attends que ça vienne » à « je sais comment aller chercher mes clients ».
      </p>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-6">
        La plupart des indépendants galèrent pour la même raison : ils maîtrisent leur métier, mais personne ne leur a appris à trouver des clients. Et autour d'eux, que des salariés à qui demander conseil. Du coup ils hésitent, ils repoussent, ils n'osent pas. Cette formation est faite pour eux.
      </p>

      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-12">
        Je n'ai pas appris ça dans un livre. J'ai monté des boîtes, accompagné une vingtaine d'indépendants, et je construis moi-même les outils que j'utilise au quotidien. Ce que je te transmets, c'est ce qui marche pour de vrai, pas de la théorie.
      </p>

      <!-- Ce que tu repars savoir faire -->
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6">Ce que tu repars savoir faire</h2>
      <div class="grid gap-0 sm:grid-cols-1">
        {apprentissages.map(item => (
          <div class="flex items-start gap-3 py-3 border-b border-neutral-100">
            <svg class="w-4 h-4 flex-shrink-0 mt-1" style="color: #E86C47;" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span class="text-[var(--color-text-muted)]">{item}</span>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- STATUT : à venir + CPF/Qualiopi -->
  <section class="w-full bg-white px-6 py-16 md:px-8 md:py-20 border-y" style="border-color: var(--color-border);">
    <div class="mx-auto max-w-2xl">
      <span class="inline-flex w-fit items-center gap-2 mb-4 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-[var(--color-accent-text)]" style="background: rgba(232, 108, 71, 0.1); letter-spacing: 0.1em;">En préparation</span>
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">Je la prépare en ce moment</h2>
      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)] mb-6">
        La formation n'est pas encore ouverte. Je la construis pour qu'elle soit concrète et directement applicable, pas un cours de plus à oublier. Plutôt que d'annoncer une date que je ne tiendrais pas, je préfère te dire la vérité : ça arrive, et je te préviens dès que c'est prêt.
      </p>
      <p class="text-base md:text-lg leading-relaxed text-[var(--color-text-muted)]">
        Je travaille aussi à la rendre <strong class="text-[var(--color-text)]">finançable via le CPF (Qualiopi)</strong> en France. C'est en cours. Si ça aboutit, tu pourras la suivre sans rien sortir de ta poche. Je n'annonce rien tant que ce n'est pas confirmé.
      </p>
    </div>
  </section>

  <!-- LISTE D'ATTENTE : Web3Forms minimal -->
  <section class="w-full px-6 py-16 md:px-8 md:py-20" style="background: #FAFAFA;">
    <div class="mx-auto max-w-xl text-center">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-3">Préviens-moi quand ça sort</h2>
      <p class="text-[var(--color-text-muted)] mb-8">
        Laisse-moi ton mail. Pas de spam, pas de relances en boucle : juste un message le jour où la formation ouvre.
      </p>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="flex flex-col sm:flex-row gap-3 items-stretch justify-center max-w-md mx-auto"
      >
        <!-- Web3Forms Access Key -->
        <input type="hidden" name="access_key" value="dccda1f5-4e63-4b9f-9c66-f5ce76f0dfdd" />
        <input type="hidden" name="webhook" value="https://marcm.fr/api/lead-inbound" />
        <input type="hidden" name="form_source" value="formation-waitlist" />
        <input type="hidden" name="subject" value="Liste d'attente formation : nouveau mail" />
        <input type="hidden" name="redirect" value="https://marcm.fr/merci" />

        <!-- Honeypot (anti-spam) -->
        <input type="text" name="botcheck" style="display: none;" tabindex="-1" autocomplete="off" />

        <label for="email" class="sr-only">Ton email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="ton@email.fr"
          class="flex-grow rounded-xl border border-[var(--color-border)] bg-white px-4 py-3 text-[var(--color-text)] placeholder:text-neutral-400 focus:outline-none focus:border-[var(--color-accent)]"
        />
        <button
          type="submit"
          class="rounded-xl px-6 py-3 text-sm font-semibold text-white transition-all duration-200 whitespace-nowrap"
          style="background: linear-gradient(135deg, #E86C47, #D4572F);"
          data-umami-event="formation-waitlist-submit"
        >
          Préviens-moi
        </button>
      </form>

      <p class="mt-4 text-xs text-[var(--color-text-muted)]">
        Tu préfères m'écrire directement ? <a href="/contact" class="text-[var(--color-accent-text)] hover:underline font-medium">Par ici</a>.
      </p>
    </div>
  </section>

  <!-- TRANSITION : en attendant -->
  <section class="w-full relative px-6 py-16 md:px-8 md:py-20 overflow-hidden" style="background-color: #0D0D0D;">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="mx-auto max-w-2xl text-center relative z-10">
      <h2 class="text-2xl font-bold text-white mb-4">Tu ne veux pas attendre ?</h2>
      <p class="text-neutral-400 mb-8">
        La formation, c'est l'entrée. Si tu veux qu'on s'y mette tout de suite, on bosse ensemble dans la durée : je fais avec toi, chaque semaine. On en parle 20 minutes, je te dis par quoi commencer.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <Button href="/contact" variant="primary">On en parle</Button>
        <Button href="/methode" variant="secondary">Voir comment je bosse →</Button>
      </div>
    </div>
  </section>

</BaseLayout>
