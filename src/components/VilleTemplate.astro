---
import BaseLayout from '@layouts/BaseLayout.astro';
import { business } from '@data/business';

interface Section {
  title: string;
  content: string;
}

interface FAQ {
  question: string;
  answer: string;
}

export interface Props {
  title: string;
  description: string;
  ville: string;
  intro: string;
  sections: Section[];
  faq: FAQ[];
  pricingExpress?: { title: string; price: string; features: string[] };
  pricingCustom?: { title: string; price: string; features: string[] };
  geo: { lat: number; lon: number };
  areaServed: string[];
  ctaTitle: string;
  ctaText: string;
  ctaButton: string;
  frPath?: string;
  enPath?: string;
}

const {
  title,
  description,
  ville,
  intro,
  sections,
  faq,
  pricingExpress = {
    title: 'Site Vitrine',
    price: '490€',
    features: [
      '✓ Design sur mesure, pas un template',
      '✓ Référencé Google & IA',
      '✓ Formulaire, WhatsApp, appel',
      '✓ Lighthouse 100/100',
      '✓ Livré en 7 jours'
    ]
  },
  pricingCustom = {
    title: 'Projet Sur Mesure',
    price: 'Sur devis',
    features: [
      '✓ Multi-pages, blog, CMS',
      '✓ Fonctionnalités métier',
      '✓ Stratégie SEO avancée',
      '✓ Optimisé IA (ChatGPT, Claude)',
      '✓ Devis gratuit sous 48h'
    ]
  },
  geo,
  areaServed,
  ctaTitle,
  ctaText,
  ctaButton,
  frPath,
  enPath,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteUrl = Astro.site?.toString().replace(/\/$/, '');

const allCities = [
  { name: 'Strasbourg', path: '/creation-site-web-strasbourg/' },
  { name: 'Metz', path: '/creation-site-web-metz/' },
  { name: 'Nancy', path: '/creation-site-web-nancy/' },
  { name: 'Colmar', path: '/creation-site-web-colmar/' },
  { name: 'Mulhouse', path: '/creation-site-web-mulhouse/' },
];
const otherCities = allCities.filter(c => c.name !== ville);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${business.url}/` },
    { '@type': 'ListItem', position: 2, name: `Création site web ${ville}`, item: `${business.url}/creation-site-web-${ville.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')}/` },
  ],
};

// LocalBusiness Schema JSON-LD
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `${business.name} — Création de sites web`,
  "description": `Création de sites web sur mesure à ${ville}. Sites custom, rapides, bien référencés.`,
  "url": siteUrl,
  "telephone": business.phone,
  "email": business.email,
  "founder": {
    "@type": "Person",
    "name": business.owner,
    "jobTitle": business.jobTitle
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": ville,
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": geo.lat,
    "longitude": geo.lon
  },
  "areaServed": areaServed.map(area => ({
    "@type": "City",
    "name": area
  })),
  "priceRange": business.priceRange,
  "currenciesAccepted": "EUR",
  "paymentAccepted": "Virement, Chèque",
  "image": `${siteUrl}/og-default.png`
};

// FAQPage Schema JSON-LD
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<BaseLayout title={title} description={description} lang="fr" frPath={frPath} enPath={enPath}>

  <div class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative bg-[#0D0D0D] py-16 md:py-24">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
          Création de site web sur mesure à <span class="text-[var(--color-accent-text)]">{ville}</span>
        </h1>
        <div class="prose max-w-none text-neutral-300 text-lg leading-relaxed">
          <p>{intro}</p>
        </div>
      </div>
    </section>

    <!-- Dynamic Sections -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        {sections.map((section, idx) => (
          <div key={idx} class={idx > 0 ? "mt-16 md:mt-20" : ""}>
            <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text)] mb-6">
              {section.title}
            </h2>
            <div class="prose prose-lg max-w-none text-[var(--color-text-muted)] leading-relaxed">
              <p>{section.content}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="py-16 md:py-20 bg-[var(--color-bg-alt)]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-accent-text)] mb-12 text-center">
          Les trois offres pour {ville}
        </h2>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Express Offer -->
          <div class="bg-white p-8 rounded-lg border-l-4 border-[var(--color-accent)]">
            <h3 class="text-2xl font-bold text-[var(--color-accent-text)] mb-2">
              {pricingExpress.title}
            </h3>
            <p class="text-3xl font-bold text-[var(--color-text)] mb-6">{pricingExpress.price}</p>
            <ul class="space-y-3 mb-6">
              {pricingExpress.features.map(feature => (
                <li key={feature} class="text-[var(--color-text)] text-sm">
                  {feature}
                </li>
              ))}
            </ul>
            <p class="text-sm text-[var(--color-text-muted)]">
              Délai : 5-7 jours
            </p>
          </div>

          <!-- Custom Offer -->
          <div class="bg-[var(--color-accent)] p-8 rounded-lg border-l-4 border-[var(--color-accent)]">
            <h3 class="text-2xl font-bold text-white mb-2">
              {pricingCustom.title}
            </h3>
            <p class="text-3xl font-bold text-white mb-6">{pricingCustom.price}</p>
            <ul class="space-y-3 mb-6">
              {pricingCustom.features.map(feature => (
                <li key={feature} class="text-white text-sm">
                  {feature}
                </li>
              ))}
            </ul>
            <p class="text-sm text-white/90">
              Délai : 2-3 semaines
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text)] mb-12">
          Questions fréquentes
        </h2>

        <div class="space-y-4">
          {faq.map((item, idx) => (
            <details key={idx} class="group border border-[var(--color-accent)] rounded-lg p-6 cursor-pointer hover:bg-[var(--color-bg)] transition-colors">
              <summary class="flex justify-between items-center font-semibold text-[var(--color-text)] text-lg">
                {item.question}
                <span class="transform group-open:rotate-180 transition-transform">
                  <svg class="w-6 h-6 text-[var(--color-accent-text)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </span>
              </summary>
              <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Pour aller plus loin -->
    <section class="py-12 md:py-16 bg-[var(--color-bg)]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <a
          href="/journal/creer-site-web-entreprise-grand-est-guide"
          data-umami-event="geo-pillar-link"
          data-umami-event-ville={ville.toLowerCase()}
          class="group block rounded-2xl border border-[var(--color-border)] bg-white p-6 md:p-8 transition-all hover:border-[var(--color-accent)] hover:shadow-md"
        >
          <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent-text)] mb-3">À lire</p>
          <h3 class="text-xl md:text-2xl font-bold text-[var(--color-text)] mb-2 leading-snug">
            Créer le site web de votre entreprise dans le Grand Est : le guide concret
          </h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed mb-4">
            Les étapes réelles, les vrais coûts, les délais et ce qui change quand on est artisan ou TPE à {ville}. Un guide complet, sans jargon.
          </p>
          <span class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-accent-text)]">
            Lire le guide
            <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </span>
        </a>
      </div>
    </section>

    <!-- Autres villes -->
    <section class="py-12 md:py-16 bg-white border-t border-[var(--color-border)]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-text-muted)] mb-6">Aussi disponible à</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          {otherCities.map(({ name, path }) => (
            <a
              href={path}
              class="rounded-full border border-[var(--color-border)] px-5 py-2 text-sm font-medium text-[var(--color-text)] transition-all hover:border-[var(--color-accent)] hover:text-[var(--color-accent-text)] hover:shadow-sm"
              data-umami-event="geo-crosslink"
              data-umami-event-from={ville.toLowerCase()}
              data-umami-event-to={name.toLowerCase()}
            >
              Site web {name}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 md:py-20 bg-[#1A1A1A]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-accent-text)] mb-6">
          {ctaTitle}
        </h2>
        <p class="text-lg text-neutral-300 mb-8 leading-relaxed">
          {ctaText}
        </p>
        <a
          href="/commander"
          data-umami-event="geo-cta-commander"
          data-umami-event-ville={ville.toLowerCase()}
          class="inline-block bg-white text-[var(--color-accent-text)] px-8 py-4 rounded-lg font-bold text-lg hover:bg-neutral-100 transition-colors"
        >
          Commander mon site — 490€
        </a>
        <p class="mt-4">
          <a href="/contact" data-umami-event="geo-cta-contact" data-umami-event-ville={ville.toLowerCase()} class="text-sm text-neutral-400 underline underline-offset-4 hover:text-white transition-colors">
            Projet sur mesure ? Parlons-en →
          </a>
        </p>
      </div>
    </section>
  </div>

  <!-- JSON-LD Schema Scripts -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
