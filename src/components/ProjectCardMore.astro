---
// Bloc « Voir plus » d'une carte du portfolio (/realisations et /en/portfolio).
//
// Pourquoi un <details> natif et pas du JS : la description d'une carte est
// coupée à 2 lignes, et jusqu'ici le seul moyen d'en lire davantage était de
// quitter marcm.fr. Le <details> déplie la description complète et le reste des
// informations SANS une ligne de JavaScript, donc ça marche aussi quand le JS
// ne se charge pas. Le déclampage de la description se fait en CSS pur dans
// global.css (`.project-card:has(.pf-more[open]) .pf-desc`).
//
// Ce bloc affiche `highlights`, `type` et `stack`, trois champs de projects.ts
// qui n'étaient rendus nulle part depuis que PortfolioProjectCard.astro était
// devenu orphelin (composant supprimé le 2026-08-17).
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  lang?: 'fr' | 'en';
}

const { project, lang = 'fr' } = Astro.props;
const isEn = lang === 'en';

const features = (isEn ? project.featuresEn ?? project.features : project.features) ?? [];
// Les 4 premières pastilles sont déjà affichées sur la carte fermée.
const extraFeatures = features.slice(4);

// Un projet en cours n'a pas de résultat mesuré à annoncer : ses highlights
// parlent de vitesse et de délai de livraison, ce qui serait faux avant la
// mise en ligne. La carte affiche déjà son badge « En cours ».
const highlights = project.wip ? [] : (isEn ? project.highlightsEn ?? project.highlights : project.highlights) ?? [];

// `stack` n'a pas de variante EN dans projects.ts : tout est du nom propre
// (Astro, Tailwind, Cloudflare, Keystatic…) sauf « CMS maison ».
const STACK_EN: Record<string, string> = { 'CMS maison': 'In-house CMS' };
const stack = (project.stack ?? []).map((s) => (isEn ? STACK_EN[s] ?? s : s));

const typeLabel = isEn ? project.typeEn ?? project.type : project.type;

const hasMore = extraFeatures.length > 0 || highlights.length > 0 || stack.length > 0 || Boolean(typeLabel);

const labels = isEn
  ? { open: 'Show more', close: 'Show less', type: 'Project', stack: 'Stack' }
  : { open: 'Voir plus', close: 'Voir moins', type: 'Projet', stack: 'Stack' };
---

{hasMore && (
  <details class="pf-more -mt-3 mb-5">
    <summary
      class="inline-flex items-center gap-1.5 rounded-md py-1 text-xs font-semibold text-[var(--color-accent-text)] transition-colors hover:text-[var(--color-accent-hover)]"
      data-umami-event={`portfolio-expand-${project.id}`}
    >
      <span class="pf-more-label-open">{labels.open}</span>
      <span class="pf-more-label-close">{labels.close}</span>
      <svg
        class="pf-more-chevron h-3.5 w-3.5 transition-transform duration-200"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>

    <div class="mt-3 space-y-3 border-t border-[var(--color-border)] pt-3">
      {extraFeatures.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {extraFeatures.map((f: string) => (
            <span class="rounded-md bg-[var(--color-bg-alt)] px-2 py-0.5 text-[11px] font-medium text-[var(--color-text)]">
              {f}
            </span>
          ))}
        </div>
      )}

      {highlights.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {highlights.map((h) => (
            <span class="inline-flex items-baseline gap-1 rounded-md border border-[var(--color-accent-200)] bg-[var(--color-accent-50)] px-2 py-0.5 text-[11px] text-[var(--color-text)]">
              {h.label}
              <span class="font-bold text-[var(--color-accent-text)]">{h.value}</span>
            </span>
          ))}
        </div>
      )}

      {typeLabel && (
        <p class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <span class="text-[10px] font-semibold uppercase tracking-wider text-[var(--color-text-light)]">
            {labels.type}
          </span>
          <span class="text-xs text-[var(--color-text)]">{typeLabel}</span>
        </p>
      )}

      {stack.length > 0 && (
        <p class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <span class="text-[10px] font-semibold uppercase tracking-wider text-[var(--color-text-light)]">
            {labels.stack}
          </span>
          <span class="text-xs font-semibold text-[var(--color-accent-text)]">{stack.join(' · ')}</span>
        </p>
      )}
    </div>
  </details>
)}
