---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallButton from '../components/MobileCallButton.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { business } from '../data/business';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  noHeader?: boolean;
  lang?: 'fr' | 'en';
  frPath?: string; // e.g. '/', '/realisations'
  enPath?: string; // e.g. '/en/', '/en/portfolio'
  ctaOverrideLabel?: string;
  ctaOverrideHref?: string;
  preloadImages?: { href: string; media?: string }[];
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  noindex = false,
  noHeader = false,
  lang = 'fr',
  frPath,
  enPath,
  ctaOverrideLabel,
  ctaOverrideHref,
  preloadImages,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site).href;
const ogLocale = lang === 'en' ? 'en_US' : 'fr_FR';

const frURL = frPath ? new URL(frPath, Astro.site).href : null;
const enURL = enPath ? new URL(enPath, Astro.site).href : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={business.owner} />
    <meta name="theme-color" content="#E86C47" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- OG Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={business.name} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@marcmuller_dev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Canonical URL & Favicon -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Font preload for faster First Contentful Paint -->
    <!-- Seule la variable normale est préchargée : l'italique n'est pas dans le above-the-fold
         et son préchargement entrait en concurrence avec l'image LCP sur la bande passante mobile.
         font-display: swap dans global.css garantit son chargement à la demande. -->
    <link rel="preload" as="font" href="/fonts/Satoshi-Variable.woff2" type="font/woff2" crossorigin />

    <!-- LCP image preload (passed per-page) -->
    {preloadImages?.map(({ href, media }) => (
      <link rel="preload" as="image" fetchpriority="high" href={href} {...(media ? { media } : {})} />
    ))}

    <!-- Hreflang alternate links -->
    {frURL && <link rel="alternate" hreflang="fr" href={frURL} />}
    {enURL && <link rel="alternate" hreflang="en" href={enURL} />}
    {frURL && <link rel="alternate" hreflang="x-default" href={frURL} />}

    <title>{title}</title>

    <!-- Schema.org WebSite (global) -->
    <SchemaOrg type="webSite" />

    <!-- Umami Analytics (self-hosted for CSP/SRI compliance) -->
    <script is:inline defer src="/scripts/umami.js" data-website-id="0e4930eb-681d-4c89-94f2-5abfcf564383" data-host-url="https://cloud.umami.is"></script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      {lang === 'en' ? 'Skip to main content' : 'Aller au contenu principal'}
    </a>
    {lang === 'en' && frPath && (
      <div style="background:#1a1a1a; border-bottom:1px solid rgba(255,255,255,0.08); padding:10px 16px; text-align:center; font-size:13px; color:rgba(255,255,255,0.6);">
        You were redirected to English.
        <a id="lang-switch-fr" href={frPath} style="color:#E86C47; font-weight:600; margin-left:6px; text-decoration:none;">Revenir en français →</a>
      </div>
      <script is:inline>
        document.getElementById('lang-switch-fr')?.addEventListener('click', function() {
          document.cookie = 'lang=fr;path=/;max-age=31536000;SameSite=Lax';
        });
      </script>
    )}
    {!noHeader && <Header lang={lang} frPath={frPath} enPath={enPath} ctaOverrideLabel={ctaOverrideLabel} ctaOverrideHref={ctaOverrideHref} />}
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton />
  </body>
</html>
